{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|NotebookRead|Grep|Glob|Bash|WebFetch|WebSearch|apply_patch|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-pre-tool",
            "timeout": 60,
            "statusMessage": "agent-guard: checking tool call",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|apply_patch|Read|NotebookRead|Grep|Glob|WebFetch|WebSearch|Agent|Task|Skill|Monitor|LSP|ListMcpResourcesTool|ReadMcpResourceTool|REPL|Poll|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-post-tool",
            "timeout": 20,
            "statusMessage": "agent-guard: scanning tool output"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|apply_patch|Read|NotebookRead|Grep|Glob|WebFetch|WebSearch|Agent|Task|Skill|Monitor|LSP|ListMcpResourcesTool|ReadMcpResourceTool|REPL|Poll|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-post-tool-failure",
            "timeout": 20,
            "statusMessage": "agent-guard: scanning failed tool output"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-stop",
            "timeout": 20,
            "statusMessage": "agent-guard: scanning changes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-session-start",
            "timeout": 5,
            "statusMessage": "agent-guard: checking setup"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-guard/plugins/agent-guard/bin/agent-guard hook-user-prompt",
            "timeout": 10,
            "statusMessage": "agent-guard: scanning prompt"
          }
        ]
      }
    ]
  }
}
