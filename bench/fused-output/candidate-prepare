#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
export AGENT_GUARD_EXPERIMENTAL_OUTPUT_PIPELINE=fused
AGENT_GUARD_EXPERIMENTAL_OUTPUT_PREPARE_BIN=${AGENT_GUARD_FUSED_PREPARE_BIN:-"$root/native/redaction-core/target/release/agent-guard-redact"}
export AGENT_GUARD_EXPERIMENTAL_OUTPUT_PREPARE_BIN
exec "$root/plugins/agent-guard/bin/agent-guard" "$@"
