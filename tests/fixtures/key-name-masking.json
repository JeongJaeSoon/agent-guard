{
  "comment": "Synthetic text for 94S-1888. Each pair holds a `pass` line, where a credential-named field is followed by an identifier that repeats the field name, and the nearest `mask` line that must stay masked. %R% becomes a random letter-and-digit run each test, %H% a random 40-digit hex run, %V% a vendor-shaped token, %W% a short human password and %G% the marker the bundled mock scanner reports, all assembled at run time so no literal here looks like a credential. `masked` is the stdout agent-guard returns and applies to both hosts: Claude rewrites updatedToolOutput, Codex blocks and carries the same text in additionalContext. A `pass` line is left untouched and passes the prompt guard; a `mask` line and every `still_masked` line is rewritten and blocks at the prompt guard. `legacy` is what a `pass` line becomes with AGENT_GUARD_KEY_NAME_REDACT=on.",
  "pairs": [
    {"label": "type named after the field",
     "pass": "  credential: Credential;", "legacy": "  credential: [REDACTED];",
     "mask": "  credential: %R%;", "masked": "  credential: [REDACTED];"},
    {"label": "union type",
     "pass": "  credential: Credential | null;", "legacy": "  credential: [REDACTED] | null;",
     "mask": "  credential: \"%R%\" | null;", "masked": "  credential: \"[REDACTED]\" | null;"},
    {"label": "schema identifier",
     "pass": "  credential: CredentialSchema,", "legacy": "  credential: [REDACTED],",
     "mask": "  credential: mypassword,", "masked": "  credential: [REDACTED],"},
    {"label": "camelCase identifier",
     "pass": "  password: hashedPassword,", "legacy": "  password: [REDACTED],",
     "mask": "  password: hashedPassword1,", "masked": "  password: [REDACTED],"},
    {"label": "member reference",
     "pass": "  credential: input.credential,", "legacy": "  credential: [REDACTED],",
     "mask": "  credential: input.credential, port: 3306", "masked": "  credential: [REDACTED], port: 3306"},
    {"label": "nullish fallback",
     "pass": "  credential: credentialOverride ?? null,", "legacy": "  credential: [REDACTED] ?? null,",
     "mask": "  credential: %R% ?? null,", "masked": "  credential: [REDACTED] ?? null,"},
    {"label": "variable reference",
     "pass": "  credential: $credential,", "legacy": "  credential: [REDACTED],",
     "mask": "  credential: $%R%,", "masked": "  credential: [REDACTED],"},
    {"label": "generic type",
     "pass": "  token: Promise<Token>;", "legacy": "  token: [REDACTED];",
     "mask": "  token: Promise<%R%>;", "masked": "  token: [REDACTED];"},
    {"label": "default after a type",
     "pass": "    credential: Credential = None", "legacy": "    credential: [REDACTED] = None",
     "mask": "    credential: Credential", "masked": "    credential: [REDACTED]"},
    {"label": "keyword argument",
     "pass": "        credential=credential,", "legacy": "        [REDACTED]=[REDACTED],",
     "mask": "        credential=%W%,", "masked": "        credential=[REDACTED],"},
    {"label": "keyword argument from a member",
     "pass": "        api_key=self.api_key,", "legacy": "        api_key=[REDACTED],",
     "mask": "        api_key=other_key,", "masked": "        api_key=[REDACTED],"},
    {"label": "member assignment",
     "pass": "        self.credential = credential", "legacy": "        self.[REDACTED] = [REDACTED]",
     "mask": "password = password", "masked": "[REDACTED] = [REDACTED]"},
    {"label": "member assignment statement",
     "pass": "  this.credential = credential;", "legacy": "  this.[REDACTED] = [REDACTED];",
     "mask": "  this.credential = \"%R%\";", "masked": "  this.credential = \"[REDACTED]\";"},
    {"label": "connection string segment",
     "pass": "  password: userPassword;", "legacy": "  password: [REDACTED];",
     "mask": "Password=MyPassword;Server=db", "masked": "Password=[REDACTED];Server=db"},
    {"label": "scanner finding under a matching name",
     "pass": "  secret: client_secret,", "legacy": "  secret: [REDACTED],",
     "mask": "  secret: %G%,", "masked": "  secret: [REDACTED],"}
  ],
  "still_masked": [
    {"label": "env password, short human value", "stdout": "password=%W%", "masked": "password=[REDACTED]"},
    {"label": "quoted password", "stdout": "password: \"%W%\"", "masked": "password: \"[REDACTED]\""},
    {"label": "YAML password word", "stdout": "password: admin", "masked": "password: [REDACTED]"},
    {"label": "env password, capitalized word", "stdout": "PASSWORD=ChangeMe", "masked": "PASSWORD=[REDACTED]"},
    {"label": "flow mapping", "stdout": "{user: root, password: mypassword, port: 3306}", "masked": "{user: root, password: [REDACTED], port: 3306}"},
    {"label": "log line", "stdout": "user=admin, password=mypassword, host=db", "masked": "user=admin, password=[REDACTED], host=db"},
    {"label": "vendor-shaped token in an object field", "stdout": "  token: %V%,", "masked": "  token: [REDACTED],"},
    {"label": "vendor-shaped token in env form", "stdout": "GITHUB_TOKEN=%V%", "masked": "GITHUB_TOKEN=[REDACTED]"},
    {"label": "dotted words under another head", "stdout": "  password: winter.coldPassword,", "masked": "  password: [REDACTED],"},
    {"label": "random hex in an object field", "stdout": "  credential: %H%,", "masked": "  credential: [REDACTED],"},
    {"label": "random hex in env form", "stdout": "API_KEY=%H%", "masked": "API_KEY=[REDACTED]"},
    {"label": "random value after a type default", "stdout": "    credential: %R% = None", "masked": "    credential: [REDACTED] = None"},
    {"label": "quoted string in schema code", "stdout": "  credential: \"%R%\",", "masked": "  credential: \"[REDACTED]\","}
  ]
}
