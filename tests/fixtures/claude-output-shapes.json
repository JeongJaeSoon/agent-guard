  "schemas": {
    "Bash": {"required": {"stdout": "string", "stderr": "string", "interrupted": "boolean"}, "optional": {"isImage": "boolean", "noOutputExpected": "boolean", "persistedOutputPath": "string", "persistedOutputSize": "number", "gitOperation": "object"}},
    "Read": {"required": {"type": "string", "file": "object", "file.filePath": "string", "file.content": "string", "file.numLines": "number", "file.startLine": "number", "file.totalLines": "number"}, "optional": {}, "words": {"type": ["text"]}},
    "Write": {"required": {"type": "string", "filePath": "string", "content": "string", "structuredPatch": "array", "originalFile": "string|null"}, "optional": {"userModified": "boolean", "gitDiff": "object", "staged": "boolean"}, "words": {"type": ["create", "update"]}},
    "Edit": {"required": {"filePath": "string", "oldString": "string", "newString": "string", "originalFile": "string|null", "structuredPatch": "array", "userModified": "boolean", "replaceAll": "boolean"}, "optional": {"gitDiff": "object", "staged": "boolean"}},
    "NotebookEdit": {"required": {"new_source": "string", "cell_type": "string", "language": "string", "edit_mode": "string", "notebook_path": "string", "original_file": "string", "updated_file": "string"}, "optional": {"old_source": "string", "cell_id": "string", "error": "string"}, "words": {"cell_type": ["code", "markdown"]}},
    "Grep": {"required": {"numFiles": "number", "filenames": "array"}, "optional": {"mode": "string", "content": "string", "numLines": "number", "numMatches": "number", "totalFiles": "number", "totalLines": "number", "appliedLimit": "number", "appliedOffset": "number", "timedOut": "boolean"}, "words": {"mode": ["content", "files_with_matches", "count"]}},
    "Glob": {"required": {"durationMs": "number", "numFiles": "number", "filenames": "array", "truncated": "boolean"}, "optional": {"totalMatches": "number", "countIsComplete": "boolean", "timedOut": "boolean"}},
    "Skill": {"required": {"success": "boolean", "commandName": "string"}, "optional": {"allowedTools": "array", "model": "string", "status": "string", "readOnly": "boolean"}, "words": {"status": ["inline"]}},
    "Monitor": {"required": {"taskId": "string", "timeoutMs": "number"}, "optional": {"persistent": "boolean", "keptInSandboxByCheck": "boolean"}},
    "REPL": {"required": {"code": "string", "stdout": "string", "stderr": "string"}, "optional": {"result": "any", "error": "string", "stoppedBy": "string", "neverRan": "string"}, "words": {"stoppedBy": ["user", "refusal"], "neverRan": ["person", "other"]}},
    "Poll": {"required": {"content": "string", "eventCount": "number", "remainingWakeCount": "number"}, "optional": {"provenance": "array", "toolsUsed": "array", "media": "array", "declared": "array", "rows": "array"}}
  }
