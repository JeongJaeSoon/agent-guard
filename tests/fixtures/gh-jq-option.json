  },
  {
    "id": "gh-pr-view-jq-sort",
    "expected_status": 0,
    "classification": "must-pass",
    "description": "gh pr view --json --jq then sort (the filter is read as program text once a block is pending, so a passing gh command costs what it did)",
    "command": "gh pr view 5 --json files --jq '.files[] | .key' | sort"
  },
  {
    "id": "command-gh",
    "both_hosts": true,
    "expected_status": 2,
    "classification": "residual",
    "description": "command gh still runs gh (the second reading knows only a bare gh command word, so this filter is still scanned)",
    "command": "command gh api x --jq '.data.key'"
  },
