[
  {
    "id": "case12-content-pipe",
    "both_hosts": true,
    "expected_status": 0,
    "classification": "must-pass",
    "description": "case 12: a gh --jq filter before a jq pipeline that reads .key",
    "command": "gh api repos/o/r/contents/fixtures/main.json --jq '.content' | base64 -d | jq '.entries | map(.key)'"
  },
  {
    "id": "gh-filter-then-jq-key",
    "expected_status": 0,
    "classification": "must-pass",
    "description": "a gh --jq filter without protected text before a jq that reads .key",
    "command": "gh api repos/o/r/contents/x.json --jq '.items' | jq '.[] | .key'"
  },
  {
    "id": "command-gh-then-jq",
    "expected_status": 0,
    "classification": "must-pass",
    "description": "command gh with --jq before a jq field filter",
    "command": "command gh api x --jq '.data' | jq -r '.key'"
  },
  {
    "id": "gh-jq-key",
    "expected_status": 0,
    "classification": "must-pass",
    "description": "the --jq filter of gh api names a .key field (the filter is read as program text once a block is pending, so a passing gh command costs what it did)",
    "command": "gh api repos/o/r/contents/x.json --jq '.key'"
  },
  {
    "id": "gh-jq-object",
    "expected_status": 0,
    "classification": "must-pass",
