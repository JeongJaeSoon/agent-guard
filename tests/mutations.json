  {
    "id": "sh-squote-no-escape",
    "rule": "sh_squote: a quote inside the value is escaped",
    "old": "  printf '%s' \"$1\" | sed \"s/'/'\\\\\\\\''/g\"",
    "new": "  printf '%s' \"$1\"",
    "tests": [
      "tests/unit-core.sh"
    ]
  },
  {
    "id": "version-newer-always",
    "rule": "version_newer: only a strictly newer version is newer",
    "old": "  semver_at_least \"$2\" \"$1\"\n  [ \"$?\" -eq 1 ]",
    "new": "  semver_at_least \"$2\" \"$1\"\n  [ \"$?\" -ge 0 ]",
    "tests": [
      "tests/unit-core.sh"
    ]
  },
