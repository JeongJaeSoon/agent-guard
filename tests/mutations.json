    ]
  },
  {
    "id": "deny-shell-no-glob-char",
    "rule": "deny_path_shell_expansion_char_pattern: ? and * stand for a character",
    "old": "sx_char=\"($sx_char_literal|\\\\\\\\x$sx_hex|\\\\?|\\\\*|$sx_bracket)\"",
    "new": "sx_char=\"($sx_char_literal|\\\\\\\\x$sx_hex|$sx_bracket)\"",
    "tests": [
      "tests/unit-deny-path.sh"
    ]
  },
  {
    "id": "deny-shell-dot-no-hex",
    "rule": "deny_path_shell_expansion_char_pattern: a dot also matches its hex escape",
