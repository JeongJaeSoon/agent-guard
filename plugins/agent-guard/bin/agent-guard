#!/usr/bin/env sh
set -u

PROGRAM=agent-guard
VERSION=3.13.1

# Where releases are published and what the host plugin managers call them.
AG_REPO=JeongJaeSoon/agent-guard
AG_REPO_URL=https://github.com/$AG_REPO
AG_MARKETPLACE=agent-guard
AG_PLUGIN_ID=agent-guard@$AG_MARKETPLACE

# Resolve the script's own path, following symlinks. The bootstrap installer
# drops a symlink at ~/.local/bin/agent-guard that points into ~/.agent-guard/
# bin/agent-guard, so dirname "$0" alone (without symlink follow) computes the
# config / scripts directory relative to ~/.local/ instead of ~/.agent-guard/.
# POSIX-portable: walk the readlink chain by hand (BSD readlink lacks -f).
script_path() {
  p=$0
  hops=0
  max_hops=40
  while [ -L "$p" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt "$max_hops" ]; then
      printf '%s: too many symlink hops while resolving script path: %s\n' "$PROGRAM" "$p" >&2
      exit 2
    fi
    target=$(readlink -- "$p")
    case "$target" in
      /*) p=$target ;;
      *) p="$(dirname -- "$p")/$target" ;;
    esac
  done
  printf '%s\n' "$p"
}

script_dir() {
  # Host hooks invoke the regular executable by absolute path. Resolve its
  # parent in this existing subshell without spawning script_path and dirname.
  # Symlink and relative invocations retain the portable chain resolver below.
  case "$0" in
    /*)
      if [ ! -L "$0" ]; then
        script_parent=${0%/*}
        CDPATH= cd -- "${script_parent:-/}" && pwd -P
        return
      fi
      ;;
  esac
  # shellcheck disable=SC2164
  CDPATH= cd -- "$(dirname -- "$(script_path)")" && pwd -P
}

BIN_DIR=$(script_dir)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)
# Resolved absolute path of THIS binary, for self re-exec and cache identity.
SELF_BIN="$BIN_DIR/agent-guard"

# Sets ag_sv_1..3 to the first three dot-separated fields of $1 (a missing or
# empty field is 0). Fails on any other character or a field of 10+ digits,
# which test(1) cannot compare.
semver_fields() {
  case "$1" in
    *[!0-9.]*|*[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*) return 1 ;;
  esac
  ag_sv_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086 # split on IFS=. into fields
  set -- $1
  IFS=$ag_sv_ifs
  ag_sv_1=${1:-0} ag_sv_2=${2:-0} ag_sv_3=${3:-0}
}

# semver_at_least A B succeeds when version A >= B; an unparsable version
# fails with 2.
semver_at_least() {
  semver_fields "$2" || return 2
  ag_sv_b1=$ag_sv_1 ag_sv_b2=$ag_sv_2 ag_sv_b3=$ag_sv_3
  semver_fields "$1" || return 2
  [ "$ag_sv_1" -ne "$ag_sv_b1" ] && { [ "$ag_sv_1" -gt "$ag_sv_b1" ]; return; }
  [ "$ag_sv_2" -ne "$ag_sv_b2" ] && { [ "$ag_sv_2" -gt "$ag_sv_b2" ]; return; }
  [ "$ag_sv_3" -ge "$ag_sv_b3" ]
}

# version_newer A B: succeeds when semver A is strictly greater than B.
version_newer() {
  semver_at_least "$2" "$1"
  [ "$?" -eq 1 ]
}

# Plugin managers install each release under a version directory. Keep one
# sibling `current` symlink so shell snapshots and hook manifests never bake a
# disposable version path. Direct CLI installs (ROOT_DIR is not a semver) keep
# their existing stable ~/.agent-guard path.
is_semver_dir() (
  set -f
  case ${1:-} in ''|*[!0-9.]*) return 1 ;; esac
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $1
  IFS=$old_ifs
  [ "$#" -eq 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ]
)

PLUGIN_CACHE_VERSION=${ROOT_DIR##*/}
PLUGIN_CACHE_BASE=
if is_semver_dir "$PLUGIN_CACHE_VERSION"; then
  PLUGIN_CACHE_BASE=${ROOT_DIR%/*}
fi

# A cache directory is selectable only when its executable, policy payload,
# and embedded version agree. An interrupted plugin update can leave a
# higher-looking directory with only bin/agent-guard; selecting it would turn a
# healthy installation into a default-open DEGRADED hook.
# Every hook checks the three policy files, so stay in the shell instead of
# starting an awk per file.
policy_file_has_active_rule() {
  [ -r "$1" ] && [ -s "$1" ] || return 1
  while IFS= read -r policy_line || [ -n "$policy_line" ]; do
    policy_line=${policy_line#"${policy_line%%[![:space:]]*}"}
    case "$policy_line" in ''|'#'*) ;; *) return 0 ;; esac
  done <"$1"
  return 1
}

cache_policy_file_usable() {
  [ -f "$1" ] && [ ! -L "$1" ] && policy_file_has_active_rule "$1"
}

plugin_cache_root_usable() (
  candidate_root=$1
  expected_version=${2:-}
  candidate_bin="$candidate_root/bin/agent-guard"
  [ -d "$candidate_root" ] && [ ! -L "$candidate_root" ] \
    && [ -d "$candidate_root/bin" ] && [ ! -L "$candidate_root/bin" ] \
    && [ -d "$candidate_root/config" ] && [ ! -L "$candidate_root/config" ] \
    && [ -f "$candidate_bin" ] && [ ! -L "$candidate_bin" ] && [ -x "$candidate_bin" ] \
    && cache_policy_file_usable "$candidate_root/config/gitleaks.toml" \
    && cache_policy_file_usable "$candidate_root/config/deny-read-paths.txt" \
    && cache_policy_file_usable "$candidate_root/config/deny-bash-patterns.txt" \
    || return 1
  embedded_version=
  while IFS= read -r candidate_line; do
    case "$candidate_line" in
      VERSION=*) embedded_version=${candidate_line#VERSION=}; break ;;
    esac
  done <"$candidate_bin"
  [ -n "$embedded_version" ] || return 1
  [ -z "$expected_version" ] || [ "$embedded_version" = "$expected_version" ]
)

refresh_plugin_current_link() {
  [ -n "$PLUGIN_CACHE_BASE" ] || return 0
  current="$PLUGIN_CACHE_BASE/current"
  # Never replace a real directory named current. The runtime resolvers below
  # still fall back to the newest version directory in that environment.
  if [ -e "$current" ] && [ ! -L "$current" ]; then
    return 1
  fi
  current_target=
  if [ -L "$current" ]; then
    current_target=$(readlink "$current" 2>/dev/null) || current_target=
    # Every check below leaves a link that already names this version as it
    # is, so skip their processes on the common path.
    [ "$current_target" != "$PLUGIN_CACHE_VERSION" ] || return 0
  fi
  plugin_cache_root_usable "$ROOT_DIR" "$PLUGIN_CACHE_VERSION" || return 1

  # A stale older process must not roll a current link backward. Conversely, a
  # merely cached higher sibling must not become active before that version's
  # host-selected binary actually runs.
  if [ -L "$current" ]; then
    if is_semver_dir "$current_target" \
       && plugin_cache_root_usable "$PLUGIN_CACHE_BASE/$current_target" "$current_target" \
       && semver_at_least "$current_target" "$PLUGIN_CACHE_VERSION"; then
      return 0
    fi
  fi
  # BSD and GNU ln both support -n to replace a symlink-to-directory itself
  # instead of following it and creating a link inside the old version.
  ln -sfn "$PLUGIN_CACHE_VERSION" "$current" 2>/dev/null
}

refresh_plugin_current_link || :
# Baked into the shell-init snippet so the wrappers can find agent-guard even
# when it is NOT on $PATH (e.g. a plugin-only install, where the binary lives in
# the plugin cache and is never symlinked onto PATH). For a plugin install it
# names the cache's `current` link, so the snippet survives plugin updates.
STABLE_BIN=$SELF_BIN
[ -n "$PLUGIN_CACHE_BASE" ] && STABLE_BIN="$PLUGIN_CACHE_BASE/current/bin/agent-guard"

# Emit $1 as a safely single-quoted POSIX shell word, so a path with spaces (or,
# rarely, an embedded quote) survives being baked into an emitted snippet.
sh_squote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

# The command word for guidance that asks the user to run this CLI. Keep the
# short `agent-guard` when that name on PATH is this installation. Standalone
# and Homebrew installs accept any copy on PATH, because Homebrew's bin entry is
# a wrapper script rather than this file. A plugin-only install puts nothing on
# PATH, so name the executable by its quoted absolute path instead: the stable
# `current` link when it works, so the advice survives the next plugin update.
# Computed on first use; only paths that print guidance pay for it.
AG_CLI_REF=
AG_CLI_REF_HOOK=
cli_ref_init() {
  [ -z "$AG_CLI_REF" ] || return 0
  cli_ref_found=$(command -v "$PROGRAM" 2>/dev/null) || cli_ref_found=
  case $cli_ref_found in
    /*)
      if [ -z "$PLUGIN_CACHE_BASE" ] || [ "$cli_ref_found" -ef "$SELF_BIN" ] \
         || [ "$cli_ref_found" -ef "$STABLE_BIN" ]; then
        AG_CLI_REF=$PROGRAM
        AG_CLI_REF_HOOK=$PROGRAM
        return 0
      fi
      ;;
  esac
  cli_ref_exec=$STABLE_BIN
  [ -x "$cli_ref_exec" ] || cli_ref_exec=$SELF_BIN
  # Double quotes read naturally inside the existing 'run ...' wording; a path
  # that double quotes would not keep literal uses POSIX single quoting.
  case $cli_ref_exec in
    *[\"\$\`\\]*) AG_CLI_REF=$(sh_squote "$cli_ref_exec") ;;
    *) AG_CLI_REF="\"$cli_ref_exec\"" ;;
  esac
  # Hook messages travel as text on stderr, inside hand-built JSON strings, and
  # through jq in closed mode, so they need a form that is the same in all
  # three: a single-quoted path, which no JSON or shell layer changes. A path
  # that holds a quote, a backslash or a control character would need escaping
  # in one of them; that rare path keeps the short name.
  case $cli_ref_exec in
    *[\'\"\\]*|*[[:cntrl:]]*) AG_CLI_REF_HOOK=$PROGRAM ;;
    *) AG_CLI_REF_HOOK="'$cli_ref_exec'" ;;
  esac
}

GITLEAKS_CONFIG=${AGENT_GUARD_GITLEAKS_CONFIG:-"$ROOT_DIR/config/gitleaks.toml"}
DENY_READ_PATHS_CUSTOM=0
if [ -n "${AGENT_GUARD_DENY_READ_PATHS:-}" ]; then
  DENY_READ_PATHS=$AGENT_GUARD_DENY_READ_PATHS
  DENY_READ_PATHS_CUSTOM=1
else
  DENY_READ_PATHS="$ROOT_DIR/config/deny-read-paths.txt"
fi
DENY_BASH_PATTERNS=${AGENT_GUARD_DENY_BASH_PATTERNS:-"$ROOT_DIR/config/deny-bash-patterns.txt"}
GITLEAKS_PRIVATE_BIN_DIR=${AGENT_GUARD_GITLEAKS_BIN_DIR:-${AGENT_GUARD_BIN_DIR:-$HOME/.agent-guard/bin}}
LIVE_PRE_TOOL_PROBE=AGENT_GUARD_LIVE_PRE_TOOL_PROBE
LIVE_POST_TOOL_PROBE=AGENT_GUARD_LIVE_POST_TOOL_PROBE
LIVE_POST_TOOL_REPLACEMENT_PREFIX='[REDACTED] agent-guard live probe run_id='
# Delimiters of the rc block `setup-shell` manages. `hook-session-start` reads
# them back to tell "setup-shell was never run" apart from "setup-shell ran, but
# the shell that launched the agent could not export the marker" — and from
# "setup-shell ran but the block can no longer load" — see shell_init_block_state.
SHELL_INIT_BLOCK_BEGIN='# >>> agent-guard shell-init >>>'
SHELL_INIT_BLOCK_END='# <<< agent-guard shell-init <<<'

usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard hook-pre-tool
  agent-guard hook-post-tool
  agent-guard hook-post-tool-failure
  agent-guard hook-stop
  agent-guard hook-session-start
  agent-guard hook-user-prompt
  agent-guard exec [--] <cmd> [args...]
  agent-guard shell-init [--bash|--zsh] [--no-command-wrapping]
  agent-guard setup-shell [--bash|--zsh|--rc FILE] [--no-command-wrapping]
  agent-guard pii-filter [--check]
  agent-guard mask-file [--key-paths] [--] FILE
  agent-guard scan-staged
  agent-guard scan-working-tree
  agent-guard scan-path PATH...
  agent-guard check
  agent-guard setup [--install --gitleaks-checksum SHA [--gitleaks-version X.Y.Z]]
  agent-guard doctor
  agent-guard logs [status|export [--output FILE]]
  agent-guard plugin status|install|update|uninstall [--host claude|codex|all] [--scope user|project|local] [--check]
  agent-guard update
  agent-guard smoke-test
  agent-guard checksum [VERSION]
  agent-guard version
EOF
}

plugin_usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard plugin status|install|update|uninstall [--host claude|codex|all] [--scope user|project|local]
  agent-guard plugin status --check

If --host is omitted, exactly one of claude or codex must be available. Claude
Code defaults to user scope. Codex supports user scope only.

Marketplaces are pinned to the release tag matching this CLI. If status reports
marketplace drift, remove that marketplace with the host manager and run install
again. Host marketplace removal also removes plugins installed from it.

status --check exits 1 when the marketplace pin or the installed plugin version
differs from this CLI (the drift status prints); without --check status exits 0
for drift. plugin update exits 2 when user action is needed (for example a
marketplace pinned to another release that must be removed and re-added).

status looks up the latest GitHub release only for an Agent Guard marketplace,
and update does so only when the installed plugin already matches this CLI
(AGENT_GUARD_RELEASE_CHECK=off skips it). When a newer release exists, update prints the host-manager commands that
move the marketplace pin forward; it never re-pins on its own.
EOF
}

# Resolve the latest release from the releases/latest HEAD redirect: no API
# token, no rate limit, no JSON. The redirect target is untrusted input, so only
# an exact tag URL with a three-field version is accepted and the raw URL is
# never printed. Sets LATEST_RELEASE_VERSION (not echoed, so the cache survives
# without a subshell) and succeeds when a version is known; `--host all` and
# doctor therefore look up once.
LATEST_RELEASE_VERSION=
LATEST_RELEASE_LOOKED_UP=0
latest_release_version() {
  if [ "$LATEST_RELEASE_LOOKED_UP" -eq 0 ]; then
    LATEST_RELEASE_LOOKED_UP=1
    if [ "${AGENT_GUARD_RELEASE_CHECK:-on}" != off ] && command -v curl >/dev/null 2>&1; then
      release_url=$(curl -fsSI --max-time 5 -o /dev/null -w '%{redirect_url}' \
        "$AG_REPO_URL/releases/latest" 2>/dev/null) || release_url=
      release_prefix="$AG_REPO_URL/releases/tag/v"
      case "$release_url" in
        "$release_prefix"*)
          release_tag=${release_url#"$release_prefix"}
          is_semver_dir "$release_tag" && LATEST_RELEASE_VERSION=$release_tag
          ;;
      esac
    fi
  fi
  [ -n "$LATEST_RELEASE_VERSION" ]
}

# Host-manager commands that move a pinned marketplace to $2 (a tag, or a
# placeholder when the latest release is unknown). Printed to stderr, never run.
print_release_forward_commands() {
  forward_host=$1
  forward_tag=$2
  forward_scope=$3
  case "$forward_host" in
    claude)
      printf '  claude plugin marketplace remove %s --scope %s\n' "$AG_MARKETPLACE" "$forward_scope" >&2
      printf '  claude plugin marketplace add %s@%s --scope %s\n' "$AG_REPO" "$forward_tag" "$forward_scope" >&2
      printf '  claude plugin install %s --scope %s\n' "$AG_PLUGIN_ID" "$forward_scope" >&2
      ;;
    codex)
      printf '  codex plugin marketplace remove %s\n' "$AG_MARKETPLACE" >&2
      printf '  codex plugin marketplace add %s@%s\n' "$AG_REPO" "$forward_tag" >&2
      printf '  codex plugin add %s\n' "$AG_PLUGIN_ID" >&2
      ;;
  esac
  printf '%s\n' "$PROGRAM: marketplace removal also removes its installed plugin; restart the host afterwards" >&2
}

# Codex trusts each hook by its entry hash and by the plugin's content hash, so
# a plugin update can mark every agent-guard hook "modified" while hooks.json
# stays byte-identical. Codex then skips them and no agent-guard process ever
# starts. Ask Codex (app-server hooks/list) instead of re-deriving its
# undocumented hashes. The answer is a snapshot of what a fresh Codex process
# reads for one directory, not observed dispatch; trust is never written here.
CODEX_TRUST_TIMEOUT_SECONDS=10
CODEX_TRUST_MAX_BYTES=4194304
CODEX_TRUST_EVENTS='["preToolUse","postToolUse","sessionStart","userPromptSubmit","stop"]'
CODEX_TRUST_STATE=
CODEX_TRUST_DETAIL=
CODEX_TRUST_CWD=
CODEX_TRUST_PROBE_PID=
CODEX_TRUST_GROUP=
CODEX_TRUST_WATCHDOG_PID=

# Runs as the leader of its own process group. hooks/list is sent only after a
# successful initialize reply. Closing stdin is what stops app-server, so the
# writer holds it open until the reply arrives or the deadline passes.
CODEX_TRUST_CLIENT='codex=$1 out=$2 cwd=$3 limit=$4 version=$5
deadline=$(( $(date +%s) + limit ))
replied() {
  jq -R -e --argjson id "$1" "fromjson? | select(type == \"object\" and .id == \$id) | $2" "$out" >/dev/null 2>&1
}
await() {
  until replied "$1" true; do
    [ "$(date +%s)" -lt "$deadline" ] || return 1
    sleep 0.1 2>/dev/null || sleep 1
  done
}
{
  jq -nc --arg v "$version" "{jsonrpc: \"2.0\", id: 1, method: \"initialize\", params: {clientInfo: {name: \"agent-guard\", title: \"agent-guard\", version: \$v}, capabilities: {}}}"
  await 1 && replied 1 "(.result | type == \"object\")" || exit 0
  printf "%s\n" "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\"}"
  jq -nc --arg cwd "$cwd" "{jsonrpc: \"2.0\", id: 2, method: \"hooks/list\", params: {cwds: [\$cwd]}}"
  await 2 || :
} | "$codex" app-server >"$out" 2>/dev/null'

clear_codex_trust_probe_processes() {
  if [ -n "$CODEX_TRUST_WATCHDOG_PID" ]; then
    kill -TERM "$CODEX_TRUST_WATCHDOG_PID" 2>/dev/null || :
    wait "$CODEX_TRUST_WATCHDOG_PID" 2>/dev/null || :
    CODEX_TRUST_WATCHDOG_PID=
  fi
  case "$CODEX_TRUST_GROUP" in
    ''|*[!0-9]*) ;;
    *)
      kill -TERM -"$CODEX_TRUST_GROUP" 2>/dev/null || :
      kill -KILL -"$CODEX_TRUST_GROUP" 2>/dev/null || :
      ;;
  esac
  # A signal can arrive before the launcher has called setsid, when no group
  # exists yet; the unreaped probe itself is still safe to signal.
  if [ -n "$CODEX_TRUST_PROBE_PID" ]; then
    kill -TERM "$CODEX_TRUST_PROBE_PID" 2>/dev/null || :
    kill -KILL "$CODEX_TRUST_PROBE_PID" 2>/dev/null || :
    wait "$CODEX_TRUST_PROBE_PID" 2>/dev/null || :
    CODEX_TRUST_PROBE_PID=
  fi
  CODEX_TRUST_GROUP=
}

# Sets CODEX_TRUST_STATE to ok, review, disabled, absent, or unverified. Only
# a complete, well-formed reply listing every expected hook once as trusted or
# managed and enabled is ok; anything that could not be read is unverified.
codex_trust_probe() {
  CODEX_TRUST_CWD=$1
  CODEX_TRUST_STATE=unverified
  CODEX_TRUST_DETAIL=
  if [ "${AGENT_GUARD_CODEX_TRUST_CHECK:-on}" = off ]; then
    CODEX_TRUST_DETAIL='check skipped by AGENT_GUARD_CODEX_TRUST_CHECK=off'
    return 0
  fi
  ct_codex=$(command -v codex 2>/dev/null) || ct_codex=
  if [ -z "$ct_codex" ]; then
    CODEX_TRUST_DETAIL='codex is not on PATH'
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    CODEX_TRUST_DETAIL='jq is required to read the Codex reply'
    return 0
  fi
  if ! select_gitleaks_probe_launcher; then
    CODEX_TRUST_DETAIL='setsid or perl is required to bound the Codex query'
    return 0
  fi
  ct_limit=$CODEX_TRUST_TIMEOUT_SECONDS
  if [ "${AG_PLUGIN_TEST_MODE:-0}" = 1 ]; then
    case "${AG_PLUGIN_TEST_CODEX_TRUST_TIMEOUT:-}" in
      ''|*[!0-9]*) ;;
      *) ct_limit=$AG_PLUGIN_TEST_CODEX_TRUST_TIMEOUT ;;
    esac
  fi
  ct_dir=
  [ -z "$AGENT_GUARD_RUNDIR" ] \
    || ct_dir=$(mktemp -d "$AGENT_GUARD_RUNDIR/codex-trust.XXXXXX" 2>/dev/null) \
    || ct_dir=
  if [ -z "$ct_dir" ]; then
    CODEX_TRUST_DETAIL='no private temporary directory for the Codex reply'
    return 0
  fi
  ct_out="$ct_dir/reply"
  : >"$ct_out" || {
    rm -rf "$ct_dir"
    CODEX_TRUST_DETAIL='no private temporary directory for the Codex reply'
    return 0
  }
  (
    # app-server's own state is not this probe's to place; run it outside the
    # project so the cwd cannot select a different Codex home or config.
    cd "$ct_dir" || exit 125
    exec_in_new_session sh -c "$CODEX_TRUST_CLIENT" agent-guard-codex-trust \
      "$ct_codex" "$ct_out" "$CODEX_TRUST_CWD" "$ct_limit" "$VERSION"
  ) </dev/null >/dev/null 2>&1 &
  CODEX_TRUST_PROBE_PID=$!
  CODEX_TRUST_GROUP=$CODEX_TRUST_PROBE_PID
  (
    ct_watch_sleep_pid=
    trap 'trap "" TERM INT
      if [ -n "$ct_watch_sleep_pid" ]; then
        kill -TERM "$ct_watch_sleep_pid" 2>/dev/null || :
        kill -KILL "$ct_watch_sleep_pid" 2>/dev/null || :
        wait "$ct_watch_sleep_pid" 2>/dev/null || :
      fi
      exit 0' TERM INT
    # The client stops writing at the deadline; this bounds a server that
    # ignores end of input or a client that cannot run at all.
    sleep "$((ct_limit + 2))" &
    ct_watch_sleep_pid=$!
    wait "$ct_watch_sleep_pid" 2>/dev/null || exit 0
    ct_watch_sleep_pid=
    kill -0 "$CODEX_TRUST_PROBE_PID" 2>/dev/null || exit 0
    kill -TERM -"$CODEX_TRUST_GROUP" 2>/dev/null \
      || kill -TERM "$CODEX_TRUST_PROBE_PID" 2>/dev/null || :
    sleep 1 &
    ct_watch_sleep_pid=$!
    wait "$ct_watch_sleep_pid" 2>/dev/null || exit 0
    ct_watch_sleep_pid=
    kill -KILL -"$CODEX_TRUST_GROUP" 2>/dev/null \
      || kill -KILL "$CODEX_TRUST_PROBE_PID" 2>/dev/null || :
  ) &
  CODEX_TRUST_WATCHDOG_PID=$!
  wait "$CODEX_TRUST_PROBE_PID" 2>/dev/null
  CODEX_TRUST_PROBE_PID=
  # Always clear the probe-private group: app-server may leave helpers behind.
  clear_codex_trust_probe_processes

  ct_bytes=$(LC_ALL=C wc -c <"$ct_out" 2>/dev/null | tr -d '[:space:]')
  case "$ct_bytes" in
    ''|*[!0-9]*) ct_bytes=$((CODEX_TRUST_MAX_BYTES + 1)) ;;
  esac
  if [ "$ct_bytes" -gt "$CODEX_TRUST_MAX_BYTES" ]; then
    CODEX_TRUST_DETAIL='Codex reply exceeded the size limit'
    rm -rf "$ct_dir"
    return 0
  fi
  ct_verdict=$(jq -R -s -r --argjson expected "$CODEX_TRUST_EVENTS" --arg id "$AG_PLUGIN_ID" '
    def names: map(.eventName) | join(", ");
    [splits("\n") | select(length > 0) | (try fromjson catch null)] as $m
    | ($m | map(select(type == "object" and .id == 1))) as $init
    | ($m | map(select(type == "object" and .id == 2))) as $list
    | if any($m[]; type != "object") then
        "unverified\tunreadable Codex reply"
      elif ($init | length) != 1 or ($init[0].result | type) != "object" then
        "unverified\tCodex app-server did not initialize"
      elif ($list | length) != 1 then
        "unverified\tCodex did not answer hooks/list in time"
      elif ($list[0].result.data | type) != "array" or ($list[0].result.data | length) != 1 then
        "unverified\tunexpected hooks/list reply"
      else
        $list[0].result.data[0] as $entry
        | if ($entry.hooks | type) != "array" or ($entry.errors | type) != "array" then
            "unverified\tunexpected hooks/list reply"
          else
            ($entry.hooks | map(select(type == "object" and .pluginId == $id))) as $ag
            # A hook Codex lists as needing review or turned off is skipped even
            # when other entries failed to load; errors only block absent and ok.
            | if any($ag[]; (.eventName | type) != "string"
                  or (.trustStatus | type) != "string"
                  or (.enabled | type) != "boolean") then
                "unverified\tunexpected agent-guard hook entry"
              elif any($ag[]; .trustStatus == "modified" or .trustStatus == "untrusted") then
                "review\t" + ($ag | map(select(.trustStatus == "modified" or .trustStatus == "untrusted")) | names)
              elif any($ag[]; .trustStatus != "trusted" and .trustStatus != "managed") then
                "unverified\tunknown hook trust status"
              elif any($ag[]; .enabled != true) then
                "disabled\t" + ($ag | map(select(.enabled != true)) | names)
              elif ($entry.errors | length) > 0 then
                "unverified\tCodex reported hook configuration errors"
              elif ($ag | length) == 0 then
                "absent\t"
              elif ([$ag[].eventName] | sort) != ($expected | sort) then
                "unverified\texpected agent-guard hooks are missing or duplicated"
              else
                "ok\t"
              end
          end
      end
  ' "$ct_out" 2>/dev/null) || ct_verdict="unverified	unreadable Codex reply"
  rm -rf "$ct_dir"
  CODEX_TRUST_STATE=${ct_verdict%%	*}
  CODEX_TRUST_DETAIL=${ct_verdict#*	}
  case "$CODEX_TRUST_STATE" in
    ok|review|disabled|absent) ;;
    *) CODEX_TRUST_STATE=unverified ;;
  esac
  [ -n "$CODEX_TRUST_DETAIL" ] || [ "$CODEX_TRUST_STATE" != unverified ] \
    || CODEX_TRUST_DETAIL='unreadable Codex reply'
  return 0
}

# $1 is plugin when the Codex plugin manager reported agent-guard installed and
# enabled, so an empty hook list cannot mean "not installed". Returns 1 only
# when Codex's own reply shows that it will not run agent-guard hooks.
codex_trust_report() {
  case "$CODEX_TRUST_STATE" in
    ok)
      info "$PROGRAM: codex hook trust: ok (agent-guard hooks are trusted and enabled for $CODEX_TRUST_CWD; configuration snapshot, not observed dispatch)"
      ;;
    review)
      info "$PROGRAM: codex hook trust: needs review for $CODEX_TRUST_CWD ($CODEX_TRUST_DETAIL); Codex skips these agent-guard hooks until they are trusted again"
      info "$PROGRAM: to re-trust, start 'codex' in that directory and choose 'Review hooks' at 'Hooks need review';"
      info "  trust a hook only after checking that its Source is $AG_PLUGIN_ID and its command is expected,"
      info "  then restart Codex sessions that were already running"
      return 1
      ;;
    disabled)
      info "$PROGRAM: codex hook trust: disabled for $CODEX_TRUST_CWD ($CODEX_TRUST_DETAIL); Codex will not run these agent-guard hooks until they are turned back on in its hook list"
      return 1
      ;;
    absent)
      if [ "${1:-}" = plugin ]; then
        info "$PROGRAM: codex hook trust: unverified (Codex lists no agent-guard hooks for $CODEX_TRUST_CWD although the plugin is installed and enabled)"
      else
        info "$PROGRAM: codex hook trust: Codex loads no agent-guard hooks for $CODEX_TRUST_CWD (plugin not installed or not enabled for Codex)"
      fi
      ;;
    *)
      info "$PROGRAM: codex hook trust: unverified ($CODEX_TRUST_DETAIL)"
      ;;
  esac
  return 0
}

plugin_codex_trust() {
  ct_here=$(pwd -P 2>/dev/null) || ct_here=$PWD
  codex_trust_probe "$ct_here"
  codex_trust_report plugin || :
}

# jq over a host plugin manager's JSON, with the identity bound. The program
# may use these definitions. $3 of the callers below is the Claude scope;
# a row without one is user-scoped.
PLUGIN_JQ_DEFS='
  def is_repo_url: . == $url or . == $url + ".git";
  def marketplace: select(.name == $marketplace);
  def claude_row($scope):
    .[] | select((.id // .pluginId // "") == $id and (.scope // "user") == $scope);
  def codex_row: .installed[] | select(.pluginId == $id and .installed == true);
  def plugin_row($host; $scope): if $host == "codex" then codex_row else claude_row($scope) end;
'
plugin_jq() {
  plugin_jq_flag=$1
  plugin_jq_program=$2
  shift 2
  jq "$plugin_jq_flag" --arg marketplace "$AG_MARKETPLACE" --arg id "$AG_PLUGIN_ID" \
    --arg repo "$AG_REPO" --arg url "$AG_REPO_URL" \
    "$PLUGIN_JQ_DEFS $plugin_jq_program" "$@"
}

plugin_marketplace_source_is_agent_guard() {
  plugin_host=$1
  plugin_json=$2
  case "$plugin_host" in
    claude)
      plugin_jq -e '.[] | marketplace
        | (((.source // "") == "github" and (.repo // "") == $repo) or
           ((.source // "") == "git" and (.url // "" | is_repo_url)))' \
        "$plugin_json" >/dev/null 2>&1
      ;;
    codex)
      plugin_jq -e '.marketplaces[] | marketplace
        | (.marketplaceSource.source // "") as $source
        | ((.marketplaceSource.sourceType // "") == "git") and
          ($source == $repo or ($source | is_repo_url))' \
        "$plugin_json" >/dev/null 2>&1
      ;;
  esac
}

# Claude exposes the configured Git ref in marketplace-list JSON. Codex 0.153.4
# does not; for mutating actions we use `marketplace add owner/repo@ref` as the
# official manager's idempotence probe. It succeeds for the same ref and rejects
# an existing unpinned or different ref without changing host state.
claude_marketplace_matches_release() {
  plugin_jq -e '.[] | marketplace | (.ref // "") == $ref' \
    --arg ref "v$VERSION" "$1" >/dev/null 2>&1
}

claude_marketplace_ref() {
  plugin_jq -r '.[] | marketplace | .ref // "unpinned"' "$1" | head -n 1
}

plugin_marketplace_present() {
  case "$1" in
    claude) plugin_jq -e '.[] | marketplace' "$2" >/dev/null 2>&1 ;;
    codex) plugin_jq -e '.marketplaces[] | marketplace' "$2" >/dev/null 2>&1 ;;
  esac
}

plugin_installed() {
  plugin_jq -e 'plugin_row($host; $scope)' \
    --arg host "$1" --arg scope "$3" "$2" >/dev/null 2>&1
}

plugin_version() {
  plugin_jq -r 'plugin_row($host; $scope) | .version // "unknown"' \
    --arg host "$1" --arg scope "$3" "$2" | head -n 1
}

plugin_enabled() {
  plugin_jq -e 'plugin_row($host; $scope) | .enabled == true' \
    --arg host "$1" --arg scope "$3" "$2" >/dev/null 2>&1
}

claude_managed_plugin_present() {
  plugin_installed claude "$1" managed
}

# Claude's marketplace-list JSON intentionally omits settings provenance for
# ordinary Git/GitHub marketplaces. Read the administrator-owned source instead
# so a first-sync/download failure cannot make a managed declaration look like a
# self-managed marketplace. Return 0 for an Agent Guard declaration, 1 when all
# available files are valid but unrelated, and 2 when their state is unsafe to
# determine. Return 3 when policyHelper replaces their values dynamically.
# Mutations fail closed on 2 or 3; status reports the configuration limitation.
claude_managed_settings_state() (
  # Path injection exists only for isolated tests. It is deliberately gated and
  # does not turn this user-run helper into an OS policy enforcement boundary.
  if [ "${AG_PLUGIN_TEST_MODE:-0}" = 1 ] \
      && [ -n "${AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT:-}" ]; then
    managed_root=$AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT
  elif [ -n "${AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT:-}" ]; then
    return 2
  else
    case "$(uname -s)" in
      Darwin) managed_root='/Library/Application Support/ClaudeCode' ;;
      Linux) managed_root='/etc/claude-code' ;;
      *) return 1 ;;
    esac
  fi
  case "$managed_root" in /*) ;; *) return 2 ;; esac

  if [ -e "$managed_root" ] || [ -L "$managed_root" ]; then
    [ -d "$managed_root" ] && [ -r "$managed_root" ] && [ -x "$managed_root" ] \
      || return 2
  fi
  managed_fragments="$managed_root/managed-settings.d"
  if [ -e "$managed_fragments" ] || [ -L "$managed_fragments" ]; then
    [ -d "$managed_fragments" ] && [ -r "$managed_fragments" ] && [ -x "$managed_fragments" ] \
      || return 2
  fi

  # Marketplace names remain as merge keys. Raw marketplace values,
  # policy-helper paths, and unrelated settings never enter this file; only
  # Agent Guard ownership classifications do. The subshell traps also remove a
  # mktemp_file fallback outside the invocation rundir on returns and signals.
  managed_summary=$(mktemp_file) || return 2
  trap 'rm -f "$managed_summary"' 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for managed_file in \
    "$managed_root/managed-settings.json" \
    "$managed_fragments"/*.json; do
    [ -e "$managed_file" ] || [ -L "$managed_file" ] || continue
    [ -f "$managed_file" ] && [ -r "$managed_file" ] || return 2
    plugin_jq -cs '
      def valid_policy_helper:
        type == "object" and
        (.path | type == "string" and startswith("/")) and
        ((has("timeoutMs") | not) or (.timeoutMs | type == "number")) and
        ((has("refreshIntervalMs") | not) or
         (.refreshIntervalMs | type == "number"));
      def compact_source:
        {} +
        (if has("source") then
           {source: (if .source == "github" or .source == "git"
                     then .source else "other" end)}
         else {} end) +
        (if has("repo") then
           {repo: (if .repo == $repo
                   then "agent-guard" else "other" end)}
         else {} end) +
        (if has("url") then
           {url: (if .url | is_repo_url
                  then "agent-guard" else "other" end)}
         else {} end);
      def compact_marketplace:
        if type != "object" then "other"
        elif has("source") and (.source | type) != "object" then
          {source: "other"}
        elif has("source") then {source: (.source | compact_source)}
        else {}
        end;
      if length == 0 then {}
      elif length == 1 and (.[0] | type == "object") then .[0]
      else error("managed settings must contain one object")
      end
      | if (has("extraKnownMarketplaces") and
            (.extraKnownMarketplaces | type) != "object") then
        error("extraKnownMarketplaces must be an object")
      elif (has("enabledPlugins") and (.enabledPlugins | type) != "object") then
        error("enabledPlugins must be an object")
      elif (has("policyHelper") and
            ((.policyHelper | valid_policy_helper) | not)) then
        error("policyHelper must name an absolute executable path")
      else
        ({
          extraKnownMarketplaces:
            ((.extraKnownMarketplaces // {})
             | with_entries(.value |= compact_marketplace)),
          enabledPlugins:
            (if ((.enabledPlugins // {}) | has($id))
             then {($id): true}
             else {}
             end)
        } + if has("policyHelper") then {policyHelper: true} else {} end)
      end
    ' "$managed_file" >>"$managed_summary" 2>/dev/null || return 2
  done

  managed_state=$(plugin_jq -rs '
      def agent_guard_source:
        type == "object" and
        ((.source == "github" and .repo == "agent-guard") or
         (.source == "git" and
          .url == "agent-guard"));
      reduce .[] as $document ({}; . * $document)
      | if has("policyHelper") then "dynamic"
        elif (((.extraKnownMarketplaces // {})
               | any(.[]; (.source? | agent_guard_source))) or
              ((.enabledPlugins // {}) | has($id))) then
          "managed"
        else "unrelated"
        end
    ' "$managed_summary" 2>/dev/null) || return 2
  case "$managed_state" in
    managed) return 0 ;;
    unrelated) return 1 ;;
    dynamic) return 3 ;;
    *) return 2 ;;
  esac
)

claude_managed_status() {
  plugin_plugins=$1
  if claude_managed_plugin_present "$plugin_plugins"; then
    managed_version=$(plugin_version claude "$plugin_plugins" managed)
    if plugin_enabled claude "$plugin_plugins" managed; then
      managed_enabled=enabled
    else
      managed_enabled=disabled
    fi
    if [ "$managed_version" = "$VERSION" ]; then
      managed_version_status="version $managed_version"
    else
      plugin_drift=1
      managed_version_status="version $managed_version, expected $VERSION"
    fi
    printf 'claude: managed by Jamf/managed settings (plugin installed, %s, %s)\n' \
      "$managed_enabled" "$managed_version_status"
  else
    printf '%s\n' 'claude: managed by Jamf/managed settings (Agent Guard configured, plugin not installed)'
  fi
}

plugin_read_state() {
  plugin_host=$1
  plugin_marketplaces=$2
  plugin_plugins=$3
  case "$plugin_host" in
    claude)
      claude plugin marketplace list --json >"$plugin_marketplaces" \
        && claude plugin list --json >"$plugin_plugins" \
        && jq -e 'type == "array"' "$plugin_marketplaces" >/dev/null 2>&1 \
        && jq -e 'type == "array"' "$plugin_plugins" >/dev/null 2>&1
      ;;
    codex)
      codex plugin marketplace list --json >"$plugin_marketplaces" \
        && codex plugin list --json >"$plugin_plugins" \
        && jq -e 'type == "object" and (.marketplaces | type == "array")' "$plugin_marketplaces" >/dev/null 2>&1 \
        && jq -e 'type == "object" and (.installed | type == "array")' "$plugin_plugins" >/dev/null 2>&1
      ;;
  esac
}

# Every exit from plugin_for_host_body is a return, so the wrapper removes the
# state directory once. A path that has already removed it clears plugin_tmp.
plugin_for_host() {
  plugin_action=$1
  plugin_host=$2
  plugin_scope=$3
  plugin_drift=0
  plugin_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-plugin.XXXXXX") || {
    printf '%s\n' "$PROGRAM: could not create plugin status directory" >&2
    return 2
  }
  plugin_for_host_body
  plugin_status=$?
  if [ "$plugin_status" -eq 0 ] && [ "$plugin_check" -eq 1 ] && [ "$plugin_drift" -eq 1 ]; then
    plugin_status=1
  fi
  [ -z "$plugin_tmp" ] || rm -rf "$plugin_tmp"
  return "$plugin_status"
}

plugin_set_retry() {
  cli_ref_init
  plugin_retry="$AG_CLI_REF plugin $1 --host $plugin_host"
  if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
    plugin_retry="$plugin_retry --scope $plugin_scope"
  fi
}

# Refuse an Agent Guard marketplace that is not pinned to this release. $1 is
# the refusal clause for the current action.
plugin_require_release_pin() {
  plugin_marketplace_matches=0
  case "$plugin_host" in
    claude)
      claude_marketplace_matches_release "$plugin_marketplaces" \
        && plugin_marketplace_matches=1
      ;;
    codex)
      codex plugin marketplace add "$AG_REPO@v$VERSION" \
        && plugin_marketplace_matches=1
      ;;
  esac
  [ "$plugin_marketplace_matches" -eq 0 ] || return 0
  if [ "$plugin_host" = claude ]; then
    plugin_actual_ref=$(claude_marketplace_ref "$plugin_marketplaces")
    plugin_remove="claude plugin marketplace remove $AG_MARKETPLACE --scope $plugin_scope"
  else
    plugin_actual_ref='unverified or different ref'
    plugin_remove="codex plugin marketplace remove $AG_MARKETPLACE"
  fi
  plugin_set_retry install
  printf '%s\n' "$PROGRAM: $plugin_host marketplace '$AG_MARKETPLACE' is '$plugin_actual_ref', expected 'v$VERSION'; $1" >&2
  printf '%s\n' "$PROGRAM: run '$plugin_remove', then '$plugin_retry'; marketplace removal also removes its installed plugin" >&2
  return 2
}

plugin_for_host_body() {
  plugin_marketplaces="$plugin_tmp/marketplaces.json"
  plugin_plugins="$plugin_tmp/plugins.json"

  if ! plugin_read_state "$plugin_host" "$plugin_marketplaces" "$plugin_plugins"; then
    printf '%s\n' "$PROGRAM: $plugin_host plugin manager could not report its state" >&2
    return 1
  fi

  plugin_managed_state=1
  if [ "$plugin_host" = claude ]; then
    if claude_managed_plugin_present "$plugin_plugins"; then
      plugin_managed_state=0
    else
      claude_managed_settings_state
      plugin_managed_state=$?
    fi
  fi
  if [ "$plugin_managed_state" -eq 2 ]; then
    if [ "$plugin_action" = status ]; then
      printf '%s\n' "$PROGRAM: Claude managed settings could not be read or safely parsed; plugin ownership cannot be determined" >&2
    else
      printf '%s\n' "$PROGRAM: Claude managed settings could not be read or safely parsed; refusing plugin lifecycle changes" >&2
    fi
    return 2
  fi
  if [ "$plugin_managed_state" -eq 3 ]; then
    printf '%s\n' "$PROGRAM: Claude policyHelper replaces file-based managed settings; plugin ownership cannot be determined, so lifecycle changes are refused" >&2
    return 2
  fi
  if [ "$plugin_managed_state" -eq 0 ]; then
    if [ "$plugin_action" = status ]; then
      claude_managed_status "$plugin_plugins"
      return 0
    fi
    printf '%s\n' "$PROGRAM: Claude Agent Guard is managed by Jamf/managed settings; ask the administrator to change the pinned marketplace ref instead of using '$PROGRAM plugin $plugin_action'" >&2
    return 2
  fi
  if [ "$plugin_managed_state" -ne 1 ]; then
    printf '%s\n' "$PROGRAM: Claude managed settings inspection was interrupted; refusing plugin lifecycle changes" >&2
    return 2
  fi

  if plugin_marketplace_present "$plugin_host" "$plugin_marketplaces"; then
    plugin_has_marketplace=1
    if plugin_marketplace_source_is_agent_guard "$plugin_host" "$plugin_marketplaces"; then
      plugin_marketplace_source=agent-guard
    else
      plugin_marketplace_source=conflict
    fi
  else
    plugin_has_marketplace=0
    plugin_marketplace_source=missing
  fi
  if plugin_installed "$plugin_host" "$plugin_plugins" "$plugin_scope"; then
    plugin_has_install=1
    if plugin_enabled "$plugin_host" "$plugin_plugins" "$plugin_scope"; then
      plugin_is_enabled=1
    else
      plugin_is_enabled=0
    fi
  else
    plugin_has_install=0
    plugin_is_enabled=0
  fi

  case "$plugin_action" in
    status)
      case "$plugin_marketplace_source" in
        agent-guard)
          if [ "$plugin_host" = claude ]; then
            if claude_marketplace_matches_release "$plugin_marketplaces"; then
              plugin_marketplace_status="configured at v$VERSION"
            else
              plugin_drift=1
              plugin_marketplace_status="drift: $(claude_marketplace_ref "$plugin_marketplaces"), expected v$VERSION"
            fi
          else
            plugin_marketplace_status='configured, pin unverified by Codex'
          fi
          ;;
        conflict) plugin_marketplace_status='conflict: different source' ;;
        missing) plugin_marketplace_status=missing ;;
      esac
      if [ "$plugin_has_install" -eq 1 ]; then
        plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
        if [ "$plugin_installed_version" = "$VERSION" ]; then
          plugin_version_status="version $plugin_installed_version"
        else
          plugin_drift=1
          plugin_version_status="version $plugin_installed_version, expected $VERSION"
        fi
        printf '%s: installed, %s (%s, marketplace %s)\n' \
          "$plugin_host" "$([ "$plugin_is_enabled" -eq 1 ] && printf enabled || printf disabled)" \
          "$plugin_version_status" "$plugin_marketplace_status"
        if [ "$plugin_host" = codex ] && [ "$plugin_is_enabled" -eq 1 ]; then
          plugin_codex_trust
        fi
      else
        printf '%s: not installed (marketplace %s)\n' \
          "$plugin_host" "$plugin_marketplace_status"
      fi
      if [ "$plugin_marketplace_source" = agent-guard ]; then
        if latest_release_version; then
          if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
            printf '%s: latest release v%s; this CLI is %s\n' \
              "$plugin_host" "$LATEST_RELEASE_VERSION" "$VERSION"
          else
            printf '%s: latest release v%s\n' "$plugin_host" "$LATEST_RELEASE_VERSION"
          fi
        else
          printf '%s: latest release unknown\n' "$plugin_host"
        fi
      fi
      ;;
    install)
      if [ "$plugin_marketplace_source" = conflict ]; then
        printf '%s\n' "$PROGRAM: $plugin_host marketplace '$AG_MARKETPLACE' has a different source; refusing to replace it" >&2
        return 2
      fi
      if [ "$plugin_marketplace_source" = agent-guard ]; then
        plugin_require_release_pin 'refusing to reuse it' || return 2
      fi
      if [ "$plugin_has_install" -eq 1 ]; then
        if [ "$plugin_is_enabled" -eq 0 ]; then
          printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin is installed but disabled; enable it with the $plugin_host plugin manager" >&2
          return 1
        fi
        plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
        if [ "$plugin_installed_version" != "$VERSION" ]; then
          plugin_set_retry update
          printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin version is $plugin_installed_version, expected $VERSION; run '$plugin_retry'" >&2
          return 1
        fi
        printf '%s: agent-guard plugin is already installed and enabled (version %s, marketplace v%s)\n' \
          "$plugin_host" "$plugin_installed_version" "$VERSION"
        [ "$plugin_host" != codex ] || plugin_codex_trust
      else
        plugin_marketplace_added=0
        if [ "$plugin_has_marketplace" -eq 0 ]; then
          case "$plugin_host" in
            claude) claude plugin marketplace add "$AG_REPO@v$VERSION" --scope "$plugin_scope" ;;
            codex) codex plugin marketplace add "$AG_REPO@v$VERSION" ;;
          esac
          plugin_add_status=$?
          if [ "$plugin_add_status" -ne 0 ]; then
            plugin_set_retry install
            printf '%s\n' "$PROGRAM: $plugin_host could not add marketplace '$AG_MARKETPLACE' pinned to v$VERSION; no plugin installation was attempted and it is safe to retry '$plugin_retry'" >&2
            return 1
          fi
          plugin_marketplace_added=1
        fi
        case "$plugin_host" in
          claude) claude plugin install "$AG_PLUGIN_ID" --scope "$plugin_scope" ;;
          codex) codex plugin add "$AG_PLUGIN_ID" ;;
        esac
        plugin_install_status=$?
        if [ "$plugin_install_status" -ne 0 ] && [ "$plugin_marketplace_added" -eq 1 ]; then
          plugin_set_retry install
          printf '%s\n' "$PROGRAM: $plugin_host marketplace '$AG_MARKETPLACE' was added, but plugin installation failed; the marketplace remains configured and it is safe to retry '$plugin_retry'" >&2
        fi
        if [ "$plugin_install_status" -eq 0 ] && [ "$plugin_host" = codex ]; then
          plugin_codex_trust
        fi
        [ "$plugin_install_status" -eq 0 ]
      fi
      ;;
    update)
      if [ "$plugin_marketplace_source" = conflict ]; then
        printf '%s\n' "$PROGRAM: $plugin_host marketplace '$AG_MARKETPLACE' has a different source; refusing to replace it" >&2
        return 2
      fi
      if [ "$plugin_has_marketplace" -eq 0 ] || [ "$plugin_has_install" -eq 0 ]; then
        cli_ref_init
        printf '%s\n' "$PROGRAM: $plugin_host plugin is not installed; run '$AG_CLI_REF plugin install --host $plugin_host' first" >&2
        return 1
      fi
      plugin_require_release_pin 'refusing to update through it' || return 2
      if [ "$plugin_is_enabled" -eq 0 ]; then
        printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin is installed but disabled; update will keep it disabled" >&2
      fi
      plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
      if [ "$plugin_installed_version" = "$VERSION" ]; then
        printf '%s: agent-guard plugin already matches this CLI (version %s, marketplace v%s)\n' \
          "$plugin_host" "$VERSION" "$VERSION"
        rm -rf "$plugin_tmp"
        plugin_tmp=
        # This binary lives in the cache that marketplace removal deletes, so
        # moving to a newer release is printed for the user, never performed.
        if latest_release_version; then
          if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
            printf '%s\n' "$PROGRAM: this CLI is $VERSION and can only pin the marketplace to v$VERSION; to move to v$LATEST_RELEASE_VERSION, run:" >&2
            print_release_forward_commands "$plugin_host" "v$LATEST_RELEASE_VERSION" "$plugin_scope"
          elif [ "$LATEST_RELEASE_VERSION" = "$VERSION" ]; then
            printf '%s\n' "$PROGRAM: v$VERSION matches the latest release v$LATEST_RELEASE_VERSION" >&2
          else
            printf '%s\n' "$PROGRAM: latest release is v$LATEST_RELEASE_VERSION" >&2
          fi
        else
          printf '%s\n' "$PROGRAM: this CLI is $VERSION and can only pin the marketplace to v$VERSION; the latest release could not be looked up. To move to a newer release v<X.Y.Z> from $AG_REPO_URL/releases, run:" >&2
          print_release_forward_commands "$plugin_host" 'v<X.Y.Z>' "$plugin_scope"
        fi
        if [ "$plugin_host" = codex ] && [ "$plugin_is_enabled" -eq 1 ]; then
          plugin_codex_trust
        fi
        return 0
      fi
      case "$plugin_host" in
        claude)
          claude plugin marketplace update "$AG_MARKETPLACE" \
            && claude plugin update "$AG_PLUGIN_ID" --scope "$plugin_scope"
          ;;
        codex) codex plugin marketplace upgrade "$AG_MARKETPLACE" ;;
      esac
      plugin_update_status=$?
      if [ "$plugin_update_status" -ne 0 ]; then
        plugin_set_retry update
        printf '%s\n' "$PROGRAM: $plugin_host update did not complete; the marketplace remains pinned to v$VERSION and it is safe to retry '$plugin_retry'" >&2
      elif [ "$plugin_host" = codex ] && [ "$plugin_is_enabled" -eq 1 ]; then
        # A content change is exactly what invalidates Codex hook trust.
        plugin_codex_trust
      fi
      [ "$plugin_update_status" -eq 0 ]
      ;;
    uninstall)
      if [ "$plugin_marketplace_source" = conflict ]; then
        printf '%s\n' "$PROGRAM: $plugin_host marketplace '$AG_MARKETPLACE' has a different source; refusing plugin lifecycle changes" >&2
        return 2
      fi
      if [ "$plugin_has_install" -eq 0 ]; then
        printf '%s\n' "$plugin_host: agent-guard plugin is not installed"
      else
        case "$plugin_host" in
          claude) claude plugin uninstall "$AG_PLUGIN_ID" --scope "$plugin_scope" ;;
          codex) codex plugin remove "$AG_PLUGIN_ID" ;;
        esac
      fi
      ;;
  esac
}

do_plugin() {
  plugin_action=${1:-}
  case "$plugin_action" in
    status|install|update|uninstall) shift ;;
    -h|--help|help) plugin_usage; return 0 ;;
    *) plugin_usage; return 2 ;;
  esac
  plugin_host=
  plugin_scope=user
  plugin_check=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || { plugin_usage; return 2; }
        plugin_host=$2
        shift 2
        ;;
      --scope)
        [ "$#" -ge 2 ] || { plugin_usage; return 2; }
        plugin_scope=$2
        shift 2
        ;;
      --check)
        plugin_check=1
        shift
        ;;
      -h|--help) plugin_usage; return 0 ;;
      *) plugin_usage; return 2 ;;
    esac
  done
  [ "$plugin_check" -eq 0 ] || [ "$plugin_action" = status ] || { plugin_usage; return 2; }
  case "$plugin_host" in ''|claude|codex|all) ;; *) plugin_usage; return 2 ;; esac
  case "$plugin_scope" in user|project|local) ;; *) plugin_usage; return 2 ;; esac
  command -v jq >/dev/null 2>&1 || {
    printf '%s\n' "$PROGRAM: jq is required to inspect plugin-manager state" >&2
    return 1
  }

  plugin_has_claude=0
  plugin_has_codex=0
  command -v claude >/dev/null 2>&1 && plugin_has_claude=1
  command -v codex >/dev/null 2>&1 && plugin_has_codex=1
  if [ -z "$plugin_host" ]; then
    if [ "$plugin_has_claude" -eq 1 ] && [ "$plugin_has_codex" -eq 0 ]; then
      plugin_host=claude
    elif [ "$plugin_has_codex" -eq 1 ] && [ "$plugin_has_claude" -eq 0 ]; then
      plugin_host=codex
    else
      printf '%s\n' "$PROGRAM: omit --host only when exactly one of claude or codex is available" >&2
      return 2
    fi
  fi
  if { [ "$plugin_host" = codex ] || [ "$plugin_host" = all ]; } && [ "$plugin_scope" != user ]; then
    printf '%s\n' "$PROGRAM: Codex plugin management supports user scope only" >&2
    return 2
  fi

  plugin_result=0
  case "$plugin_host" in
    claude)
      [ "$plugin_has_claude" -eq 1 ] || { printf '%s\n' "$PROGRAM: claude command not found" >&2; return 1; }
      plugin_for_host "$plugin_action" claude "$plugin_scope"
      ;;
    codex)
      [ "$plugin_has_codex" -eq 1 ] || { printf '%s\n' "$PROGRAM: codex command not found" >&2; return 1; }
      plugin_for_host "$plugin_action" codex "$plugin_scope"
      ;;
    all)
      if [ "$plugin_has_claude" -eq 1 ]; then
        plugin_for_host "$plugin_action" claude "$plugin_scope" || plugin_result=1
      else
        printf '%s\n' "$PROGRAM: claude command not found" >&2
        plugin_result=1
      fi
      if [ "$plugin_has_codex" -eq 1 ]; then
        plugin_for_host "$plugin_action" codex "$plugin_scope" || plugin_result=1
      else
        printf '%s\n' "$PROGRAM: codex command not found" >&2
        plugin_result=1
      fi
      return "$plugin_result"
      ;;
  esac
}

info() {
  printf '%s\n' "$*" >&2
}

# Local support log. Only fixed vocabulary and numeric metadata reach disk.
# Never pass hook JSON, diagnostics, arguments, paths or environment values here.
AG_AUDIT_FILE=
AG_AUDIT_ID=
AG_AUDIT_START=0
AG_LIVE_PROBE_MARKER=
# Set once by audit_begin; the audit helpers otherwise start uname and id on
# every ownership check.
AG_OS=
AG_UID=
# The private directory audit_begin validated, or empty. With logging off it is
# set only for an explicit AGENT_GUARD_SCAN_CACHE=on, and no event file is
# written.
AG_STATE_DIR=

audit_location() {
  printf '%s/agent-guard' "${XDG_STATE_HOME:-${HOME:-}/.local/state}"
}

# file_stat FIELDS FOLLOW FILE... prints one line per FILE through BSD or GNU
# stat. FOLLOW is -L to follow a symlink or -P not to. FIELDS is one of:
#   access    uid:mode
#   entry     uid:mode:links:ctime
#   identity  dev:inode:size:mtime:ctime, with sub-second times
# Caches trust identity to notice a rewrite, so it fails where stat is not
# known to print sub-second times (%F): a same-size rewrite within one second
# would otherwise keep a stale entry. Those platforms run uncached.
file_stat() {
  ag_fs_os=${AG_OS:-$(uname -s)}
  case "$ag_fs_os:$1" in
    Darwin:access|*BSD:access|DragonFly:access) ag_fs_format='-f %u:%Lp' ;;
    Darwin:entry|*BSD:entry|DragonFly:entry) ag_fs_format='-f %u:%Lp:%l:%c' ;;
    Darwin:identity) ag_fs_format='-f %d:%i:%z:%Fm:%Fc' ;;
    *BSD:identity|DragonFly:identity) return 1 ;;
    *:access) ag_fs_format='-c %u:%a' ;;
    *:entry) ag_fs_format='-c %u:%a:%h:%Z' ;;
    *:identity) ag_fs_format='-c %d:%i:%s:%y:%z' ;;
    *) return 1 ;;
  esac
  ag_fs_follow=$2
  shift 2
  # BSD stat wants every option before the operands.
  if [ "$ag_fs_follow" = -L ]; then
    stat -L "${ag_fs_format%% *}" "${ag_fs_format#* }" "$@" 2>/dev/null
  else
    stat "${ag_fs_format%% *}" "${ag_fs_format#* }" "$@" 2>/dev/null
  fi
}

# Succeeds when $1 is absolute, holds no control character, has no empty, `.`
# or `..` component, and no component is a symlink. Shell tests only, so it
# costs no process on a hook (#407); a shell pattern, unlike a line-oriented
# grep, also refuses a newline.
plain_absolute_path() {
  case "$1" in /*) ;; *) return 1 ;; esac
  case "$1" in *[[:cntrl:]]*) return 1 ;; esac
  ag_pap_prefix=
  ag_pap_rest=${1#/}
  while [ -n "$ag_pap_rest" ]; do
    ag_pap_part=${ag_pap_rest%%/*}
    case "$ag_pap_part" in ''|.|..) return 1 ;; esac
    ag_pap_prefix="$ag_pap_prefix/$ag_pap_part"
    [ ! -L "$ag_pap_prefix" ] || return 1
    case "$ag_pap_rest" in */*) ag_pap_rest=${ag_pap_rest#*/} ;; *) ag_pap_rest= ;; esac
  done
}

# Succeeds when $1 is a directory, not a symlink, this user's, and mode 0700.
private_dir_ok() {
  [ -d "$1" ] && [ ! -L "$1" ] \
    && [ "$(file_stat access -P "$1")" = "${AG_UID:-$(id -u)}:700" ]
}

# Between private_writes_begin and private_writes_end a redirection creates a
# file with mode 0600 and never opens an existing name: noclobber makes the
# open O_EXCL. The caller's umask and noclobber setting come back at the end.
# Fails, changing nothing, when the saved umask (AG_UMASK) is unknown. A pair
# does not nest.
private_writes_begin() {
  case "${AG_UMASK:-}" in ''|*[!01234567]*|?????*) return 1 ;; esac
  case $- in *C*) ag_pw_noclobber=1 ;; *) ag_pw_noclobber= ;; esac
  set -C
  umask 077
}

private_writes_end() {
  umask "$AG_UMASK"
  [ -n "$ag_pw_noclobber" ] || set +C
}

# Succeeds when $1, an epoch time a state cache stored, is less than
# STATE_CACHE_TTL_SECONDS before AG_AUDIT_START and not after it.
STATE_CACHE_TTL_SECONDS=600
state_cache_fresh() {
  # A leading zero would make the arithmetic an octal error that ends the hook.
  case "$1" in ''|0*|*[!0-9]*|?????????????*) return 1 ;; esac
  ag_scf_age=$((AG_AUDIT_START - $1))
  [ "$ag_scf_age" -ge 0 ] && [ "$ag_scf_age" -lt "$STATE_CACHE_TTL_SECONDS" ]
}

# Succeeds when audit_begin validated a private state directory and read the
# clock, so a state cache has a home and a time to store.
state_cache_ready() {
  [ -n "$AG_STATE_DIR" ] || return 1
  case "$AG_AUDIT_START" in ''|0|*[!0-9]*) return 1 ;; esac
}

# Existing private directories are never chmodded: an unexpected directory is
# an error.
audit_directory() (
  ag_dir=$(audit_location)
  plain_absolute_path "$ag_dir" || return 1
  # mkdir -p leaves an existing directory untouched, so only a missing (or
  # not-yet-plain) directory needs the subshell and the mkdir process (#407).
  if [ "${1:-}" = create ] && { [ ! -d "$ag_dir" ] || [ -L "$ag_dir" ]; }; then
    (umask 077; mkdir -p "$ag_dir") 2>/dev/null || return 1
  fi
  private_dir_ok "$ag_dir" || return 1
  printf '%s' "$ag_dir"
)

# The audit log vocabulary. The writer records and the exporter accepts only
# these words, so the two cannot drift apart.
AUDIT_COMMANDS='hook-pre-tool hook-post-tool hook-post-tool-failure hook-stop hook-user-prompt hook-session-start scan-staged scan-working-tree scan-path exec pii-filter'
# Outcomes a run can note, lowest precedence first: when several were noted,
# the last one in this list is recorded.
AUDIT_NOTES='warned masked error degraded blocked'
# Fixed codes for why an invocation blocked. A host can drop the block reason
# a hook prints (codex exec shows only "hook: UserPromptSubmit Blocked"), so
# the metadata log keeps the code. Never a value, path, or rule text.
AUDIT_REASONS='secret-rule secret-assignment pii pii-detector-failure infra-failure-closed'

# Succeeds when $1 is one word of the space-separated list $2.
audit_word_in() {
  case "$1" in ''|*[!abcdefghijklmnopqrstuvwxyz-]*) return 1 ;; esac
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

audit_note() {
  [ -n "$AG_AUDIT_FILE" ] && [ -n "${AGENT_GUARD_RUNDIR:-}" ] || return 0
  if audit_word_in "$1" "$AUDIT_NOTES"; then
    (umask 077; : >"$AGENT_GUARD_RUNDIR/audit-$1") 2>/dev/null || :
  fi
  return 0
}

audit_record() {
  # Every interpolated string is selected internally, never supplied by a host.
  printf '{"schema":1,"run_id":"%s","time":%s,"version":"%s","command":"%s","host":"%s","phase":"%s","outcome":"%s","exit_code":%s,"duration_seconds":%s,"reason":%s}\n' \
    "$AG_AUDIT_ID" "$1" "$VERSION" "$AG_AUDIT_COMMAND" "$AG_AUDIT_HOST" "$2" "$3" "$4" "$5" "${6:-null}"
}

audit_reason() {
  [ -n "$AG_AUDIT_FILE" ] && [ -n "${AGENT_GUARD_RUNDIR:-}" ] || return 0
  audit_word_in "$1" "$AUDIT_REASONS" || return 0
  # The first reason wins: a later infrastructure note must not replace the
  # verdict that actually decided the block.
  [ ! -e "$AGENT_GUARD_RUNDIR/audit-reason" ] || return 0
  (umask 077; printf '%s\n' "$1" >"$AGENT_GUARD_RUNDIR/audit-reason") 2>/dev/null || :
  return 0
}

# A run id is "<start seconds>-<mktemp suffix>", the grammar
# ^[0-9]{1,12}-[A-Za-z0-9]{6}$. The shell check costs no process (#407) and
# spells the classes out so no locale can widen a range. jq's $ also matches
# before a final newline, so the jq form anchors with \A and \z.
AUDIT_RUN_ID_JQ_REGEX='\A[0-9]{1,12}-[A-Za-z0-9]{6}\z'

audit_run_id_valid() {
  case "$1" in *-*) ;; *) return 1 ;; esac
  ag_rid_time=${1%%-*}
  ag_rid_rand=${1#*-}
  case "$ag_rid_time" in ''|*[!0123456789]*) return 1 ;; esac
  case "$ag_rid_rand" in
    ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
  esac
  [ "${#ag_rid_time}" -le 12 ] && [ "${#ag_rid_rand}" -eq 6 ]
}

audit_prune() (
  # Keep housekeeping off the EXIT/signal path. Bound the directory listing
  # before filtering, so unrelated files cannot force an unbounded traversal.
  # Retention is incremental if the private directory was externally populated.
  ag_dir=$1
  ag_cutoff=$((AG_AUDIT_START - 604800))
  find "$ag_dir" -mindepth 1 -maxdepth 1 -print 2>/dev/null \
    | head -n 2000 \
    | AG_AUDIT_PRUNE_DIR="$ag_dir" LC_ALL=C awk '
        BEGIN { prefix=ENVIRON["AG_AUDIT_PRUNE_DIR"] "/" }
        index($0, prefix) == 1 {
          name=substr($0, length(prefix)+1)
          # Older system awks lack interval expressions. Keep the same ASCII
          # filename grammar using field lengths and simple character classes.
          if (split(name, fields, "-") == 3 && fields[1] == "event" &&
              fields[2] ~ /^[0-9]+$/ && length(fields[2]) <= 12 &&
              fields[3] ~ /^[A-Za-z0-9]+$/ && length(fields[3]) == 6) print
        }
      ' \
    | LC_ALL=C sort -r \
    | awk -v cutoff="$ag_cutoff" '
        { n=split($0, parts, "/"); split(parts[n], event, "-")
          if (event[2]+0 < cutoff || ++kept > 999) print }
      ' \
    | while IFS= read -r ag_old; do
        ag_old_id=${ag_old##*/event-}
        if audit_run_id_valid "$ag_old_id"; then
          # A live-probe sidecar is an empty directory by construction. Never
          # recurse or remove a nonempty/tampered marker during retention.
          rmdir "$ag_dir/live-probe-$ag_old_id" 2>/dev/null || :
          printf '%s\0' "$ag_old"
        fi
      done \
    | xargs -0 rm -f -- 2>/dev/null
)

audit_begin() {
  case "${AGENT_GUARD_LOG_MODE:-on}" in
    on) ag_log=on ;;
    off)
      # No event file is written. An explicit AGENT_GUARD_SCAN_CACHE=on still
      # validates the state directory, so the caches have a private home.
      [ "${AGENT_GUARD_SCAN_CACHE:-}" = on ] || return 0
      ag_log=off
      ;;
    *)
      printf '%s\n' 'agent-guard: local diagnostic logging unavailable (invalid log mode).' >&2
      return 0 ;;
  esac
  audit_word_in "$1" "$AUDIT_COMMANDS" || return 0
  AG_AUDIT_COMMAND=$1
  case "${AGENT_GUARD_HOOK_HOST:-claude}" in codex) AG_AUDIT_HOST=codex ;; *) AG_AUDIT_HOST=claude ;; esac
  case "$AG_AUDIT_COMMAND" in hook-*) ;; *) AG_AUDIT_HOST=cli ;; esac
  AG_AUDIT_START=$(date +%s 2>/dev/null) || AG_AUDIT_START=0
  case "$AG_AUDIT_START" in ''|*[!0-9]*) AG_AUDIT_START=0 ;; esac
  AG_OS=$(uname -s 2>/dev/null) || AG_OS=
  AG_UID=$(id -u 2>/dev/null) || AG_UID=
  ag_candidate=
  ag_dir=$(audit_directory create) || ag_dir=
  if [ "$ag_log" = off ]; then
    AG_STATE_DIR=$ag_dir
    return 0
  fi
  if [ -n "$ag_dir" ]; then
    AG_STATE_DIR=$ag_dir
    audit_prune "$ag_dir"
    ag_candidate=$(umask 077; mktemp "$ag_dir/event-$AG_AUDIT_START-XXXXXX" 2>/dev/null) || ag_candidate=
  fi
  AG_AUDIT_ID=${ag_candidate##*/event-}
  if [ -n "$ag_candidate" ] && [ ! -L "$ag_candidate" ] && [ -f "$ag_candidate" ] \
      && [ "$(file_stat access -P "$ag_candidate")" = "${AG_UID:-$(id -u)}:600" ] \
      && audit_record "$AG_AUDIT_START" started pending null 0 null >>"$ag_candidate"; then
    # A caught signal before this assignment leaves no finish-only event.
    AG_AUDIT_FILE=$ag_candidate
  else
    printf '%s\n' 'agent-guard: local diagnostic logging unavailable; protection continues.' >&2
  fi
  return 0
}

audit_finish() {
  [ -n "$AG_AUDIT_FILE" ] || return 0
  ag_exit=$1
  ag_end=$(date +%s 2>/dev/null) || ag_end=$AG_AUDIT_START
  case "$ag_end" in ''|*[!0-9]*) ag_end=$AG_AUDIT_START ;; esac
  ag_duration=$((ag_end - AG_AUDIT_START))
  [ "$ag_duration" -ge 0 ] || ag_duration=0
  ag_outcome=pass
  case "$ag_exit" in
    0) ;;
    130|143) ag_outcome=interrupted ;;
    *)
      case "$AG_AUDIT_COMMAND:$ag_exit" in
        hook-*:2|scan-*:1|pii-filter:1) ag_outcome=blocked ;;
        *) ag_outcome=error ;;
      esac ;;
  esac
  if [ -n "${AGENT_GUARD_RUNDIR:-}" ]; then
    # This can run from a signal trap inside code that changed IFS.
    ag_finish_ifs=$IFS
    IFS=' '
    for ag_flag in $AUDIT_NOTES; do
      [ ! -f "$AGENT_GUARD_RUNDIR/audit-$ag_flag" ] || ag_outcome=$ag_flag
    done
    IFS=$ag_finish_ifs
  fi
  case "$ag_exit" in 130|143) ag_outcome=interrupted ;; esac
  ag_reason=null
  # Recorded only beside a nonzero exit: a closed infrastructure block keeps
  # its degraded outcome but still names why it stopped the call.
  if [ "$ag_exit" != 0 ] && [ -n "${AGENT_GUARD_RUNDIR:-}" ] \
      && [ -f "$AGENT_GUARD_RUNDIR/audit-reason" ]; then
    IFS= read -r ag_reason_code <"$AGENT_GUARD_RUNDIR/audit-reason" 2>/dev/null || ag_reason_code=
    ! audit_word_in "$ag_reason_code" "$AUDIT_REASONS" || ag_reason="\"$ag_reason_code\""
  fi
  if [ ! -L "$AG_AUDIT_FILE" ] && [ -f "$AG_AUDIT_FILE" ] \
      && [ "$(file_stat access -P "$AG_AUDIT_FILE")" = "${AG_UID:-$(id -u)}:600" ]; then
    audit_record "$ag_end" finished "$ag_outcome" "$ag_exit" "$ag_duration" "$ag_reason" >>"$AG_AUDIT_FILE" 2>/dev/null \
      || printf '%s\n' 'agent-guard: local diagnostic log could not be completed.' >&2
  fi
  return 0
}

audit_export() {
  command -v jq >/dev/null 2>&1 || { printf '%s\n' 'agent-guard: log export requires jq.' >&2; return 2; }
  ag_dir=$(audit_directory) || { printf '%s\n' 'agent-guard: no private diagnostic log directory is available.' >&2; return 2; }
  for ag_file in "$ag_dir"/event-*; do
    [ -f "$ag_file" ] && [ ! -L "$ag_file" ] || continue
    [ "$(file_stat access -P "$ag_file")" = "$(id -u):600" ] || continue
    ag_bytes=$(wc -c <"$ag_file" | tr -d ' ')
    case "$ag_bytes" in ''|*[!0-9]*) continue ;; esac
    [ "$ag_bytes" -le 2048 ] || continue
    # Rebuild the schema, dropping unknown keys. Validate every field so a
    # manually edited/corrupt log cannot smuggle source data into an export.
    jq -c --arg run_id_re "$AUDIT_RUN_ID_JQ_REGEX" --arg commands "$AUDIT_COMMANDS" \
        --arg notes "$AUDIT_NOTES" --arg reasons "$AUDIT_REASONS" '
      def words($list): $list | split(" ")[];
      select(type == "object" and .schema == 1)
      | select(.run_id | type == "string" and test($run_id_re))
      | select(.time | type == "number" and . >= 0 and . <= 9999999999 and floor == .)
      | select(.version | type == "string" and test("^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$"))
      | select(.command | IN(words($commands)))
      | select(.host | IN("claude", "codex", "cli"))
      | select(.phase | IN("started", "finished"))
      | select(.outcome | IN("pending", "pass", "interrupted", words($notes)))
      | select(.exit_code == null or (.exit_code | type == "number" and . >= 0 and . <= 255 and floor == .))
      | select(.duration_seconds | type == "number" and . >= 0 and . <= 9999999999 and floor == .)
      | select(.reason == null or (.reason | IN(words($reasons))))
      | {schema,run_id,time,version,command,host,phase,outcome,exit_code,duration_seconds,reason}
    ' "$ag_file" 2>/dev/null || :
  done
}

# Write a complete export into a private temporary file in the requested parent,
# then publish it with link(2). A hard-link creation fails if FILE already exists,
# unlike mv, so an existing regular file, directory, FIFO, or symlink is never
# overwritten. The temporary file and its final name are in one filesystem.
audit_export_to_file() (
  ag_output=$1
  case "$ag_output" in '') printf '%s\n' 'agent-guard: log export output path is required.' >&2; return 2 ;; esac
  ag_parent=$(dirname -- "$ag_output") || return 2
  [ -d "$ag_parent" ] && [ ! -L "$ag_parent" ] || {
    printf '%s\n' 'agent-guard: log export parent directory must already exist and not be a symlink.' >&2
    return 2
  }
  [ ! -e "$ag_output" ] && [ ! -L "$ag_output" ] || {
    printf '%s\n' 'agent-guard: refusing to overwrite an existing log export target.' >&2
    return 2
  }
  ag_tmp=
  trap '[ -z "$ag_tmp" ] || rm -f -- "$ag_tmp"' 0
  ag_tmp=$(umask 077; mktemp "$ag_parent/.agent-guard-support.XXXXXX" 2>/dev/null) || {
    printf '%s\n' 'agent-guard: could not create a private temporary log export file.' >&2
    return 2
  }
  if [ ! -f "$ag_tmp" ] || [ -L "$ag_tmp" ] || [ "$(file_stat access -P "$ag_tmp")" != "$(id -u):600" ]; then
    printf '%s\n' 'agent-guard: temporary log export file was not private.' >&2
    return 2
  fi
  audit_export >"$ag_tmp" || return $?
  ln "$ag_tmp" "$ag_output" 2>/dev/null || {
    printf '%s\n' 'agent-guard: refusing to overwrite an existing or invalid log export target.' >&2
    return 2
  }
  [ -f "$ag_output" ] && [ ! -L "$ag_output" ] && [ "$(file_stat access -P "$ag_output")" = "$(id -u):600" ] || {
    printf '%s\n' 'agent-guard: log export target was not a private regular file.' >&2
    return 2
  }
  printf 'agent-guard: exported metadata-only support log to %s\n' "$ag_output" >&2
)

audit_logs_usage() {
  printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2
}

audit_logs() {
  case "${1:-status}" in
    -h|--help|help)
      [ "$#" -eq 1 ] || { audit_logs_usage; return 2; }
      audit_logs_usage
      return 0
      ;;
    status)
      case "$#:${1:-}" in 0:|1:status) ;; *) audit_logs_usage; return 2 ;; esac
      case "${AGENT_GUARD_LOG_MODE:-on}" in on|off) ag_mode=${AGENT_GUARD_LOG_MODE:-on} ;; *) ag_mode=invalid ;; esac
      printf 'Local diagnostic logging: %s\nDirectory: ${XDG_STATE_HOME:-~/.local/state}/agent-guard\nRetention target: 7 days, 1000 invocations; bounded cleanup runs at start, so concurrency or externally added files can exceed this.\n' "$ag_mode"
      if audit_directory >/dev/null; then printf 'Storage: private directory ready\n'; else printf 'Storage: not created or unavailable\n'; fi
      ;;
    export)
      shift
      case "$#" in
        0) audit_export ;;
        2) [ "$1" = --output ] || { audit_logs_usage; return 2; }; audit_export_to_file "$2" ;;
        *) audit_logs_usage; return 2 ;;
      esac
      ;;
    *) audit_logs_usage; return 2 ;;
  esac
}

# Read hook JSON without depending on external `cat`: dependency-degraded PATH
# fixtures (and minimal hosts) still need the session_id to deduplicate warnings.
read_stdin() {
  # The shell loop below is O(lines x total bytes): a multi-hundred-KB paste
  # (exactly what hook-user-prompt exists to catch) burns the whole host hook
  # timeout inside the loop and the guard dies unrun. Prefer cat; the loop
  # remains only for a degraded PATH with no cat at all.
  if command -v cat >/dev/null 2>&1; then
    cat
    return 0
  fi
  stdin_value=
  while IFS= read -r stdin_line || [ -n "$stdin_line" ]; do
    if [ -n "$stdin_value" ]; then
      stdin_value="$stdin_value
$stdin_line"
    else
      stdin_value=$stdin_line
    fi
  done
  printf '%s' "$stdin_value"
}

die() {
  die_with_status 2 "$@"
}

die_with_status() {
  audit_note error
  failure_status=$1
  shift
  info "$PROGRAM: $*"
  exit "$failure_status"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 \
    || die_with_status "${2:-2}" "required command not found: $1"
}

resolve_gitleaks() {
  # A configured or private candidate is authoritative even when broken. A
  # silent fallback would make the active default rules depend on PATH again.
  if [ -n "${AGENT_GUARD_GITLEAKS_BIN:-}" ]; then
    ag_gl_candidate=$AGENT_GUARD_GITLEAKS_BIN
  elif [ -e "$GITLEAKS_PRIVATE_BIN_DIR/gitleaks" ] \
       || [ -L "$GITLEAKS_PRIVATE_BIN_DIR/gitleaks" ]; then
    ag_gl_candidate=$GITLEAKS_PRIVATE_BIN_DIR/gitleaks
  elif command -v gitleaks >/dev/null 2>&1; then
    ag_gl_candidate=$(command -v gitleaks) || return 1
  else
    return 1
  fi
  if [ -x "$ag_gl_candidate" ]; then
    ag_gl_dir=${ag_gl_candidate%/*}
    ag_gl_name=${ag_gl_candidate##*/}
    if [ "$ag_gl_dir" = "$ag_gl_candidate" ]; then
      ag_gl_dir=.
    elif [ -z "$ag_gl_dir" ]; then
      ag_gl_dir=/
    fi
    ag_gl_dir=$(CDPATH= cd -- "$ag_gl_dir" 2>/dev/null && pwd -P) \
      || return 1
    printf '%s/%s\n' "$ag_gl_dir" "$ag_gl_name"
    return 0
  fi
  printf '%s\n' "$ag_gl_candidate"
}

GITLEAKS_MIN_VERSION=8.30.0
GITLEAKS_DEFAULT_VERSION=8.30.1
GITLEAKS_PROBE_TIMEOUT_SECONDS=2
GITLEAKS_PROBE_MAX_BYTES=8192
GITLEAKS_PROBE_STATE=
GITLEAKS_PROBE_VERSION=
GITLEAKS_PROBE_DETAIL=
GITLEAKS_READY_BIN=
AG_GITLEAKS_PROBE_PID=
AG_GITLEAKS_PROBE_GROUP=
AG_GITLEAKS_WATCHDOG_PID=
GITLEAKS_PROBE_FALLBACK_DIR=
GITLEAKS_PROBE_FALLBACK_BASE=
GITLEAKS_PROBE_FALLBACK_OUTPUT=
GITLEAKS_PROBE_FALLBACK_TIMEOUT=
GITLEAKS_PROBE_FILE=
GITLEAKS_PROBE_MKDIR_BIN=
GITLEAKS_PROBE_RMDIR_BIN=
GITLEAKS_PROBE_LAUNCHER=
GITLEAKS_PROBE_LAUNCHER_BIN=

kill_gitleaks_probe_group() {
  ag_gl_signal=$1
  case "$AG_GITLEAKS_PROBE_GROUP" in
    ''|*[!0-9]*) return 0 ;;
  esac
  kill -"$ag_gl_signal" -"$AG_GITLEAKS_PROBE_GROUP" 2>/dev/null || :
}

clear_gitleaks_probe_processes() {
  if [ -n "$AG_GITLEAKS_WATCHDOG_PID" ]; then
    kill -TERM "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
    wait "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
    AG_GITLEAKS_WATCHDOG_PID=
  fi
  if [ -n "$AG_GITLEAKS_PROBE_PID" ]; then
    kill_gitleaks_probe_group TERM
    kill -TERM "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    kill_gitleaks_probe_group KILL
    kill -KILL "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    wait "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    AG_GITLEAKS_PROBE_PID=
    AG_GITLEAKS_PROBE_GROUP=
  fi
  for ag_gl_temp_path in \
    "$GITLEAKS_PROBE_FALLBACK_OUTPUT" "$GITLEAKS_PROBE_FALLBACK_TIMEOUT"; do
    [ -n "$ag_gl_temp_path" ] || continue
    if [ -f "$ag_gl_temp_path" ] && [ ! -L "$ag_gl_temp_path" ]; then
      rm -f "$ag_gl_temp_path" 2>/dev/null || :
    fi
  done
  GITLEAKS_PROBE_FALLBACK_OUTPUT=
  GITLEAKS_PROBE_FALLBACK_TIMEOUT=
  if [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ -d "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ ! -L "$GITLEAKS_PROBE_FALLBACK_DIR" ]; then
    "${GITLEAKS_PROBE_RMDIR_BIN:-rmdir}" \
      "$GITLEAKS_PROBE_FALLBACK_DIR" 2>/dev/null || :
  fi
  GITLEAKS_PROBE_FALLBACK_DIR=
}

mktemp_gitleaks_probe_file() {
  ag_gl_temp_kind=$1
  GITLEAKS_PROBE_FILE=$(mktemp_file 2>/dev/null) && return 0

  # Version output is not secret-bearing hook data. Keep the readiness probe
  # available when mktemp itself is unavailable. Atomically acquire a private
  # directory first, so a pre-existing FIFO or symlink can only occupy one
  # candidate directory name and is never opened as a file.
  if [ -z "$GITLEAKS_PROBE_FALLBACK_DIR" ]; then
    GITLEAKS_PROBE_MKDIR_BIN=$(command -v mkdir 2>/dev/null) || {
      GITLEAKS_PROBE_DETAIL=temp-helper-unavailable
      return 1
    }
    GITLEAKS_PROBE_RMDIR_BIN=$(command -v rmdir 2>/dev/null) || {
      GITLEAKS_PROBE_DETAIL=temp-helper-unavailable
      return 1
    }
    ag_gl_temp_attempt=0
    while [ "$ag_gl_temp_attempt" -lt 10 ]; do
      ag_gl_temp_dir="$GITLEAKS_PROBE_FALLBACK_BASE/agent-guard-version-$$-$ag_gl_temp_attempt.d"
      if (umask 077; "$GITLEAKS_PROBE_MKDIR_BIN" "$ag_gl_temp_dir") 2>/dev/null; then
        GITLEAKS_PROBE_FALLBACK_DIR=$ag_gl_temp_dir
        break
      fi
      ag_gl_temp_attempt=$((ag_gl_temp_attempt + 1))
    done
    [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] || return 1
  fi
  GITLEAKS_PROBE_FILE="$GITLEAKS_PROBE_FALLBACK_DIR/$ag_gl_temp_kind"
  (umask 077; : >"$GITLEAKS_PROBE_FILE") 2>/dev/null || return 1
  case "$ag_gl_temp_kind" in
    output) GITLEAKS_PROBE_FALLBACK_OUTPUT=$GITLEAKS_PROBE_FILE ;;
    timeout) GITLEAKS_PROBE_FALLBACK_TIMEOUT=$GITLEAKS_PROBE_FILE ;;
  esac
  return 0
}

release_gitleaks_probe_fallback_dir() {
  [ -z "$GITLEAKS_PROBE_FALLBACK_OUTPUT" ] || return 0
  [ -z "$GITLEAKS_PROBE_FALLBACK_TIMEOUT" ] || return 0
  [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] || return 0
  if [ -d "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ ! -L "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && "$GITLEAKS_PROBE_RMDIR_BIN" \
        "$GITLEAKS_PROBE_FALLBACK_DIR" 2>/dev/null; then
    GITLEAKS_PROBE_FALLBACK_DIR=
  fi
  return 0
}

remove_gitleaks_probe_file() {
  ag_gl_remove_kind=$1
  ag_gl_remove_path=$2
  rm -f "$ag_gl_remove_path" || return 1
  case "$ag_gl_remove_kind" in
    output)
      if [ "$GITLEAKS_PROBE_FALLBACK_OUTPUT" = "$ag_gl_remove_path" ]; then
        GITLEAKS_PROBE_FALLBACK_OUTPUT=
      fi
      ;;
    timeout)
      if [ "$GITLEAKS_PROBE_FALLBACK_TIMEOUT" = "$ag_gl_remove_path" ]; then
        GITLEAKS_PROBE_FALLBACK_TIMEOUT=
      fi
      ;;
  esac
  release_gitleaks_probe_fallback_dir
  return 0
}

select_gitleaks_probe_launcher() {
  if ag_gl_launcher=$(command -v setsid 2>/dev/null) \
      && [ -n "$ag_gl_launcher" ]; then
    GITLEAKS_PROBE_LAUNCHER=setsid
    GITLEAKS_PROBE_LAUNCHER_BIN=$ag_gl_launcher
    return 0
  fi
  if ag_gl_launcher=$(command -v perl 2>/dev/null) \
      && [ -n "$ag_gl_launcher" ]; then
    GITLEAKS_PROBE_LAUNCHER=perl
    GITLEAKS_PROBE_LAUNCHER_BIN=$ag_gl_launcher
    return 0
  fi
  GITLEAKS_PROBE_LAUNCHER=
  GITLEAKS_PROBE_LAUNCHER_BIN=
  return 1
}

# Replace the calling subshell with "$@" as the leader of a new session, so a
# watchdog can kill the whole process group. Call only from a subshell after
# select_gitleaks_probe_launcher has succeeded; it never returns.
exec_in_new_session() {
  case "$GITLEAKS_PROBE_LAUNCHER" in
    setsid) exec "$GITLEAKS_PROBE_LAUNCHER_BIN" "$@" ;;
    perl)
      exec "$GITLEAKS_PROBE_LAUNCHER_BIN" -MPOSIX \
        -e 'POSIX::setsid() >= 0 or exit 125; exec @ARGV; exit 126' "$@"
      ;;
    *) exit 125 ;;
  esac
}

probe_gitleaks() {
  ag_gl_probe_bin=$1
  GITLEAKS_PROBE_STATE=missing
  GITLEAKS_PROBE_VERSION=
  GITLEAKS_PROBE_DETAIL=
  [ -x "$ag_gl_probe_bin" ] || return 1
  GITLEAKS_PROBE_STATE=runtime-failure
  command -v sleep >/dev/null 2>&1 || {
    GITLEAKS_PROBE_DETAIL=timer-unavailable
    return 1
  }
  select_gitleaks_probe_launcher || {
    GITLEAKS_PROBE_DETAIL=launcher-unavailable
    return 1
  }
  GITLEAKS_PROBE_FALLBACK_BASE=${TMPDIR:-/tmp}
  case "$GITLEAKS_PROBE_FALLBACK_BASE" in
    /*) ;;
    *) GITLEAKS_PROBE_FALLBACK_BASE=/tmp ;;
  esac
  [ -d "$GITLEAKS_PROBE_FALLBACK_BASE" ] \
    && [ ! -L "$GITLEAKS_PROBE_FALLBACK_BASE" ] \
    || GITLEAKS_PROBE_FALLBACK_BASE=/tmp
  mktemp_gitleaks_probe_file output || {
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=temp-unavailable
    return 1
  }
  ag_gl_probe_output=$GITLEAKS_PROBE_FILE
  mktemp_gitleaks_probe_file timeout || {
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=temp-unavailable
    return 1
  }
  ag_gl_probe_timeout=$GITLEAKS_PROBE_FILE
  (
    # POSIX ulimit -f uses 512-byte blocks. Bounding the regular output file
    # prevents a broken version command from filling memory before parsing.
    ulimit -f 16 >/dev/null 2>&1 || exit 125
    exec_in_new_session "$ag_gl_probe_bin" version
  ) >"$ag_gl_probe_output" 2>&1 &
  AG_GITLEAKS_PROBE_PID=$!
  AG_GITLEAKS_PROBE_GROUP=$AG_GITLEAKS_PROBE_PID
  (
    ag_gl_watch_sleep_pid=
    # Reap the timer before exiting. Killing it alone orphans a zombie when
    # the host's PID 1 does not reap adopted children (common in containers).
    trap 'trap "" TERM INT
      if [ -n "$ag_gl_watch_sleep_pid" ]; then
        kill -TERM "$ag_gl_watch_sleep_pid" 2>/dev/null || :
        kill -KILL "$ag_gl_watch_sleep_pid" 2>/dev/null || :
        wait "$ag_gl_watch_sleep_pid" 2>/dev/null || :
      fi
      exit 0' TERM INT
    sleep "$GITLEAKS_PROBE_TIMEOUT_SECONDS" &
    ag_gl_watch_sleep_pid=$!
    wait "$ag_gl_watch_sleep_pid" 2>/dev/null || exit 0
    ag_gl_watch_sleep_pid=
    # The parent may have reaped a completed probe and then been descheduled
    # before cancelling this watchdog. Do not turn its completed exit status
    # into a timeout, or signal a group whose leader no longer exists.
    kill -0 "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || exit 0
    # A completed child can still exist as a zombie while its parent is
    # descheduled. It has no running code to time out; preserve wait's status.
    # Use the system utility: a PATH shim must not stall the watchdog.
    # Missing/failed ps keeps the conservative original deadline behavior.
    ag_gl_deadline_state=$(/bin/ps -o stat= -p "$AG_GITLEAKS_PROBE_PID" 2>/dev/null) || ag_gl_deadline_state=
    case "$ag_gl_deadline_state" in *Z*) exit 0 ;; esac
    printf 'timeout\n' >"$ag_gl_probe_timeout"
    kill_gitleaks_probe_group TERM
    kill -TERM "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    sleep 1 &
    ag_gl_watch_sleep_pid=$!
    wait "$ag_gl_watch_sleep_pid" 2>/dev/null || exit 0
    ag_gl_watch_sleep_pid=
    kill_gitleaks_probe_group KILL
    kill -KILL "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
  ) &
  AG_GITLEAKS_WATCHDOG_PID=$!
  wait "$AG_GITLEAKS_PROBE_PID" 2>/dev/null
  ag_gl_probe_status=$?
  AG_GITLEAKS_PROBE_PID=
  # A version wrapper may fork and exit before its child. The isolated group is
  # probe-private, so always clear any remaining descendants before returning.
  kill_gitleaks_probe_group TERM
  kill_gitleaks_probe_group KILL
  kill -TERM "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
  wait "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
  AG_GITLEAKS_WATCHDOG_PID=
  AG_GITLEAKS_PROBE_GROUP=
  ag_gl_probe_bytes=$(LC_ALL=C wc -c <"$ag_gl_probe_output" 2>/dev/null \
    | tr -d '[:space:]')
  if [ -s "$ag_gl_probe_timeout" ]; then
    GITLEAKS_PROBE_DETAIL=timeout
  else
    case "$ag_gl_probe_bytes" in
      ''|*[!0-9]*) GITLEAKS_PROBE_DETAIL=output-unavailable ;;
      *)
        if [ "$ag_gl_probe_bytes" -ge "$GITLEAKS_PROBE_MAX_BYTES" ]; then
          GITLEAKS_PROBE_DETAIL=output-limit
        fi
        ;;
    esac
  fi
  remove_gitleaks_probe_file timeout "$ag_gl_probe_timeout" || :
  if [ "$ag_gl_probe_status" -ne 0 ]; then
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=command-failed
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    return 1
  fi
  if [ -n "$GITLEAKS_PROBE_DETAIL" ]; then
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    return 1
  fi
  GITLEAKS_PROBE_VERSION=$(awk '
      {
        line = $0
        if (match(line, /[vV]?[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*/)) {
          version = substr(line, RSTART, RLENGTH)
          sub(/^[vV]/, "", version)
          print version
          exit
        }
      }
    ' "$ag_gl_probe_output")
  ag_gl_probe_status=$?
  remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
  if [ "$ag_gl_probe_status" -ne 0 ] || [ -z "$GITLEAKS_PROBE_VERSION" ]; then
    GITLEAKS_PROBE_STATE=unparseable
    return 1
  fi
  if ! semver_at_least "$GITLEAKS_PROBE_VERSION" "$GITLEAKS_MIN_VERSION"; then
    GITLEAKS_PROBE_STATE=unsupported
    return 1
  fi
  GITLEAKS_PROBE_STATE=ready
  return 0
}

# The runtime-failure details probe_gitleaks reports by name. Prints the
# message for detail $1 about executable $2; fails for any other detail.
gitleaks_probe_detail_message() {
  case "$1" in
    timeout)
      printf 'gitleaks version command timed out after %ss: %s' \
        "$GITLEAKS_PROBE_TIMEOUT_SECONDS" "$2"
      ;;
    output-limit)
      printf 'gitleaks version output exceeded %s bytes: %s' \
        "$GITLEAKS_PROBE_MAX_BYTES" "$2"
      ;;
    timer-unavailable)
      printf 'gitleaks version timeout helper is unavailable: sleep'
      ;;
    launcher-unavailable)
      printf 'gitleaks version isolation requires setsid or perl'
      ;;
    temp-helper-unavailable)
      printf 'gitleaks version temp fallback requires mkdir and rmdir'
      ;;
    output-unavailable|command-failed|temp-unavailable)
      printf 'gitleaks version command failed: %s' "$2"
      ;;
    *) return 1 ;;
  esac
}

gitleaks_probe_error() {
  ag_gl_error_bin=$1
  case "$GITLEAKS_PROBE_STATE" in
    missing)
      printf 'selected gitleaks is not executable: %s' "$ag_gl_error_bin"
      ;;
    runtime-failure)
      gitleaks_probe_detail_message "$GITLEAKS_PROBE_DETAIL" "$ag_gl_error_bin" \
        || printf 'gitleaks version command failed: %s' "$ag_gl_error_bin"
      ;;
    unparseable)
      printf 'could not parse gitleaks version from %s (required >= %s)' \
        "$ag_gl_error_bin" "$GITLEAKS_MIN_VERSION"
      ;;
    unsupported)
      printf 'gitleaks %s is incompatible; required >= %s (%s)' \
        "$GITLEAKS_PROBE_VERSION" "$GITLEAKS_MIN_VERSION" "$ag_gl_error_bin"
      ;;
    *)
      printf 'gitleaks readiness probe failed: %s' "$ag_gl_error_bin"
      ;;
  esac
}

# Every hook is a new process, and the isolated `gitleaks version` probe costs
# about as much as the scan that follows it, so on a loaded machine the pair can
# reach the host's hook timeout. A ready verdict is reused for the same
# executable for a short while. The key holds the resolved path, the minimum
# version and the file's identity (device, inode, size, and mtime and ctime at
# the finest resolution stat reports), so replacing or rewriting the binary
# misses; the TTL bounds whatever the key cannot see.
# Only ready verdicts are stored, and any cache problem runs the full probe.
# The file lives in the private state directory audit_begin validated, so
# diagnostics (check, doctor, setup) always probe, as does
# AGENT_GUARD_LOG_MODE=off without AGENT_GUARD_SCAN_CACHE=on.
GITLEAKS_PROBE_CACHE_KEY=

gitleaks_probe_cache_lookup() {
  GITLEAKS_PROBE_CACHE_KEY=
  state_cache_ready || return 1
  ag_gl_cache_bin=$1
  case "$ag_gl_cache_bin" in /*) ;; *) return 1 ;; esac
  case "$ag_gl_cache_bin" in *[[:cntrl:]]*) return 1 ;; esac
  # A version manager's shim (an asdf script, or a mise link to its own
  # binary) runs whichever gitleaks the cwd or environment selects behind one
  # unchanged file. Refuse the shapes that can be seen: a link chain ending in
  # another name, and a #! script. A native multiplexer copied under the name
  # gitleaks still passes; the TTL bounds it.
  ag_gl_cache_real=$ag_gl_cache_bin
  ag_gl_cache_hops=0
  while [ -L "$ag_gl_cache_real" ]; do
    ag_gl_cache_hops=$((ag_gl_cache_hops + 1))
    [ "$ag_gl_cache_hops" -le 8 ] || return 1
    ag_gl_cache_link=$(readlink -- "$ag_gl_cache_real" 2>/dev/null) || return 1
    case "$ag_gl_cache_link" in
      /*) ag_gl_cache_real=$ag_gl_cache_link ;;
      *) ag_gl_cache_real=${ag_gl_cache_real%/*}/$ag_gl_cache_link ;;
    esac
  done
  [ "${ag_gl_cache_real##*/}" = gitleaks ] && [ -f "$ag_gl_cache_real" ] || return 1
  ag_gl_cache_head=
  IFS= read -r ag_gl_cache_head <"$ag_gl_cache_real" 2>/dev/null || :
  case "$ag_gl_cache_head" in '#!'*) return 1 ;; esac
  ag_gl_cache_id=$(file_stat identity -L "$ag_gl_cache_bin") || return 1
  [ -n "$ag_gl_cache_id" ] || return 1
  GITLEAKS_PROBE_CACHE_KEY="1 $GITLEAKS_MIN_VERSION $ag_gl_cache_id $ag_gl_cache_bin"
  ag_gl_cache_file="$AG_STATE_DIR/gitleaks-probe"
  [ -f "$ag_gl_cache_file" ] && [ ! -L "$ag_gl_cache_file" ] || return 1
  { IFS= read -r ag_gl_cached_key && IFS= read -r ag_gl_cached_time \
      && IFS= read -r ag_gl_cached_version; } <"$ag_gl_cache_file" 2>/dev/null \
    || return 1
  [ "$ag_gl_cached_key" = "$GITLEAKS_PROBE_CACHE_KEY" ] || return 1
  state_cache_fresh "$ag_gl_cached_time" || return 1
  case "$ag_gl_cached_version" in ''|*[!0-9.]*) return 1 ;; esac
  semver_at_least "$ag_gl_cached_version" "$GITLEAKS_MIN_VERSION" || return 1
  GITLEAKS_PROBE_STATE=ready
  GITLEAKS_PROBE_VERSION=$ag_gl_cached_version
  GITLEAKS_PROBE_DETAIL=
}

gitleaks_probe_cache_store() {
  [ -n "$GITLEAKS_PROBE_CACHE_KEY" ] && [ "$GITLEAKS_PROBE_STATE" = ready ] || return 0
  ag_gl_cache_file="$AG_STATE_DIR/gitleaks-probe"
  [ ! -d "$ag_gl_cache_file" ] || return 0
  ag_gl_cache_tmp=$(umask 077; mktemp "$ag_gl_cache_file.XXXXXX" 2>/dev/null) || return 0
  if ! { printf '%s\n%s\n%s\n' "$GITLEAKS_PROBE_CACHE_KEY" "$AG_AUDIT_START" \
        "$GITLEAKS_PROBE_VERSION" >"$ag_gl_cache_tmp" \
      && mv -f "$ag_gl_cache_tmp" "$ag_gl_cache_file"; } 2>/dev/null; then
    rm -f "$ag_gl_cache_tmp" 2>/dev/null || :
  fi
  return 0
}

# A hook scans the same short text over and over (`ls -la`, `git status`), and
# each scan starts gitleaks (#407). A clean verdict is a function of the bytes
# fed to `gitleaks stdin`, the flags below, the config file, the gitleaks
# executable, and what gitleaks reads beside them: GITLEAKS_CONFIG and
# GITLEAKS_CONFIG_TOML, and ./.gitleaksignore in the scan's directory. Only a
# completed clean scan is remembered, under a SHA-256 of all of that, so a
# change to any one of them misses. Findings, scanner errors, signals, and
# could-not-run states are never stored, and every doubt (no hash tool, no
# native-binary identity from the probe cache, an ignore file, an extended
# config file, a stale, foreign or unreadable entry) runs the scan uncached.
# Entries hold only hashes and a time, never the text. They live in a 0700
# directory inside the private state directory audit_begin validated, so
# diagnostics, and AGENT_GUARD_LOG_MODE=off without AGENT_GUARD_SCAN_CACHE=on,
# never cache. The TTL is the probe cache's: a version manager that swaps
# gitleaks behind one file changes
# the probed version within that window. AGENT_GUARD_SCAN_CACHE=off opts out.
GITLEAKS_SCAN_FLAGS='--redact --no-banner --no-color --log-level error'
GITLEAKS_STDIN_SCAN_FLAGS="stdin $GITLEAKS_SCAN_FLAGS --config CONFIG --exit-code 1"
GITLEAKS_CLEAN_CACHE_MAX_ENTRIES=256
GITLEAKS_CLEAN_CACHE_FORMAT=1
# Bump when gitleaks_clean_cache_config_cacheable changes, so a config-<hash>
# marker it wrote is checked again even within one release.
GITLEAKS_CLEAN_CACHE_CHECKER_FORMAT=1
GITLEAKS_CLEAN_CACHE_FILE=
GITLEAKS_CLEAN_CACHE_CONFIG_SUM=

# $1 is the scanned text, fed as printf '%s\n'. Sets GITLEAKS_CLEAN_CACHE_FILE
# and GITLEAKS_CLEAN_CACHE_CONFIG_SUM, or fails when the scan must not be cached.
gitleaks_clean_cache_key() {
  GITLEAKS_CLEAN_CACHE_FILE=
  GITLEAKS_CLEAN_CACHE_CONFIG_SUM=
  [ "${AGENT_GUARD_SCAN_CACHE:-on}" = on ] || return 1
  state_cache_ready || return 1
  # The probe cache's identity of a native executable; a script shim has none.
  [ -n "$GITLEAKS_PROBE_CACHE_KEY" ] && [ "$GITLEAKS_PROBE_STATE" = ready ] \
    && [ -n "$GITLEAKS_READY_BIN" ] || return 1
  case "$GITLEAKS_PROBE_CACHE_KEY" in *" $GITLEAKS_READY_BIN") ;; *) return 1 ;; esac
  case "$GITLEAKS_PROBE_VERSION" in ''|*[!0-9.]*) return 1 ;; esac
  # gitleaks stdin applies ./.gitleaksignore; its contents can hide a finding.
  [ ! -e .gitleaksignore ] && [ ! -L .gitleaksignore ] || return 1
  [ -f "$GITLEAKS_CONFIG" ] || return 1
  gitleaks_clean_cache_hasher || return 1
  ag_glc_text=$1
  # Length-prefixed fields; the scanned bytes come last, exactly as fed.
  ag_glc_sums=$(
    {
      printf 'agent-guard gitleaks clean %s\n' "$GITLEAKS_CLEAN_CACHE_FORMAT"
      for ag_glc_field in "$VERSION" "$GITLEAKS_STDIN_SCAN_FLAGS" \
          "$GITLEAKS_PROBE_CACHE_KEY" "$GITLEAKS_PROBE_VERSION" \
          "${GITLEAKS_CONFIG+set}:${GITLEAKS_CONFIG:-}" \
          "${GITLEAKS_CONFIG_TOML+set}:${GITLEAKS_CONFIG_TOML:-}"; do
        printf '%s:%s\n' "${#ag_glc_field}" "$ag_glc_field"
      done
      printf '%s\n' "$ag_glc_text"
    } | gitleaks_clean_cache_hash - "$GITLEAKS_CONFIG" /dev/null 2>/dev/null
  ) || return 1
  ag_glc_text=
  gitleaks_clean_cache_sums "$ag_glc_sums" 3 || return 1
  GITLEAKS_CLEAN_CACHE_FILE="$AG_STATE_DIR/gitleaks-clean/$ag_glc_sum1"
  GITLEAKS_CLEAN_CACHE_CONFIG_SUM=$ag_glc_sum2
}

# A digest from a tool someone else controls could turn any text into a hit,
# and no check of its output can rule that out. So the hash tool is never
# taken from PATH: only a fixed system path, not a symlink, in a directory that
# is not a symlink. Before an entry is trusted or stored, the tool and its
# directory must also be owned by root and writable by nobody else (checked by
# gitleaks_clean_cache_modes_ok in the same stat as the cache entry). Without
# such a tool nothing is cached. As defense in depth every call also hashes
# /dev/null, whose SHA-256 is known, and all digests of one call must differ.
GITLEAKS_CLEAN_CACHE_HASHER=
GITLEAKS_CLEAN_CACHE_EMPTY_SUM=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# The arguments override the candidates for tests only.
gitleaks_clean_cache_hasher() {
  GITLEAKS_CLEAN_CACHE_HASHER=
  [ "$#" -gt 0 ] || set -- /usr/bin/sha256sum /bin/sha256sum /usr/bin/shasum
  for ag_glc_cand in "$@"; do
    case "$ag_glc_cand" in /*/sha256sum|/*/shasum) ;; *) continue ;; esac
    [ -f "$ag_glc_cand" ] && [ ! -L "$ag_glc_cand" ] && [ -x "$ag_glc_cand" ] || continue
    [ -d "${ag_glc_cand%/*}" ] && [ ! -L "${ag_glc_cand%/*}" ] || continue
    GITLEAKS_CLEAN_CACHE_HASHER=$ag_glc_cand
    return 0
  done
  return 1
}

# shasum is a perl script (on macOS the only candidate), and perl takes code
# from the environment; run it without those variables.
gitleaks_clean_cache_hash() {
  case "$GITLEAKS_CLEAN_CACHE_HASHER" in
    /*/sha256sum) LC_ALL=C "$GITLEAKS_CLEAN_CACHE_HASHER" "$@" ;;
    /*/shasum)
      (unset PERL5OPT PERL5LIB PERLLIB PERL5DB PERL5DB_THREADED PERLIO PERL_UNICODE
       LC_ALL=C exec "$GITLEAKS_CLEAN_CACHE_HASHER" -a 256 "$@") ;;
    *) return 1 ;;
  esac
}


# $1 holds four stat lines: the hash tool, its directory, the cache directory,
# and then the entry ($3 = hit) or the config ($3 = store); $2 is this user's
# uid. The tool and its directory: root's and writable by nobody else. The
# cache directory: this user's, 0700. The entry: this user's, writable by
# nobody else, one link (a hard link could make another file's content an
# entry). The config's ctime is left in ag_glc_config_ctime.
gitleaks_clean_cache_modes_ok() {
  ag_glc_rest=$1
  ag_glc_nl='
'
  ag_glc_i=0
  ag_glc_config_ctime=
  while [ -n "$ag_glc_rest" ]; do
    ag_glc_i=$((ag_glc_i + 1))
    ag_glc_line=${ag_glc_rest%%"$ag_glc_nl"*}
    case "$ag_glc_rest" in
      *"$ag_glc_nl"*) ag_glc_rest=${ag_glc_rest#*"$ag_glc_nl"} ;;
      *) ag_glc_rest= ;;
    esac
    case "$ag_glc_line" in *:*:*:*:*) return 1 ;; *:*:*:*) ;; *) return 1 ;; esac
    case "$ag_glc_line" in *[!0-9:]*|*::*|:*|*:) return 1 ;; esac
    ag_glc_owner=${ag_glc_line%%:*}
    ag_glc_line=${ag_glc_line#*:}
    ag_glc_mode=${ag_glc_line%%:*}
    ag_glc_line=${ag_glc_line#*:}
    ag_glc_links=${ag_glc_line%%:*}
    ag_glc_ctime=${ag_glc_line#*:}
    case "$ag_glc_mode" in [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;; *) return 1 ;; esac
    case "$ag_glc_i:$3" in
      1:*|2:*) [ "$ag_glc_owner" = 0 ] || return 1
           case "$ag_glc_mode" in *[0145][0145]) ;; *) return 1 ;; esac ;;
      3:*) [ "$ag_glc_owner" = "$2" ] && [ "$ag_glc_mode" = 700 ] || return 1 ;;
      4:hit) [ "$ag_glc_owner" = "$2" ] && [ "$ag_glc_links" = 1 ] || return 1
         case "$ag_glc_mode" in *[0145][0145]) ;; *) return 1 ;; esac ;;
      4:store) ag_glc_config_ctime=$ag_glc_ctime ;;
      *) return 1 ;;
    esac
  done
  [ "$ag_glc_i" -eq 4 ]
}

# $1 is the output of one hash call whose last operand was /dev/null, $2 the
# number of operands. Sets ag_glc_sum1, ag_glc_sum2, ... in operand order.
gitleaks_clean_cache_sums() {
  ag_glc_rest=$1
  ag_glc_nl='
'
  ag_glc_i=0
  ag_glc_seen=
  while [ "$ag_glc_i" -lt "$2" ]; do
    ag_glc_i=$((ag_glc_i + 1))
    [ -n "$ag_glc_rest" ] || return 1
    ag_glc_line=${ag_glc_rest%%"$ag_glc_nl"*}
    case "$ag_glc_rest" in
      *"$ag_glc_nl"*) ag_glc_rest=${ag_glc_rest#*"$ag_glc_nl"} ;;
      *) ag_glc_rest= ;;
    esac
    ag_glc_sum=${ag_glc_line%% *}
    case "$ag_glc_sum" in ''|*[!0123456789abcdef]*) return 1 ;; esac
    [ "${#ag_glc_sum}" -eq 64 ] || return 1
    case " $ag_glc_seen " in *" $ag_glc_sum "*) return 1 ;; esac
    ag_glc_seen="$ag_glc_seen $ag_glc_sum"
    eval "ag_glc_sum$ag_glc_i=\$ag_glc_sum"
  done
  [ -z "$ag_glc_rest" ] && [ "$ag_glc_sum" = "$GITLEAKS_CLEAN_CACHE_EMPTY_SUM" ]
}

# Only configurations whose loaded files the key hashes are cached. gitleaks
# reads its config through viper, which ignores key case, and TOML spells a key
# bare, quoted, dotted, as an inline table, or with escapes in a basic string.
# So the word extend may appear only once per line, as a lone [extend] header
# whose body sets nothing but useDefault and a one-line disabledRules list, and
# no key or table header may start with a basic (double-quoted) string, where
# an escape can hide a name. This line view holds only outside multiline
# strings, so the header may appear once, after no multiline delimiter (three
# single or three double quotes), and no delimiter may appear in its body: one
# there can turn a line that looks like a table header into string content
# while the real table goes on. Anything else, a comment naming extend
# included, is not cached.
gitleaks_clean_cache_config_cacheable() {
  LC_ALL=C awk '
    { l = tolower($0); delim = index($0, "\047\047\047") || index($0, "\"\"\"") }
    {
      c = l
      n = gsub(/extend/, "", c)
      if (n) {
        if (n == 1 && !headers++ && !delim_seen \
            && l ~ /^[ \t]*\[[ \t]*extend[ \t]*\][ \t]*(#.*)?$/) { ext = 1; next }
        bad = 1; exit
      }
    }
    ext && delim { bad = 1; exit }
    delim { delim_seen = 1 }
    /^[ \t]*\[/ { ext = 0; if (index($0, "\"")) { bad = 1; exit }; next }
    /^[ \t]*"/ { bad = 1; exit }
    ext {
      if (l ~ /^[ \t]*(#.*)?$/) next
      if (l ~ /^[ \t]*usedefault[ \t]*=[ \t]*(true|false)[ \t]*(#.*)?$/) next
      if (l ~ /^[ \t]*disabledrules[ \t]*=[ \t]*\[.*\][ \t]*(#.*)?$/ && !index(l, "\\")) next
      bad = 1; exit
    }
    END { exit bad }
  ' "$GITLEAKS_CONFIG" 2>/dev/null
}

# Succeed only for a fresh entry of this exact key. Any other state misses.
gitleaks_clean_cache_hit() {
  [ -n "$GITLEAKS_CLEAN_CACHE_FILE" ] || return 1
  ag_glc_dir="$AG_STATE_DIR/gitleaks-clean"
  [ -d "$ag_glc_dir" ] && [ ! -L "$ag_glc_dir" ] || return 1
  [ -f "$GITLEAKS_CLEAN_CACHE_FILE" ] && [ ! -L "$GITLEAKS_CLEAN_CACHE_FILE" ] || return 1
  # The tool that named the entry, the directory as the store left it, and an
  # entry nobody else could write, in one stat.
  ag_glc_modes=$(file_stat entry -P "$GITLEAKS_CLEAN_CACHE_HASHER" \
    "${GITLEAKS_CLEAN_CACHE_HASHER%/*}" "$ag_glc_dir" "$GITLEAKS_CLEAN_CACHE_FILE") || return 1
  gitleaks_clean_cache_modes_ok "$ag_glc_modes" "${AG_UID:-$(id -u)}" hit || return 1
  { IFS= read -r ag_glc_format && IFS= read -r ag_glc_config \
      && IFS= read -r ag_glc_time; } <"$GITLEAKS_CLEAN_CACHE_FILE" 2>/dev/null \
    || return 1
  [ "$ag_glc_format" = "$GITLEAKS_CLEAN_CACHE_FORMAT" ] || return 1
  [ "$ag_glc_config" = "$GITLEAKS_CLEAN_CACHE_CONFIG_SUM" ] || return 1
  state_cache_fresh "$ag_glc_time"
}

# Called only after run_gitleaks_stdin returned 0: gitleaks exited 0 and
# printed nothing. Never fails the scan; a store problem only skips the store.
# A miss already paid for gitleaks, so the store keeps to one stat and one mv:
# the config is hashed again only when its ctime is not older than this
# process, the config check runs once per config content (a marker named by
# its hash and holding this version and checker format remembers a pass), and the entry is
# written by the shell under noclobber and umask 077 (an mv only to replace).
gitleaks_clean_cache_store() {
  [ -n "$GITLEAKS_CLEAN_CACHE_FILE" ] || return 0
  # An ignore file that appeared during the scan may have been read by it.
  [ ! -e .gitleaksignore ] && [ ! -L .gitleaksignore ] || return 0
  [ -n "$GITLEAKS_CLEAN_CACHE_HASHER" ] || return 0
  ag_glc_dir="$AG_STATE_DIR/gitleaks-clean"
  if [ ! -d "$ag_glc_dir" ] && [ ! -L "$ag_glc_dir" ]; then
    (umask 077; mkdir "$ag_glc_dir") 2>/dev/null || return 0
  fi
  [ -d "$ag_glc_dir" ] && [ ! -L "$ag_glc_dir" ] || return 0
  # -L: the config is read through any link, as gitleaks reads it. The tool and
  # the directories were checked not to be links.
  ag_glc_modes=$(file_stat entry -L "$GITLEAKS_CLEAN_CACHE_HASHER" \
    "${GITLEAKS_CLEAN_CACHE_HASHER%/*}" "$ag_glc_dir" "$GITLEAKS_CONFIG") || return 0
  gitleaks_clean_cache_modes_ok "$ag_glc_modes" "${AG_UID:-$(id -u)}" store || return 0
  # The config gitleaks just read must be the one the key hashed. A ctime from
  # before this process started means no change since the key was taken; any
  # later one (a write, a rename onto it, even one that restores the old bytes)
  # hashes the file again. A link anywhere on the path can be pointed at
  # another, older file without touching that file's ctime, so such a path (or
  # a relative one) is always hashed again.
  case "$ag_glc_config_ctime" in ''|*[!0-9]*|?????????????*) return 0 ;; esac
  ag_glc_config_ctime=${ag_glc_config_ctime#"${ag_glc_config_ctime%%[!0]*}"}
  if [ "${ag_glc_config_ctime:-0}" -ge "$AG_AUDIT_START" ] \
      || ! plain_absolute_path "$GITLEAKS_CONFIG"; then
    ag_glc_sums=$(gitleaks_clean_cache_hash "$GITLEAKS_CONFIG" /dev/null 2>/dev/null) \
      || return 0
    gitleaks_clean_cache_sums "$ag_glc_sums" 2 || return 0
    [ "$ag_glc_sum1" = "$GITLEAKS_CLEAN_CACHE_CONFIG_SUM" ] || return 0
  fi
  ag_glc_marker="$ag_glc_dir/config-$GITLEAKS_CLEAN_CACHE_CONFIG_SUM"
  ag_glc_marked=
  if [ -f "$ag_glc_marker" ] && [ ! -L "$ag_glc_marker" ]; then
    { IFS= read -r ag_glc_marked <"$ag_glc_marker"; } 2>/dev/null || ag_glc_marked=
  fi
  ag_glc_remark=
  if [ "$ag_glc_marked" != "$VERSION:$GITLEAKS_CLEAN_CACHE_CHECKER_FORMAT" ]; then
    gitleaks_clean_cache_config_cacheable || return 0
    ag_glc_remark=1
  fi
  [ ! -d "$GITLEAKS_CLEAN_CACHE_FILE" ] || return 0
  # A new entry is created in place, and a reader that races the single short
  # write sees too few lines, a short hash or a short (so expired) time, all
  # of which miss. Replacing an existing entry goes through a temporary name
  # and one mv.
  private_writes_begin || return 0
  ag_glc_tmp=
  ag_glc_wrote=
  if [ -e "$GITLEAKS_CLEAN_CACHE_FILE" ] || [ -L "$GITLEAKS_CLEAN_CACHE_FILE" ]; then
    ag_glc_tmp="$ag_glc_dir/tmp.$$"
    ag_glc_target=$ag_glc_tmp
  else
    ag_glc_target=$GITLEAKS_CLEAN_CACHE_FILE
  fi
  if [ ! -e "$ag_glc_target" ] && [ ! -L "$ag_glc_target" ] \
      && { printf '%s\n%s\n%s\n' "$GITLEAKS_CLEAN_CACHE_FORMAT" \
        "$GITLEAKS_CLEAN_CACHE_CONFIG_SUM" "$AG_AUDIT_START" >"$ag_glc_target"; } 2>/dev/null; then
    ag_glc_wrote=1
  fi
  # A stale marker (another release or checker) is rewritten after the pass.
  if [ -n "$ag_glc_remark" ] && [ ! -L "$ag_glc_marker" ]; then
    if [ ! -e "$ag_glc_marker" ]; then
      { printf '%s:%s\n' "$VERSION" "$GITLEAKS_CLEAN_CACHE_CHECKER_FORMAT" >"$ag_glc_marker"; } 2>/dev/null || :
    elif [ -f "$ag_glc_marker" ]; then
      { printf '%s:%s\n' "$VERSION" "$GITLEAKS_CLEAN_CACHE_CHECKER_FORMAT" >|"$ag_glc_marker"; } 2>/dev/null || :
    fi
  fi
  private_writes_end
  [ -n "$ag_glc_wrote" ] || return 0
  if [ -n "$ag_glc_tmp" ] && ! mv -f "$ag_glc_tmp" "$GITLEAKS_CLEAN_CACHE_FILE" 2>/dev/null; then
    rm -f "$ag_glc_tmp" 2>/dev/null || :
    return 0
  fi
  # Bound the directory with a builtin count; only past the limit, keep the
  # newest three quarters.
  set -- "$ag_glc_dir"/*
  [ "$#" -gt "$GITLEAKS_CLEAN_CACHE_MAX_ENTRIES" ] || return 0
  ( cd "$ag_glc_dir" 2>/dev/null && ls -t 2>/dev/null ) \
    | tail -n +$((GITLEAKS_CLEAN_CACHE_MAX_ENTRIES * 3 / 4 + 1)) \
    | while IFS= read -r ag_glc_entry; do
        # Only names this cache writes; never a path from elsewhere.
        case "$ag_glc_entry" in
          tmp.*) case "${ag_glc_entry#tmp.}" in ''|*[!0123456789]*) continue ;; esac ;;
          config-*) ag_glc_hex=${ag_glc_entry#config-}
             [ "${#ag_glc_hex}" -eq 64 ] || continue
             case "$ag_glc_hex" in *[!0123456789abcdef]*) continue ;; esac ;;
          *) [ "${#ag_glc_entry}" -eq 64 ] || continue
             case "$ag_glc_entry" in *[!0123456789abcdef]*) continue ;; esac ;;
        esac
        [ -d "$ag_glc_dir/$ag_glc_entry" ] || rm -f "$ag_glc_dir/$ag_glc_entry" 2>/dev/null || :
      done
  return 0
}

prepare_gitleaks() {
  if [ -n "$GITLEAKS_READY_BIN" ]; then
    GITLEAKS_BIN=$GITLEAKS_READY_BIN
    if [ ! -x "$GITLEAKS_BIN" ]; then
      GITLEAKS_PROBE_STATE=missing
      GITLEAKS_PROBE_DETAIL=
      return 1
    fi
    return 0
  fi
  GITLEAKS_BIN=$(resolve_gitleaks) || {
    GITLEAKS_PROBE_STATE=missing
    GITLEAKS_PROBE_DETAIL=no-candidate
    return 1
  }
  if gitleaks_probe_cache_lookup "$GITLEAKS_BIN"; then
    GITLEAKS_READY_BIN=$GITLEAKS_BIN
    return 0
  fi
  probe_gitleaks "$GITLEAKS_BIN" || return 1
  gitleaks_probe_cache_store
  GITLEAKS_READY_BIN=$GITLEAKS_BIN
  return 0
}

need_gitleaks() {
  if ! prepare_gitleaks; then
    if [ -z "${GITLEAKS_BIN:-}" ]; then
      cli_ref_init
      die_with_status "${1:-2}" \
        "required command not found: gitleaks (run: $AG_CLI_REF setup)"
    fi
    probe_detail=$(gitleaks_probe_error "$GITLEAKS_BIN")
    die_with_status "${1:-2}" "$probe_detail"
  fi
  [ -f "$GITLEAKS_CONFIG" ] \
    || die_with_status "${1:-2}" "gitleaks config not found: $GITLEAKS_CONFIG"
}

# Every hook needs each policy file present with at least one active rule.
# Prints the first file that is not, and fails when all are usable.
hook_policy_unusable() {
  for hook_policy in "$GITLEAKS_CONFIG" "$DENY_READ_PATHS" "$DENY_BASH_PATTERNS"; do
    [ -f "$hook_policy" ] && policy_file_has_active_rule "$hook_policy" && continue
    printf '%s' "$hook_policy"
    return 0
  done
  return 1
}

hook_dependencies_ready() {
  command -v jq >/dev/null 2>&1 || return 1
  command -v awk >/dev/null 2>&1 || return 1
  prepare_gitleaks || return 1
  ! hook_policy_unusable >/dev/null
}

# The PreToolUse protected-path and deny-pattern checks need only jq, awk and
# their two policy files, not gitleaks. When hook_dependencies_ready failed and
# these are ready, only the secret scanner is missing.
hook_policy_dependencies_ready() {
  command -v jq >/dev/null 2>&1 || return 1
  command -v awk >/dev/null 2>&1 || return 1
  [ -f "$DENY_READ_PATHS" ] && policy_file_has_active_rule "$DENY_READ_PATHS" || return 1
  [ -f "$DENY_BASH_PATTERNS" ] && policy_file_has_active_rule "$DENY_BASH_PATTERNS" || return 1
}

# Set to 1 only by hook_pre_tool, in the open policy, when gitleaks or its
# config is unavailable but the policy checks can run. Every gitleaks scan then
# reports "could not run" without probing again, and the hook reports that once
# through the infrastructure policy instead of treating the scan as clean.
HOOK_SCANNER_UNAVAILABLE=0

infrastructure_failure_mode() {
  case "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" in
    open|closed) printf '%s\n' "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" ;;
    *) printf '%s\n' open ;;
  esac
}

# Seconds before the open-policy infrastructure notice repeats in one session.
# Ten minutes matches GITLEAKS_PROBE_CACHE_TTL_SECONDS, the window in which a
# repaired scanner is picked up anyway, and at the usual pace of tool calls
# shows the notice a few times an hour rather than on every call. It is fixed
# on purpose: the notice is the only thing telling the user protection is off.
HOOK_WARNING_INTERVAL_SECONDS=600

# Whether the open notice is due: on the session's first failure, and again
# once HOOK_WARNING_INTERVAL_SECONDS have passed since the time the marker
# records. The clock is the hook start time audit_begin already read; date runs
# only when logging is off. A marker that cannot be created or read for another
# reason (full disk, read-only dir, not ours) must still warn. Without a clock
# the notice stays once per session. Two hooks racing past the interval can
# both warn; neither can suppress the other.
hook_warning_due() {
  warning_marker=$(warning_state_path infrastructure "${1:-}") || return 0
  warning_now=$AG_AUDIT_START
  case "$warning_now" in
    ''|0|*[!0-9]*) warning_now=$(date +%s 2>/dev/null) || warning_now= ;;
  esac
  # A leading zero would be read as octal, and a digit 8 or 9 then ends the
  # shell with exit 2 inside the arithmetic below.
  case "$warning_now" in 0*|*[!0-9]*|????????????*) warning_now= ;; esac
  # Never open anything but a regular file: noclobber still opens an existing
  # FIFO or device, and a planted FIFO would hang the hook until the host
  # timeout. Such a marker proves nothing, so the notice is due.
  if [ -L "$warning_marker" ] || { [ -e "$warning_marker" ] && [ ! -f "$warning_marker" ]; }; then
    return 0
  fi
  (umask 077; set -C; printf '%s\n' "$warning_now" >"$warning_marker") 2>/dev/null \
    && return 0
  [ -e "$warning_marker" ] || return 0
  [ -n "$warning_now" ] || return 1
  # Read only our own regular file; the check above narrows, not closes, a
  # swap, and the read itself is a builtin.
  warning_last=
  if [ -f "$warning_marker" ] && [ ! -L "$warning_marker" ] && [ -O "$warning_marker" ]; then
    IFS= read -r warning_last 2>/dev/null <"$warning_marker" || :
  fi
  # An empty (pre-interval) or unreadable marker, or a time ahead of the
  # clock, is due; otherwise wait out the interval.
  case "$warning_last" in
    ''|0*|*[!0-9]*|????????????*) ;;
    *)
      [ "$warning_last" -gt "$warning_now" ] \
        || [ $((warning_now - warning_last)) -ge "$HOOK_WARNING_INTERVAL_SECONDS" ] \
        || return 1
      ;;
  esac
  # Replace rather than overwrite, so a marker swapped for a symlink is never
  # followed; noclobber refuses to write through one. rm is the only process
  # this adds, once per interval. If it cannot remove the marker, the notice
  # stays due on every call: louder, never silent.
  rm -f "$warning_marker" 2>/dev/null || :
  (umask 077; set -C; printf '%s\n' "$warning_now" >"$warning_marker") 2>/dev/null || :
  return 0
}

# Per-session state file under the private warnings dir. Fails only when the
# directory cannot be created.
warning_state_path() {
  warning_session=${AGENT_GUARD_SESSION_ID:-}
  if [ -z "$warning_session" ] && command -v jq >/dev/null 2>&1; then
    warning_session=$(printf '%s' "${2:-}" | jq -r '.session_id // empty' 2>/dev/null) || warning_session=
  fi
  [ -n "$warning_session" ] || warning_session="${AGENT_GUARD_HOOK_HOST:-host}-${PPID:-0}"
  case "$warning_session" in
    *[!A-Za-z0-9._-]*) warning_session="${AGENT_GUARD_HOOK_HOST:-host}-${PPID:-0}" ;;
  esac
  warning_dir=$(warning_root)
  if [ ! -d "$warning_dir" ]; then
    (umask 077; mkdir -p "$warning_dir") 2>/dev/null || return 1
    chmod 700 "$warning_dir" 2>/dev/null || :
  fi
  printf '%s\n' "$warning_dir/$1-$warning_session"
}

# warning_state_path for state that is read back into the model's context.
# Another user who can create the shared default path could plant it, so the
# directory must be ours and 0700; anything unverifiable is refused.
private_warning_state_path() {
  private_path=$(warning_state_path "$1" "${2:-}") || return 1
  private_dir=${private_path%/*}
  private_dir_ok "$private_dir" || return 1
  printf '%s\n' "$private_path"
}

# `sh` has no UID variable, so the default derives the user from id -u.
warning_root() {
  printf '%s\n' "${AGENT_GUARD_WARNING_DIR:-${TMPDIR:-/tmp}/agent-guard-warnings-$(id -u 2>/dev/null || echo user)}"
}

# Shared front half of every infrastructure-failure policy: apply the closed
# policy, warn on stderr when hook_warning_due says the open notice is due, and
# leave the message a caller may still want to publish in $INFRA_FAILURE_NOTICE
# (empty when this session warned within the interval). Callers differ only in
# WHERE that notice goes, because a
# hook may write at most one top-level JSON response: a handler that prints its
# own object cannot be followed by a second one.
INFRA_FAILURE_NOTICE=

begin_infrastructure_failure() {
  audit_note degraded
  bif_detail=$2
  INFRA_FAILURE_NOTICE=
  # The repeat interval applies only to the open warning. Each closed
  # block carries its own reason: a bare exit 2 reaches the host as a denial
  # with no verdict or explanation.
  if [ "$(infrastructure_failure_mode)" = closed ]; then
    audit_reason infra-failure-closed
    info "$bif_detail Blocking because AGENT_GUARD_INFRA_FAILURE_MODE=closed."
    withhold_post_tool_output
    exit 2
  fi
  if hook_warning_due "${1:-}"; then
    INFRA_FAILURE_NOTICE="$bif_detail continuing because AGENT_GUARD_INFRA_FAILURE_MODE=open (the default)."
    info "$INFRA_FAILURE_NOTICE"
  fi
  return 0
}

# Emits the notice immediately. Only safe where the caller returns without
# writing anything else to stdout; hook-user-prompt defers instead.
# hook_warning_due repeats when its marker cannot be written, and a second
# JSON object makes the stdout unparseable, which Claude's PreToolUse
# onFailure "block" turns into a block. So write at most one per process.
#
# Claude Code never shows a hook's exit-0 stderr, and additionalContext reaches
# only the model, so on Claude the same object also carries the notice as
# systemMessage, which its hook reference documents as a warning shown to the
# user on these events and on Stop (code.claude.com/docs/en/hooks, JSON
# output). Codex keeps the model-facing channel only: whether it shows a
# systemMessage from these events has not been verified.
INFRA_FAILURE_NOTICE_EMITTED=0

handle_hook_infrastructure_failure() {
  hif_event=$1
  hif_detail=$3
  # Another notice can be the first of the session while the scanner is
  # missing; carry the scanner notice with it so the marker it creates never
  # hides that the secret scan did not run.
  if [ "$HOOK_SCANNER_UNAVAILABLE" = 1 ]; then
    hif_scanner=$(degraded_hook_message scanner)
    [ "$hif_detail" = "$hif_scanner" ] || hif_detail="$hif_scanner $hif_detail"
  fi
  begin_infrastructure_failure "${2:-}" "$hif_detail"
  [ -n "$INFRA_FAILURE_NOTICE" ] || return 0
  [ "$INFRA_FAILURE_NOTICE_EMITTED" = 0 ] || return 0
  case "$(hook_host):$hif_event" in
    codex:PreToolUse|codex:PostToolUse|codex:PostToolUseFailure|codex:UserPromptSubmit)
      printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$hif_event" "$INFRA_FAILURE_NOTICE"
      INFRA_FAILURE_NOTICE_EMITTED=1
      ;;
    codex:*) ;;
    *:PreToolUse|*:PostToolUse|*:PostToolUseFailure|*:UserPromptSubmit)
      printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$INFRA_FAILURE_NOTICE" "$hif_event" "$INFRA_FAILURE_NOTICE"
      INFRA_FAILURE_NOTICE_EMITTED=1
      ;;
    *:Stop)
      printf '{"systemMessage":"%s"}\n' "$INFRA_FAILURE_NOTICE"
      INFRA_FAILURE_NOTICE_EMITTED=1
      ;;
  esac
  return 0
}

# A malformed hook envelope is attacker-controlled input, not unavailable
# scanner infrastructure. It must never inherit the default open policy. A
# PreToolUse or Stop exit can prevent the unsafe boundary action; PostToolUse
# runs after the tool, so its exit is only an explicit diagnostic after the
# valid-envelope recovery path has failed. Do not deduplicate the diagnostic.
validate_hook_object() {
  if printf '%s' "${2:-}" | jq -e 'type == "object"' >/dev/null 2>&1; then
    return 0
  fi
  audit_note blocked
  case "$1" in
    PostToolUse)
      info "$PROGRAM: the $1 hook input was not a JSON object; rejecting malformed input, but the host may retain an already-completed tool result"
      ;;
    *)
      info "$PROGRAM: the $1 hook input was not a JSON object; blocking because malformed hook input cannot be inspected safely"
      ;;
  esac
  exit 2
}

# Which host's hook contract this invocation speaks. Host-conditional hook
# branches route through this single default so adding a host or changing the
# fallback is a one-line change, not a grep for scattered ':-claude' defaults.
hook_host() {
  printf '%s\n' "${AGENT_GUARD_HOOK_HOST:-claude}"
}

# Claude Code renders an exit-2 block as "[<hooks.json command>]: <stderr>"
# unless stdout carries a JSON reason, which puts the hook command line before
# the reason (#294; the line is now the ~500-byte launcher command rather than
# the old ~2 KB inline resolver), and it echoes a blocked prompt back as "Original
# prompt:" unless suppressOriginalPrompt is set (#297). Exit 2 stays the block
# signal; the JSON only reshapes the message. Before Claude Code 2.1.214 an
# exit-2 hook whose JSON failed schema validation could stop blocking, so the
# JSON is added only when the host version is known to be newer. AI_AGENT
# (claude-code_2-1-289_harness, set by Claude Code since 2.1.120) is the only
# version signal a hook receives; without it the block stays stderr-only.
claude_block_json_supported() {
  [ "$(hook_host)" = claude ] || return 1
  case "${AI_AGENT:-}" in
    claude-code_*) ;;
    *) return 1 ;;
  esac
  cb_version=${AI_AGENT#claude-code_}
  cb_version=${cb_version%%_*}
  case "$cb_version" in
    ''|*[!0-9-]*|*[0-9][0-9][0-9][0-9][0-9][0-9]*) return 1 ;;
  esac
  cb_ifs=$IFS
  IFS=-
  # shellcheck disable=SC2086 # split on IFS=- into major, minor, patch
  set -- $cb_version
  IFS=$cb_ifs
  [ "$#" -eq 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ] || return 1
  semver_at_least "$1.$2.$3" 2.1.214
}

CLAUDE_BLOCK_EVENT=
CLAUDE_BLOCK_OUT=
CLAUDE_BLOCK_ERR=

# Handlers exit from deep inside, so the response is finished by the EXIT trap
# rather than a subshell (which would drop the trap's probe cleanup). If the
# buffers cannot be created, the streams stay untouched.
claude_block_capture_begin() {
  claude_block_json_supported || return 0
  CLAUDE_BLOCK_OUT=$(mktemp_file) || { CLAUDE_BLOCK_OUT=; return 0; }
  CLAUDE_BLOCK_ERR=$(mktemp_file) || {
    rm -f "$CLAUDE_BLOCK_OUT"
    CLAUDE_BLOCK_OUT=
    CLAUDE_BLOCK_ERR=
    return 0
  }
  CLAUDE_BLOCK_EVENT=$1
  exec 8>&1 9>&2 >"$CLAUDE_BLOCK_OUT" 2>"$CLAUDE_BLOCK_ERR"
}

# The reason is the handler's own stderr, which is already the masked text
# printed today. A handler that wrote its own stdout keeps it unchanged: a hook
# may emit only one top-level JSON object.
claude_block_capture_finish() {
  [ -n "$CLAUDE_BLOCK_EVENT" ] || return 0
  exec 1>&8 2>&9 8>&- 9>&-
  cat "$CLAUDE_BLOCK_ERR" >&2
  if [ "$1" -eq 2 ] && [ ! -s "$CLAUDE_BLOCK_OUT" ] && [ -s "$CLAUDE_BLOCK_ERR" ]; then
    case "$CLAUDE_BLOCK_EVENT" in
      PreToolUse)
        jq -Rsc '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: rtrimstr("\n")}}' ;;
      UserPromptSubmit)
        jq -Rsc '{decision: "block", reason: rtrimstr("\n"), hookSpecificOutput: {hookEventName: "UserPromptSubmit", suppressOriginalPrompt: true}}' ;;
      Stop)
        jq -Rsc '{decision: "block", reason: rtrimstr("\n")}' ;;
    esac <"$CLAUDE_BLOCK_ERR" 2>/dev/null || :
  else
    cat "$CLAUDE_BLOCK_OUT"
  fi
  rm -f "$CLAUDE_BLOCK_OUT" "$CLAUDE_BLOCK_ERR"
  CLAUDE_BLOCK_EVENT=
}

# What degraded_hook_message names: the checks hook_dependencies_ready makes,
# plus git, which SessionStart also requires. Fixed labels only, never a path:
# the message is embedded in hand-built JSON. Shell tests and the probe state
# prepare_gitleaks left behind answer every question without a new process,
# and the list is left in $dmc rather than printed to avoid a subshell.
# hook_dependencies_ready stops at the first failure, so a scanner it never
# probed (jq or awk missing) is not named yet.
degraded_missing_components() {
  dmc=
  command -v jq >/dev/null 2>&1 || dmc="${dmc:+$dmc, }jq"
  command -v awk >/dev/null 2>&1 || dmc="${dmc:+$dmc, }awk"
  command -v git >/dev/null 2>&1 || dmc="${dmc:+$dmc, }git"
  case "${GITLEAKS_PROBE_STATE:-}" in
    ''|ready) ;;
    missing) dmc="${dmc:+$dmc, }gitleaks" ;;
    runtime-failure)
      case "${GITLEAKS_PROBE_DETAIL:-}" in
        launcher-unavailable) dmc="${dmc:+$dmc, }setsid or perl (gitleaks process isolation)" ;;
        timer-unavailable) dmc="${dmc:+$dmc, }sleep (gitleaks timeout)" ;;
        temp-helper-unavailable) dmc="${dmc:+$dmc, }mkdir or rmdir (gitleaks temp fallback)" ;;
        *) dmc="${dmc:+$dmc, }a working gitleaks" ;;
      esac
      ;;
    *) dmc="${dmc:+$dmc, }a supported gitleaks" ;;
  esac
  { [ -f "$GITLEAKS_CONFIG" ] && policy_file_has_active_rule "$GITLEAKS_CONFIG"; } \
    || dmc="${dmc:+$dmc, }policy file gitleaks.toml"
  { [ -f "$DENY_READ_PATHS" ] && policy_file_has_active_rule "$DENY_READ_PATHS"; } \
    || dmc="${dmc:+$dmc, }policy file deny-read-paths.txt"
  { [ -f "$DENY_BASH_PATTERNS" ] && policy_file_has_active_rule "$DENY_BASH_PATTERNS"; } \
    || dmc="${dmc:+$dmc, }policy file deny-bash-patterns.txt"
  return 0
}

# $1 = scanner when only gitleaks or its config is unavailable and PreToolUse
# still ran its protected-path and deny-pattern checks.
degraded_hook_message() {
  case "$(hook_host)" in
    codex) setup_ref='$setup-agent-guard' ;;
    *) setup_ref='/agent-guard:setup-agent-guard' ;;
  esac
  degraded_missing_components
  if [ -n "$dmc" ]; then
    printf 'agent-guard: protection is DEGRADED because these are missing or unusable: %s.' "$dmc"
    [ "${1:-}" != scanner ] \
      || printf ' The scanner is unusable, so the secret scan did not run; protected-path and deny-pattern checks still run.'
  elif [ "${1:-}" = scanner ]; then
    printf 'agent-guard: protection is DEGRADED because gitleaks (including its setsid or Perl process-isolation helper) or its config is unavailable, so the secret scan did not run; protected-path and deny-pattern checks still run.'
  else
    printf 'agent-guard: protection is DEGRADED because jq, awk, git, gitleaks (including its setsid or Perl process-isolation helper), or a policy file is unavailable.'
  fi
  # Fixed diagnostic codes only: never include scanner output, scanned paths or
  # payloads in the host envelope. The one path allowed is this CLI's own
  # executable (AG_CLI_REF_HOOK), so a plugin-only install is told a command
  # that runs. hook_warning_due decides how often the notice repeats.
  degraded_probe_reason=
  case "${GITLEAKS_PROBE_STATE:-}" in
    # A missing scanner is already named above.
    missing) [ -n "$dmc" ] || degraded_probe_reason=missing ;;
    unparseable|unsupported) degraded_probe_reason=$GITLEAKS_PROBE_STATE ;;
    runtime-failure)
      if gitleaks_probe_detail_message "${GITLEAKS_PROBE_DETAIL:-}" '' >/dev/null; then
        degraded_probe_reason=$GITLEAKS_PROBE_DETAIL
      else
        degraded_probe_reason=runtime-failure
      fi
      ;;
  esac
  [ -z "$degraded_probe_reason" ] \
    || printf ' Scanner readiness: %s.' "$degraded_probe_reason"
  cli_ref_init
  printf ' Run %s (or %s setup), approve any required installation, verify with %s check and smoke-test, then restart the host;' \
    "$setup_ref" "$AG_CLI_REF_HOOK" "$AG_CLI_REF_HOOK"
}

emit_degraded_hook_warning() {
  handle_hook_infrastructure_failure "$1" "${2:-}" "$(degraded_hook_message)"
}

# PostToolUse may still emit one redaction response after an open git-backstop
# failure. Warn on stderr only here so the hook never emits two JSON responses.
handle_git_infrastructure_failure() {
  begin_infrastructure_failure "${1:-}" "$2"
  return 0
}

jq_lookbehind_supported() {
  printf '%s\n' '"x1"' \
    | jq -e 'test("(?<![0-9])1")' >/dev/null 2>&1
}


check_deps() {
  need_cmd sh
  need_cmd jq
  need_cmd git
  need_cmd awk
  need_gitleaks
  [ -f "$DENY_READ_PATHS" ] || die "deny read policy not found: $DENY_READ_PATHS"
  [ -f "$DENY_BASH_PATTERNS" ] || die "deny bash policy not found: $DENY_BASH_PATTERNS"
  # Never report ok for a state in which hooks would run degraded.
  if check_policy=$(hook_policy_unusable); then
    die "policy file has no active rule: $check_policy"
  fi
  info "$PROGRAM: dependencies ok"
  if jq_lookbehind_supported; then
    info "$PROGRAM: jq regex lookbehind supported"
  else
    info "$PROGRAM: jq regex lookbehind unavailable (PostToolUse uses the conservative shape-preserving fallback)"
  fi
  info "$PROGRAM: gitleaks $GITLEAKS_PROBE_VERSION (required >= $GITLEAKS_MIN_VERSION; $GITLEAKS_BIN)"
}

SETUP_INSTALL_DIR=$GITLEAKS_PRIVATE_BIN_DIR

setup_status_line() {
  name=$1
  if command -v "$name" >/dev/null 2>&1; then
    # stdin closed: `awk version` is an awk program that would read the terminal.
    ver=$($name --version </dev/null 2>/dev/null | head -1)
    if [ -z "$ver" ]; then
      ver=$($name version </dev/null 2>/dev/null | head -1)
    fi
    info "$PROGRAM: $name  ok  (${ver:-installed})"
    return 0
  fi
  info "$PROGRAM: $name  missing"
  return 1
}

setup_gitleaks_status_line() {
  if gl=$(resolve_gitleaks); then
    if probe_gitleaks "$gl"; then
      info "$PROGRAM: gitleaks  ok  ($GITLEAKS_PROBE_VERSION; $gl)"
      return 0
    fi
    case "$GITLEAKS_PROBE_STATE" in
      missing)
        info "$PROGRAM: gitleaks  missing  (selected path is not executable: $gl)"
        ;;
      runtime-failure)
        probe_detail=$(gitleaks_probe_error "$gl")
        info "$PROGRAM: gitleaks  runtime failure  ($probe_detail)"
        ;;
      unparseable)
        info "$PROGRAM: gitleaks  unparseable  (required >= $GITLEAKS_MIN_VERSION; $gl)"
        ;;
      unsupported)
        info "$PROGRAM: gitleaks  unsupported  ($GITLEAKS_PROBE_VERSION; required >= $GITLEAKS_MIN_VERSION; $gl)"
        ;;
      *) info "$PROGRAM: gitleaks  unavailable  ($gl)" ;;
    esac
    return 1
  fi
  if [ -n "${AGENT_GUARD_GITLEAKS_BIN:-}" ]; then
    info "$PROGRAM: gitleaks  missing (AGENT_GUARD_GITLEAKS_BIN is not executable: $AGENT_GUARD_GITLEAKS_BIN)"
  else
    info "$PROGRAM: gitleaks  missing"
  fi
  return 1
}

setup_jq_lookbehind_status_line() {
  if jq_lookbehind_supported; then
    info "$PROGRAM: jq regex lookbehind  supported"
  else
    info "$PROGRAM: jq regex lookbehind  unavailable (PostToolUse uses the conservative shape-preserving fallback)"
  fi
  return 0
}

# $1 is the package name and $2 the download page when no known package
# manager is available.
setup_suggest_pkg_install() {
  if command -v brew >/dev/null 2>&1; then
    info "  brew install $1"
  elif command -v apt-get >/dev/null 2>&1; then
    info "  sudo apt-get install -y $1"
  elif command -v dnf >/dev/null 2>&1; then
    info "  sudo dnf install -y $1"
  else
    info "  $2"
  fi
}

setup_suggest_gitleaks_runtime_repair() {
  cli_ref_init
  case "$GITLEAKS_PROBE_DETAIL" in
    launcher-unavailable)
      info "$PROGRAM: install a gitleaks process-isolation helper:"
      if command -v brew >/dev/null 2>&1; then
        info "  brew install perl"
      elif command -v apt-get >/dev/null 2>&1; then
        info "  sudo apt-get install -y util-linux"
      elif command -v dnf >/dev/null 2>&1; then
        info "  sudo dnf install -y util-linux"
      else
        info "  install setsid (util-linux) or Perl, then rerun $AG_CLI_REF doctor"
      fi
      return 0
      ;;
    timer-unavailable)
      info "$PROGRAM: install the POSIX sleep utility, then rerun $AG_CLI_REF doctor"
      return 0
      ;;
    temp-helper-unavailable)
      info "$PROGRAM: install the POSIX mkdir and rmdir utilities, then rerun $AG_CLI_REF doctor"
      return 0
      ;;
  esac
  return 1
}

setup_install_gitleaks() {
  version=$1
  checksum=$2
  if [ -z "$checksum" ]; then
    die "setup: --gitleaks-checksum is required when using --install. Get the published value from https://github.com/gitleaks/gitleaks/releases/download/v${version}/gitleaks_${version}_checksums.txt"
  fi

  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m)
  case "$arch" in
    x86_64|amd64) arch=x64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) die "setup: unsupported architecture: $arch" ;;
  esac
  case "$os" in
    darwin|linux) ;;
    *) die "setup: unsupported os: $os" ;;
  esac

  need_cmd curl
  need_cmd shasum
  need_cmd tar

  archive="gitleaks_${version}_${os}_${arch}.tar.gz"
  url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}"

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-setup.XXXXXX") || die "setup: failed to create temp dir"
  AG_EXIT_TMP_DIR=$tmp

  info "$PROGRAM: downloading $archive"
  curl -fsSL "$url" -o "$tmp/$archive" || die "setup: download failed: $url"

  info "$PROGRAM: verifying sha256"
  printf '%s  %s\n' "$checksum" "$tmp/$archive" | shasum -a 256 -c - >&2 \
    || die "setup: checksum verification failed for $archive"

  info "$PROGRAM: extracting"
  tar -xzf "$tmp/$archive" -C "$tmp" || die "setup: extraction failed"

  mkdir -p "$SETUP_INSTALL_DIR" || die "setup: cannot create install dir: $SETUP_INSTALL_DIR"
  mv "$tmp/gitleaks" "$SETUP_INSTALL_DIR/gitleaks" || die "setup: failed to install gitleaks binary"
  chmod +x "$SETUP_INSTALL_DIR/gitleaks"

  info "$PROGRAM: installed gitleaks v${version} at $SETUP_INSTALL_DIR/gitleaks"
  case ":$PATH:" in
    *":$SETUP_INSTALL_DIR:"*) ;;
    *)
      info "$PROGRAM: $SETUP_INSTALL_DIR is not on PATH; add to your shell rc:"
      info "  export PATH=\"$SETUP_INSTALL_DIR:\$PATH\""
      ;;
  esac
}

do_setup() {
  install=0
  version=$GITLEAKS_DEFAULT_VERSION
  checksum=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) install=1 ;;
      --gitleaks-version)
        shift
        [ $# -gt 0 ] || die "setup: --gitleaks-version requires a value"
        version=$1
        ;;
      --gitleaks-version=*) version=${1#--gitleaks-version=} ;;
      --gitleaks-checksum)
        shift
        [ $# -gt 0 ] || die "setup: --gitleaks-checksum requires a value"
        checksum=$1
        ;;
      --gitleaks-checksum=*) checksum=${1#--gitleaks-checksum=} ;;
      -h|--help)
        cat >&2 <<'EOF'
Usage:
  agent-guard setup
  agent-guard setup --install --gitleaks-checksum SHA [--gitleaks-version X.Y.Z]

Default behavior is opt-in: setup only reports the dependency status.
Pass --install to download gitleaks. The checksum is required and must
match the published value at:
  https://github.com/gitleaks/gitleaks/releases/download/vX.Y.Z/gitleaks_X.Y.Z_checksums.txt
EOF
        return 0
        ;;
      *) die "setup: unknown argument: $1" ;;
    esac
    shift
  done

  jq_ok=1; awk_ok=1; git_ok=1; gitleaks_ok=1
  setup_status_line jq       || jq_ok=0
  [ "$jq_ok" -eq 0 ] || setup_jq_lookbehind_status_line
  setup_status_line awk      || awk_ok=0
  setup_status_line git      || git_ok=0
  setup_gitleaks_status_line || gitleaks_ok=0
  # setup and doctor can establish only local dependencies.
  # A host must still dispatch one of its hook commands before runtime
  # protection can be observed; never imply that this CLI has inspected that
  # boundary or authenticated a host decision.
  info "$PROGRAM: host hook protection: unverified (dependency checks do not observe tool dispatch)"

  if [ "$install" -eq 1 ]; then
    gitleaks_runtime_ok=1
    if [ "$gitleaks_ok" -eq 1 ]; then
      info "$PROGRAM: gitleaks already available; skipping --install"
    elif setup_suggest_gitleaks_runtime_repair; then
      gitleaks_runtime_ok=0
    elif ! select_gitleaks_probe_launcher; then
      GITLEAKS_PROBE_DETAIL=launcher-unavailable
      setup_suggest_gitleaks_runtime_repair
      gitleaks_runtime_ok=0
    else
      setup_install_gitleaks "$version" "$checksum"
      GITLEAKS_READY_BIN=
      if ! setup_gitleaks_status_line; then
        gitleaks_runtime_ok=0
        setup_suggest_gitleaks_runtime_repair || :
      fi
    fi
    if [ "$jq_ok" -eq 0 ]; then
      info "$PROGRAM: jq is not auto-installed; use your system package manager:"
      setup_suggest_pkg_install jq https://stedolan.github.io/jq/download/
    fi
    if [ "$awk_ok" -eq 0 ]; then
      info "$PROGRAM: awk is not auto-installed; use your system package manager:"
      setup_suggest_pkg_install gawk https://www.gnu.org/software/gawk/
    fi
    if [ "$git_ok" -eq 0 ]; then
      info "$PROGRAM: git is not auto-installed; use your system package manager:"
      setup_suggest_pkg_install git https://git-scm.com/downloads
    fi
    [ "$jq_ok" -eq 1 ] && [ "$awk_ok" -eq 1 ] && [ "$git_ok" -eq 1 ] \
      && [ "$gitleaks_runtime_ok" -eq 1 ]
    return $?
  fi

  if [ "$jq_ok" -eq 0 ] || [ "$awk_ok" -eq 0 ] || [ "$git_ok" -eq 0 ] \
      || [ "$gitleaks_ok" -eq 0 ]; then
    info ""
    if [ "$jq_ok" -eq 0 ]; then
      info "$PROGRAM: install jq with your package manager:"
      setup_suggest_pkg_install jq https://stedolan.github.io/jq/download/
    fi
    if [ "$awk_ok" -eq 0 ]; then
      info "$PROGRAM: install awk with your package manager:"
      setup_suggest_pkg_install gawk https://www.gnu.org/software/gawk/
    fi
    if [ "$git_ok" -eq 0 ]; then
      info "$PROGRAM: install git with your package manager:"
      setup_suggest_pkg_install git https://git-scm.com/downloads
    fi
    if [ "$gitleaks_ok" -eq 0 ]; then
      if ! setup_suggest_gitleaks_runtime_repair; then
        cli_ref_init
        info "$PROGRAM: install gitleaks (rerun with --install to opt in):"
        info "  $AG_CLI_REF setup --install \\"
        info "    --gitleaks-version $GITLEAKS_DEFAULT_VERSION \\"
        info "    --gitleaks-checksum <sha256-from-published-checksums.txt>"
        info ""
        info "$PROGRAM: get the checksum from"
        info "  https://github.com/gitleaks/gitleaks/releases/download/v$GITLEAKS_DEFAULT_VERSION/gitleaks_${GITLEAKS_DEFAULT_VERSION}_checksums.txt"
      fi
    fi
    return 1
  fi

  info "$PROGRAM: setup ok (dependencies only)"
  return 0
}

write_private_key_fixture() {
  path=$1
  body=AGENT-GUARD-FIXTURE-NEVER-A-REAL-KEY
  body="${body}-${body}-${body}-${body}"
  {
    printf '%s%s\n' '-----BEGIN RSA ' 'PRIVATE KEY-----'
    printf '%s\n' "$body"
    printf '%s%s\n' '-----END RSA ' 'PRIVATE KEY-----'
  } >"$path"
}

smoke_expect() {
  expected=$1
  label=$2
  shift 2
  ( "$@" ) >/dev/null 2>&1
  status=$?
  if [ "$status" -eq "$expected" ]; then
    info "$PROGRAM: smoke ok: $label"
    return 0
  fi
  die "smoke failed: $label (expected exit $expected, got $status)"
}

smoke_test() {
  check_deps
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-smoke.XXXXXX") || die "smoke: failed to create temp dir"
  AG_EXIT_TMP_DIR=$tmp

  mkdir -p "$tmp/clean" "$tmp/dirty"
  printf '%s\n' "console.log('ok')" >"$tmp/clean/app.js"
  write_private_key_fixture "$tmp/dirty/private-key-fixture.txt"

  smoke_expect 0 "scan-path allows a clean directory" scan_path "$tmp/clean"
  smoke_expect 1 "scan-path blocks a private-key fixture" scan_path "$tmp/dirty"

  printf '%s' '{"tool_name":"Read","tool_input":{"file_path":".env"}}' \
    | smoke_expect 2 "hook-pre-tool blocks .env reads" hook_pre_tool

  printf '%s\n' "Contact smoke@example.com from 203.0.113.42" \
    | smoke_expect 0 "pii-filter runs with the regex provider" pii_filter

  write_payload=$(mktemp_file) || die "smoke: failed to create temp file"
  jq -c -R -s '{tool_name: "Write", tool_input: {file_path: "guard-fixture.txt", content: .}}' \
    <"$tmp/dirty/private-key-fixture.txt" >"$write_payload"
  smoke_expect 2 "hook-pre-tool blocks secret-like writes" hook_pre_tool <"$write_payload"
  rm -f "$write_payload"

  repo="$tmp/repo"
  mkdir -p "$repo"
  (
    cd "$repo" || exit 2
    git init -q || exit 2
    git config user.email test@example.com || exit 2
    git config user.name "Agent Guard Smoke" || exit 2
    git config commit.gpgsign false || exit 2
    printf '%s\n' ok >README.md
    git add README.md || exit 2
    git commit -q -m init || exit 2
    mkdir -p githooks
    {
      printf '%s\n' '#!/usr/bin/env sh'
      printf 'exec %s scan-staged\n' "$(sh_squote "$SELF_BIN")"
    } >githooks/pre-commit
    chmod +x githooks/pre-commit || exit 2
    git config core.hooksPath githooks || exit 2
    write_private_key_fixture staged-fixture.txt
    git add staged-fixture.txt || exit 2
    git commit -m leak >/dev/null 2>&1
    status=$?
    [ "$status" -ne 0 ] || exit 1
  ) || die "smoke failed: native pre-commit hook did not block staged fixture"
  info "$PROGRAM: smoke ok: native pre-commit hook blocks staged fixture"
  info "$PROGRAM: smoke-test ok"
}

mktemp_file() {
  # Every scan temp file lands under the per-invocation rundir (created once at
  # dispatch) so the single EXIT/INT/TERM trap removes all of them even when a
  # scan is interrupted mid-run. When there is no rundir — sourced in tests, or
  # its creation failed — the fallback makes a standalone mktemp file, so temp
  # allocation never hard-fails.
  if [ -n "${AGENT_GUARD_RUNDIR:-}" ] && [ -d "$AGENT_GUARD_RUNDIR" ]; then
    rundir_temp_file && return 0
    mktemp "$AGENT_GUARD_RUNDIR/agent-guard.XXXXXX" 2>/dev/null && return 0
  fi
  mktemp "${TMPDIR:-/tmp}/agent-guard.XXXXXX" 2>/dev/null || mktemp /tmp/agent-guard.XXXXXX
}

# A hook allocates a couple dozen scan temp files, and a mktemp process for
# each was a large share of its execs (#407). Inside the private rundir that
# mktemp -d created (mode 700, removed by the exit trap) a name only has to be
# unique, not unpredictable, so claim one with the shell alone:
#   - noclobber (set -C) makes each create an O_EXCL open, so two claimers can
#     never get the same name and an existing entry is never reused;
#   - a never-deleted .claim.N marker is taken first, so a number whose temp
#     file a caller already removed is not handed out again;
#   - .next is only a starting hint; a lost or stale update costs a retry;
#   - the file is created under umask 077 (mode 600, as mktemp makes it) and
#     the caller's umask and noclobber setting are restored afterwards.
# Any doubt -- no saved umask, a symlinked rundir, no free name in a bounded
# number of tries -- returns 1 and mktemp_file falls back to mktemp.
rundir_temp_file() {
  rt_dir=${AGENT_GUARD_RUNDIR:-}
  [ -n "$rt_dir" ] && [ -d "$rt_dir" ] && [ ! -L "$rt_dir" ] || return 1
  rt_n=
  { IFS= read -r rt_n <"$rt_dir/.next"; } 2>/dev/null || rt_n=
  case "$rt_n" in ''|0*|*[!0123456789]*|?????????*) rt_n=1 ;; esac
  private_writes_begin || return 1
  rt_file=
  rt_tries=0
  while [ -z "$rt_file" ] && [ "$rt_tries" -lt 64 ]; do
    rt_tries=$((rt_tries + 1))
    rt_try="$rt_dir/agent-guard.$rt_n"
    rt_claim="$rt_dir/.claim.$rt_n"
    # noclobber opens an existing non-regular file (a FIFO would block the
    # hook) without O_EXCL, so any entry already at either name is skipped
    # before a redirection touches it.
    if [ -e "$rt_claim" ] || [ -L "$rt_claim" ] \
        || [ -e "$rt_try" ] || [ -L "$rt_try" ]; then
      :
    elif { printf '' >"$rt_claim"; } 2>/dev/null \
        && { printf '' >"$rt_try"; } 2>/dev/null \
        && [ -f "$rt_try" ] && [ ! -L "$rt_try" ]; then
      rt_file=$rt_try
    fi
    rt_n=$((rt_n + 1))
  done
  private_writes_end
  [ -n "$rt_file" ] || return 1
  { printf '%s\n' "$rt_n" >|"$rt_dir/.next"; } 2>/dev/null || :
  printf '%s\n' "$rt_file"
}

pii_filter_usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard pii-filter [--check]

Reads text from stdin and writes masked text to stdout.
Set AGENT_GUARD_PII_PROVIDER=regex|http|pleno to choose a provider (default: regex).
  regex  built-in local adapter; no network access.
  http   experimental bring-your-own-endpoint adapter; needs
         AGENT_GUARD_PII_REDACT_URL; no service compatibility guarantee.
  pleno  verified pleno-anonymize /api/redact adapter; needs
         AGENT_GUARD_PII_REDACT_URL. AGENT_GUARD_PII_LANGUAGE defaults to en.
EOF
}

# Keep accepted-value validation in one place so filter and --check cannot
# drift apart. Unknown values fail closed rather than reaching pass-through
# output or an unvalidated endpoint contract.
pii_unsupported_provider() {
  die "pii-filter: unsupported provider: $1 (expected regex, http, or pleno)"
}

# Tier-1 types AGENT_GUARD_PII_SKIP may turn off. Tier-2 (credit card, US SSN,
# KR resident reg. no.) is deliberately absent: masking those is what the
# mask-mode input hard-block is derived from, and a fail-closed gate must not be
# switchable from the environment. The names are the output placeholders
# (`[PII:IP_ADDRESS]`), so what to write is readable off the masked output.
PII_SKIPPABLE=',EMAIL,PHONE,IP_ADDRESS,'

# Sets PII_SKIP to the skip set normalized to `,A,B,` so a substring test is an
# exact name test. Separators are commas and/or spaces. An unknown or Tier-2 name
# dies rather than being ignored: someone who wrote AGENT_GUARD_PII_SKIP=CREDIT_CARD
# expects cards to pass and has to be told the knob cannot do that. It sets a
# variable instead of printing because a die inside $( ) would end only the
# subshell and let the misconfiguration run on.
pii_skip_set() {
  # skip_-prefixed names throughout: sh has no locals, and this runs in the main
  # shell of callers that hold their own `out` / `name` / `raw`.
  PII_SKIP=,
  skip_raw=${AGENT_GUARD_PII_SKIP:-}
  [ -n "$skip_raw" ] || return 0
  case $- in *f*) skip_had_noglob=1 ;; *) skip_had_noglob=0 ;; esac
  skip_oifs=$IFS
  IFS=', '
  set -f
  # Intentional word splitting: this is the list parse.
  set -- $skip_raw
  IFS=$skip_oifs
  [ "$skip_had_noglob" -eq 1 ] || set +f
  skip_out=,
  for skip_name in "$@"; do
    case "$PII_SKIPPABLE" in
      *",$skip_name,"*) ;;
      *) die "AGENT_GUARD_PII_SKIP: unsupported type: $skip_name (expected EMAIL, PHONE, or IP_ADDRESS)" ;;
    esac
    case $skip_out in
      *",$skip_name,"*) continue ;;
    esac
    skip_out="$skip_out$skip_name,"
  done
  # An endpoint provider redacts server-side and never receives the skip set, so
  # accepting one would leave a switch that silently does nothing on every path
  # that goes through the provider. An unknown provider value is left alone here
  # so the adapter still reports it as the provider error it is.
  if [ "$skip_out" != , ]; then
    case "${AGENT_GUARD_PII_PROVIDER:-regex}" in
      http|pleno)
        die "AGENT_GUARD_PII_SKIP is only supported with AGENT_GUARD_PII_PROVIDER=regex (got ${AGENT_GUARD_PII_PROVIDER})"
        ;;
    esac
  fi
  PII_SKIP=$skip_out
}

# Held here so the CLI masker and the hook input gate below read the SAME
# Tier-2 patterns instead of two hand-kept copies. They contain no backslashes,
# so `awk -v` passes them through unchanged. mask_pii_response_json is a jq
# transcription of the same shapes and still has to change alongside them;
# tests/run.sh drives one sample of each through all three.
# The 19-digit PAN is a separate pattern rather than an optional tail group:
# greedy matching would otherwise swallow a following 3-digit number, fail Luhn
# on the 19 digits, and lose the valid 16-digit card inside it. Longest first.
PII_CREDIT_CARD_RE='[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9]'
PII_CREDIT_CARD19_RE="$PII_CREDIT_CARD_RE"'[ -]?[0-9][0-9][0-9]'
PII_AMEX_RE='3[47][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][0-9]'
PII_SSN_RE='[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
PII_KR_RRN_RE='[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9][0-9]'
PII_IPV4_RE='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))'

# awk has no \b and its gsub() cannot veto an individual match, so every
# validated pattern goes through mask_re(): it walks matches left to right,
# requires non-digit boundaries, and lets a validator reject a candidate. That
# is what keeps epoch-nanosecond timestamps and Snowflake ids — card-shaped but
# unbounded and Luhn-invalid — out of the Tier-2 verdict. Shared verbatim by
# pii_regex_adapter_filter and pii_tier2_present; mask_pii_response_json is the
# jq transcription (Oniguruma lookaround in place of the boundary checks) and
# must change alongside it. tests/run.sh drives every case through all three.
PII_AWK_LIB='
function tail2(s) { return (length(s) > 2) ? substr(s, length(s) - 1) : s }
function luhn(s,   i, d, sum, alt) {
  gsub(/[^0-9]/, "", s)
  sum = 0; alt = 0
  for (i = length(s); i >= 1; i--) {
    d = substr(s, i, 1) + 0
    if (alt) { d *= 2; if (d > 9) { d -= 9 } }
    sum += d
    alt = !alt
  }
  return (length(s) > 0 && sum % 10 == 0)
}
function pii_bounded(kind, before, after) {
  if (kind == "ipv4") { return (before !~ /[0-9][.]?$/ && after !~ /^[.]?[0-9]/) }
  return (before !~ /[0-9]$/ && after !~ /^[0-9]/)
}
BEGIN {
  # awk cannot start match() at an offset, so mask_re walks a sliding window
  # rather than re-slicing the whole remainder after every candidate — that
  # copy is per-candidate and turns one long line of card-shaped rejects
  # quadratic, past the host hook timeouts in hooks/hooks.json.
  # PII_MARGIN must exceed the longest text any pattern can match (19 digits
  # plus three separators), so a match landing clear of the margin is whole.
  PII_WIN = 512
  PII_MARGIN = 64
}
function mask_re(s, re, repl, kind,   out, n, pos, win, wlen, mstart, mlen, mend, pre, m, after, skip) {
  n = length(s)
  out = ""
  pos = 1
  while (pos <= n) {
    win = substr(s, pos, PII_WIN)
    wlen = length(win)
    if (!match(win, re)) {
      # Nothing here. The tail margin may hold the start of a match that runs
      # past this window, so emit everything before it and slide.
      if (pos + wlen > n) { break }
      out = out substr(win, 1, wlen - PII_MARGIN)
      pos = pos + wlen - PII_MARGIN
      continue
    }
    mstart = RSTART
    mlen = RLENGTH
    mend = mstart + mlen - 1
    if (mstart > 1 && mend > wlen - PII_MARGIN && pos + wlen <= n) {
      # The match reaches into the margin with more input behind it, so it may
      # be truncated. Re-window from its start and look again.
      out = out substr(win, 1, mstart - 1)
      pos = pos + mstart - 1
      continue
    }
    pre = substr(win, 1, mstart - 1)
    m = substr(win, mstart, mlen)
    after = substr(win, mend + 1, 2)
    if (pii_bounded(kind, tail2(tail2(out) pre), after) \
        && (kind != "luhn" || luhn(m))) {
      out = out pre repl
      pos = pos + mend
    } else {
      # A rejected candidate cannot start again inside its own leading digit
      # run: every position in there has a digit in front of it, which the
      # boundary rule refuses. Skip the whole run, not one character.
      skip = match(m, /^[0-9]+/) ? RLENGTH : 1
      out = out pre substr(m, 1, skip)
      pos = pos + mstart - 1 + skip
    }
  }
  if (pos <= n) { out = out substr(s, pos) }
  return out
}
function mask_tier2(s) {
  s = mask_re(s, CC19_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, CC16_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, AMEX_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, KR_RRN_RE, "[PII:KR_RRN]", "digits")
  s = mask_re(s, SSN_RE, "[PII:SSN]", "digits")
  return s
}
'

# pii_awk PROGRAM [awk options...] runs PROGRAM after PII_AWK_LIB in the C
# locale, with every pattern the library reads already bound.
pii_awk() {
  pii_awk_program=$1
  shift
  LC_ALL=C awk -v CC16_RE="$PII_CREDIT_CARD_RE" -v CC19_RE="$PII_CREDIT_CARD19_RE" \
      -v AMEX_RE="$PII_AMEX_RE" -v SSN_RE="$PII_SSN_RE" \
      -v KR_RRN_RE="$PII_KR_RRN_RE" -v IPV4_RE="$PII_IPV4_RE" \
      "$@" "$PII_AWK_LIB$pii_awk_program"
}

pii_regex_byte_stage() {
  # Byte windows can split UTF-8 characters. Numeric patterns use C locale;
  # email classification stays in the caller's locale in the middle pass.
  pii_awk '
    BEGIN {
      kr_mobile = "01[0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9]"
      phone = "([+]?[0-9][ .-]?)?([(][0-9][0-9][0-9][)]|[0-9][0-9][0-9])[ .-]?[0-9][0-9][0-9][ .-]?[0-9][0-9][0-9][0-9]"
    }
    {
      line = $0
      if (STAGE == "first") {
        line = mask_tier2(line)
        if (!index(SKIP, ",IP_ADDRESS,")) {
          line = mask_re(line, IPV4_RE, "[PII:IP_ADDRESS]", "ipv4")
        }
        # Preserve record framing between passes; only the last pass applies
        # the existing filter behavior of omitting the final newline.
        printf "%s\n", line
      } else {
        if (!index(SKIP, ",PHONE,")) {
          line = mask_re(line, kr_mobile, "[PII:PHONE]", "digits")
          line = mask_re(line, phone, "[PII:PHONE]", "digits")
        }
        if (NR > 1) { printf "%s", ORS }
        printf "%s", line
      }
    }
  ' -v STAGE="$1" -v SKIP="$2"
}

pii_regex_adapter_filter() (
  need_cmd awk
  pii_skip_set
  umask 077
  pii_work=$(mktemp -d "${AGENT_GUARD_RUNDIR:-${TMPDIR:-/tmp}}/pii.XXXXXX") || exit 2
  trap 'rm -rf "$pii_work"' 0
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  # Buffer each stage and check its status before exposing any final output.
  pii_regex_byte_stage first "$PII_SKIP" >"$pii_work/first" || exit "$?"
  awk -v SKIP="$PII_SKIP" '
    BEGIN { email = "[[:alnum:]_%+.-]+@[[:alnum:].-]+[.][[:alpha:]][[:alpha:]][[:alpha:]]*" }
    {
      if (!index(SKIP, ",EMAIL,")) { gsub(email, "[PII:EMAIL]") }
      printf "%s\n", $0
    }
  ' <"$pii_work/first" >"$pii_work/email" || exit "$?"
  pii_regex_byte_stage last "$PII_SKIP" <"$pii_work/email" >"$pii_work/last" || exit "$?"
  cat "$pii_work/last"
)

pii_endpoint_adapter_filter() {
  provider=$1
  need_cmd curl
  need_cmd jq
  url=${AGENT_GUARD_PII_REDACT_URL:-}
  [ -n "$url" ] || die "pii-filter: AGENT_GUARD_PII_REDACT_URL is required for provider: $provider"

  timeout=${AGENT_GUARD_PII_TIMEOUT_SECONDS:-30}
  case "$timeout" in
    ''|*[!0-9]*) die "pii-filter: AGENT_GUARD_PII_TIMEOUT_SECONDS must be a positive integer" ;;
  esac
  [ "$timeout" -gt 0 ] 2>/dev/null \
    || die "pii-filter: AGENT_GUARD_PII_TIMEOUT_SECONDS must be a positive integer"
  if [ "${AGENT_GUARD_PII_HOOK_REQUEST:-}" = 1 ] && [ "$timeout" -gt 5 ]; then
    timeout=5
  fi

  # Provider differences end here, so the request and reader below stay common:
  # a change to the response contract — "exactly one JSON object", the
  # string-typed requirement, the fail-closed die — cannot land for one provider
  # and silently miss the other.
  case "$provider" in
    http)
      payload=$(jq -Rs '{text: .}') \
        || die "pii-filter: $provider provider request serialization failed"
      response_paths='[["redacted_text"],["anonymized_text"],["text"],["data","redacted_text"]]'
      response_shape='redacted_text, anonymized_text, text, or data.redacted_text'
      ;;
    pleno)
      language=${AGENT_GUARD_PII_LANGUAGE:-en}
      case "$language" in
        en|ja) ;;
        *) die "pii-filter: AGENT_GUARD_PII_LANGUAGE must be en or ja for provider: pleno" ;;
      esac
      payload=$(jq -Rs --arg language "$language" '{text: ., language: $language}') \
        || die "pii-filter: $provider provider request serialization failed"
      response_paths='[["text"]]'
      response_shape='string text'
      ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
  out=$(mktemp_file) || die "pii-filter: failed to create temp file"
  if ! printf '%s' "$payload" \
    | curl -fsS --max-time "$timeout" -H 'Content-Type: application/json' -d @- "$url" \
      >"$out" 2>/dev/null; then
    rm -f "$out"
    die "pii-filter: $provider provider request failed"
  fi

  # `first` stops at the earliest string-typed field, so a later path is never
  # evaluated once an earlier one matched — a response carrying both
  # `redacted_text` and a non-object `data` still resolves instead of erroring.
  # No match at all produces no output, which `-e` reports as a failure and the
  # die below turns into a fail-closed refusal rather than empty "masked" text.
  if ! jq -e -r -s -j --argjson paths "$response_paths" '
    if length != 1 or (.[0] | type != "object") then
      error("expected exactly one JSON object")
    else .[0]
    end
    | . as $body
    | first($paths[] as $path | $body | getpath($path) | select(type == "string"))
  ' "$out"; then
    rm -f "$out"
    die "pii-filter: $provider provider returned invalid response; expected JSON with $response_shape"
  fi
  rm -f "$out"
}

pii_adapter_filter() {
  provider=${1:-${AGENT_GUARD_PII_PROVIDER:-regex}}
  case "$provider" in
    regex) pii_regex_adapter_filter ;;
    http|pleno) pii_endpoint_adapter_filter "$provider" ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
}

pii_adapter_check() {
  provider=$1
  case "$provider" in
    regex)
      need_cmd awk
      info "$PROGRAM: PII provider regex ok"
      ;;
    http|pleno)
      printf '%s' "agent-guard pii provider check" | pii_endpoint_adapter_filter "$provider" >/dev/null
      status=$?
      [ "$status" -eq 0 ] || exit "$status"
      info "$PROGRAM: PII provider $provider ok"
      ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
}

pii_filter() {
  check=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --check) check=1 ;;
      -h|--help)
        pii_filter_usage
        return 0
        ;;
      *) die "pii-filter: unknown argument: $1" ;;
    esac
    shift
  done

  provider=${AGENT_GUARD_PII_PROVIDER:-regex}
  # Validate here, not only inside the adapter: --check never reaches the adapter
  # and would otherwise report "ok" for a skip set every real run refuses.
  pii_skip_set
  if [ "$check" -eq 1 ]; then
    pii_adapter_check "$provider"
    return 0
  fi
  pii_adapter_filter "$provider"
}

pii_text_has_match() {
  text=$1
  [ -n "$text" ] || return 1
  masked=$(printf '%s' "$text" | AGENT_GUARD_PII_HOOK_REQUEST=1 pii_adapter_filter)
  status=$?
  [ "$status" -eq 0 ] || exit "$status"
  [ "$masked" != "$text" ]
}

# Sets PII_HOOK_MODE; like pii_skip_set it runs in the caller's shell so an
# unsupported value stops the hook instead of turning the gate off.
pii_hook_mode() {
  PII_HOOK_MODE=${AGENT_GUARD_PII_HOOK_MODE:-off}
  case "$PII_HOOK_MODE" in
    off|block|mask) ;;
    *) die "unsupported PII hook mode: $PII_HOOK_MODE (expected off, block, or mask)" ;;
  esac
}

# High-sensitivity ("Tier 2") PII that must never reach a tool input even in
# mask mode: SSN, credit card, and Korean resident registration number. Detected
# directly (provider-independent) so the input gate works for any provider, since
# only the regex adapter exposes typed markers. Reads the same PII_*_RE patterns
# the CLI masker uses; mask_pii_response_json is the jq transcription and must
# change with them. tests/run.sh drives a credit card, SSN, and resident reg. no.
# through this gate (expect exit 2) and through the masker.
pii_tier2_present() {
  text=$1
  [ -n "$text" ] || return 1
  need_cmd awk
  printf '%s' "$text" | pii_awk '
    mask_tier2($0) != $0 { found = 1 }
    END { exit (found ? 0 : 1) }
  '
}

# Input gate. block mode blocks ANY PII (run pii-filter first); mask mode only
# hard-blocks Tier-2 PII on the way in (Tier-1 — email/phone/IP — is allowed in
# and masked on the way out instead). off never reaches here.
block_on_pii_text() {
  label=$1
  text=$2
  pii_hook_mode
  case "$PII_HOOK_MODE" in
    block)
      pii_text_has_match "$text" || return 0
      cli_ref_init
      info "$PROGRAM: blocked PII in $label; run $AG_CLI_REF_HOOK pii-filter before using this tool"
      audit_reason pii
      exit 2
      ;;
    mask)
      # Fail closed: only a definitive "no Tier-2 PII" (status 1) lets input
      # through; a detector error (awk missing/failed) blocks rather than
      # silently allowing high-sensitivity PII into the tool.
      pii_tier2_present "$text"
      status=$?
      case "$status" in
        1) return 0 ;;
        0)
          info "$PROGRAM: blocked high-sensitivity PII (SSN/credit card/resident reg. no.) in $label"
          audit_reason pii
          ;;
        *)
          info "$PROGRAM: blocked input: Tier-2 PII detector failed (status $status) in $label"
          audit_reason pii-detector-failure
          ;;
      esac
      exit 2
      ;;
  esac
}

# The tools that propose file content, read the same way by the PII gate, the
# secret gate and the post-tool target scan. The jq expressions are the
# json_value_cached keys, so they must stay byte-identical to that table.

# tool_patch_text INPUT prints the apply_patch body from whichever field the
# host put it in.
tool_patch_text() {
  printf '%s' "$1" | jq -r '
    .tool_input.command // .tool_input.patch // .tool_input.input //
    .tool_input.diff // .tool_input.content // empty |
    if type == "string" then . else tojson end
  '
}

# tool_write_path INPUT TOOL prints the file a Write, Edit, MultiEdit or
# NotebookEdit call targets.
tool_write_path() {
  case "$2" in
    Write|Edit|MultiEdit)
      json_value "$JV_PATH" "$1" ;;
    NotebookEdit)
      json_value '.tool_input.notebook_path // .tool_input.file_path // empty' "$1" ;;
  esac
}

# tool_proposed_text INPUT TOOL prints the text the call would write; for
# apply_patch, only the lines it adds.
tool_proposed_text() {
  case "$2" in
    Write) json_value "$JV_CONTENT" "$1" ;;
    Edit) json_value "$JV_NEW_STRING" "$1" ;;
    MultiEdit)
      printf '%s' "$1" | jq -r '[.tool_input.edits[]?.new_string // empty] | join("\n")' ;;
    NotebookEdit) json_value '.tool_input.new_source // empty' "$1" ;;
    apply_patch)
      tool_patch=$(tool_patch_text "$1")
      printf '%s\n' "$tool_patch" | extract_patch_added_lines
      ;;
  esac
}

check_pii_hook_input() {
  input=$1
  tool=$2
  pii_hook_mode
  pii_skip_set
  [ "$PII_HOOK_MODE" = off ] && return 0
  need_cmd jq

  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit)
      content=$(tool_proposed_text "$input" "$tool")
      block_on_pii_text "proposed $tool content" "$content"
      ;;
    apply_patch)
      content=$(tool_proposed_text "$input" "$tool")
      block_on_pii_text "proposed apply_patch added lines" "$content"
      ;;
    Bash)
      content=$(json_value "$JV_COMMAND" "$input")
      block_on_pii_text "Bash command" "$content"
      ;;
    WebFetch|WebSearch|Agent|Task|mcp__*)
      case "$tool" in
        Agent|Task) pii_input_label='subagent delegation input' ;;
        mcp__*) pii_input_label='MCP tool input' ;;
        *) pii_input_label="$tool input" ;;
      esac
      content=$(printf '%s' "$input" | jq -r '.tool_input // {} | .. | strings')
      block_on_pii_text "$pii_input_label" "$content"
      ;;
  esac
}

run_gitleaks_stdin() {
  [ "$HOOK_SCANNER_UNAVAILABLE" = 0 ] || return "$SCAN_STATUS_UNAVAILABLE"
  need_gitleaks
  gitleaks_scan "$1" stdin
}

# Run the prepared gitleaks $1 with the remaining arguments. When
# AGENT_GUARD_GITLEAKS_HELPER names an absolute executable scan client, the
# client runs in its place: it answers from the warm helper only when that
# helper runs the probed gitleaks version and these exact config bytes, and
# otherwise execs $1 with the same arguments and input, so a helper failure is
# never a clean scan. An explicit AGENT_GUARD_GITLEAKS_BIN keeps its scanner,
# and AGENT_GUARD_LOG_MODE=off never uses it: without the private state
# directory there is no socket directory, and with one kept only for
# AGENT_GUARD_SCAN_CACHE=on the helper stays off until log-off mode decides
# otherwise (#537, #520). Off, this is one case with no process (#407). A caller
# that runs gitleaks as the last command of a subshell tests
# gitleaks_helper_selected outside it and keeps the plain command otherwise,
# so the shell still execs gitleaks without another fork.
gitleaks_helper_selected() {
  case "${AGENT_GUARD_GITLEAKS_HELPER:-}" in /*) ;; *) return 1 ;; esac
  [ -z "${AGENT_GUARD_GITLEAKS_BIN:-}" ] && [ -n "$AG_STATE_DIR" ] \
    && [ "${AGENT_GUARD_LOG_MODE:-on}" != off ] \
    && [ -n "${GITLEAKS_PROBE_VERSION:-}" ] \
    && [ -f "$AGENT_GUARD_GITLEAKS_HELPER" ] && [ -x "$AGENT_GUARD_GITLEAKS_HELPER" ]
}

gitleaks_exec() {
  if gitleaks_helper_selected; then
    ag_gx_bin=$1
    shift
    "$AGENT_GUARD_GITLEAKS_HELPER" --gitleaks "$ag_gx_bin" \
      --gitleaks-version "$GITLEAKS_PROBE_VERSION" --state-dir "$AG_STATE_DIR" -- "$@"
    return
  fi
  "$@"
}

# $1 labels the scanned input in messages; the rest is the gitleaks
# subcommand and its operands. Returns 0 clean, 1 finding, 2 scanner error.
gitleaks_scan() {
  label=$1
  shift
  ag_gs_ifs=$IFS
  IFS=' '
  set -- "$@" $GITLEAKS_SCAN_FLAGS --config "$GITLEAKS_CONFIG" --exit-code 1
  IFS=$ag_gs_ifs
  out=$(mktemp_file) || die "failed to create temp file"
  gitleaks_exec "$GITLEAKS_BIN" "$@" >"$out" 2>&1
  status=$?
  if [ "$status" -eq 0 ]; then
    if [ -s "$out" ]; then
      info "$PROGRAM: gitleaks reported an error while scanning $label"
      sed 's/^/  /' "$out" >&2
      rm -f "$out"
      return 2
    fi
    rm -f "$out"
    return 0
  fi
  if [ "$status" -eq 1 ]; then
    info "$PROGRAM: secret-like value detected in $label"
    sed 's/^/  /' "$out" >&2
    rm -f "$out"
    return 1
  fi
  info "$PROGRAM: gitleaks failed while scanning $label"
  sed 's/^/  /' "$out" >&2
  rm -f "$out"
  return 2
}

# Filter records encoded as one lockfile-kind byte, a tab, then the original
# line. Keeping the checksum grammar in one place prevents staged diffs, host
# writes, untracked files, and path scans from drifting apart. Replace only the
# checksum field so any other same-line content is still scanned.
filter_lockfile_records() {
  forced_kind=${1:-}
  record_source=${2:--}
  LC_ALL=C awk -v forced_kind="$forced_kind" '
    function replace_match(line, replacement) {
      return substr(line, 1, RSTART - 1) replacement substr(line, RSTART + RLENGTH)
    }
    function hex_digit_value(ch, position) {
      if (length(ch) != 1) return -1
      position = index("0123456789abcdef", tolower(ch))
      return position ? position - 1 : -1
    }
    function unicode_escape_valid(line, at, width, i, digit, value) {
      value = 0
      for (i = 1; i <= width; i++) {
        digit = hex_digit_value(substr(line, at + 1 + i, 1))
        if (digit < 0) return 0
        value = value * 16 + digit
      }
      return value <= 1114111 && !(value >= 55296 && value <= 57343)
    }
    function basic_escape_valid(line, at, multiline, escaped_char, remainder) {
      escaped_char = substr(line, at + 1, 1)
      if (escaped_char == "\"" || escaped_char == "\\" \
          || escaped_char == "b" || escaped_char == "t" \
          || escaped_char == "n" || escaped_char == "f" \
          || escaped_char == "r")
        return 1
      if (escaped_char == "u") return unicode_escape_valid(line, at, 4)
      if (escaped_char == "U") return unicode_escape_valid(line, at, 8)
      # A multiline basic string may fold a physical line ending after a
      # backslash and optional spaces/tabs. awk has already removed the LF
      # record separator, but a CRLF record still has its terminal CR.
      if (multiline) {
        remainder = substr(line, at + 1)
        if (remainder ~ /^[ \t]*\r?$/) return 1
      }
      return 0
    }
    function toml_incomplete(kind) {
      return (kind == "c" || kind == "u") \
          && (toml_multiline != "" || toml_array_depth != 0 || toml_invalid)
    }
    function structured_delimiter(line, at, kind, n, ch) {
      n = length(line)
      # Yarn integrity and Cargo checksum are whole scalar fields. Accept only
      # end-of-record whitespace or a comment; malformed trailing data must
      # remain raw and scannable. package-lock and uv use inline containers.
      if (kind == "y" || kind == "c")
        return substr(line, at) ~ /^[[:space:]]*(#.*)?$/
      while (at <= n && substr(line, at, 1) ~ /[[:space:]]/) at++
      return at > n || substr(line, at, 1) == "," || substr(line, at, 1) == "}"
    }
    function field_replacement(line, at, kind, probe) {
      # All supported checksum fields are shorter than this bounded lookahead.
      # Excessive inter-token whitespace is left untouched and scanned
      # conservatively instead of making candidate search depend on line size.
      probe = substr(line, at, 256)
      replacement_length = 0
      replacement_text = ""
      if (kind == "p") {
        if (match(probe, "^\"integrity\"[[:space:]]*:[[:space:]]*\"" sri "\"")) {
          replacement_length = RLENGTH
          replacement_text = "\"integrity\": \"CHECKSUM\""
        }
      } else if (kind == "y") {
        if (match(probe, "^integrity[[:space:]]+" sri)) {
          replacement_length = RLENGTH
          replacement_text = "integrity CHECKSUM"
        } else if (match(probe, "^checksum:[[:space:]]*[0-9a-f]{64}")) {
          replacement_length = RLENGTH
          replacement_text = "checksum: CHECKSUM"
        }
      } else if (kind == "c") {
        if (match(probe, "^checksum[[:space:]]*=[[:space:]]*\"[0-9a-f]{64}\"")) {
          replacement_length = RLENGTH
          replacement_text = "checksum = \"CHECKSUM\""
        }
      } else if (kind == "u") {
        if (match(probe, "^hash[[:space:]]*=[[:space:]]*\"sha256:[0-9a-f]{64}\"")) {
          replacement_length = RLENGTH
          replacement_text = "hash = \"sha256:CHECKSUM\""
        }
      }
      if (replacement_length \
          && !structured_delimiter(line, at + replacement_length, kind)) {
        replacement_length = 0
        replacement_text = ""
      }
      return replacement_length
    }
    function emit_structural_fields(line, kind,
                                    encoded, char_count, i, ch, quote, escaped,
                                    field_allowed, ml_escaped, triple, chunk,
                                    header, brace_depth, uv_artifact_line, probe,
                                    json_open_role,
                                    chars, replacements, skips, uv_url_seen) {
      char_count = length(line)
      if (toml_skip_rest || json_skip_rest \
          || char_count > max_structured_line_chars \
          || index(line, char_separator)) {
        # Oversized/invalid records stay fully scannable. Their parser state is
        # intentionally not guessed; after one such TOML/JSON record,
        # conservatively skip neutralization for the rest of that file.
        if (kind == "c" || kind == "u") {
          toml_skip_rest = 1
          toml_invalid = 1
        }
        if (kind == "p") json_skip_rest = 1
        print line
        return
      }
      if (kind == "c" && toml_multiline == "") {
        header = line
        sub(/^[[:space:]]*/, "", header)
        if (substr(header, 1, 1) == "[") {
          if (header ~ /^\[\[[[:space:]]*package[[:space:]]*\]\][[:space:]]*(#.*)?$/ \
              || header ~ /^\[[[:space:]]*root[[:space:]]*\][[:space:]]*(#.*)?$/ \
              || header ~ /^\[\[[[:space:]]*patch[[:space:]]*\.[[:space:]]*unused[[:space:]]*\]\][[:space:]]*(#.*)?$/)
            cargo_checksum_scope = 1
          else
            cargo_checksum_scope = 0
        }
      }
      if (kind == "u" && toml_multiline == "") {
        header = line
        sub(/^[[:space:]]*/, "", header)
        if (substr(header, 1, 1) == "[") {
          uv_wheels_scope = 0
          if (header ~ /^\[\[[[:space:]]*(package|distribution)[[:space:]]*\]\][[:space:]]*(#.*)?$/)
            uv_package_scope = 1
          else
            uv_package_scope = 0
        }
        if (uv_package_scope \
            && header ~ /^wheels[[:space:]]*=[[:space:]]*\[[[:space:]]*(#.*)?$/)
          uv_wheels_scope = 1
        else if (header ~ /^\][[:space:]]*(#.*)?$/)
          uv_wheels_scope = 0
      }
      json_open_role = ""
      if (kind == "p") {
        if (json_depth == 1 \
            && line ~ /^[[:space:]]*"packages"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "package_map"
        else if (json_depth == 1 \
            && line ~ /^[[:space:]]*"dependencies"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "dependency_map"
        else if ((json_role[json_depth] == "package_map" \
                  || json_role[json_depth] == "dependency_map") \
                 && line ~ /^[[:space:]]*"[^"]*"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "entry"
        else if (json_role[json_depth] == "entry" \
                 && line ~ /^[[:space:]]*"dependencies"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "dependency_map"
      }
      uv_artifact_line = 0
      if (kind == "u" && toml_multiline == "" && uv_package_scope \
          && (line ~ /^[[:space:]]*sdist[[:space:]]*=[[:space:]]*\{/ \
              || line ~ /^[[:space:]]*wheels[[:space:]]*=[[:space:]]*\[[[:space:]]*\{/ \
              || (uv_wheels_scope \
                  && line ~ /^[[:space:]]*\{/)))
        uv_artifact_line = 1
      encoded = line
      gsub(/./, "&" char_separator, encoded)
      split(encoded, chars, char_separator)
      quote = ""
      escaped = 0
      field_allowed = 1
      ml_escaped = 0
      brace_depth = 0
      i = 1
      while (i <= char_count) {
        ch = chars[i]

        # TOML multiline basic/literal strings span physical records. Preserve
        # their content verbatim until an unescaped matching triple delimiter.
        if ((kind == "c" || kind == "u") && toml_multiline != "") {
          field_allowed = 0
          triple = chars[i] chars[i + 1] chars[i + 2]
          if (toml_multiline == "\"") {
            if (ch == "\\") {
              if (!ml_escaped && !basic_escape_valid(line, i, 1))
                toml_invalid = 1
              ml_escaped = !ml_escaped
              i++
              continue
            }
            if (triple == triple_double && !ml_escaped) {
              i += 3
              toml_multiline = ""
              ml_escaped = 0
              continue
            }
            ml_escaped = 0
          } else if (triple == triple_single) {
            i += 3
            toml_multiline = ""
            continue
          }
          i++
          continue
        }

        if (quote != "") {
          if (quote == "\"" && ch == "\\") {
            if (!escaped && (kind == "c" || kind == "u") \
                && !basic_escape_valid(line, i, 0))
              toml_invalid = 1
            escaped = !escaped
            i++
            continue
          }
          if (ch == quote && !escaped) quote = ""
          escaped = 0
          i++
          continue
        }

        # JSON has no comments or single-quoted strings. TOML/Yarn comments
        # consume the remainder of a record and must stay fully scannable.
        if (kind != "p" && ch == "#") {
          break
        }

        if (kind == "u" && uv_artifact_line && brace_depth == 1 \
            && field_allowed && ch == "u") {
          probe = substr(line, i, 256)
          if (probe ~ /^url[[:space:]]*=[[:space:]]*"/)
            uv_url_seen[brace_depth] = 1
        }

        if (field_allowed \
            && ((kind == "p" && ch == "\"") \
                || (kind == "y" && (ch == "i" || ch == "c")) \
                || (kind == "c" && ch == "c") \
                || (kind == "u" && ch == "h")) \
            && (kind != "p" || json_role[json_depth] == "entry") \
            && (kind != "c" || cargo_checksum_scope) \
            && (kind != "u" \
                || (uv_artifact_line && brace_depth == 1 \
                    && uv_url_seen[brace_depth])) \
            && field_replacement(line, i, kind)) {
          replacements[i] = replacement_text
          skips[i] = replacement_length
          i += replacement_length
          field_allowed = 0
          continue
        }

        if ((kind == "c" || kind == "u") \
            && chars[i] chars[i + 1] chars[i + 2] == triple_double) {
          i += 3
          toml_multiline = "\""
          field_allowed = 0
          continue
        }
        if ((kind == "c" || kind == "u") \
            && chars[i] chars[i + 1] chars[i + 2] == triple_single) {
          i += 3
          toml_multiline = single_quote
          field_allowed = 0
          continue
        }
        if (ch == "\"" || (kind != "p" && ch == single_quote)) {
          quote = ch
          escaped = 0
          field_allowed = 0
          i++
          continue
        }

        if (kind == "c" || kind == "u") {
          if (ch == "[")
            toml_array_depth++
          else if (ch == "]") {
            if (toml_array_depth > 0)
              toml_array_depth--
            else
              toml_invalid = 1
          }
        }
        if (ch == "{") {
          if (kind == "p") {
            if (json_depth >= max_json_depth) {
              json_skip_rest = 1
              print line
              return
            }
            json_depth++
            if (json_open_role != "") {
              json_role[json_depth] = json_open_role
              json_open_role = ""
            } else {
              json_role[json_depth] = "other"
            }
          }
          brace_depth++
          uv_url_seen[brace_depth] = 0
          if (kind != "c") field_allowed = 1
        } else if (ch == "}") {
          if ((kind == "c" || kind == "u") && brace_depth == 0)
            toml_invalid = 1
          if (kind == "p") {
            delete json_role[json_depth]
            if (json_depth > 0) json_depth--
          }
          delete uv_url_seen[brace_depth]
          if (brace_depth > 0) brace_depth--
          field_allowed = 0
        # Cargo.lock checksums are line-leading fields in dependency tables,
        # never arbitrary inline-table keys. Other supported formats do use
        # checksum fields after record delimiters.
        } else if (kind != "c" && ch == ",")
          field_allowed = 1
        else if (ch !~ /[[:space:]]/)
          field_allowed = 0
        i++
      }

      # Ordinary TOML strings and inline tables cannot cross a physical
      # record. Preserve the whole raw snapshot if either remains open.
      if ((kind == "c" || kind == "u") \
          && (quote != "" || brace_depth != 0))
        toml_invalid = 1

      # Emit in bounded chunks. Repeatedly appending an unbounded record is
      # quadratic in some POSIX awks, even when parsing itself is single-pass.
      chunk = ""
      i = 1
      while (i <= char_count) {
        if (i in replacements) {
          chunk = chunk replacements[i]
          i += skips[i]
        } else {
          chunk = chunk chars[i]
          i++
        }
        if (length(chunk) >= 4096) {
          printf "%s", chunk
          chunk = ""
        }
      }
      print chunk
    }
    BEGIN {
      sri = "(sha1-[A-Za-z0-9+\\/]{27}=|sha256-[A-Za-z0-9+\\/]{43}=|sha384-[A-Za-z0-9+\\/]{64}|sha512-[A-Za-z0-9+\\/]{86}==)"
      single_quote = "'\''"
      triple_single = single_quote single_quote single_quote
      triple_double = "\"\"\""
      char_separator = sprintf("%c", 28)
      max_structured_line_chars = 131072
      max_json_depth = 256
      previous_kind = ""
      toml_multiline = ""
      toml_array_depth = 0
      toml_invalid = 0
      toml_skip_rest = 0
    }
    {
      if (forced_kind != "") {
        kind = forced_kind
        line = $0
      } else {
        kind = substr($0, 1, 1)
        line = substr($0, 3)
      }
      # Uppercase structured kinds are context-free physical-record fragments.
      # Their surrounding parser state is unavailable, so leave them fully
      # scannable instead of guessing that a checksum-looking field is
      # structural. Full-file records use the lowercase kinds below.
      if (kind ~ /^[CUP]$/) {
        print line
        next
      }
      if (kind != previous_kind) {
        # A structured TOML stream must not silently discard incomplete parser
        # state when the record kind changes. Returning nonzero makes the
        # caller scan the immutable raw snapshot instead.
        if (toml_incomplete(previous_kind))
          exit 2
        toml_multiline = ""
        toml_array_depth = 0
        toml_invalid = 0
        toml_skip_rest = 0
        json_skip_rest = 0
        json_depth = 0
        cargo_checksum_scope = 0
        uv_package_scope = 0
        uv_wheels_scope = 0
        previous_kind = kind
      }
      # Non-lockfile records have no structural checksum fields. Preserve the
      # preceding state-transition check, then skip the per-character parser.
      if (kind == "-") {
        print line
        next
      }
      if (kind == "g") {
        # Only the third go.sum field is a checksum. A module path may itself
        # contain an h1-shaped secret and must remain visible to gitleaks.
        if (match(line, /^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/)) {
          go_prefix = substr(line, 1, RLENGTH)
          go_tail = substr(line, RLENGTH + 1)
          if (go_tail ~ /^h1:[A-Za-z0-9+\/]{43}=[[:space:]]*$/ \
              && match(go_tail, /^h1:[A-Za-z0-9+\/]{43}=/))
            line = go_prefix replace_match(go_tail, "h1:CHECKSUM")
        }
      } else {
        emit_structural_fields(line, kind)
        next
      }
      print line
    }
    END {
      # Never emit checksum-neutralized output for incomplete TOML. The caller
      # treats this parser failure as a signal to scan the full raw snapshot.
      if (toml_incomplete(previous_kind))
        exit 2
    }
  ' "$record_source"
}

# Gitleaks' bundled defaults skip common lockfiles by path. Agent Guard rescans
# them through stdin after replacing only exact checksum fields; this both fixes
# checksum false positives and keeps credentials elsewhere detectable.
#
# One row per supported lockfile: basename, kind byte for a whole file, kind
# byte for a diff fragment. A fragment kind is uppercase when the format needs
# whole-file context that a hunk lacks (see filter_lockfile_records). The
# path allowlist in config/gitleaks.toml must name the same files.
LOCKFILE_TABLE='go.sum g g
package-lock.json p P
yarn.lock y y
Cargo.lock c C
uv.lock u U'

# Derives, once per process, the space-separated LOCKFILE_NAMES and the awk
# lockfile_kind() that both diff extractors prepend.
lockfile_table_load() {
  ag_ltl_ifs=$IFS
  IFS=' ''
'
  set -- $LOCKFILE_TABLE
  IFS=$ag_ltl_ifs
  LOCKFILE_NAMES=
  AWK_LOCKFILE_KIND='
    function lockfile_kind(path, parts, count, name) {
      count = split(path, parts, "/")
      name = parts[count]'
  while [ "$#" -ge 3 ]; do
    LOCKFILE_NAMES="$LOCKFILE_NAMES $1"
    AWK_LOCKFILE_KIND="$AWK_LOCKFILE_KIND
      if (name == \"$1\") return \"$3\""
    shift 3
  done
  AWK_LOCKFILE_KIND="$AWK_LOCKFILE_KIND
      return \"-\"
    }"
}
lockfile_table_load

# Sets kind to the whole-file kind byte for basename $1, or fails.
lockfile_whole_kind() {
  ag_lwk_name=$1
  ag_lwk_ifs=$IFS
  IFS=' ''
'
  set -- $LOCKFILE_TABLE
  IFS=$ag_lwk_ifs
  while [ "$#" -ge 3 ]; do
    [ "$1" = "$ag_lwk_name" ] && { kind=$2; return 0; }
    shift 3
  done
  return 1
}

filter_lockfile_hashes() {
  path=$1
  original_source=${2:-$path}
  snapshot=
  lockfile_whole_kind "${path##*/}" || { cat -- "$original_source"; return; }

  # Filter one immutable snapshot for every supported lockfile. Besides closing
  # path-swap races, this lets us reject NUL-bearing input before POSIX awk sees
  # it: BSD awk truncates a record at NUL and could otherwise discard a
  # credential suffix. NUL-bearing files stay byte-for-byte scannable.
  snapshot=$(mktemp_file) || { cat -- "$original_source"; return; }
  if ! cat -- "$original_source" >"$snapshot"; then
    rm -f "$snapshot"
    case "$original_source" in
      -|/dev/stdin) return 2 ;;
      *) cat -- "$original_source"; return ;;
    esac
  fi
  source=$snapshot
  nul_probe=$(mktemp_file) || nul_probe=
  if [ -z "$nul_probe" ] \
      || ! LC_ALL=C tr -d '\000' <"$source" >"$nul_probe" \
      || ! cmp -s "$source" "$nul_probe"; then
    cat -- "$source"
    status=$?
    rm -f "$snapshot" "$nul_probe"
    return "$status"
  fi
  rm -f "$nul_probe"

  if [ "$kind" = p ]; then
    # The streaming field parser cannot know that later input is truncated.
    # Validate the complete document first, keeping only a count/type summary
    # so large lockfiles do not need to be slurped into memory. If jq is absent,
    # the JSON is malformed, or multiple documents are present, preserve every
    # byte for gitleaks instead of risking an early integrity replacement.
    if ! command -v jq >/dev/null 2>&1 \
        || ! jq -e -n --stream '
          reduce inputs as $event (
            {documents: 0, in_object: false, valid: true};
            ($event[0] // []) as $path
            | if (.valid | not) then
                .
              elif .in_object then
                if (($event | length) == 1 and ($path | length) == 1) then
                  .in_object = false
                else
                  .
                end
              elif ($path | length) == 0 then
                if (($event | length) == 2 and $event[1] == {}) then
                  .documents += 1
                else
                  .valid = false
                end
              elif (($path[0] | type) == "string") then
                .documents += 1
                | .in_object = true
                | if (($event | length) == 1 and ($path | length) == 1) then
                    .in_object = false
                  else
                    .
                  end
              else
                .valid = false
              end
          )
          | .valid and (.documents == 1) and (.in_object | not)
        ' "$source" >/dev/null 2>&1; then
      cat -- "$source"
      status=$?
      rm -f "$snapshot"
      return "$status"
    fi
  fi
  filtered=$(mktemp_file) || {
    cat -- "$source"
    status=$?
    rm -f "$snapshot"
    return "$status"
  }
  if filter_lockfile_records "$kind" "$source" >"$filtered"; then
    cat -- "$filtered"
    status=$?
  else
    # Parser failure must never turn a lockfile into empty clean input. The
    # immutable snapshot is the authoritative byte stream for raw fallback.
    cat -- "$source"
    status=$?
  fi
  rm -f "$filtered"
  rm -f "$snapshot"
  return "$status"
}

scan_lockfiles_under() {
  root=$1
  label=$2
  blob=$(mktemp_file) || die "failed to create temp file"
  list=$(mktemp_file) || { rm -f "$blob"; die "failed to create temp file"; }
  set --
  for ag_slu_name in $LOCKFILE_NAMES; do
    set -- "$@" -o -name "$ag_slu_name"
  done
  shift
  find "$root" -type f \( "$@" \) -print0 >"$list"
  find_status=$?
  if [ "$find_status" -ne 0 ]; then
    rm -f "$blob" "$list"
    info "$PROGRAM: failed to prepare lockfiles in $label"
    return 2
  fi
  if [ ! -s "$list" ]; then
    rm -f "$blob" "$list"
    return 0
  fi
  xargs -0 -I '{}' "$SELF_BIN" filter-lockfile-hashes '{}' '{}' \
    >>"$blob" <"$list"
  prepare_status=$?
  rm -f "$list"
  if [ "$prepare_status" -ne 0 ]; then
    rm -f "$blob"
    info "$PROGRAM: failed to prepare lockfiles in $label"
    return 2
  fi
  if [ ! -s "$blob" ]; then
    rm -f "$blob"
    return 0
  fi
  run_gitleaks_stdin "$label lockfile content" <"$blob"
  status=$?
  rm -f "$blob"
  return "$status"
}

scan_text_direct() {
  label=$1
  text=$2
  [ -n "$text" ] || return 0
  printf '%s\n' "$text" | run_gitleaks_stdin "$label"
}

# The PreToolUse Bash command text is the one scan that repeats byte for byte
# (`ls -la`, `git status`, hundreds of times an hour), so only it consults the
# clean-verdict cache; every other caller of scan_text_direct scans directly.
# The cache is consulted only after an earlier prepare_gitleaks in this process
# left a ready native executable; otherwise the scan below resolves, probes and
# reports exactly as scan_text_direct does.
scan_shell_command_text() {
  [ -n "$1" ] || return 0
  [ "$HOOK_SCANNER_UNAVAILABLE" = 0 ] || return "$SCAN_STATUS_UNAVAILABLE"
  if gitleaks_clean_cache_key "$1"; then
    gitleaks_clean_cache_hit && return 0
  fi
  printf '%s\n' "$1" | run_gitleaks_stdin "shell command"
  ag_glc_status=$?
  [ "$ag_glc_status" -ne 0 ] || gitleaks_clean_cache_store
  return "$ag_glc_status"
}

# Remove only recognized lockfile checksum fields before scanning proposed file
# content. The logical path controls the exception; the temporary filename does
# not, so the same checksum-shaped text in any other file remains detectable.
scan_file_text_direct() {
  label=$1
  path=$2
  text=$3
  [ -n "$text" ] || return 0
  [ -n "$path" ] || { scan_text_direct "$label" "$text"; return $?; }

  source=$(mktemp_file) || die "failed to create temp file"
  printf '%s\n' "$text" >"$source"
  filter_lockfile_hashes "$path" "$source" | run_gitleaks_stdin "$label"
  status=$?
  rm -f "$source"
  return "$status"
}

# Edit/MultiEdit payloads contain only replacement fragments, not complete file
# context. Structural checksum filtering is unsafe there because an unchanged
# surrounding quote, multiline string, or earlier go.sum field is absent.
scan_file_fragment_direct() {
  label=$1
  text=$3
  scan_text_direct "$label" "$text"
}

# Scan status protocol, shared by every scan_* function and by
# block_on_scan_status:
#   0 clean, 1 a secret was found, 3 the scan could not run, other scanner error.
# 3 exists because "I found a secret in your staged changes" and "I never got to
# look" are different facts and an operator has to be able to act on the right
# one. Hook callers apply AGENT_GUARD_INFRA_FAILURE_MODE to infrastructure
# failures; direct scan commands preserve the status for their caller.
SCAN_STATUS_UNAVAILABLE=3
# The git gate's own status for a commit or push whose directory does not
# exist or is no repository when the hook runs.
GIT_SCAN_STATUS_NO_REPOSITORY=4
SCAN_INPUT_MAX_BYTES=10485760
# Operators raise the budget when one legitimate file (a regenerated lockfile)
# exceeds it; a larger budget scans more, never less, so it cannot bypass the
# fail-closed contract. It is raise-only: a value below the default would
# shrink the budget until every diff is "unavailable", which under the open
# policy lets unscanned input through. Non-numeric, smaller, or overlong
# (beyond 18 digits, where dash arithmetic aborts) values keep the default.
case ${AGENT_GUARD_SCAN_INPUT_MAX_BYTES:-} in
  ''|*[!0-9]*) ;;
  *)
    # Strip leading zeros before arithmetic so `007` is not read as octal.
    scan_limit_override=${AGENT_GUARD_SCAN_INPUT_MAX_BYTES#"${AGENT_GUARD_SCAN_INPUT_MAX_BYTES%%[!0]*}"}
    case "$scan_limit_override" in
      ???????????????????*) ;;
      ?*) [ "$scan_limit_override" -ge "$SCAN_INPUT_MAX_BYTES" ] \
            && SCAN_INPUT_MAX_BYTES=$scan_limit_override ;;
    esac
    ;;
esac
# scan-working-tree has at most three producers: worktree diff, index diff, and
# untracked content. Giving each one third keeps their aggregate under the budget.
SCAN_COMPONENT_MAX_BYTES=$((SCAN_INPUT_MAX_BYTES / 3))

block_on_scan_status() {
  status=$1
  message=$2
  case "$status" in
    0) return 0 ;;
    1) info "$PROGRAM: $message"; exit 2 ;;
    "$SCAN_STATUS_UNAVAILABLE")
      # hook_pre_tool reports a missing scanner once, after every other check.
      [ "$HOOK_SCANNER_UNAVAILABLE" = 0 ] || return 0
      handle_hook_infrastructure_failure "${HOOK_EVENT:-PreToolUse}" "${HOOK_INPUT:-}" \
        "$PROGRAM: scanner infrastructure could not verify the command;"
      ;;
    *)
      handle_hook_infrastructure_failure "${HOOK_EVENT:-PreToolUse}" "${HOOK_INPUT:-}" \
        "$PROGRAM: scanner infrastructure failed before it could verify the command;"
      ;;
  esac
}

# Extract only added diff lines, dropping exact checksum fields only when the
# diff header identifies one of the supported lockfiles.
extract_added_lines() {
  LC_ALL=C awk "$AWK_LOCKFILE_KIND"'
    /^diff --git / { in_hunk = 0; path = ""; next }
    !in_hunk && /^\+\+\+ b\// { path = substr($0, 7); next }
    /^@@/ { in_hunk = 1; next }
    in_hunk && /^\+/ { print lockfile_kind(path) "\t" substr($0, 2) }
  ' | filter_lockfile_records
}
# Extract lines introduced by Codex apply_patch envelopes or unified diffs.
extract_patch_added_lines() {
  LC_ALL=C awk "$AWK_LOCKFILE_KIND"'
    BEGIN { mode = "none"; in_hunk = 0 }
    /^\*\*\* Begin Patch/ { mode = "none"; in_hunk = 0; next }
    /^\*\*\* End Patch/ { mode = "none"; in_hunk = 0; next }
    /^\*\*\* Add File:/ { path = $0; sub(/^\*\*\* Add File:[ \t]*/, "", path); mode = "add"; next }
    /^\*\*\* Update File:/ { path = $0; sub(/^\*\*\* Update File:[ \t]*/, "", path); mode = "update"; next }
    /^\*\*\* Delete File:/ { mode = "none"; path = ""; in_hunk = 0; next }
    /^\*\*\* End of File/ { next }
    /^diff --git / { if (mode == "none") in_hunk = 0; next }
    /^@@/ { if (mode == "none") in_hunk = 1; next }
    {
      if (mode == "add") {
        line = $0
        sub(/^\+/, "", line)
        print lockfile_kind(path) "\t" line
        next
      }
      if (mode == "update") {
        if (substr($0, 1, 1) == "+")
          print lockfile_kind(path) "\t" substr($0, 2)
        next
      }
      # Fallback: treat as a unified diff hunk. Tell a `+++ b/path` file header
      # (before the first @@, in_hunk=0) from added CONTENT by position, not by
      # shape — matching `+++ ` by shape dropped any added line whose own content
      # began with `++ `, which git prefixes to `+++ SECRET`. Only `+` lines
      # inside a hunk are additions.
      if (!in_hunk && /^\+\+\+ b\//) { path = substr($0, 7); next }
      if (!in_hunk && /^\+\+\+ /) next
      if (in_hunk && /^\+/) {
        line = $0
        sub(/^\+/, "", line)
        print lockfile_kind(path) "\t" line
      }
    }
  ' | filter_lockfile_records
}
# A hook asks this twice for the same directory (the caller's guard, then
# require_git_repo), so a yes is remembered for the exact $PWD of this shell
# and its subshells (#407). A no is never remembered, and any other directory
# asks git again.
AG_INSIDE_GIT_PWD=
inside_git_repo() {
  [ -n "${AG_INSIDE_GIT_PWD:-}" ] && [ "$AG_INSIDE_GIT_PWD" = "$PWD" ] && return 0
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  AG_INSIDE_GIT_PWD=$PWD
}

# Name the directory and the action, not the internal subcommand: the operator
# never typed `scan-staged`, so telling them it "must run inside a git work
# tree" describes agent-guard's plumbing instead of their problem.
require_git_repo() {
  inside_git_repo && return 0
  info "$PROGRAM: could not scan: $(pwd) is not a git repository; run the command from inside the repository"
  return "$SCAN_STATUS_UNAVAILABLE"
}

# Set scan_byte_count to the size of file $1 in bytes, for the two bounded
# scan producers. BSD wc pads the count with blanks; they are trimmed by the
# shell instead of piping through tr (#407). Anything else that is not a plain
# number (wc failed, the file is unreadable) returns 1 so the caller fails closed.
scan_file_bytes() {
  scan_byte_count=$(LC_ALL=C wc -c <"$1" 2>/dev/null)
  while :; do
    case "$scan_byte_count" in
      [[:space:]]*) scan_byte_count=${scan_byte_count#?} ;;
      *) break ;;
    esac
  done
  case "$scan_byte_count" in
    ''|*[!0-9]*) return 1 ;;
  esac
}

extract_git_diff_added() {
  diff_file=$(mktemp_file) || return "$SCAN_STATUS_UNAVAILABLE"
  diff_status_file=$(mktemp_file) || { rm -f "$diff_file"; return "$SCAN_STATUS_UNAVAILABLE"; }
  # Unlike the untracked producer, git's stderr is bounded rather than
  # discarded: `fatal: bad revision` is the one detail an operator needs, so the
  # failure path relays its first line after sanitizing and truncating it. The
  # capture itself is bounded at the source (512 bytes, enough for that line):
  # a git wrapper spewing stderr must neither fill TMPDIR nor stall the hook,
  # and the trailing drain keeps a noisy-but-successful git from seeing SIGPIPE.
  diff_err_file=$(mktemp_file) || { rm -f "$diff_file" "$diff_status_file"; return "$SCAN_STATUS_UNAVAILABLE"; }
  # autoRefreshIndex=false: a work-tree diff otherwise rewrites the index to
  # refresh stale stat data, and a scan must leave the repository as it was.
  #
  # Read at most one byte beyond the shared scan budget. Closing the pipe there
  # stops a large diff from being fully materialized before the host timeout.
  # This bounds scan work and storage; it is not a portable wall-clock timeout
  # for a git process that stalls before producing output.
  (
    exec 3>&1
    { git -c diff.autoRefreshIndex=false diff --text --no-textconv --no-color "$@" 2>&1 >&3; printf '%s\n' "$?" >"$diff_status_file"; } 2>/dev/null \
      | { head -c 512 >"$diff_err_file"; cat >/dev/null; }
  ) | head -c $((SCAN_COMPONENT_MAX_BYTES + 1)) >"$diff_file"
  pipe_status=$?
  # The first line, read by the shell instead of a sed process (#407).
  diff_status=
  { IFS= read -r diff_status <"$diff_status_file"; } 2>/dev/null || :
  rm -f "$diff_status_file"
  scan_file_bytes "$diff_file" || {
    rm -f "$diff_file" "$diff_err_file"
    return "$SCAN_STATUS_UNAVAILABLE"
  }
  diff_bytes=$scan_byte_count
  # `head` closes the pipe at the sentinel byte, so git may report SIGPIPE (or
  # never reach its status write) for an over-budget diff; the byte count, not
  # that status, is authoritative here. `scan_untracked_files` bounds its own
  # producer the same way.
  if [ "$diff_bytes" -gt "$SCAN_COMPONENT_MAX_BYTES" ]; then
    rm -f "$diff_file" "$diff_err_file"
    info "$PROGRAM: git diff exceeded the scan input limit of $SCAN_COMPONENT_MAX_BYTES bytes; reduce the pending change, split it into smaller commits, or raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  if [ "$pipe_status" -ne 0 ] || [ "$diff_status" != 0 ]; then
    git_line=$(head -c 200 "$diff_err_file" 2>/dev/null | sed -n '1p' | tr -d '[:cntrl:]')
    rm -f "$diff_file" "$diff_err_file"
    info "$PROGRAM: git diff failed; staged or working changes were not scanned"
    [ -z "$git_line" ] || info "$PROGRAM: git: $git_line"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  # A successful empty diff has no added line, and both awk filters print
  # nothing and exit 0 on empty input, so skip their two processes (#407).
  if [ "$diff_bytes" -eq 0 ]; then
    rm -f "$diff_file" "$diff_err_file"
    return 0
  fi
  extract_added_lines <"$diff_file"
  status=$?
  rm -f "$diff_file" "$diff_err_file"
  return "$status"
}

# Preflight shared by the repository-wide scans: a missing git or gitleaks
# exits with the unavailable status, and repo_root is left set for the caller.
git_scan_prepare() {
  need_cmd git "$SCAN_STATUS_UNAVAILABLE"
  [ "$HOOK_SCANNER_UNAVAILABLE" = 0 ] || return "$SCAN_STATUS_UNAVAILABLE"
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  require_git_repo || return $?
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || return "$SCAN_STATUS_UNAVAILABLE"
}

# The added lines of a root-relative `git diff "$@" -- .`. It changes directory
# in the calling shell, so call it only inside a command substitution.
repo_diff_added() {
  CDPATH= cd -- "$repo_root" && extract_git_diff_added "$@" -- .
}

# Fold one scan status into $result: a finding outranks everything, and an
# unavailable or failed scan outranks only a clean one.
merge_scan_status() {
  case "$1" in
    0) ;;
    1) result=1 ;;
    *) [ "$result" -eq 0 ] && result="$SCAN_STATUS_UNAVAILABLE" ;;
  esac
}

# scan-path's documented exits differ: a scanner error is 2 and outranks a
# finding, so the caller sees that part of the tree went unscanned.
merge_scan_path_status() {
  case "$1" in
    0) ;;
    1) [ "$result" -eq 0 ] && result=1 ;;
    *) result=2 ;;
  esac
}

scan_staged() {
  git_scan_prepare || return $?
  added=$(repo_diff_added --cached --unified=0 --no-ext-diff)
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  [ -n "$added" ] || return 0
  scan_text_direct "staged added lines" "$added"
}

# What a `git commit` records: the index, plus tracked work-tree changes that
# Git stages itself after PreToolUse has run — all of them for -a, --patch and
# --interactive ($1 = 1), or those under the pathspecs in $3... (relative to
# the command cwd, as Git reads them). --interactive can also add untracked
# files ($2 = 1), and a same-command `git add -f` even ignored ones ($2 = 2),
# which may exceed the scan budget and then reports unavailable. A diff against
# HEAD is used instead of staging into a scratch index so the scan writes
# neither the index nor the object store.
scan_commit_candidate() {
  stage_all=$1
  stage_untracked=$2
  shift 2
  git_scan_prepare || return $?
  added=$(repo_diff_added --cached --unified=0 --no-ext-diff)
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  if [ "$stage_all" -eq 1 ] || [ "$#" -gt 0 ]; then
    # Without a HEAD, the work tree is diffed against the index; the --cached
    # diff above already holds every index line, so together they cover it.
    stage_base=
    git rev-parse --verify --quiet HEAD >/dev/null 2>&1 && stage_base=HEAD
    if [ "$stage_all" -eq 1 ]; then
      staged_by_git=$(repo_diff_added --unified=0 --no-ext-diff ${stage_base:+"$stage_base"})
    else
      staged_by_git=$(extract_git_diff_added --unified=0 --no-ext-diff ${stage_base:+"$stage_base"} -- "$@")
    fi
    status=$?
    [ "$status" -eq 0 ] || return "$status"
    [ -n "$staged_by_git" ] && added=${added:+"$added
"}$staged_by_git
  fi
  # A finding in either part outranks the other part failing to scan.
  untracked_status=0
  if [ "$stage_untracked" -ne 0 ]; then
    untracked_mode=
    [ "$stage_untracked" -eq 2 ] && untracked_mode=ignored
    (CDPATH= cd -- "$repo_root" && scan_untracked_files ${untracked_mode:+"$untracked_mode"})
    untracked_status=$?
    [ "$untracked_status" -eq 1 ] && return 1
  fi
  if [ -n "$added" ]; then
    scan_text_direct "commit candidate added lines" "$added"
    status=$?
    [ "$status" -eq 0 ] || return "$status"
  fi
  [ "$untracked_status" -eq 0 ] || return "$SCAN_STATUS_UNAVAILABLE"
  return 0
}

# $1 = ignored also lists gitignored files, for a same-command `git add -f`.
scan_untracked_files() {
  untracked_filter=--exclude-standard
  [ "${1:-}" = ignored ] && untracked_filter=
  need_cmd git
  need_gitleaks
  # Resolve the repo ROOT so an untracked secret OUTSIDE the caller's subdir is
  # still listed. --full-name emits root-relative paths regardless of cwd; the
  # cat step below reads them from that same root.
  root=$(git rev-parse --show-toplevel) || die "failed to resolve repository root"
  list=$(mktemp_file) || die "failed to create temp file"
  # core.quotePath=false + -z keep every filename byte-exact (non-ASCII,
  # backslash, quote, even an embedded newline). A newline-delimited read would
  # skip such names and let a secret sit in a file the backstop never scans.
  git -C "$root" -c core.quotePath=false ls-files --others ${untracked_filter:+"$untracked_filter"} --full-name -z >"$list" || {
    rm -f "$list"
    die "failed to list untracked files"
  }

  if [ ! -s "$list" ]; then
    rm -f "$list"
    return 0
  fi

  # Stream every untracked file through one gitleaks stdin call. Exact checksum
  # fields are removed only for supported lockfile basenames; all other content
  # from those files, including credentials, remains in the stream.
  # Producer stderr is untrusted and unbounded; discard it here and emit only
  # the fixed, secret-safe preparation diagnostic below when its status fails.
  blob=$(mktemp_file) || { rm -f "$list"; die "failed to create temp file"; }
  prepare_status_file=$(mktemp_file) || { rm -f "$list" "$blob"; die "failed to create temp file"; }
  (xargs -0 -I '{}' sh -c '
    cd "$0" 2>/dev/null || exit 0
    f=$1
    filter=$2
    [ -f "$f" ] || exit 0
    printf "### file: %s\n" "$f"
    case " $3 " in
      *" ${f##*/} "*) "$filter" filter-lockfile-hashes "$f" "$f" || exit 1 ;;
      *) cat -- "$f" || exit 1 ;;
    esac
    printf "\n" || exit 1
  ' "$root" '{}' "$SELF_BIN" "$LOCKFILE_NAMES" <"$list"; printf '%s\n' "$?" >"$prepare_status_file") \
    2>/dev/null \
    | head -c $((SCAN_COMPONENT_MAX_BYTES + 1)) >"$blob"
  pipe_status=$?
  # The first line, read by the shell instead of a sed process (#407).
  prepare_status=
  { IFS= read -r prepare_status <"$prepare_status_file"; } 2>/dev/null || :
  rm -f "$prepare_status_file"
  rm -f "$list"
  scan_file_bytes "$blob" || { rm -f "$blob"; return "$SCAN_STATUS_UNAVAILABLE"; }
  blob_bytes=$scan_byte_count
  # `head` deliberately closes the pipe after the sentinel byte. The producer
  # may therefore report SIGPIPE (or never reach its status write) for an
  # over-budget stream; the byte count is the authoritative outcome in that
  # case. Preserve real preparation failures while the stream is still within
  # budget, where `head` did not truncate it.
  if [ "$blob_bytes" -gt "$SCAN_COMPONENT_MAX_BYTES" ]; then
    rm -f "$blob"
    info "$PROGRAM: untracked files exceeded the scan input limit of $SCAN_COMPONENT_MAX_BYTES bytes; reduce untracked input, add intentional exclusions to .gitignore, or raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  if [ "$pipe_status" -ne 0 ] || [ "$prepare_status" != 0 ]; then
    rm -f "$blob"
    info "$PROGRAM: failed to prepare untracked files for scanning"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi

  if [ ! -s "$blob" ]; then
    rm -f "$blob"
    return 0
  fi

  run_gitleaks_stdin "untracked files" <"$blob"
  status=$?
  rm -f "$blob"
  return "$status"
}

scan_working_tree() {
  git_scan_prepare || return $?

  # Two diffs, and with a HEAD both are taken AGAINST HEAD (#224). `git diff
  # HEAD` alone compares only the worktree, so a secret staged and then reverted
  # on disk left the scan while the next commit still carried it; `--cached`
  # (index vs HEAD) closes that. Diffing the worktree against the INDEX instead
  # would look symmetric but is not: a committed line whose removal is staged and
  # then undone on disk reads as an addition there, re-reporting history that
  # `git diff HEAD` correctly calls unchanged. Added lines only is the contract,
  # so HEAD stays the base for both.
  result=0
  first=
  second=
  if git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    first=$(repo_diff_added --unified=0 --no-ext-diff HEAD)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
    second=$(repo_diff_added --cached --unified=0 --no-ext-diff)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
  else
    # No HEAD: `--cached` compares against the empty tree and the plain diff
    # carries unstaged edits. Nothing is committed yet, so neither can re-report
    # history and there is no HEAD to diff against.
    first=$(repo_diff_added --cached --unified=0 --no-ext-diff)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
    second=$(repo_diff_added --unified=0 --no-ext-diff)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
  fi
  # Content staged and left alone on disk appears in both. gitleaks reports the
  # same finding either way and agent-guard emits one generic line, so the cost
  # is duplicate scanner input, not duplicate output.
  tracked=$first
  [ -n "$first" ] && [ -n "$second" ] && tracked="$tracked
$second"
  [ -z "$first" ] && tracked=$second

  if [ -n "$tracked" ]; then
    scan_text_direct "working tree added lines" "$tracked"
    status=$?
    merge_scan_status "$status"
  fi

  (CDPATH= cd -- "$repo_root" && scan_untracked_files)
  status=$?
  merge_scan_status "$status"

  return "$result"
}

scan_path() {
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  [ "$#" -gt 0 ] || die "scan-path requires at least one path"
  result=0
  for path in "$@"; do
    [ -e "$path" ] || die "path not found: $path"
    gitleaks_scan "path: $path" dir "$path"
    merge_scan_path_status "$?"
    scan_lockfiles_under "$path" "path: $path"
    merge_scan_path_status "$?"
  done
  return "$result"
}

# A hook reads several fields of its own input: the object check,
# `.tool_input | type`, the tool name, the command, the path... This cache
# (#407) saves one jq process per field, plus the pipeline and command
# substitution around it: json_value_prime reads those fields in one jq run,
# and json_value answers them from shell variables only while it is handed
# that exact input text.
#
# A field is cached only when `jq -r EXPR` provably prints the same bytes: the
# expression yields exactly one string without a NUL byte (printed with a
# newline) or nothing at all. Any other shape -- a number, an object, several
# results, an error, a stream of several JSON documents, or a string longer
# than 64 Ki characters (quoting a large Write body into the shell would cost
# more than the jq run it saves) -- is left uncached and
# json_value runs jq exactly as before, so no value is ever reformatted.
# Expressions json_value_prime does not list always run jq. The cache is keyed
# by expression text, so callers name a primed field with these constants.
JV_INPUT_TYPE='.tool_input | type'
JV_TOOL='.tool_name // .tool // .name // empty'
JV_WORKDIR='.tool_input.workdir // .tool_input.cwd // .cwd // empty'
JV_COMMAND='.tool_input.command // .tool_input.cmd // empty'
JV_PATH='.tool_input.file_path // .tool_input.path // empty'
JV_CONTENT='.tool_input.content // empty'
JV_NEW_STRING='.tool_input.new_string // empty'
JV_CACHE_INPUT=
JV_CACHE_OBJECT=

json_value_prime() {
  JV_CACHE_INPUT=
  JV_CACHE_OBJECT=
  for jv_name in input_type tool workdir command path content new_string; do
    unset "jv_$jv_name" "jv_${jv_name}_set"
  done
  jv_object=
  [ -n "$1" ] || return 0
  # A large input (a big Write body) costs more to parse and compare once more
  # than the few jq runs the cache saves; leave it to the per-field path.
  [ "${2:-}" = measured ] || [ "${#1}" -le 262144 ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  jv_program='
    def cached($name; f):
      (try ([f] | if length == 0 then {none: true}
                  elif length == 1 and (.[0] | type) == "string"
                       and (.[0] | length) <= 65536
                       and ((.[0] | index("\u0000")) == null)
                  then {value: .[0]}
                  else null end)
       catch null) as $v
      | if $v == null then empty
        elif $v.none then "\($name)_set=0"
        else "\($name)_set=1", "\($name)=\($v.value | @sh)" end;
    if length == 1 and (.[0] | type) == "object" then
      .[0]
      | "jv_object=1",
        cached("jv_input_type"; '"$JV_INPUT_TYPE"'),
        cached("jv_tool"; '"$JV_TOOL"'),
        cached("jv_workdir"; '"$JV_WORKDIR"'),
        cached("jv_command"; '"$JV_COMMAND"'),
        cached("jv_path"; '"$JV_PATH"'),
        cached("jv_content"; '"$JV_CONTENT"'),
        cached("jv_new_string"; '"$JV_NEW_STRING"')
    else empty end'
  # Slurp so a stream of several documents is seen as such and left uncached.
  jv_assignments=$(printf '%s' "$1" | jq -rs "$jv_program" 2>/dev/null) || return 0
  # jq's @sh quotes every value; the names are the fixed ones above.
  eval "$jv_assignments"
  [ "$jv_object" = 1 ] || return 0
  JV_CACHE_OBJECT=1
  JV_CACHE_INPUT=$1
}

# Return 0 when $1 is the primed input and that input is exactly one JSON
# object, so `jq -e 'type == "object"'` would succeed on it; otherwise return 1
# and let the caller run jq itself.
json_input_is_primed_object() {
  [ "${JV_CACHE_OBJECT:-}" = 1 ] && [ -n "${JV_CACHE_INPUT:-}" ] \
    && [ "$1" = "$JV_CACHE_INPUT" ]
}

# Set jv_set to 0 (primed as no output) or 1 (primed as jv_val) when field $1
# of input $2 is primed; return 1 otherwise.
json_value_cached() {
  jv_set=
  if [ -n "${JV_CACHE_INPUT:-}" ] && [ "$2" = "$JV_CACHE_INPUT" ]; then
    case "$1" in
      "$JV_INPUT_TYPE") jv_set=${jv_input_type_set:-} jv_val=${jv_input_type:-} ;;
      "$JV_TOOL") jv_set=${jv_tool_set:-} jv_val=${jv_tool:-} ;;
      "$JV_WORKDIR") jv_set=${jv_workdir_set:-} jv_val=${jv_workdir:-} ;;
      "$JV_COMMAND") jv_set=${jv_command_set:-} jv_val=${jv_command:-} ;;
      "$JV_PATH") jv_set=${jv_path_set:-} jv_val=${jv_path:-} ;;
      "$JV_CONTENT") jv_set=${jv_content_set:-} jv_val=${jv_content:-} ;;
      "$JV_NEW_STRING") jv_set=${jv_new_string_set:-} jv_val=${jv_new_string:-} ;;
      *) jv_set= ;;
    esac
  fi
  case "$jv_set" in
    0|1) return 0 ;;
  esac
  return 1
}

# Both readers consult json_value_cached only while a cache is primed. Passing
# the input as an argument copies it in the shell, and an input over the 256 Ki
# character priming limit (a large PostToolUse tool output) is never primed, so
# an unconditional lookup copied that whole input once per field for an answer
# that was always "not cached".
json_value() {
  expr=$1
  input=$2
  if [ -n "${JV_CACHE_INPUT:-}" ] && json_value_cached "$expr" "$input"; then
    [ "$jv_set" = 0 ] || printf '%s\n' "$jv_val"
    return 0
  fi
  printf '%s' "$input" | jq -r "$expr"
}

# Set jv_out to what `jv_out=$(json_value "$1" "$2")` would hold and return the
# same status. Only an unprimed field costs a subshell. That subshell runs jq
# directly: json_value would repeat the lookup that just missed for the same
# arguments and copy the input once more.
json_value_to() {
  if [ -n "${JV_CACHE_INPUT:-}" ] && json_value_cached "$1" "$2"; then
    jv_out=
    [ "$jv_set" = 0 ] && return 0
    jv_out=$jv_val
    while :; do
      case "$jv_out" in
        *'
') jv_out=${jv_out%'
'} ;;
        *) return 0 ;;
      esac
    done
  fi
  jv_out=$(printf '%s' "$2" | jq -r "$1")
}

normalize_path() {
  candidate=$1
  case "$candidate" in
    file://*) candidate=${candidate#file://} ;;
  esac
  case "$candidate" in
    '~') candidate=${HOME:-/} ;;
    '~/'*) candidate=${HOME:-/}/${candidate#"~/"} ;;
  esac
  while :; do
    case "$candidate" in
      './'*) candidate=${candidate#./} ;;
      *) break ;;
    esac
  done
  printf '%s' "$candidate"
}

resolve_path() {
  candidate=$1
  # Resolve symlinks when possible; otherwise keep matching the original path.
  resolved=$(
    if command -v realpath >/dev/null 2>&1; then
      realpath -- "$candidate" 2>/dev/null
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f -- "$candidate" 2>/dev/null
    fi
  )
  if [ -n "$resolved" ]; then
    printf '%s' "$resolved"
  else
    printf '%s' "$candidate"
  fi
}

# Match a candidate without applying any template exception. Keep this in a
# subshell because POSIX sh has no local variables and callers also iterate the
# deny file.
candidate_matches_raw_deny() (
  raw_deny_candidate=$1
  [ -f "$DENY_READ_PATHS" ] || return 1
  while IFS= read -r raw_deny_pattern || [ -n "$raw_deny_pattern" ]; do
    case "$raw_deny_pattern" in
      ''|\#*) continue ;;
    esac
    case "$raw_deny_candidate" in
      $raw_deny_pattern|*/$raw_deny_pattern) return 0 ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
)

# A template basename never exempts a file inside a deny-listed directory. Walk
# every ancestor rather than only the complete parent string: `local.env/sub`
# must be caught by `*.env` before `local.env/sub/sample.env` can be allowed.
candidate_parent_matches_deny() (
  deny_parent_path=$1
  while [ -n "$deny_parent_path" ] && [ "$deny_parent_path" != / ]; do
    candidate_matches_raw_deny "$deny_parent_path" && return 0
    case "$deny_parent_path" in
      */*)
        next_deny_parent=${deny_parent_path%/*}
        [ "$next_deny_parent" = "$deny_parent_path" ] && break
        [ -n "$next_deny_parent" ] || next_deny_parent=/
        deny_parent_path=$next_deny_parent
        ;;
      *) break ;;
    esac
  done
  return 1
)

# Classify explicitly named environment placeholder templates. Accepted suffix
# markers are `example`, `sample`, `template`, `dist`, `tpl`, and `tmpl`,
# separated by `.`, `-`, or `_` (`.env.example`, `.env-example`, `.env_sample`,
# `.env.tpl`); the marker must be final. `.env.default(s)` is deliberately not
# a marker: dotenv-defaults loads it at runtime, so it may hold real values.
# `example.env`, `sample.env`, and `template.env` (plus their envrc forms) are
# also accepted because that prefix convention is common and unambiguous.
#
# The name on the other side of a suffix marker must still be an environment
# file family: env/envrc, *.env/*.envrc, .flaskenv, or .dev.vars. Consequently,
# runtime names such as `.env.local`, `local.env`, `env.local`, and
# `example.env.local` are not templates. This function checks the basename
# grammar only; candidate_matches_deny retains parent, non-environment, and
# custom-policy precedence.
candidate_is_allowed() {
  template_base=${1##*/}
  template_stem=

  case "$template_base" in
    example.env|sample.env|template.env|example.envrc|sample.envrc|template.envrc|\
    .example.env|.sample.env|.template.env|.example.envrc|.sample.envrc|.template.envrc)
      ;;
    *[._-]example) template_stem=${template_base%[._-]example} ;;
    *[._-]sample) template_stem=${template_base%[._-]sample} ;;
    *[._-]template) template_stem=${template_base%[._-]template} ;;
    *[._-]dist) template_stem=${template_base%[._-]dist} ;;
    *[._-]tpl) template_stem=${template_base%[._-]tpl} ;;
    *[._-]tmpl) template_stem=${template_base%[._-]tmpl} ;;
    *) return 1 ;;
  esac

  if [ -n "$template_stem" ]; then
    case "$template_stem" in
      .env|.env.*|env|env.*|.envrc|.envrc.*|envrc|envrc.*|*.env|*.envrc|\
      .flaskenv|.flaskenv.*|.dev.vars|.dev.vars.*) ;;
      *) return 1 ;;
    esac
  fi
  return 0
}

# Keep ordinary source modules such as `config.env.ts` readable without opening
# data/config suffixes such as `config.env.json`. Require a non-empty prefix for
# reverse-extension forms so `.env.ts` remains a protected runtime variant.
#
# The basename must end in a known code extension; the stem in front of it may
# carry at most ONE intermediate segment (`env.d.ts`, `env.server.ts`,
# `app.env.spec.ts`) because those are ordinary committed modules. Enforced by
# stripping the final dot-free segment from the stem: what remains must itself
# be a bare env stem, so `env.production.backup.ts` and `app.env.local.copy.js`
# stay on the deny globs. A stem with no code extension (`env.d`, `env.local`,
# `config.env.json`) is never a source module.
candidate_is_env_source_module() {
  env_source_base=${1##*/}
  case "$env_source_base" in
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.py|*.rb|*.go|*.rs|*.java|*.kt|*.kts|\
    *.swift) ;;
    *) return 1 ;;
  esac
  env_source_stem=${env_source_base%.*}
  case "$env_source_stem" in
    env|envrc|?*.env|?*.envrc) return 0 ;;
  esac
  case "${env_source_stem%.*}" in
    env|envrc|?*.env|?*.envrc) return 0 ;;
    *) return 1 ;;
  esac
}

candidate_has_default_env_exception() {
  candidate_is_allowed "$1" || candidate_is_env_source_module "$1"
}

# Only these shipped environment-family rules may be relaxed by a classified
# template or source-module basename. Custom deny files are always authoritative,
# and unrelated built-in rules such as `.ssh/id_*` must still win.
deny_pattern_allows_env_exception() {
  case "$1" in
    '.env*'|'*.env'|'*.env.*'|'*.envrc'|'*.envrc.*'|'env.*'|'envrc.*'|\
    '.flaskenv.*'|'.dev.vars.*') return 0 ;;
    *) return 1 ;;
  esac
}

candidate_matches_deny() (
  deny_candidate=$1
  case "$deny_candidate" in
    */*) candidate_parent_matches_deny "${deny_candidate%/*}" && return 0 ;;
  esac

  deny_candidate_has_env_exception=0
  candidate_has_default_env_exception "$deny_candidate" \
    && deny_candidate_has_env_exception=1
  while IFS= read -r deny_pattern || [ -n "$deny_pattern" ]; do
    case "$deny_pattern" in
      ''|\#*) continue ;;
    esac
    case "$deny_candidate" in
      $deny_pattern|*/$deny_pattern)
        if [ "$deny_candidate_has_env_exception" -eq 1 ] \
          && [ "$DENY_READ_PATHS_CUSTOM" -eq 0 ] \
          && deny_pattern_allows_env_exception "$deny_pattern"; then
          continue
        fi
        return 0
        ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
)

matches_deny_path() {
  raw=$1
  [ -f "$DENY_READ_PATHS" ] || return 1

  normalized=$(normalize_path "$raw")
  candidate_matches_deny "$normalized" && return 0

  resolved=$(resolve_path "$normalized")
  if [ "$resolved" != "$normalized" ]; then
    candidate_matches_deny "$resolved" && return 0
  fi
  return 1
}

# Print the directory the tracked-file exception places relative paths in,
# or nothing. The host's own `cwd` is the authority. A directory inside
# tool_input counts only when the event has no `cwd` (the Codex shell shape)
# or names the same one: a file tool takes no such parameter, so a stray
# `tool_input.cwd` must not move "the current repository" elsewhere.
exception_workdir() {
  printf '%s' "$1" | jq -r --arg v "${2-}" "$EXCEPTION_WORKDIR_JQ"' | if '"${3:-true}"' then . else "" end' 2>/dev/null
}
EXCEPTION_WORKDIR_JQ='
  ((.cwd // "") as $event
   | (.tool_input.workdir? // .tool_input.cwd? // "") as $inner
   | if ($event | type) != "string" or ($inner | type) != "string" then ""
     elif $event == "" then $inner
     elif $inner == "" or $inner == $event then $event
     else "" end) as $dir
  | . as $in | if ($dir | test("\n")) then "" else $dir end'

# The Bash scan already runs in the directory the hook took from the event.
# The exception applies only when that is the absolute directory
# exception_workdir names: an empty or stray tool_input field can leave the
# scan in the hook's own directory, where a relative word means another file.
exception_workdir_is_here() {
  ewh_dir=$(exception_workdir "$1") || return 1
  case "$ewh_dir" in /*) ;; *) return 1 ;; esac
  ewh_real=$(CDPATH= cd -P -- "$ewh_dir" 2>/dev/null && pwd -P) || return 1
  [ "$ewh_real" = "$(pwd -P)" ]
}

# $1 is a path a file tool was given, $2 the hook input and $3 the jq path of
# the tool's own path field. Only that field qualifies, compared as a whole
# string: a Grep glob is a name filter applied under the path, any other
# field is not known to be a path, and a path with a newline is a different
# file from the line read here. One jq run answers both questions. Without a
# workdir in the event the path cannot be placed, and the block stands.
tool_path_tracked_exception() (
  [ "${AGENT_GUARD_TRACKED_FILE_EXCEPTION-on}" = on ] || exit 1
  # The host opens the path as written, after collapsing `..` by name; the
  # check below follows symlinks. A path with a `..` part, a URL prefix or a
  # tilde could therefore mean two different files, and keeps the block. A
  # file tool takes no directory of its own, so only the event cwd counts.
  case "/$1/" in */../*|/file:*|/'~'*) exit 1 ;; esac
  # The host may also trim blanks and normalise Unicode before it opens the
  # path, so only plain path characters qualify.
  case "$1" in *[!A-Za-z0-9_./@%+,=-]*) exit 1 ;; esac
  tpt_workdir=$(exception_workdir "$2" "$1" \
    "(\$in | $3) == \$v and (\$in.cwd | type) == \"string\" and \$in.cwd != \"\"") || exit 1
  case "$tpt_workdir" in /*) ;; *) exit 1 ;; esac
  CDPATH= cd -- "$tpt_workdir" 2>/dev/null || exit 1
  tracked_file_exception_applies "$1"
)

check_sensitive_reads() {
  input=$1
  # POSIX sh has no locals: do not reuse the caller's `tool` here, it is still
  # needed by later checks in the same hook run.
  reads_tool=${2:-}
  need_cmd jq
  [ -f "$DENY_READ_PATHS" ] || die "deny read policy not found: $DENY_READ_PATHS"

  # Every string leaf of tool_input is a deny-path candidate: the gate does not
  # know which fields a host treats as paths, so unknown fields fail closed.
  # The one exception is Grep's `pattern`. It is the content regex the host
  # hands to ripgrep, structurally separate from `path` / `glob`, and nothing
  # resolves it into a filesystem path later - so a search for the literal text
  # `.key` is not a read of a `*.key` file (#187). The exemption is limited to
  # a string that does not start with `-`: a host that passed the pattern
  # positionally would let `--file=.env` / `-f.env` make ripgrep read patterns
  # FROM that file, and a non-string `pattern` is not a regex at all, so both
  # keep the every-leaf gate. Glob's `pattern` is a path glob and stays
  # checked. Secret-shaped Grep patterns are still handled by
  # check_broad_grep_content.
  values=$(printf '%s' "$input" | jq -r --arg tool "$reads_tool" '
    .tool_input // {}
    | if $tool == "Grep" and type == "object"
         and (.pattern | type) == "string"
         and (.pattern | startswith("-") | not)
      then del(.pattern) else . end
    | .. | strings')
  [ -n "$values" ] || return 0

  # Drive the loop from a temp file so it runs in this shell, not a pipeline
  # sub-shell — that keeps `exit 2` definitive even if a future edit appends
  # work after the loop.
  tmp=$(mktemp_file) || die "failed to create temp file"
  printf '%s\n' "$values" >"$tmp"
  while IFS= read -r value; do
    [ -n "$value" ] || continue
    if matches_deny_path "$value"; then
      # A file tool reads the one path it is given from the event workdir, so
      # a file under the tracked-file exception is not blocked by its name.
      case "$reads_tool" in
        Read) tool_path_field='.tool_input.file_path' ;;
        NotebookRead) tool_path_field='.tool_input.notebook_path' ;;
        Grep) tool_path_field='.tool_input.path' ;;
        *) tool_path_field= ;;
      esac
      if [ -n "$tool_path_field" ] \
        && tool_path_tracked_exception "$value" "$input" "$tool_path_field"; then
        continue
      fi
      rm -f "$tmp"
      dr_mode=$(deny_read_mode) || dr_mode=invalid
      if [ "$dr_mode" = mask ] && dr_target=$(read_mask_target "$input" "$reads_tool"); then
        deny_read_masked_block "$dr_target" \
          "$(json_value "$JV_WORKDIR" "$input")"
      fi
      info "$PROGRAM: blocked sensitive file access: $value"
      [ "$dr_mode" = invalid ] && deny_read_mode_notice invalid
      exit 2
    fi
  done <"$tmp"
  rm -f "$tmp"
}

deny_path_regex_fragment() {
  # Set dprf_out to the POSIX ERE fragment for a supported deny-read shell
  # glob. The shell-expanded mode also catches command words that the shell
  # can expand into a deny-listed path, such as .e[n]v, .e?v, .e*v, or
  # $'.e\x6ev'. The helpers assign many plain global names, so every caller
  # runs inside a subshell of its own.
  pattern=$1
  mode=${2:-literal}
  case "$mode" in
    shell-expanded|shell-expanded-starless-positions)
      deny_path_shell_expanded_fragment "$pattern" "$mode"
      return
      ;;
  esac
  py=
  remaining=$pattern
  while [ -n "$remaining" ]; do
    ch=${remaining%"${remaining#?}"}
    remaining=${remaining#?}
    case "$ch" in
      '*') py=${py}'[^[:space:]<>|;&`$()]*' ;;
      '.'|'^'|'$'|'+'|'?'|'('|')'|'['|']'|'{'|'}'|'|'|'\\') py=${py}'\'${ch} ;;
      '/') py=${py}'/' ;;
      *) py=${py}${ch} ;;
    esac
  done
  dprf_out=$py
}

# A shell word reaches an entry in two ways. Position by position, each entry
# character may be itself, a \xHH escape, or one glob character (.e[n]v, .e?v,
# .e*v, $'.e\x6ev'). A `*` can also stand for a whole run of characters (.e*,
# ~/.n*, .n*c, .*v), but only inside one `/` component: bash never lets a star
# match a slash, so ~/.config* does not reach .config/gh/hosts.yml. The second
# kind of alternative therefore picks the component that holds the stars and
# spells every other component position by position. Inside that component
# the word is an entry prefix, a `*` (more stars may follow), and an entry
# suffix; prefix and suffix are nested optionals instead of one alternative
# per split point, which keeps the ERE linear in the entry length, at the
# price of letting them overlap (.n*netrc), which can only over-block. A dot
# that starts a component must be spelled out, because bash globs never match
# a leading dot.
#
# The match must also pin at least one of the entry's letters or digits with
# that character, its hex escape, or a bracket listing it: accepting a bare
# star, `?`, or a generic class instead would turn `.*`, `\s*`, and
# `\.[^.]*$` in ordinary sed/grep regexes into protected-path matches. Another
# component spelled out with its first letter pinned is enough. Otherwise the
# prefix pins the component's first letter and is at least two characters long
# (.e*), or, for a component that starts with a dot, the suffix pins its last
# letter (.*v). A suffix pin needs that leading dot: without it, *.json would
# name credentials.json. An entry `*` after the pinned last letter matches only
# stars there, so .*version stays a regex rather than a way to name .env*.
#
# The position-by-position spelling has no pin requirement, so a `*` standing
# for a single entry character lets regex text such as `(.*?)` read as `*.p8`.
# Mode shell-expanded-starless-positions drops that one-character star; the
# caller blocks a word that needs it only when the word also pins a letter.
deny_path_shell_expanded_fragment() {
  sx_rest=$1
  sx_mode=${2:-shell-expanded}
  sx_any='[^[:space:]<>|;&`$()]*'
  sx_gap='\*([^[:space:]<>|;&`$()/]*\*)?'
  sx_n=0 sx_full= sx_alnum_segs=0 sx_seg_pinned=0
  # sx_c_<i>: the entry character at i; sx_t_<i>: the same, but an entry `*`
  # matches only stars; sx_p_<i>: the same as sx_c_<i>, except that each
  # component's first letter is pinned.
  while [ -n "$sx_rest" ]; do
    ch=${sx_rest%"${sx_rest#?}"}
    sx_rest=${sx_rest#?}
    sx_n=$((sx_n + 1))
    case "$ch" in
      '*')
        sx_c=$sx_any
        sx_t='\**'
        ;;
      *)
        deny_path_shell_expansion_char_pattern "$ch"
        sx_c=$sx_char
        sx_t=$sx_c
        ;;
    esac
    sx_p=$sx_c
    case "$ch" in
      /) sx_seg_pinned=0 ;;
      [[:alnum:]])
        if [ "$sx_seg_pinned" -eq 0 ]; then
          sx_seg_pinned=1
          sx_alnum_segs=$((sx_alnum_segs + 1))
          deny_path_pin_char_pattern "$ch"
          sx_p=$sx_pin
        fi
        ;;
    esac
    eval "sx_r_$sx_n=\$ch sx_c_$sx_n=\$sx_c sx_t_$sx_n=\$sx_t sx_p_$sx_n=\$sx_p"
    case "$sx_mode:$sx_c" in
      shell-expanded-starless-positions:*'|\*|'*)
        sx_c=${sx_c%%'|\*|'*}'|'${sx_c#*'|\*|'}
        ;;
    esac
    sx_full=${sx_full}${sx_c}
  done

  sx_alts=
  sx_a=1
  sx_i=1
  while [ "$sx_i" -le $((sx_n + 1)) ]; do
    sx_ch=/
    [ "$sx_i" -le "$sx_n" ] && eval "sx_ch=\$sx_r_$sx_i"
    if [ "$sx_ch" = / ]; then
      [ "$sx_i" -gt "$sx_a" ] \
        && deny_path_spanning_component_alternatives "$sx_a" $((sx_i - 1))
      sx_a=$((sx_i + 1))
    fi
    sx_i=$((sx_i + 1))
  done
  if [ -n "$sx_alts" ]; then
    dprf_out="($sx_full$sx_alts)"
  else
    dprf_out=$sx_full
  fi
}

# Append to sx_alts the alternatives whose stars fall in component $1..$2.
deny_path_spanning_component_alternatives() {
  sca_a=$1
  sca_b=$2
  sca_first= sca_last= sca_j=$sca_a
  while [ "$sca_j" -le "$sca_b" ]; do
    eval "sca_ch=\$sx_r_$sca_j"
    case "$sca_ch" in
      [[:alnum:]])
        [ -n "$sca_first" ] || sca_first=$sca_j
        sca_last=$sca_j
        ;;
    esac
    sca_j=$((sca_j + 1))
  done
  eval "sca_lead=\$sx_r_$sca_a"
  deny_path_sx_concat p 1 $((sca_a - 1))
  sca_before=$sx_out
  deny_path_sx_concat p $((sca_b + 1)) "$sx_n"
  sca_after=$sx_out
  deny_path_sx_suffixes c "$sca_a" "$sca_b"
  sca_suffixes=$sx_out
  # The leading dot of a component is mandatory in every prefix.
  sca_pre_from=$sca_a
  [ "$sca_lead" = . ] && sca_pre_from=$((sca_a + 1))
  deny_path_sx_concat c "$sca_a" $((sca_pre_from - 1))
  sca_prefixes=$sx_out
  deny_path_sx_prefixes c "$sca_pre_from" "$sca_b"
  sca_prefixes=$sca_prefixes$sx_out

  sca_others=$sx_alnum_segs
  [ -n "$sca_first" ] && sca_others=$((sca_others - 1))
  if [ "$sca_others" -ge 1 ]; then
    sx_alts="$sx_alts|$sca_before$sca_prefixes$sx_gap$sca_suffixes$sca_after"
    return 0
  fi
  [ -n "$sca_first" ] || return 0

  sca_head_end=$sca_first
  [ "$sca_head_end" -gt "$sca_a" ] || sca_head_end=$((sca_a + 1))
  if [ "$sca_head_end" -le "$sca_b" ]; then
    deny_path_sx_concat p "$sca_a" "$sca_head_end"
    sca_head=$sx_out
    deny_path_sx_prefixes c $((sca_head_end + 1)) "$sca_b"
    sx_alts="$sx_alts|$sca_before$sca_head$sx_out$sx_gap$sca_suffixes$sca_after"
  fi

  [ "$sca_lead" = . ] || return 0
  eval "sca_ch=\$sx_r_$sca_last"
  deny_path_pin_char_pattern "$sca_ch"
  deny_path_sx_suffixes t "$sca_a" $((sca_last - 1))
  sca_tail=$sx_out$sx_pin
  deny_path_sx_concat t $((sca_last + 1)) "$sca_b"
  sca_tail=$sca_tail$sx_out
  sx_alts="$sx_alts|$sca_before$sca_prefixes$sx_gap$sca_tail$sca_after"
}

# Set sx_pin to the pattern for $1 as a pinning character: itself, a bracket
# listing it, or its \xHH escape when it has an ASCII one.
deny_path_pin_char_pattern() {
  if deny_path_char_hex_pattern "$1"; then
    sx_pin="($1|\\[[^]]*$1[^]]*\\]|\\\\x$sx_hex)"
  else
    sx_pin="($1|\\[[^]]*$1[^]]*\\])"
  fi
}

# Set sx_out to the concatenation of sx_<$1>_<i> for i in $2..$3.
deny_path_sx_concat() {
  sx_out=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"\${sx_out}\${sx_$1_$sx_j}\""
    sx_j=$((sx_j + 1))
  done
}

# Set sx_out to an ERE for any prefix, possibly empty, of sx_<$1>_<$2..$3>.
deny_path_sx_prefixes() {
  sx_out=
  sx_close=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"\${sx_out}(\${sx_$1_$sx_j}\""
    sx_close="${sx_close})?"
    sx_j=$((sx_j + 1))
  done
  sx_out=$sx_out$sx_close
}

# Set sx_out to an ERE for any suffix, possibly empty, of sx_<$1>_<$2..$3>.
deny_path_sx_suffixes() {
  sx_out=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"(\${sx_out}\${sx_$1_$sx_j})?\""
    sx_j=$((sx_j + 1))
  done
}

deny_path_char_hex_pattern() {
  sx_hex=
  case "$1" in
    0) sx_hex='3[0]' ;; 1) sx_hex='3[1]' ;; 2) sx_hex='3[2]' ;; 3) sx_hex='3[3]' ;;
    4) sx_hex='3[4]' ;; 5) sx_hex='3[5]' ;; 6) sx_hex='3[6]' ;; 7) sx_hex='3[7]' ;;
    8) sx_hex='3[8]' ;; 9) sx_hex='3[9]' ;;
    a|A) sx_hex='6[1]' ;; b|B) sx_hex='6[2]' ;; c|C) sx_hex='6[3]' ;;
    d|D) sx_hex='6[4]' ;; e|E) sx_hex='6[5]' ;; f|F) sx_hex='6[6]' ;;
    g|G) sx_hex='6[7]' ;; h|H) sx_hex='6[8]' ;; i|I) sx_hex='6[9]' ;;
    j|J) sx_hex='6[aA]' ;; k|K) sx_hex='6[bB]' ;; l|L) sx_hex='6[cC]' ;;
    m|M) sx_hex='6[dD]' ;; n|N) sx_hex='6[eE]' ;; o|O) sx_hex='6[fF]' ;;
    p|P) sx_hex='7[0]' ;; q|Q) sx_hex='7[1]' ;; r|R) sx_hex='7[2]' ;;
    s|S) sx_hex='7[3]' ;; t|T) sx_hex='7[4]' ;; u|U) sx_hex='7[5]' ;;
    v|V) sx_hex='7[6]' ;; w|W) sx_hex='7[7]' ;; x|X) sx_hex='7[8]' ;;
    y|Y) sx_hex='7[9]' ;; z|Z) sx_hex='7[aA]' ;;
    '.') sx_hex='2[eE]' ;; '_') sx_hex='5[fF]' ;; '-') sx_hex='2[dD]' ;;
    *) return 1 ;;
  esac
}

# Set sx_char rather than spawning a command-substitution shell per character.
# These helpers share only private output variables; the enclosing fragment
# conversion already runs in a subshell of its own.
deny_path_shell_expansion_char_pattern() {
  sx_char_input=$1
  case "$sx_char_input" in
    '.'|'^'|'$'|'+'|'?'|'('|')'|'['|']'|'{'|'}'|'|'|'\\')
      sx_char_literal=\\$sx_char_input
      ;;
    *) sx_char_literal=$sx_char_input ;;
  esac
  deny_path_char_hex_pattern "$sx_char_input" || :
  case "$sx_char_input" in
    '/') sx_char=/ ;;
    '.')
      if [ -n "$sx_hex" ]; then
        sx_char="($sx_char_literal|\\\\x$sx_hex)"
      else
        sx_char=$sx_char_literal
      fi
      ;;
    *)
      # A bracket made only of digits and `-` (`[0-9]`) cannot match an ASCII
      # letter. The letters are listed because a range follows the locale.
      sx_bracket='\[[^]]+\]'
      case "$sx_char_input" in
        [abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ])
          sx_bracket='\[[^]]*[^]0-9-][^]]*\]' ;;
      esac
      if [ -n "$sx_hex" ]; then
        sx_char="($sx_char_literal|\\\\x$sx_hex|\\?|\\*|$sx_bracket)"
      else
        sx_char="($sx_char_literal|\\?|\\*|$sx_bracket)"
      fi
      ;;
  esac
}

deny_path_command_regex() {
  deny_path_command_regex_set "$1" "$2" || return 1
  printf '%s' "$dcr_regex"
}

# Set dcr_regex to what deny_path_command_regex prints. Like
# deny_path_regex_fragment, it must run inside a subshell of its own.
deny_path_command_regex_set() {
  deny_path_regex_fragment "$1" "$2"
  converted=$dprf_out
  [ -n "$converted" ] || return 1
  # Catch path arguments and shell words without matching substrings like myenv.
  # A `[` just before an expanded word opens a bracket expression that matches
  # one character, so the word after it is not where a file name starts: CSS
  # selectors such as div[id*="x"] stay allowed.
  dcr_lead='[^[:alnum:]_./~-]'
  case "$2" in
    shell-expanded*) dcr_lead='[^[:alnum:][_./~-]' ;;
  esac
  dcr_regex='(^|'"$dcr_lead"')('"${converted}"'|[^[:space:]<>|;&`$()]*/'"${converted}"')([^[:alnum:]_.-]|$)'
}

# Set sx_out to an ERE matching any pin of the entry's letters and digits.
deny_path_entry_pin_regex() {
  pr_rest=$1
  sx_out=
  while [ -n "$pr_rest" ]; do
    pr_ch=${pr_rest%"${pr_rest#?}"}
    pr_rest=${pr_rest#?}
    case "$pr_ch" in
      [[:alnum:]])
        deny_path_pin_char_pattern "$pr_ch"
        sx_out=${sx_out:+$sx_out|}$sx_pin
        ;;
    esac
  done
}

# $1 already matched the shell-expanded regex $3 for entry $2. Return 0 when
# the match holds without a one-character star, or when a word that matches
# also pins a letter of the entry; return 1 for a match that relies on a star
# alone, such as `(.*?)` for `*.p8`. A word that pins a letter elsewhere only
# over-blocks. Any other status is a failed scan.
bash_shell_expanded_match_is_pinned() {
  sp_regex=$(deny_path_command_regex "$2" shell-expanded-starless-positions) || return 0
  printf '%s\n' "$1" | grep -Eq "$sp_regex"
  sp_status=$?
  [ "$sp_status" -eq 1 ] || return "$sp_status"
  deny_path_entry_pin_regex "$2"
  [ -n "$sx_out" ] || return 0
  sp_words=$(printf '%s\n' "$1" | tr -s '[:space:]<>|;&`$()' '[\n*]' | grep -E "$3")
  sp_status=$?
  # A bracket can hold a separator, so a split can lose the line's match.
  [ "$sp_status" -eq 1 ] && return 0
  [ "$sp_status" -eq 0 ] || return "$sp_status"
  printf '%s\n' "$sp_words" | grep -Eq "$sx_out"
}

# Compiling every entry's regex in shell is most of a Bash hook's CPU, and the
# result depends only on the deny list, this script and the mode. One combined
# regex file per mode lets a single grep rule a command out. Only a clean
# "no match" is trusted: a match, a grep error, or any cache problem runs the
# per-entry loop below, which names the entry and applies the pin check.
# The file name carries the identity (device, inode, size, mtime, ctime) of the
# deny list and of this script, so editing either one misses the cache. The
# file lives in the private state directory audit_begin validated.
#
# Without a state directory (diagnostics, AGENT_GUARD_LOG_MODE=off without
# AGENT_GUARD_SCAN_CACHE=on) the file is built in this invocation's run
# directory instead and reused only by the
# passes of this invocation, which see the same deny list, script and locale;
# the exit trap removes it with the directory. mktemp -d made that directory
# (mode 700) for this process alone, so no other writer can supply the file. A
# run directory that is missing, a symlink or not writable, or a build that
# failed once, leaves every pass on the per-entry loop, as before.
#
# Why a clean "no match" is sound: every line of the file is the regex the
# per-entry loop builds for one active entry, written by the same
# deny_path_command_regex, and deny_path_cache_complete checks that each
# active entry wrote exactly one line. `grep -E -f` exits 1 only when no line
# matches, so every per-entry grep of the loop would also have exited 1 and
# the loop would have blocked nothing.
DENY_PATH_CACHE_ID=
DENY_PATH_RUNDIR_CACHE=on

deny_path_cache_file() {
  if [ -z "$AG_STATE_DIR" ]; then
    [ "$DENY_PATH_RUNDIR_CACHE" = on ] || return 1
    [ -n "${AGENT_GUARD_RUNDIR:-}" ] && [ -d "$AGENT_GUARD_RUNDIR" ] \
      && [ ! -L "$AGENT_GUARD_RUNDIR" ] && [ -w "$AGENT_GUARD_RUNDIR" ] || return 1
    dpc_file="$AGENT_GUARD_RUNDIR/deny-path-regex-$1"
    [ ! -L "$dpc_file" ] && [ ! -d "$dpc_file" ]
    return
  fi
  if [ -z "$DENY_PATH_CACHE_ID" ]; then
    dpc_nl='
'
    dpc_ids=$(file_stat identity -L "$DENY_READ_PATHS" "$SELF_BIN") || return 1
    # The regex splits a multibyte character differently per locale, so the
    # locale that built a file is part of its name.
    dpc_ids="$VERSION:${dpc_ids%%"$dpc_nl"*}:${dpc_ids#*"$dpc_nl"}:L${LC_ALL:-}:${LC_CTYPE:-}:${LANG:-}"
    # Anything outside this alphabet (a Linux stat date has spaces and a
    # sign) is not a file name worth trusting.
    case "$dpc_ids" in *[!0-9A-Za-z.:_+\ -]*) return 1 ;; esac
    DENY_PATH_CACHE_ID=$dpc_ids
  fi
  dpc_file="$AG_STATE_DIR/deny-path-regex-$1-$DENY_PATH_CACHE_ID"
  [ ! -L "$dpc_file" ] && [ ! -d "$dpc_file" ]
}

# A read error ends the loop like end of file. Count the active entries in a
# second pass: every one of them must have written exactly one regex.
deny_path_cache_complete() {
  # Skips exactly what the loop skips: an empty line or one starting with `#`.
  dpc_want=$(grep -Evc '^(#|$)' "$DENY_READ_PATHS") || return 1
  dpc_got=$(grep -c '' "$1") || return 1
  [ "$dpc_want" -eq "$dpc_got" ] 2>/dev/null
}

deny_path_cache_store() {
  dpc_mode=$1
  dpc_tmp=$(umask 077; mktemp "$dpc_file.XXXXXX" 2>/dev/null) || return 1
  # A failed write (a full disk) must not publish the regexes written so far:
  # a file missing an entry would rule that entry's commands out.
  # One subshell for the whole list, not one per entry: the regex helpers
  # assign plain global names.
  if ! {
    (
      while IFS= read -r dpc_entry || [ -n "$dpc_entry" ]; do
        case "$dpc_entry" in
          ''|\#*) continue ;;
        esac
        # The scan skips an entry that yields no regex, but a failure here may
        # be transient, and a file without that entry would rule its commands
        # out.
        deny_path_command_regex_set "$dpc_entry" "$dpc_mode" || exit 1
        printf '%s\n' "$dcr_regex" || exit 1
      done
    ) <"$DENY_READ_PATHS" >"$dpc_tmp" \
      && [ -s "$dpc_tmp" ] \
      && deny_path_cache_complete "$dpc_tmp" && mv -f "$dpc_tmp" "$dpc_file"
  } 2>/dev/null; then
    rm -f "$dpc_tmp" 2>/dev/null || :
    return 1
  fi
  # Only the shared state directory holds files of other list, script or
  # locale keys; they stay until a handful pile up.
  [ -n "$AG_STATE_DIR" ] || return 0
  case "$dpc_file" in "$AG_STATE_DIR"/*) ;; *) return 0 ;; esac
  dpc_count=0
  for dpc_old in "$AG_STATE_DIR/deny-path-regex-$dpc_mode-"*; do
    [ -f "$dpc_old" ] && dpc_count=$((dpc_count + 1))
  done
  if [ "$dpc_count" -gt 6 ]; then
    for dpc_old in "$AG_STATE_DIR/deny-path-regex-$dpc_mode-"*; do
      [ "$dpc_old" = "$dpc_file" ] || [ -d "$dpc_old" ] || rm -f "$dpc_old" 2>/dev/null || :
    done
  fi
  return 0
}

# Return 0 only when no deny-list entry can match $1 in mode $2.
deny_path_cache_rules_out() {
  deny_path_cache_file "$2" || return 1
  if ! { [ -s "$dpc_file" ] && [ -f "$dpc_file" ]; }; then
    deny_path_cache_store "$2" || {
      # A run-directory build that failed would fail again in the next pass.
      [ -n "$AG_STATE_DIR" ] || DENY_PATH_RUNDIR_CACHE=off
      return 1
    }
  fi
  printf '%s\n' "$1" | grep -Eq -f "$dpc_file"
  [ "$?" -eq 1 ]
}

# The shell-expanded regex of an entry differs from its literal regex only in
# alternatives that need a `*`, `?`, `[` or a backslash (\xHH) in the text,
# and in a lead class that also refuses `[`; the wrapper and an entry `*` are
# spelled the same. So for an entry made only of letters, digits and `._/~*-`
# (each spelled as itself in both modes) and a text without those four
# characters, both regexes match the same texts, a match needs no pin check
# (it pins every letter it spells), and the literal pass gives the verdict and
# the entry it names. Its combined file is a fraction of the shell-expanded one,
# which costs most of a plain Bash hook to build and to compile in grep.
# A deny list with any other character keeps every shell-expanded pass.
DENY_PATH_SX_LITERAL_LIST=

# Return 0 when a shell-expanded pass over $1 may read it in literal mode.
deny_path_sx_reads_as_literal() {
  case "$1" in
    *'*'*|*'?'*|*'['*|*'\'*) return 1 ;;
  esac
  if [ -z "$DENY_PATH_SX_LITERAL_LIST" ]; then
    DENY_PATH_SX_LITERAL_LIST=yes
    # The entries the scan loop reads. The letters are listed because a range
    # follows the locale.
    while IFS= read -r dpl_entry || [ -n "$dpl_entry" ]; do
      case "$dpl_entry" in
        ''|\#*) ;;
        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/~*-]*)
          DENY_PATH_SX_LITERAL_LIST=no
          break
          ;;
      esac
    done <"$DENY_READ_PATHS" 2>/dev/null || DENY_PATH_SX_LITERAL_LIST=no
  fi
  [ "$DENY_PATH_SX_LITERAL_LIST" = yes ]
}

# Private variable name; see check_bash_command (#127).
bash_matches_deny_path_mode() {
  mode_cmd=$1
  mode=$2
  [ -f "$DENY_READ_PATHS" ] || return 1
  if [ "$mode" = shell-expanded ] && deny_path_sx_reads_as_literal "$mode_cmd"; then
    mode=literal
  fi
  ! deny_path_cache_rules_out "$mode_cmd" "$mode" || return 1
  while IFS= read -r entry || [ -n "$entry" ]; do
    case "$entry" in
      ''|\#*) continue ;;
    esac
    regex=$(deny_path_command_regex "$entry" "$mode") || continue
    printf '%s\n' "$mode_cmd" | grep -Eq "$regex"
    grep_status=$?
    if [ "$grep_status" -eq 0 ] && [ "$mode" = shell-expanded ]; then
      bash_shell_expanded_match_is_pinned "$mode_cmd" "$entry" "$regex"
      grep_status=$?
    fi
    case "$grep_status" in
      0)
        # Name what tripped the gate on stdout, so a block can be diagnosed
        # without guessing (#99): the value of this line is that a false
        # positive can be rewritten instead of answered by weakening the deny
        # list. Report the entry only -- it is public policy text. An excerpt of
        # the matched text is NOT safe to emit: both wildcards in the regex
        # swallow whatever else shares the shell word (an entry's own trailing
        # `*` eats a URL query string, the `<prefix>/` alternative eats a
        # userinfo field or a directory component), so the excerpt can carry a
        # credential, and this branch blocks before any scanner runs, leaving
        # nothing downstream to redact it.
        # The caller prints it once the block is final.
        deny_path_report="matched deny-read-paths entry '$entry'"
        deny_path_regex=$regex
        return 0
        ;;
      1) ;;
      *)
        # grep failed (e.g. a custom deny-read entry produced an invalid ERE).
        # Fail closed, mirroring check_bash_command: silently allowing here
        # would let one bad entry disable the rest of the deny-read path check.
        info "$PROGRAM: deny-read-paths Bash scan failed; refusing to allow command"
        exit 2
        ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
}

shell_dequote_for_policy() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c == "\\") {
          i++
          if (i <= length($0)) {
            out = out substr($0, i, 1)
          }
          continue
        }
        if (c == "\"" || c == "\047") {
          continue
        }
        out = out c
      }
      print out
    }
  '
}

# Replace the brackets of a quoted subscript with \001. shell_dequote_for_policy
# drops the quotes, so a program such as python3 -c 'a["x"]["y"]' would
# otherwise read as the bracket glob a[x][y] in the shell-expanded passes; the
# raw text reads `["x"]` as a bracket expression too. Only a '...' quote that is
# the program argument of python -c (the text just before it ends in that
# option, and python itself is in command position, after at most NAME=value
# assignments) can hold a subscript: other quoted text may be a pattern that
# find, a shell run through `. /dev/stdin`, rg, or another interpreter that
# only received `python3 -c` as arguments expands itself. Inside such a program
# the Python strings are followed (", """, backslash escapes), and only a `[`
# followed by a quote that sits outside every Python string opens a subscript;
# the next `]` outside a string closes it. A `[` inside a string literal is
# pattern text (re.fullmatch("""e["n"]v""", name)) and keeps its brackets, as
# does `[^ ]` in a quoted regex and every bracket outside quotes (a glob such
# as .e[n]"v"). A program with a `#` outside a string, or a string that does
# not close, is left alone.
# The text comes back unchanged, so every bracket is read, when the quote state
# cannot be followed to the end (an unterminated quote, or $( or a backtick
# inside double quotes), or when the command could expand a pattern from inside
# the program (a shell, eval, source, ssh, xargs, a process-spawning call, or
# glob/fnmatch): python3 -c 'glob.glob("""e["n"]v""")' reads a real glob. The
# same goes for a command that turns the program's output into shell words
# ($(...), backticks, <(...), read): cat $(python3 -c 'print("""e["n"]v""")')
# lets the shell expand what the program printed. After the program's closing
# quote the command may only continue through pipes: a `;`, `&`, redirection,
# backtick, $( or a following line could run what the program wrote
# (python3 -c '...' > code; . ./code), and the dot command is on the list above.
# Also left alone: a multi-line command (a here-document or function body is
# not attributable to python), a function definition, alias or PATH assignment
# (python3 may not be python), a backslash before a separator (the text this
# function receives has already lost whether a `;` was escaped), and a program
# that can list a directory or
# import its way to one (os, pathlib, listdir...), since only such a program
# can match names against pattern text; one that cannot opens literal names,
# which the unmodified scan already reads.
# $2, when set, is the same command before its jq field names were dropped.
# A dot command is then looked for only there: dropping `.name` from
# `select(.name | ...)` leaves `(. ` inside the filter, which runs nothing.
# A `#` that starts a word ends the line for quote tracking, so a comment's
# apostrophe cannot flip the state for the lines below it.
# Under the same conditions, every glob character becomes \001 in the whole
# '...' program word of python -c, node/bun -e|-p, jq (no-argument options
# only before it) or awk (only -F options before it): regex text such as
# id[_a-z]* or /id_r?a/ then no longer reads as a glob that names id_rsa. That
# needs a program that cannot match names it learns against the pattern and
# open them, nor hand the pattern to a module that expands it: a python
# program that imports only a few stdlib modules or a node program that loads
# none, either with nothing piped into it, an awk program without getline or
# ARGV, or any jq filter; for awk, also no `|` that pipes to a command; and
# output that only goes through plain text filters
# (wc, head, sort, grep...), never to a command that may expand what the
# program printed. The literal passes still read the unmodified word.
shell_neutralize_quoted_brackets_for_policy() {
  # A second line may be a here-document body or a function body, neither of
  # which this scan can attribute to python, so such a command is left alone.
  case "$1" in
    *'
'*) printf '%s\n' "$1"; return ;;
  esac
  nq_bail='(^|[^[:alnum:]_.-])(sh|bash|zsh|dash|ksh|ash|csh|tcsh|fish|eval|source|xargs|read|mapfile|readarray|alias|function|os)([^[:alnum:]_.-]|$)|ssh|system|popen|Popen|subprocess|spawn|exec|child_process|glob|fnmatch|listdir|iterdir|scandir|walk|pathlib|Path|shutil|fileinput|__import__|importlib|compile|getattr|globals|builtins|<<|\$\(|`|<\(|>\(|[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*[{(]|(^|[[:space:];&|(])PATH=|\\[[:space:]]*[;&|(]'
  nq_dot='(^|[[:space:];&|(])\.([[:space:]]|$)'
  if printf '%s\n' "$1" | grep -Eq "$nq_bail|$nq_dot"; then
    # The text before field names were dropped must pass the whole test.
    if [ -z "${2-}" ] ||
      printf '%s\n' "$1" | grep -Eq "$nq_bail" ||
      printf '%s\n' "$2" | grep -Eq "$nq_bail|$nq_dot"; then
      printf '%s\n' "$1"
      return
    fi
  fi
  printf '%s\n' "$1" | LC_ALL=C awk '
    function closed(l, p,   r) {
      r = substr(l, p + 1)
      if (r ~ /[;&<>`]/ || r ~ /\$\(/) bail = 1
      lastclose = NR
    }
    function pyneutral(s,   j, m, ch, ps, sub2, res2) {
      m = length(s); ps = 0; sub2 = 0; res2 = ""
      for (j = 1; j <= m; j++) {
        ch = substr(s, j, 1)
        if (ps == 0) {
          if (ch == "#") return s
          if (ch == "\"") {
            # An f-string or t-string may nest quotes (Python 3.12, 3.14), which this scan cannot follow.
            if (substr(s, (j > 2 ? j - 2 : 1), (j > 2 ? 2 : j - 1)) ~ /[fFtT]$|[fFtT][rR]$/) return s
            if (substr(s, j, 3) == "\"\"\"") { ps = 3; res2 = res2 "\"\"\""; j += 2; continue }
            ps = 1
          } else if (ch == "[" && substr(s, j + 1, 1) == "\"") { sub2 = 1; ch = "\001" }
          else if (ch == "]" && sub2) { sub2 = 0; ch = "\001" }
        } else if (ch == "\\") {
          res2 = res2 ch substr(s, j + 1, 1); j++; continue
        } else if (ps == 1 && ch == "\"") ps = 0
        else if (ps == 3 && substr(s, j, 3) == "\"\"\"") { ps = 0; res2 = res2 "\"\"\""; j += 2; continue }
        res2 = res2 ch
      }
      return (ps == 0 && !sub2) ? res2 : s
    }
    # Whole-word rewrite: w is the program, pre the text before it, r the rest
    # of its line. A python or node program has too many ways to open a file
    # to list, so it may not read names from a pipe; awk opens files only
    # through getline and ARGV; jq opens none. None may list or glob a
    # directory, nor (awk) pipe to a command, and the output may only reach
    # plain text filters. Any File substring (FileIO, GzipFile, readFileSync,
    # the source name of an imported alias) counts as opening a file. An
    # outside module may expand a pattern argument itself (polars, dask,
    # shelljs), so a python program may import only the modules pymodok names,
    # in a shape pyimportsok reads with certainty, and a node or bun program
    # may load no module at all.
    function progneutral_ok(w, pre, r, isawk, isjq, ispy,   t, segs, k, m, wd) {
      if (w ~ /open|File|ReadStream|readdir|readDir|Glob|Bun\.file|getline|ARGV/) return 0
      if (ispy && !pyimportsok(w)) return 0
      if (!ispy && !isawk && !isjq && w ~ /require|import|binding|mainModule|getBuiltinModule|module/) return 0
      # Any pipe earlier on the line may feed the program (`| (`, `|&`).
      t = pre; gsub(/\|\|/, "", t)
      if (!isawk && !isjq && index(t, "|")) return 0
      t = w; gsub(/\|\|/, "", t)
      if (isawk && index(t, "|")) return 0
      gsub(/\|\|/, "\002", r)
      m = split(r, segs, "|")
      for (k = 2; k <= m; k++) {
        wd = segs[k]; sub(/^[ \t]+/, "", wd); match(wd, /^[A-Za-z0-9_-]*/)
        if (substr(wd, 1, RLENGTH) !~ /^(wc|head|tail|sort|uniq|tr|cut|nl|grep|column)$/) return 0
      }
      return 1
    }
    function pymodok(m) {
      return m ~ /^(re|sys|json|string|math|itertools|collections|functools|textwrap|unicodedata)$/
    }
    function pynamesok(l, mods,   p, q, k, nm) {
      q = split(l, p, ",")
      for (k = 1; k <= q; k++) {
        nm = p[k]; sub(/^[ \t]+/, "", nm); sub(/[ \t]+$/, "", nm)
        sub(/[ \t]+as[ \t]+[A-Za-z_][A-Za-z0-9_]*$/, "", nm)
        if (nm !~ /^[A-Za-z_][A-Za-z0-9_]*$/ || (mods && !pymodok(nm))) return 0
      }
      return q > 0
    }
    # Every import token must open a ;-separated statement of one of the two
    # forms below; one anywhere else (after `if x:`, in a string) fails too.
    function pyimportsok(w,   s, q, k, t) {
      q = split(w, s, ";")
      for (k = 1; k <= q; k++) {
        t = s[k]; sub(/^[ \t]+/, "", t)
        if (t ~ /^import[^A-Za-z0-9_]/) {
          if (!pynamesok(substr(t, 7), 1)) return 0
        } else if (t ~ /^from[ \t]+[A-Za-z0-9_]+[ \t]+import[ \t]/) {
          sub(/^from[ \t]+/, "", t); match(t, /^[A-Za-z0-9_]+/)
          if (!pymodok(substr(t, 1, RLENGTH))) return 0
          t = substr(t, RLENGTH + 1); sub(/^[ \t]+import/, "", t)
          if (!pynamesok(t, 0)) return 0
        } else if (t ~ /(^|[^A-Za-z0-9_])import([^A-Za-z0-9_]|$)/) return 0
      }
      return 1
    }
    function progneutral(s) {
      gsub(/[[*?]/, "\001", s)
      gsub(/\]/, "\001", s)
      return s
    }
    BEGIN {
      lead = "(^|[;&|(])[ \t]*([A-Za-z_][A-Za-z0-9_]*=[^ \t]*[ \t]+)*"
      pyprog = lead "python[0-9.]*([ \t]+-[A-Za-z]+)*[ \t]+-c[ \t]+$"
      prog = lead "(python[0-9.]*([ \t]+-[A-Za-z]+)*[ \t]+-c" \
        "|(node|nodejs|bun)([ \t]+-[A-Za-z][-A-Za-z0-9=]*)*[ \t]+(-e|-p|-pe|-ep|--eval|--print)" \
        "|jq([ \t]+(-[nrjcsSaCMeR]+|--(raw-output|compact-output|slurp|null-input|exit-status|sort-keys|join-output|raw-input|ascii-output|tab)))*)[ \t]+$"
      awkprog = lead "(awk|gawk|mawk)([ \t]+-F[^ \t\047\"]+)*[ \t]+$"
      jqprog = lead "jq([ \t]+(-[nrjcsSaCMeR]+|--(raw-output|compact-output|slurp|null-input|exit-status|sort-keys|join-output|raw-input|ascii-output|tab)))*[ \t]+$"
    }
    {
      orig[NR] = $0
      out = ""
      n = length($0)
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        nx = substr($0, i + 1, 1)
        if (st == 0) {
          if (c == "\\") { out = out c nx; i++; continue }
          if (c == "#" && (i == 1 || substr($0, i - 1, 1) ~ /[ \t;&|(]/)) {
            out = out substr($0, i); break
          }
          if (c == "$" && nx == "\047") { out = out "$\047"; i++; st = 3; continue }
          if (c == "\047" && (out ~ prog || out ~ awkprog)) {
            e = index(substr($0, i + 1), "\047")
            w = substr($0, i + 1, e - 1)
            if (e > 0 && progneutral_ok(w, out, substr($0, i + e + 1), out ~ awkprog, out ~ jqprog, out ~ pyprog)) w = progneutral(w)
            else if (e > 0 && out ~ pyprog) w = pyneutral(w)
            else e = 0
            if (e > 0) {
              out = out "\047" w "\047"
              i += e
              closed($0, i)
              continue
            }
          }
          if (c == "\047") st = 1
          else if (c == "\"") st = 2
          out = out c
          continue
        }
        if (st == 1) {
          if (c == "\047") st = 0
          out = out c
          continue
        }
        if (st == 2) {
          if (c == "\\") { out = out c nx; i++; continue }
          if (c == "`" || (c == "$" && nx == "(")) bail = 1
          if (c == "\"") st = 0
          out = out c
          continue
        }
        if (c == "\\") { out = out c nx; i++; continue }
        if (c == "\047") st = 0
        out = out c
      }
      res[NR] = out
    }
    END {
      keep = (st != 0 || bail || (lastclose && lastclose < NR))
      for (k = 1; k <= NR; k++) print keep ? orig[k] : res[k]
    }
  '
}

# Unquote the command the way bash would, decoding $'...' escapes. The coarse
# pass above turns $'.e\x6e'v into $.ex6ev, so an ANSI-C escape spliced with
# unquoted text slipped past both it and the raw \xHH alternatives. A byte that
# no deny-read path contains (a control character, a backslash, or anything
# above ASCII) becomes \001; a NUL ends the $'...' string, as in bash. Every
# backslash left in the output is literal text, such as the \x6e in '\x6e' or
# \$'\x6e', so it must not reach the shell-expanded pass, which would read it
# as an escape again. Expansions and globs are left as text for the literal and
# shell-expanded passes.
shell_decode_ansi_c_for_policy() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    function hexval(ch) { return index("0123456789abcdef", tolower(ch)) - 1 }
    function emit(v) {
      if (nul) return
      if (v == 0) { nul = 1; return }
      if (v < 32 || v > 126) v = 1
      out = out sprintf("%c", v)
    }
    { s = (NR == 1) ? $0 : s "\n" $0 }
    END {
      q = "\047"; out = ""; state = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (state == "single") {
          if (c == q) state = ""; else out = out c
          continue
        }
        if (state == "double") {
          if (c == "\"") { state = ""; continue }
          if (c == "\\" && i < n && index("$`\"\\\n", substr(s, i + 1, 1))) {
            i++
            if (substr(s, i, 1) != "\n") out = out substr(s, i, 1)
            continue
          }
          out = out c
          continue
        }
        if (state == "ansi") {
          if (c == q) { state = ""; continue }
          if (c != "\\" || i == n) { if (!nul) out = out c; continue }
          i++
          e = substr(s, i, 1)
          if (e == "x" || e == "u" || e == "U") {
            max = (e == "x") ? 2 : ((e == "u") ? 4 : 8)
            v = 0; k = 0
            while (k < max && i < n && hexval(substr(s, i + 1, 1)) >= 0) {
              i++; v = v * 16 + hexval(substr(s, i, 1)); k++
            }
            if (k > 0) emit(v); else if (!nul) out = out "\\" e
          } else if (e ~ /[0-7]/) {
            v = e + 0; k = 1
            while (k < 3 && i < n && substr(s, i + 1, 1) ~ /[0-7]/) {
              i++; v = v * 8 + substr(s, i, 1); k++
            }
            emit(v)
          } else if (e == "c") {
            if (i < n) i++
            emit(1)
          } else if (index("abefnrtvE", e)) {
            emit(1)
          } else if (index("\\\047\"?", e)) {
            if (!nul) out = out e
          } else if (!nul) {
            out = out "\\" e
          }
          continue
        }
        if (c == "\\") {
          if (i < n) { i++; if (substr(s, i, 1) != "\n") out = out substr(s, i, 1) }
          continue
        }
        if (c == q) { state = "single"; continue }
        if (c == "\"") { state = "double"; continue }
        if (c == "$" && i < n && substr(s, i + 1, 1) == q) {
          state = "ansi"; nul = 0; i++
          continue
        }
        if (c == "$" && i < n && substr(s, i + 1, 1) == "\"") {
          state = "double"; i++
          continue
        }
        out = out c
      }
      gsub(/\\/, "\001", out)
      print out
    }
  '
}

# Drop the backslash-newline pairs bash removes before it splits words: those
# outside quotes and inside "...", but not inside '...' or $'...'. The later
# passes split the command into words and rejoin them with spaces, which would
# turn $\<newline>'...' into `$\ '...'` and hide the $'...' string bash reads.
shell_join_line_continuations() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    { s = (NR == 1) ? $0 : s "\n" $0 }
    END {
      q = "\047"; out = ""; state = ""; dollar = 0; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (state == "single") {
          if (c == q) state = ""
          out = out c
          continue
        }
        if (state == "ansi") {
          out = out c
          if (c == "\\" && i < n) { i++; out = out substr(s, i, 1) }
          else if (c == q) state = ""
          continue
        }
        if (c == "\\" && i < n) {
          i++
          if (substr(s, i, 1) != "\n") { out = out c substr(s, i, 1); dollar = 0 }
          continue
        }
        if (state == "double") {
          if (c == "\"") state = ""
          out = out c
          continue
        }
        if (c == q) state = dollar ? "ansi" : "single"
        else if (c == "\"") state = "double"
        dollar = (c == "$" && !dollar)
        out = out c
      }
      print out
    }
  '
}

# Remove only exclusion operands whose command context proves they do not name a
# file to read. This is intentionally narrow: globally dropping `!*.pem` would
# turn a literal path such as `cat '!secret.pem'` into a policy bypass. Ripgrep's
# negative glob is common in repository scans and has an unambiguous grammar.
#
# The value must be one literal word: a single-quoted part holding no quote, a
# double-quoted part holding no quote, `$`, backquote or backslash, or an
# unquoted word holding none of those nor a brace. Anything else may expand
# into a command substitution that reads a file, or (`!{a,b}.pem`) into a
# second word that rg opens.
bash_strip_exclusion_operands() {
  (
    set -f
    shell_words_marker "$1"
    words=$(shell_command_words "$1") || { printf '%s' "$1"; exit 0; }
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    unset IFS
    result= shell_words_nl= command_name= pending_glob= git_state=
    # A literal-pathspec setting makes `:!name` the name of a file.
    case "$* ${GIT_LITERAL_PATHSPECS+GIT_LITERAL_PATHSPECS}" in
      *GIT_LITERAL_PATHSPECS*|*--literal-pathspecs*|*--no-index*) git_state=off ;;
    esac

    # A git pathspec that only leaves paths out (`:!name`, `:^name`,
    # `:(exclude)name`) can make git read nothing more. The same limits as
    # for a negative glob apply to what follows the prefix.
    is_exclude_pathspec_value() {
      value=$1
      case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
        \"*\") value=${value#\"}; value=${value%\"} ;;
        *'{'*|*'}'*) return 1 ;;
      esac
      case "$value" in
        ':!'*|':^'*) value=${value#:?} ;;
        ':(exclude)'*) value=${value#':(exclude)'} ;;
        *) return 1 ;;
      esac
      case "$value" in
        *[[:space:]]*|*\'*|*\"*|*'$'*|*'`'*|*\\*|*';'*|*'|'*|*'&'*|\
        *'<'*|*'>'*|*'('*|*')'*|*"$SHELL_WORD_NL"*) return 1 ;;
      esac
      return 0
    }

    is_negative_glob_value() {
      value=$1
      case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
        \"*\") value=${value#\"}; value=${value%\"} ;;
        *'{'*|*'}'*) return 1 ;;
      esac
      # Where shell_command_words reads quotes unlike the shell, the quoted
      # value is shell code; without blanks, operators, expansions or quotes
      # it cannot run anything.
      case "$value" in
        *[[:space:]]*|*\'*|*\"*|*'$'*|*'`'*|*\\*|*';'*|*'|'*|*'&'*|\
        *'<'*|*'>'*|*'('*|*')'*|*"$SHELL_WORD_NL"*) return 1 ;;
      esac
      case "$value" in !*) return 0 ;; *) return 1 ;; esac
    }

    for token in "$@"; do
      # is_shell_command_separator, a lone `&` and the newline word, matched
      # inline because this runs once per word (#595).
      case $token in
        ';'|'&&'|'||'|'|'|'&'|"$SHELL_WORD_NL")
          [ -n "$pending_glob" ] && shell_words_append "$pending_glob"
          pending_glob=
          shell_words_append "$token"
          command_name=
          case $git_state in off) ;; *) git_state= ;; esac
          continue
          ;;
      esac

      if [ -z "$command_name" ]; then
        if is_assignment_token "$token" || is_noop_wrapper "${token##*/}"; then
          shell_words_append "$token"
          continue
        fi
        command_name=${token##*/}
        case "$command_name" in
          *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._+-]*)
            command_name=$(printf '%s' "$command_name" | tr -d "'\"")
            ;;
        esac
        shell_words_append "$token"
        continue
      fi

      if [ "$command_name" = rg ]; then
        if [ -n "$pending_glob" ]; then
          if is_negative_glob_value "$token"; then
            pending_glob=
            continue
          fi
          shell_words_append "$pending_glob"
          pending_glob=
        fi
        case "$token" in
          -g|--glob|--iglob)
            pending_glob=$token
            continue
            ;;
          --glob=*|--iglob=*)
            value=${token#*=}
            is_negative_glob_value "$value" && continue
            ;;
        esac
      fi
      # git_state: empty at the word after `git`, then `sub` for a
      # subcommand whose words after `--` are pathspecs, `dd` past that
      # `--`, `no` for the rest of another segment, and `off` for the rest
      # of the command.
      case $command_name:$git_state in
        git:)
          case $token in
            grep|diff|log|show|status|ls-files|add) git_state=sub ;;
            *) git_state=no ;;
          esac
          ;;
        git:sub)
          case $token in
            --) git_state=dd ;;
            *'<'*|*'>'*) git_state=off ;;
          esac
          ;;
        git:dd)
          # A word after a redirection is a file, and one after an option may
          # be its value (`-e -- -f NAME` makes `--` the pattern).
          case $token in
            -*|*'<'*|*'>'*) git_state=off ;;
            *) is_exclude_pathspec_value "$token" && continue ;;
          esac
          ;;
      esac
      shell_words_append "$token"
    done
    [ -n "$pending_glob" ] && shell_words_append "$pending_glob"
    shell_words_print "$result"
  )
}

# Set env_exception_token to a literal shell token suitable for template
# classification, or return 1 and leave it unchanged. Fully quoted tokens
# without expansion syntax are safe to unwrap; partial quoting, double-quoted
# expansions, and tokens split at whitespace remain conservative.
env_exception_literal_shell_token() {
  literal_shell_token=$1
  literal_env_unquoted=0
  # A quoted word from shell_command_words may hold an operator or a newline,
  # which `eval` would run as a command boundary.
  case "$literal_shell_token" in
    *';'*|*'|'*|*'&'*|*"$SHELL_WORD_NL"*) return 1 ;;
  esac
  case "$literal_shell_token" in
    \'*\')
      literal_env_value=${literal_shell_token#\'}
      literal_env_value=${literal_env_value%\'}
      case "$literal_env_value" in *\'*) return 1 ;; esac
      ;;
    \"*\")
      literal_env_value=${literal_shell_token#\"}
      literal_env_value=${literal_env_value%\"}
      case "$literal_env_value" in
        *\"*|*\\*|*'$'*|*'`'*) return 1 ;;
      esac
      ;;
    *\'*|*\"*) return 1 ;;
    *)
      literal_env_value=$literal_shell_token
      literal_env_unquoted=1
      ;;
  esac

  # The exception candidate must remain literal even if a wrapper such as
  # `eval` performs another round of shell parsing. Apply this after unquoting,
  # not only to initially unquoted tokens: a single-quoted expansion is inert
  # for the first parse but becomes active when eval reinterprets it. Otherwise
  # a dynamic prefix can hide a denied read behind an allowed basename and the
  # whole token would be removed before the deny regex sees the protected path.
  case "$literal_env_value" in
    *\'*|*\"*|*'$'*|*'`'*|*\\*|*'*'*|*'?'*|*'['*|*']'*|*'{'*|*'}'*|\
    *'('*|*')'*|*'<'*|*'>'*) return 1 ;;
  esac

  # Only an initially unquoted `~/...` is normalized to the same path the shell
  # expands. Quoted tildes and account-lookup forms such as `~other/...` can
  # change meaning under another parse and therefore stay in the deny scan.
  case "$literal_env_value" in
    '~/'*) [ "$literal_env_unquoted" -eq 1 ] || return 1 ;;
    *'~'*) return 1 ;;
  esac
  case "$literal_env_value" in *[[:space:]]*) return 1 ;; esac
  env_exception_token=$literal_env_value
}

# A template *name* that is actually a symlink to a deny-listed secret is NOT
# stripped: mirroring the Read path (matches_deny_path), the token is resolved
# and kept when its target is itself deny-listed, so the whole-command deny gate
# still blocks it. A genuine template file resolves to a same-named target and
# is still stripped. When the command changes cwd once to a static directory, a
# relative token must pass this check from both the event workdir and that
# directory.
bash_env_exception_path_is_safe() {
  candidate_matches_deny "$1" && return 1
  env_exception_resolved=$(resolve_path "$1")
  [ "$env_exception_resolved" = "$1" ] || ! candidate_matches_deny "$env_exception_resolved"
}

# Drop tokens that name an allowed `.env` template (e.g. `.env.example`) before
# the whole-command deny regex runs, so `cat .env.example` is allowed while
# `cat .env.example .env` still blocks on the bare `.env` token. Globbing is
# disabled inside a subshell so a stray `*` in the command is not expanded
# against the real filesystem during word splitting.
bash_strip_allowed_tokens() {
  (
    set -f
    bash_relative_env_exception_safe=1
    bash_rebase_target=
    if bash_command_may_rebase_relative_paths "$1"; then
      bash_rebase_target=$(bash_command_rebase_target "$1") \
        || bash_relative_env_exception_safe=0
    fi
    shell_words_marker "$1"
    words=$(shell_command_words "$1") || { printf '%s' "$1"; exit 0; }
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    unset IFS
    result= shell_words_nl=
    for token in "$@"; do
      env_exception_token=
      env_exception_literal_shell_token "$token" 2>/dev/null || :
      if [ -n "$env_exception_token" ] \
        && candidate_has_default_env_exception "$env_exception_token"; then
        normalized=$(normalize_path "$env_exception_token")
        bash_rebased_token=
        case "$normalized" in
          /*) bash_env_token_context_safe=1 ;;
          *)
            bash_env_token_context_safe=$bash_relative_env_exception_safe
            [ -z "$bash_rebase_target" ] \
              || bash_rebased_token=$(normalize_path "$bash_rebase_target/$normalized")
            ;;
        esac
        if [ "$bash_env_token_context_safe" -eq 1 ] \
          && bash_env_exception_path_is_safe "$normalized" \
          && { [ -z "$bash_rebased_token" ] \
            || bash_env_exception_path_is_safe "$bash_rebased_token"; }; then
          continue
        fi
      fi
      shell_words_append "$token"
    done
    shell_words_print "$result"
  )
}

# Recognize only complete, static prose sinks. Do not trim punctuation on
# arbitrary shell fragments: they may be filenames or code re-read by eval,
# sh -c, or a pipeline. The normal path check still sees every other command.
bash_strip_source_module_prose() (
  set -f
  prose_original=$1
  if [ "$DENY_READ_PATHS_CUSTOM" -eq 1 ]; then
    printf '%s' "$prose_original"
    exit
  fi
  prose_records=$(git_command_records "$1")
  IFS='
'
  # shellcheck disable=SC2086
  set -- $prose_records
  prose_message=
  case "$#:${1-}:${2-}" in
    2:0echo:0*) prose_message=${2#0} ;;
    3:0printf:0%s|3:0printf:0%s\\n)
      case "$3" in 0*) prose_message=${3#0} ;; esac
      ;;
    4:0git:0commit)
      case "$3:$4" in
        0-m:0*|0--message:0*) prose_message=${4#0} ;;
      esac
      ;;
  esac
  # Require prose, not an option or a one-word path; dynamic/malformed records,
  # additional arguments and shell operators never match the shapes above.
  case "$prose_message" in
    -*) printf '%s' "$prose_original"; exit ;;
    *[' 	']*) ;;
    *) printf '%s' "$prose_original"; exit ;;
  esac
  # The sinks do not evaluate these, but later policy dequoting/ANSI-C decoding
  # does. Keep that existing conservative treatment rather than changing it.
  case "$prose_message" in
    *'$'*|*'\'*) printf '%s' "$prose_original"; exit ;;
  esac
  prose_words=$(printf '%s\n' "$prose_message" | LC_ALL=C awk '{
    for (i = 1; i <= NF; i++) print $i
  }')
  # shellcheck disable=SC2086
  set -- $prose_words
  prose_result=
  for prose_word in "$@"; do
    prose_candidate=$(printf '%s' "$prose_word" | LC_ALL=C awk '
      { sub(/^["\047`<(]+/, ""); sub(/["\047`>,;:)]+$/, ""); print }
    ')
    if candidate_is_env_source_module "$prose_candidate" \
      && bash_env_exception_path_is_safe "$(normalize_path "$prose_candidate")"; then
      continue
    fi
    prose_result="$prose_result $prose_word"
  done
  printf '%s' "$prose_result"
)

# Succeed when every PATH entry is absolute; an empty entry means the current
# directory, so a cd could change what a later command name runs.
path_entries_absolute() {
  case ":${PATH-}:" in *::*|*:[!/]*) return 1 ;; esac
}

# The commands message_value_records and search_operand_spans accept before a
# later command name, and literal_consumers_inert accepts as text consumers:
# none of them can rebind a name (no builtin that assigns, no loop variable)
# or write a file a PATH entry resolves it to. All three prepend
# AWK_INERT_COMMAND and pass the list and path_entries_absolute to awk as
# -v inert_names and -v cd_ok="1"; it holds no backslash, so -v escape
# processing leaves it unchanged. cd qualifies only while path_entries_absolute
# holds, and an awk program given neither variable finds no command inert.
INERT_SEGMENT_COMMANDS_ERE='^(grep|egrep|fgrep|ls|cat|head|tail|wc|cut|tr|echo|true|false|pwd|cd|jq|diff|comm|basename|dirname|date|sleep)$'
AWK_INERT_COMMAND='
    function inert_command(w) { return inert_names != "" && w ~ inert_names && (w != "cd" || cd_ok == "1") }'

# awk function message_value_records and literal_consumers_inert put before
# their program. plain_word(k, v) succeeds for a git_command_records word v of
# kind k that is literal, or whose expansions are bare parameter references:
# every word of a simple command is expanded before its name is looked up, and
# an expansion can assign (`${PWD:PATH=0}` evaluates PATH=0). zsh evaluates
# `$x[...]` as a subscript.
AWK_PLAIN_WORD='
    function plain_word(k, v) {
      if (k == "0") return 1
      if (k != "4" || v ~ /\$[A-Za-z_][A-Za-z0-9_]*\[/) return 0
      gsub(/\$\{[A-Za-z_][A-Za-z0-9_]*\}/, "", v)
      gsub(/\$[A-Za-z_][A-Za-z0-9_]*/, "", v)
      return v !~ /[$`]/
    }'

# awk functions prepended to programs that read git_command_records.
# record_separator is true for the record of an unquoted `;`, `&&`, `||` or
# `|`, which ends a simple command. A quoted operator is kind 4.
AWK_RECORD_SEPARATOR='
    function record_separator(r) { return r == "0;" || r == "0&&" || r == "0||" || r == "0|" }
    # The `&` of `2>&1` or `0<&3`: git_command_records emits it as a `3&`
    # right after the word that ends in the operator, and a backgrounding `&`
    # after that word as a second `3&`. prev is the record before r.
    function fd_dup_amp(r, prev) { return r == "3&" && prev ~ /[<>]$/ }'

# Print the record numbers (git_command_records) of message values the
# command sends as data: the subject and body of `orca orchestration
# send|reply|ask` (and the question of `ask`), the text options of `orca bot
# item set` (its `-file` twins and `--file` are not listed), the title and body of `gh pr|issue create|comment|edit` and
# `gh pr review`, and the message of `git commit`. These CLIs open no file the
# text names; their file-taking forms (--body-file, -F) are not listed. As in
# search_operand_spans, a segment qualifies only when it starts with the bare
# command name and every segment before it is an inert command without a
# redirection, so nothing earlier on the line can change what the name runs.
# Prints nothing when the line may hide a command (heredoc, group, eval).
message_value_records() {
  printf '%s\n' "$1" | LC_ALL=C awk -v cd_ok="$(path_entries_absolute && echo 1)" \
    -v inert_names="$INERT_SEGMENT_COMMANDS_ERE" "$AWK_PLAIN_WORD$AWK_RECORD_SEPARATOR$AWK_INERT_COMMAND"'
    function bail() { failed = 1; exit }
    # git commit operands are pathspecs it reads, so pair a message option
    # only through options known to take no separate value; `--` or anything
    # else ends the search.
    function git_flag(w) {
      return w ~ /^-[aqsvne]+$/ || w ~ /^--[a-z-]+=/ \
        || w ~ /^--(all|quiet|verbose|signoff|no-signoff|edit|no-edit|amend|allow-empty|allow-empty-message|only|include|dry-run|reset-author|status|no-status|no-gpg-sign|short|porcelain|long)$/
    }
    # A redirection may write a file a command name resolves to.
    function inert(   j) {
      if (kind[1] != "0" || !inert_command(word[1])) return 0
      for (j = 1; j <= n; j++) if (word[j] ~ /[<>]/) return 0
      return 1
    }
    function finish(bound,   j, w, opts, all, before) {
      if (n == 0) return
      all = 1
      for (j = 1; j <= n; j++) if (!plain_word(kind[j], word[j])) all = 0
      # The commands of a pipeline start together, so one piped after a
      # message command may replace it before it runs.
      if (pipe_target && !(all && inert())) bail()
      before = length(out)
      if (all && ok && kind[1] == "0") {
        if (word[1] == "orca" && word[2] == "orchestration" && word[3] ~ /^(send|reply)$/) opts = "|--subject|--body|"
        else if (word[1] == "orca" && word[2] == "orchestration" && word[3] == "ask") opts = "|--subject|--body|--question|"
        else if (word[1] == "orca" && word[2] == "bot" && word[3] == "item" && word[4] == "set") opts = "|--comment|--title|--description|--done-means|--note|--reason|--ask|--option|"
        else if (word[1] == "gh" && (word[2] ~ /^(pr|issue)$/ && word[3] ~ /^(create|comment|edit)$/ || word[2] == "pr" && word[3] == "review")) opts = "|-t|--title|-b|--body|"
        else if (word[1] == "git" && word[2] == "commit") opts = "|-m|--message|"
        for (j = (opts ~ /-m\|/ ? 3 : 2); opts != "" && j <= n; j++) {
          w = word[j]
          if (w == "--") break
          if (index(opts, "|" w "|") || opts ~ /-m\|/ && w ~ /^-[aqsvn]+m$/) {
            if (j + 1 <= n && substr(word[j + 1], 1, 1) != "-") out = out rec[j + 1] "\n"
            j++
            continue
          }
          if (opts ~ /-m\|/ && !git_flag(w)) break
        }
        if (opts != "") ok = 0
      }
      if (!all || !inert()) ok = 0
      pipe_target = bound == "0|" && (pipe_target || length(out) > before)
      n = 0
    }
    BEGIN { ok = 1; n = 0 }
    {
      prev = r; r = $0; k = substr(r, 1, 1); v = substr(r, 2)
      # A subshell or a process substitution (`<(`, `>(`, zsh `=(`) runs
      # before the command it sits in, so it can replace what the name runs.
      if (r ~ /^3[][(){}]$/ || k == "2") bail()
      if (k == "0" && v ~ /^(eval|alias|function|trap|source|\.)$/) bail()
      if (record_separator(r)) { finish(r); next }
      if (fd_dup_amp(r, prev)) next
      # A backgrounded command (or `|&`) runs alongside whatever follows.
      if (r == "3&") { finish(r); if (out != "") bail(); ok = 0; next }
      if (k == "3") { ok = 0; next }
      n++; kind[n] = k; word[n] = v; rec[n] = NR
    }
    END { if (!failed) { finish(""); printf "%s", out } }
  '
}

# Succeed when a command named git, gh or orca holds an unquoted glob
# character. The records show a glob word as a literal, but its expansion can
# add words (files named `--` or `-m`) and turn a message value into a
# pathspec. `^` and `#` are globs under zsh EXTENDED_GLOB.
message_command_has_glob() {
  MV_CMD=$1 LC_ALL=C awk 'BEGIN {
    s = ENVIRON["MV_CMD"]; n = length(s); q = 0; fw = ""; inw = 1; glob = 0
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (q == 1) { if (c == "\047") q = 0; else if (inw) fw = fw c; continue }
      if (q == 2) {
        if (c == "\"") q = 0
        else { if (c == "\\") c = substr(s, ++i, 1); if (inw) fw = fw c }
        continue
      }
      if (c == "\\") { c = substr(s, ++i, 1); if (c != "\n" && inw) fw = fw c; continue }
      if (c == "\047") { q = 1; started = 1; continue }
      if (c == "\"") { q = 2; started = 1; continue }
      if (c ~ /[;&|\n]/) {
        if (glob && fw ~ /^(git|gh|orca)$/) exit 0
        fw = ""; inw = 1; started = 0; glob = 0
        continue
      }
      if (c == " " || c == "\t") { if (started) inw = 0; continue }
      if (c ~ /[*?[^#]/) glob = 1
      if (inw) { fw = fw c; started = 1 }
    }
    exit !(glob && fw ~ /^(git|gh|orca)$/)
  }'
}

# Replace a whole lookup of the agent runner's own variables with `:` so the
# deny patterns do not read it as an environment dump. Two shapes qualify, each
# only when every word parses and the segment ends at a command boundary:
#   printenv NAME...   NAME is ORCA_* or CLAUDE_JOB_DIR and not secret-named;
#   env | grep PAT... PAT is a quoted anchored whole name (`^ORCA_X=`) and
#                      nothing else: a prefix or a regex prints other
#                      variables with their values, and a count or exit
#                      status still tells a guessed value apart. The grep must
#                      come first, so a filter cannot rewrite lines into the
#                      name; the rest are read-nothing filters (cut sort uniq
#                      head tail wc sed s///).
# Anything else, including file operands, redirects, `$`/backquote/`\` in a
# word, a second pipe branch or `&`, stays untouched and keeps matching. The
# PostToolUse redactor still hides a token-named variable such a lookup prints.
bash_strip_safe_env_lookups() {
  case "$1" in
    *env*) ;;
    *) printf '%s' "$1"; return 0 ;;
  esac
  EG_TEXT=$1 LC_ALL=C awk '
    function isterm(c) { return c == "" || index(" \t\n;|&)", c) > 0 }
    function skipsp(p) {
      while (substr(t, p, 1) == " " || substr(t, p, 1) == "\t") p++
      return p
    }
    function secretish(s) {
      return toupper(s) ~ /TOKEN|SECRET|PASS|CREDENTIAL|CAPAB|KEY|AUTH|COOKIE|SESSION|DSN|PIN|BEARER|PRIV|CERT|HASH|LOGIN/
    }
    # One shell word at p: sets wv (value), wk (u/s/d quoting) and wp (next).
    function word(p,   c, j, k, v) {
      c = substr(t, p, 1)
      if (c == "" || index(" \t\n;|&)", c)) return 0
      if (c == "\047") {
        j = index(substr(t, p + 1), "\047")
        if (!j) return 0
        v = substr(t, p + 1, j - 1)
        if (index(v, "\n")) return 0
        wv = v; wk = "s"; wp = p + j + 1
      } else if (c == "\"") {
        j = p + 1; v = ""
        while (1) {
          k = substr(t, j, 1)
          if (k == "") return 0
          if (k == "\"") break
          if (index("$`\\!\n", k)) return 0
          v = v k; j++
        }
        wv = v; wk = "d"; wp = j + 1
      } else {
        j = p; v = ""
        while (!isterm(substr(t, j, 1))) {
          k = substr(t, j, 1)
          if (!index(SAFE, k)) return 0
          v = v k; j++
        }
        wv = v; wk = "u"; wp = j
      }
      return isterm(substr(t, wp, 1))
    }
    function endok(p,   c, d) {
      p = skipsp(p); c = substr(t, p, 1); d = substr(t, p + 1, 1)
      return c == "" || c == "\n" || c == ";" || c == ")" || (c == "&" && d == "&") || (c == "|" && d == "|")
    }
    function grepok(   i, np, pat) {
      np = 0
      for (i = 1; i <= nargs; i++) {
        if (!np && ak[i] == "u" && substr(a[i], 1, 1) == "-") {
          if (a[i] !~ /^-[iEonceqwsxF]+$/) return 0
        } else {
          np++
          if (np > 1 || ak[i] == "u") return 0
          pat = a[i]
        }
      }
      # Only one whole variable name selects that variable alone. Anything
      # wider, a regex included, prints other variables with their values, and
      # even a count or an exit status tells a regex-guessed value apart.
      return np == 1 && exactname(pat)
    }
    function exactname(s) {
      return s ~ /^\^(ORCA_[A-Z0-9_]+|CLAUDE_JOB_DIR)=$/ && !secretish(s)
    }
    function cutok(   i, d, f) {
      # After the prefix grep the name must stay on the line: field 1 or a
      # character range that starts at 1. A later field or range would print a
      # value with its name cut off, which the output redactor cannot key on.
      for (i = 1; i <= nargs; i++) {
        if (a[i] ~ /^-d.$/) d++
        else if (a[i] == "-f1" || a[i] ~ /^-c1?-[0-9]+$/) f++
        else if (a[i] != "-s") return 0
      }
      return f == 1 && d <= 1
    }
    # tail -c would keep only the end of a line, a value without its name.
    function headok(name,   i, s, bytes) {
      bytes = name == "head" ? "[nc]" : "n"
      for (i = 1; i <= nargs; i++) {
        s = a[i]
        if (s ~ /^-[0-9]+$/ || s ~ ("^-" bytes "[0-9]+$")) continue
        if (s ~ ("^-" bytes "$") && a[i + 1] ~ /^[0-9]+$/) { i++; continue }
        return 0
      }
      return 1
    }
    function flagsok(re,   i) {
      for (i = 1; i <= nargs; i++) if (a[i] !~ re) return 0
      return 1
    }
    function sedok(   i, np, parts) {
      i = 1
      if (a[1] == "-E") i = 2
      if (nargs != i) return 0
      np = split(a[i], parts, "/")
      # The pattern must end in `=.*` and the replacement must be literal text
      # (no `&`, no backslash group reference): a group before the `=` could
      # still capture value text, so the sed may only delete a value.
      if (!(np == 4 && parts[1] == "s" && parts[2] ~ /=\.\*$/ && parts[3] !~ /[&\\]/ && parts[4] ~ /^[gIi]*$/)) return 0
      return 1
    }
    function stageok(name, pre,   i) {
      if (name == "grep" || name == "egrep") return grepok()
      if (pre) return 0
      if (name == "sed") return sedok()
      for (i = 1; i <= nargs; i++) if (ak[i] != "u") return 0
      if (name == "cut") return cutok()
      if (name == "head" || name == "tail") return headok(name)
      if (name == "sort") return flagsok("^-[urfnV]+$")
      if (name == "uniq") return flagsok("^-[cdu]$")
      if (name == "wc") return flagsok("^-[lwcm]+$")
      return 0
    }
    function envseg(p,   name, q, greps) {
      p = skipsp(p); greps = 0
      while (1) {
        if (substr(t, p, 1) != "|" || substr(t, p + 1, 1) == "|" || substr(t, p + 1, 1) == "&") return 0
        p = skipsp(p + 1)
        if (!word(p) || wk != "u") return 0
        name = wv; p = wp; nargs = 0
        while (1) {
          q = skipsp(p)
          if (word(q)) { nargs++; a[nargs] = wv; ak[nargs] = wk; p = wp; continue }
          if (!isterm(substr(t, q, 1))) return 0
          p = q
          break
        }
        if (!stageok(name, !greps)) return 0
        if (name == "grep" || name == "egrep") greps = 1
        p = skipsp(p)
        if (substr(t, p, 1) == "|" && substr(t, p + 1, 1) != "|") continue
        break
      }
      if (!greps || !endok(p)) return 0
      return p
    }
    function printenvseg(p,   q, n) {
      n = 0
      while (1) {
        q = skipsp(p)
        if (substr(t, q, 2) == "2>") {
          if (substr(t, q, 11) != "2>/dev/null" || !isterm(substr(t, q + 11, 1))) return 0
          p = q + 11
          break
        }
        if (!word(q)) {
          if (!isterm(substr(t, q, 1))) return 0
          p = q
          break
        }
        if (wk != "u" || wv !~ /^(ORCA_[A-Z0-9_]+|CLAUDE_JOB_DIR)$/ || secretish(wv)) return 0
        n++; p = wp
      }
      if (!n || !endok(p)) return 0
      return p
    }
    BEGIN {
      t = ENVIRON["EG_TEXT"]
      SAFE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_=,:./@%+-"
      n = length(t); out = ""; prev = ""; i = 1
      while (i <= n) {
        c = substr(t, i, 1); e = 0
        if ((prev == "" || index(";&|(`\n", prev)) && (c == "e" || c == "p")) {
          if (substr(t, i, 3) == "env" && isterm(substr(t, i + 3, 1))) e = envseg(i + 3)
          else if (substr(t, i, 8) == "printenv" && isterm(substr(t, i + 8, 1))) e = printenvseg(i + 8)
        }
        if (e) { out = out ":"; i = e; prev = ":"; continue }
        out = out c
        if (c != " " && c != "\t") prev = c
        i++
      }
      printf "%s", out
    }
  ' </dev/null
}

# Cheap gate for bash_join_quoted_words: 0 when that awk pass could change $1.
# The pass only rewrites a word that mixes quoted, escaped and plain parts, or
# a quoted word where a command starts. One plain command whose quotes each
# wrap a whole argument (`printf 'build passed'`, `grep "foo" src`) has
# neither, so it skips the awk run. Every doubtful shape answers 0;
# tests/unit-quoted-words.sh pins that a 1 here means the pass changes nothing.
bash_quoting_may_hide_name() {
  case "$1" in
    *[\'\"\\]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    # An escape, another command, a redirection, a group, an assignment or a
    # line break: a later word may start a command.
    *[\\\`\;\|\&\(\)\<\>\{\}\!=]*|*'
'*) return 0 ;;
    # A quote or a blank where the first command word starts.
    [\'\"[:space:]]*) return 0 ;;
    # A word that leaves the next word in command position.
    *sudo*|*command*|*builtin*|*exec*|*nohup*|*nice*|*time*|*then*|*do*|*else*|*elif*) return 0 ;;
    # A quote with text on both sides sits inside a word.
    *[![:space:]][\'\"][![:space:]]*) return 0 ;;
    # With both kinds present, one may be plain text inside the other.
    *\'*\"*|*\"*\'*) return 0 ;;
  esac
  # An odd count leaves the last quote open, and the pass closes it at the end
  # of the text, which can join it to the word before it.
  qh_rest=$1 qh_open=0
  while :; do
    case "$qh_rest" in
      *[\'\"]*) qh_rest=${qh_rest#*[\'\"]} qh_open=$((1 - qh_open)) ;;
      *) break ;;
    esac
  done
  return "$((1 - qh_open))"
}

# Print $1 with shell quote removal applied to the words whose quoting only
# hides a name from the deny patterns: a word split into several quoted,
# escaped or plain parts (`c'u'rl`, `"https"://`, `cu\rl`, `$'sec'urity`), and
# a quoted word where a command starts (`"security" dump-keychain`). The text
# of a `'...'` or `$'...'` part is kept as written (no ANSI-C decoding), a
# `"..."` part drops only the backslash before `$`, backquote, `"`, `\` and a
# newline, and an unquoted backslash keeps the character after it. Every other
# word stays exactly as written, so a quoted argument such as `"load the env"`,
# `'a|env|b'` or a JSON body is still read with its quotes. A word whose quoted
# or escaped text holds a blank, a newline or one of ; | & ( ) < > backquote
# also stays as written: removing those quotes would end the word where the
# shell does not. An unclosed quote runs to the end of the text, as if closed
# there (the shell refuses such a command, so reading it either way is safe).
# The deny patterns read this copy in addition to the text, never instead.
bash_join_quoted_words() {
  QJ_TEXT=$1 LC_ALL=C awk '
    function isdelim(ch) { return ch != "" && index(" \t\n;|&()<>`", ch) > 0 }
    function unsafe(seg) { return seg ~ /[ \t\n;|&()<>`]/ }
    BEGIN {
      t = ENVIRON["QJ_TEXT"]; n = length(t); out = ""; i = 1; cmdpos = 1
      while (i <= n) {
        c = substr(t, i, 1)
        if (isdelim(c)) {
          out = out c
          if (index("\n;|&(`", c)) cmdpos = 1
          i++
          continue
        }
        raw = ""; val = ""; parts = 0; quoted = 0; bad = 0; plain = 0
        while (i <= n) {
          c = substr(t, i, 1)
          if (isdelim(c)) break
          if (c == "\\") {
            d = substr(t, i + 1, 1)
            if (d == "") { raw = raw c; val = val c; i++; plain = 0; continue }
            raw = raw c d; quoted = 1; parts++; plain = 0; i += 2
            if (d == "\n") continue
            if (unsafe(d) || d == "\"" || d == "\047") bad = 1
            val = val d
            continue
          }
          q = c; start = i
          if (c == "$" && (substr(t, i + 1, 1) == "\047" || substr(t, i + 1, 1) == "\"")) {
            q = substr(t, i + 1, 1); i++
          }
          if (q == "\047") {
            j = index(substr(t, i + 1), "\047")
            if (j) { seg = substr(t, i + 1, j - 1); i += j + 1 }
            else { seg = substr(t, i + 1); i = n + 1 }
          } else if (q == "\"") {
            seg = ""; j = i + 1
            while (j <= n) {
              d = substr(t, j, 1)
              if (d == "\"") break
              if (d == "\\" && index("$`\"\\\n", substr(t, j + 1, 1))) {
                if (substr(t, j + 1, 1) != "\n") seg = seg substr(t, j + 1, 1)
                j += 2
                continue
              }
              seg = seg d; j++
            }
            i = j + 1
          } else {
            raw = raw c; val = val c; i++
            if (!plain) { parts++; plain = 1 }
            continue
          }
          raw = raw substr(t, start, i - start); val = val seg
          quoted = 1; parts++; plain = 0
          if (unsafe(seg)) bad = 1
        }
        out = out ((quoted && !bad && (parts > 1 || cmdpos)) ? val : raw)
        # An assignment, a reserved word or a wrapper keeps the next word in
        # command position.
        if (!(raw ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || val ~ /^(!|\{|then|do|else|elif|time|command|builtin|exec|nohup|nice|sudo)$/)) cmdpos = 0
      }
      printf "%s", out
    }
  ' </dev/null
}

MESSAGE_HEREDOC_PLACEHOLDER=agent_guard_heredoc_message

# Print $1 with every word of the form
#   "$(cat <<'EOF'
#   text
#   EOF
#   )"
# replaced by the single-quoted placeholder above, and fail unless at least one
# word was replaced and nothing else on the line is a substitution. With a
# quoted delimiter the body expands nothing, so the word is that text and
# runs nothing else. The proof is textual and holds for a shell that reads the
# here-document inside the substitution (bash 4 and later, zsh, dash, ksh)
# and for one that only matches quotes and parentheses to find where it ends
# (bash 3.2): the body may not hold `$`, a backslash or a double quote, each
# backquote or single quote must pair on its line around text with none of
# them or a parenthesis, the other parentheses of a line must balance, a line
# with `#` (a comment to such a scanner) may hold none of them, and no line
# may start with the delimiter (a `EOF)` that some shell might accept). Any
# other substitution, backquote, here-document or comment outside the words
# makes the whole line fail, and re-tokenizing must show that each word was
# one record that only the placeholder replaced.
message_heredoc_placeholders() (
  set -f
  mh_cmd=$1
  case "$mh_cmd" in *"$MESSAGE_HEREDOC_PLACEHOLDER"*) exit 1 ;; esac
  mh_new=$(MH_CMD=$mh_cmd MH_PH=$MESSAGE_HEREDOC_PLACEHOLDER LC_ALL=C awk '
    function inert(line, d,   x, k, j, ch, depth) {
      x = line; sub(/^[ \t]+/, "", x)
      if (substr(x, 1, length(d)) == d) return 0
      if (line ~ /[\\$"]/) return 0
      if (index(line, "#") && line ~ /[\047`()]/) return 0
      depth = 0
      for (k = 1; k <= length(line); k++) {
        ch = substr(line, k, 1)
        if (ch == "\047" || ch == "`") {
          j = index(substr(line, k + 1), ch)
          if (!j || substr(line, k + 1, j - 1) ~ /[\047`()]/) return 0
          k += j
        } else if (ch == "(") depth++
        else if (ch == ")" && --depth < 0) return 0
      }
      return depth == 0
    }
    # The index just past the closing quote of a safe word at i, or 0.
    function safe(i,   t, d, k, line, after) {
      t = substr(s, i + 1)
      if (!match(t, /^\$\([ \t]*cat[ \t]+<<[ \t]*\047[A-Za-z_][A-Za-z0-9_]*\047[ \t]*\n/)) return 0
      d = substr(t, 1, RLENGTH); sub(/^[^\047]*\047/, "", d); sub(/\047.*/, "", d)
      t = substr(t, RLENGTH + 1)
      while (1) {
        k = index(t, "\n")
        if (!k) return 0
        line = substr(t, 1, k - 1); t = substr(t, k + 1)
        if (line == d) break
        if (!inert(line, d)) return 0
      }
      if (!match(t, /^[ \t]*\)"/)) return 0
      after = substr(t, RLENGTH + 1, 1)
      if (after != "" && index(" \t\n;&|", after) == 0) return 0
      return n - length(t) + 1 + RLENGTH
    }
    BEGIN {
      s = ENVIRON["MH_CMD"]; ph = ENVIRON["MH_PH"]; n = length(s); out = ""; count = 0; i = 1
      while (i <= n) {
        c = substr(s, i, 1)
        if (c == "\047") {
          j = index(substr(s, i + 1), "\047")
          if (!j) exit 1
          out = out substr(s, i, j + 1); i += j + 1; continue
        }
        if (c == "\\") { out = out substr(s, i, 2); i += 2; continue }
        if (c == "\"") {
          p = i == 1 ? " " : substr(s, i - 1, 1)
          if ((p == " " || p == "\t") && (e = safe(i))) {
            out = out "\047" ph "\047"; count++; i = e; continue
          }
          for (j = i + 1; j <= n; j++) {
            d = substr(s, j, 1)
            if (d == "\\") { j++; continue }
            if (d == "`" || d == "$" && substr(s, j + 1, 1) == "(") exit 1
            if (d == "\"") break
          }
          if (j > n) exit 1
          out = out substr(s, i, j - i + 1); i = j + 1; continue
        }
        if (c == "`" || c == "#" || c == "$" && substr(s, i + 1, 1) == "(" || substr(s, i, 2) == "<<") exit 1
        out = out c; i++
      }
      if (!count) exit 1
      printf "%s", out
    }
  ' </dev/null) || exit 1
  MH_OLD=$(git_command_records "$mh_cmd") MH_NEW=$(git_command_records "$mh_new") \
    MH_PH=$MESSAGE_HEREDOC_PLACEHOLDER LC_ALL=C awk 'BEGIN {
      a = split(ENVIRON["MH_OLD"], old, "\n"); b = split(ENVIRON["MH_NEW"], new, "\n")
      if (a != b) exit 1
      for (k = 1; k <= a; k++) {
        if (old[k] == new[k]) continue
        if (new[k] != "0" ENVIRON["MH_PH"] || substr(old[k], 1, 3) != "4$(") exit 1
        changed++
      }
      exit !changed
    }' || exit 1
  printf '%s' "$mh_new"
)

# Replace each message value message_value_records finds, quotes included,
# with `_`. A value is replaced only when it is one quoted literal (single
# quotes, or double quotes holding no `$`, backquote or backslash) and
# re-tokenizing shows that it changed that record and nothing else. Leaving no
# quotes lets the deny-path check skip its dequoted pass.
#
# Any other substitution in a message value, or anywhere in the command,
# leaves the value in the scan (#409). The one exception is a value of the
# `"$(cat <<'EOF' ... EOF)"` shape that message_heredoc_placeholders proves is
# only its text: it is read as that literal, and only when every such word on
# the line turned out to be a message value; otherwise the whole line is
# handled as if none of them were literals.
bash_strip_message_values() (
  set -f
  mv_cmd=$1
  # Every message option starts with `-` and follows the command words.
  case "$mv_cmd" in *orca*orchestration*-*|*orca*bot*item*-*|*gh*-*|*git*commit*-*) ;; *) printf '%s' "$mv_cmd"; exit 0 ;; esac
  case "$mv_cmd" in
    *'"$('*cat*'<<'*)
      if mv_masked=$(message_heredoc_placeholders "$mv_cmd") \
        && mv_masked=$(bash_strip_literal_message_values "$mv_masked"); then
        case "$mv_masked" in
          *"$MESSAGE_HEREDOC_PLACEHOLDER"*) ;;
          *) printf '%s' "$mv_masked"; exit 0 ;;
        esac
      fi
      ;;
  esac
  bash_strip_literal_message_values "$mv_cmd"
)

bash_strip_literal_message_values() (
  set -f
  mv_cmd=$1
  if bash_command_sources_script "$mv_cmd"; then
    printf '%s' "$mv_cmd"
    exit 0
  fi
  mv_records=$(git_command_records "$mv_cmd")
  mv_targets=$(message_value_records "$mv_records")
  if [ -n "$mv_targets" ] && message_command_has_glob "$mv_cmd"; then
    printf '%s' "$mv_cmd"
    exit 0
  fi
  for mv_at in $mv_targets; do
    mv_expected=$(printf '%s\n' "$mv_records" | awk -v k="$mv_at" 'NR == k { print "0_"; next } { print }')
    mv_value=$(printf '%s\n' "$mv_records" | awk -v k="$mv_at" 'NR == k { print substr($0, 2) }')
    mv_try=1
    while [ "$mv_try" -le 20 ]; do
      mv_candidate=$(MV_CMD=$mv_cmd MV_VALUE=$mv_value LC_ALL=C awk -v want="$mv_try" 'BEGIN {
        s = ENVIRON["MV_CMD"]; v = ENVIRON["MV_VALUE"]; n = length(s); seen = 0
        for (i = 1; i <= n; i++) {
          q = substr(s, i, 1)
          if (q != "\047" && q != "\"") continue
          for (j = i + 1; j <= n && substr(s, j, 1) != q; j++) ;
          if (j > n) exit 1
          body = substr(s, i + 1, j - i - 1)
          flat = body; gsub(/\n/, " ", flat)
          if (flat == v && !(q == "\"" && body ~ /[$`\\]/) && ++seen == want) {
            printf "%s", substr(s, 1, i - 1) "_" substr(s, j + 1)
            exit 0
          }
          i = j
        }
        exit 1
      }') || break
      if [ "$(git_command_records "$mv_candidate")" = "$mv_expected" ]; then
        mv_cmd=$mv_candidate
        mv_records=$mv_expected
        break
      fi
      mv_try=$((mv_try + 1))
    done
  done
  printf '%s' "$mv_cmd"
)

# Print the start and end offsets of words in $1 that name no file the command
# reads: the search pattern of grep, egrep, fgrep and rg, and (as `O start end
# value`) the output path of an openssl key or certificate generator. A word
# qualifies only in a segment whose first word is that command and whose words
# up to it match the option tables below; an unknown option, an expansion, a
# glob, a redirection before it, or an option after an operand (GNU grep
# permutes, BSD grep reads it as a file) leaves the segment alone. The whole
# line is left alone when it may hide a segment boundary: a newline, a
# substitution, a here-document, a group or a comment. Segments after one
# whose command is not on the inert list below are left alone too. With
# `trusted` as $2, print instead the start offset of each jq or sed command
# word that same segment check reaches; there an expansion or unsafe word
# anywhere in an earlier segment also stops it. With `tracked` as $2, print
# instead (as `T start end value`) each literal operand of a command that
# opens the paths it is given (tracked_scan), under the same segment check.
# With `program` as $2, print the grep and rg pattern spans and, as
# `P kind start end value`, the program word of jq, sed, awk, an inline
# python, node, perl or ruby script and gh --jq (program_scan); there a gh
# query counts as an inert earlier segment, and a segment qualifies only
# when everything its pipeline feeds is a plain text filter (sink_ok).
search_operand_spans() {
  printf '%s\n' "$1" | LC_ALL=C awk -v grep_env="${GREP_OPTIONS-}" -v cd_ok="$(path_entries_absolute && echo 1)" -v mode="${2-}" \
    -v inert_names="$INERT_SEGMENT_COMMANDS_ERE" "$AWK_INERT_COMMAND"'
    function bail() { failed = 1; exit }
    function start_word() {
      if (inword) return
      inword = 1; wstart = i; val = ""; dyn = 0; uns = 0; red = 0
    }
    function flush_word() {
      if (!inword) return
      nw++; ws[nw] = wstart; we[nw] = i - 1; wv[nw] = val
      wdyn[nw] = dyn; wuns[nw] = uns; wred[nw] = red; wseg[nw] = nseg
      inword = 0
    }
    function bad(k) { return wdyn[k] || wuns[k] || wred[k] }
    function span(k) { return ws[k] " " we[k] "\n" }
    function grep_scan(a, b, rg,   k, v, j, ch, rest, sawe, opnd, dd, noconf, out, noarg, numarg, wordarg, longs, longv) {
      if (rg) {
        noarg = "iISsnNlcovwxFUuHLPazqbp0"; numarg = "ABCmjMd"; wordarg = "gtTEr"
        longs = "^--(hidden|no-ignore|no-ignore-vcs|no-ignore-dot|no-ignore-parent|ignore-case|smart-case|case-sensitive|line-number|no-line-number|count|count-matches|files-with-matches|files-without-match|only-matching|fixed-strings|word-regexp|line-regexp|invert-match|no-filename|with-filename|no-heading|heading|column|multiline|multiline-dotall|pcre2|follow|text|vimgrep|trim|no-messages|quiet|null|byte-offset|crlf|unrestricted|json|no-config)$"
        longv = "^--(glob|iglob|type|type-not|max-count|max-depth|context|after-context|before-context|color|colors|encoding|replace|sort|sortr|max-columns|threads|max-filesize)="
      } else {
        noarg = "EFGPHhilLnoqsvwxcrRaIUzZbTy"; numarg = "ABCm"; wordarg = "dD"
        longs = "^--(recursive|dereference-recursive|ignore-case|no-ignore-case|line-number|count|files-with-matches|files-without-match|only-matching|extended-regexp|fixed-strings|basic-regexp|perl-regexp|word-regexp|line-regexp|invert-match|no-filename|with-filename|quiet|silent|no-messages|null|null-data|text|byte-offset|initial-tab|color|colour)$"
        longv = "^--(include|exclude|exclude-dir|max-count|context|after-context|before-context|binary-files|label|devices|directories|color|colour)="
      }
      out = ""; sawe = 0; opnd = 0; dd = 0; noconf = 0
      for (k = a + 1; k <= b; k++) {
        v = wv[k]
        if (v == "--no-config" && !opnd && !dd) noconf = 1
        if (opnd) {
          if (!dd && substr(v, 1, 1) == "-") return ""
          continue
        }
        if (bad(k)) return ""
        if (dd || v == "-" || substr(v, 1, 1) != "-") {
          if (!sawe) out = out span(k)
          opnd = 1
          continue
        }
        if (v == "--") { dd = 1; continue }
        if (substr(v, 1, 2) == "--") {
          if (v == "--regexp") {
            if (++k > b || bad(k)) return ""
            out = out span(k); sawe = 1; continue
          }
          if (v ~ /^--regexp=/) { out = out span(k); sawe = 1; continue }
          if (v ~ longs || v ~ longv) continue
          return ""
        }
        for (j = 2; j <= length(v); j++) {
          ch = substr(v, j, 1); rest = substr(v, j + 1)
          if (index(noarg, ch)) continue
          if (ch == "e") {
            if (rest == "") { if (++k > b || bad(k)) return "" }
            out = out span(k); sawe = 1; break
          }
          if (index(numarg, ch)) {
            if (rest == "") { if (++k > b || bad(k)) return ""; rest = wv[k] }
            if (rest !~ /^[0-9]+$/) return ""
            break
          }
          if (index(wordarg, ch)) {
            if (rest == "" && (++k > b || bad(k))) return ""
            break
          }
          return ""
        }
      }
      # Options from the environment come before these words and can turn the
      # pattern into a file: a ripgrep config file unless --no-config is
      # given, and GREP_OPTIONS, which BSD grep still reads.
      if (rg ? !noconf : grep_env != "") return ""
      return out
    }
    # A value moved off its option by a valueless one before it would be a
    # stray operand, which these subcommands reject before writing anything.
    function openssl_scan(a, b,   k, out) {
      if (a + 1 > b || wv[a + 1] !~ /^(req|genrsa|genpkey|ecparam)$/ || bad(a + 1)) return ""
      out = ""
      for (k = a + 2; k < b; k++)
        if ((wv[k] == "-out" || wv[k] == "-keyout") && !bad(k) && !bad(k + 1) \
            && substr(wv[k + 1], 1, 1) != "-" && wv[k + 1] != "") {
          out = out "O " ws[k + 1] " " we[k + 1] " " wv[k + 1] "\n"
          k++
        }
      return out
    }
    # The operand words of a command that reads the paths it is given from
    # the directory it runs in: no remote host, container or archive, no name
    # pattern applied to another directory, no wrapped command. git is not
    # one: its operands also select revisions, the index and pathspec
    # wildcards, so it can show bytes the work tree does not hold. Every word
    # of the segment must be literal (a lone `&` or a redirection hides
    # another command or a write), and every option must be on the short
    # table below: none of them takes a name filter or a list of files as
    # its value (`grep --include`, `sort --files0-from`, `grep -f`), so a word
    # that is not an option is either a path the command opens or a value it
    # never opens.
    function tracked_scan(a, b,   k, v, h, opts, out) {
      h = wv[a]
      # Each of these opens every operand it is given, for reading, and no
      # other file because of one: diff and comm pair an operand with a
      # same-named file in a directory operand, uniq writes its second
      # operand, a pager or `tail -f` reopens a name later, and the script
      # word of sed or jq is program text that can name another file
      # (`sed r.env`), not a path.
      if (h == "cat") opts = "^-[AbeEnstTuv]+$"
      else if (h == "head" || h == "tail") opts = "^-([0-9]+|[nc]|[nc][+-]?[0-9]+|[qv]+)$"
      else if (h == "wc") opts = "^-[clmwL]+$"
      else if (h == "cut") opts = "^-[dfcbsz]"
      else if (h == "sort") opts = "^-[bdfgiMhnRrVsuz]+$"
      else if (h ~ /^(grep|egrep|fgrep)$/) opts = "^-([EFGPHhilLnoqsvwxcaIzZbTy]+|[ABCm][0-9]*|e)$"
      else if (h ~ /^(nl|tac|stat|file)$/) opts = "^$"
      else return ""
      out = ""
      for (k = a + 1; k <= b; k++) {
        v = wv[k]
        if (bad(k)) return ""
        if (v == "--") continue
        if (substr(v, 1, 1) == "-") { if (v !~ opts) return ""; continue }
        # `tail +1f` is the old spelling of -n +1 -f.
        if (substr(v, 1, 1) == "+") return ""
        if (v != "") out = out "T " ws[k] " " we[k] " " v "\n"
      }
      return out
    }
    # Program mode. A word that a known tool reads as program text, never as
    # a path: `P kind start end value`. Every word of the segment must be
    # literal, and the options before the program word must be ones this
    # table knows, so no option can take that word as its value or turn it
    # into a file operand (-f).
    function pline(kind, j) { return "P " kind " " ws[pw[j]] " " we[pw[j]] " " wv[pw[j]] "\n" }
    # pw[1..pn] are the words of the segment, the command name first, without
    # the redirections that name no file (`2>&1`, `2>/dev/null`). Any other
    # redirection or non-literal word gives the segment up: a `<` word would
    # shift which word is the program.
    function program_scan(a, b,   k, j, v, h, out, sawe, script, prev, wasi) {
      pn = 0
      for (k = a; k <= b; k++) {
        if (wv[k] ~ /^(2>&1|[12]?>\/dev\/null)$/ && !wdyn[k] && k > a) continue
        if (bad(k)) return ""
        pw[++pn] = k
      }
      h = wv[a]
      # The command name as written, with no quoting or escape in it.
      if (we[a] - ws[a] + 1 != length(h)) return ""
      if (h == "jq") {
        if (nojq) return ""
        for (j = 2; j <= pn; j++) if (wv[pw[j]] ~ /^-[A-Za-z]*f/ || wv[pw[j]] == "--from-file") return ""
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v ~ /^--(arg|argjson|slurpfile|rawfile)$/) { j += 2; continue }
          if (v == "--indent" || v == "-L") { j++; continue }
          if (v ~ /^-[nRscrjaSCMe]+$/ || v ~ /^--(null-input|raw-input|slurp|compact-output|raw-output|raw-output0|join-output|ascii-output|sort-keys|color-output|monochrome-output|tab|unbuffered|exit-status|stream|stream-errors|seq|args|jsonargs)$/) continue
          if (substr(v, 1, 1) == "-") return ""
          return pline("jq", j)
        }
        return ""
      }
      if (h == "sed") {
        out = ""; sawe = 0; script = 0; wasi = 0
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v == "--expression" || v ~ /^-[nErsuz]*e$/) {
            if (++j > pn) return ""
            out = out pline("sed", j); sawe = 1; wasi = 0
            continue
          }
          # -i may take the next word as its suffix (BSD): an empty one is
          # that suffix under BSD and an empty script under GNU, never a file.
          if (v ~ /^-[nErsuz]*i/ || v == "--in-place" || v ~ /^--in-place=/) { wasi = 1; continue }
          if (v == "" && wasi) { wasi = 0; continue }
          wasi = 0
          if (v ~ /^-[nErsuz]+$/ || v ~ /^--(quiet|silent|regexp-extended|separate|unbuffered|null-data|posix)$/) continue
          if (substr(v, 1, 1) == "-") return ""
          if (!script) script = j
        }
        if (sawe) return out
        return script ? pline("sed", script) : ""
      }
      if (h ~ /^(awk|gawk|mawk)$/) {
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v == "-F" || v == "-v") { j++; continue }
          if (v ~ /^-F./ || v ~ /^-v[A-Za-z_]/) continue
          if (substr(v, 1, 1) == "-") return ""
          return pline("awk", j)
        }
        return ""
      }
      if (h ~ /^python(3(\.[0-9]+)?)?$/) {
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v ~ /^-[bBdEIOqsSuvx]*c$/) return j < pn ? pline("py", j + 1) : ""
          if (v !~ /^-[bBdEIOqsSuvx]+$/) return ""
        }
        return ""
      }
      if (h ~ /^(node|nodejs)$/)
        return pn >= 3 && wv[pw[2]] ~ /^(-e|--eval|-p|--print|-pe)$/ ? pline("js", 3) : ""
      if (h == "perl") {
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v ~ /^-[lnpaw0-9]*[eE]$/) return j < pn ? pline("pl", j + 1) : ""
          if (v !~ /^-(l|n|p|a|w|0[0-7]*)$/) return ""
        }
        return ""
      }
      if (h == "ruby") {
        for (j = 2; j <= pn; j++) {
          v = wv[pw[j]]
          if (v ~ /^-[nplaw]*e$/) return j < pn ? pline("rb", j + 1) : ""
          if (v !~ /^-(n|p|l|a|w)$/) return ""
        }
        return ""
      }
      if (h == "gh" && !nojq && (k = gh_jq_option(a, b))) return "P jq " ws[k + 1] " " we[k + 1] " " wv[k + 1] "\n"
      return ""
    }
    # The index of the --jq word of a built-in gh query when it is that
    # option for sure, as in bash_neutralize_first_pipeline: every word
    # literal, no `--` before it, and the word before it no option that could
    # take --jq as its value. Its value, the next word, is a jq filter gh
    # runs itself. 0 otherwise.
    function gh_jq_option(a, b,   k, prev) {
      if (!gh_query(a, b, 1)) return 0
      for (k = a + 2; k < b; k++) {
        if (wv[k] == "--") return 0
        if (wv[k] != "--jq") continue
        prev = wv[k - 1]
        if (substr(prev, 1, 1) == "-" && prev !~ /^(--paginate|--slurp|--include|-i|--silent|--verbose)$/) return 0
        return k
      }
      return 0
    }
    # A gh subcommand that only queries: it writes no file and changes no
    # shell state, and gh accepts no alias or extension named after a
    # built-in. With jq set, the built-ins that take --jq instead.
    function gh_query(a, b, jq,   k, sub1) {
      if (wv[a] != "gh" || a + 1 > b) return 0
      for (k = a; k <= b; k++) if (bad(k)) return 0
      sub1 = wv[a + 1]
      if (sub1 != "api") sub1 = sub1 " " (a + 2 <= b ? wv[a + 2] : "")
      if (jq) return sub1 ~ /^(api|run view|run list|pr view|pr list|pr checks|pr status|issue view|issue list|issue status|release view|release list|repo view|repo list)$/
      return sub1 ~ /^(api|run view|run list|run watch|pr view|pr list|pr checks|pr diff|pr status|issue view|issue list|issue status)$/
    }
    function git_lists_files(a, b,   k) {
      if (wv[a] != "git" || a + 1 > b || wv[a + 1] != "ls-files") return 0
      for (k = a; k <= b; k++) if (bad(k)) return 0
      return 1
    }
    # Program text can reach the output (a string a jq filter prints, the
    # matched text of grep -o), so every command its pipeline feeds must be a
    # plain text filter: none that runs or opens what it reads (sh, xargs, a
    # pager with shell escapes).
    function sink_ok(k,   j, f, g) {
      for (j = wseg[k]; segpipe[j]; j++) {
        if (!((j + 1) in segfirst)) return 0
        f = segfirst[j + 1]
        if (bad(f)) return 0
        if (wv[f] == "sed") {
          # sed can run what it reads (the e command and flag); a line print cannot.
          for (g = f; g < nw && wseg[g + 1] == wseg[f]; g++) ;
          if (!sed_prints_lines(f, g)) return 0
        } else if (wv[f] !~ /^(wc|head|tail|sort|uniq|tr|cut|nl|grep|egrep|fgrep|column|cat|jq)$/) return 0
        # A long option or sort -o can make a filter open a list of files it
        # reads (--files0-from) or write one; every word must be literal.
        for (g = f; g <= nw && wseg[g] == wseg[f]; g++)
          if (bad(g) || substr(wv[g], 1, 2) == "--" || wv[f] == "sort" && wv[g] ~ /^-[A-Za-z]*o/) return 0
      }
      return 1
    }
    # `sed -n 1,50p file` only prints lines: with nothing but these flags
    # (GNU sed reads an option after the script too, so -i, -f or a second
    # script anywhere disqualifies it) and a line-number script, given as the
    # first operand or by one -e, it writes no file and runs nothing, so it
    # cannot rebind the name of a later command.
    function sed_prints_lines(a, b,   k, script) {
      script = 0
      for (k = a + 1; k <= b; k++) {
        if (bad(k)) return 0
        if (wv[k] ~ /^-[nErsuz]+$/) continue
        if (wv[k] == "-e" && !script && k < b) {
          k++
          if (bad(k) || wv[k] !~ /^([0-9]+|\$)(,([0-9]+|\$|[+~][0-9]+))?[pd]$/) return 0
          script = 1
          continue
        }
        if (substr(wv[k], 1, 1) == "-") return 0
        if (!script) {
          if (wv[k] !~ /^([0-9]+|\$)(,([0-9]+|\$|[+~][0-9]+))?[pd]$/) return 0
          script = 1
        }
      }
      return script
    }
    BEGIN { safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./:@%+,=-" }
    NR > 1 { bail() }
    {
      s = $0; n = length(s); q = ""; nseg = 1
      if (index(s, "`") || index(s, "$(") || index(s, "<<") || index(s, "<(") || index(s, ">(")) bail()
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (q == "s") { if (c == "\047") q = ""; else val = val c; continue }
        if (q == "d") {
          if (c == "\"") { q = ""; continue }
          if (c == "\\" && i < n && index("$`\"\\", substr(s, i + 1, 1))) { i++; val = val substr(s, i, 1); continue }
          if (c == "$") dyn = 1
          val = val c
          continue
        }
        if (c == " " || c == "\t") { flush_word(); continue }
        if (c == ";" || c == "|" || c == "&" && substr(s, i + 1, 1) == "&") {
          flush_word()
          segpipe[nseg] = (c == "|" && substr(s, i + 1, 1) != "|")
          nseg++
          if (c != ";" && substr(s, i + 1, 1) == c) i++
          continue
        }
        # A lone `&` stays in a word: the next command then starts no segment
        # of its own and is not parsed, which only keeps its text in the scan.
        if (index("(){}", c) || c == "#" && !inword) bail()
        start_word()
        if (c == "\\") {
          if (i == n) bail()
          i++; val = val substr(s, i, 1)
          continue
        }
        if (c == "\047") { q = "s"; continue }
        if (c == "\"") { q = "d"; continue }
        if (c == "<" || c == ">" || c == "&") red = 1
        if (c == "$") dyn = 1
        if (!index(safe, c) || c == "=" && i == wstart) uns = 1
        val = val c
      }
      if (q != "") bail()
      flush_word()
    }
    END {
      if (failed) exit 1
      # Tracked mode reads one command only: the first on the line, or the
      # one right after a leading `cd DIR`. A loop, a condition or any other
      # earlier command could run the cd or the read more than once, or wait
      # between the check and the read.
      if (mode == "tracked") {
        if (nw == 0) exit 0
        # An expansion anywhere on the line can reuse the operand under
        # another name (`cat /repo/a.env; cat $_.local`).
        for (r = 1; r <= nw; r++) if (wdyn[r]) exit 0
        for (e = 1; e < nw && wseg[e + 1] == wseg[1]; e++) ;
        k = 1
        if (wv[1] == "cd" && e == 2 && !bad(1) && !bad(2) && cd_ok == "1" && e < nw) {
          k = 3
          for (e = k; e < nw && wseg[e + 1] == wseg[k]; e++) ;
        }
        # What the pipeline of the reader feeds runs at the same time as the
        # reader, so it must be a plain text filter that cannot touch the
        # file before the reader opens it.
        for (j = wseg[k]; segpipe[j]; j++) {
          f = 0
          for (r = 1; r <= nw; r++) {
            if (wseg[r] != j + 1) continue
            if (!f) { f = r; if (wv[r] !~ /^(wc|head|tail|sort|tr|cut|nl|grep|egrep|fgrep|column|cat)$/) exit 0 }
            if (bad(r) || substr(wv[r], 1, 2) == "--" || wv[f] == "sort" && wv[r] ~ /^-[A-Za-z]*o/) exit 0
          }
          if (!f) exit 0
        }
        if (!bad(k)) printf "%s", tracked_scan(k, e)
        exit 0
      }
      for (k = 1; k <= nw; k++) if (!(wseg[k] in segfirst)) segfirst[wseg[k]] = k
      # As in bash_neutralize_first_pipeline, a word that holds "jq" anywhere
      # but at a command start may run or redefine jq, unless it is the
      # certain --jq option of a gh query: then no jq filter is rewritten.
      if (mode == "program") for (k = 1; k <= nw; k = e + 1) {
        for (e = k; e < nw && wseg[e + 1] == wseg[k]; e++) ;
        c = wv[k] == "gh" ? gh_jq_option(k, e) : 0
        for (r = k + 1; r <= e; r++) if (wv[r] ~ /jq/ && r != c) nojq = 1
      }
      for (k = 1; k <= nw; k = e + 1) {
        for (e = k; e < nw && wseg[e + 1] == wseg[k]; e++) ;
        if (!bad(k)) {
          if (mode == "trusted") { if (wv[k] ~ /^(jq|sed)$/) print ws[k] }
          else if (mode == "program") {
            if (sink_ok(k)) {
              if (wv[k] ~ /^(grep|egrep|fgrep)$/) printf "%s", grep_scan(k, e, 0)
              else if (wv[k] == "rg") printf "%s", grep_scan(k, e, 1)
              else printf "%s", program_scan(k, e)
            }
          }
          # A pattern selects the lines a later command receives, so what the
          # pipeline feeds must be a plain text filter here too: `xargs cat`
          # would open the names the pattern picked.
          else if (wv[k] ~ /^(grep|egrep|fgrep)$/) { if (sink_ok(k)) printf "%s", grep_scan(k, e, 0) }
          else if (wv[k] == "rg") { if (sink_ok(k)) printf "%s", grep_scan(k, e, 1) }
          else if (wv[k] == "openssl") printf "%s", openssl_scan(k, e)
        }
        # A later command name means what it says only while every segment
        # before it is a command that cannot change how this shell looks up
        # names: any builtin (`hash`, `read PATH`, `printf -v`, `command
        # export`) or loop variable might rebind it, and a command or
        # redirection that writes files might create or replace the file a
        # PATH entry resolves it to, so list the inert ones.
        for (r = k; r <= e; r++) if (wred[r] || mode == "trusted" && bad(r)) exit 0
        for (h = k; h <= e && wv[h] ~ /^(do|then|else|elif|if|while|until|done|fi|!)$/ && !bad(h); h++) ;
        for (a = h; h <= e && wv[h] ~ /^[A-Za-z_][A-Za-z0-9_]*=/ && !bad(h); h++) ;
        if (h > e) { if (a > e) continue; exit 0 }
        if (bad(h)) exit 0
        if (wv[h] == "for" && h + 2 <= e && wv[h + 1] ~ /^[a-z]$/ && wv[h + 2] == "in") continue
        # rg runs programs (--pre, --hostname-bin, RIPGREP_CONFIG_PATH), test
        # and [ evaluate array subscripts, the zsh stat builtin assigns arrays
        # (`stat -A path`), and an assignment prefix such as
        # LD_PRELOAD can make any listed command run code; a locale name
        # without a path loads no code.
        for (r = a; r < h; r++) if (wv[r] !~ /^(LC_[A-Z]+|LANG|LANGUAGE|TZ)=[A-Za-z0-9_.@:+-]*$/) exit 0
        if (wv[h] == "sed" && sed_prints_lines(h, e)) continue
        # A gh query that feeds a pipe runs in a subshell and writes no file,
        # so it cannot change what the next command name runs. Sequenced with
        # `;` or `&&` it stays outside the inert list, as before.
        if (mode == "program" && a == h && segpipe[wseg[k]] && gh_query(h, e, 0)) continue
        # So does `git ls-files` that feeds a pipe: it prints the names of
        # tracked files and opens none of them.
        if (a == h && segpipe[wseg[k]] && git_lists_files(h, e)) continue
        if (!inert_command(wv[h])) exit 0
        # In program mode a loop or condition could run a cd more than once,
        # and `cd old new` goes elsewhere in zsh and ksh: the directory the
        # program reads relative names from must be certain.
        if (mode == "program" && (wv[k] ~ /^(do|then|else|elif|if|while|until|done|fi|for|!)$/ || wv[h] == "cd" && e - h != 1)) exit 0
      }
    }
  '
}

# Replace the words search_operand_spans finds with `_`, keeping every other
# byte, so the later passes still see each file operand, option value and
# redirection exactly as written. An output path is replaced only while
# nothing exists there, from the event workdir and from the one static
# directory the command may change to: overwriting a protected file stays
# blocked.
bash_strip_non_read_operands() (
  set -f
  sn_cmd=$1
  sn_spans=$(search_operand_spans "$sn_cmd") && [ -n "$sn_spans" ] || {
    printf '%s' "$sn_cmd"
    exit 0
  }
  sn_rebase_known=1 sn_rebase=
  case "$sn_spans" in
    O*|*'
O'*)
      if bash_command_may_rebase_relative_paths "$sn_cmd"; then
        sn_rebase=$(bash_command_rebase_target "$sn_cmd") || sn_rebase_known=0
      fi
      ;;
  esac
  sn_keep=
  sn_ifs=$IFS
  IFS='
'
  for sn_span in $sn_spans; do
    IFS=$sn_ifs
    case "$sn_span" in
      'O '*)
        sn_rest=${sn_span#O }
        sn_start=${sn_rest%% *}; sn_rest=${sn_rest#* }
        sn_end=${sn_rest%% *}; sn_path=${sn_rest#* }
        case "$sn_path" in
          /*) set -- "$sn_path" ;;
          *)
            [ "$sn_rebase_known" -eq 1 ] || continue
            set -- "$sn_path"
            [ -z "$sn_rebase" ] || set -- "$sn_path" "$sn_rebase/$sn_path"
            ;;
        esac
        sn_new=1
        for sn_target in "$@"; do
          if [ -e "$sn_target" ] || [ -L "$sn_target" ]; then sn_new=0; fi
        done
        [ "$sn_new" -eq 1 ] || continue
        sn_keep="$sn_keep $sn_start $sn_end"
        ;;
      *) sn_keep="$sn_keep $sn_span" ;;
    esac
  done
  IFS=$sn_ifs
  printf '%s\n' "$sn_cmd" | LC_ALL=C awk -v spans="$sn_keep" '
    {
      m = split(spans, p, " "); out = ""; at = 1
      for (k = 1; k < m; k += 2) {
        out = out substr($0, at, p[k] - at) "_"
        at = p[k + 1] + 1
      }
      printf "%s", out substr($0, at)
    }'
)

# Print $1, a jq filter, with the names of the field chains rooted at `.`
# removed: `.data.key` becomes `.`, and `env.X` becomes `env`. `$x.y` keeps
# its names, and so do strings (an import or include path names a file jq
# reads) and a comment.
jq_filter_without_field_names() {
  JQ_FILTER=$1 LC_ALL=C awk '
    # t[k] opens a string; return the index of its closing quote, or 0.
    function skipstr(t, k,   m, c, e) {
      m = length(t)
      for (k++; k <= m; k++) {
        c = substr(t, k, 1)
        if (c == "\"") return k
        if (c == "\\") {
          if (substr(t, k + 1, 1) == "(") {
            e = matchparen(t, k + 2)
            if (!e) return 0
            k = e
            continue
          }
          k++
        }
      }
      return 0
    }
    # k is just past a "("; return the index of the matching ")", or 0. A
    # comment can hide a ")" up to its line end, so it returns 0 too.
    function matchparen(t, k,   m, c, d, e) {
      m = length(t); d = 1
      for (; k <= m; k++) {
        c = substr(t, k, 1)
        if (c == "#") return 0
        if (c == "\"") {
          e = skipstr(t, k)
          if (!e) return 0
          k = e
          continue
        }
        if (c == "(") d++
        else if (c == ")" && --d == 0) return k
      }
      return 0
    }
    # The text of a string is a literal (an import path names a file), but the
    # code of a "\( )" interpolation in it is a filter like any other.
    function strip(t,   out, n, i, c, j, e, chain) {
      out = ""; n = length(t); chain = 0
      for (i = 1; i <= n; i++) {
        c = substr(t, i, 1)
        if (c == "#") { out = out substr(t, i); break }
        if (c == "\"") {
          out = out c
          for (j = i + 1; j <= n && substr(t, j, 1) != "\""; j++) {
            if (substr(t, j, 1) == "\\") {
              if (substr(t, j + 1, 1) == "(") {
                e = matchparen(t, j + 2)
                if (!e) return t
                out = out "\\(" strip(substr(t, j + 2, e - j - 2)) ")"
                j = e
                continue
              }
              out = out substr(t, j, 2)
              j++
              continue
            }
            out = out substr(t, j, 1)
          }
          out = out substr(t, j, 1)
          i = j
          chain = 0
          continue
        }
        # The builtin env object: its member names are environment variables.
        if (substr(t, i, 4) == "env." && substr(t, i + 4, 1) ~ /[A-Za-z_]/ \
            && (i == 1 || substr(t, i - 1, 1) !~ /[A-Za-z0-9_$.]/)) {
          out = out "env"
          i += 2
          chain = 1
          continue
        }
        if (c == "." && substr(t, i + 1, 1) ~ /[A-Za-z_]/ \
            && (chain || i == 1 || substr(t, i - 1, 1) !~ /[A-Za-z0-9_$.]/)) {
          if (!chain) out = out "."
          for (i++; i <= n && substr(t, i, 1) ~ /[A-Za-z0-9_]/; i++) ;
          i--
          chain = 1
          continue
        }
        chain = 0
        out = out c
      }
      return out
    }
    BEGIN { printf "%s", strip(ENVIRON["JQ_FILTER"]) }'
}

# Print $1, a sed script, with the regex of each s command and each `/re/`
# address removed: `s/^a\t[^\t]*//g` becomes `s///g` and `/x/,+5p` becomes
# `//,+5p`. sed never opens a file its regex names. Fail unless the script is
# only commands joined by `;`, each an optional line or `/re/` address (or a
# range of them) and then an s command whose flags neither write (w) nor run
# (e) anything, or one of p, d, = and q. A delimiter or `\]` inside a bracket
# expression also fails, since GNU and BSD sed may end such a regex at
# different places, and so may a newline.
sed_script_without_regex() {
  SED_SCRIPT=$1 LC_ALL=C awk '
  # t[i] opens a regex delimited by d; move i to its closing delimiter.
  function skip_re(d,   c, j, k, e) {
    for (i++; i <= n && (c = substr(t, i, 1)) != d; i++) {
      if (c == "\n") exit 1
      if (c == "\\") { i++; if (substr(t, i, 1) == "\n") exit 1; continue }
      if (c != "[") continue
      j = i + 1
      if (substr(t, j, 1) == "^") j++
      if (substr(t, j, 1) == "]") j++
      for (; j <= n && (c = substr(t, j, 1)) != "]"; j++) {
        if (c == d || c == "\n" || substr(t, j, 2) == "\\]") exit 1
        if (c == "[" && (k = index(":.=", substr(t, j + 1, 1)))) {
          e = index(substr(t, j + 2), substr(":.=", k, 1) "]")
          if (e == 0 || index(substr(t, j + 2, e - 1), d)) exit 1
          j += e + 2
        }
      }
      if (j > n) exit 1
      i = j
    }
    if (i > n) exit 1
  }
  # Copy one address at t[i] to out: a line number, `$`, or `/re/` without
  # its regex; with second set, also `+N` and `~N`. Return 0 when none is there.
  function address(second,   c) {
    c = substr(t, i, 1)
    if (c == "/") { skip_re("/"); out = out "//"; i++; return 1 }
    if (c == "$") { out = out c; i++; return 1 }
    if (second && (c == "+" || c == "~")) { out = out c; i++; c = substr(t, i, 1) }
    if (c !~ /[0-9]/) return 0
    for (; i <= n && substr(t, i, 1) ~ /[0-9]/; i++) out = out substr(t, i, 1)
    return 1
  }
  BEGIN {
    t = ENVIRON["SED_SCRIPT"]; n = length(t); i = 1; out = ""
    while (1) {
      while (i <= n && substr(t, i, 1) == " ") i++
      if (i > n) break
      if (address(0) && substr(t, i, 1) == ",") {
        out = out ","; i++
        if (!address(1)) exit 1
      }
      c = substr(t, i, 1)
      if (c != "" && index("pd=q", c)) {
        out = out c; i++
      } else {
        d = substr(t, i + 1, 1)
        if (c != "s" || d == "" || index("/|#,:@!%", d) == 0) exit 1
        i++
        skip_re(d)
        out = out "s" d d
        for (i++; i <= n && (c = substr(t, i, 1)) != d; i++) {
          if (c == "\n") exit 1
          if (c == "\\") { out = out c; i++; c = substr(t, i, 1); if (c == "\n") exit 1 }
          out = out c
        }
        if (i > n) exit 1
        out = out d
        for (i++; i <= n && substr(t, i, 1) ~ /[gpIiMm0-9]/; i++) out = out substr(t, i, 1)
      }
      while (i <= n && substr(t, i, 1) == " ") i++
      if (i > n) break
      if (substr(t, i, 1) != ";") exit 1
      out = out ";"
      i++
    }
    printf "%s", out
  }'
}

# A jq filter is program text: `select(.key|test("x"))` names a field, not a
# `*.key` file, and jq opens no file the filter names. Drop field names from
# the filter of each jq at a command start of the first pipeline. Only that
# pipeline qualifies: an element left of jq runs in a subshell and one right of
# it (the current shell in zsh or under lastpipe) starts after jq inherited its
# environment, but any command sequenced before jq (`;`, `&&`, `||`, a newline, `&`) runs in the same shell
# and can redefine jq in ways no text test enumerates (alias, eval, a sourced
# script, a command name made by tilde, glob or brace expansion). Inside it,
# only literal words qualify: an expansion can shift which word is the
# filter, -f anywhere turns the first operand into a file, and a PATH
# assignment can pick another jq. Every other word, redirections included,
# still reaches the deny regex. A rewrite is kept only when re-tokenizing
# shows that it changed the filter word and nothing else. The script of a sed
# made only of s and print commands gets the same treatment under the same rules: its
# regexes are dropped (sed_script_without_regex), and -f, -i or an -e after
# the script word keeps the command unchanged.
#
# A jq or sed in a later segment is trusted only where the segment check of
# search_operand_spans already trusts a grep: every segment before it is an
# inert command, so nothing before it can rebind its name. The text from that
# command word on is then rewritten like a first pipeline. Later offsets go
# first, so the earlier ones still point at their words.
bash_neutralize_jq_field_names() (
  set -f
  nj_cmd=$1
  # sed counts only as a whole name, as in jq_names_tool below: a rewrite
  # needs a `sed` command word, and words such as "passed" hold the letters.
  case "$nj_cmd" in
    *jq*|sed|sed[!A-Za-z0-9_]*|*[!A-Za-z0-9_]sed|*[!A-Za-z0-9_]sed[!A-Za-z0-9_]*) ;;
    *) printf '%s' "$nj_cmd"; exit 0 ;;
  esac
  case "$nj_cmd" in
    *PATH*|*path=*|*path+=*|*'path['*) printf '%s' "$nj_cmd"; exit 0 ;;
  esac
  if bash_command_sources_script "$nj_cmd"; then
    printf '%s' "$nj_cmd"
    exit 0
  fi
  for nj_at in $(search_operand_spans "$nj_cmd" trusted | sort -rn); do
    [ "$nj_at" -gt 1 ] || continue
    nj_head=$(NJ=$nj_cmd LC_ALL=C awk -v at="$nj_at" 'BEGIN { printf "%s", substr(ENVIRON["NJ"], 1, at - 1) }')
    nj_tail=$(NJ=$nj_cmd LC_ALL=C awk -v at="$nj_at" 'BEGIN { printf "%s", substr(ENVIRON["NJ"], at) }')
    nj_cmd=$nj_head$(bash_neutralize_first_pipeline "$nj_tail")
  done
  bash_neutralize_first_pipeline "$nj_cmd"
)

bash_neutralize_first_pipeline() (
  set -f
  jq_orig=$1
  jq_cmd=$jq_orig
  jq_records=$(git_command_records "$jq_orig")
  jq_sed=0
  case "
$jq_records
" in *'
0sed
'*) jq_sed=1 ;; esac

  # A word that names a rewritten tool anywhere but at its own command start
  # may run or redefine it, so it keeps the command unchanged. sed counts only
  # as a whole name (`sed=`, `[sed]`, `/sed`), since English words such as
  # "passed" hold it.
  jq_names_tool() {
    case "$1" in *jq*) return 0 ;; esac
    [ "$jq_sed" = 1 ] || return 1
    case "$1" in
      sed|sed[!A-Za-z0-9_]*|*[!A-Za-z0-9_]sed|*[!A-Za-z0-9_]sed[!A-Za-z0-9_]*) return 0 ;;
    esac
    return 1
  }
  jq_try_rewrite() {
    case "$jq_tool" in
      sed) jq_new=$(sed_script_without_regex "$jq_filter") || return 0 ;;
      *) jq_new=$(jq_filter_without_field_names "$jq_filter") ;;
    esac
    [ "$jq_new" = "$jq_filter" ] && return 0
    jq_expected=$(printf '%s\n' "$jq_records" | JQ_NEW=$jq_new awk -v k="$jq_filter_at" '
      NR == k { print "0" ENVIRON["JQ_NEW"]; next } { print }')
    for jq_form in single double bare; do
      case "$jq_form:$jq_filter" in
        single:*\'*) continue ;;
        single:*) jq_old="'$jq_filter'" jq_repl="'$jq_new'" ;;
        double:*\"*|double:*\\*|double:*'$'*|double:*'`'*) continue ;;
        double:*) jq_old="\"$jq_filter\"" jq_repl="\"$jq_new\"" ;;
        # Unquoted, only a plain field chain is sure to stay one literal
        # word: zsh extended glob also expands `#` and `^`.
        bare:*[!A-Za-z0-9_.]*) continue ;;
        bare:*) jq_old=$jq_filter jq_repl=$jq_new ;;
      esac
      jq_candidate=$(JQ_CMD=$jq_cmd JQ_OLD=$jq_old JQ_REPL=$jq_repl LC_ALL=C awk 'BEGIN {
        s = ENVIRON["JQ_CMD"]; p = index(s, ENVIRON["JQ_OLD"])
        if (p == 0) exit 1
        printf "%s", substr(s, 1, p - 1) ENVIRON["JQ_REPL"] substr(s, p + length(ENVIRON["JQ_OLD"]))
      }') || continue
      if [ "$(git_command_records "$jq_candidate")" = "$jq_expected" ]; then
        jq_cmd=$jq_candidate
        jq_records=$jq_expected
        return 0
      fi
    done
  }
  jq_end_segment() {
    [ "$jq_state:$jq_seg_bad" = after:0 ] && jq_try_rewrite
    jq_state=start jq_cmdw=
  }
  jq_bail() {
    printf '%s' "$jq_orig"
    exit 0
  }

  IFS='
'
  # shellcheck disable=SC2086
  set -- $jq_records
  jq_i=0 jq_state=start jq_need=0 jq_seg_bad=0 jq_prev= jq_cmdw=
  for jq_rec in "$@"; do
    jq_i=$((jq_i + 1))
    case "$jq_prev:$jq_rec" in "3(:3)") jq_bail ;; esac
    jq_before=$jq_prev
    jq_prev=$jq_rec
    case "$jq_rec" in
      0eval|0trap|0function) jq_bail ;;
      # The `&` of `2>&1` keeps jq's arguments going, so a later -f is still
      # seen. Any other `&` among them (`&>out`, a background job) may hide
      # more arguments and keeps the command unchanged.
      3'&')
        case "$jq_state:$jq_before" in
          after:*'>'|after:*'<') continue ;;
          opt:*|operand:*|after:*) jq_seg_bad=1 ;;
        esac
        jq_end_segment
        break
        ;;
      # A record cannot tell a `{ ...; }` group from brace expansion, which
      # can make a command name (`{eval,}`) or turn the filter into a file
      # operand (`.key{,}`).
      3'{'|3'}') jq_bail ;;
      # Inside jq's arguments a `(` is a glob qualifier or a syntax error; a
      # subshell can only open at a command start.
      3'(')
        case "$jq_state" in opt|operand|after) jq_seg_bad=1 ;; esac
        jq_end_segment
        continue
        ;;
      0';'|0'&&'|0'||') jq_end_segment; break ;;
      0'|'|3*) jq_end_segment; continue ;;
      0*) ;;
      4*) [ "$jq_state" = opt ] && [ "$jq_need" -gt 0 ] || jq_bail ;;
      *) jq_bail ;;
    esac
    jq_word=${jq_rec#?}
    # bash_command_sources_script sees `.` only at a plain command start, not
    # after `then` or `do` or with a glued redirect (`.</dev/null x.sh`);
    # outside jq's own arguments refuse it anywhere.
    case "$jq_state:${jq_word%%[<>]*}" in
      start:.|start:source|other:.|other:source|*:eval|*:trap|*:function) jq_bail ;;
    esac
    if [ "$jq_state" = start ]; then
      # A glob can expand to a command name such as eval (`ev?l`); zsh
      # extended glob adds `#` and `^`.
      case "$jq_word" in *[\*?[#^]*) jq_bail ;; esac
      # `command jq` skips shell functions and aliases, and a system path
      # skips the PATH lookup; either still runs jq itself. Only a bare
      # `command` directly before the tool name qualifies (`command -v jq`
      # prints a path), and only the system directories below, not a jq the
      # session could have written itself.
      case "$jq_cmdw:$jq_rec" in
        :0command) jq_cmdw=1; continue ;;
        *:0jq|*:0sed|:0/usr/bin/jq|:0/bin/jq|:0/usr/local/bin/jq|:0/opt/homebrew/bin/jq|\
        :0/usr/bin/sed|:0/bin/sed|:0/usr/local/bin/sed|:0/opt/homebrew/bin/sed)
          jq_tool=${jq_word##*/} jq_state=opt jq_need=0 jq_seg_bad=0 jq_e=0 ;;
        *:0gh) jq_state=ghopt jq_seg_bad=0 jq_ghnext=0 jq_ghn=0 jq_ghsub= jq_ghprev= jq_ghdd=0 ;;
        *) jq_state=other ;;
      esac
      jq_cmdw=
      if [ "$jq_state" != opt ] && jq_names_tool "$jq_word"; then jq_bail; fi
      continue
    fi
    # --jq is an option of gh, not a command, so it does not stop the rewrite
    # of a jq later in this pipeline, where --jq is that option for sure: the
    # subcommand is a built-in one that takes --jq (an alias or extension may
    # run its arguments as shell, and gh rejects one named after a built-in),
    # no `--` came before it, and the word before it is no option that may
    # take --jq as its value. The gh filter itself is left as written and
    # stays in the scan, which keeps a gh command at its old cost. Anywhere
    # else --jq stops the rewrite, as before.
    case "$jq_state" in
      ghopt)
        if [ "$jq_ghnext" = 1 ]; then
          jq_ghnext=0
          # A redirection is no filter word: it goes on to the checks below.
          case "$jq_word" in *'<'*|*'>'*) ;; *) continue ;; esac
        fi
        jq_ghn=$((jq_ghn + 1))
        case "$jq_ghn" in
          1) jq_ghsub=$jq_word ;;
          2) [ "$jq_ghsub" = api ] || jq_ghsub="$jq_ghsub $jq_word" ;;
        esac
        [ "$jq_word" != -- ] || jq_ghdd=1
        if [ "$jq_word" = --jq ]; then
          [ "$jq_ghdd" = 0 ] || jq_bail
          case "$jq_ghsub" in
            api|'run view'|'run list'|'pr view'|'pr list'|'pr checks'|'pr status'|\
            'issue view'|'issue list'|'issue status'|'release view'|'release list'|\
            'repo view'|'repo list') ;;
            *) jq_bail ;;
          esac
          case "$jq_ghprev" in
            --paginate|--slurp|--include|-i|--silent|--verbose) ;;
            -*) jq_bail ;;
          esac
          jq_ghnext=1
          continue
        fi
        jq_ghprev=$jq_word
        ;;
    esac
    if jq_names_tool "$jq_word"; then jq_bail; fi
    # Records drop quoting, so any glob character in an option value or a
    # later operand may expand into several words, or into an -f option
    # (zsh extended glob: `^x` is every file but x; zsh numeric range: `<0-9>`;
    # a leading tilde becomes HOME, whatever it holds).
    case "$jq_state:$jq_need:$jq_word" in
      opt:[12]:*[\*?[#^]*|operand:[12]:*[\*?[#^]*|after:*[\*?[#^]*) jq_seg_bad=1 ;;
      opt:[12]:*'<'*'>'*|operand:[12]:*'<'*'>'*|after:*'<'*'>'*) jq_seg_bad=1 ;;
      opt:[12]:'~'*|operand:[12]:'~'*|after:*:'~'*) jq_seg_bad=1 ;;
    esac
    case "$jq_state" in
      opt|operand)
        if [ "$jq_need" -gt 0 ]; then
          jq_need=$((jq_need - 1))
          continue
        fi
        if [ "$jq_tool:$jq_e" = sed:1 ]; then
          jq_filter=$jq_word jq_filter_at=$jq_i jq_state=after
          continue
        fi
        if [ "$jq_tool" = sed ]; then
          case "$jq_state:$jq_word" in
            opt:--) jq_state=operand ;;
            opt:--quiet|opt:--silent|opt:--regexp-extended|opt:--separate|\
            opt:--unbuffered|opt:--null-data|opt:--posix) ;;
            opt:--expression) jq_e=1 ;;
            opt:-?*)
              jq_flags=${jq_word#-}
              case "$jq_flags" in *e) jq_flags=${jq_flags%e} jq_e=1 ;; esac
              case "$jq_flags" in *[!nErsuz]*) jq_seg_bad=1 jq_state=other ;; esac
              ;;
            *:'<'*|*:'>'*|*:[0-9]*'<'*|*:[0-9]*'>'*) jq_seg_bad=1 jq_state=other ;;
            *) jq_filter=$jq_word jq_filter_at=$jq_i jq_state=after ;;
          esac
          continue
        fi
        case "$jq_state:$jq_word" in
          opt:--) jq_state=operand ;;
          opt:--null-input|opt:--raw-input|opt:--slurp|opt:--compact-output|\
          opt:--raw-output|opt:--raw-output0|opt:--join-output|opt:--ascii-output|\
          opt:--sort-keys|opt:--color-output|opt:--monochrome-output|opt:--tab|\
          opt:--unbuffered|opt:--stream|opt:--stream-errors|opt:--seq|\
          opt:--exit-status|opt:--args|opt:--jsonargs) ;;
          opt:--indent|opt:-L) jq_need=1 ;;
          opt:--arg|opt:--argjson|opt:--slurpfile|opt:--rawfile) jq_need=2 ;;
          opt:-L?*) ;;
          opt:-?*)
            case "${jq_word#-}" in *[!nRscrjaSCMe]*) jq_seg_bad=1 jq_state=other ;; esac
            ;;
          *:'<'*|*:'>'*|*:[0-9]*'<'*|*:[0-9]*'>'*) jq_seg_bad=1 jq_state=other ;;
          *) jq_filter=$jq_word jq_filter_at=$jq_i jq_state=after ;;
        esac
        ;;
      # GNU sed reorders its arguments, so an -e or -f after the script word
      # makes that word a file operand.
      after)
        if [ "$jq_tool" = sed ]; then
          case "$jq_word" in
            --quiet|--silent|--regexp-extended|--separate|--unbuffered|\
            --null-data|--posix|--) ;;
            -?*) case "${jq_word#-}" in *[!nErsuz]*) jq_seg_bad=1 ;; esac ;;
          esac
          continue
        fi
        case "$jq_word" in
          --null-input|--raw-input|--slurp|--compact-output|--raw-output|\
          --raw-output0|--join-output|--ascii-output|--sort-keys|--color-output|\
          --monochrome-output|--tab|--unbuffered|--stream|--stream-errors|--seq|\
          --exit-status|--args|--jsonargs|--) ;;
          -?*)
            case "${jq_word#-}" in *[!nRscrjaSCMe]*) jq_seg_bad=1 ;; esac
            ;;
        esac
        ;;
    esac
  done
  jq_end_segment
  printf '%s' "$jq_cmd"
)

# `process.env.PORT` in program text ends in `.env` and so looks like a dotenv
# file name. Rewrite the four runtime objects (process.env, import.meta.env,
# Bun.env, Deno.env) to a non-matching spelling, but only while no file of that
# name or a dotted variant of it exists in the directories the command's
# relative names resolve against; a real file with that name keeps its match.
# Only a member access inside a quoted argument qualifies (inline program text
# or a search pattern): an unquoted word is a file operand, and the bare object
# is a whole-environment dump. The text before the name must be a word start
# (not a path part, a prefix, an expansion or a quoted join), and what follows
# must be member names or a plain index, then a delimiter that cannot extend
# the word into a glob or another name.
# A here-document body can hold a stray quote that the quote tracking would
# carry past the body, so a command with `<<` is read line by line instead,
# and only the body of a heredoc that is the program of an interpreter alone on
# its line (`node <<'EOF'`, `python3 - <<EOF`) qualifies. The rest of such a
# command keeps every name, and anything else with `<<` is left as it is. In
# the body the name must follow a code delimiter, never a quote or a path
# part, and an unquoted delimiter's body may not run a command substitution.
bash_neutralize_runtime_globals() (
  set -f
  rg_orig=$1
  case "$rg_orig" in
    *process.env*|*import.meta.env*|*Bun.env*|*Deno.env*) ;;
    *) printf '%s' "$rg_orig"; exit 0 ;;
  esac
  rg_heredoc=
  case "$rg_orig" in
    *'<<'*) rg_heredoc=1 ;;
  esac
  rg_rebase=
  if bash_command_may_rebase_relative_paths "$rg_orig"; then
    rg_rebase=$(bash_command_rebase_target "$rg_orig") \
      || { printf '%s' "$rg_orig"; exit 0; }
  fi
  rg_dirs=.
  if [ -n "$rg_rebase" ]; then
    case "$rg_rebase" in
      *[[:space:]]*) printf '%s' "$rg_orig"; exit 0 ;;
    esac
    rg_dirs=". $rg_rebase"
  fi
  for rg_dir in $rg_dirs; do
    rg_found=$(
      CDPATH= cd -- "$rg_dir" 2>/dev/null || { echo 1; exit 0; }
      set +f
      for rg_path in process.env process.env.* import.meta.env import.meta.env.* \
        Bun.env Bun.env.* Deno.env Deno.env.*; do
        if [ -e "$rg_path" ] || [ -L "$rg_path" ]; then echo 1; break; fi
      done
    )
    [ -z "$rg_found" ] || { printf '%s' "$rg_orig"; exit 0; }
  done
  rg_out=$(RG_CMD=$rg_orig RG_HEREDOC=$rg_heredoc LC_ALL=C awk '
    function ok_prev(i,   p, q) {
      if (i == 1) return 1
      p = substr(s, i - 1, 1)
      if (p == "\047" || p == "\"") {
        if (i == 2) return 1
        q = substr(s, i - 2, 1)
        return index(" \t\n(,;{=|&!<>", q) > 0
      }
      return index(" \t\n(,;{=|&!<>", p) > 0
    }
    # A quoted word is a file operand for any command that opens files
    # (`tar -xOf a.tar "process.env.PORT"`), whatever the word looks like, so
    # it counts as text only for a command known to treat it as text: the
    # pattern of a grep-family command, the code given to an interpreter with
    # -e or -c, or the output words of echo and printf.
    # echo and printf only print the word, but the output can become a file
    # operand elsewhere: inside a substitution or group, or piped to a command
    # that opens what it reads. Only a pipe to a plain text filter keeps it text.
    function echo_text(qs, p, pre,   rest, e, i, c, d, word) {
      if (p > 0 && substr(pre, p, 1) == "(") return 0
      e = index(substr(s, qs + 1), substr(s, qs, 1))
      if (e == 0) return 0
      rest = substr(s, qs + e + 1)
      for (i = 1; i <= length(rest); i++) {
        c = substr(rest, i, 1)
        if (index(";&\n)", c) > 0) break
        if (c != "|") continue
        if (substr(rest, i + 1, 1) == "|") break
        d = substr(rest, i + 1)
        sub(/^[ \t]+/, "", d)
        match(d, /^[A-Za-z0-9_-]*/)
        word = substr(d, 1, RLENGTH)
        if (word !~ /^(wc|head|tail|sort|uniq|tr|cut|nl)$/) return 0
      }
      return 1
    }
    function text_word(qs,   pre, p, c, seg, nw, w, x, last, cmd, w0) {
      pre = substr(s, 1, qs - 1)
      p = 0
      for (x = length(pre); x >= 1; x--) {
        c = substr(pre, x, 1)
        if (index(";|&\n(", c) > 0) { p = x; break }
      }
      seg = substr(pre, p + 1)
      if (seg ~ /[\047"\\$`*?]/) return 0
      nw = split(seg, w, /[ \t]+/)
      while (nw > 0 && w[nw] == "") nw--
      x = 1
      while (x <= nw && w[x] == "") x++
      if (x > nw) return 0
      cmd = w[x]
      # Look through env, command and similar wrappers to the command they run.
      while (cmd ~ /^(env|command|exec|nohup)$/) {
        w0 = cmd
        for (x++; x <= nw; x++) {
          if (w[x] ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
          if (w0 == "env" && w[x] ~ /^-/) continue
          break
        }
        if (x > nw) return 0
        cmd = w[x]
      }
      last = substr(pre, length(pre), 1)
      if (last != " " && last != "\t" && w[nw] !~ /^-/) return 0
      if (cmd ~ /^(echo|printf)$/) return echo_text(qs, p, pre)
      if (cmd ~ /^(grep|egrep|fgrep|rg|ag|ack)$/) {
        for (x++; x <= nw; x++) {
          if (w[x] !~ /^-/ || w[x] ~ /^-[A-Za-z]*f/ || w[x] ~ /^--file/) return 0
        }
        return 1
      }
      if (cmd ~ /^(node|nodejs|bun|python|python3|ruby|perl|deno)$/) {
        if (x == nw || w[nw] !~ /^(-e|-p|-pe|-ep|-c|--eval|--print)$/ && !(cmd == "deno" && w[nw] == "eval")) return 0
        for (x++; x <= nw; x++) {
          if (cmd == "deno" && w[x] == "eval") continue
          if (w[x] !~ /^-/) return 0
        }
        return 1
      }
      return 0
    }
    function ok_tail(j,   c, k, body, members, first, b) {
      members = 0
      while (j <= n) {
        c = substr(s, j, 1)
        if (c == "." && substr(s, j + 1, 1) ~ /[A-Za-z_]/) {
          b = j + 1
          for (j++; j <= n && substr(s, j, 1) ~ /[A-Za-z0-9_]/; j++) ;
          if (!members) first = substr(s, b, j - b)
          members++
          continue
        }
        if (c == "[") {
          k = index(substr(s, j), "]")
          if (k == 0) return 0
          body = substr(s, j + 1, k - 2)
          if (body !~ /^["\047]?[A-Za-z0-9_]+["\047]?$/) return 0
          if (!members) { first = body; gsub(/["\047]/, "", first) }
          j += k
          members++
          continue
        }
        break
      }
      if (!members) return 0
      # A member that the object itself defines (toObject, valueOf, entries, ...)
      # hands back the whole environment however long the chain after it is, or
      # even when it is only referenced and called later.
      if (first ~ /^(toObject|valueOf|toString|toLocaleString|toJSON|constructor|__proto__|__defineGetter__|__defineSetter__|__lookupGetter__|__lookupSetter__|entries|keys|values)$/) return 0
      # A direct call on the object is a lookup only for the keyed accessors.
      if (members == 1 && substr(s, j, 1) == "(" && first !~ /^(get|has|set|delete)$/) return 0
      if (j > n) return 1
      return index(" \t\n()]},;\047\"|&=+!<>", substr(s, j, 1)) > 0
    }
    # line starts at offset pos of s and is a line of an interpreter heredoc body.
    # A name inside a string literal may be a file name, so it stays; a line
    # that ends inside a string (a multi-line template, a comment apostrophe)
    # gives up on the whole command, and so does a line with a name and a `/`,
    # since a regex literal or a comment can hold a quote that flips the state.
    function body_rewrite(line, pos,   r, i, ln, k, m, p, c, q) {
      if (index(line, "/") && line ~ /process\.env|import\.meta\.env|Bun\.env|Deno\.env/) exit 1
      r = ""; ln = length(line); q = ""
      for (i = 1; i <= ln; ) {
        c = substr(line, i, 1)
        if (q != "") {
          if (c == "\\") { r = r substr(line, i, 2); i += 2; continue }
          if (c == q) q = ""
          r = r c; i++; continue
        }
        if (c == "\047" || c == "\"" || c == "`") { q = c; r = r c; i++; continue }
        k = 0
        for (m = 1; m <= nn; m++)
          if (substr(line, i, length(names[m])) == names[m]) { k = m; break }
        if (k) {
          p = i == 1 ? " " : substr(line, i - 1, 1)
          if (index(" \t([{,;=!|&<>?:+*%^~}", p) && ok_tail(pos + i - 1 + length(names[k]))) {
            r = r repl[k]; i += length(names[k]); continue
          }
        }
        r = r substr(line, i, 1); i++
      }
      if (q != "") exit 1
      return r
    }
    function heredoc_pass(   nl, L, li, line, t, pos, delim, dash, quoted, rest, res) {
      nl = split(s, L, "\n"); pos = 1; delim = ""; res = ""
      for (li = 1; li <= nl; li++) {
        line = L[li]
        if (delim != "") {
          t = line
          if (dash) sub(/^\t+/, "", t)
          if (t == delim) delim = ""
          else {
            if (!quoted && (index(line, "`") || index(line, "$("))) exit 1
            line = body_rewrite(line, pos)
          }
        } else if (index(line, "<<")) {
          if (line !~ /^[ \t]*((node|nodejs|python[0-9.]*)([ \t]+(-|-[A-Za-z][-A-Za-z0-9=]*))*|(bun|deno)([ \t]+(-|-[A-Za-z][-A-Za-z0-9=]*|run))*)[ \t]*<<-?[ \t]*(\047[A-Za-z_][A-Za-z0-9_]*\047|"[A-Za-z_][A-Za-z0-9_]*"|[A-Za-z_][A-Za-z0-9_]*)[ \t]*$/) exit 1
          rest = substr(line, index(line, "<<") + 2)
          dash = sub(/^-/, "", rest)
          gsub(/[ \t]/, "", rest)
          quoted = rest ~ /^[\047"]/
          gsub(/[\047"]/, "", rest)
          delim = rest
        }
        res = res line (li < nl ? "\n" : "")
        pos += length(L[li]) + 1
      }
      if (delim != "") exit 1
      return res
    }
    BEGIN {
      s = ENVIRON["RG_CMD"]; n = length(s); out = ""; quote = ""
      nn = split("process.env import.meta.env Bun.env Deno.env", names, " ")
      split("process_env import.meta_env Bun_env Deno_env", repl, " ")
      if (ENVIRON["RG_HEREDOC"] != "") { printf "%s", heredoc_pass(); exit 0 }
      for (i = 1; i <= n; ) {
        k = 0
        for (m = 1; m <= nn; m++)
          if (substr(s, i, length(names[m])) == names[m]) { k = m; break }
        if (k && quote != "" && ok_prev(i) && ok_tail(i + length(names[k])) && text_word(qstart)) {
          out = out repl[k]; i += length(names[k]); continue
        }
        ch = substr(s, i, 1)
        if (quote != "\047" && ch == "\\") { out = out ch substr(s, i + 1, 1); i += 2; continue }
        if (quote == "" && (ch == "\047" || ch == "\"")) { quote = ch; qstart = i }
        else if (quote != "" && ch == quote) quote = ""
        out = out ch; i++
      }
      printf "%s", out
    }') || { printf '%s' "$rg_orig"; exit 0; }
  printf '%s' "$rg_out"
)

# Print $1 without the bodies of the here-documents that `cat` or `tee` only
# write out, or that a gh or git commit message command reads from stdin
# (`--body-file -`, `-F -`) behind a quoted delimiter: that text is data, so a
# protected-path name in it opens no file. A message body qualifies only in a
# first-line command, alone with its heredoc, with nothing but `git add`
# before it and `git push` after it, as a later command could run the stored
# message. The line that starts the heredoc (its redirect target included) and
# the delimiter line stay. Anything not read with confidence prints $1
# unchanged: another head (a shell or python runs its body), a pipe, group or
# background on the line, a body with no terminator, an unquoted delimiter whose
# body expands anything but a bare parameter reference, or a line the command gate does not read the same
# way after the rewrite (a later `sh`, `.` or `eval` may run what was written).
# heredoc_body_rewrite reads the text on stdin and holds that decision; with
# $1 set to 1 it prints, for a text it accepts, the whole text with only a
# backquote or `$(` in each body line replaced (see
# bash_neutralize_literal_substitutions) instead of the text without bodies.
heredoc_body_rewrite() {
  LC_ALL=C awk -v neutral="${1:-0}" '
    function reject() { bad = 1; exit 1 }
    # The words of s, quoted text replaced by Q, in w[1..]; returns the count.
    function words(s, w) {
      gsub(/\047[^\047]*\047|"[^"]*"/, "Q", s)
      sub(/^[ \t]+/, "", s)
      return split(s, w, /[ \t]+/)
    }
    # Succeed when segment s is `gh pr|issue create|comment|edit`,
    # `gh pr review` or `git commit` (the commands message_value_records
    # exempts) reading its body or message from stdin with `-F -`,
    # `--body-file -` or `--file -`, and no option starts an editor, a web
    # browser or an interactive prompt that would read the same stdin.
    function message_stdin(s,   w, m, k, gh, gc, dash) {
      if (match(s, /(;|&&)/)) s = substr(s, 1, RSTART - 1)
      m = words(s, w)
      gh = w[1] == "gh" && (w[2] ~ /^(pr|issue)$/ && w[3] ~ /^(create|comment|edit)$/ || w[2] == "pr" && w[3] == "review")
      gc = w[1] == "git" && w[2] == "commit"
      if (!gh && !gc) return 0
      for (k = 3; k <= m; k++) {
        if (w[k] == "--") break
        if (gh && (w[k] ~ /^-[A-Za-z]*[ew]/ || w[k] ~ /^--(editor|web)/)) return 0
        if (gc && (w[k] ~ /^-[A-Za-z]*[cCeip]/ || w[k] ~ /^--(edit|patch|interactive|reedit-message|reuse-message|squash|fixup|template)/)) return 0
        if ((w[k] == "-F" || gh && w[k] == "--body-file" || gc && w[k] == "--file") && w[k + 1] == "-") dash = 1
        if (gh && w[k] == "--body-file=-" || gc && w[k] == "--file=-") dash = 1
      }
      return dash
    }
    # Commands that may come before the message command on its line: none
    # of them can change what gh or git names or reads.
    function lead_inert(s,   seg) {
      while (s != "") {
        if (match(s, /(;|&&)/)) { seg = substr(s, 1, RSTART - 1); s = substr(s, RSTART + RLENGTH) }
        else { seg = s; s = "" }
        if (seg ~ /[<>$]/ || seg !~ /^[ \t]*git[ \t]+(add|status)([ \t]|$)/) return 0
      }
      return 1
    }
    # After the message command, only `git push` may follow on its line.
    function tail_inert(s,   seg) {
      if (!match(s, /(;|&&)/)) return 1
      s = substr(s, RSTART + RLENGTH)
      while (s != "") {
        if (match(s, /(;|&&)/)) { seg = substr(s, 1, RSTART - 1); s = substr(s, RSTART + RLENGTH) }
        else { seg = s; s = "" }
        if (seg ~ /[<>$]/ || seg !~ /^[ \t]*git[ \t]+push([ \t]|$)/) return 0
      }
      return 1
    }
    delim != "" {
      line = $0
      if (strip) sub(/^\t+/, "", line)
      if (line == delim) { delim = ""; kept[++nk] = $0; ntext = ntext $0 "\n"; if (msg) mend = nk; next }
      if (!quoted) {
        # An unquoted delimiter expands its body. A bare parameter reference
        # runs nothing and opens no file unless an earlier `declare -n` made
        # it a name reference; that declaration is itself on the scanned
        # line, not in the body. A substitution, arithmetic (which
        # evaluates the values of the names it reads), a subscript, any other
        # `${...}` form or a backslash keeps the command in the scan.
        line = $0
        if (line ~ /[`\\]/ || line ~ /\$[A-Za-z_][A-Za-z0-9_]*\[/) reject()
        gsub(/\$\{[A-Za-z_][A-Za-z0-9_]*\}/, "", line)
        gsub(/\$[A-Za-z_][A-Za-z0-9_]*/, "", line)
        if (index(line, "$")) reject()
      }
      line = $0; gsub(/`/, "_", line); gsub(/\$\(/, "_(", line)
      ntext = ntext line "\n"
      next
    }
    {
      kept[++nk] = $0; ntext = ntext $0 "\n"
      if (index($0, "<<") == 0) next
      rest = $0
      if (rest ~ /<<</ || rest ~ /\\/) reject()
      # cat with a quoted delimiter piped to `gh ... --body-file -`: cat only passes the body on and
      # the message command reads it as data, under the limits of a body it
      # reads straight from stdin.
      piped = ""
      if (match(rest, /^[ \t]*cat[ \t]*<<-?[ \t]*\047[A-Za-z_][A-Za-z0-9_]*\047[ \t]*\|/) && substr(rest, RLENGTH + 1) !~ /[|()`<>]/) {
        piped = substr(rest, RLENGTH + 1)
        rest = substr(rest, 1, RLENGTH - 1)
        t = piped; gsub(/&&/, "", t)
        q = piped
        if (t ~ /&/ || gsub(/\047/, "", q) % 2 || gsub(/"/, "", q) % 2) reject()
      }
      pre = substr(rest, 1, index(rest, "<<") - 1)
      post = substr(rest, index(rest, "<<") + 2)
      if (index(post, "<<") > 0) reject()
      t = rest; gsub(/&&/, "", t)
      if (t ~ /[&()`|]/) reject()
      q = rest; if (gsub(/\047/, "", q) % 2 || gsub(/"/, "", q) % 2) reject()
      lead = ""
      while (match(pre, /(&&|;)/)) { lead = lead substr(pre, 1, RSTART + RLENGTH - 1); pre = substr(pre, RSTART + RLENGTH) }
      writer = pre ~ /^[ \t]*(cat|tee)([ \t]|$)/
      if (!writer && pre !~ /^[ \t]*(gh|git)[ \t]/) reject()
      nh++
      strip = 0
      if (post ~ /^-/) { strip = 1; post = substr(post, 2) }
      sub(/^[ \t]+/, "", post)
      c = substr(post, 1, 1)
      if (c == "\047" || c == "\"") {
        quoted = 1
        e = index(substr(post, 2), c)
        if (e == 0) reject()
        delim = substr(post, 2, e - 1)
        post = substr(post, e + 2)
      } else {
        quoted = 0
        if (!match(post, /^[A-Za-z_][A-Za-z0-9_]*/)) reject()
        delim = substr(post, 1, RLENGTH)
        post = substr(post, RLENGTH + 1)
      }
      if (delim == "" || delim ~ /[ \t$`\\\047"]/ || post !~ /^([ \t;&<>]|$)/) reject()
      if (!writer) {
        # A message body read from stdin: the line must be the first, the
        # heredoc its only one and nothing may run after it (a later
        # `git log --format=%B | sh` would run what was stored).
        if (!quoted || NR != 1 || !message_stdin(pre post) || !lead_inert(lead) || !tail_inert(post)) reject()
        msg = 1
      }
      if (piped != "") {
        if (NR != 1 || !message_stdin(piped) || !tail_inert(piped)) reject()
        msg = 1
      }
      # Name what the line writes: a word after > or >>, and the operands of tee.
      m = split(rest, w, /[ \t]+/); tee = 0
      for (k = 1; k <= m; k++) {
        name = ""
        if (w[k] ~ /^>>?$/) name = w[k + 1]
        else if (w[k] ~ /^>>?[^>]/) { name = w[k]; sub(/^>>?/, "", name) }
        else if (w[k] == "tee") { tee = 1; continue }
        else if (tee && w[k] !~ /^[-<>&;]/) name = w[k]
        if (w[k] ~ /^(&&|;)$/) tee = 0
        gsub(/["\047]/, "", name); sub(/.*\//, "", name)
        if (name != "") target[++nt] = name
      }
    }
    END {
      if (bad || delim != "") exit 1
      if (msg) {
        if (nh != 1 || !mend) exit 1
        for (k = mend + 1; k <= nk; k++) if (kept[k] !~ /^[ \t]*$/) exit 1
      }
      text = ""
      for (k = 1; k <= nk; k++) text = text kept[k] "\n"
      # Whatever the line writes may run later, as a script or an interpreter
      # argument, so the file name may not come up again.
      for (k = 1; k <= nt; k++) {
        c = 0; s = text
        while ((p = index(s, target[k])) > 0) { c++; s = substr(s, p + length(target[k])) }
        for (j = 1; j <= nt; j++) if (target[j] == target[k] && j != k) c--
        if (c > 1) exit 1
      }
      if (text ~ /(^|[^A-Za-z0-9_.-])(python[0-9.]*|node|nodejs|ruby|perl|php|lua|deno|bun|awk|gawk|mawk|osascript|tclsh|Rscript|swift|java|jshell)([^A-Za-z0-9_-]|$)/) exit 1
      printf "%s", (neutral == 1 ? ntext : text)
      # 3: accepted as a body piped from cat to a message command.
      if (piped != "") exit 3
    }
  '
}

bash_strip_heredoc_bodies() (
  set -f
  hd_cmd=$1
  case "$hd_cmd" in
    *'<<'*) ;;
    *) printf '%s' "$hd_cmd"; exit 0 ;;
  esac
  hd_new=$(printf '%s\n' "$hd_cmd" | heredoc_body_rewrite)
  hd_status=$?
  case "$hd_status" in
    0|3) ;;
    *) printf '%s' "$hd_cmd"; exit 0 ;;
  esac
  if [ "$hd_new" = "$hd_cmd" ]; then
    printf '%s' "$hd_cmd"
    exit 0
  fi
  # The command gate reads a body on a line with a pipe as code, whatever
  # reads it, so its records cannot vouch for this form. It was accepted
  # only as the whole command: cat, one message command reading stdin, and
  # at most a `git push` after it.
  if [ "$hd_status" -eq 3 ]; then
    printf '%s' "$hd_new"
    exit 0
  fi
  hd_before=$(git_gate_records "$hd_cmd")
  hd_after=$(git_gate_records "$hd_new")
  if [ "$hd_before" = "$hd_after" ]; then
    printf '%s' "$hd_new"
  else
    printf '%s' "$hd_cmd"
  fi
)

# Succeed when every command in the git_command_records stream $1 only treats
# the text it is given as data, so a literal backquote or `$(` handed to it
# runs nothing: its name is literal and on the inert list message_value_records
# and search_operand_spans share (cd only when PATH holds no relative entry),
# every word is literal or a bare parameter reference, and nothing on the line
# is a redirection, a group, a subshell, a background job, a substitution or a
# word the tokenizer could not read. With $2 set to heredoc, a segment holding
# a `<<` word may also be the cat, tee, gh or git command that
# bash_strip_heredoc_bodies accepted, with its redirections, and mkdir or git
# may come before or after it; none of them can change what that command
# runs. Anything else fails, so a shell, eval, ssh, xargs, trap, an
# interpreter, an assignment prefix, a function or alias definition or a pipe
# into any of them keeps the whole line in the scan.
literal_consumers_inert() {
  printf '%s\n' "$1" | LC_ALL=C awk -v cd_ok="$(path_entries_absolute && echo 1)" -v mode="${2-}" \
    -v inert_names="$INERT_SEGMENT_COMMANDS_ERE" "$AWK_PLAIN_WORD$AWK_RECORD_SEPARATOR$AWK_INERT_COMMAND"'
    # An exit with no status in END keeps 0, so give it one.
    function bail() { failed = 1; exit 1 }
    function finish(   j, hd, redir) {
      if (n == 0) return
      if (kind[1] != "0") bail()
      hd = 0; redir = 0
      for (j = 1; j <= n; j++) {
        if (word[j] ~ /^<</) hd = 1
        if (word[j] ~ /[<>]/) redir = 1
      }
      if (hd) {
        if (mode != "heredoc" || word[1] !~ /^(cat|tee|gh|git)$/) bail()
      } else {
        if (redir) bail()
        if (!inert_command(word[1]) && !(mode == "heredoc" && word[1] ~ /^(mkdir|git)$/)) bail()
      }
      n = 0
    }
    {
      r = $0; k = substr(r, 1, 1); v = substr(r, 2)
      if (record_separator(r)) { finish(); next }
      if (!plain_word(k, v)) bail()
      n++; kind[n] = k; word[n] = v
    }
    END { if (!failed) finish(); exit failed }
  '
}

# Print $1 with each backquote and `$(` that the shell reads as text, and that
# only a command literal_consumers_inert accepts receives, replaced by `_` (the
# `(` stays), so the deny patterns do not read it as a command substitution.
# Two places qualify: the body of a quoted-delimiter here-document that
# bash_strip_heredoc_bodies leaves out (cat, tee, a gh or git commit message
# from stdin), and a single-quoted word on a line with no here-document.
# Every other character stays, so a body or argument that names an
# environment dump (`printenv`, `env | ...`) or any other deny-listed command
# is still read; a double-quoted word, an unquoted delimiter, `$'...'`, a
# backslash-quoted or partly quoted delimiter, a here-string and anything
# outside the quotes keep their backquotes. Re-tokenizing a single-quoted
# rewrite must show the same records with nothing but those characters
# changed. Whenever any check fails, $1 is printed unchanged.
bash_neutralize_literal_substitutions() (
  set -f
  ln_cmd=$1
  case "$ln_cmd" in
    *'`'*|*'$('*) ;;
    *) printf '%s' "$ln_cmd"; exit 0 ;;
  esac
  case "$ln_cmd" in
    *'<<'*)
      ln_strip=$(bash_strip_heredoc_bodies "$ln_cmd")
      if [ "$ln_strip" != "$ln_cmd" ] \
        && literal_consumers_inert "$(git_command_records "$ln_strip")" heredoc \
        && ln_new=$(printf '%s\n' "$ln_cmd" | heredoc_body_rewrite 1) \
        && [ -n "$ln_new" ]; then
        printf '%s' "$ln_new"
      else
        printf '%s' "$ln_cmd"
      fi
      exit 0
      ;;
    *"'"*) ;;
    *) printf '%s' "$ln_cmd"; exit 0 ;;
  esac
  ln_records=$(git_command_records "$ln_cmd")
  literal_consumers_inert "$ln_records" || { printf '%s' "$ln_cmd"; exit 0; }
  ln_new=$(LN_CMD=$ln_cmd LC_ALL=C awk 'BEGIN {
    s = ENVIRON["LN_CMD"]; n = length(s); out = ""; q = ""; started = 0
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (q == "s") {
        if (c == "\047") q = ""
        else if (c == "`" || c == "$" && substr(s, i + 1, 1) == "(") c = "_"
        out = out c; continue
      }
      if (q == "d") {
        if (c == "\\") { out = out c substr(s, i + 1, 1); i++; continue }
        if (c == "\"") q = ""
        out = out c; continue
      }
      if (c == "\\") { out = out c substr(s, i + 1, 1); i++; started = 1; continue }
      # A comment runs to the end of its line and is copied as written.
      if (c == "#" && !started) {
        k = index(substr(s, i), "\n")
        if (!k) { out = out substr(s, i); break }
        out = out substr(s, i, k - 1); i += k - 2; continue
      }
      if (c == "\047") q = "s"
      else if (c == "\"") q = "d"
      started = index(" \t\n;&|()<>", c) == 0
      out = out c
    }
    if (q != "") exit 1
    printf "%s", out
  }') || { printf '%s' "$ln_cmd"; exit 0; }
  if [ "$ln_new" = "$ln_cmd" ]; then
    printf '%s' "$ln_cmd"
    exit 0
  fi
  LN_OLD=$ln_records LN_NEW=$(git_command_records "$ln_new") LC_ALL=C awk 'BEGIN {
    a = split(ENVIRON["LN_OLD"], old, "\n"); b = split(ENVIRON["LN_NEW"], new, "\n")
    if (a != b) exit 1
    for (k = 1; k <= a; k++) {
      if (old[k] == new[k]) continue
      if (substr(old[k], 1, 1) != substr(new[k], 1, 1) || length(old[k]) != length(new[k])) exit 1
      for (j = 1; j <= length(old[k]); j++) {
        x = substr(old[k], j, 1); y = substr(new[k], j, 1)
        if (x != y && !(y == "_" && (x == "`" || x == "$" && substr(old[k], j + 1, 1) == "("))) exit 1
      }
    }
  }' || { printf '%s' "$ln_cmd"; exit 0; }
  printf '%s' "$ln_new"
)

# Print $1 with the text of each single-quoted word replaced by `_` when the
# whole command is one echo or printf, optionally redirected to one file:
# `echo 'const m = obj.env;' > note.md`. Those commands only print their
# words, so a path-shaped word opens nothing. The redirect target keeps its
# text, and a quote after the `>`, a second redirection, a newline outside the
# quotes, or any unquoted character that could expand, glob, join another
# command or open a pipe prints $1 unchanged.
bash_strip_echo_literal_text() {
  case "$1" in
    "echo '"*|"echo -"*|"printf '"*|"printf -"*) ;;
    *) printf '%s' "$1"; return 0 ;;
  esac
  ET_CMD=$1 LC_ALL=C awk 'BEGIN {
    s = ENVIRON["ET_CMD"]; n = length(s); out = ""; redir = 0
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (c == "\047") {
        e = index(substr(s, i + 1), "\047")
        if (e == 0 || redir) exit 1
        out = out "\047_\047"; i += e; continue
      }
      if (c == ">") {
        if (redir) exit 1
        redir = 1; out = out c
        if (substr(s, i + 1, 1) == ">") { out = out c; i++ }
        continue
      }
      if (c != " " && c != "\t" && c !~ /[A-Za-z0-9_.\/:@%+,=-]/) exit 1
      out = out c
    }
    printf "%s", out
  }' || printf '%s' "$1"
}

# Private variable name; see check_bash_command (#127).
# The tracked-file exception: what is committed to the repository that holds
# the event workdir is not secret from an agent working in that repository,
# so a name pattern alone does not protect it. Return 0 only when $1, read
# from the current directory, is all of: a regular file that is not a symlink;
# inside that repository's work tree by its physical path, so no symlinked
# directory leads out of it; in the index (git ls-files); byte for byte the
# blob committed at HEAD under that path, so the read shows nothing the
# repository does not already hold (a file committed with placeholders and
# filled in locally, or one that is only staged, stays blocked); and matched
# by no deny entry that names a directory (`.aws/credentials`, `.ssh/id_*`),
# which stays protected wherever it is. Anything else, a git that fails or is
# missing included, returns 1 and the block stands. Git variables are dropped
# so the answer describes the work tree on disk, and the file is hashed
# without filters, so no configured filter command runs.
tracked_file_exception_applies() (
  [ "${AGENT_GUARD_TRACKED_FILE_EXCEPTION-on}" = on ] || exit 1
  tfe_path=$1
  case "$tfe_path" in
    ''|*'
'*) exit 1 ;;
  esac
  [ -f "$tfe_path" ] && [ ! -L "$tfe_path" ] || exit 1
  case "$tfe_path" in
    */*) tfe_dir=${tfe_path%/*}; [ -n "$tfe_dir" ] || tfe_dir=/ ;;
    *) tfe_dir=. ;;
  esac
  tfe_dir=$(CDPATH= cd -P -- "$tfe_dir" 2>/dev/null && pwd -P) || exit 1
  tfe_real=${tfe_dir%/}/${tfe_path##*/}
  # The path as written must be that same location for every process that
  # opens it: no symlink, `.` or `..` part on the way. `/proc/self/cwd/x` is
  # one file for this check and another for a command that has changed
  # directory.
  case "$tfe_path" in
    /*) tfe_written=$tfe_path ;;
    *) tfe_written=$(pwd -P)/${tfe_path#./} ;;
  esac
  [ "$tfe_written" = "$tfe_real" ] || exit 1
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CEILING_DIRECTORIES \
    GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_CONFIG
  # Replace refs can make HEAD:<path> name an object that was never committed.
  unset GIT_REPLACE_REF_BASE
  GIT_OPTIONAL_LOCKS=0 GIT_NO_LAZY_FETCH=1 GIT_NO_REPLACE_OBJECTS=1
  export GIT_OPTIONAL_LOCKS GIT_NO_LAZY_FETCH GIT_NO_REPLACE_OBJECTS
  tfe_top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
  tfe_top=$(CDPATH= cd -P -- "$tfe_top" 2>/dev/null && pwd -P) || exit 1
  case "$(pwd -P)/" in
    "${tfe_top%/}"/*) ;;
    *) exit 1 ;;
  esac
  case "$tfe_real" in
    "${tfe_top%/}"/*) ;;
    *) exit 1 ;;
  esac
  tfe_rel=${tfe_real#"${tfe_top%/}"/}
  [ -f "$DENY_READ_PATHS" ] || exit 1
  while IFS= read -r tfe_entry || [ -n "$tfe_entry" ]; do
    case "$tfe_entry" in
      ''|\#*) continue ;;
      */*)
        # shellcheck disable=SC2254
        case "$tfe_real" in
          $tfe_entry|*/$tfe_entry|*/$tfe_entry/*) exit 1 ;;
        esac
        # The path as written too: a symlinked directory can carry the name.
        # shellcheck disable=SC2254
        case "/$tfe_path" in
          */$tfe_entry|*/$tfe_entry/*) exit 1 ;;
        esac
        ;;
    esac
  done <"$DENY_READ_PATHS"
  git -c core.fsmonitor=false --literal-pathspecs -C "$tfe_top" \
    ls-files --error-unmatch -- "$tfe_rel" >/dev/null 2>&1 || exit 1
  # ls-tree, not HEAD:<path>: the revision parser would read a name ending in
  # -g<hex> as an object id. Exactly one regular-file entry under that path.
  tfe_tree=$(git --literal-pathspecs -C "$tfe_top" ls-tree --full-tree HEAD -- "$tfe_rel" 2>/dev/null) \
    && [ -n "$tfe_tree" ] || exit 1
  case "$tfe_tree" in
    *'
'*) exit 1 ;;
    '100644 blob '*"	$tfe_rel"|'100755 blob '*"	$tfe_rel") ;;
    *) exit 1 ;;
  esac
  tfe_head=${tfe_tree#?????? blob }
  tfe_head=${tfe_head%%"	"*}
  tfe_disk=$(git -C "$tfe_top" hash-object --no-filters -- "$tfe_real" 2>/dev/null) || exit 1
  [ "$tfe_disk" = "$tfe_head" ]
)

# Replace with `_` each operand word (search_operand_spans, tracked mode)
# that names a file under the tracked-file exception, keeping every other
# byte, so the scan that follows still reads every other word. A relative
# word is read from the event workdir or from the one static directory the
# command may change to: it qualifies only when, at each of the two, the path
# is either such a file or absent, and at one of them it is such a file. An
# unknown directory change leaves relative words alone.
bash_strip_tracked_file_operands() (
  set -f
  tf_cmd=$1
  tf_spans=$(search_operand_spans "$tf_cmd" tracked) && [ -n "$tf_spans" ] || {
    printf '%s' "$tf_cmd"
    exit 0
  }
  tf_rebase_known=1 tf_rebase=
  if bash_command_may_rebase_relative_paths "$tf_cmd"; then
    tf_rebase=$(bash_command_rebase_target "$tf_cmd") || tf_rebase_known=0
  fi
  tf_keep=
  tf_ifs=$IFS
  IFS='
'
  for tf_span in $tf_spans; do
    IFS=$tf_ifs
    tf_rest=${tf_span#T }
    tf_start=${tf_rest%% *}; tf_rest=${tf_rest#* }
    tf_end=${tf_rest%% *}; tf_path=${tf_rest#* }
    case "$tf_path" in
      /*) set -- "$tf_path" ;;
      *)
        [ "$tf_rebase_known" -eq 1 ] || continue
        set -- "$tf_path"
        [ -z "$tf_rebase" ] || set -- "$tf_path" "$tf_rebase/$tf_path"
        ;;
    esac
    tf_tracked=0 tf_other=0
    for tf_target in "$@"; do
      if tracked_file_exception_applies "$tf_target"; then
        tf_tracked=1
      elif [ -e "$tf_target" ] || [ -L "$tf_target" ]; then
        tf_other=1
      fi
    done
    [ "$tf_tracked" -eq 1 ] && [ "$tf_other" -eq 0 ] || continue
    tf_keep="$tf_keep $tf_start $tf_end"
  done
  IFS=$tf_ifs
  [ -n "$tf_keep" ] || { printf '%s' "$tf_cmd"; exit 0; }
  printf '%s\n' "$tf_cmd" | LC_ALL=C awk -v spans="$tf_keep" '
    {
      m = split(spans, p, " "); out = ""; at = 1
      for (k = 1; k < m; k += 2) {
        out = out substr($0, at, p[k] - at) "_"
        at = p[k + 1] + 1
      }
      printf "%s", out substr($0, at)
    }'
)

# Print the deny-read suffixes that name no file by themselves: `.p8` for the
# entry `*.p8`. Such a word in program text is an extension being mentioned
# (endswith(".p8"), /\.key$/), not a path, unless a file of exactly that name
# exists where the command reads relative names ($@: the event workdir is
# the current directory; the arguments are further base directories). A
# suffix that another entry also matches as a whole name (`.env` under
# `.env*`) is a file name and is never listed.
program_text_bare_suffixes() (
  [ -f "$DENY_READ_PATHS" ] || exit 0
  bs_out=
  while IFS= read -r bs_entry || [ -n "$bs_entry" ]; do
    case "$bs_entry" in
      '*.'?*) bs_suffix=${bs_entry#\*} ;;
      *) continue ;;
    esac
    case "${bs_suffix#.}" in *[!A-Za-z0-9_]*) continue ;; esac
    bs_bare=1
    while IFS= read -r bs_other || [ -n "$bs_other" ]; do
      case "$bs_other" in ''|\#*) continue ;; esac
      # shellcheck disable=SC2254
      case "$bs_suffix" in
        $bs_other) [ "$bs_other" = "*$bs_suffix" ] || { bs_bare=0; break; } ;;
      esac
    done <"$DENY_READ_PATHS"
    [ "$bs_bare" -eq 1 ] || continue
    for bs_dir in . "$@"; do
      if [ -e "$bs_dir/$bs_suffix" ] || [ -L "$bs_dir/$bs_suffix" ]; then bs_bare=0; fi
    done
    [ "$bs_bare" -eq 1 ] && bs_out="$bs_out $bs_suffix"
  done <"$DENY_READ_PATHS"
  printf '%s' "$bs_out"
)

# Print program text $2 of kind $1 without the parts that cannot name a file
# the program opens; $3 is the list from program_text_bare_suffixes. Every
# string literal, path part and glob stays as written for the scan.
# - jq: the field names of the filter (jq_filter_without_field_names).
# - sed: the regexes of a script made only of s and print commands
#   (sed_script_without_regex); any other script keeps its text.
# - py, js: member names in code outside string literals (`row.key`,
#   `process.env.PORT`). Only where the quoting can be followed for sure: a
#   python program without a comment or a triple quote, a node program
#   without a `/` (regex, comment) or a backquote outside strings.
# - every kind: a bare suffix that is only mentioned (mention_ok), unless
#   the text can change directory, since the suffix was only checked where
#   the command starts.
program_text_residual() {
  pr_text=$2
  case "$1" in
    jq) pr_text=$(jq_filter_without_field_names "$pr_text") || return 1 ;;
    # A script outside that grammar may run a command (the e command and
    # flag) or name a file (r, w): it keeps every byte.
    sed) pr_text=$(sed_script_without_regex "$pr_text") || return 1 ;;
  esac
  PT_TEXT=$pr_text LC_ALL=C awk -v kind="$1" -v suffixes="$3" '
    function chains(t,   out, n, i, c, q, p) {
      # The environment objects (process.env, os.environ) keep their names:
      # the bare object is a dump of every variable, and the scan decides
      # which member accesses are safe.
      if (t ~ /(^|[^A-Za-z0-9_])(env|environ|ENV)([^A-Za-z0-9_]|$)/) return t
      out = ""; n = length(t); q = ""
      for (i = 1; i <= n; i++) {
        c = substr(t, i, 1)
        if (q != "") {
          out = out c
          if (c == "\\") { i++; out = out substr(t, i, 1) }
          else if (c == q) {
            q = ""
            # Text glued to a closing quote is no code this scan can read.
            if (substr(t, i + 1, 1) ~ /[A-Za-z0-9_]/) return t
          }
          continue
        }
        if (c == "\047" || c == "\"") {
          if (kind == "py" && substr(t, i, 3) == c c c) return t
          # An f-string or t-string may nest quotes, which this scan cannot follow.
          if (kind == "py" && substr(t, (i > 2 ? i - 2 : 1), (i > 2 ? 2 : i - 1)) ~ /[fFtT]$|[fFtT][rR]$/) return t
          q = c; out = out c
          continue
        }
        if (c == "]" && substr(t, i + 1, 1) ~ /[A-Za-z0-9_]/) return t
        if (kind == "py" && c == "#") return t
        if (kind == "js" && (c == "/" || c == "`")) return t
        if (c == "." && substr(t, i + 1, 1) ~ /[A-Za-z_]/ && i > 1 && substr(t, i - 1, 1) ~ /[])A-Za-z0-9_]/) {
          for (i++; i <= n && substr(t, i, 1) ~ /[A-Za-z0-9_]/; i++) ;
          i--
          continue
        }
        out = out c
      }
      return q == "" ? out : t
    }
    # A bare suffix is dropped only where it cannot be the end of a name the
    # program builds: as regex text after a backslash (`\.key$`); as the whole
    # string literal handed to a suffix test or a comparison, whose result is
    # a boolean (`endswith(".p8")`, `ext == ".p8"`); or inside a longer
    # literal, with other text on both sides (`"keys (.p8) stay out"`). A literal that is
    # only the suffix anywhere else (`name + ".key"`, awk `$1".key"`) and a
    # suffix that ends a literal (`"\(.name).key"`, `"cat .key"`) stay.
    # A suffix is dropped only from a program that can neither open a file,
    # list a directory, read names from its input nor run a command: there a
    # suffix test only filters text the program was given. Any other program
    # could pick the files to open with it, or cut the suffix out of a
    # longer literal, so it keeps every suffix (tier 0).
    function tier(t,   u) {
      if (kind == "jq" || kind == "sed") return 2
      if (kind == "awk") return t ~ /getline|system|ARGV|ENVIRON|FILENAME|close|[|]/ ? 0 : 2
      if (kind == "py") {
        u = t
        gsub(/import[ \t]+(sys|re|json|string|math|itertools|collections|functools|textwrap|unicodedata)([ \t]*,[ \t]*(sys|re|json|string|math|itertools|collections|functools|textwrap|unicodedata))*/, "", u)
        if (u ~ /import|exec|eval|compile|__|getattr|globals|locals|vars|modules|breakpoint|input|stdin/) return 0
        return u ~ /open/ ? 0 : 2
      }
      if (kind == "js") return t ~ /require|import|binding|module|eval|Function|global|child|stdin|process\.[a-z]*[A-Z(]/ ? 0 : 2
      # perl and ruby have too many ways to run a command or open a file
      # (readpipe, qx, %x, open modes, -n/-p) for a word list to rule out.
      return 0
    }
    function mention_ok(t, p, len,   before, after, head, tail) {
      before = p > 1 ? substr(t, p - 1, 1) : ""
      after = substr(t, p + len, 1)
      if (before ~ name_before || after ~ name_after) return 0
      if (before == "\\") return 1
      if (before ~ quote) {
        if (after != before) return 0
        head = substr(t, 1, p - 2); tail = substr(t, p + len + 1)
        sub(/[ \t]+$/, "", head); sub(/^[ \t]+/, "", tail)
        return head ~ /(endswith|endsWith|end_with\?|ends_with|hasSuffix|HasSuffix)\($|[=!]=$/ || tail ~ /^[=!]=/
      }
      # Inside a longer literal: a character that is neither blank nor a
      # quote must stand on each side, so no trimming leaves the bare suffix.
      head = substr(t, 1, p - 1); tail = substr(t, p + len)
      sub(/[ \t]+$/, "", head); sub(/^[ \t]+/, "", tail)
      return head != "" && tail != "" && substr(head, length(head)) !~ quote && substr(tail, 1, 1) !~ quote
    }
    function mentions(t,   m, k, sfx, out, p, rest, at) {
      if (t ~ /chdir|cwd|pushd|(^|[^A-Za-z0-9_])cd[ \t]/) return t
      level = tier(t)
      if (level == 0) return t
      m = split(suffixes, sfx, " ")
      for (k = 1; k <= m; k++) {
        out = ""; at = 1
        while ((p = index(substr(t, at), sfx[k])) > 0) {
          p += at - 1
          if (mention_ok(t, p, length(sfx[k]))) {
            t = substr(t, 1, p - 1) "_" substr(t, p + length(sfx[k]))
            at = p + 1
          } else at = p + length(sfx[k])
        }
      }
      return t
    }
    BEGIN {
      name_before = "[]A-Za-z0-9_./~*?-]"; name_after = "[[A-Za-z0-9_.*?-]"; quote = "[\047\"`]"
      # Mentions first: the suffix test is recognized by its method name.
      t = mentions(ENVIRON["PT_TEXT"])
      if (kind == "py" || kind == "js") t = chains(t)
      printf "%s", t
    }'
}

# The second reading of a command that is about to be blocked: print $1 with
# the program text of known tools (search_operand_spans, program mode)
# reduced to what can still name a file (program_text_residual), and each
# grep or rg pattern there replaced with `_`. Every other byte stays, so the
# scan that follows reads each file operand, option value, redirection and
# string literal as written. A program word that itself names an existing
# path is left alone, and so is everything when the directory the command
# reads from is not known.
bash_strip_program_text() (
  set -f
  pt_cmd=$1
  pt_spans=$(search_operand_spans "$pt_cmd" program) && [ -n "$pt_spans" ] || {
    printf '%s' "$pt_cmd"
    exit 0
  }
  pt_spans=$(printf '%s\n' "$pt_spans" | LC_ALL=C awk '
    /^P / { n = $3; sub(/^P /, ""); print n " " $0; next }
    /^[0-9]/ { print $1 " pat " $0 }' | sort -rn)
  # Where the shell reads relative names from is decided without the program
  # words: a `$1` or a `cd` in awk or python text moves nothing in the shell,
  # and text that changes the program's own directory keeps its suffixes
  # (program_text_residual).
  pt_shape=$(printf '%s\n' "$pt_spans" | PT_CMD=$pt_cmd LC_ALL=C awk '
    { s = NR == 1 ? ENVIRON["PT_CMD"] : s; a = $3; b = $4; s = substr(s, 1, a - 1) "_" substr(s, b + 1) }
    END { printf "%s", s }')
  pt_rebase=
  if bash_command_may_rebase_relative_paths "$pt_shape"; then
    pt_rebase=$(bash_command_rebase_target "$pt_shape") || { printf '%s' "$pt_cmd"; exit 0; }
  fi
  # shellcheck disable=SC2086
  pt_suffixes=$(program_text_bare_suffixes ${pt_rebase:+"$pt_rebase"})
  pt_ifs=$IFS
  IFS='
'
  for pt_span in $pt_spans; do
    IFS=$pt_ifs
    pt_rest=${pt_span#* }
    pt_kind=${pt_rest%% *}; pt_rest=${pt_rest#* }
    pt_start=${pt_rest%% *}; pt_rest=${pt_rest#* }
    case "$pt_kind" in
      pat) pt_end=$pt_rest pt_new=_ ;;
      *)
        pt_end=${pt_rest%% *}; pt_value=${pt_rest#* }
        [ "$pt_end" != "$pt_rest" ] || continue
        pt_exists=0
        for pt_dir in . ${pt_rebase:+"$pt_rebase"}; do
          if [ -e "$pt_dir/$pt_value" ] || [ -L "$pt_dir/$pt_value" ]; then pt_exists=1; fi
        done
        case "$pt_value" in /*) [ ! -e "$pt_value" ] && [ ! -L "$pt_value" ] || pt_exists=1 ;; esac
        [ "$pt_exists" -eq 0 ] || continue
        pt_new=$(program_text_residual "$pt_kind" "$pt_value" "$pt_suffixes") || continue
        [ "$pt_new" != "$pt_value" ] || continue
        ;;
    esac
    pt_next=$(PT_CMD=$pt_cmd PT_NEW=$pt_new LC_ALL=C awk -v a="$pt_start" -v b="$pt_end" -v kind="$pt_kind" 'BEGIN {
      s = ENVIRON["PT_CMD"]; t = ENVIRON["PT_NEW"]
      if (kind != "pat") { gsub(/\047/, "\047\\\047\047", t); t = "\047" t "\047" }
      printf "%s", substr(s, 1, a - 1) t substr(s, b + 1)
    }') && [ -n "$pt_next" ] || continue
    pt_cmd=$pt_next
  done
  IFS=$pt_ifs
  printf '%s' "$pt_cmd"
)

# Return 0 and print the matched entry when the command names a protected
# path. A command that passes costs what it did before: only once a block is
# pending is the command read a second time, with the operands that name a
# committed file replaced (git is asked only here) and the program text of
# known tools reduced to what can name a file. The rescan reads every other
# word as written.
# Print $1 for the deny patterns with each wholly quoted literal word of a
# grep, egrep, fgrep, rg or `git grep` command replaced by `''`: a search
# pattern or a file name that such a command is given runs nothing, so an
# `env|` inside a regex alternation is not a pipeline. A word qualifies only
# as one single-quoted part, or one double-quoted part holding no `$`,
# backquote or backslash; the command name must be the first word of its
# segment, every command before it inert, and everything its pipeline feeds
# a plain text filter that writes no file, since
# `grep -o` prints the pattern's text. A word that starts with `-`, or that
# follows an option not known to take no value, stays. Returns 1, and the caller keeps $1,
# when no word qualifies, when PATH holds a relative entry, or when the
# command defines or rebinds a name (a function, an alias, eval, trap,
# source, export, a PATH assignment): the search command may then be
# something else. Words are those of shell_command_words; one blank joins
# them again, which no pattern can tell from the original spacing.
bash_neutralize_search_words() {
  case "$1" in *"'"*|*'"'*) ;; *) return 1 ;; esac
  path_entries_absolute || return 1
  shell_words_marker "$1"
  sw_words=$(shell_command_words "$1") || return 1
  printf '%s\n' "$sw_words" | LC_ALL=C awk '
    function sep(v) { return v == ";" || v == "&&" || v == "||" || v == "|" || v == "&" || v == nl }
    function literal(v) {
      if (index(v, nl) || substr(v, 2, 1) == "-") return 0
      return v ~ /^\047[^\047]+\047$/ || v ~ /^"[^"$`\\]+"$/
    }
    # The word before a data word: an operand, `--`, a pattern option, or an
    # option known to take no value. Any other option may take the word as a
    # command it runs (`git grep -O`, `rg --pre`) or a file it reads (-f).
    function before_ok(p) {
      if (substr(p, 1, 1) != "-" || p == "--" || p == "--regexp" || p ~ /^--[a-z-]+=/) return 1
      if (p ~ /^--(extended-regexp|fixed-strings|perl-regexp|basic-regexp|ignore-case|line-number|files-with-matches|count|only-matching|word-regexp|recursive|invert-match|no-config|hidden)$/) return 1
      return p ~ /^-[EFGPHhilLnoqsvwxcrRaIzZbTySNuUp0]*e?$/
    }
    function plain(v) { return v ~ /^[A-Za-z0-9_.\/:@%+,=-]+$/ || v ~ /^2>(&1|\/dev\/null)$/ }
    # A later search command means what it says only while every command
    # before it is one that cannot change how the shell looks up names, as
    # in search_operand_spans: an inert command given plain or quoted
    # literal words, or `git ls-files` feeding a pipe.
    function inert_segment(a, b,   k) {
      for (k = a + 1; k <= b; k++) if (!plain(w[k]) && w[k] != "\047\047" && !literal(w[k])) return 0
      if (w[a] == "git") return a < b && w[a + 1] == "ls-files" && b < n && w[b + 1] == "|"
      return w[a] ~ /^(grep|egrep|fgrep|ls|cat|head|tail|wc|cut|tr|echo|true|false|pwd|jq|diff|comm|basename|dirname|date|sleep)$/
    }
    BEGIN { nl = "\034" }
    { w[NR] = $0 }
    END {
      n = NR; changed = 0
      for (k = 1; k <= n; k++)
        if (w[k] ~ /^(eval|alias|function|trap|source|\.|export|hash|enable|command|builtin|exec)$/ || w[k] ~ /\(\)/ || w[k] ~ /^PATH=/) exit 1
      for (s = 1; s <= n; s = e + 2) {
        for (e = s; e <= n && !sep(w[e]); e++) ;
        e--
        if (e < s) continue
        if (!(w[s] ~ /^(grep|egrep|fgrep|rg)$/ || w[s] == "git" && s < e && w[s + 1] == "grep")) {
          if (!inert_segment(s, e)) break
          continue
        }
        # The output may not reach a file or another process: no word of
        # the segment redirects anything but stderr, and each command down
        # the pipeline is a plain text filter given plain words only.
        ok = 1
        for (k = s; k <= e; k++) if (w[k] ~ /[<>]/ && !literal(w[k]) && w[k] !~ /^2>(&1|\/dev\/null)$/) ok = 0
        for (j = e + 1; ok && j <= n && w[j] == "|"; j = f) {
          if (j + 1 > n || w[j + 1] !~ /^(wc|head|tail|sort|uniq|tr|cut|nl|grep|egrep|fgrep|column|cat)$/) { ok = 0; break }
          # As in sink_ok of search_operand_spans: no long option, no sort -o.
          for (f = j + 1; f <= n && !sep(w[f]); f++)
            if (!plain(w[f]) || substr(w[f], 1, 2) == "--" || w[j + 1] == "sort" && w[f] ~ /^-[A-Za-z]*o/) ok = 0
        }
        if (ok) for (k = e; k > s; k--) if (literal(w[k]) && before_ok(w[k - 1])) { w[k] = "\047\047"; changed = 1 }
        if (!inert_segment(s, e)) break
      }
      if (!changed) exit 1
      out = ""; fresh = 1
      for (k = 1; k <= n; k++) {
        if (w[k] == nl) { out = out "\n"; fresh = 1; continue }
        v = w[k]; gsub(/\034/, "\n", v)
        out = out (fresh ? "" : " ") v; fresh = 0
      }
      printf "%s", out
    }
  '
}

# Print, one per line, the text of each wholly quoted word in a command that
# hands such a word to a shell: the word after the `-c` of sh, bash, zsh,
# dash or ksh (`bash -c`, `xargs sh -c`, `find -exec sh -c`), and every
# word of an eval, ssh, trap, watch or su command. The deny patterns anchor a command at a blank or an operator, so they
# cannot see one that starts right after a quote. Double-quoted text loses
# the backslash of an escaped `"`, `$`, backquote or backslash.
bash_shell_program_texts() {
  shell_words_marker "$1"
  pt_words=$(shell_command_words "$1") || return 1
  printf '%s\n' "$pt_words" | LC_ALL=C awk '
    function unescape(v,   r, i, c) {
      r = ""
      for (i = 1; i <= length(v); i++) {
        c = substr(v, i, 1)
        if (c == "\\" && index("\"$`\\", substr(v, i + 1, 1))) { i++; c = substr(v, i, 1) }
        r = r c
      }
      return r
    }
    function base(v) { gsub(/["\047\\]/, "", v); sub(/.*\//, "", v); return v }
    function flush(   i, j, k, v, only, all) {
      # eval, ssh, trap, watch and su run their words when they are the
      # command of the segment, past assignments and wrappers. A shell name
      # anywhere (`xargs sh -c`, `find -exec sh -c`) counts only with its
      # `-c`, and then only the next word is code: the words after it are
      # positional parameters.
      only = 0; all = 0
      for (i = 1; i <= m && (seg[i] ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || base(seg[i]) ~ /^(sudo|command|exec|time|nohup|nice|env|builtin)$/); i++) ;
      if (i <= m && base(seg[i]) ~ /^(eval|ssh|trap|watch|su)$/) all = 1
      for (k = 1; k <= m && !only; k++) if (base(seg[k]) ~ /^(sh|bash|zsh|dash|ksh)$/)
        for (j = k + 1; j <= m && substr(seg[j], 1, 1) == "-"; j++) if (seg[j] ~ /^-[A-Za-z]*c$/) { only = j + 1; break }
      if (all || only) for (k = 1; k <= m; k++) {
        if (!all && k != only) continue
        v = seg[k]
        if (v ~ /^\047[^\047]*\047$/) v = substr(v, 2, length(v) - 2)
        else if (v ~ /^"([^"\\]|\\.)*"$/) v = unescape(substr(v, 2, length(v) - 2))
        else continue
        gsub(/\034/, "\n", v)
        print v
      }
      m = 0
    }
    {
      if ($0 == ";" || $0 == "&&" || $0 == "||" || $0 == "|" || $0 == "&" || $0 == "\034") { flush(); next }
      seg[++m] = $0
    }
    END { flush() }
  '
}

# Print where ERE $2 matches in command $1, as `word N` or `words N, M`
# (three at most): the shell words of $1 counted from 1, an operator such as
# `|` or `&&` counting as a word. A position says where to look and shows no
# text of the command. Returns 1 when the match cannot be placed (no grep -o,
# or the pattern only matches after quote removal or expansion).
bash_match_words() {
  mw_offsets=$(printf '%s\n' "$1" | grep -n -o -E -e "$2" 2>/dev/null | MW_CMD=$1 LC_ALL=C awk '
    BEGIN {
      n = split(ENVIRON["MW_CMD"], L, "\n"); base[1] = 0
      for (k = 1; k <= n; k++) base[k + 1] = base[k] + length(L[k]) + 1
    }
    {
      c = index($0, ":"); ln = substr($0, 1, c - 1) + 0; m = substr($0, c + 1)
      if (ln < 1 || ln > n || m == "") next
      if (ln != last) { from = 1; last = ln }
      p = index(substr(L[ln], from), m)
      if (!p) next
      p += from - 1; from = p + length(m)
      # The first character of the match that belongs to a word.
      for (j = 1; j <= length(m) && index(" \t;|&(`", substr(m, j, 1)); j++) ;
      if (j > length(m)) j = 1
      print base[ln] + p + j - 1
      if (++shown == 3) exit
    }') || return 1
  [ -n "$mw_offsets" ] || return 1
  shell_words_marker "$1"
  mw_list= mw_count=0
  for mw_offset in $mw_offsets; do
    mw_prefix=$(MW_CMD=$1 LC_ALL=C awk -v n="$mw_offset" 'BEGIN { printf "%s", substr(ENVIRON["MW_CMD"], 1, n) }')
    mw_word=$(shell_command_words "$mw_prefix" | LC_ALL=C awk '$0 != "\034" { n++ } END { print n + 0 }') || return 1
    case ", $mw_list," in
      *", $mw_word,"*) ;;
      *) mw_list=${mw_list:+"$mw_list, "}$mw_word; mw_count=$((mw_count + 1)) ;;
    esac
  done
  case "$mw_count" in
    0) return 1 ;;
    1) printf 'word %s' "$mw_list" ;;
    *) printf 'words %s' "$mw_list" ;;
  esac
}

# Print, one per line, each segment of the one-line command $1 that is a
# plain cp, mv or mkdir: the name, single-letter options and relative operands
# made of name characters and brace groups, between `&&` or `;` on both
# sides, with no redirection. Such a command cannot put a file where a later
# command name is looked up: PATH holds only absolute entries, none of them
# under the directory the scan runs in, nothing on the line changes
# directory, and no operand is absolute or can reach a parent directory (a
# brace group can spell `..` from two single dots, so a dot next to a brace
# or comma is refused). Returns 1 when there is none.
bash_file_mover_segments() {
  case "$1" in
    *'
'*|*'<<'*) return 1 ;;
  esac
  case "$1" in *'&&'*|*';'*) ;; *) return 1 ;; esac
  case "$1" in *'cp '*|*'mv '*|*'mkdir '*) ;; *) return 1 ;; esac
  path_entries_absolute || return 1
  case ":$PATH:" in *":$PWD:"*|*":$PWD/"*) return 1 ;; esac
  shell_words_marker "$1"
  fm_words=$(shell_command_words "$1") || return 1
  printf '%s\n' "$fm_words" | LC_ALL=C awk '
    function ok_word(v) {
      if (v !~ /^[A-Za-z0-9_.\/@%+,{}-]+$/) return 0
      if (substr(v, 1, 1) == "-") return v ~ /^-[A-Za-z]+$/
      return !(substr(v, 1, 1) == "/" || v ~ /\.[{},]*\./ || v ~ /[{,][.\/]/ || v ~ /\.[,}]/)
    }
    function sep(v) { return v == ";" || v == "&&" || v == "||" || v == "|" || v == "&" }
    { w[NR] = $0 }
    END {
      for (k = 1; k <= NR; k++) if (w[k] ~ /^(cd|pushd|popd)$/) exit 1
      # No operand may hold the name of a command the line runs, as the file
      # `cp tool bin/grep` writes would.
      for (k = 1; k <= NR; k++) if (k == 1 || sep(w[k - 1])) { v = w[k]; sub(/.*\//, "", v); head[v] = 1 }
      found = 0
      for (s = 1; s <= NR; s = e + 2) {
        for (e = s; e <= NR && !sep(w[e]); e++) ;
        e--
        if (e <= s || w[s] !~ /^(cp|mv|mkdir)$/) continue
        if (e + 1 > NR || w[e + 1] != "&&" && w[e + 1] != ";") continue
        if (s > 1 && w[s - 1] != "&&" && w[s - 1] != ";") continue
        good = 1; line = w[s]
        for (k = s + 1; k <= e; k++) {
          if (!ok_word(w[k])) good = 0
          m = split(w[k], part, /[\/{},]/)
          for (j = 1; j <= m; j++) if (part[j] in head) good = 0
          line = line " " w[k]
        }
        if (good) { print line; found = 1 }
      }
      exit !found
    }
  '
}

# Print $1 with each segment of $2 (bash_file_mover_segments) replaced by a
# `true` command carrying a marker word ($3 = out), or with those markers
# replaced by the segments again ($3 = in). Returns 1 when a segment or a
# marker is not found as written.
bash_file_mover_swap() {
  FM_CMD=$1 FM_SEGMENTS=$2 LC_ALL=C awk -v dir="$3" 'BEGIN {
    s = ENVIRON["FM_CMD"]; n = split(ENVIRON["FM_SEGMENTS"], seg, "\n")
    for (k = 1; k <= n; k++) {
      mark = "true agent-guard-file-mover-" k
      from = dir == "out" ? seg[k] : mark
      to = dir == "out" ? mark : seg[k]
      p = index(s, from)
      if (!p) exit 1
      s = substr(s, 1, p - 1) to substr(s, p + length(from))
    }
    printf "%s", s
  }'
}

# Print the pending deny-path report, with the place of the match in command
# $1 when it can be found there.
deny_path_report_print() {
  [ -n "$deny_path_report" ] || return 0
  if [ -n "${deny_path_regex-}" ] && deny_path_where=$(bash_match_words "$1" "$deny_path_regex"); then
    deny_path_report="$deny_path_report at $deny_path_where of the command"
  fi
  printf '%s\n' "$deny_path_report"
}

bash_matches_deny_path() {
  deny_path_report=
  bash_deny_path_scan "$1" || return "$?"
  # $2 is the hook input. It is read for the event workdir only here, once a
  # block is pending. Without a workdir a relative word cannot be placed (the
  # hook's own directory need not be the shell's), and the block stands.
  if [ -z "${2-}" ] || ! exception_workdir_is_here "$2"; then
    deny_path_report_print "$1"
    return 0
  fi
  tfx_cmd=$1
  if [ "${AGENT_GUARD_TRACKED_FILE_EXCEPTION-on}" = on ]; then
    tfx_cmd=$(bash_strip_tracked_file_operands "$1") && [ -n "$tfx_cmd" ] || tfx_cmd=$1
  fi
  tfx_text=$(bash_strip_program_text "$tfx_cmd") && [ -n "$tfx_text" ] || tfx_text=$tfx_cmd
  if [ "$tfx_text" != "$1" ]; then
    deny_path_report=
    bash_deny_path_scan "$tfx_text" || return "$?"
  fi
  deny_path_report_print "$1"
  return 0
}

bash_deny_path_scan() {
  deny_cmd=$1
  case "$deny_cmd" in
    *"\\
"*) deny_cmd=$(shell_join_line_continuations "$deny_cmd") ;;
  esac
  deny_cmd=$(bash_strip_heredoc_bodies "$deny_cmd")
  deny_cmd=$(bash_strip_echo_literal_text "$deny_cmd")
  # A plain cp, mv or mkdir before a search or message command stands aside
  # as `true` while the two exemptions below decide what is data, and comes
  # back right after them, so its own operands are scanned as written.
  deny_movers=
  if deny_movers=$(bash_file_mover_segments "$deny_cmd") && [ -n "$deny_movers" ]; then
    deny_with_movers=$deny_cmd
    deny_cmd=$(bash_file_mover_swap "$deny_cmd" "$deny_movers" out) \
      || { deny_cmd=$deny_with_movers; deny_movers=; }
  else
    deny_movers=
  fi
  # A failed rewrite keeps the whole command in the scan.
  # The deny-pattern check already stripped the same text (it depends on
  # nothing but the text), so reuse that result.
  if [ "${mv_strip_in+set}" = set ] && [ "$deny_cmd" = "$mv_strip_in" ]; then
    deny_cmd=$mv_strip_out
  else
    deny_stripped=$(bash_strip_message_values "$deny_cmd") && deny_cmd=$deny_stripped
  fi
  deny_stripped=$(bash_strip_non_read_operands "$deny_cmd") && deny_cmd=$deny_stripped
  if [ -n "$deny_movers" ]; then
    deny_cmd=$(bash_file_mover_swap "$deny_cmd" "$deny_movers" in) || deny_cmd=$deny_with_movers
  fi
  deny_pre_jq=$deny_cmd
  deny_cmd=$(bash_neutralize_jq_field_names "$deny_cmd")
  # Kept only when field names were dropped (see the dot-command test there).
  [ "$deny_cmd" != "$deny_pre_jq" ] || deny_pre_jq=
  deny_cmd=$(bash_neutralize_runtime_globals "$deny_cmd")
  deny_cmd=$(bash_strip_source_module_prose "$deny_cmd")
  deny_cmd=$(bash_strip_exclusion_operands "$deny_cmd")
  deny_cmd=$(bash_strip_allowed_tokens "$deny_cmd")
  bash_matches_deny_path_mode "$deny_cmd" "literal" && return 0
  # Brackets that bash keeps literal are not globs, so both shell-expanded
  # passes read a copy in which they no longer look like bracket expressions.
  # Only a `[` followed by a quote can be a subscript, and only a quoted
  # interpreter, jq or awk program with a glob character can need rewriting, so
  # any other command is scanned as it is and costs no extra process. A failed or empty rewrite
  # scans the original text, never nothing.
  neutral_cmd=$deny_cmd
  neutral_wanted=
  case "$deny_cmd" in
    *'["'*|*"['"*) neutral_wanted=1 ;;
    *"'"*)
      case "$deny_cmd" in
        *python*|*node*|*bun*|*jq*|*awk*)
          case "$deny_cmd" in *'['*|*'*'*|*'?'*) neutral_wanted=1 ;; esac
          ;;
      esac
      ;;
  esac
  if [ -n "$neutral_wanted" ]; then
    neutral_cmd=$(shell_neutralize_quoted_brackets_for_policy "$deny_cmd" "$deny_pre_jq") || neutral_cmd=
    [ -n "$neutral_cmd" ] || neutral_cmd=$deny_cmd
  fi
  bash_matches_deny_path_mode "$neutral_cmd" "shell-expanded" && return 0
  dequoted=$(shell_dequote_for_policy "$deny_cmd")
  [ "$dequoted" = "$deny_cmd" ] && return 1
  bash_matches_deny_path_mode "$dequoted" "literal" && return 0
  dequoted_sx=$dequoted
  if [ "$neutral_cmd" != "$deny_cmd" ]; then
    dequoted_sx=$(shell_dequote_for_policy "$neutral_cmd") || dequoted_sx=
    [ -n "$dequoted_sx" ] || dequoted_sx=$dequoted
  fi
  bash_matches_deny_path_mode "$dequoted_sx" "shell-expanded" && return 0
  case "$deny_cmd" in *"\$'"*) ;; *) return 1 ;; esac
  decoded=$(shell_decode_ansi_c_for_policy "$deny_cmd")
  bash_matches_deny_path_mode "$decoded" "literal" && return 0
  bash_matches_deny_path_mode "$decoded" "shell-expanded"
}

is_shell_command_separator() {
  case "$1" in
    ';'|'&&'|'||'|'|') return 0 ;;
    *) return 1 ;;
  esac
}

# Set SHELL_WORD_NL to the byte shell_command_words writes for a newline in
# $1. Text without a newline yields no such byte, so a newline, which no word
# holds, stands in for it there and costs no process.
shell_words_marker() {
  SHELL_WORD_NL='
'
  case "$1" in *"$SHELL_WORD_NL"*) SHELL_WORD_NL=$(printf '\034') ;; esac
}

# Print the words of $1 one per line, split where the shell splits them: at
# blanks and at the operators `;`, `|`, `||`, `&&` and a lone `&` (not the
# `&` of `2>&1` or `&>`), each printed as a word of its own. Quotes, a
# backslash escape and `$(...)`, `${...}`, `<(...)`, `>(...)` or backquotes
# stay inside their word as written. A comment splits only at blanks, so its
# apostrophes and operators change nothing. An unquoted newline is the word "$SHELL_WORD_NL", and a newline
# inside a word is written as that byte too. An unclosed quote runs to the
# end. Returns 1 when $1 already holds that byte. Callers set the byte with
# shell_words_marker first.
shell_command_words() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    function flush() { if (w != "") print w; w = "" }
    function push(k) { st = st k }
    { t = (NR == 1) ? $0 : t "\n" $0 }
    END {
      n = length(t); nl = "\034"; w = ""; st = ""
      if (index(t, nl)) exit 1
      for (i = 1; i <= n; i++) {
        c = substr(t, i, 1); nx = substr(t, i + 1, 1); top = substr(st, length(st))
        if (cm) {
          if (c == "\n") { cm = 0; flush(); print nl }
          else if (c == " " || c == "\t") flush()
          else w = w c
          continue
        }
        if (top == "S" || top == "A" || top == "Q" || top == "D") {
          if (c == "\n") c = nl
          if (top != "S" && c == "\\" && i < n) {
            w = w c (nx == "\n" ? nl : nx); i++; continue
          }
          if ((top == "S" || top == "A") && c == "\047" || top == "Q" && c == "`" || top == "D" && c == "\"") {
            st = substr(st, 1, length(st) - 1)
          } else if (top == "D" && c == "$" && nx == "$") {
            w = w c nx; i++; continue
          } else if (top == "D" && c == "$" && (nx == "(" || nx == "{")) {
            push(nx == "(" ? "P" : "B"); w = w c nx; i++; continue
          } else if (top == "D" && c == "`") push("Q")
          w = w c
          continue
        }
        if (top == "") {
          if (c == " " || c == "\t") { flush(); continue }
          if (c == "\n") { flush(); print nl; continue }
          if (c == ";") { flush(); print c; continue }
          if (c == "|") { flush(); if (nx == "|") { print "||"; i++ } else print c; continue }
          if (c == "&" && nx == "&") { flush(); print "&&"; i++; continue }
          if (c == "&" && nx != ">" && w !~ /[<>]$/) { flush(); print c; continue }
          if (c == "#" && w == "") { cm = 1; w = c; continue }
        } else if (c == "\n") c = nl
        else if (top == "P" && c == ")" || top == "B" && c == "}") st = substr(st, 1, length(st) - 1)
        else if (top == "P" && c == "(") push("P")
        if (c == "\\" && i < n) { w = w c (nx == "\n" ? nl : nx); i++; continue }
        # `$$` is one parameter: `$$'...'` is a plain quote.
        if (c == "$" && nx == "$") { w = w c nx; i++; continue }
        if (c == "$" && nx == "\047") { push("A"); w = w c nx; i++; continue }
        if ((c == "$" || c == "<" || c == ">") && nx == "(" || c == "$" && nx == "{") {
          push(nx == "(" ? "P" : "B"); w = w c nx; i++; continue
        }
        if (c == "\047") push("S")
        else if (c == "\"") push("D")
        else if (c == "`") push("Q")
        w = w c
      }
      flush()
    }
  '
}

# Append word $1 of shell_command_words to $result, after a blank unless it
# is the first word or a newline word is on either side; shell_words_nl
# carries that between calls. It runs once per word, so it uses case and
# parameter expansion: a `[` per word cost the Bash pre-tool path 6% (#595).
shell_words_append() {
  case $1 in
    "$SHELL_WORD_NL") result=$result$1 shell_words_nl=1 ;;
    *)
      case $shell_words_nl in
        1) result=$result$1 shell_words_nl= ;;
        *) result=${result:+"$result "}$1 ;;
      esac
      ;;
  esac
}

# Print a result of shell_words_append with its newlines restored.
shell_words_print() {
  case "$1" in
    *"$SHELL_WORD_NL"*) printf '%s' "$1" | tr '\034' '\n' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Tokenize only enough POSIX shell syntax to locate git and its cwd-changing
# options without executing the command. Each record is prefixed with 0 for a
# literal token, 4 for one that shell expansion yields as exactly one word
# (every expansion is double-quoted and cannot split, like "$x" or "$(cmd)"),
# or 1 for one whose expansion may split into several words, or into none;
# malformed input is emitted as 2. A quoted or escaped `;`, `&&`, `||` or `|`
# is a 4 too, so that no caller mistakes it for the operator. With $2 set to
# gate (the commit/push gate, git_gate_code_records), so is a word after a `cd` or `pushd` command name (past any
# assignment-shaped words, quoted or not) that starts with `~` and has a
# quoted or escaped part before its first unquoted `/`: only an unquoted tilde
# prefix expands to $HOME alike in every shell (zsh expands `~"/x"`). Also with
# gate, a command-position word shaped like `NAME=value` with a quoted or
# escaped part before its first unquoted `=` is emitted as 5: the shell runs
# it as a command name, not an assignment, and whatever it expands to still
# starts with that literal `NAME=`. It is a 6 instead when an unquoted
# expansion or glob character may make it no word at all (nullglob). With
# gate, the code of each command substitution inside double quotes in a word
# follows that word as one record with prefix 7, each substitution's code
# wrapped as `( code` and `)` lines and every newline written as \034; only
# git_gate_records reads it. Unquoted substitutions, in a word or in a
# here-document body, get the same record. A bare `&` or a `( ) { }` character is emitted on its own with
# prefix 3: a command boundary for most callers, but the commit argument parser
# must tell `2>&1` and brace expansion apart from the end of the command. Newlines cannot be represented safely in the record stream, so
# they make the affected token dynamic and therefore subject to infra policy.
# Comments are dropped. A here-document body is still tokenized, since it may
# be code for another shell, but is wrapped in `3(` and `3)`: nothing in it
# runs in this shell. With gate, a body that cat, tee, python, gh or git
# commit reads, and nothing else on the line can, is wrapped in `3[` and `3]`
# instead: none of them runs it as shell code. Behind an unquoted delimiter
# the code of its substitutions follows the body as 7 records, since this
# shell runs it either way. Python code is outside the gate already, as `python3 -c` and
# `python3 script.py` are. git_gate_records decides what such a body is.
git_command_records() {
  printf '%s\n' "$1" | LC_ALL=C awk -v gate="${2:-}" '
    BEGIN { heredoc_next = 1 }
    # A pipe, a subshell or a background job on the line may hand a
    # here-document to a shell after all.
    function stdin_shared(  h) {
      for (h = line_heredocs + 1; h <= heredoc_count; h++) heredoc_inert[h] = 0
    }
    # The body of $(( expr )) is arithmetic, not a command: read it as the
    # arguments of `:` so that only the substitutions in it run as code.
    # $((cmd) ) is a subshell in a substitution and stays one.
    function arith_body(b,   k, d, ch, q) {
      if (!body_dollar || substr(b, 1, 1) != "(" || b ~ /[\\`]/) return b
      d = 0; q = ""
      for (k = 1; k <= length(b); k++) {
        ch = substr(b, k, 1)
        if (q != "") { if (ch == q) q = ""; continue }
        if (ch == "\047" || ch == "\"") q = ch
        else if (ch == "(") d++
        else if (ch == ")" && --d == 0 && k < length(b)) return b
      }
      return d == 0 && q == "" ? "( :" substr(b, 2) : b
    }
    function emit() {
      if (!started) return
      if (heredoc_expect) {
        delim = substr(word, heredoc_mark + 1)
        heredoc_mark = 0
        if (delim != "" || heredoc_quoted) {
          # 1: text; 2: text the shell expands, so the code of its
          # substitutions runs either way. gh reads its stdin as a body or
          # JSON input, except for a --shell alias, and git commit as a
          # message.
          hb = head; sub(/.*\//, "", hb)
          heredoc_inert[heredoc_count + 1] = gate != "" && (hb ~ /^(cat|tee|python|python3|gh)$/ && head_sub != "alias" || head_sub == "commit") ? (heredoc_quoted ? 1 : 2) : 0
          heredoc_quoted = 0
          heredoc_delim[++heredoc_count] = delim
          heredoc_strip[heredoc_count] = heredoc_dash
          heredoc_expect = 0
        }
      }
      if (gate != "" && !at_word && name_quoted && word ~ /^[A-Za-z_][A-Za-z0-9_]*=/) print (splits || globbed ? "6" : "5") word
      else print (splits ? "1" : dynamic || word ~ /^(;|&&|\|\||\|)$/ || gate != "" && cd_args && quoted && word ~ /^~/ ? "4" : "0") word
      if (code != "") {
        if (heredoc_open && heredoc_inert[heredoc_next] == 2) body_code = body_code "7" code "\n"
        else print "7" code
        code = ""
      }
      last_word = word
      if (!at_word && (word !~ /^[A-Za-z_][A-Za-z0-9_]*=/ || name_quoted)) head = dynamic || splits || quoted ? "" : word
      if (!at_word && (word == "cd" || word == "pushd")) cd_args = 1
      if (at_word && (head ~ /(^|\/)git$/ && word == "commit" || head ~ /(^|\/)gh$/ && word == "alias")) head_sub = word
      if (word !~ /^[A-Za-z_][A-Za-z0-9_]*=/ || name_quoted) at_word = 1
      if (word == "[[") in_test = 1
      if (word == "]]") in_test = 0
      word = ""; started = 0; dynamic = 0; splits = 0; quoted = 0; slashed = 0; name_quoted = 0; equaled = 0; globbed = 0
    }
    # A backslash-newline outside quotes and here-documents joins two lines.
    NR > 1 && !joined {
      if (quote == "") { emit(); print "0;"; cd_args = 0; at_word = 0; head = ""; head_sub = "" }
      else { stdin_shared(); word = word (gate != "" && quote ~ /^(double|subst)$/ ? "\034" : " "); dynamic = 1 }
      heredoc_expect = 0; heredoc_quoted = 0
      line_heredocs = heredoc_count
    }
    { joined = 0 }
    nest_hd != "" && NR > nest_hd_line {
      line = $0
      if (nest_hd_strip) sub(/^\t+/, "", line)
      if (line == nest_hd) nest_hd = ""
      word = word $0
      next
    }
    heredoc_next <= heredoc_count && NR > heredoc_line {
      line = $0
      if (heredoc_strip[heredoc_next]) sub(/^\t+/, "", line)
      if (line != heredoc_delim[heredoc_next]) {
        if (!heredoc_open) { print heredoc_inert[heredoc_next] ? "3[" : "3("; heredoc_open = 1 }
      } else {
        if (quote != "") { quote = ""; nest = ""; dynamic = 1; splits = 1 }
        emit()
        if (heredoc_open) { print heredoc_inert[heredoc_next] ? "3]" : "3)"; heredoc_open = 0 }
        printf "%s", body_code; body_code = ""
        heredoc_next++
        next
      }
    }
    {
      in_heredoc = heredoc_next <= heredoc_count && NR > heredoc_line
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        n = substr($0, i + 1, 1)
        if (quote == "single") {
          if (c == "\047") quote = ""
          else word = word c
          started = 1
          continue
        }
        # Inside a command substitution (in double quotes, or unquoted in
        # gate mode): quoting, nesting, a case pattern and a here-document
        # follow shell rules, so that the substitution ends where the shell
        # ends it.
        if (quote ~ /^(double|subst)$/ && nest != "") {
          top = substr(nest, length(nest))
          word = word c
          if (top == "s") { if (c == "\047") nest = substr(nest, 1, length(nest) - 1) }
          else if (c == "\\") { word = word n; i++ }
          else if (top == "b") { if (c == "`") nest = substr(nest, 1, length(nest) - 1) }
          else if (top == "d" && c == "\"") nest = substr(nest, 1, length(nest) - 1)
          else if (c == "$" && n == "(") { word = word n; i++; nest = nest "p" }
          else if (c == "`") nest = nest "b"
          else if (top == "d") ;
          else if (c == "\047") nest = nest "s"
          else if (c == "\"") nest = nest "d"
          else if (c == "(") nest = nest "p"
          else if (c == ")" && top == "p") nest = substr(nest, 1, length(nest) - 1)
          else if (substr($0, i, 4) ~ /^(case|esac)$/ && (i == 1 || substr($0, i - 1, 1) ~ /[ \t;&|(]/) \
              && substr($0, i + 4, 1) ~ /^[ \t;)]?$/) {
            word = word substr($0, i + 1, 3)
            if (c == "c") nest = nest "c"
            else if (top == "c") nest = substr(nest, 1, length(nest) - 1)
            i += 3
          } else if (c == "<" && n == "<" && substr($0, i + 2, 1) != "<") {
            rest = substr($0, i + 2)
            nest_hd_strip = rest ~ /^-/
            sub(/^-?[ \t]*/, "", rest)
            match(rest, /^[^ \t;&|()<>]*/)
            nest_hd = substr(rest, 1, RLENGTH)
            gsub(/["\047\\]/, "", nest_hd)
            nest_hd_line = NR
          }
          if (nest == "") {
            code = code "( " arith_body(substr(word, body_start, length(word) - body_start)) "\034)\034"
            if (quote == "subst") quote = ""
          }
          continue
        }
        if (quote == "double") {
          if (c == "\"") { quote = ""; started = 1; continue }
          # `"` needs no backslash inside a bracket expression, and `\"` is not
          # a defined escape there: gawk warns on every hook run and another awk
          # is free to read the class differently. `\\` already puts a literal
          # backslash in the set, so the class is unchanged (#99).
          if (c == "\\" && n ~ /^["\\$`]$/) {
            word = word n; started = 1; i++; continue
          }
          if (gate != "" && (c == "`" || c == "$" && n == "(")) {
            word = word c
            if (c == "$") { word = word n; i++ }
            nest = c == "`" ? "b" : "p"
            body_start = length(word) + 1; body_dollar = c == "$"
            dynamic = 1; started = 1
            continue
          }
          if (c == "$" || c == "`") dynamic = 1
          # "$@", "${a[@]}", "${!a@}", zsh "$a[@]" and "${(f)a}" still split;
          # "${a:-b c}" does not.
          if (c == "$" && substr($0, i) !~ /^\$([A-Za-z_][A-Za-z0-9_]*([^A-Za-z0-9_[]|$)|[0-9*#?$!-]|\{#?([A-Za-z_][A-Za-z0-9_]*|[0-9]+)[^}@[]*\}|\()/) splits = 1
          word = word c; started = 1
          continue
        }
        if (c == " " || c == "\t") { emit(); continue }
        # Unquoted, a substitution splits into words and its code is hoisted
        # as in double quotes; the word stays an argument of its command.
        if (gate != "" && (c == "`" || c == "$" && n == "(")) {
          word = word c
          if (c == "$") { word = word n; i++ }
          nest = c == "`" ? "b" : "p"; quote = "subst"
          body_start = length(word) + 1; body_dollar = c == "$"
          dynamic = 1; splits = 1; started = 1
          continue
        }
        # In a here-document body a quote or a `#` is text; a substitution
        # in it still runs.
        # `#` opens a comment only where a word starts; `${#x}` and `a#b` do not,
        # nor does `$(x)#y`, but `(x)#y` does.
        if (c == "#" && !started && !in_heredoc && (i == 1 || substr($0, i - 1, 1) ~ /[ \t;&|(]/ \
            || (substr($0, i - 1, 1) == ")" && closed == "s"))) break
        if ((c == "\047" || c == "\"") && !in_heredoc) {
          # An empty quoted word after << is a valid delimiter.
          if (heredoc_expect) heredoc_quoted = 1
          quote = c == "\047" ? "single" : "double"; started = 1; if (!slashed) quoted = 1; if (!equaled) name_quoted = 1; continue
        }
        if (c == "\\") {
          if (i == length($0)) {
            if (!in_heredoc && !heredoc_expect && heredoc_count == line_heredocs) { joined = 1; continue }
            # The command goes on past the line the body seems to start on.
            stdin_shared(); dynamic = 1; splits = 1; started = 1; continue
          }
          if (heredoc_expect) heredoc_quoted = 1
          word = word n; started = 1; if (!slashed) quoted = 1; if (!equaled) name_quoted = 1; i++; continue
        }
        if (c == "<" && n == "<" && !in_heredoc) {
          if (substr($0, i + 2, 1) == "<") { word = word "<<<"; started = 1; i += 2; continue }
          word = word "<<"; started = 1; i++
          heredoc_dash = substr($0, i + 1, 1) == "-"
          if (heredoc_dash) { word = word "-"; i++ }
          heredoc_expect = 1; heredoc_mark = length(word); heredoc_line = NR
          continue
        }
        if (c == ";" || c == "|" || (c == "&" && n == "&")) {
          emit()
          if (c == "|" && n != "|") stdin_shared()
          if ((c == "|" || c == "&") && n == c) { print "0" c c; i++ }
          else print "0" c
          cd_args = 0; at_word = 0; head = ""; head_sub = ""
          continue
        }
        # Bare &, newline-free ( ) { } grouping: treat as a command boundary so
        # a git commit/push after one is still seen as a command head (#127).
        # Over-splitting can only cause MORE detection, never less.
        if (c == "&" || c == "(" || c == ")" || c == "{" || c == "}") {
          # A `(` that starts a word opens a subshell; `$(`, `<(`, `@(` and a
          # group in a `[[ =~ ]]` pattern do not.
          if (c == "(") parens = parens (started || in_test ? "w" : "s")
          if (c == ")") { closed = substr(parens, length(parens)); parens = substr(parens, 1, length(parens) - 1) }
          emit()
          redirect = c == "&" && redir_at == NR ":" (i - 1)
          if (c == "(" || c == ")" || c == "&" && !redirect) stdin_shared()
          # fd_dup_amp reads a `&` after a word ending in > or < as the `&`
          # of `2>&1`; after a quoted or escaped > it backgrounds, so it gets
          # a second one.
          if (c == "&" && !redirect && last_word ~ /[<>]$/) print "3&"
          print "3" c; cd_args = 0; at_word = 0; head = ""; head_sub = ""; continue
        }
        if (c == "$" || c == "`") { dynamic = 1; splits = 1 }
        if (c == "/") slashed = 1
        if (c == "=") equaled = 1
        if (index("*?[", c)) globbed = 1
        if (c == ">" || c == "<") redir_at = NR ":" i
        word = word c; started = 1
      }
    }
    END {
      if (quote != "") print "2"
      else emit()
      if (body_code != "") { if (heredoc_open) print "3]"; printf "%s", body_code }
    }
  '
}

# The records of $1 for the commit/push gate: git_command_records in gate
# mode, where the code of each command substitution inside a quoted word, as
# in `echo "$(git commit)"`, runs in a ( ) subshell placed before the command
# that word belongs to. Code that cannot be read back runs as a command only
# run time knows.
git_gate_records() (
  set -f
  gate_records=$(git_gate_code_records "$1")
  case "$gate_records" in
    *'
3['*) ;;
    *)
      printf '%s\n' "$gate_records"
      exit 0
      ;;
  esac
  # A here-document body in `3[` and `3]` is text unless a command of the
  # line may run what it wrote: a shell, a wrapper, a name only run time
  # knows, or a path whose file name another word of the line also names, as
  # the file a here-document is written to is. Code a shell or a git alias
  # runs (gate_child_code) may follow a script the outer line wrote.
  printf '%s\n' "$gate_records" | LC_ALL=C awk -v runner="${gate_child_code:-0}" "$AWK_RECORD_SEPARATOR"'
    { rec[++n] = $0 }
    END {
      # File names the line gives as words other than a command name.
      head = 1
      for (k = 1; k <= n; k++) {
        r = rec[k]; t = substr(r, 2)
        if (record_separator(r) || r ~ /^3/) { head = 1; continue }
        if (head && t !~ /^[A-Za-z_][A-Za-z0-9_]*=/) { head = 0; continue }
        sub(/^[0-9]*[<>&|]+/, "", t); sub(/.*\//, "", t)
        named[tolower(t)]++
      }
      head = 1
      for (k = 1; k <= n && runner == 0; k++) {
        r = rec[k]; kind = substr(r, 1, 1); t = substr(r, 2)
        if (r == "3[") { body++; continue }
        if (r == "3]") { body--; continue }
        if (body) continue
        if (record_separator(r) || kind == "3") { head = 1; continue }
        if (!head || kind ~ /[014]/ && t ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
        head = 0
        b = t; sub(/.*\//, "", b)
        # A shell given a script file no other word names runs that file, not
        # what the line wrote.
        # A file system may fold case, and a glob or brace may match it.
        nb = substr(rec[k + 1], 2); sub(/.*\//, "", nb)
        if (b ~ /^(sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish)$/ \
            && rec[k + 1] ~ /^0[^-;&|<>]/ && nb !~ /[*?[{]/ && named[tolower(nb)] == 1) continue
        if (kind != "0" || t ~ /\// && (named[tolower(b)] || b ~ /[*?[{]/) || b ~ /^(sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish|eval|source|\.|exec|coproc|trap|alias|env|command|builtin|sudo|doas|su|nice|nohup|time|timeout|xargs|watch|script|parallel)$/) runner = 1
      }
      body = 0
      for (k = 1; k <= n; k++) {
        r = rec[k]
        if (runner && r == "3[") r = "3("
        else if (runner && r == "3]") r = "3)"
        else if (r == "3[") { body++; continue }
        else if (r == "3]") { body--; continue }
        if (!body) print r
      }
    }'
)

# git_gate_records without its here-document decision, which needs the whole
# line.
git_gate_code_records() (
  set -f
  gate_records=$(git_command_records "$1" gate)
  case "$gate_records" in
    7*|*'
7'*) ;;
    *)
      printf '%s\n' "$gate_records"
      exit 0
      ;;
  esac
  gate_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $gate_records
  IFS=$gate_ifs
  gate_segment=
  gate_code=
  gate_prev=
  gate_flush() {
    if [ -n "$gate_code" ]; then
      gate_sub=$(git_gate_code_records "$gate_code")
      if printf '%s\n' "$gate_sub" \
        | LC_ALL=C awk '$0 == "2" { exit 1 } $0 == "3(" { d++ } $0 == "3)" && --d < 0 { exit 1 } END { if (d) exit 1 }'; then
        printf '%s\n' "$gate_sub"
      else
        printf '3(\n1$\n3)\n'
      fi
    fi
    printf '%s' "$gate_segment"
    gate_segment=
    gate_code=
  }
  while [ "$#" -gt 0 ]; do
    gate_record=$1
    shift
    gate_end=0
    case "$gate_record" in
      7*)
        gate_code="$gate_code$(printf '%s' "${gate_record#7}" | tr '\034' '\n')
"
        continue
        ;;
      0';'|0'&&'|0'||'|0'|'|3'('|3')'|3'['|3']') gate_end=1 ;;
      # Not the `&` of `2>&1` or `&>log`.
      3'&')
        case "$gate_prev:${1-}" in
          *'>:'*|*'<:'*|*:0'>'*|*:0'<'*) ;;
          *) gate_end=1 ;;
        esac
        ;;
    esac
    if [ "$gate_end" -eq 1 ]; then
      gate_flush
      printf '%s\n' "$gate_record"
    else
      gate_segment="$gate_segment$gate_record
"
    fi
    gate_prev=$gate_record
  done
  gate_flush
)

# A sourced script runs in this shell and may change cwd where no command text
# shows it (`. ./switch.sh; cat env.py`). Look for `.`/`source` where a command
# starts, past assignments and the builtin/command/eval/time/! prefixes.
bash_command_sources_script() (
  set -f
  source_records=$(git_command_records "$1")
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $source_records
  IFS=$old_ifs

  source_command_start=1
  for source_record in "$@"; do
    case "$source_record" in
      3*) source_command_start=1; continue ;;
    esac
    case "${source_record#?}" in
      ';'|'&&'|'||'|'|') source_command_start=1 ;;
      .|source) [ "$source_command_start" -eq 1 ] && return 0 ;;
      [A-Za-z_]*=*|builtin|command|eval|time|'!') ;;
      *) source_command_start=0 ;;
    esac
  done
  return 1
)

# Classify word $1 of a command whose -C or -D option owner is $2 by how it
# moves the cwd later relative operands resolve against, in cwd_change:
#   cd     the next word is the directory (cd, pushd)
#   next   an option whose next word is the directory
#   value  an option holding the directory, set in cwd_change_value
#   owner  a command whose -C or -D option changes directory
#   any    a change no static word names (popd, chroot, find -execdir)
#   empty  none
# Command names match by file name, options as the whole word: the value of
# `--chdir=/srv/app` or `-C/srv/app` holds a slash. A word that is no option
# but whose file name looks like one stays an unknown change, as before.
bash_cwd_change() {
  cwd_change=
  cwd_change_value=
  case "${1##*/}" in
    cd|pushd) cwd_change=cd; return 0 ;;
    popd|chroot) cwd_change=any; return 0 ;;
    env|tar|git|make|ninja|cmake|sudo|find) cwd_change=owner; return 0 ;;
  esac
  case "$1" in
    -execdir|-execdir=*) cwd_change=any ;;
    --chdir|--directory) cwd_change=next ;;
    --chdir=*|--directory=*)
      cwd_change=value
      cwd_change_value=${1#*=}
      ;;
    -C|-C?*|-D|-D?*)
      case "${1%"${1#-?}"}:$2" in
        -C:env|-C:tar|-C:git|-C:make|-C:ninja|-C:cmake|-D:sudo) ;;
        *) return 0 ;;
      esac
      case "$1" in
        -?) cwd_change=next ;;
        *)
          cwd_change=value
          cwd_change_value=${1#-?}
          ;;
      esac
      ;;
    */*)
      case "${1##*/}" in
        -execdir|-execdir=*|--chdir|--chdir=*|--directory|--directory=*) cwd_change=any ;;
        -C|-C?*) case "$2" in env|tar|git|make|ninja|cmake) cwd_change=any ;; esac ;;
        -D|-D?*) [ "$2" = sudo ] && cwd_change=any ;;
      esac
      ;;
  esac
  return 0
}

# A relative template token can be resolved safely only when the command keeps
# the event workdir as its path base. Refuse the exception when shell syntax is
# dynamic or a command can rebase later relative operands (`cd`, `env -C`,
# `find -execdir`, and common `-C`/directory forms), unless
# bash_command_rebase_target can name the single static base. Absolute template
# paths are unaffected because their resolution does not depend on command-local
# cwd.
bash_command_may_rebase_relative_paths() (
  set -f
  bash_command_sources_script "$1" && return 0
  cwd_records=$(git_command_records "$1")
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $cwd_records
  IFS=$old_ifs

  cwd_option_owner=
  for cwd_record in "$@"; do
    case "$cwd_record" in
      4';'|4'&&'|4'||'|4'|') cwd_option_owner=; continue ;;
      1*|2*|4*) return 0 ;;
      3*) cwd_option_owner=; continue ;;
    esac
    cwd_token=${cwd_record#?}
    # A quoted word with whitespace may be code that eval or `sh -c` runs
    # later (`eval "cd sub && cat env.py"`); its cwd changes count too. Only
    # blanks split shell words: a blank in a token was quoted in $1, so the
    # token is shorter and the recursion ends. CR, VT and FF split nothing and
    # would re-parse to the same token forever.
    case "$cwd_token" in
      *[' 	']*)
        [ "$cwd_token" != "$1" ] \
          && bash_command_may_rebase_relative_paths "$cwd_token" && return 0
        ;;
    esac
    case "${cwd_token##*/}" in
      ';'|'&&'|'||'|'|') cwd_option_owner=; continue ;;
    esac
    bash_cwd_change "$cwd_token" "$cwd_option_owner"
    case "$cwd_change" in
      owner) cwd_option_owner=${cwd_token##*/} ;;
      ?*) return 0 ;;
    esac
  done
  return 1
)

# Print the one directory a command may rebase relative operands to, for the
# common `cd /repo && git add pkg/env.py` and `git -C /repo add ...` shapes.
# Fail, leaving the caller conservative, unless exactly one cwd change names a
# static target. Callers check a token against the event workdir AND this
# target, so position within the command does not matter, and a wrong guess
# (`git commit -C <rev>`) only adds a base that must also be safe.
bash_command_rebase_target() (
  set -f
  bash_command_sources_script "$1" && return 1
  rebase_records=$(git_command_records "$1")
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $rebase_records
  IFS=$old_ifs

  rebase_owner=
  rebase_target=
  rebase_count=0
  rebase_expect=
  for rebase_record in "$@"; do
    rebase_token=${rebase_record#?}
    case "$rebase_token" in
      *[' 	']*)
        [ "$rebase_token" != "$1" ] \
          && bash_command_may_rebase_relative_paths "$rebase_token" && return 1
        ;;
    esac
    if [ -n "$rebase_expect" ]; then
      case "$rebase_record" in 0*) ;; *) return 1 ;; esac
      # A redirection may sit between the word and its operand (`cd >log sub`).
      case "$rebase_token" in ';'|'&&'|'||'|'|'|*'<'*|*'>'*) return 1 ;; esac
      [ "$rebase_expect" = cd ] && rebase_target_kind=cd || rebase_target_kind=option
      rebase_expect=
      rebase_target=$rebase_token
      rebase_count=$((rebase_count + 1))
      continue
    fi
    case "$rebase_record" in
      4';'|4'&&'|4'||'|4'|') rebase_owner=; continue ;;
      1*|2*|4*) return 1 ;;
      3*) rebase_owner=; continue ;;
    esac
    case "${rebase_token##*/}" in
      ';'|'&&'|'||'|'|') rebase_owner=; continue ;;
    esac
    bash_cwd_change "$rebase_token" "$rebase_owner"
    case "$cwd_change" in
      cd) rebase_expect=cd ;;
      next) rebase_expect=option ;;
      value)
        rebase_target=$cwd_change_value
        rebase_target_kind=option
        rebase_count=$((rebase_count + 1))
        ;;
      owner) rebase_owner=${rebase_token##*/} ;;
      any) return 1 ;;
    esac
  done
  [ -z "$rebase_expect" ] && [ "$rebase_count" -eq 1 ] || return 1
  # Options, tilde and zsh `=` expansion, globs and brace lists are not static.
  case "$rebase_target" in
    ''|[-+=]*|'~'*|*[*?[{]*|*'<'*|*'>'*) return 1 ;;
  esac
  # A bare cd operand may be redirected by CDPATH or cdable_vars, however they
  # were set, and cd resolves `..` logically while realpath resolves the joined
  # token physically. Accept only `/...` or `./...` cd targets without `..`;
  # directory options use chdir() and need neither restriction.
  if [ "$rebase_target_kind" = cd ]; then
    case "$rebase_target" in /*|./*) ;; *) return 1 ;; esac
    case "/$rebase_target/" in */../*) return 1 ;; esac
  fi
  printf '%s' "$rebase_target"
)

git_option_takes_value() {
  case "$1" in
    -c|-C|--git-dir|--work-tree|--namespace|--exec-path|--config-env) return 0 ;;
    *) return 1 ;;
  esac
}

is_git_global_option() {
  case "$1" in
    -*) return 0 ;;
    *) return 1 ;;
  esac
}

is_assignment_token() {
  case "$1" in
    [A-Za-z_]*=*)
      case "${1%%=*}" in
        *[!A-Za-z0-9_]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

# The variables that decide which configuration files git reads, and so what a
# git alias expands to. GIT_CONFIG itself redirects `git config` alone.
is_git_config_env_name() {
  case "$1" in
    HOME|XDG_CONFIG_HOME|GIT_CONFIG_*|GIT_DIR|GIT_COMMON_DIR|GIT_CEILING_DIRECTORIES|GIT_DISCOVERY_ACROSS_FILESYSTEM) return 0 ;;
    *) return 1 ;;
  esac
}

# Succeed when a word names one of those variables other than in an expansion
# that only reads it, as `export HOME=x`, `unset GIT_DIR`, `read HOME` and
# `${HOME:=x}` do.
mentions_git_config_env() {
  case "$1" in
    *HOME*|*GIT_*) ;;
    *) return 1 ;;
  esac
  mentions_env_name 'HOME|XDG_CONFIG_HOME|GIT_CONFIG_[A-Za-z0-9_]*|GIT_DIR|GIT_COMMON_DIR|GIT_CEILING_DIRECTORIES|GIT_DISCOVERY_ACROSS_FILESYSTEM' "$1"
}

mentions_git_target_env() {
  case "$1" in
    *GIT_DIR*|*GIT_WORK_TREE*) ;;
    *) return 1 ;;
  esac
  mentions_env_name 'GIT_DIR|GIT_WORK_TREE' "$1"
}

# Succeed when word $2 names a variable matching ERE $1 other than in an
# expansion that only reads it.
mentions_env_name() {
  printf '%s\n' "$2" \
    | sed -E 's/\$[A-Za-z_][A-Za-z0-9_]*//g; s/\$\{#?[A-Za-z_][A-Za-z0-9_]*([}#%\/^,?+-]|:[^=])//g' \
    | grep -Eq "(^|[^A-Za-z0-9_])($1)([^A-Za-z0-9_]|\$)"
}

# Git runs a subcommand that has no built-in as an external git-<name>
# program, else as an alias; an alias cannot hide a built-in, except a
# deprecated one. The common built-ins skip spawning git to list them.
git_is_builtin() {
  case "$1" in
    status|log|diff|show|add|stage|rm|mv|rev-parse|config|remote|branch|tag|ls-files|describe|shortlog|blame|grep|fetch|pull|checkout|switch|restore|reset|stash|merge|rebase|cherry-pick|revert|init|clone|worktree|submodule|apply|am|format-patch|ls-tree|ls-remote|cat-file|rev-list|for-each-ref|show-ref|symbolic-ref|reflog|clean|bisect|notes|gc|fsck|version|help|var|merge-base|update-index) return 0 ;;
  esac
  if [ -z "${git_builtin_names+x}" ]; then
    git_builtin_names=$(git --list-cmds=builtins 2>/dev/null) || git_builtin_names=
    git_deprecated_names=$(git --list-cmds=deprecated 2>/dev/null) || git_deprecated_names=
  fi
  case "
$git_deprecated_names
" in
    *"
$1
"*) return 1 ;;
  esac
  case "
$git_builtin_names
" in
    *"
$1
"*) return 0 ;;
  esac
  return 1
}

git_has_external() {
  command -v "git-$1" >/dev/null 2>&1 && return 0
  git_exec_path=$(git --exec-path 2>/dev/null) && [ -x "$git_exec_path/git-$1" ]
}

# Print the alias git expands subcommand $1 to when it runs in directory $2,
# then in each directory on a line of $3, with the git options in $4 (-c,
# --git-dir, --bare) and the variable assignments in $5, one word per line.
# Fail with 1 when $1 names no alias and help.autocorrect runs no guess, with 3
# when autocorrect may run one, and with 2 when the configuration cannot be
# read or the alias is not a plain git command line, one that the tokenizer
# splits the way git does: `!` shell aliases included.
git_alias_lookup() (
  set -f
  alias_name=$1
  CDPATH= cd -- "$2" 2>/dev/null || exit 2
  IFS='
'
  # shellcheck disable=SC2086
  for alias_dir in $3; do
    # A shell cd resolves `..` logically, git -C and env -C physically.
    alias_physical=$(CDPATH= cd -P -- "$alias_dir" 2>/dev/null && pwd -P) || exit 2
    CDPATH= cd -- "$alias_dir" 2>/dev/null || exit 2
    [ "$(pwd -P)" = "$alias_physical" ] || exit 2
  done
  unset GIT_CONFIG
  # shellcheck disable=SC2086
  set -- $5 git $4 config -z --list
  # Each entry is `key<LF>value<NUL>`, or `key<NUL>` for a bare boolean: one
  # line per entry, with \001 after the key and for a newline in the value.
  alias_value=$(
    { env "$@" 2>/dev/null || printf '\001failed\0'; } \
      | tr '\0\n' '\n\001' \
      | LC_ALL=C awk -v name="$alias_name" '
        BEGIN { FS = "\001"; name = tolower(name) }
        $0 == "\001failed" { failed = 1; next }
        {
          key = tolower($1)
          sep = index($0, FS)
          # Git matches `alias.<name>` case-insensitively and the subsection
          # form `alias.<name>.command` case-sensitively; match both loosely.
          if (key == "alias." name || key == "alias." name ".command") {
            found = 1
            bare = !sep
            value = substr($0, sep + 1)
          } else if (key == "help.autocorrect") {
            autocorrect = sep ? tolower(substr($0, sep + 1)) : "true"
          }
        }
        END {
          if (failed || (found && bare)) exit 2
          if (found) { print value; exit 0 }
          if (autocorrect == "" || autocorrect ~ /^(0|false|off|no|show|never)$/) exit 1
          exit 3
        }
      '
  )
  alias_status=$?
  case "$alias_status:$alias_value" in
    0:|0:!*|0:*[!A-Za-z0-9_./=:,+@%^~?*\'\"\ \	-]*) exit 2 ;;
  esac
  [ "$alias_status" -ne 0 ] || printf '%s\n' "$alias_value"
  exit "$alias_status"
)

# Transparent wrappers that run the command following them; a git commit/push
# behind one of these still stages/commits, so the gate must see through it.
is_noop_wrapper() {
  case "$1" in
    env|command|sudo|nice|nohup|time|xargs) return 0 ;;
    *) return 1 ;;
  esac
}

# The wrappers the commit/push gate reads through: is_noop_wrapper's, and
# those that run the command after their options and the operands
# git_gate_wrapper_operands counts. is_noop_wrapper also names command heads
# for path policy, so it does not grow with this list.
is_git_gate_wrapper() {
  case "$1" in
    env|command|sudo|nice|nohup|time|xargs) return 0 ;;
    timeout|doas|stdbuf|ionice|setsid|chronic|flock|taskset|chroot|nsenter|caffeinate|unbuffer|exec|busybox) return 0 ;;
    *) return 1 ;;
  esac
}

git_gate_wrapper_operands() {
  case "$1" in
    timeout|flock|taskset|chroot) return 1 ;;
    *) return 0 ;;
  esac
}

# Succeed when option $2 of wrapper $1 consumes the next word as its value.
# wrapper_value_option is then the option that takes a value (a letter, or a
# long name), and wrapper_value_glued its value when $2 itself holds it. An
# option missing here reads as a flag: its value becomes the command name,
# which the gate's fallback reads; a flag read as taking a value would hide
# the command instead.
wrapper_option_takes_value() {
  wrapper_value_option=
  wrapper_value_glued=
  case "$1" in
    env) wov_short=uCSa; wov_long=' --unset --chdir --split-string --argv0 ' ;;
    sudo) wov_short=ugChDprtURTca; wov_long=' --user --group --close-from --host --chdir --prompt --role --type --other-user --chroot --command-timeout --login-class --auth-type ' ;;
    doas) wov_short=aCu; wov_long=' ' ;;
    nice) wov_short=n; wov_long=' --adjustment ' ;;
    time) wov_short=fo; wov_long=' --format --output ' ;;
    xargs) wov_short=nLPsIdEa; wov_long=' --max-args --max-procs --max-chars --delimiter --arg-file --process-slot-var ' ;;
    timeout) wov_short=sk; wov_long=' --signal --kill-after ' ;;
    stdbuf) wov_short=ioe; wov_long=' --input --output --error ' ;;
    ionice) wov_short=cnpPu; wov_long=' --class --classdata --pid --pgid --uid ' ;;
    flock) wov_short=wE; wov_long=' --timeout --wait --conflict-exit-code ' ;;
    chroot) wov_short=; wov_long=' --userspec --groups ' ;;
    nsenter) wov_short=tSGWN; wov_long=' --target --setuid --setgid --wdns --net-socket ' ;;
    caffeinate) wov_short=tw; wov_long=' ' ;;
    exec) wov_short=a; wov_long=' ' ;;
    *) wov_short=; wov_long=' ' ;;
  esac
  case "$2" in
    --*=*)
      case "$wov_long" in
        *" ${2%%=*} "*) wrapper_value_option=${2%%=*}; wrapper_value_glued=${2#*=} ;;
      esac
      return 1
      ;;
    --*)
      case "$wov_long" in
        *" $2 "*) wrapper_value_option=$2; return 0 ;;
      esac
      return 1
      ;;
  esac
  wov_rest=${2#-}
  while [ -n "$wov_rest" ]; do
    wov_letter=${wov_rest%"${wov_rest#?}"}
    wov_rest=${wov_rest#?}
    case "$wov_short" in
      *"$wov_letter"*)
        wrapper_value_option=$wov_letter
        wrapper_value_glued=$wov_rest
        [ -z "$wov_rest" ]
        return
        ;;
    esac
  done
  return 1
}

# Names whose arguments the commit/push gate reads as text, never as a command.
git_gate_inert_head() {
  case "$1" in
    echo|printf|pwd|ls|cat|head|tail|wc|true|false|:|test|'['|'[['|which|type|date|whoami|id|uname|grep|rg|sleep|wait|jq|sort|uniq|diff|stat|basename|dirname|realpath|readlink) return 0 ;;
    # Shell state only; `set -P` is caught when the scan resolves `..`.
    set|export|read|local|declare|typeset|readonly|shift|printenv) return 0 ;;
    *) return 1 ;;
  esac
}

# Documentation readers: their operands name a page, so `man git commit`
# runs no git. Kept apart from git_gate_inert_head, which also decides
# whether a later cd can still be resolved.
git_gate_doc_head() {
  case "$1" in
    man|info|tldr|apropos|whatis|help) return 0 ;;
    *) return 1 ;;
  esac
}

# Commands that run their arguments, or one of them, as code in a language
# the gate does not parse.
git_gate_code_runner() {
  case "$1" in
    su|script|watch|parallel|fish|nu|pwsh|powershell) return 0 ;;
    *) return 1 ;;
  esac
}

# Set gsc_code to the code that su -c, script -c or watch ($1) hands to a
# shell, from the records of its arguments ($2 on), and succeed only when
# that is certain: every word is literal, every option is one listed here,
# and no word outside the code names git. Otherwise the caller reads all the
# words as code. watch stops at its first operand and joins the rest.
git_gate_sh_runner_code() {
  gsc_code=
  case "$1" in
    su) gsc_flags=lmpfP gsc_values=gGw gsc_long=' --login --preserve-environment --fast --pty ' gsc_vlong=' --group --supp-group --whitelist-environment ' ;;
    script) gsc_flags=aefq gsc_values=EIOBTmo gsc_long=' --append --return --flush --quiet --timing ' gsc_vlong=' --echo --log-in --log-out --log-io --log-timing --logging-format --output-limit ' ;;
    watch) gsc_flags=bcCegprtw gsc_values=nq gsc_long=' --beep --color --no-color --differences --errexit --chgexit --precise --no-rerun --no-title --no-wrap ' gsc_vlong=' --interval --equexit ' ;;
    *) return 1 ;;
  esac
  gsc_runner=$1
  gsc_found=0
  gsc_next=
  gsc_options=1
  gsc_text=
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      0';'|0'&&'|0'||'|0'|'|3*) break ;;
      0*) ;;
      *) return 1 ;;
    esac
    gsc_word=${1#0}
    shift
    gsc_text=
    # The word comes last and may hold ':' itself, so every pattern names the
    # fields before it in full; a '*' there would let the word stand in for
    # them.
    case "$gsc_next:$gsc_options:$gsc_runner:$gsc_word" in
      c:*)
        [ "$gsc_found" -eq 0 ] || return 1
        gsc_code=$gsc_word
        gsc_found=1
        ;;
      v:*) gsc_text=$gsc_word ;;
      :1:"$gsc_runner":--) gsc_options=0 ;;
      :1:su:-) ;;
      :1:su:--command|:1:script:--command) gsc_next=c; continue ;;
      :1:su:--command=*|:1:script:--command=*)
        [ "$gsc_found" -eq 0 ] || return 1
        gsc_code=${gsc_word#--command=}
        gsc_found=1
        ;;
      :1:"$gsc_runner":--*=*)
        case "$gsc_long$gsc_vlong" in
          *" ${gsc_word%%=*} "*) gsc_text=${gsc_word#*=} ;;
          *) return 1 ;;
        esac
        ;;
      :1:"$gsc_runner":--*)
        case "$gsc_vlong" in
          *" $gsc_word "*) gsc_next=v; continue ;;
        esac
        case "$gsc_long" in
          *" $gsc_word "*) ;;
          *) return 1 ;;
        esac
        ;;
      :1:"$gsc_runner":-?*)
        gsc_rest=${gsc_word#-}
        while [ -n "$gsc_rest" ]; do
          gsc_letter=${gsc_rest%"${gsc_rest#?}"}
          gsc_rest=${gsc_rest#?}
          case "$gsc_flags" in
            *"$gsc_letter"*) continue ;;
          esac
          case "$gsc_runner:$gsc_letter" in
            su:c|script:c)
              [ "$gsc_found" -eq 0 ] || return 1
              if [ -n "$gsc_rest" ]; then
                gsc_code=$gsc_rest
                gsc_found=1
              else
                gsc_next=c
              fi
              ;;
            # An optional value is glued to its option.
            watch:d|script:t) gsc_text=$gsc_rest ;;
            *)
              case "$gsc_values" in
                *"$gsc_letter"*) ;;
                *) return 1 ;;
              esac
              gsc_text=$gsc_rest
              [ -n "$gsc_rest" ] || gsc_next=v
              ;;
          esac
          break
        done
        [ "$gsc_next" != c ] || continue
        [ "$gsc_next" != v ] || continue
        ;;
      :[01]:watch:*)
        gsc_options=0
        gsc_code="${gsc_code:+$gsc_code }$gsc_word"
        gsc_found=1
        ;;
      *) gsc_text=$gsc_word ;;
    esac
    gsc_next=
    case "$gsc_text" in
      *[Gg][Ii][Tt]*) gsc_code=; return 1 ;;
    esac
  done
  if [ "$gsc_found" -eq 0 ] || [ -n "$gsc_next" ] || [ -z "$gsc_code" ]; then
    gsc_code=
    return 1
  fi
}

# Succeed when record $2, a word after git subcommand $1 (commit or push),
# disables hooks or signing. git_skip_state holds what the words before it
# leave: v when an option's value comes next, e past `--`; callers empty it
# at the subcommand. Git takes a unique prefix of a long option, and
# --no-ver is still ambiguous with --no-verbose. Only commit reads -n as
# --no-verify, and in a cluster the rest of the word after -m, -F, -c, -C,
# -t, -S or -u is that option's value.
git_skip_flag() {
  case "$git_skip_state" in
    v) git_skip_state=; return 1 ;;
    e) return 1 ;;
  esac
  # In `-a>/dev/null` the shell takes the redirection off the word.
  case "$2" in
    0*[\<\>]*) set -- "$1" "${2%%[<>]*}" ;;
  esac
  case "$2" in
    0--) git_skip_state=e; return 1 ;;
    0--no-veri|0--no-verif|0--no-verify) return 0 ;;
    0--no-g|0--no-gp|0--no-gpg|0--no-gpg-|0--no-gpg-s|0--no-gpg-si|0--no-gpg-sig|0--no-gpg-sign) return 0 ;;
  esac
  [ "$1" = commit ] || return 1
  case "$2" in
    0--file|0--author|0--date|0--message|0--reedit-message|0--reuse-message|0--fixup|0--squash|0--trailer|0--template|0--cleanup|0--pathspec-from-file)
      git_skip_state=v
      return 1
      ;;
    0-[!-]*) gsf_rest=${2#0-} ;;
    *) return 1 ;;
  esac
  while [ -n "$gsf_rest" ]; do
    gsf_char=${gsf_rest%"${gsf_rest#?}"}
    gsf_rest=${gsf_rest#?}
    case "$gsf_char" in
      n) return 0 ;;
      [mFcCt]) [ -n "$gsf_rest" ] || git_skip_state=v; return 1 ;;
      [Su]) return 1 ;;
    esac
  done
  return 1
}

# Succeed when git configuration $1 (KEY=VALUE, or KEY), given to one git
# command, moves its hooks or turns commit signing off. Keys are
# case-insensitive.
git_config_skips_hooks() {
  case "${1%%=*}" in
    [Cc][Oo][Rr][Ee].[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh]) return 0 ;;
    [Cc][Oo][Mm][Mm][Ii][Tt].[Gg][Pp][Gg][Ss][Ii][Gg][Nn]) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *=*) ;;
    *) return 1 ;;
  esac
  case "${1#*=}" in
    [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]|1) return 1 ;;
  esac
  return 0
}

# Succeed when assignment $1 in the environment of a git command switches
# its hooks off: through git configuration, or through the switch that
# turns husky, lefthook or overcommit off as a whole. A variable that skips
# some of their hooks (pre-commit's SKIP, LEFTHOOK_EXCLUDE) leaves the rest.
git_env_skips_hooks() {
  case "$1" in
    HUSKY=0|HUSKY_SKIP_HOOKS=*|LEFTHOOK=0|LEFTHOOK=false|OVERCOMMIT_DISABLE=*) return 0 ;;
    GIT_CONFIG_KEY_*=*) git_config_skips_hooks "${1#*=}" ;;
    GIT_CONFIG_PARAMETERS=*[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Succeed when git config arguments $@, up to the end of the command, set or
# remove core.hooksPath. Reading it, with the key alone, does not.
git_config_sets_hooks() {
  gch_key=0
  gch_unset=0
  gch_skip=0
  for gch_word in "$@"; do
    case "$gch_word" in
      3*|0';'|0'&&'|0'||'|0'|') break ;;
    esac
    if [ "$gch_skip" -eq 1 ]; then
      gch_skip=0
      continue
    fi
    case "$gch_word" in
      0[0-9]*'>'|0[0-9]*'<'|0'>'|0'>>'|0'<') gch_skip=1; continue ;;
      0[0-9]*'>'*|0[0-9]*'<'*|0'>'*|0'<'*) continue ;;
    esac
    [ "$gch_key" -eq 0 ] || return 0
    case "${gch_word#?}" in
      [Cc][Oo][Rr][Ee].[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh]) gch_key=1 ;;
      --unset|--unset-all|unset) gch_unset=1 ;;
    esac
  done
  [ "$gch_key$gch_unset" = 11 ]
}

# The fallback for a command name the gate does not know. Given the records
# of one simple command from its name on ($1 is 1) or of a whole code string
# ($1 is 0), set git_fb_found to 1 when it may run git commit or push: a word
# git followed, past git's own options, by commit, push or a word only run
# time knows, or code that a code runner, or a word after -c or --command,
# runs. git_fb_flag is 1 when a flag that disables hooks or signing follows
# that git in the same simple command. A name in git_gate_inert_head starts a
# simple command whose words are text.
git_gate_fallback_scan() {
  gfb_one=$1
  shift
  gfb_head=1
  gfb_skip=0
  gfb_git=0
  gfb_hit=0
  gfb_off=0
  gfb_prev=
  gfb_text=
  while [ "$#" -gt 0 ]; do
    gfb_kind=${1%"${1#?}"}
    gfb_word=${1#?}
    shift
    case "$gfb_kind$gfb_word" in
      0';'|0'&&'|0'||'|0'|'|3'('|3')'|3'&')
        case "$gfb_kind$gfb_word:$gfb_prev" in
          '3&:'*'>'|'3&:'*'<') continue ;;
        esac
        git_gate_fallback_subst "$gfb_text"
        [ "$gfb_one" -eq 0 ] || return 0
        gfb_text=
        gfb_head=1
        gfb_skip=0
        gfb_git=0
        gfb_hit=0
        gfb_off=0
        gfb_prev=
        continue
        ;;
      3*) continue ;;
    esac
    if [ "$gfb_skip" -eq 1 ]; then
      gfb_text="$gfb_text $gfb_word"
      continue
    fi
    # A wrapper the gate does not know may pass an assignment on, as env does.
    [ "$gfb_kind" != 0 ] || ! is_assignment_token "$gfb_word" \
      || ! git_env_skips_hooks "$gfb_word" || gfb_off=1
    if [ "$gfb_head" -eq 1 ]; then
      is_assignment_token "$gfb_word" && continue
      gfb_head=0
      if [ "$gfb_kind" = 0 ] && { git_gate_inert_head "${gfb_word##*/}" \
        || git_gate_doc_head "${gfb_word##*/}"; }; then
        gfb_skip=1
        continue
      fi
      if git_gate_code_runner "${gfb_word##*/}"; then
        gfb_code=
        gfb_sh=0
        if git_gate_sh_runner_code "${gfb_word##*/}" "$@"; then
          gfb_code=$gsc_code
          gfb_sh=1
        fi
        while [ "$#" -gt 0 ]; do
          case "$1" in
            0';'|0'&&'|0'||'|0'|'|3*) break ;;
          esac
          [ "$gfb_sh" -eq 1 ] || gfb_code="$gfb_code ${1#?}"
          shift
        done
        git_gate_fallback_code "$gfb_code"
        continue
      fi
    fi
    if [ "$gfb_hit" -eq 1 ]; then
      git_skip_flag "$gfb_sub" "$gfb_kind$gfb_word" && git_fb_flag=1
    fi
    case "$gfb_prev:$gfb_word" in
      -c:*|--command:*|-Command:*|-command:*) git_gate_fallback_code "$gfb_word" ;;
      *:--command=*) git_gate_fallback_code "${gfb_word#--command=}" ;;
    esac
    gfb_prev=$gfb_word
    case "$gfb_git" in
      2)
        case "$gfb_opt" in
          -c|--config-env) git_config_skips_hooks "$gfb_word" && gfb_off=1 ;;
        esac
        gfb_git=1
        continue
        ;;
      1)
        case "$gfb_kind$gfb_word" in
          0commit|0push|[!0]*)
            git_fb_found=1
            gfb_hit=1
            gfb_git=0
            gfb_sub=$gfb_word
            git_skip_state=
            [ "$gfb_off" -eq 0 ] || git_fb_flag=1
            continue
            ;;
          0--config-env=*)
            git_config_skips_hooks "${gfb_word#--config-env=}" && gfb_off=1
            continue
            ;;
          0-*)
            if git_option_takes_value "$gfb_word"; then gfb_git=2; gfb_opt=$gfb_word; fi
            continue
            ;;
        esac
        gfb_git=0
        ;;
    esac
    case "$gfb_kind${gfb_word##*/}" in
      0[Gg][Ii][Tt]) gfb_git=1 ;;
    esac
  done
  git_gate_fallback_subst "$gfb_text"
}

# The words of a text-only command, $1, as code when a command substitution
# in them still runs.
git_gate_fallback_subst() {
  case "$1" in
    *'`'*|*'$('*) git_gate_fallback_code "$(printf '%s\n' "$1" | tr '`$()"' '     ')" ;;
  esac
}

# git_gate_fallback_scan for code string $1, in a subshell: its words are
# read as shell words, which is all the fallback needs of any language.
git_gate_fallback_code() {
  case "$1" in
    *[Gg][Ii][Tt]*) ;;
    *) return 0 ;;
  esac
  if [ "${git_fb_depth:-0}" -ge 4 ]; then
    git_fb_found=1
    return 0
  fi
  (
    set -f
    git_fb_depth=$((${git_fb_depth:-0} + 1))
    git_fb_found=0
    git_fb_flag=0
    gfb_records=$(git_command_records "$1")
    gfb_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $gfb_records
    IFS=$gfb_ifs
    git_gate_fallback_scan 0 "$@"
    exit $((git_fb_found + git_fb_flag))
  )
  case "$?" in
    1) git_fb_found=1 ;;
    2) git_fb_found=1; git_fb_flag=1 ;;
  esac
}

# The groups for a git commit or push the fallback found behind command $1:
# one the policy decides, and one that still scans the index of the hook's
# directory, where that git most likely runs.
git_gate_fallback_emit() {
  printf 'G\n'
  [ "$git_fb_flag" -eq 0 ] || printf 'N\n'
  git_unresolved "git commit or push runs through $(git_reason_word "$1"), whose arguments or code the scan does not follow"
  printf 'G\n'
}

long_option_abbreviates() {
  [ -n "$1" ] || return 1
  case "$2" in
    "$1"*) return 0 ;;
    *) return 1 ;;
  esac
}

# `git commit -a`, --patch, --interactive, --pathspec-from-file, and a
# pathspec (with or without --only/--include) make Git stage tracked work-tree
# changes itself, after PreToolUse has run. Given the git_command_records after
# `commit`, print W when any tracked change may be staged, I when untracked
# files may be too (--interactive), and P<pathspec> for each literal pathspec.
# Every misreading must widen the scan, never narrow it: a word only known at
# run time may be --interactive, so it becomes I, and an unrecognised option is
# a flag, so the word after it stays a pathspec. Git accepts unambiguous
# long-option prefixes, and an ambiguous one fails the commit, so any prefix of
# a staging option widens the scan.
git_commit_stage_records() {
  stage_skip_next=0
  stage_options_done=0
  while [ "$#" -gt 0 ]; do
    stage_kind=${1%"${1#?}"}
    stage_word=${1#?}
    shift
    if [ "$stage_kind" = 3 ]; then
      case "$stage_word" in
        '&')
          # `2>&1` and `&>log` are redirections, not a background `&`; the
          # pathspec that may follow them still belongs to this commit.
          [ "$stage_skip_next" -ne 0 ] && continue
          case "${1-}" in
            0'>'*|0'<'*) continue ;;
          esac
          return 0
          ;;
        # Brace expansion can yield any option or pathspec, and `(` here is
        # extglob or a syntax error.
        '{'|'}') printf 'I\n'; continue ;;
        '(') printf 'W\n'; return 0 ;;
        *) return 0 ;;
      esac
    fi
    if [ "$stage_kind" = 0 ] && is_shell_command_separator "$stage_word"; then
      return 0
    fi
    # A quoted operator, like the pathspec in `-- ';'`, is a literal word.
    case "$stage_kind$stage_word" in
      4';'|4'&&'|4'||'|4'|') stage_kind=0 ;;
    esac
    if [ "$stage_skip_next" -eq 1 ]; then
      stage_skip_next=0
      # An option value that may split, like `-m $F`, may also be --interactive.
      case "$stage_kind" in
        0|4) ;;
        *) printf 'I\n' ;;
      esac
      continue
    fi
    if [ "$stage_skip_next" -eq 2 ]; then
      stage_skip_next=0
      # A redirection target, unless the shell saw a quoted `>` pathspec: keep
      # every word that can name a file inside the repository.
      case "$stage_word" in
        /*|..|../*|-) ;;
        *[!0-9]*) [ "$stage_kind" = 0 ] && printf 'P%s\n' "$stage_word" ;;
      esac
      continue
    fi
    if [ "$stage_kind" != 0 ]; then
      printf 'I\n'
      continue
    fi
    # The tokenizer keeps `x>log` whole; the shell passes `x` to Git. Keep the
    # whole word too, in case it was a quoted pathspec.
    stage_prefix=${stage_word%%[<>]*}
    case "$stage_prefix" in
      *[!0-9]*)
        if [ "$stage_prefix" != "$stage_word" ]; then
          printf 'P%s\n' "$stage_word"
          case "$stage_word" in
            *'>'|*'<') stage_skip_next=2 ;;
          esac
          stage_word=$stage_prefix
        fi
        ;;
    esac
    stage_redirect=${stage_word#"${stage_word%%[!0-9]*}"}
    # A redirection word is also a harmless relative pathspec, and keeping it
    # covers a quoted pathspec that merely looks like one.
    case "$stage_redirect" in
      '>'|'>>'|'<'|'<<'|'<<<'|'<>'|'>|') printf 'P%s\n' "$stage_word"; stage_skip_next=2; continue ;;
      '>'*|'<'*) printf 'P%s\n' "$stage_word"; continue ;;
    esac
    # An unquoted glob that starts with `-` or with a glob character can
    # expand to a file named `-a` or `--interactive`; the tokenizer cannot
    # tell it from a quoted one. A glob under a directory is a pathspec.
    case "$stage_word" in
      -*[*?[]*|[*?[]*) printf 'I\n'; continue ;;
    esac
    if [ "$stage_options_done" -eq 0 ]; then
      case "$stage_word" in
        --)
          stage_options_done=1
          continue
          ;;
        --*)
          stage_long=${stage_word#--}
          stage_long=${stage_long%%=*}
          for stage_option in all interactive patch pathspec-from-file; do
            if long_option_abbreviates "$stage_long" "$stage_option"; then
              printf 'W\n'
              break
            fi
          done
          long_option_abbreviates "$stage_long" interactive && printf 'I\n'
          case "$stage_word" in
            *=*) ;;
            --file|--author|--date|--message|--reedit-message|--reuse-message|--fixup|--squash|--trailer|--template|--cleanup|--unified|--inter-hunk-context)
              stage_skip_next=1
              ;;
            # Its file lies outside the repository as often as not; the scan
            # is already whole-tree, so dropping the word loses nothing.
            *) long_option_abbreviates "$stage_long" pathspec-from-file && stage_skip_next=1 ;;
          esac
          continue
          ;;
        -?*)
          stage_short=${stage_word#-}
          while [ -n "$stage_short" ]; do
            stage_flag=${stage_short%"${stage_short#?}"}
            stage_short=${stage_short#?}
            case "$stage_flag" in
              a|p) printf 'W\n' ;;
              F|m|c|C|t|U) [ -n "$stage_short" ] || stage_skip_next=1; break ;;
              # -S and -u take only an attached optional value.
              S|u) break ;;
            esac
          done
          continue
          ;;
      esac
    fi
    printf 'P%s\n' "$stage_word"
  done
  return 0
}

# Given the records after `git add`, succeed when it may add ignored files:
# -f/--force (or a prefix of it, which Git accepts), or a word only known at
# run time — a variable, a brace expansion, or a glob that may match `-f`
# (one that starts with `-` or with a glob character; `src/*.js` cannot).
git_add_is_forced() {
  add_after_redirect=0
  while [ "$#" -gt 0 ]; do
    add_kind=${1%"${1#?}"}
    add_word=${1#?}
    shift
    case "$add_kind:$add_word" in
      # `2>&1` and `&>log` arrive split around a bare `&`; the arguments after
      # them still belong to this `git add`.
      3:'&')
        [ "$add_after_redirect" -eq 1 ] && continue
        case "${1-}" in
          0'>'*|0'<'*) continue ;;
        esac
        return 1
        ;;
      3:'{'|3:'}') return 0 ;;
      3:*) return 1 ;;
      0:*) is_shell_command_separator "$add_word" && return 1 ;;
      *) return 0 ;;
    esac
    add_after_redirect=0
    case "$add_word" in
      *'>'|*'<') add_after_redirect=1 ;;
    esac
    # The tokenizer keeps `-f>log` whole; the shell passes `-f` to Git.
    add_prefix=${add_word%%[<>]*}
    case "$add_prefix" in
      *[!0-9]*) add_word=$add_prefix ;;
    esac
    case "$add_word" in
      -*[*?[]*|[*?[]*) return 0 ;;
      --) return 1 ;;
      --*) long_option_abbreviates "${add_word#--}" force && return 0 ;;
      -*f*) return 0 ;;
    esac
  done
  return 1
}

# Given the records after `cd` or `pushd`, print the one literal directory it
# changes to. Fail when only run time knows it: no operand ($HOME), `-`
# ($OLDPWD), an option or directory-stack entry, several operands (zsh
# substitutes), a dynamic or glob word, a tilde word other than an unquoted `~`
# or `~/...` while $shell_cd_home holds a known $HOME, a relative one that CDPATH may
# redirect ($shell_cd_cdpath), or a redirection that may fail and skip the cd.
shell_cd_target() {
  cd_target=
  cd_operands=0
  cd_dashdash=0
  cd_skip=0
  cd_dup=0
  while [ "$#" -gt 0 ]; do
    cd_kind=${1%"${1#?}"}
    cd_word=${1#?}
    shift
    if [ "$cd_skip" -eq 1 ]; then
      # `2>&1` arrives as `2>`, `&`, `1`.
      if [ "$cd_kind$cd_word" = '3&' ]; then
        cd_dup=1
        continue
      fi
      cd_skip=0
      # A redirection that fails skips the cd; these cannot fail.
      case "$cd_dup$cd_kind$cd_word" in
        101|102|00/dev/null) continue ;;
        *) return 1 ;;
      esac
    fi
    case "$cd_kind$cd_word" in
      0';'|0'&&'|0'||'|0'|'|3'&'|3')'|3'}') break ;;
      # Brace expansion adds operands; `(` is a syntax error.
      *) [ "$cd_kind" != 3 ] && [ "$cd_kind" != 2 ] || return 1 ;;
    esac
    cd_redirect=${cd_word#"${cd_word%%[!0-9]*}"}
    case "$cd_redirect" in
      '>'|'>>'|'<')
        cd_skip=1
        cd_dup=0
        continue
        ;;
      '>/dev/null'|'>>/dev/null'|'</dev/null') continue ;;
      *'>'*|*'<'*) return 1 ;;
    esac
    [ "$cd_kind" = 0 ] || return 1
    if [ "$cd_word$cd_dashdash$cd_operands" = --00 ]; then
      cd_dashdash=1
      continue
    fi
    cd_operands=$((cd_operands + 1))
    cd_target=$cd_word
  done
  [ "$cd_operands" -eq 1 ] || return 1
  case "$cd_target" in
    '~'|'~/'*)
      [ -n "$shell_cd_home" ] && [ "$shell_cd_home_known" -eq 1 ] || return 1
      cd_target=$shell_cd_home${cd_target#'~'}
      ;;
  esac
  case "$cd_target" in
    # zsh expands a leading `=` to a command path.
    ''|[-+=]*|'~'*|*[*?[]*) return 1 ;;
    /*|.|..|./*|../*) ;;
    *) [ "$shell_cd_cdpath" -eq 0 ] || return 1 ;;
  esac
  printf '%s\n' "$cd_target"
}

# Given `eval` or a shell name and the records after it, print how many of
# them the command takes, a colon, and the code it runs: eval's arguments
# joined by spaces, the script after -c, or a here-string. Fail with 1 when
# only run time knows that code, and with 2 when the command line holds none
# (a script file, or stdin from a pipe, a file or a here-document, whose body
# is tokenized in place).
shell_command_code() {
  code_shell=$1
  shift
  code_taken=0
  code_text=
  code_state=options
  code_c=0
  code_here=
  code_prev=
  while [ "$#" -gt 0 ]; do
    code_kind=${1%"${1#?}"}
    code_word=${1#?}
    case "$code_kind$code_word" in
      0';'|0'&&'|0'||'|0'|'|3'('|3')'|3'}') break ;;
      # `2>&1` arrives as `2>`, `&`, `1`.
      3'&')
        case "$code_prev" in
          *'>'|*'<') ;;
          *) break ;;
        esac
        ;;
      # Brace expansion.
      3*) return 1 ;;
    esac
    shift
    code_taken=$((code_taken + 1))
    code_prev=$code_word
    if [ "$code_shell" = eval ]; then
      case "$code_kind" in
        0|3|4)
          # A quoted operator is not one to eval, but eval parses it as one.
          case "$code_kind$code_word" in
            4';'|4'&&'|4'||'|4'|') ;;
            4*) return 1 ;;
          esac
          ;;
        *) return 1 ;;
      esac
      # eval's `--` may follow redirections, which apply to eval itself.
      if [ "$code_kind" = 0 ] && [ "$code_state" != script ]; then
        case "$code_state:${code_word#"${code_word%%[!0-9]*}"}" in
          redirect:*) code_state=options ;;
          *:'>'|*:'>>'|*:'<'|*:'<>'|*:'>|'|*:'<<<') code_state=redirect ;;
          *:'>'*|*:'<'*) ;;
          *:--) code_state=script; continue ;;
          *) code_state=script ;;
        esac
      fi
      code_text="$code_text${code_text:+ }$code_word"
      continue
    fi
    [ "$code_kind" = 3 ] && continue
    case "$code_state" in
      # The words after a -c script are its $0, $1, ...: data.
      script) continue ;;
      redirect) code_state=options; continue ;;
      here)
        code_state=options
        code_here=$code_kind$code_word
        continue
        ;;
      # An option value that splits may add -c.
      value)
        code_state=options
        case "$code_kind" in
          0|4) continue ;;
          *) return 1 ;;
        esac
        ;;
    esac
    # A $NAME this shell set to one plain word is that word, which may still
    # be an option such as -c.
    case "$git_child_code:$code_kind:$code_word" in
      0:[14]:'$'*)
        code_var=${code_word#?}
        case "$code_kind:$code_var" in
          4:'{'*'}') code_var=${code_var#?}; code_var=${code_var%?} ;;
        esac
        case "$code_var" in
          ''|[0-9]*|*[!A-Za-z0-9_]*) ;;
          *)
            case "$git_args_set" in
              *" $code_var "*)
                code_word=$(printf '%s\n' "$git_command_vars" | sed -n "s/^A	$code_var	//p")
                code_kind=0
                ;;
            esac
            ;;
        esac
        ;;
    esac
    [ "$code_kind" = 0 ] || return 1
    case "${code_word#"${code_word%%[!0-9]*}"}" in
      '<<<') code_state=here; continue ;;
      '<<<'*) code_here=0${code_word#*'<<<'}; continue ;;
      '>'|'>>'|'<'|'<>'|'>|') code_state=redirect; continue ;;
      '>'*|'<'*) continue ;;
    esac
    if [ "$code_state" = options ]; then
      case "$code_word" in
        --|-) code_state=operands; continue ;;
        --rcfile|--init-file) code_state=value; continue ;;
        --*) continue ;;
        [-+]*)
          case "$code_word" in
            -*c*) code_c=1 ;;
          esac
          # -o and -O take an option name.
          case "$code_word" in
            [-+]*[oO]*) code_state=value ;;
          esac
          continue
          ;;
      esac
    fi
    [ "$code_c" -eq 1 ] || return 2
    code_text=$code_word
    code_state=script
  done
  # A shell with no -c and no script file operand reads stdin.
  if [ "$code_shell" != eval ] && [ "$code_state" != script ]; then
    [ "$code_c" -eq 0 ] || return 2
    case "$code_here" in
      '') return 2 ;;
      0*) code_text=${code_here#0} ;;
      *) return 1 ;;
    esac
  fi
  printf '%s:%s\n' "$code_taken" "$code_text"
}

# Print, for command $1 and its gate records $2, the variables whose $NAME
# command word the commit/push gate may read without running it. "S<TAB>NAME":
# every $NAME and ${NAME} in $1 stands apart as a whole word, so a quoted
# "$NAME" command word is that one word. "R<TAB>NAME<TAB>VALUE": moreover an
# unquoted $NAME command word expands to the literal VALUE, whose words are
# plain and whose first word is an ordinary command, not git, a shell or a
# wrapper. That holds when NAME is assigned once, by a bare top-level
# `NAME=VALUE` that nothing before it makes conditional or moves into a
# subshell, and nothing in the line can set it another way: another
# assignment, a mention outside $NAME (read, unset, ${NAME:=x}), a dynamic
# name given to declare, read or printf, or a command name only run time
# knows; eval, source, trap and IFS, which can do any of that unseen; or git
# and the shells, whose code may read NAME in a child that lacks it.
# "A<TAB>NAME<TAB>VALUE": the same for a VALUE that is one plain word, except
# that git or a shell may run and $NAME may be glued to text other than a
# brace: an unquoted $NAME git argument, or a $NAME shell operand, in this
# shell is that word.
git_gate_command_vars() {
  printf '%s\n' "$2" | GGCV_CMD=$1 LC_ALL=C awk "$AWK_RECORD_SEPARATOR"'
    function base(t) { sub(/.*\//, "", t); return t }
    function delim(c) { return c == "" || c ~ /[ \t\n;&|()<>]/ }
    # The word from s to e - 1 is not glued to a neighbour, also across a
    # double quote: "$X"{a,} and {a,}$X expand to other words.
    function apart(s, e,   b, a) {
      b = s > 1 ? substr(cmd, s - 1, 1) : ""
      if (b == "\"") b = s > 2 ? substr(cmd, s - 2, 1) : ""
      a = substr(cmd, e, 1)
      if (a == "\"") a = substr(cmd, e + 1, 1)
      return delim(b) && delim(a)
    }
    # Of those neighbours, only a brace or an open paren makes the word from s
    # to e - 1 part of another one: the records keep every other glued text
    # in the same word.
    function braced(s, e,   b, a) {
      b = s > 1 ? substr(cmd, s - 1, 1) : ""
      if (b == "\"") b = s > 2 ? substr(cmd, s - 2, 1) : ""
      a = substr(cmd, e, 1)
      if (a == "\"") a = substr(cmd, e + 1, 1)
      return b ~ /[{}(]/ || a ~ /[{}(]/
    }
    { rec[++n] = $0 }
    END {
      cmd = ENVIRON["GGCV_CMD"]
      # zsh runs `$X eval ...` as eval when X is noglob or -.
      special = "^(git|eval|source|\\.|trap|enable|alias|unalias|exec|command|builtin|noglob|nocorrect|-|env|sudo|nice|nohup|time|xargs|cd|pushd|popd|set|shopt|declare|typeset|local|export|readonly|read|unset|mapfile|readarray|getopts|let|printf|wait|compgen|sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish)$"
      unseen = "^(git|eval|source|\\.|trap|enable|alias|setopt|unsetopt|emulate|zmodload|autoload|exec|read|mapfile|readarray|getopts|select|coproc|=~|sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish)$"
      # Of those, the words that matter as an argument too: a resolved $NAME
      # names an ordinary command, which runs no builtin its arguments name,
      # the same as that command written out.
      external = "^(git|=~|sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish)$"
      # Variables the shell itself sets or ties to another one.
      shellset = "^(_|REPLY|MAPFILE|OPTARG|OPTIND|OPTERR|COPROC.*|BASH.*|PWD|OLDPWD|MATCH|MBEGIN|MEND|LINENO|RANDOM|SRANDOM|SECONDS|EPOCH.*|PPID|UID|EUID|GID|EGID|GROUPS|HOSTNAME|HOSTTYPE|OSTYPE|MACHTYPE|SHLVL|HISTCMD|FUNCNAME|PIPESTATUS|COLUMNS|LINES|ARGV|ARGC|STATUS|ERRNO|PATH|CDPATH|FPATH|MANPATH|MODULE_PATH|PSVAR|HOME|IFS|ZSH.*|TRY_BLOCK_.*|TTYIDLE|SIGNALS|COMP_.*|READLINE_.*|HISTFILE|PS[0-4])$"
      namers = "^(declare|typeset|local|export|readonly|read|unset|mapfile|readarray|getopts|let|printf|wait|compgen)$"
      # These may run a builtin of this shell; env, sudo and the like cannot.
      wrappers = "^(command|builtin)$"
      reserved = "^(if|then|else|elif|fi|do|done|while|until|for|case|esac|select|function|coproc|!|in)$"
      abort = cmd ~ /IFS/ || index(cmd, "${!") || index(cmd, "\\\n")

      for (i = 1; i <= length(cmd); ) {
        if (substr(cmd, i, 1) !~ /[A-Za-z0-9_]/) { i++; continue }
        for (j = i; substr(cmd, j, 1) ~ /[A-Za-z0-9_]/; j++) ;
        name = substr(cmd, i, j - i)
        p1 = i > 1 ? substr(cmd, i - 1, 1) : ""
        if (name ~ /^[A-Za-z_]/) {
          if (p1 == "$") {
            used[name] = 1
            if (!apart(i - 1, j)) glued[name] = 1
            if (braced(i - 1, j)) joined[name] = 1
          } else if (p1 == "{" && i > 2 && substr(cmd, i - 2, 1) == "$") {
            used[name] = 1
            if (substr(cmd, j, 1) != "}") tainted[name] = 1
            else if (!apart(i - 2, j + 1)) glued[name] = 1
          } else if (substr(cmd, j, 1) == "=" && (i == 1 || p1 ~ /[ \t\n;]/)) assigned[name]++
          # An option word like `-C` or `+D` names no variable.
          else if (p1 ~ /[-+]/ && (i == 2 || delim(substr(cmd, i - 2, 1))) && delim(substr(cmd, j, 1))) optword[name] = 1
          else tainted[name] = 1
        }
        i = j
      }

      head = 1; wrapped = 0; namer = ""; blocked = 0; depth = 0; varhead = 0
      for (k = 1; k <= n; k++) {
        r = rec[k]; kind = substr(r, 1, 1); t = substr(r, 2)
        if (fd_dup_amp(r, rec[k - 1])) continue
        # A here-document body is tokenized like the line, so a ) in it reads
        # as a closing paren; depth after it says nothing.
        if (index(t, "<<")) blocked = 1
        if (record_separator(r) || kind == "3") {
          # A subshell or substitution that has closed leaves the assignments
          # after it unconditional and in this shell. Braces are not counted:
          # an argument } is emitted as 3} too, so it would close a group
          # that bash still holds open.
          if (t == "(") depth++
          else if (t == ")" && depth > 0) depth--
          else if (kind == "3") blocked = 1
          head = 1; wrapped = 0; namer = ""; varhead = 0
          continue
        }
        if (kind == "2" || kind == "5" || kind == "6") abort = 1
        if (kind == "0" && tolower(base(t)) ~ (varhead ? external : unseen)) {
          if (tolower(base(t)) == "git") gitrun = 1
          # A child shell cannot set NAME here, so only R is lost: its code
          # may read NAME as a command name where NAME is unset.
          else if (tolower(base(t)) ~ /^(sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh|fish)$/) shellrun = 1
          else abort = 1
        }
        if (namer != "") {
          if (kind != "0") {
            if (!(namer ~ /^(declare|typeset|local|export|readonly)$/ && t ~ /^[A-Za-z_][A-Za-z0-9_]*=/) \
                && !(namer == "printf" && nargs > 0 && printf_ok)) abort = 1
          } else {
            if (namer ~ /^(declare|typeset|local|export|readonly)$/ && t ~ /^-[A-Za-z]*n/) abort = 1
            if (namer == "printf" && nargs == 0) printf_ok = t !~ /^-/
          }
          nargs++
        } else if (kind == "0" && !varhead && base(t) ~ namers) {
          namer = base(t); nargs = 0; printf_ok = 0
        }
        if (head && t ~ /^[A-Za-z_][A-Za-z0-9_]*=/) {
          nm = t; sub(/=.*/, "", nm)
          arec[nm]++
          for (m = k - 1; m >= 1 && rec[m] == "0;"; m--) ;
          if ((kind == "0" || kind == "1" && substr(t, length(nm) + 2) ~ /^(\$HOME|\$\{HOME\})(\/[A-Za-z0-9_.\/:,@%+-]*)?$/) \
              && !blocked && !depth && (k == 1 || rec[k - 1] == "0;") \
              && (m < 1 || rec[m] != "0&&" && rec[m] != "0||" && rec[m] != "0|") \
              && (k == n || rec[k + 1] == "0;"))
            cand[nm] = substr(t, length(nm) + 2)
          continue
        }
        if (head && kind == "0" && t ~ reserved) { blocked = 1; continue }
        if (wrapped && kind == "0" && t ~ /^-/) continue
        if (head || wrapped) {
          wrapped = head && kind == "0" && base(t) ~ wrappers
          varhead = 1
          if (kind == "1" && t == "$" && rec[k + 1] == "3{" && rec[k + 3] == "3}") {
            heads[substr(rec[k + 2], 2)] = 1
            k += 3
          } else if (t ~ /^\$[A-Za-z_][A-Za-z0-9_]*$/) heads[substr(t, 2)] = 1
          else if (kind == "4" && t ~ /^\$\{[A-Za-z_][A-Za-z0-9_]*\}$/) heads[substr(t, 3, length(t) - 3)] = 1
          else {
            varhead = 0
            if (kind != "0") abort = 1
          }
          head = 0
        }
      }

      # NAME=~/x and NAME=$HOME/x start with HOME, unless the line may set it.
      home = ENVIRON["HOME"]
      if (home ~ /^\/[A-Za-z0-9_.\/@%+-]*$/ && !assigned["HOME"] && !tainted["HOME"] && !abort)
        for (nm in cand)
          if (match(cand[nm], /^(~|\$HOME|\$\{HOME\})(\/|$)/))
            cand[nm] = home substr(cand[nm], index(cand[nm], "/") ? index(cand[nm], "/") : length(cand[nm]) + 1)
      for (nm in cand) {
        if (arec[nm] != 1 || assigned[nm] != 1 || tainted[nm] || toupper(nm) ~ shellset) continue
        nw = split(cand[nm], w, /[ \t]+/)
        if (nw == 1 && !joined[nm] && w[1] ~ /^[A-Za-z0-9_.\/:,@%+-][A-Za-z0-9_.\/:=,@%+-]*$/) plain[nm] = cand[nm]
        if (glued[nm] || optword[nm]) continue
        # A case-insensitive file system runs GIT as git; zsh expands =git.
        ok = nw > 0 && tolower(base(w[1])) !~ special
        for (m = 1; m <= nw; m++)
          if (w[m] !~ /^[A-Za-z0-9_.\/:,@%+-][A-Za-z0-9_.\/:=,@%+-]*$/ || tolower(base(w[m])) == "git") ok = 0
        if (ok) resolved[nm] = cand[nm]
      }
      # A command name that resolves to nothing known may be declare or read.
      for (nm in heads) if (!(nm in resolved)) abort = 1
      for (nm in used) if (!glued[nm]) printf "S\t%s\n", nm
      if (!abort && !gitrun && !shellrun) for (nm in resolved) printf "R\t%s\t%s\n", nm, resolved[nm]
      if (!abort) for (nm in plain) printf "A\t%s\t%s\n", nm, plain[nm]
    }
  '
}

# Succeed when the records in "$@", the arguments of a one-word command name
# that may be git, cannot make it commit or push: each is a plain literal that
# is not git, commit, push, or an option that moves the repository or sets
# config, and the command reads no input a shell could run. An alias or an
# external git-<name> is left to the git checks.
git_unknown_head_args_safe() {
  gua_prev=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      0';'|0'&&'|0'||'|0'|'|3')'|3'}') return 0 ;;
      3'&')
        case "$gua_prev:${2-}" in
          *'>:'*) shift; [ "$#" -gt 0 ] && shift; continue ;;
          *:0'>'*) shift; continue ;;
          *) return 0 ;;
        esac
        ;;
      0?*) ;;
      *) return 1 ;;
    esac
    gua_prev=${1#?}
    case "$gua_prev" in
      *[!A-Za-z0-9_./:=,@%+\>-]*) return 1 ;;
      [Gg][Ii][Tt]|*/[Gg][Ii][Tt]|commit|push|-c*|-C*|--git-dir*|--work-tree*|--exec-path*|--config-env*|--namespace*|--no-verify|--no-gpg-sign) return 1 ;;
    esac
    shift
  done
}

# U marks a git commit or push group the scan cannot resolve; the Y record
# after it says why, for the closed-mode message.
git_unresolved() {
  printf 'U\nY%s\n' "$1"
}

# $1 in backticks when it is a short plain word, else a neutral stand-in: the
# reason must not echo a long or unusual word that may be a secret.
git_reason_word() {
  case "$1" in
    ''|*[!A-Za-z0-9_.\$\{\}-]*) printf 'a word' ;;
    *)
      if [ "${#1}" -le 24 ]; then printf '`%s`' "$1"; else printf 'a word'; fi
      ;;
  esac
}

is_git_commit_or_push() {
  cmd=$1
  git_alias_workdir=${2:-}
  [ -n "$git_alias_workdir" ] || git_alias_workdir=$(pwd)
  (
    set -f
    words=$(git_gate_records "$cmd")
    # Every later git_gate_records call reads code a shell or a git alias runs.
    gate_child_code=1
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    IFS=$old_ifs

    git_command_vars=
    git_vars_failed=0
    case "$cmd" in
      *'$'*)
        git_command_vars=$(git_gate_command_vars "$cmd" "$words") \
          || { git_command_vars=; git_vars_failed=1; }
        ;;
    esac
    # The resolvable variables whose assignment the scan has passed.
    git_vars_set=' '
    # The same for one-word git arguments (A), read only in this shell's own
    # code: code for a shell or a git alias runs in a child that lacks them.
    git_args_set=' '
    git_child_code=0
    # The git command at hand stands for a command name only run time knows.
    git_head_unknown=0
    git_head_sub=0
    git_cmd_reads_input=0
    case "$cmd" in
      *'|'*|*'<'*) git_cmd_reads_input=1 ;;
    esac

    unset git_builtin_names
    # A git alias expands per the configuration its command reads. That is
    # unknown once an earlier part of the line may write a config file
    # (git_config_mutable) or change the variables that locate one
    # (git_env_changed), or when the command's own assignments or options
    # that do so are dynamic. Literal ones are applied to the lookup.
    git_config_mutable=0
    git_env_changed=0
    git_env_args=
    git_env_dynamic=0
    # The git command at hand runs without its hooks or signing through its
    # environment or options (git_hooks_off), or after an earlier git config
    # on the line moved its hooks (git_hooks_moved).
    git_hooks_off=0
    git_hooks_moved=0
    # The same for GIT_DIR and GIT_WORK_TREE, which choose the repository a
    # commit or push uses.
    git_target_changed=0
    git_target_args=
    git_target_dynamic=0
    shell_head=
    git_config_args=
    git_config_dynamic=0
    git_alias_depth=0
    # Only a redirection to a descriptor or /dev/null writes no file.
    case "$cmd" in
      *'>'*)
        printf '%s\n' "$cmd" \
          | sed -E 's/[0-9]*>&([0-9]+|-)([[:space:];&|)]|$)/\2/g; s/(&|[0-9]*)>>?[|]? *\/dev\/null([[:space:];&|)]|$)/\2/g' \
          | grep -q '>' && git_config_mutable=1
        ;;
    esac
    # PATH decides which external git-<name> programs exist.
    git_external_known=1
    case "$cmd" in
      *PATH*|*--exec-path*) git_external_known=0 ;;
    esac

    command_start=1
    effective_c_dirs=
    effective_c_dynamic=0
    xargs_wrapped=0
    # Why a wrapper runs git in another root or directory the scan does not
    # follow.
    git_root_moved=
    # A wrapper word only run time knows: like effective_c_dynamic, except
    # that the git command behind it is still scanned in the hook's directory.
    git_wrapper_dynamic=0
    # A for or select loop names its words; they are not a command.
    git_fb_skip=0
    git_index_changed=0
    git_index_forced=0
    matched=1
    # A shell cd moves every later git command, across ; && || and out of a
    # { } group, but not out of a ( ) subshell or a here-document. The scan
    # follows a literal cd whose effect is certain (D records). Any other cd
    # leaves the working directory of every later git command unknown (U):
    # one behind a wrapper, in a pipeline, in a backgrounded list, in braces,
    # after control flow or anything that can redefine cd, after a command
    # that may relink its target, or one reached through && or || once its
    # and-or list ends, since the commands after that run whether or not it
    # did.
    shell_cd_dirs=
    shell_cd_count=0
    shell_cd_unknown=0
    shell_cd_lost=0
    shell_cd_cond=0
    shell_cd_pending=0
    shell_cd_in_list=0
    shell_cd_last=0
    shell_cd_piped=0
    shell_cd_wrapped=0
    shell_cd_braces=0
    shell_cd_untrusted=0
    shell_cd_mutable=0
    shell_cd_mutable_by=
    shell_cd_mutable_git=
    shell_cd_why=
    shell_cd_reason() { [ -n "$shell_cd_why" ] || shell_cd_why=$1; }
    shell_cd_function=0
    shell_cd_stack=
    shell_cd_prev=
    # An earlier command may change HOME without naming it, as arithmetic on a
    # variable read from a file does, so a tilde cd counts only before any
    # command other than cd in this shell (shell_cd_home_known).
    shell_cd_home_known=1
    shell_cd_home=
    case "${HOME:-}" in
      *'
'*) ;;
      /*) shell_cd_home=$HOME ;;
    esac
    shell_cd_cdpath=0
    [ -n "${CDPATH:-}" ] && shell_cd_cdpath=1
    case "$cmd" in
      *[Cc][Dd][Pp][Aa][Tt][Hh]*) shell_cd_cdpath=1 ;;
    esac
    # $1 is a separator or a kind-3 token, $2 the record after it, and $3
    # is 1 when $1 stands where a command starts.
    shell_cd_boundary() {
      shell_cd_last_was=$shell_cd_last
      shell_cd_last=0
      shell_cd_wrapped=0
      shell_cd_piped=0
      case "$1" in
        # cond 1: only && led here, so a cd holds for the rest of the chain;
        # cond 2: an || did, so what follows may run without the cd. A command
        # that runs only because a cd failed keeps its D: the cd fails the
        # same way in the scan, which then reports it could not run.
        '&&') [ "$shell_cd_cond" -eq 2 ] || shell_cd_cond=1 ;;
        '||')
          shell_cd_cond=2
          [ "$shell_cd_pending" -eq 0 ] || { shell_cd_unknown=1; shell_cd_reason "a cd may not run, since an || follows its && list"; }
          ;;
        '|')
          shell_cd_piped=1
          [ "$shell_cd_last_was" -eq 0 ] || { shell_cd_unknown=1; shell_cd_reason "a cd runs in a pipeline"; }
          ;;
        ';'|'&')
          [ "$shell_cd_pending" -eq 0 ] || { shell_cd_unknown=1; shell_cd_reason "a cd may not run, since its && list ends"; }
          # A backgrounded list runs its cds in a subshell.
          [ "$1:$shell_cd_in_list" != '&:1' ] || { shell_cd_unknown=1; shell_cd_reason "a cd runs in a background job"; }
          shell_cd_cond=0
          shell_cd_pending=0
          shell_cd_in_list=0
          ;;
        '{') [ "$3" -eq 0 ] || shell_cd_braces=$((shell_cd_braces + 1)) ;;
        '}')
          if [ "$3" -eq 1 ] && [ "$shell_cd_braces" -gt 0 ]; then
            shell_cd_braces=$((shell_cd_braces - 1))
          fi
          ;;
        '(')
          if [ "$2" = '3)' ]; then
            # `name()` defines a function, which may be cd itself.
            shell_cd_untrusted=1
            shell_cd_function=1
          else
            shell_cd_stack="$shell_cd_stack $shell_cd_count:$shell_cd_unknown:$shell_cd_cond:$shell_cd_pending:$shell_cd_in_list:$shell_cd_braces:$shell_cd_home_known"
            shell_cd_cond=0
            shell_cd_pending=0
            shell_cd_in_list=0
          fi
          ;;
        ')')
          if [ "$shell_cd_function" -eq 1 ]; then
            shell_cd_function=0
          elif [ -z "$shell_cd_stack" ]; then
            :
          elif [ "$shell_cd_untrusted" -eq 1 ]; then
            # A case pattern also ends in `)`; the subshell it closes is unknown.
            [ "$shell_cd_count" -eq 0 ] || { shell_cd_lost=1; shell_cd_reason "a cd runs in a subshell the scan cannot follow"; }
          else
            shell_cd_saved=${shell_cd_stack##* }
            shell_cd_stack=${shell_cd_stack% *}
            shell_cd_count=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_unknown=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_cond=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_pending=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_in_list=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_braces=${shell_cd_saved%%:*}
            shell_cd_home_known=${shell_cd_saved#*:}
            if [ "$shell_cd_count" -eq 0 ]; then
              shell_cd_dirs=
            else
              shell_cd_dirs=$(printf '%s\n' "$shell_cd_dirs" | sed -n "1,${shell_cd_count}p")
            fi
          fi
          ;;
      esac
    }
    append_effective_c_dir() {
      record=$1
      case "$record" in
        # Tilde expansion is not modeled for a directory option.
        1*|0'~'*) effective_c_dynamic=1 ;;
        0*)
          dir=${record#?}
          effective_c_dirs="${effective_c_dirs:+$effective_c_dirs
}$dir"
          ;;
        *) effective_c_dynamic=1 ;;
      esac
    }
    append_wrapper_c_dir() {
      case "$1" in
        0'~'*|[!0]*) git_wrapper_dynamic=1 ;;
        *) append_effective_c_dir "$1" ;;
      esac
    }
    # $1 is GIT_DIR or GIT_WORK_TREE, $2 the record of the path git takes for
    # it. A commit or push is scanned with them, or fails per the policy.
    git_target_value() {
      case "$2" in
        0|0*'~'*|[!0]*) git_target_dynamic=1 ;;
        *) git_target_args="$git_target_args$1=${2#?}
" ;;
      esac
    }
    # $1 is a NAME=value record before a command name. A tilde in it expands.
    git_env_assignment() {
      git_env_name=${1#?}
      git_env_skips_hooks "$git_env_name" && git_hooks_off=1
      case "$git_env_name" in
        GIT_DIR=*|GIT_WORK_TREE=*) git_target_value "${git_env_name%%=*}" "${1%"$git_env_name"}${1#*=}" ;;
      esac
      is_git_config_env_name "${git_env_name%%=*}" || return 0
      case "$1" in
        0*'~'*|[!0]*) git_env_dynamic=1 ;;
        *) git_env_args="$git_env_args${1#?}
" ;;
      esac
    }
    # $1 is an option that changes the configuration git reads, $2 the record
    # of its value.
    git_config_option() {
      case "$2" in
        0*) git_config_args="$git_config_args$1
${2#?}
" ;;
        *) git_config_dynamic=1 ;;
      esac
    }
    # Set git_arg to record $1, or to the literal an unquoted $NAME in it
    # stands for.
    git_arg_record() {
      git_arg=$1
      case "$git_child_code$git_arg" in
        01'$'*) ;;
        *) return 0 ;;
      esac
      case "${git_arg#??}" in
        ''|*[!A-Za-z0-9_]*) return 0 ;;
      esac
      case "$git_args_set" in
        *" ${git_arg#??} "*)
          git_arg=0$(printf '%s\n' "$git_command_vars" | sed -n "s/^A	${git_arg#??}	//p")
          ;;
      esac
    }
    # Print what git expands subcommand $1 to, with the status of
    # git_alias_lookup; one that only run time knows fails with 2, unless git
    # runs an external command by that name instead.
    git_subcommand_alias() (
      if [ "$git_config_mutable$git_env_changed$git_env_dynamic$git_config_dynamic$effective_c_dynamic$git_wrapper_dynamic$shell_cd_unknown$shell_cd_lost" = 00000000 ]; then
        git_alias_lookup "$1" "$git_alias_workdir" "$shell_cd_dirs
$effective_c_dirs" "$git_config_args" "$git_env_args"
        git_alias_status=$?
        [ "$git_alias_status" -eq 3 ] || exit "$git_alias_status"
      fi
      [ "$git_external_known" -eq 1 ] && git_has_external "$1" && exit 1
      exit 2
    )
    while [ "$#" -gt 0 ]; do
      record=$1
      record_kind=${record%"${record#?}"}
      token=${record#?}

      if [ "$command_start" -eq 1 ]; then
        case "$record_kind$token" in
          0cd|0pushd|3*|0';'|0'&&'|0'||'|0'|') ;;
          0HOME=*) shell_cd_home_known=0 ;;
          0*=*) is_assignment_token "$token" || shell_cd_home_known=0 ;;
          *) shell_cd_home_known=0 ;;
        esac
        # Strip leading `NAME=value` assignments and no-op wrappers so a wrapped
        # invocation like `FOO=1 env git commit --no-verify` still reaches the
        # git check below. command_start stays 1 so the next token is re-examined
        # as the command head.
        if [ "$record_kind" != 5 ] && [ "$record_kind" != 6 ] && is_assignment_token "$token"; then
          case "$record_kind$git_command_vars" in
            [01]*"R	${token%%=*}	"*) git_vars_set="$git_vars_set${token%%=*} " ;;
          esac
          case "$record_kind$git_command_vars" in
            [01]*"A	${token%%=*}	"*) git_args_set="$git_args_set${token%%=*} " ;;
          esac
          git_env_assignment "$record"
          shift
          continue
        fi
        # `git>/dev/null` and `bash<<<code` are a command name and a
        # redirection; the name alone is matched below.
        head_name=${token%%[<>]*}
        if [ "$record_kind" = 0 ] && [ -n "$head_name" ] && [ "$head_name" != "$token" ]; then
          case "$head_name" in
            *[!0-9]*)
              shift
              set -- "0$head_name" "0${token#"$head_name"}" "$@"
              continue
              ;;
          esac
        fi
        # A redirection may precede the command name: `>/dev/null git commit`.
        # One that fails skips the command, so a cd after it is unknown.
        case "${token#"${token%%[!0-9]*}"}" in
          '>'|'>>'|'<'|'<>'|'>|')
            shell_cd_wrapped=1
            case "$token" in *'<'*) git_head_sub=1 ;; esac
            shift
            [ "${1-}" = '3&' ] && shift
            [ "$#" -gt 0 ] && shift
            continue
            ;;
          '>'*|'<'*)
            shell_cd_wrapped=1
            case "$token" in *'<'*) git_head_sub=1 ;; esac
            shift
            continue
            ;;
        esac
        # The next word may be the command name; whether a cd after it runs is
        # then unknown.
        if [ "$record_kind" = 6 ]; then
          shell_cd_mutable=1
          shift
          continue
        fi
        # A command name only run time knows may be git, a shell or eval;
        # git_gate_command_vars names the variables whose value is known
        # anyway. A quoted one whose value is not stands for one word, which
        # is git at worst: the git checks then read its arguments.
        git_var=
        case "$record_kind:$token:${2-}:${4-}" in
          '1:$:3{:3}') git_var=${3#?} ;;
          [14]:'$'*) git_var=${token#?} ;;
        esac
        case "$record_kind:$git_var" in
          4:'{'*'}') git_var=${git_var#?}; git_var=${git_var%?} ;;
        esac
        case "$git_var" in
          ''|[0-9]*|*[!A-Za-z0-9_]*) git_var= ;;
        esac
        if [ -n "$git_var" ]; then
          git_var_skip=1
          [ "$token" = '$' ] && git_var_skip=4
          git_var_value=
          case "$git_vars_set" in
            *" $git_var "*)
              git_var_value=$(printf '%s\n' "$git_command_vars" | sed -n "s/^R	$git_var	//p")
              ;;
          esac
          if [ -n "$git_var_value" ]; then
            shift "$git_var_skip"
            if [ "$record_kind" = 1 ]; then
              # shellcheck disable=SC2086
              git_var_records=$(printf '0%s\n' $git_var_value)
            else
              git_var_records=0$git_var_value
            fi
            IFS='
'
            # shellcheck disable=SC2086
            set -- $git_var_records "$@"
            IFS=$old_ifs
            continue
          fi
          if [ "$record_kind$git_var_skip$xargs_wrapped$git_head_sub" = 4100 ] \
            && [ "$shell_cd_untrusted$shell_cd_braces" = 00 ] && [ -z "$shell_cd_stack" ] \
            && [ "$git_cmd_reads_input" -eq 0 ] \
            && printf '%s\n' "$git_command_vars" | grep -qxF "S	$git_var"; then
            shift
            if git_unknown_head_args_safe "$@"; then
              git_head_unknown=1
              set -- 0git "$@"
              continue
            fi
            set -- "$record" "$@"
          fi
        fi
        case "$record_kind:${token##*/}" in
          1:*|4:*[\$\`]*)
            printf 'G\n'
            git_unresolved "the command name $(git_reason_word "$token") is only known at run time"
            # The variable may be resolvable; the resolver itself failed.
            if [ -n "$git_var" ] && [ "$git_vars_failed" -eq 1 ]; then printf 'F\n'; fi
            matched=0
            shell_cd_mutable=1
            shift
            command_start=0
            continue
            ;;
        esac
        case "$token" in
          cd|pushd|popd)
            shift
            if [ "$token" != popd ] \
              && [ "$shell_cd_untrusted$shell_cd_piped$shell_cd_wrapped" = 000 ] \
              && [ "$shell_cd_cond" -ne 2 ] \
              && [ "$shell_cd_mutable" -eq 0 ] \
              && [ "$shell_cd_braces" -eq 0 ] \
              && shell_cd_dir=$(shell_cd_target "$@"); then
              shell_cd_dirs="${shell_cd_dirs:+$shell_cd_dirs
}$shell_cd_dir"
              shell_cd_count=$((shell_cd_count + 1))
              shell_cd_in_list=1
              [ "$shell_cd_cond" -eq 0 ] || shell_cd_pending=1
            else
              shell_cd_unknown=1
              if [ "$shell_cd_mutable" -eq 1 ]; then
                if [ -n "$shell_cd_mutable_by" ]; then
                  shell_cd_reason "a cd runs after $shell_cd_mutable_git$(git_reason_word "$shell_cd_mutable_by") that may create or relink paths"
                else
                  shell_cd_reason "a cd runs after a command that may create or relink paths"
                fi
              elif [ "$shell_cd_untrusted$shell_cd_piped$shell_cd_wrapped$shell_cd_braces" != 0000 ] || [ "$shell_cd_cond" -eq 2 ]; then
                shell_cd_reason "a cd runs after control flow, ||, in a pipeline, in braces or behind a redirection"
              else
                shell_cd_reason "a cd goes to a directory only known at run time"
              fi
            fi
            shell_cd_last=1
            command_start=0
            continue
            ;;
          # Reserved words start a command of their own, under control flow.
          if|then|else|elif|fi|do|done|while|until|for|case|esac|select|function|coproc|'!')
            shell_cd_untrusted=1
            shift
            case "$token" in
              for|select) git_fb_skip=1 ;;
            esac
            # `case WORD in` matches WORD, but expands it first. Parameter
            # transformations (e.g. Bash ${X@P}) and arithmetic can execute
            # stored code without a lexical command substitution. Keep those
            # subjects unresolved along with explicit command substitutions.
            if [ "$token" = case ] && [ "${2-}" = 0in ]; then
              case "${1-}" in
                [014]*'$('*|[014]*'`'*|[014]*'${'*|[014]*'$'*'['*) ;;
                [014]?*) shift 2 ;;
              esac
            fi
            continue
            ;;
          builtin)
            shell_cd_wrapped=1
            shift
            continue
            ;;
          # These can redefine or disable cd, or run code that does.
          # exec can also close a descriptor a later `2>&1` duplicates.
          alias|unalias|enable|disable|unset|unfunction|autoload|source|.|eval|exec|trap|shopt|setopt|unsetopt|emulate|*'['*']='*)
            shell_cd_untrusted=1
            ;;
        esac
        # The code a shell or eval runs from its arguments goes through the
        # same checks, in place: a shell's in a ( ) subshell, since its cds
        # do not leave it; eval's in this shell, whose later cds it already
        # made unknown. Code only run time knows may commit or push anywhere;
        # the policy then decides for the whole command, but the open policy
        # still scans the other git commands where they appear to run.
        case "${token##*/}" in
          eval|sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh)
            shift
            shell_code=$(shell_command_code "${token##*/}" "$@")
            shell_code_status=$?
            # xargs may append -c and a script, or replace text in one.
            [ "$xargs_wrapped" -eq 0 ] || shell_code_status=1
            case "$shell_code_status" in
              0)
                shift "${shell_code%%:*}"
                shell_code_records=$(git_gate_records "${shell_code#*:}")
                # An unbalanced ( or ) would restore the cd state of a
                # subshell around this command.
                printf '%s\n' "$shell_code_records" \
                  | LC_ALL=C awk '$0 == "3(" { d++ } $0 == "3)" && --d < 0 { exit 1 } END { if (d) exit 1 }' \
                  || shell_cd_untrusted=1
                # env -C and --chdir start the shell in their directory.
                shell_code_chdir=
                if [ -n "$effective_c_dirs" ]; then
                  shell_code_chdir=$(printf '%s\n' "$effective_c_dirs" \
                    | LC_ALL=C awk '{ print "0cd"; print "0--"; print "0" $0; print "0;" }')
                fi
                [ "$effective_c_dynamic$git_wrapper_dynamic" = 00 ] || shell_code_chdir="$shell_code_chdir
0cd
1\$
0;"
                # An assignment before eval may outlast it.
                [ -z "$git_env_args" ] && [ "$git_env_dynamic" -eq 0 ] || git_env_changed=1
                [ -z "$git_target_args" ] && [ "$git_target_dynamic" -eq 0 ] || git_target_changed=1
                git_child_code=1
                IFS='
'
                if [ "${token##*/}" = eval ]; then
                  # shellcheck disable=SC2086
                  set -- $shell_code_records "$@"
                elif [ -n "$shell_code_records" ]; then
                  # shellcheck disable=SC2086
                  set -- '3(' $shell_code_chdir $shell_code_records '3)' "$@"
                fi
                IFS=$old_ifs
                continue
                ;;
              1)
                printf 'G\n'
                git_unresolved "the shell code ${token##*/} runs is only known at run time"
                matched=0
                ;;
            esac
            shell_cd_mutable=1
            command_start=0
            continue
            ;;
        esac
        if is_git_gate_wrapper "${token##*/}"; then
          wrapper=${token##*/}
          shell_cd_wrapped=1
          # xargs appends words read from stdin, which may be any argument.
          [ "$wrapper" = xargs ] && xargs_wrapped=1
          # sudo and doas may run git with another HOME, and without GIT_DIR.
          case "$wrapper" in
            sudo|doas)
              git_env_dynamic=1
              [ -z "$git_target_args${GIT_DIR:-}${GIT_WORK_TREE:-}" ] || git_target_dynamic=1
              ;;
            chroot|nsenter) git_root_moved="$wrapper runs git under another root or namespace" ;;
          esac
          git_gate_wrapper_operands "$wrapper"
          wrapper_operands=$?
          shift
          while [ "$#" -gt 0 ]; do
            record=$1
            record_kind=${record%"${record#?}"}
            token=${record#?}
            case "$token" in
              --) shift; break ;;
              -*)
                case "$wrapper:$token" in
                  env:-C|env:--chdir)
                    shift
                    [ "$#" -gt 0 ] || break
                    append_wrapper_c_dir "$1"
                    shift
                    continue
                    ;;
                  env:--chdir=*)
                    append_wrapper_c_dir "$record_kind${token#--chdir=}"
                    shift
                    continue
                    ;;
                  env:-C?*)
                    append_wrapper_c_dir "$record_kind${token#-C}"
                    shift
                    continue
                    ;;
                  # env -S splits its string into more options and the command.
                  env:-S|env:--split-string)
                    shift
                    [ "$#" -gt 0 ] || break
                    env_split=$1
                    ;;
                  env:-S?*) env_split=$record_kind${token#-S} ;;
                  env:--split-string=*) env_split=$record_kind${token#--split-string=} ;;
                  # -i and -u remove variables that locate git configuration.
                  env:-|env:--ignore-environment|env:--unset|env:--unset=*|env:-[!-]*[iu]*|env:-[iu]*)
                    git_env_dynamic=1
                    [ -z "$git_target_args${GIT_DIR:-}${GIT_WORK_TREE:-}" ] || git_target_dynamic=1
                    env_split=
                    ;;
                  *) env_split= ;;
                esac
                wrapper_value=
                wrapper_takes=1
                if [ -z "$env_split" ]; then
                  wrapper_option_takes_value "$wrapper" "$token" && wrapper_takes=0
                  [ -z "$wrapper_value_glued" ] || wrapper_value=$record_kind$wrapper_value_glued
                  if [ "$wrapper_takes" -eq 0 ]; then
                    shift
                    wrapper_value=${1-}
                  fi
                  # A cluster such as env -iS or -iC, and the options of sudo
                  # that move the command.
                  case "$wrapper:$wrapper_value_option" in
                    env:S) env_split=$wrapper_value ;;
                    env:C|sudo:D|sudo:--chdir) git_root_moved="$wrapper changes the directory git runs in" ;;
                    sudo:R|sudo:--chroot) git_root_moved="sudo --chroot runs git under another root" ;;
                  esac
                fi
                if [ -n "$env_split" ]; then
                  shift
                  # env -S splits at any whitespace and has escapes of its
                  # own (`\_` separates words); read it as shell words only
                  # when every character means the same to both.
                  case "$env_split" in
                    0*[!A-Za-z0-9_./=:,+@%^~?*\'\"\ \	-]*) env_split=1 ;;
                  esac
                  if [ "${env_split%"${env_split#?}"}" != 0 ]; then
                    printf 'G\n'
                    git_unresolved "env -S splits a string only known at run time"
                    matched=0
                    break
                  fi
                  git_child_code=1
                  IFS='
'
                  # shellcheck disable=SC2086
                  set -- $(git_gate_records "${env_split#?}") "$@"
                  IFS=$old_ifs
                  continue
                fi
                # A word that may split, or be -C, may move the command.
                [ "$record_kind" = 0 ] || git_wrapper_dynamic=1
                if [ "$wrapper_takes" -eq 0 ]; then
                  case "${1-}" in
                    1*|2*) git_wrapper_dynamic=1 ;;
                  esac
                  [ "$#" -gt 0 ] && shift
                else
                  shift
                fi
                ;;
              *)
                is_assignment_token "${1#?}" && { git_env_assignment "$1"; shift; continue; }
                # `{}`, as in `xargs -I{}`, is a word, not a group.
                case "$record" in
                  3'{'|3'}') shift; continue ;;
                esac
                break
                ;;
            esac
          done
          # timeout's duration, flock's lock file, taskset's mask and chroot's
          # new root come before the command.
          while [ "$wrapper_operands" -gt 0 ] && [ "$#" -gt 0 ]; do
            case "$1" in
              0';'|0'&&'|0'||'|0'|'|3*) break ;;
              0*|4*) ;;
              *) git_wrapper_dynamic=1 ;;
            esac
            wrapper_operands=$((wrapper_operands - 1))
            shift
          done
          # `flock FILE -c CODE` runs CODE with sh -c.
          case "$wrapper:${1-}" in
            flock:0-c|flock:0--command)
              git_fb_found=0
              git_fb_flag=0
              [ "$#" -lt 2 ] || git_gate_fallback_code "${2#?}"
              if [ "$git_fb_found" -eq 1 ]; then
                [ "$git_hooks_off" -eq 0 ] || git_fb_flag=1
                git_gate_fallback_emit flock
                matched=0
              fi
              shift
              [ "$#" -gt 0 ] && shift
              ;;
          esac
          continue
        fi
        if [ "${token##*/}" = git ]; then
          shift
          git_alias_depth=0
          [ "$shell_cd_mutable" -eq 0 ] || git_config_mutable=1
          while [ "$#" -gt 0 ]; do
            git_arg_record "$1"
            record=$git_arg
            token=${record#?}
            # `git --version && cd x` still reaches the cd.
            case "$record" in
              3*|0';'|0'&&'|0'||'|0'|') break ;;
            esac
            shift
            # A redirection is not a git argument: `git 2>&1 commit`.
            case "$record_kind${token#"${token%%[!0-9]*}"}" in
              0'>'|0'>>'|0'<'|0'<>'|0'>|')
                [ "${1-}" = '3&' ] && shift
                [ "$#" -gt 0 ] && shift
                continue
                ;;
              0'>'*|0'<'*) continue ;;
            esac
            # A word only run time knows may be an option that moves the
            # repository, or the subcommand itself: scan it as a commit in an
            # unknown directory. A long option's quoted value is one word.
            if git_option_takes_value "$token"; then
              [ "$#" -gt 0 ] || continue
              git_arg_record "$1"
              shift
              set -- "$git_arg" "$@"
              [ "$token" = -C ] && append_effective_c_dir "$1"
              git_value=$1
              shift
              case "$token" in
                -c|--git-dir) git_config_option "$token" "$git_value" ;;
                --config-env) git_config_dynamic=1 ;;
              esac
              case "$token" in
                -c|--config-env) git_config_skips_hooks "${git_value#?}" && git_hooks_off=1 ;;
              esac
              case "$token" in
                --git-dir) git_target_value GIT_DIR "$git_value" ;;
                --work-tree) git_target_value GIT_WORK_TREE "$git_value" ;;
              esac
              case "$git_value" in
                0*|4*) continue ;;
              esac
              token=commit
              effective_c_dynamic=1
            else
              case "$record" in
                0--git-dir=*|0--bare) git_config_args="$git_config_args$token
" ;;
                0--config-env=*|4--git-dir=*|4--config-env=*) git_config_dynamic=1 ;;
              esac
              case "$token" in
                --config-env=*) git_config_skips_hooks "${token#--config-env=}" && git_hooks_off=1 ;;
              esac
              case "$token" in
                --git-dir=*) git_target_value GIT_DIR "${record%"$token"}${token#*=}" ;;
                --work-tree=*) git_target_value GIT_WORK_TREE "${record%"$token"}${token#*=}" ;;
              esac
              case "$record" in
                0*) is_git_global_option "$token" && continue ;;
                4--*=*)
                  case "${token%%=*}" in
                    *[!A-Za-z-]*) ;;
                    *) continue ;;
                  esac
                  ;;
              esac
              if [ "${record%"$token"}" != 0 ]; then
                token=commit
                effective_c_dynamic=1
              fi
            fi

            case "$token" in
              status|log|diff|show|add|stage|rev-parse|config|remote|branch|tag|ls-files|describe|shortlog|blame|grep|fetch) ;;
              # Checkout, hooks and the rest may move a path a later cd follows.
              *)
                shell_cd_mutable=1
                [ -n "$shell_cd_mutable_by" ] || { shell_cd_mutable_by=$token; shell_cd_mutable_git='git '; }
                ;;
            esac
            case "$token" in
              commit|push)
                # A root or directory the scan cannot follow gets a group of
                # its own, so that the work tree is still scanned as before.
                [ -z "$git_root_moved" ] || { printf 'G\n'; git_unresolved "$git_root_moved"; }
                [ "$git_wrapper_dynamic" -eq 0 ] || { printf 'G\n'; git_unresolved "a wrapper option or operand before git is only known at run time"; }
                # One G-led group per git command: a later `git commit -a`
                # in the same command line must not hide behind an earlier
                # plain commit or push.
                printf 'G\n'
                [ "$git_head_unknown" -eq 1 ] && git_unresolved "git is reached through a command name only known at run time"
                [ "$effective_c_dynamic" -eq 1 ] && git_unresolved "a git option or argument is only known at run time; an unquoted variable may split into more words, so quote it"
                [ "$shell_cd_unknown$shell_cd_lost" = 00 ] || git_unresolved "${shell_cd_why:-an earlier cd could not be followed}"
                [ -n "$shell_cd_dirs" ] && printf '%s\n' "$shell_cd_dirs" | sed 's/^/D/'
                [ -n "$effective_c_dirs" ] && printf '%s\n' "$effective_c_dirs" | sed 's/^/D/'
                [ "$git_target_changed$git_target_dynamic" = 00 ] || git_unresolved "GIT_DIR or GIT_WORK_TREE changes in a way the scan cannot follow"
                [ -n "$git_target_args" ] && printf '%s' "$git_target_args" | sed 's/^/E/'
                # N: a flag that disables hooks or signing, also from code
                # that is_git_hook_bypass cannot see in the command line.
                git_skip_state=
                for git_word in "$@"; do
                  case "$git_word" in
                    3*|0';'|0'&&'|0'||'|0'|') break ;;
                  esac
                  git_arg_record "$git_word"
                  git_skip_flag "$token" "$git_arg" && git_hooks_off=1
                done
                [ "$git_hooks_off$git_hooks_moved" = 00 ] || printf 'N\n'
                if [ "$token" = commit ]; then
                  [ "$xargs_wrapped" -eq 1 ] && printf 'I\n'
                  [ "$git_index_changed" -eq 1 ] && printf 'I\n'
                  [ "$git_index_forced" -eq 1 ] && printf 'X\n'
                  stage_records=$(git_commit_stage_records "$@")
                  [ -n "$stage_records" ] && printf '%s\n' "$stage_records"
                fi
                matched=0
                break
                ;;
              # Stages after PreToolUse, like `git commit -a`; the scan cannot
              # tell which paths, so a later commit scans all of them.
              add|stage|rm|mv)
                git_index_changed=1
                case "$token" in
                  add|stage) git_add_is_forced "$@" && git_index_forced=1 ;;
                esac
                break
                ;;
              # It may define an alias a later git command runs.
              config)
                git_config_mutable=1
                git_config_sets_hooks "$@" && git_hooks_moved=1
                break
                ;;
              *)
                git_is_builtin "$token" && break
                # Expand an alias in place, so that the checks above see the
                # git command it runs. Git refuses an alias loop.
                git_alias=$(git_subcommand_alias "$token")
                case "$?" in
                  0)
                    if [ "$git_alias_depth" -lt 10 ]; then
                      git_alias_depth=$((git_alias_depth + 1))
                      git_child_code=1
                      IFS='
'
                      # shellcheck disable=SC2086
                      set -- $(git_gate_records "$git_alias") "$@"
                      IFS=$old_ifs
                      continue
                    fi
                    ;;
                  1) break ;;
                esac
                printf 'G\n'
                git_unresolved "git $(git_reason_word "$token") is an alias or external command that could not be expanded"
                matched=0
                break
                ;;
            esac
          done
          git_env_args=
          git_hooks_off=0
          # A command other than git may also relink a path a later cd uses.
          [ "$git_head_unknown" -eq 0 ] || shell_cd_mutable=1
          git_head_unknown=0
          git_env_dynamic=0
          git_target_args=
          git_target_dynamic=0
          git_root_moved=
          command_start=0
          continue
        fi
        # The scan resolves every cd before the command runs, so any earlier
        # command that may create, remove or relink a path leaves a later cd
        # unknown. These cannot; redirections write regular files only.
        case "$record_kind$token" in
          3*|0';'|0'&&'|0'||'|0'|') ;;
          *)
            if [ "$record_kind" != 0 ] || ! git_gate_inert_head "$token"; then
              # A command the gate does not know may still run git commit or
              # push from its arguments. A quoted NAME=value word (5) names
              # no command that exists.
              case "$record_kind$git_fb_skip:$cmd" in
                00:*[Gg][Ii][Tt]*)
                  git_fb_found=0
                  git_fb_flag=0
                  git_gate_fallback_scan 1 "$@"
                  if [ "$git_fb_found" -eq 1 ]; then
                    [ "$git_hooks_off" -eq 0 ] || git_fb_flag=1
                    git_gate_fallback_emit "${token##*/}"
                    matched=0
                  fi
                  ;;
              esac
              # gh subcommands that only talk to the API; checkout, clone,
              # download, extension and alias may write or relink local paths.
              case "$record_kind${token##*/} ${2-} ${3-}" in
                '0gh 0auth 0status'|'0gh 0api '*|'0gh 0search '*|'0gh 0status '*) ;;
                '0gh 0pr 0view'|'0gh 0pr 0list'|'0gh 0pr 0checks'|'0gh 0pr 0diff'|'0gh 0pr 0status'|'0gh 0pr 0edit'|'0gh 0pr 0comment') ;;
                '0gh 0issue 0view'|'0gh 0issue 0list'|'0gh 0issue 0comment'|'0gh 0run 0view'|'0gh 0run 0list'|'0gh 0run 0watch') ;;
                '0gh 0repo 0view'|'0gh 0release 0view'|'0gh 0release 0list') ;;
                *)
                  shell_cd_mutable=1
                  [ -n "$shell_cd_mutable_by" ] || shell_cd_mutable_by=${token##*/}
                  ;;
              esac
            fi
            ;;
        esac
      fi

      mentions_git_config_env "$token" && git_env_changed=1
      # Only these builtins set or remove a variable named in an argument;
      # any other command, such as cat for a commit message, does not.
      [ "$command_start" -eq 1 ] && shell_head=$record_kind$token
      case "$shell_head" in
        0export|0unset|0declare|0typeset|0readonly|0local|0read)
          mentions_git_target_env "$token" && git_target_changed=1
          ;;
      esac
      shift
      if [ "$record_kind" = 3 ] || is_shell_command_separator "$token"; then
        # `>&2` and `2>&1` redirect; they neither background anything nor
        # start a command.
        case "$record_kind$token:$shell_cd_prev" in
          '3&:'*'>'|'3&:'*'<') shell_cd_prev=$token; continue ;;
          *) shell_cd_boundary "$token" "${1-}" "$command_start" ;;
        esac
        command_start=1
        effective_c_dirs=
        effective_c_dynamic=0
        git_wrapper_dynamic=0
        xargs_wrapped=0
        git_root_moved=
        git_fb_skip=0
        git_head_sub=0
        # An assignment no git command took may stay in the environment.
        [ -z "$git_env_args" ] && [ "$git_env_dynamic" -eq 0 ] || git_env_changed=1
        git_env_args=
        git_env_dynamic=0
        git_hooks_off=0
        [ -z "$git_target_args" ] && [ "$git_target_dynamic" -eq 0 ] || git_target_changed=1
        git_target_args=
        git_target_dynamic=0
        git_config_args=
        git_config_dynamic=0
      else
        command_start=0
      fi
      shell_cd_prev=$token
    done
    return "$matched"
  )
}

is_git_hook_bypass() {
  cmd=$1
  (
    set -f
    words=$(git_command_records "$cmd")
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    IFS=$old_ifs

    while [ "$#" -gt 0 ]; do
      token=${1#?}
      shift
      case "$token" in
        --no-verify|--no-gpg-sign) return 0 ;;
      esac
    done
    return 1
  )
}

check_git_command() {
  cmd=$1
  workdir=${2:-}
  git_c_records=$(is_git_commit_or_push "$cmd" "$workdir")
  git_command_status=$?
  if [ "$git_command_status" -eq 0 ]; then
    if is_git_hook_bypass "$cmd" || printf '%s\n' "$git_c_records" | grep -qx N; then
      info "$PROGRAM: blocked git command that disables hooks/signing"
      exit 2
    fi
    if ! command -v git >/dev/null 2>&1; then
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: git is unavailable, so staged changes could not be scanned;"
      return $?
    fi
    # A group with U cannot be scanned. The closed policy blocks the whole
    # command; the open policy still scans every other group.
    if printf '%s\n' "$git_c_records" | grep -qx F; then
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: awk failed while reading the command variables of this command, so a git commit or push it may run could not be resolved;"
    elif printf '%s\n' "$git_c_records" | grep -qx U; then
      git_c_reason=$(printf '%s\n' "$git_c_records" | sed -n 's/^Y//p' | head -n 1)
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: a git commit or push may run in a working directory, or with arguments, a git alias or shell code, that could not be resolved safely (${git_c_reason:-unresolved}); run that git command as its own Bash call, as git -C <absolute path> with literal arguments;"
    fi
    (
      set -f
      git_scan_status=0
      git_group=
      git_in_group=0
      git_ifs=$IFS
      IFS='
'
      # The trailing G flushes the last group.
      # shellcheck disable=SC2086
      for git_c_record in $git_c_records G; do
        if [ "$git_c_record" != G ]; then
          git_group="$git_group$git_c_record
"
          continue
        fi
        case "
$git_group" in
          *'
U
'*) git_in_group=0 ;;
        esac
        if [ "$git_in_group" -eq 1 ]; then
          IFS=$git_ifs
          scan_git_command_group "${workdir:-$(pwd)}" "$git_group"
          git_group_status=$?
          if [ "$git_group_status" -eq 1 ] || [ "$git_scan_status" -eq 0 ]; then
            git_scan_status=$git_group_status
          fi
        fi
        git_in_group=1
        git_group=
      done
      exit "$git_scan_status"
    )
    git_scan_status=$?
    case "$git_c_records" in
      *'
'[WIPX]*) git_scan_message="changes this git commit would stage contain secret-like values; blocking git command" ;;
      *) git_scan_message="staged changes contain secret-like values; blocking git command" ;;
    esac
    if [ "$git_scan_status" -eq "$GIT_SCAN_STATUS_NO_REPOSITORY" ]; then
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: a git commit or push runs in a directory that does not exist or is not a git repository when the hook runs, such as one this command creates, so what it commits could not be scanned; create the repository in one Bash call and commit or push in the next;"
      return $?
    fi
    block_on_scan_status "$git_scan_status" "$git_scan_message"
  fi
}

# Scan one git commit/push command: apply its D<dir> cwd changes in order, then
# scan the index plus whatever its W/P records say Git will stage itself.
scan_git_command_group() (
  set -f
  CDPATH= cd -- "$1" 2>/dev/null || exit "$SCAN_STATUS_UNAVAILABLE"
  group_stage_all=0
  group_untracked=0
  group_pathspecs=
  group_env=
  group_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  for group_record in $2; do
    case "$group_record" in
      D*)
        # A shell cd resolves `..` logically unless `set -P` is on; git -C and
        # env -C resolve it physically. Refuse to guess when they disagree.
        group_physical=$(CDPATH= cd -P -- "${group_record#D}" 2>/dev/null && pwd -P) \
          || exit "$GIT_SCAN_STATUS_NO_REPOSITORY"
        CDPATH= cd -- "${group_record#D}" 2>/dev/null || exit "$GIT_SCAN_STATUS_NO_REPOSITORY"
        [ "$(pwd -P)" = "$group_physical" ] || exit "$SCAN_STATUS_UNAVAILABLE"
        ;;
      E*) group_env="$group_env${group_record#E}
" ;;
      W) group_stage_all=1 ;;
      I) group_stage_all=1; [ "$group_untracked" -eq 2 ] || group_untracked=1 ;;
      X) group_stage_all=1; group_untracked=2 ;;
      P*) group_pathspecs="$group_pathspecs${group_record#P}
" ;;
      *) exit "$SCAN_STATUS_UNAVAILABLE" ;;
    esac
  done
  # Git reads a relative GIT_DIR or GIT_WORK_TREE from where it starts; the
  # scan changes directory after that.
  for group_assignment in $group_env; do
    group_value=${group_assignment#*=}
    case "$group_value" in
      /*) ;;
      *) group_value=$(pwd -P)/$group_value ;;
    esac
    export "${group_assignment%%=*}=$group_value"
  done
  # The scan runs Git from the work tree root, where it would find another
  # repository than the one GIT_WORK_TREE was given with.
  case "
$group_env" in
    *'
GIT_DIR='*|'
') ;;
    *)
      GIT_DIR=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit "$GIT_SCAN_STATUS_NO_REPOSITORY"
      export GIT_DIR
      ;;
  esac
  # shellcheck disable=SC2086
  set -- $group_pathspecs
  IFS=$group_ifs
  set +f
  scan_commit_candidate "$group_stage_all" "$group_untracked" "$@"
)

check_bash_command() {
  input=$1
  need_cmd jq
  json_value_to "$JV_COMMAND" "$input"
  cmd=$jv_out
  [ -n "$cmd" ] || return 0
  # POSIX sh has no locals, so a helper that assigns the bare name `cmd` would
  # overwrite the command mid-function. The deny-path helpers also rejoin tokens
  # with single spaces, which destroys a real newline separator — collapsing
  # `cd X<newline>git commit` into one word and hiding the commit from the
  # detector (#127). Keep an untouched copy and use it for every later check.
  raw_cmd=$cmd
  # Set only by the deny-pattern check below, never from the environment.
  unset mv_strip_in mv_strip_out
  json_value_to "$JV_WORKDIR" "$input"
  workdir=$jv_out

  # A harmless, deterministic sentinel lets setup prove that the host really
  # dispatched PreToolUse without naming or touching any sensitive file. Keep
  # this before configurable policy checks so the probe is stable everywhere.
  case "$cmd" in
    *"$LIVE_PRE_TOOL_PROBE"*)
      info "$PROGRAM: blocked the live PreToolUse probe"
      exit 2
      ;;
  esac

  [ -f "$DENY_BASH_PATTERNS" ] || die "deny bash policy not found: $DENY_BASH_PATTERNS"
  patterns=$(mktemp_file) || die "failed to create temp file"
  grep -Ev '^[[:space:]]*(#|$)' "$DENY_BASH_PATTERNS" >"$patterns"
  if [ -s "$patterns" ]; then
    # A message body that quotes a risky command (a report that `printenv` was
    # blocked) only sends that text; the gitleaks scan below still sees it.
    if pattern_cmd=$(bash_strip_message_values "$cmd"); then
      mv_strip_in=$cmd mv_strip_out=$pattern_cmd
    else
      pattern_cmd=$cmd
    fi
    if env_stripped=$(bash_strip_safe_env_lookups "$pattern_cmd"); then
      pattern_cmd=$env_stripped
    fi
    # A backquote or `$(` in a single-quoted word or a quoted-delimiter
    # here-document body is text, so when only echo, cat or a message command
    # receives it the patterns must not read it as a substitution (94S-1712).
    # Only such a command line pays for the check; this runs before the
    # quote-removed copy below so that copy reads the rewrite too.
    case "$pattern_cmd" in
      *'`'*|*'$('*)
        case "$pattern_cmd" in
          *"'"*|*'<<'*)
            if literal_cmd=$(bash_neutralize_literal_substitutions "$pattern_cmd") \
              && [ -n "$literal_cmd" ]; then
              pattern_cmd=$literal_cmd
            fi
            ;;
        esac
        ;;
    esac
    # The shell removes quotes before it runs a word, so `c'u'rl` and
    # `"https"://user:pw@host` reach the process as the name or URL the
    # patterns know. Read that copy too, after the same exemptions; the text
    # as written is still read, so a failed rewrite only loses the extra copy.
    dp_base=$pattern_cmd
    if bash_quoting_may_hide_name "$pattern_cmd" \
      && joined_cmd=$(bash_join_quoted_words "$pattern_cmd") \
      && [ "$joined_cmd" != "$pattern_cmd" ]; then
      pattern_cmd="$pattern_cmd
$joined_cmd"
    fi
    printf '%s\n' "$pattern_cmd" | grep -E -q -f "$patterns"
    grep_status=$?
    # Where a block is reported: the command as written, unless an exemption
    # above already changed its words.
    dp_where_text=$cmd
    # A hit may sit in a quoted word that a search command only reads (a
    # regex alternation ending in `env|`). Only a hit pays for the second
    # look, without those words.
    if [ "$grep_status" -eq 0 ] && dp_view=$(bash_neutralize_search_words "$dp_base") \
      && [ -n "$dp_view" ]; then
      pattern_cmd=$dp_view
      if bash_quoting_may_hide_name "$dp_view" \
        && joined_cmd=$(bash_join_quoted_words "$dp_view") \
        && [ "$joined_cmd" != "$dp_view" ]; then
        pattern_cmd="$dp_view
$joined_cmd"
      fi
      printf '%s\n' "$pattern_cmd" | grep -E -q -f "$patterns"
      grep_status=$?
      [ "$dp_base" != "$cmd" ] || dp_where_text=$dp_view
    fi
    # A quoted word that a shell runs (`bash -c 'env | ...'`, eval, ssh) is
    # a command line of its own. Only a command that may hold one pays.
    if [ "$grep_status" -eq 1 ]; then
      case "$dp_base" in
        *[\'\"]*)
          case "$dp_base" in
            *sh[[:space:]]*|*eval[[:space:]]*|*trap[[:space:]]*|*watch[[:space:]]*|*su[[:space:]]*)
              if dp_program=$(bash_shell_program_texts "$dp_base") && [ -n "$dp_program" ]; then
                printf '%s\n' "$dp_program" | grep -E -q -f "$patterns"
                grep_status=$?
                if [ "$grep_status" -eq 0 ]; then
                  pattern_cmd=$dp_program
                  dp_where_text=
                elif [ "$grep_status" -ne 1 ]; then
                  grep_status=2
                fi
              fi
              ;;
          esac
          ;;
      esac
    fi
    rm -f "$patterns"
    case "$grep_status" in
      0)
        info "$PROGRAM: blocked risky shell command by deny pattern"
        # Name the first matching line so the reader can tell which idiom
        # was caught. Only a block pays for this per-line search.
        dp_hit=$(grep -n -Ev '^[[:space:]]*(#|$)' "$DENY_BASH_PATTERNS" | while IFS= read -r dp_line; do
          if printf '%s\n' "$pattern_cmd" | grep -E -q -e "${dp_line#*:}"; then
            printf '%s' "${dp_line%%:*}"
            break
          fi
        done)
        if [ -n "$dp_hit" ]; then
          # The entry is policy text, not a secret; the command's own text is
          # not shown, only where the entry matched. A long entry is cut.
          dp_entry=$(sed -n "${dp_hit}p" "$DENY_BASH_PATTERNS")
          dp_where=
          if [ -z "$dp_where_text" ]; then
            dp_where=' in quoted text that a shell runs'
          elif dp_words=$(bash_match_words "$dp_where_text" "$dp_entry"); then
            dp_where=" at $dp_words of the command"
          fi
          info "$PROGRAM: matched deny-bash-patterns line $dp_hit ($DENY_BASH_PATTERNS)$dp_where"
          [ "${#dp_entry}" -le 120 ] || dp_entry=$(printf '%s' "$dp_entry" | cut -c 1-117)...
          info "$PROGRAM: deny-bash-patterns entry: $dp_entry"
        fi
        case "$(hook_host)" in
          codex)
            dp_read='Read an ordinary file with a shell command on that file alone'
            dp_next='If the text was only a document body, write the file with apply_patch'
            ;;
          *)
            dp_read='Read files with the Read tool'
            dp_next='If the text was only a document body or a search pattern, write the file with the Write tool or search with the Grep tool'
            ;;
        esac
        info "$PROGRAM: this command prints, captures or sends a secret value (an environment dump, a credential store read, a token in a request); do not retry it in another form. $dp_read, and let the program that needs a secret read it from its own environment or config."
        info "$PROGRAM: $dp_next; if a secret value itself is needed, ask the user."
        exit 2
        ;;
      1) ;;
      *)
        # grep failed (e.g., invalid ERE in a custom deny file). Fail closed —
        # silently allowing here would let the rest of the deny list be bypassed.
        info "$PROGRAM: deny-bash-patterns scan failed; refusing to allow command"
        exit 2
        ;;
    esac
  else
    rm -f "$patterns"
  fi

  # Run the deny-path check inside the event workdir. bash_strip_allowed_tokens
  # resolves a template-named token (e.g. a `.env.example` symlink) with realpath
  # to decide whether it points at a deny-listed secret (#132); a relative token
  # resolves against the process cwd, so if the host dispatched the hook from a
  # different directory than the command targets, the resolution — and the
  # symlink check that depends on it — would silently no-op and fall open. cd
  # first, mirroring check_git_command.
  #
  # bash_matches_deny_path returns 0 on a deny match and 1 on none; its internal
  # fail-closed path exits 2, which in this subshell no longer terminates the
  # process, so re-propagate every status but 1 (no-match) as a block. `die` on
  # an inaccessible workdir also surfaces as a non-1 status (fail closed).
  #
  # The subshell's stdout carries only the match report (every helper it calls
  # captures its own output), so it is safe to collect here and replay as a
  # diagnosis. A non-match produces no output.
  deny_report=$(
    [ -n "$workdir" ] && { CDPATH= cd -- "$workdir" 2>/dev/null \
      || die "hook workdir is not accessible: $workdir"; }
    bash_matches_deny_path "$raw_cmd" "$input"
  )
  case "$?" in
    0)
      dr_mode=$(deny_read_mode) || dr_mode=invalid
      if [ "$dr_mode" = mask ] && dr_target=$(cat_mask_target "$raw_cmd" "$workdir"); then
        deny_read_masked_block "$dr_target" "$workdir"
      fi
      info "$PROGRAM: blocked shell command referencing a deny-listed path"
      info "$PROGRAM: reason=bash_protected_path_text_match; raw Bash command text matched a protected-path pattern and may be a file operand or source/search text; command was not executed"
      [ -n "$deny_report" ] && info "$PROGRAM: $deny_report"
      # Name the tool for each job, not a way to reword the command: text
      # rewritten to look unlike a path can still open the protected file.
      # In mask mode the block can carry a masked view instead of the file,
      # so say that rather than "cannot open".
      case "$dr_mode" in
        mask)
          dr_read_note='The Read tool shows a protected file only as a masked view.'
          dr_limits='apart from a masked view, checking a protected file or reading its metadata is not supported'
          ;;
        *)
          dr_read_note='The Read tool cannot open a protected file either.'
          dr_limits='checking whether a protected file exists or reading its metadata is not supported'
          ;;
      esac
      case "$(hook_host)" in
        codex) info "$PROGRAM: for an ordinary file, edit it with apply_patch and read it with a shell command on that file alone; Codex searches run as shell commands, so keep file name and content searches to paths that hold no protected file. A program an interpreter runs (python3 - <<EOF, node -e) stays blocked while its text names a protected file, because the guard cannot tell a string from a path it opens." ;;
        *) info "$PROGRAM: for an ordinary file, use the Read, Edit or Write tool (write a document body with the Write tool, not a here-document); find file names with the Glob tool and search contents with the Grep tool, outside protected paths. $dr_read_note A program an interpreter runs (python3 - <<EOF, node -e) stays blocked while its text names a protected file, because the guard cannot tell a string from a path it opens." ;;
      esac
      info "$PROGRAM: $dr_limits; if that or the content of a protected file is needed, ask the user. Do not weaken the deny list or reshape the command to pass this check."
      deny_read_mode_notice "$dr_mode"
      exit 2
      ;;
    1) ;;
    *) exit 2 ;;
  esac

  scan_shell_command_text "$raw_cmd"
  block_on_scan_status "$?" "shell command contains secret-like values"

  # Path-policy helpers above intentionally dequote their input and use global
  # POSIX-shell variables. raw_cmd preserves the original quoting for git cwd
  # parsing.
  check_git_command "$raw_cmd" "$workdir"
}

scan_tool_input() {
  input=$1
  label=$2
  need_cmd jq
  text=$(printf '%s' "$input" | jq -c '.tool_input // {}')
  scan_text_direct "$label" "$text"
  block_on_scan_status "$?" "$label contains secret-like values"
}

# The scan view stays in its own variable: the PII check after this one must
# read the original event from the caller's `input`.
scan_mcp_input() {
  need_cmd jq
  text=$(printf '%s' "$1" | jq -c '.tool_input // {}')
  if is_figma_mcp_tool "${2:-}"; then
    text=$(figma_file_key_scan_view "$text")
  fi
  scan_text_direct "MCP tool input" "$text"
  block_on_scan_status "$?" "MCP tool input contains secret-like values"
}

# Figma MCP tools take a file key in `fileKey` and return it in `file_key`. The
# key names a document, not a credential: opening the file still needs a Figma
# login with access to it. generic-api-key reads the `key` in those field names
# as a credential label, and the output masker then replaces every copy of the
# value, including the one in the file URL, so the session loses the key.
is_figma_mcp_tool() {
  figma_tool_rest=${1#mcp__}
  [ "$figma_tool_rest" != "${1:-}" ] || return 1
  figma_tool_server=${figma_tool_rest%%__*}
  [ "$figma_tool_server" != "$figma_tool_rest" ] || return 1
  [ -n "${figma_tool_rest#*__}" ] || return 1
  case "$figma_tool_server" in
    *[Ff][Ii][Gg][Mm][Aa]*) return 0 ;;
  esac
  return 1
}

# Prints the copy of a JSON value that the detectors scan for a Figma MCP tool:
# a 22-character alphanumeric value is blanked only in a `fileKey`/`file_key`
# field, as an object member or as quoted JSON text inside a string. The event
# itself is not changed. The same value anywhere else is still a finding, and
# the masker then replaces every copy. On any jq error the unchanged value is
# printed, so the full value is scanned.
figma_file_key_scan_view() {
  if figma_view=$(printf '%s' "$1" | jq -c "$JQ_WALK"'
      def blank_key: if type == "string" and length == 22
                        and test("\\A[A-Za-z0-9]{22}\\z")
                     then "" else . end;
      walk(if type == "object"
           then with_entries(if .key == "fileKey" or .key == "file_key"
                             then .value |= blank_key else . end)
           elif type == "string"
           then gsub("\"fileKey\"[ \t\r\n]*:[ \t\r\n]*\"[A-Za-z0-9]{22}\""; "\"fileKey\":\"\"")
                | gsub("\"file_key\"[ \t\r\n]*:[ \t\r\n]*\"[A-Za-z0-9]{22}\""; "\"file_key\":\"\"")
           else . end)
    ' 2>/dev/null) && [ -n "$figma_view" ]; then
    printf '%s' "$figma_view"
  else
    printf '%s' "$1"
  fi
}

scan_network_input() {
  input=$1
  check_sensitive_reads "$input"
  scan_tool_input "$input" "network tool input"
}

scan_proposed_write() {
  input=$1
  tool=$2
  need_cmd jq

  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit|apply_patch) ;;
    *) return 0 ;;
  esac
  content=$(tool_proposed_text "$input" "$tool")
  case "$tool" in
    apply_patch)
      scan_text_direct "proposed apply_patch added lines" "$content" ;;
    Write)
      path=$(tool_write_path "$input" "$tool")
      scan_file_text_direct "proposed Write content" "$path" "$content" ;;
    *)
      path=$(tool_write_path "$input" "$tool")
      scan_file_fragment_direct "proposed $tool content" "$path" "$content" ;;
  esac
  block_on_scan_status "$?" "proposed $tool contains secret-like values"
}

is_broad_search_path() {
  path=${1:-}
  normalized=$(normalize_path "$path")
  case "$normalized" in
    ''|'.'|'./'|'/') return 0 ;;
  esac
  cwd=$(pwd -P 2>/dev/null || pwd)
  [ "$normalized" = "$cwd" ] && return 0
  return 1
}

is_broad_grep_glob() {
  case "${1:-}" in
    ''|'*'|'**'|'**/*'|'./**/*'|'*.*') return 0 ;;
    *) return 1 ;;
  esac
}

is_secret_search_pattern() {
  pattern=$1
  case "$pattern" in
    ''|'.*'|'.+'|'^.*$'|'[[:print:]]*'|'[\\s\\S]*') return 0 ;;
  esac
  printf '%s\n' "$pattern" \
    | grep -Eiq '(secret|token|password|passwd|credential|api[^[:alnum:]]*key|access[^[:alnum:]]*key|private[^[:alnum:]]*key|authorization|bearer|aws|openai|anthropic|stripe|github|ghp_|sk-)'
}

check_broad_grep_content() {
  input=$1
  output_mode=$(json_value '.tool_input.output_mode // empty' "$input")
  [ "$output_mode" = "content" ] || return 0

  path=$(json_value '.tool_input.path // empty' "$input")
  glob=$(json_value '.tool_input.glob // empty' "$input")
  pattern=$(json_value '.tool_input.pattern // empty' "$input")

  is_broad_search_path "$path" || return 0
  is_broad_grep_glob "$glob" || return 0
  if is_secret_search_pattern "$pattern"; then
    info "$PROGRAM: blocked broad Grep content search that could expose secrets"
    exit 2
  fi
}

hook_pre_tool() {
  input=$(read_stdin)
  HOOK_EVENT=PreToolUse
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    # Refuse an over-limit input before the call copies it ('' resets alike).
    # Inline, not a helper: in dash each function definition costs every hook.
    if [ "${#input}" -le 262144 ]; then json_value_prime "$input" measured; else json_value_prime ''; fi
    # One primed JSON object is exactly what the jq object check accepts.
    json_input_is_primed_object "$input" \
      || validate_hook_object PreToolUse "$input" || return 0
  fi
  if ! hook_dependencies_ready; then
    # A scan that cannot run is not clean, but it does not stop the checks
    # that need no scanner. The closed policy still blocks every call here.
    if [ "$(infrastructure_failure_mode)" = closed ] \
      || ! hook_policy_dependencies_ready; then
      emit_degraded_hook_warning PreToolUse "$input"
      return 0
    fi
    HOOK_SCANNER_UNAVAILABLE=1
  fi
  need_cmd jq
  if [ -z "$input" ]; then
    finish_pre_tool_scanner_unavailable
    return 0
  fi

  # A host may serialize tool_input as a JSON-encoded string instead of an
  # object. When that string decodes to an *object*, the precise-field extractors
  # (.tool_input.command / .content / .file_path) would otherwise error on a
  # string and yield nothing, so the Bash/Write checks silently no-op
  # (fail-open). Decode it back into an object so those checks see real fields.
  #
  # Only an object is substituted. A string that does NOT decode to an object
  # (plain text, or JSON that decodes to an array/scalar) is left UNCHANGED: the
  # generic scanners for Read/Grep/WebFetch/WebSearch/MCP use
  # `.tool_input // {} | .. | strings`, which already inspects a raw string leaf.
  # Coercing such input to {} would drop that leaf and let a bare secret string
  # (e.g. an mcp__* tool_input of "AGENT_GUARD_TEST_SECRET") through — a
  # regression. Recover-not-block keeps a string-encoding host from being
  # over-blocked.
  json_value_to "$JV_INPUT_TYPE" "$input"
  if [ "$jv_out" = "string" ]; then
    input=$(printf '%s' "$input" \
      | jq -c '(.tool_input | try fromjson catch null) as $decoded
               | if ($decoded | type) == "object" then .tool_input = $decoded else . end')
  fi

  json_value_to "$JV_TOOL" "$input"
  tool=$jv_out

  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit|apply_patch)
      scan_proposed_write "$input" "$tool"
      ;;
    Read|NotebookRead|Grep|Glob)
      check_sensitive_reads "$input" "$tool"
      if [ "$tool" = "Grep" ]; then
        check_broad_grep_content "$input"
      fi
      ;;
    Bash)
      check_bash_command "$input"
      ;;
    WebFetch|WebSearch)
      scan_network_input "$input"
      ;;
    Agent|Task)
      # Delegation is a trust boundary too: the task prompt leaves the parent
      # context and the returned result re-enters it. `Agent` is the current
      # tool name on Claude and Codex; `Task` keeps coverage for older Claude
      # releases that still emit the legacy alias.
      scan_tool_input "$input" "subagent delegation input"
      ;;
    mcp__*)
      scan_mcp_input "$input" "$tool"
      ;;
  esac

  check_pii_hook_input "$input" "$tool"
  finish_pre_tool_scanner_unavailable
}

# Reached only when no check blocked, so the open warning never shares stdout
# with a block. Its once-per-session marker is the infrastructure one.
finish_pre_tool_scanner_unavailable() {
  [ "$HOOK_SCANNER_UNAVAILABLE" = 1 ] || return 0
  handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
    "$(degraded_hook_message scanner)"
}

is_mutation_tool() {
  case "$1" in
    Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash|mcp__*) return 0 ;;
    *) return 1 ;;
  esac
}

# --- Tool-output secret redaction (PostToolUse) ------------------------------
# The pre-tool checks only ever see a command string or a file path; they never
# see what a command PRINTS or what a file read RETURNS. A shell command that
# dumps credentials to stdout (an env-printing CLI, `cat` of a secret-bearing
# note) therefore leaks the secret into the model context unscanned. PostToolUse
# can replace an already-produced result before the model sees it. Claude uses
# `hookSpecificOutput.updatedToolOutput`; Codex blocks the original result and
# receives a sanitized replacement in `additionalContext`.
#
# Fail-closed: this path runs for (potentially) every tool result, and a
# detector, parser or rewrite failure never publishes a partial rewrite. Masking
# then falls back to the conservative whole-leaf rewrite, and when even that
# cannot be serialized the original result is blocked with a secret-free
# replacement. Every replacement keeps the tool's native output shape.

output_redact_enabled() {
  case "${AGENT_GUARD_OUTPUT_REDACT:-mask}" in
    off) return 1 ;;
    *) return 0 ;;
  esac
}

# One jq tree-walk definition shared by every response rewriter below (it also
# keeps jq 1.5, which lacks the walk builtin, working). Prepend as
# `jq -c "$JQ_WALK"'<program>'`.
JQ_WALK='def walk(f): def w: if type == "object" then map_values(w)
                    elif type == "array" then map(w)
                    else . end | f; w;
'

# Key-aware companion to the walk above, for the redactors that rewrite a
# tool_response the host feeds straight back into the conversation as
# `updatedToolOutput`. Anthropic content blocks are a discriminated union: the
# `type`, `source.type` and `media_type` strings select which block shape the
# API expects. Masking one produces a block tagged `[REDACTED]`, every later
# request is rejected with `Input tag '[REDACTED]' ... does not match any of
# the expected tags`, and because the host persists the rewritten block in the
# session transcript the failure is permanent — a retry replays it. So the leaf
# filter is skipped for a discriminator, but ONLY when the value is exactly one
# of the protocol tokens below. Allowlisting whole values rather than key names
# is what keeps this from becoming a hole: no secret is equal to `image/png`,
# so nothing that needs masking can reach the skip, and a `type` carrying
# anything else is still replaced. The tokens are one flat list instead of one
# set per key because hosts are not consistent about which key carries which
# token — Claude Code's Read returns `{"type":"image","file":{"type":
# "image/png",...}}`, a media type under a plain `type`, and tags a PDF read
# `{"type":"pdf","file":{"base64":...}}` with no media type at all. MCP's own
# image block spells the same thing `mimeType`. Claude Code's built-in tools add
# words of their own that it checks before taking a replacement (#612): Read's
# `notebook` and `parts` and its PDF pages' `mediaType`, Write's `create`
# and `update`, Grep's `mode` and NotebookEdit's `cell_type`. Prepend as
# `jq -c "$JQ_SHAPE_SAFE_WALK"'<program>'`.
# Resolve the extent records secretish_env_values flags (`agent_guard_extent`)
# once every detector's literals are in the bundle. An extent (`[hidden]`,
# `<hunter2 Summer>`) widens a literal of the same occurrence (`[hidden`,
# `<hunter2`), which is already in the bundle. It goes out as a plain literal
# only when no other plain literal can partially overlap it in any text; then
# replacing it cannot change what another literal masks, in any length order
# a redactor uses (jq and Rust count characters, the exec plaintext path
# counts bytes). Otherwise it is dropped and masking is exactly as before.
# A literal that starts inside the extent and runs past its end holds the
# last character of the extent; that presence test alone drops the extent.
# A literal that starts before the extent and ends inside it has a proper
# tail, opening with the first character of the extent, that the extent
# starts with; those tails are checked exactly (the literal of the same
# occurrence, `[[x` for `[[x]]`, has such a tail that does not match). More
# than eight candidate tails count as an overlap, which bounds the cost.
# split is used rather than indices or rindex, whose string offsets are
# bytes, not characters, on jq 1.6. Dropping an extent that could never
# overlap only leaves the old masking in place.
JQ_SETTLE_EXTENTS='def overlap_from_before($e):
      ($e[:1]) as $f
      | split($f) as $parts
      | ($parts | length) as $n
      | $n > 9
        or any(range(1; $n)
               | select(. > 1 or ($parts[0] | length) > 0);
               ($f + ($parts[.:] | join($f))) as $tail
               | ($e | startswith($tail)));
    def settle_extents:
      map(select(type == "string")) as $plain
      | map(if type == "object" and .agent_guard_extent == true
            then .literal as $e
                 | if ($e | type) != "string" or ($e | length) < 2
                      or any($plain[];
                             . == $e
                             or index($e[-1:]) != null
                             or overlap_from_before($e))
                   then empty else $e end
            else . end)
      | unique;'

JQ_SHAPE_SAFE_WALK='def protocol_discriminator($key): . as $v
    | ($key == "type" or $key == "media_type" or $key == "mimeType"
       or $key == "mediaType" or $key == "encoding" or $key == "mode"
       or $key == "cell_type")
      and (["text","image","document","search_result","browser_state",
            "tool_reference","tool_use","tool_result","thinking",
            "redacted_thinking","base64","url","file","content","pdf",
            "image/png","image/jpeg","image/gif","image/webp",
            "application/pdf","text/plain",
            "notebook","parts","file_unchanged","create","update",
            "files_with_matches","count","code","markdown"]
           | map(. == $v) | any);
def shape_safe_walk(f): def w($key):
      if type == "object"
      then with_entries(. as $e | .value = ($e.value | w($e.key)))
      elif type == "array" then map(w(null))
      elif type == "string" and protocol_discriminator($key) then .
      else f
      end;
    w(null);
def binary_media_type: . as $v
    | (["image/png","image/jpeg","image/gif","image/webp","application/pdf"]
       | map(. == $v) | any);
def binary_block:
      type == "object"
      and (((.type == "image" or .type == "document")
            and (.source | type) == "object"
            and .source.type == "base64"
            and (.source.data | type) == "string"
            and (.source.media_type | binary_media_type))
           or (.type == "image"
               and (.file | type) == "object"
               and (.file.base64 | type) == "string"
               and (.file.type | binary_media_type))
           or (.type == "pdf"
               and (.file | type) == "object"
               and (.file.base64 | type) == "string")
           or (.type == "image"
               and (.data | type) == "string"
               and (.mimeType | binary_media_type))
           or ((.base64 | type) == "string"
               and (.mediaType | binary_media_type)));
def binary_payload_path:
      if has("source") then ["source", "data"]
      elif has("file") then ["file", "base64"]
      elif has("mediaType") then ["base64"]
      else ["data"]
      end;
def binary_payload_paths: . as $root
    | [[], paths]
    | map(select(. as $p | $root | getpath($p) | binary_block))
    | map(. as $p | $p + ($root | getpath($p) | binary_payload_path));
def strip_binary_payloads:
      reduce binary_payload_paths[] as $p (.; setpath($p; ""));
def restore_binary_payloads($orig):
      reduce ($orig | binary_payload_paths[]) as $p
        (.; setpath($p; $orig | getpath($p)));
'

# Literal splitting avoids regex replacement overhead on control-heavy leaves.
frame_json_string_leaves() {
  jq -rj '
    .. | strings
    | (split("\u001f") | join("\u001f\u001f"))
    | (split("\u001e") | join("\u001f\u001e"))
    | . + "\u001e\n"
  '
}

# Frame one raw plaintext leaf without decoding it as UTF-8. This gives exec's
# byte-oriented assignment pass the same collision-safe transport used for JSON
# leaves while preserving invalid bytes inside a credential value.
frame_plaintext_leaf() {
  LC_ALL=C awk '
    BEGIN {
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
    }
    NR > 1 { printf "\n" }
    {
      # Both patterns/replacements contain only literal control bytes. Escape
      # US first so the US introduced for RS is not escaped again. Whole-record
      # substitution avoids one interpreted function call/printf per byte.
      gsub(escape, escape escape)
      gsub(boundary, escape boundary)
      printf "%s", $0
    }
    END { printf "%s", boundary }
  '
}

# Recall booster for the most common leak shape: `KEY=value`, `export KEY=value`
# or `KEY: value` dumps whose key name looks secret-bearing. gitleaks misses most
# of these (custom value formats), so emit the VALUE for literal redaction.
#
# Read an RS-delimited, US-escaped leaf stream. Each leaf gets independent
# multiline quote state. Emits JSON-string records by default, or raw framed
# secret records for exec's byte-preserving plaintext pass. Probe modes exit on
# the first non-sanitized assignment key. Framed input modes append ordinary
# byte spans in bulk; control bytes retain the same escape/boundary decoder.
secretish_env_values() {
  record_mode=${1:-json}
  LC_ALL=C awk -v record_mode="$record_mode" '
    BEGIN {
      # AGENT_GUARD_KEY_NAME_REDACT. Only an unset, empty or exact `off` value
      # keeps the default. Any other value, a typo included, selects the
      # stricter masking by key name (see self_named_reference).
      key_name_redact = ENVIRON["AGENT_GUARD_KEY_NAME_REDACT"]
      key_name_redact = !(key_name_redact == "" || key_name_redact == "off")
      core = "password|passwd|passphrase|db[_-]?pass(word)?|secret|secret[_-]?key|token|refresh[_-]?token|auth[_-]?token|session[_-]?key|api[_-]?key|access[_-]?key|private[_-]?key|signing[_-]?key|encryption[_-]?key|credential|client[_-]?secret|bearer|webhook"
      # Match assignment keys whose secret-bearing term is terminal or carries
      # only a bounded qualifier suffix (AWS_ACCESS_KEY_ID, API_KEY_VALUE,
      # DB_PASSWORD_HASH). An unbounded suffix over-masked metadata keys such
      # as password_policy or token_name; no suffix at all dropped these very
      # common real-credential names. Bare PATH/PWD remain excluded; compound
      # _pat/_pwd keys keep their intended coverage.
      qualifier = "([_-](id|ids|value|val|hash|b64|base64|hex|enc|encrypted|encoded|raw|str|string|pem|cert|json|prod|production|dev|development|staging|stage|test|local|old|new|current|primary|secondary|backup|main|default|[0-9]+))*"
      key = "[a-z0-9_.-]*(" core "|[_-](pat|pwd))" qualifier
      # `(` and `[` open an argument or subscript list, so an assignment can
      # begin immediately after one (`wrap(secret_key=<secret>)`). `:` is here
      # for the serialized-log leaf a tool returns as JSON: in a
      # `{"log":"KEY=<value>"}` shape the only thing between the structure and
      # the key is `:`, so without it the whole class went unmatched (#178).
      # It must sit away from `[` in the class — `[:` opens a POSIX character
      # class and makes the whole regex invalid. The value gate
      # below stops treating a whole call expression as a single literal, so a
      # nested assignment has to be reachable on its own to stay masked.
      #
      # `\r` is a delimiter for the same reason it is edge whitespace on the
      # value side: a carriage return separates fields on screen but is not
      # part of either. Without it a CR before the key hid the assignment
      # completely — a curl or pip progress meter, a spinner, or classic-Mac
      # line endings all put one there, and `<meter>\rAPI_KEY=<secret>` leaked
      # in full and did not block at the prompt guard.
      equals_assignment = "(^|[ \t\r,:{;([])[\"'\''`]?" key "[\"'\''`]?[ \t]*="
      # A colon is ambiguous in prose. Accept it at the start of a YAML field,
      # after a JSON/map/argument delimiter, or after plain whitespace (log lines
      # such as `10:00:00 password: hunter2`); the loop below rejects the
      # whitespace form only when the preceding token is a known status word,
      # which marks a prose chain like `error: password: authentication is
      # disabled`.
      colon_assignment = "(^[ \t\r]*|[,{([][ \t\r]*|[ \t\r]+)[\"'\''`]?" key "[\"'\''`]?[ \t]*:"
      # Skipping after ANY colon-terminated token also let real structured log
      # lines through unmasked (`response: api_key: <secret>`), so only these
      # status words justify the skip. Deliberately short: an unlisted label
      # falls through to masking, and a false-positive mask of prose is far
      # cheaper than a displayed secret. Require the status word to stand alone
      # at line start or after whitespace; punctuation-bound suffixes such as
      # `response.error:` / `response/error:` are structured labels and must
      # not suppress masking. Matched against the lowercased line, so `Error:` /
      # `ERROR:` are covered too, including after a timestamp/log prefix.
      status_label = "(^|[ \t\r])(error|warning|info|note|debug|fatal|hint)[ \t]*:$"
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
      pw_n = split("your my the a an api access auth bearer client app user id key keys pass password secret secrets token tokens value personal private refresh session here", pw_words, " ")
      for (pw_i = 1; pw_i <= pw_n; pw_i++) placeholder_word[pw_words[pw_i]] = 1
      type_n = split("string number boolean bigint symbol unknown any never void object buffer uint8array str int float bool bytes bytearray", type_words, " ")
      for (type_i = 1; type_i <= type_n; type_i++) type_word[type_words[type_i]] = 1
      root_n = split("this self opts options config cfg conf settings props params args ctx context env input data req request state app user process", root_words, " ")
      for (root_i = 1; root_i <= root_n; root_i++) root_word[root_words[root_i]] = 1
      # Subcommand words a credential-retrieval command takes inside `$(...)`.
      # Closed on purpose: any other bare argument may be the literal value.
      sub_n = split("token create get read show print generate new login auth value secret key decrypt export", sub_words, " ")
      for (sub_i = 1; sub_i <= sub_n; sub_i++) subcommand_word[sub_words[sub_i]] = 1
      # Modal and subordinator words that open a prose sentence about a value
      # (`client secret: must be rotated monthly`). Closed on purpose and
      # checked against passphrase wordlists: none is in the EFF large or
      # short lists, and none is a common config value. Words of three letters
      # or fewer, and `cannot`, already pass on their own.
      lead_n = split("must should shall will would might needs when", lead_words, " ")
      for (lead_i = 1; lead_i <= lead_n; lead_i++) prose_lead_word[lead_words[lead_i]] = 1
      # Credential words a key and an identifier can share, compared after
      # case and separators come off (`api_key`, `apiKey` -> `apikey`).
      # The closed list of words an identifier may add to the name of its
      # field (`hashedPassword`, `CredentialSchema`, `Promise<Token>`). Any
      # other word keeps masking, so no run of random letters can pass.
      ident_n = split("schema schemas input inputs output type types value values hash hashed hasher id ids name names strength length field fields ref refs provider providers service manager mgr config cfg options opts props params args state store storage data info dto model entity request req response res payload body encrypted decrypted plain raw new old current next prev previous last first user client server refresh auth http https db database default test mock fake dummy stub expected actual valid invalid is has get set with from to for of by env var file path url uri header headers cookie basic oauth jwt csrf validator validation verify verified generator generated create created update updated reset change confirm confirmation repeat check checker encoder policy rule rules error exception handler helper util utils factory builder context ctx form column attr attribute property prop element component view controller repository repo record row table index count size max min limit expiry expires expiration expired ttl at time date timestamp salt digest cipher algorithm encoded decoded string str text bytes buffer object obj map list array enum class interface struct optional nullable required masked redacted hidden label placeholder hint message msg title description promise async null undefined none nil this self override overrides source target temp tmp local remote global shared base parent child app application system internal external primary secondary ssh tls ssl rsa aws gcp sdk smtp imap ldap sso mfa otp totp proxy xml json html grpc rest api", ident_list, " ")
      for (ident_i = 1; ident_i <= ident_n; ident_i++) ident_word[ident_list[ident_i]] = 1
      # What may stand alone after an operator: a keyword or a builtin type.
      operand_n = split("null undefined none nil true false string str number int integer float bool boolean any unknown never void object optional", operand_list, " ")
      for (ident_i = 1; ident_i <= operand_n; ident_i++) operand_word[operand_list[ident_i]] = 1
      name_stem_n = split("password passwd passphrase secret token credential apikey accesskey privatekey signingkey encryptionkey sessionkey bearer webhook", name_stem, " ")
    }
    function quoted_end(raw, quote, i, slash_count, ch) {
      slash_count = 0
      for (i = 1; i <= length(raw); i++) {
        ch = substr(raw, i, 1)
        if (ch == "\\") {
          slash_count++
          continue
        }
        if (ch == quote && slash_count % 2 == 0) return i
        slash_count = 0
      }
      return 0
    }
    function json_escape(value, i, ch, replacement) {
      gsub(/\\/, "\\\\", value)
      gsub(/"/, "\\\"", value)
      for (i = 1; i < 32; i++) {
        ch = sprintf("%c", i)
        replacement = sprintf("\\u%04x", i)
        gsub(ch, replacement, value)
      }
      return value
    }
    function emit_framed(value, tag, i, ch) {
      printf "%s", tag
      for (i = 1; i <= length(value); i++) {
        ch = substr(value, i, 1)
        if (ch == escape) printf "%s%s", escape, escape
        else if (ch == boundary) printf "%s%s", escape, boundary
        else printf "%s", ch
      }
      printf "%s", boundary
    }
    function already_redacted(value, marker, tail, i, ch) {
      marker = "[REDACTED]"
      if (substr(value, 1, length(marker)) != marker) return 0
      tail = substr(value, length(marker) + 1)
      for (i = 1; i <= length(tail); i++) {
        ch = substr(tail, i, 1)
        if (ch != "}" && ch != "]" && ch != ")") return 0
      }
      return 1
    }
    # scan_line deliberately re-scans inside a quoted value after emit_secret
    # records that wider literal. A short inner assignment can then produce a
    # contextual mapping whose value span is the SAME occurrence already
    # covered by the outer secret. Applying it first strands the inner key
    # prefix. Suppress only that scanner occurrence; an identical short value
    # elsewhere still needs its own contextual mapping and must remain emitted.
    function emit_mapping(literal, replacement, value_start, value_length) {
      if (record_mode == "probe" || record_mode == "probe_raw") {
        if (!probe_found) print "x"
        probe_found = 1
      } else if (rescan_cover_end > 0 \
                 && value_start >= rescan_cover_start \
                 && value_start + value_length - 1 <= rescan_cover_end) {
        return
      } else if (record_mode == "framed") {
        emit_framed(literal, "L")
        emit_framed(replacement, "R")
      } else {
        print "{\"literal\":\"" json_escape(literal) \
          "\",\"replacement\":\"" json_escape(replacement) \
          "\",\"contextual\":true}"
      }
    }
    # A multiline capture keeps the newline that separated the label from the
    # value, so the global literal is `<newline><secret>` and a BARE recurrence
    # of the credential later in the output does not match it. Emit the trimmed
    # token as a second record so global masking still reaches those.
    # A guarded capture that fails the shape test must not be DISCARDED: it has
    # absorbed every following line of the leaf, and throwing that away drops
    # the assignments inside it. A status label whose value opens a quote that
    # never closes — an apostrophe in ordinary prose is enough — made every real
    # assignment on the lines below it stop masking, and stopped the prompt
    # guard blocking the same text. An earlier fix reached those lines because
    # the status label took an unconditional skip; the deferral has to reach
    # them too, so re-scan what was absorbed as ordinary input.
    #
    # guard_rescan makes that single-pass: during a re-scan the status path
    # falls back to the old skip instead of opening another capture, so this
    # cannot nest or loop.
    function guard_rescan_leaf(v) {
      open_quote = ""
      open_value = ""
      open_guard = 0
      if (guard_rescan) return
      guard_rescan = 1
      # The capture began after an opening quote, so its first line does not
      # start a physical line (see key_line_start in scan_line).
      rescan_head = 1
      scan_leaf(v)
      rescan_head = 0
      guard_rescan = 0
    }
    # `\r` counts as edge whitespace: scan_leaf splits on `\n` and keeps the
    # preceding `\r`, so CRLF output left a carriage return glued to the value.
    # The capture then recorded `\r\n<secret>` as its literal and a bare
    # recurrence of the credential further down matched nothing.
    function edge_trim(v) {
      sub(/^[ \t\r\n]+/, "", v)
      sub(/[ \t\r\n]+$/, "", v)
      return v
    }
    # The benign checks below judge a value by its core: prose wraps a value
    # in backticks or quotes, follows it with a comma, or glues on a Korean
    # particle (`<token>`,`, `enabled가`). Only those come off, so a real
    # suffix (`true비밀`, `disabled.`, `dummy_password!`) still masks. Only the
    # judgement uses the core; an emitted literal keeps the full token.
    function prose_core(value, v) {
      v = tolower(edge_trim(value))
      sub(/[`'\''",]+$/, "", v)
      sub(/(가|이|은|는|을|를|의|도|에|에서|로|으로|와|과|만)$/, "", v)
      return v
    }
    # Keep the assignment heuristic aligned with the narrow, human-readable
    # documentation placeholders in gitleaks.toml. Match the complete core
    # only: decorated values and secrets that merely contain one of these
    # words must retain independent protection from the heuristic.
    function obvious_word_placeholder(value, v) {
      v = prose_core(value)
      return v ~ /^(example|dummy)[_-]?(token|key|secret|password)$/ \
          || v ~ /^not[-_ ]?a[-_ ]?real[-_ ]?(token|key|secret|password)$/ \
          || v ~ /^redacted$/ \
          || your_here_placeholder(v) \
          || angle_placeholder(v)
    }
    # A sample config writes `your-client-secret-here` or `your_api_key_here`
    # for a value to fill in. Every word between `your` and `here` must be a
    # known placeholder word, as in angle_placeholder, so a real value inside
    # the frame (`your-<value>-here`) or an unlisted word still masks.
    function your_here_placeholder(v, n, i, words) {
      if (v !~ /^your([-_][a-z]+)+[-_]here$/) return 0
      n = split(v, words, /[-_]/)
      for (i = 2; i < n; i++)
        if (!(words[i] in placeholder_word)) return 0
      return 1
    }
    # Heuristic only, gitleaks has no rule that matches it: `<token>` and
    # `<your-api-key>` stand for a value in prose. Every word must be a known
    # placeholder word, so an arbitrary word or passphrase in angle brackets
    # (`<correct-horse-battery>`) still masks.
    # A name before a placeholder noun (`<acme-pat>`) is still a placeholder:
    # the last word says it stands for a value. A phrase that ends in any other
    # word stays caught.
    function angle_placeholder(v, n, words) {
      if (v !~ /^<[a-z][a-z_ .-]*>$/) return 0
      n = split(substr(v, 2, length(v) - 2), words, /[-_ .]+/)
      if (n > 1 && words[n] ~ /^(pat|token|key|secret|password)$/) return 1
      return angle_placeholder_words(v)
    }
    # The stricter half of angle_placeholder: every word is a known
    # placeholder word. An unquoted `<your key>` is judged by this alone (see
    # emit_value), so a spaced phrase that merely ends in a placeholder noun
    # (`<correct horse key>`) is not exempted on the strength of that noun.
    function angle_placeholder_words(v, n, i, words) {
      if (v !~ /^<[a-z][a-z_ .-]*>$/) return 0
      n = split(substr(v, 2, length(v) - 2), words, /[-_ .]+/)
      for (i = 1; i <= n; i++)
        if (!(words[i] in placeholder_word)) return 0
      return n > 0
    }
    # A markdown label such as `**Repo secret**: **cannot verify**` has a
    # secret-bearing key and a status word for a value. Whole core only, after
    # the emphasis marks come off, so `cannot123` still masks.
    function prose_status_word(value, v) {
      v = prose_core(value)
      sub(/^[*_]+/, "", v)
      sub(/[*_]+$/, "", v)
      return v ~ /^(cannot|unknown|missing|present|deleted|required|optional|n\/a)$/
    }
    # A boolean or null under a secret-bearing key (`api_token: true`) is a
    # config flag, not a credential. Emitting it made the word a global
    # literal, so every `true`/`false` in the same response was masked, and
    # the prompt guard blocked a prompt that only described such a config.
    # Whole core only, so `trueX1...` still masks.
    function config_literal(value) {
      return prose_core(value) ~ /^(true|false|yes|no|on|off|null|nil|none|undefined|enabled|disabled)$/
    }
    # A field or parameter annotated with a bare type word (the TypeScript and
    # Python forms) names a type, not a value. Only a colon label and a bare
    # type word qualify; a type with brackets or a call is already a reference
    # above. A YAML scalar is the same words with nothing after them, so the
    # word must be followed by code: a semicolon, a comma, the closing paren of
    # a parameter list, or a union or default after a space. A bare word at the
    # end of the line stays masked.
    function type_annotation(assignment, value, token, term, tail) {
      if (assignment !~ /:$/ || !(tolower(value) in type_word)) return 0
      if (term == ";" || term == ",") return 1
      if (substr(token, length(value) + 1, 1) == ")") return 1
      if (term == " ") {
        sub(/^[ \t]+/, "", tail)
        return substr(tail, 1, 1) ~ /[|=]/
      }
      return 0
    }
    # An object member whose value reads another object (a key, a colon, then
    # `config.` and a field name, then a comma) has the shape
    # looks_like_reference accepts after `=`: a lowercase head, a
    # dotted chain, an uppercase letter and no digits. The trailing comma is
    # what separates it from a YAML scalar; `term` is the character after the
    # token.
    #
    # A logical or nullish operator after a space (`??`, `||`, `&&`) is code
    # as well: a YAML or env scalar never continues with one. That form also
    # accepts an all-lowercase chain (`config.token`), because the operator,
    # not the case, is what shows source code there; the root head and the
    # segment rules below still apply. `process.env.` followed by an
    # environment-variable name reads a variable wherever the line ends, so it
    # needs no terminator at all.
    function member_reference(assignment, value, term, tail, \
                              seg_n, seg, seg_i, code_tail) {
      if (assignment !~ /:$/) return 0
      sub(/^[ \t]+/, "", tail)
      code_tail = (term == " " && tail ~ /^(\?\?|\|\||&&)/)
      if (term != "," && !code_tail \
          && value !~ /^process\.env\.[A-Z][A-Z_]*$/) return 0
      if (value !~ /^[a-z_$]+(\.[A-Za-z_$]+)+$/) return 0
      if (!code_tail) {
        if (value !~ /[A-Z]/) return 0
        # Two parts (`abc.Def`) look like a word pair, so only a camelCase
        # leaf (`cfg.secretId`) or an environment-variable name
        # (`env.API_KEY`) counts as a member read here.
        if (value !~ /\..*\./ && value !~ /\.[a-z_$][A-Za-z_$]*[A-Z]/ \
            && value !~ /\.[A-Z][A-Z_]+$/) return 0
      }
      # Letters, dots and a comma alone do not show source code: a passphrase of
      # words has that shape. The head must also be an object name that source
      # code commonly reads from, a closed list.
      if (!(substr(value, 1, index(value, ".") - 1) in root_word)) return 0
      # An underscore or dollar sign is a member name only in the shape of an
      # environment variable (capitals and underscores); a mixed-case segment
      # with one reads as a made-up secret, so it stays masked.
      seg_n = split(value, seg, ".")
      for (seg_i = 1; seg_i <= seg_n; seg_i++)
        if (seg[seg_i] ~ /[_$]/ && seg[seg_i] !~ /^[A-Z][A-Z_]*$/) return 0
      return accessor_chain(value)
    }
    # A code keyword that starts an expression (`await` or `new` before a
    # call, `typeof` before an operand) is the first word of source code, not
    # a value: the token cut at the space left only the keyword. The call or
    # operand after it must be there, so the bare word alone still masks.
    function keyword_expression(assignment, value, tail) {
      if (assignment !~ /([ \t]=|:)$/) return 0
      if (value == "await" || value == "new" || value == "yield")
        return tail ~ /^[ \t]+[A-Za-z_$][A-Za-z0-9_$.]*\(/
      if (value == "typeof")
        return tail ~ /^[ \t]+[A-Za-z_$][A-Za-z0-9_$.]*([ \t;,)]|$)/
      return 0
    }
    # A command substitution is a reference only when nothing inside it can be
    # a literal credential. One simple command, no quotes, expansions,
    # operators or redirections. The command is a plain name or path and not
    # one that prints its arguments (echo, printf, print); a bare command name
    # is a program that runs, not text that is the value. Every argument is an
    # option, a path with a slash, or a word from the closed subcommand list in
    # BEGIN (`token create`, `secret get`, ...), and no word is credential
    # shaped. An option that names a credential (`-p`, or a long option with
    # pass, token, secret, key, auth or cred in it) takes the next word as its
    # value, so any word after one keeps masking. Anything else, such as a
    # literal handed to echo or printf, or an unlisted word, keeps masking.
    function command_substitution_reference(value, inner, n, words, i, w, \
                                            value_option) {
      if (value !~ /^\$\([^()"'\''`$|;&<>\\]*\)$/) return 0
      inner = substr(value, 3, length(value) - 3)
      n = split(inner, words, /[ \t]+/)
      i = 1
      if (words[1] == "") i = 2
      if (i > n || words[i] !~ /^[A-Za-z0-9_.\/-]+$/) return 0
      w = words[i]
      sub(/^.*\//, "", w)
      if (w == "echo" || w == "printf" || w == "print" || w == "") return 0
      if (credential_shaped(w)) return 0
      value_option = 0
      for (i++; i <= n; i++) {
        w = words[i]
        if (w == "") continue
        if (credential_shaped(w)) return 0
        if (w ~ /^--?[a-z][a-z0-9-]*$/) {
          value_option = (w == "-p" \
            || (w ~ /^--/ && w ~ /(pass|token|secret|key|auth|cred)/))
          continue
        }
        if (value_option) return 0
        if (w ~ /\// && w ~ /^[A-Za-z0-9_.\/-]+$/) continue
        if (w in subcommand_word) continue
        return 0
      }
      return 1
    }
    # A quoted value made of nothing but one expansion or template reference
    # holds no credential text: a shell variable (in braces, or bare with an
    # environment-variable name), a command substitution that passes the test
    # above, a GitHub Actions expression that reads a secret, variable
    # or input, or a Go/Helm template that reads a value (`.Values.x`) with
    # optional pipe functions. The unquoted branch already treats these as
    # references through their opener; inside quotes that test does not run.
    # Any literal text next to the reference, a quote inside a template, or a
    # lowercase or digit-bearing bare dollar word keeps masking.
    function interpolated_reference(value) {
      return value ~ /^\$\{[A-Za-z_][A-Za-z0-9_]*\}$/ \
          || value ~ /^\$[A-Z]+(_[A-Z]+)*$/ \
          || command_substitution_reference(value) \
          || value ~ /^\$\{\{[ \t]*(secrets|vars|env|inputs)\.[A-Za-z_][A-Za-z0-9_]*[ \t]*\}\}$/ \
          || value ~ /^\{\{-?[ \t]*\.[A-Za-z_][A-Za-z0-9_.]*([ \t]*\|[ \t]*[A-Za-z_][A-Za-z0-9_]*)*[ \t]*-?\}\}$/
    }
    # Helm charts name an existing Kubernetes Secret, and the data key inside
    # it, under `existingSecret` style keys. Those values are object names,
    # never the credential. Exempt only the reference names in that camelCase
    # family (the bare key, a Name suffix, or a suffix ending in Key or Ref;
    # a Password or Token suffix may hold the value itself) in a colon
    # field and a lowercase DNS-style name that is not credential shaped, so
    # a random or digit-mixed value under the same key still masks.
    function secret_object_name(assignment, value) {
      if (assignment !~ /(^|[^A-Za-z0-9_.-])["'\''`]?existingSecret(Name|([A-Z][A-Za-z]*)?(Key|Ref))?["'\''`]?[ \t]*:$/) return 0
      if (length(value) > 253 || value !~ /^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$/) return 0
      return !credential_shaped(value)
    }
    # A value another tool already masked (`gh auth status` prints
    # `ghu_****`) carries no credential. Only the exact shapes below: a known
    # vendor prefix followed by nothing but mask characters, `<redacted>`, or a
    # bare run of mask characters. A real token keeps at least one non-mask
    # character after its prefix, so `ghu_****real` still masks. The bullet is
    # matched as bytes because awk runs under LC_ALL=C.
    function masked_placeholder(value, v, mask, star) {
      v = prose_core(value)
      star = "(\\*|\342\200\242)"
      mask = "(\\*|x|\342\200\242)"
      return v ~ /^<redacted>$/ \
          || v ~ ("^" star star star "+$") \
          || v ~ ("^(gh[pousr]_|github_pat_|glpat-|xox[abposr]-|sk-|npm_|akia|asia)" mask mask mask "+$")
    }
    # The short-value floor is about characters, but awk runs under LC_ALL=C
    # and length() counts bytes: a two-character word in a multibyte script
    # (six UTF-8 bytes) cleared the floor and became a global literal that
    # masked the same word across a whole document. Skip continuation bytes.
    function char_length(s, c) {
      c = s
      return length(s) - gsub(/[\200-\277]/, "", c)
    }
    function emit_captured(v, trimmed) {
      emit_secret(v)
      trimmed = edge_trim(v)
      if (trimmed != v) emit_secret(trimmed)
    }
    # Returns 1 when the value was recorded, so a caller can add a wider
    # extent of the same occurrence only when the value itself qualified.
    function emit_secret(value, eligible_length) {
      if (already_redacted(value)) return 0
      if (obvious_word_placeholder(value)) return 0
      if (config_literal(value)) return 0
      if (prose_status_word(value)) return 0
      if (masked_placeholder(value)) return 0
      if (eligible_length == 0) eligible_length = char_length(value)
      if (eligible_length < 4 || length(value) == 0) return 0
      emit_record(value)
      return 1
    }
    function emit_record(value) {
      if (record_mode == "probe" || record_mode == "probe_raw") {
        if (!probe_found) print "x"
        probe_found = 1
        return
      }
      if (record_mode == "framed") emit_framed(value, "S")
      else print "\"" json_escape(value) "\""
    }
    # A wider extent of an occurrence whose own value was already recorded
    # (`[hidden]` after `[hidden`). Literals apply longest first, so a new
    # longer literal could consume the start of another secret that overlaps
    # it and leave the tail of that secret visible where it used to be masked.
    # An extent therefore never goes out as an ordinary literal here. JSON
    # records carry a flag, and bundle settlement (JQ_SETTLE_EXTENTS) keeps
    # the extent only when no literal from any detector can overlap it.
    # Framed records feed the exec raw path, which applies the bundle literals
    # afterwards where no settlement can see them, so they carry no extent and
    # mask exactly as before.
    function emit_extent(value) {
      if (record_mode != "json") return
      print "{\"literal\":\"" json_escape(value) \
        "\",\"replacement\":\"[REDACTED]\",\"agent_guard_extent\":true}"
    }
    # A credential-shaped KEY only tells us the assignment is interesting; it
    # says nothing about whether the right-hand side IS a credential. Source that
    # merely READS one (`process.env.API_KEY`, `os.environ["DB_PASSWORD"]`,
    # `config.apiKey`, `${API_KEY:?required}`) is a reference, so masking it
    # hides nothing and destroys ordinary code. Decide from the token SHAPE, not
    # from a list of known accessor spellings: an unfamiliar accessor is still
    # rejected, and an unfamiliar credential format is still masked.
    #
    # Only applies to the bare/unquoted branch. A quoted value is already a
    # literal, and trailing closers are stripped before this test so a value
    # such as `abc)evil` is still treated as a value.
    #
    # Tradeoff: an unquoted credential that itself contains an opener or an
    # embedded quote is no longer masked by this heuristic. gitleaks still
    # covers every format it knows, and the block/detect path is unaffected.
    # Where the uppercase sits separates an accessor from a passphrase that
    # happens to be dot-separated. An accessor reads a value OUT of lowercase
    # roots (`process.env`, `config`, `cfg`), so only its LEAF carries case; a
    # passphrase capitalizes whole words anywhere in the chain. Past two
    # segments a real chain ends in a constant or property — SCREAMING_SNAKE,
    # camelCase, or underscore-bearing — never a plain Capitalized word, which
    # is what separates `my.secret.Phrase` from `process.env.API_KEY`.
    #
    # Residual: a two-segment `head.Word` (`my.Secret`) is the same shape as the
    # Go/C# exported-field access it mimics (`cfg.Token`), so it still reads as
    # a reference. Narrowing that too would re-break the source code #169 is
    # about; gitleaks still covers every format it knows either way.
    function accessor_chain(v, parts, n, i, leaf) {
      n = split(v, parts, ".")
      for (i = 1; i < n; i++)
        if (parts[i] ~ /[A-Z]/) return 0
      leaf = parts[n]
      if (n > 2 && leaf !~ /_/ && leaf !~ /^[A-Z$]+$/ \
          && leaf !~ /^[a-z_$][A-Za-z_$]*[A-Z]/)
        return 0
      return 1
    }
    function looks_like_reference(value, assignment, leading, v, ch) {
      # An opener or an embedded quote: call, index, expansion or nested string.
      # An opener only counts past the first character, because a call, an index
      # and an expansion always follow the thing they apply to; a token that
      # BEGINS with a bracket (`[REDACTED]]evil`) is not a reference, so it stays
      # maskable. `$` alone is deliberately allowed so bcrypt-style `$2b$12$...`
      # values stay masked; `${...}` is caught by the brace.
      if (index(value, "(") > 1 || index(value, "[") > 1 \
          || index(value, "{") > 1 || index(value, "\"") \
          || index(value, "'\''") || index(value, "`"))
        return 1
      # A trailing `:` (a def/lambda suite ending the line) blocked the outer
      # closer strip, so `DEFAULT_PASSWORD):` still carries its closers here.
      # Normalize a local copy for classification only; masking, when it does
      # happen, still replaces the original extent.
      v = value
      sub(/:+$/, "", v)
      while (length(v) > 0) {
        ch = substr(v, length(v), 1)
        if (ch != "}" && ch != "]" && ch != ")") break
        v = substr(v, 1, length(v) - 1)
      }
      # Inside an argument or subscript list (`make(api_key=DEFAULT_API_KEY)`,
      # `def connect(password=None):`) a bare digit-free identifier or
      # identifier chain is a default or reference, not a literal. A digit
      # pushes the token back toward masking: real identifiers named as
      # defaults rarely carry digits, credential fragments usually do.
      ch = substr(assignment, 1, 1)
      if ((ch == "(" || ch == "[") && v ~ /^[A-Za-z_$]+(\.[A-Za-z_$]+)*$/)
        return 1
      # Dotted identifier chain (`process.env.API_KEY`, `config.apiKey`), and
      # only in a code-shaped assignment: whitespace on both sides of `=`, a
      # lowercase head segment (accessor roots are lowercase in the languages
      # this bug mangled), no digit in any segment, and at least one uppercase
      # character somewhere in the chain. Anything short of all four masks, so
      # dot-separated passphrases (`correct.horse.battery.staple`), dotted
      # env/YAML/INI values (`PASSWORD=a.b.c`, `password: a.b.c`) and dotted
      # version- or token-shaped values (`v1.0.x`) keep masking. Those four
      # still admit a capitalized passphrase (`my.Secret.phrase`), so where the
      # uppercase SITS has to decide as well; see accessor_chain.
      if (!(assignment ~ /[ \t]=$/ && leading != "" && v ~ /[A-Z]/ \
            && v ~ /^[a-z_$]+(\.[A-Za-z_$]+)+$/))
        return 0
      return accessor_chain(v)
    }
    # An unquoted shell variable with an environment-variable name
    # (`GITHUB_TOKEN=$GITHUB_TOKEN`) reads a value, as the same word in double
    # quotes does in interpolated_reference. The same shape only: a digit, a
    # lowercase letter, a second `$` (bcrypt `$2b$12$...`) or any text glued
    # to the name keeps masking.
    function bare_variable_reference(value) {
      return value ~ /^\$[A-Z]+(_[A-Z]+)*$/
    }
    # A key ending in `token` also names opaque version handles: an MCP page
    # read returns `"snapshotToken": "v:10"` for optimistic concurrency, and
    # masking it makes every update past version 9 fail as stale (#303). Only
    # that exact shape under a token key is exempt; any other value, and the
    # same value under password, secret or api_key keys, still masks. The
    # length cap keeps a long digit run, which can be a numeric credential,
    # masked.
    function version_reference(assignment, value) {
      if (value !~ /^v:[0-9]+$/ || length(value) > 11) return 0
      return tolower(assignment) ~ /token["'\''`]?[ \t]*[:=]$/
    }
    # A pagination cursor key (`nextPageToken`, `next_page_token`) carries an
    # opaque value the client has to send back verbatim, so masking it broke
    # every search result past the first page. Only the exact camel/snake
    # cursor names in a JSON/YAML `:` field are exempt, matched with case and
    # a key boundary: `PAGE_TOKEN=` and `FB_PAGE_TOKEN` name a real page
    # access token, and `homepage_token` or `next_page_token_id` are other keys.
    function page_cursor(assignment) {
      return assignment ~ /(^|[^A-Za-z0-9_.-])["'\''`]?((next|prev|previous)(PageToken|_page_token)|pageToken|page_token)["'\''`]?[ \t]*:$/
    }
    # A prose line names a camel- or PascalCase setter or field ending in Secret, then
    # a colon, the issue-tracker id it tracks, and more prose
    # (`setClientSecret: ABC-123 의 조건`). Exempt only that whole shape. The
    # key is camelCase (a lowercase letter or digit right before `Secret`), so
    # `secret:`, `api_secret:` and `CLIENT_SECRET:` and every password, token
    # or key field still mask. The id is an uppercase team key of up to ten
    # characters (Linear keys may start with a digit) and a number of up to six
    # digits with no leading zero, after a Korean particle (or, inside
    # backticks, a trailing comma) comes off. A word must follow on the same
    # line, starting with a letter or a non-ASCII byte: that separates prose
    # from a YAML scalar, a flow mapping (`, next:`), and a `#`, `//` or `;`
    # comment. Unquoted or in markdown backticks only; the `=` form, a JSON
    # string, lowercase or mixed-case words, and longer digit runs still mask.
    function issue_reference(assignment, value, tail, v, dash) {
      if (assignment !~ /[a-z0-9]Secret`?[ \t]*:$/) return 0
      sub(/^[ \t]+/, "", tail)
      # A Latin letter, or a UTF-8 lead byte of the Hangul syllable block. Any
      # other non-ASCII lead (a dash, a fullwidth sign, NBSP) is not a word.
      if (tail !~ /^[A-Za-z\352-\355]/) return 0
      v = value
      sub(/[`,]+$/, "", v)
      sub(/(가|이|은|는|을|를|의|도|에|에서|로|으로|와|과|만)$/, "", v)
      if (v !~ /^[A-Z0-9]*[A-Z][A-Z0-9]*-[1-9][0-9]*$/) return 0
      dash = index(v, "-")
      return dash <= 11 && length(v) - dash <= 6
    }
    # A prose line can describe a secret by the endpoint that sets it
    # (`client secret: `PUT /v1/providers/:id/client-secret``). An HTTP method
    # and a path, or a path of two or more segments, names a route, not a
    # value. Colon form only, unquoted or in backticks, like issue_reference.
    # Every segment is judged on its own, so a credential-shaped segment, or a
    # long digit run that can be a numeric secret, still masks the whole value.
    function route_reference(assignment, value, v, minimum, n, segs, i, s, count) {
      if (assignment !~ /:$/) return 0
      v = value
      minimum = 2
      if (v ~ /^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS) \//) {
        v = substr(v, index(v, " ") + 1)
        minimum = 1
      }
      if (v !~ /^(\/[A-Za-z0-9._~:{}-]+)+\/?$/) return 0
      n = split(substr(v, 2), segs, "/")
      count = 0
      for (i = 1; i <= n; i++) {
        s = segs[i]
        if (s == "") continue
        count++
        sub(/^:/, "", s)
        if (s ~ /^\{[^{}]+\}$/) s = substr(s, 2, length(s) - 2)
        if (credential_shaped(s) || s ~ /[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/)
          return 0
      }
      return count >= minimum
    }
    # A prose line can say what happens to a secret instead of giving it
    # (`client secret: must be rotated monthly`). Colon form only, unquoted
    # only: the token is a word from the closed prose_lead_word list, and the
    # rest of the line is that word and at least two more lowercase ASCII words,
    # one space apart, with at most one final `.` before trailing whitespace.
    # A quoted key, a backticked or quoted value, a tab or a double space, a
    # digit, an uppercase letter or any other symbol anywhere in the tail keeps
    # masking. Each following word is judged on its own, like a route segment,
    # so a credential-shaped word masks the whole value.
    function prose_reference(assignment, value, raw, v, n, words, i) {
      if (assignment !~ /:$/ || assignment ~ /["'\'']/) return 0
      if (!(value in prose_lead_word)) return 0
      v = raw
      sub(/[ \t\r]+$/, "", v)
      sub(/\.$/, "", v)
      if (v !~ /^[a-z]+ [a-z]+ [a-z]+( [a-z]+)*$/) return 0
      n = split(v, words, " ")
      for (i = 2; i <= n; i++)
        if (credential_shaped(words[i])) return 0
      return 1
    }
    # A draft read from a document tool returns a `d<n>:`-prefixed base64 snapshot
    # token for optimistic locking; the next update must echo it verbatim, so
    # masking it made every draft update fail. Exempt only that value shape
    # under the exact snapshot-token key in a JSON/YAML `:` field. The same
    # value under other keys, the env form, or any other shape still masks.
    function snapshot_handle(assignment, value) {
      if (value !~ /^d[0-9]+:[A-Za-z0-9+\/_-]+=*$/) return 0
      return assignment ~ /(^|[^A-Za-z0-9_.-])["'\''`]?(snapshotToken|snapshot_token)["'\''`]?[ \t]*:$/
    }
    # Value-side gate for the status-label colon path (#156). A status label on
    # its own cannot separate `error: password: authentication is disabled`
    # (prose, must not mask) from `error: password: hunter2-long-value`
    # (assignment, must mask): the label is identical in both, so the VALUE has
    # to decide. Mask only a token whose shape reads as a credential; an
    # ordinary word, path, number or timestamp stays visible, which is what
    # keeps the #145/#153 prose assertions green.
    #
    # Deliberately shape-based rather than a dictionary: an unfamiliar prose
    # word is still preserved and an unfamiliar credential format is still
    # masked. Residual: an all-lowercase alphabetic secret below the compound
    # threshold is indistinguishable from a prose word on this path and stays
    # visible. gitleaks still covers every format it knows regardless of the
    # label, and the block/detect path is unaffected either way.
    function credential_shaped(v) {
      if (length(v) < 6) return 0
      # A credential is a single token. The unquoted branch has already cut at
      # whitespace, so this only bites on a QUOTED value — where a multi-word
      # string behind a status label is a message, not a secret. Without it
      # `error: password: "must be at least 8 characters"` masks, because the
      # class tests below would find a letter and a digit somewhere in the
      # sentence and never ask whether they were part of the same token.
      if (v ~ /[ \t]/) return 0
      # Dates, timestamps and clock times are the ordinary log values that would
      # otherwise satisfy the mixed-class tests. Anchored at BOTH ends: a date
      # only tells us this value is a date when the value is nothing else, and a
      # prefix match let `2026-08-30-A1b2C3d4-token` through unmasked.
      if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
      if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][T][0-9][0-9]:[0-9][0-9](:[0-9][0-9])?([.][0-9]+)?(Z|[+-][0-9][0-9]:?[0-9][0-9])?$/) return 0
      if (v ~ /^[0-9]+:[0-9]+(:[0-9]+)?$/) return 0
      # Mixed character classes. The digit test requires the digit and the
      # letter to be ADJACENT: `hunter2-long-value` is a credential, `least 8
      # characters` and `expires in 3600 seconds` are prose that merely contain
      # both. An uppercase run must start past the first character, since a
      # leading capital alone is ordinary sentence case (`Authentication`).
      if (v ~ /[0-9][A-Za-z]/ || v ~ /[A-Za-z][0-9]/) return 1
      if (v ~ /[a-z]/ && substr(v, 2) ~ /[A-Z]/) return 1
      # A single-case alphabetic run longer than any ordinary word, joined by
      # `.`/`-`/`_` or not. Requiring a PURELY alphabetic value let a
      # delimiter-separated passphrase (`correct-horse-battery-staple`) through,
      # although it is far less prose-like than the bare-word residual below it.
      if (length(v) >= 24 && v ~ /^[A-Za-z]+([._-][A-Za-z]+)*$/) return 1
      return 0
    }
    # A credential-named field whose value is an identifier that repeats the
    # name of the field is source code naming the same thing again
    # (`credential: CredentialSchema,`, `credential: input.credential,`,
    # `credential=credential,`, `this.credential = credential;`), not a value.
    # Emitting it made the field name itself a global literal, so every
    # occurrence of the word in a diff was masked.
    # AGENT_GUARD_KEY_NAME_REDACT turns this exemption off.
    #
    # All of these must hold, so that a config literal keeps masking:
    # - The field starts its line (key_line_start, set by scan_line): only
    #   indentation, one diff marker and declaration keywords come before
    #   it, after an optional line locator as grep -n, cat -n and the like
    #   print one (`path:14:`).
    #   A key in the middle of a line is a log line, a table row, a flow
    #   mapping or a connection string, and keeps masking.
    # - Unquoted only, and the complete token is the value: a digit-free
    #   identifier or dotted chain of at most 80 bytes, with an optional
    #   leading `$` or one simple generic argument. A digit, a quote or any
    #   other symbol keeps masking. A dotted chain must start at an object
    #   name source code reads from (the closed root list member_reference
    #   uses), because letters and dots are also what a passphrase of words
    #   looks like.
    # - Code follows it and a `,` or `;` ends the line. After a colon field
    #   the value may first continue with union, logical, nullish or default
    #   operators, each followed by one digit-free identifier or chain
    #   (`Credential | null;`); any other text after the value keeps masking.
    #   A `self.`/`this.` member assigned with `=` may also end the line with
    #   nothing. A bare word at the end of any other line is what an env,
    #   YAML or INI file writes, and keeps masking.
    # - The value names the field. Names are compared after case, digits and
    #   separators come off. After `=` the last segment must be the field
    #   name (`api_key=self.api_key,`). After a colon a type or a schema is
    #   named after the field rather than equal to it, so it is enough that
    #   both share a credential word (`password: hashedPassword,`) when the
    #   value is also written as an identifier: a capital, an underscore or
    #   a dot past its first character. A plain word that is not the field
    #   name (`mypassword,`) keeps masking.
    # - Every word of the value, and of each operand after an operator, is a
    #   word of the field name or a word from a closed list (names_field).
    #   Letters that are not such words keep masking, so a random run cannot
    #   pass by carrying the key word (`SecretQzxvWplm`), and neither can a
    #   password built around it (`MyPassword`, `top_secret`).
    # Residual, accepted: at the start of a line and before a line-ending
    # `,` or `;`, a digit-free password that is its own key name in any
    # case (`PASSWORD=password;`), or one made only of the key word and
    # listed words (`password: userPassword,`), reads the same way, with or
    # without a leading `$`. So does such a password assigned to a
    # `self.`/`this.` key with nothing after it.
    #
    # ident_split: the lowercase words of an identifier in words[1..n].
    # Words end at a separator, where a capital follows a small letter and
    # where an acronym ends (`HTTPCredential` -> http credential).
    function ident_split(text, words,   i, ch, prev, out) {
      out = ""
      prev = ""
      for (i = 1; i <= length(text); i++) {
        ch = substr(text, i, 1)
        if (ch ~ /[A-Z]/ && (prev ~ /[a-z]/ \
            || (prev ~ /[A-Z]/ && substr(text, i + 1, 1) ~ /[a-z]/)))
          out = out " "
        out = out ch
        prev = ch
      }
      gsub(/[^A-Za-z]+/, " ", out)
      sub(/^ +/, "", out)
      sub(/ +$/, "", out)
      if (out == "") return 0
      return split(tolower(out), words, " ")
    }
    # 1 when every word of text is a word of the field name key (any word of
    # it, its plural or singular too) or a listed word, and, with need_named,
    # at least one is a word of the field name. Anything else, a random run
    # above all, is 0.
    # head without the key and delimiter it ends with: the cut that
    # sub(/["'\''`]?[A-Za-z0-9_.$-]+["'\''`]?[ \t]*[:=]$/, "", head) makes,
    # walked back from the end. That pattern is anchored only at its end, so
    # sub() tries it from every position of a run of name characters, which
    # is quadratic in the length of the run.
    function without_key_tail(head,   p, q, c) {
      p = length(head)
      c = substr(head, p, 1)
      if (c != ":" && c != "=") return head
      p--
      while (p > 0 && ((c = substr(head, p, 1)) == " " || c == "\t")) p--
      if (p > 0 && index("\"'\''`", substr(head, p, 1))) p--
      q = p
      while (p > 0 && substr(head, p, 1) ~ /^[A-Za-z0-9_.$-]$/) p--
      if (p == q) return head
      if (p > 0 && index("\"'\''`", substr(head, p, 1))) p--
      return substr(head, 1, p)
    }
    # Length of the line locator head starts with, or 0. It is the cut of
    # one pattern, ^((PATH:)?[0-9]+:|(PATH-)?[0-9]+-|[ \t]*[0-9]+\t), where
    # PATH is a run of path characters that does not start with `+` or `-`
    # and holds a letter. The forms are looked for one at a time, each in a
    # single pass: written as one pattern, mawk took quadratic time on a
    # long run of path characters, since `-` and digits are path characters
    # too and every split of the run had to be tried.
    function locator_length(head,   best, n, w, i, j) {
      best = 0
      if (match(head, /^[ \t]*[0-9]+\t/)) best = RLENGTH
      if (match(head, /^[0-9]+[:-]/) && RLENGTH > best) best = RLENGTH
      if (!match(head, /^[A-Za-z0-9_.\/@~][A-Za-z0-9_.\/@+~-]*/)) return best
      n = RLENGTH
      w = substr(head, 1, n)
      if (w !~ /[A-Za-z]/) return best
      # `path:14:`. A colon is not a path character, so the path is all of w.
      if (match(substr(head, n + 1), /^:[0-9]+:/) && n + RLENGTH > best)
        best = n + RLENGTH
      # `path-14-`. The last `-digits-` in w gives the longest cut; the path
      # is what precedes it, and a shorter path could not hold a letter that
      # the longest one lacks.
      for (i = n; i > 3; i--) {
        if (substr(w, i, 1) != "-") continue
        j = i - 1
        while (j > 0 && substr(w, j, 1) ~ /^[0-9]$/) j--
        if (j < i - 1 && j > 1 && substr(w, j, 1) == "-") {
          if (i > best && substr(w, 1, j - 1) ~ /[A-Za-z]/) best = i
          break
        }
        i = j + 1
      }
      return best
    }
    function names_field(text, key, need_named,   kw, kn, vw, vn, i, j, hit, named) {
      kn = ident_split(key, kw)
      vn = ident_split(text, vw)
      if (!kn || !vn) return 0
      named = 0
      for (i = 1; i <= vn; i++) {
        hit = 0
        for (j = 1; j <= kn; j++)
          if (vw[i] == kw[j] || vw[i] == kw[j] "s" || vw[i] "s" == kw[j]) hit = 1
        if (hit) named = 1
        else if (!(vw[i] in ident_word) && !(vw[i] in root_word)) return 0
      }
      return need_named ? named : 1
    }
    function self_named_reference(assignment, value, token, term, tail, \
                                  k, key, v, leaf, arg, i, n, operand) {
      if (!key_line_start) return 0
      sub(/\r$/, "", token)
      if (token != value || length(value) > 80) return 0
      if (value !~ /^\$?[A-Za-z_]+(\.[A-Za-z_]+)*(<[A-Za-z_.]+>)?$/) return 0
      key = assignment
      sub(/[ \t]*[:=]$/, "", key)
      gsub(/["'\''`]/, "", key)
      sub(/^.*[^A-Za-z0-9_-]/, "", key)
      if (term == "," || term == ";") {
        if (substr(tail, 2) !~ /^[ \t\r]*$/) return 0
      } else if (term == " " || term == "\t") {
        sub(/^[ \t]+/, "", tail)
        if (assignment !~ /:$/ \
            || tail !~ /^((\|\|?|\?\?|&&|=)[ \t]+[A-Za-z_$][A-Za-z_$.]*[ \t]*)+[,;][ \t\r]*$/)
          return 0
        # Each operand after an operator is a keyword or builtin type
        # (`| null;`, `= None,`) or names the field itself with known words
        # (`?? credentialOverride,`). A lone listed word does not qualify:
        # `password: Password ?? admin,` keeps masking.
        gsub(/[^A-Za-z_$.]+/, " ", tail)
        n = split(tail, operand, " ")
        for (i = 1; i <= n; i++)
          if (!(tolower(operand[i]) in operand_word) && !names_field(operand[i], key, 1)) return 0
      } else if (term != "" \
                 || assignment !~ /(^|[^A-Za-z0-9_.-])(self|this)\.[A-Za-z_]+[ \t]*=$/) {
        return 0
      }
      k = tolower(key)
      gsub(/[^a-z]/, "", k)
      v = value
      sub(/^\$/, "", v)
      arg = ""
      if (index(v, "<")) {
        arg = tolower(substr(v, index(v, "<") + 1))
        gsub(/[^a-z]/, "", arg)
        v = substr(v, 1, index(v, "<") - 1)
      }
      leaf = v
      sub(/^.*\./, "", leaf)
      leaf = tolower(leaf)
      gsub(/[^a-z]/, "", leaf)
      if (k == "" || leaf == "") return 0
      if (index(v, ".") && !(substr(v, 1, index(v, ".") - 1) in root_word))
        return 0
      # A generic argument belongs to a type, and a type name is capitalized.
      if (arg != "" && v !~ /^[A-Z]/) return 0
      if (leaf == k || arg == k) return names_field(value, key, 1)
      if (assignment !~ /:$/) return 0
      if (substr(v, 2) !~ /[A-Z_.]/) return 0
      v = tolower(v)
      gsub(/[^a-z]/, "", v)
      for (i = 1; i <= name_stem_n; i++)
        if (index(k, name_stem[i]) && index(v, name_stem[i])) return names_field(value, key, 1)
      return 0
    }
    function emit_value(source, start, assignment, require_credential, \
                        raw, leading, quote, end, \
                        value, token, trailing, ch, route, \
                        extent, wrap, lead, closer, rest) {
      next_rescan_cover_start = 0
      next_rescan_cover_end = 0
      raw = substr(source, start)
      match(raw, /^[ \t]*/)
      leading = substr(raw, 1, RLENGTH)
      sub(/^[ \t]+/, "", raw)
      quote = substr(raw, 1, 1)
      if (quote == "\"" || quote == "'\''" || quote == "`") {
        raw = substr(raw, 2)
        end = quoted_end(raw, quote)
        if (end == 0) {
          # Truncated or malformed output after an opening quote. Open the
          # multiline capture like every other path and DEFER the shape
          # decision to the close (or leaf end), carrying open_guard so the
          # status-label rule still applies there. Classifying the fragment
          # available on THIS line instead missed a value whose text begins on
          # the NEXT one — a status label, its key, an opening quote, then a
          # newline before the credential. There the fragment is empty, so it
          # failed the shape test, the capture never opened, and the
          # continuation line has no assignment key of its own to match.
          # Inside a re-scan the status path takes the pre-deferral skip, which
          # is what stops this from re-opening the capture it just failed.
          if (require_credential && guard_rescan) return 0
          open_quote = quote
          open_value = raw
          open_guard = require_credential
          return 1
        }
        value = substr(raw, 1, end - 1)
        # Classify an edge-trimmed copy, replace the original. A quoted value
        # with padding (`" <secret>"`) failed the whitespace-is-prose test on
        # its padding alone, on this single-line path as well as the multiline
        # one. Internal whitespace is untouched, so prose still reads as prose.
        if (require_credential && !credential_shaped(edge_trim(value))) return 0
        if (version_reference(assignment, value)) return 0
        if (quote == "`" && issue_reference(assignment, value, substr(raw, end + 1))) return 0
        if (quote == "`" && route_reference(assignment, value)) return 0
        if (page_cursor(assignment)) return 0
        if (snapshot_handle(assignment, value)) return 0
        if (interpolated_reference(value)) return 0
        if (secret_object_name(assignment, value)) return 0
      } else {
        value = raw
        sub(/[ \t,;].*$/, "", value)
        if (already_redacted(value)) return 0
        # An unquoted `<...>` with spaces inside (`<your key>`) is one value,
        # but the cut above keeps only its first word. That word never passed
        # the placeholder test, so a placeholder was half-masked
        # (`[REDACTED] key>`) and a real value showed every word after the
        # first (`<hunter2 Summer>`). Take the whole span only when it closes
        # before the token ends, and judge it with the all-placeholder-words
        # rule. Otherwise the first word still decides exactly as before, and
        # the span only widens what is masked. A tab separates the words as
        # well, but the placeholder test admits only spaces, so a tab-bearing
        # span is always masked whole.
        extent = ""
        if (substr(raw, 1, 1) == "<" \
            && match(raw, /^<[A-Za-z][A-Za-z0-9_ \t.-]*>/) \
            && substr(raw, 1, RLENGTH) ~ /[ \t]/) {
          ch = substr(raw, RLENGTH + 1, 1)
          if (ch == "" || ch == "'\''" || index(" \t\r,;\"`)]}", ch)) {
            extent = substr(raw, 1, RLENGTH)
            # Closers and quotes may follow a placeholder (`<your key>)`),
            # but text after them is a value glued to it
            # (`<your key>)q7tail`), which the first word decided before and
            # still does.
            rest = substr(raw, RLENGTH + 1)
            sub(/[ \t\r,;].*$/, "", rest)
            gsub(/[)}"`]/, "", rest)
            gsub(/\]/, "", rest)
            gsub(/'\''/, "", rest)
            if (rest == "" && angle_placeholder_words(tolower(extent))) return 0
          }
        }
        token = value
        end = length(value)
        strip_quote = 0
        while (end > 0) {
          # Re-test after every strip, because the strip can walk INTO the
          # redaction sentinel. `password=[REDACTED]"}` loses `}` and then the
          # quote, and the next closer taken is the `]` that belongs to the
          # marker itself. The pre-loop test passed (the tail held a quote),
          # and after that
          # `[REDACTED` no longer matches, so the fragment is re-emitted as a
          # secret and a stray `]` appended. That compounds on every pass
          # (`[REDACTED]]`, `[REDACTED]]]`) and makes the prompt guard BLOCK
          # text agent-guard itself redacted.
          if (already_redacted(substr(value, 1, end))) return 0
          ch = substr(value, end, 1)
          # `\r` is edge whitespace, not value: scan_leaf splits on `\n` and
          # keeps the preceding carriage return, so on CRLF output the token is
          # `…"}\r` and this loop stopped on the CR before it could reach the
          # quote or the closers — leaving the exact shape #178 is about
          # unmasked on Windows, PowerShell, Docker and CI logs. Stripping it
          # keeps the replacement extent at the value: the CR stays in the text.
          if (ch == "\r") { end--; continue }
          if (ch == "}" || ch == "]" || ch == ")") { end--; continue }
          # One trailing quote closes the string the assignment SITS INSIDE; it
          # is not part of the value. A tool returning a serialized log leaf
          # puts the JSON string terminator right after the credential, and
          # leaving it attached made the token carry a quote, which
          # looks_like_reference() reads as a nested string — so the whole class
          # went unmasked (#178). Exactly one, only at the very end, so an
          # interior quote still marks a reference and the accessor forms in
          # the #169 assertions stay preserved.
          #
          # A line-start quoted assignment needs the same strip. The re-scan of
          # an outer quoted value can then rediscover a narrower short token;
          # emit_mapping suppresses that record only when an already-emitted
          # secret literal covers its exact value span (#180).
          if (strip_quote == 0 \
              && (ch == "\"" || ch == "'\''" || ch == "`")) {
            strip_quote = 1
            end--
            continue
          }
          break
        }
        value = substr(value, 1, end)
        # The strip above also takes a closer whose opener STARTS the value, so
        # `[hidden]` was recorded as `[hidden` and left `[REDACTED]]`. Pair the
        # leading openers with the closers stripped right after the value,
        # innermost first. Only the masked extent grows: every check below
        # still judges the stripped value, as it did before.
        wrap = 0
        lead = 0
        while (lead < end - 1 && index("[({", substr(value, lead + 1, 1))) lead++
        while (wrap < lead) {
          ch = substr(value, lead - wrap, 1)
          closer = (ch == "[") ? "]" : ((ch == "(") ? ")" : "}")
          if (substr(token, end + wrap + 1, 1) != closer) break
          wrap++
        }
        if (wrap > 0) extent = value substr(token, end + 1, wrap)
        if (!key_name_redact && self_named_reference(assignment, value, token, substr(raw, length(token) + 1, 1), substr(raw, length(token) + 1))) return 0
        if (type_annotation(assignment, value, token, substr(raw, length(token) + 1, 1), substr(raw, length(token) + 1))) return 0
        if (member_reference(assignment, value, substr(raw, length(token) + 1, 1), substr(raw, length(token) + 1))) return 0
        if (keyword_expression(assignment, value, substr(raw, length(token) + 1))) return 0
        if (secret_object_name(assignment, value)) return 0
        if (looks_like_reference(value, assignment, leading)) return 0
        if (bare_variable_reference(value)) return 0
        if (version_reference(assignment, value)) return 0
        if (issue_reference(assignment, value, substr(raw, length(token) + 1))) return 0
        if (route_reference(assignment, value)) return 0
        # The token stops at the first space, so an unquoted method sees only
        # its own word; judge it with the next token as one route.
        if (value == token && substr(raw, length(token) + 1, 1) == " ") {
          route = substr(raw, length(token) + 2)
          sub(/[ \t,;].*$/, "", route)
          if (route_reference(assignment, value " " route)) return 0
        }
        if (prose_reference(assignment, value, raw)) return 0
        if (page_cursor(assignment)) return 0
        if (snapshot_handle(assignment, value)) return 0
        if (config_literal(value)) return 0
        if (prose_status_word(value)) return 0
        if (masked_placeholder(value)) return 0
        if (require_credential && !credential_shaped(edge_trim(value))) return 0
        # Eligibility is based on the complete token. For short values, scope
        # replacement to the complete assignment token so an ordinary
        # one-character literal is not replaced throughout the response.
        #
        # The status-label path deliberately does NOT scope: a value that has
        # passed credential_shaped is masked globally, exactly like one found
        # behind any other label. Scoping it left a recurrence visible —
        # `error: password: <secret>` followed by `retrying with <secret>`
        # masked only the labelled line. The false positives that scoping would
        # contain (a version string or a resource name scrubbed from a later
        # line) are not specific to this path: `response: token: v1.2.3` already
        # scrubs every v1.2.3 in the response on main. Consistency with the
        # other paths is worth more here than containing a bad guess, because a
        # displayed secret costs more than a mangled log line.
        if (char_length(value) < 4 && char_length(token) >= 4) {
          trailing = substr(token, end + wrap + 1)
          emit_mapping(assignment leading token,
                       assignment leading "[REDACTED]" trailing,
                       start + length(leading),
                       length(value))
          return 0
        }
        if (emit_secret(value, char_length(token)) && extent != "")
          emit_extent(extent)
        return 0
      }
      # emit_captured, not emit_secret: a padded quoted value (`" <secret> "`)
      # is classified on its trimmed copy just above, so recording only the
      # padded literal left a bare recurrence of the same credential further
      # down unmasked. Record both forms, exactly as the multiline close does.
      emit_captured(value)
      # Coordinates are relative to this scan_line source. Once scan_line
      # advances past the assignment delimiter it translates them to the new
      # `rest`, allowing only mappings from this exact emitted value occurrence
      # to be suppressed. Mixed quotes elsewhere in the span stay scannable.
      next_rescan_cover_start = start + length(leading) + 1
      next_rescan_cover_end = start + length(leading) + length(value)
      return 0
    }
    # Set assignment_start/assignment_length to the leftmost assignment in
    # `low` for one delimiter (`=` or `:`), without depending on which match
    # the awk implementation reports. POSIX requires match() to return the
    # leftmost match, but mawk 1.3.4 can return a longer match further right
    # when the pattern opens with an alternation, which dropped the first of
    # two assignments on one line from the candidates.
    #
    # Each assignment pattern ends in its delimiter and cannot contain it
    # anywhere else, and neither pattern looks past its last character. Two
    # matches of one pattern therefore never overlap, and a match that starts
    # further left ends before the reported one starts and is still a match
    # when the string is cut there. So re-match the text before the reported
    # match until nothing is found: the last match found is the leftmost one,
    # whether match() prefers the leftmost or the longest candidate. Candidates
    # that end at the same delimiter differ only in where they start, so there
    # the longest is also the leftmost. Without the delimiter in the text
    # before the match there is nothing to re-match.
    #
    # The patterns stay literal globals at each match() call: gawk recompiles
    # a pattern that arrives through a function parameter on every call.
    function assignment_match(text, delimiter) {
      if (delimiter == "=") return match(text, equals_assignment)
      return match(text, colon_assignment)
    }
    function find_assignment(low, delimiter, before) {
      assignment_start = 0
      assignment_length = -1
      if (!assignment_match(low, delimiter)) return
      do {
        assignment_start = RSTART
        assignment_length = RLENGTH
        before = substr(low, 1, assignment_start - 1)
      } while (index(before, delimiter) > 0 && assignment_match(before, delimiter))
    }
    function scan_line(line, rest, end, low, eq_start, eq_length, \
                       colon_start, colon_length, start, matched_length, \
                       chose_colon, skip, status_guard, first, expansion, \
                       closed_value, key_opener, advance, advanced, head) {
      rest = line
      advanced = rescan_head
      rescan_head = 0
      rescan_cover_start = 0
      rescan_cover_end = 0
      if (open_quote != "") {
        end = quoted_end(rest, open_quote)
        if (end == 0) {
          open_value = open_value "\n" rest
          return
        }
        closed_value = open_value "\n" substr(rest, 1, end - 1)
        # Classify the EDGE-trimmed capture: an indented continuation line
        # carries leading spaces into closed_value, and the whitespace test
        # would reject the credential before emit_captured could trim it.
        # Internal whitespace is untouched, so it still marks prose.
        if (!open_guard || credential_shaped(edge_trim(closed_value))) {
          emit_captured(closed_value)
          open_quote = ""
          open_value = ""
          open_guard = 0
          rest = substr(rest, end + 1)
          advanced = 1
        } else {
          # The capture scans forward for ANY matching quote, so the one it
          # closed on often belongs to something else entirely — typically the
          # OPENING quote of a credential further down. Re-scanning only what
          # was absorbed then leaves that credential stranded on the far side
          # of a quote the capture ate, with its key consumed too, so nothing
          # masks it. Hand the re-scan the absorbed text AND the rest of this
          # line starting at that quote, which reconstructs the original text
          # exactly, and consume the line here.
          guard_rescan_leaf(closed_value substr(rest, end))
          rest = ""
        }
      }
      while (length(rest) > 0) {
        low = tolower(rest)
        find_assignment(low, "=")
        eq_start = assignment_start
        eq_length = assignment_length
        find_assignment(low, ":")
        colon_start = assignment_start
        colon_length = assignment_length

        start = eq_start
        matched_length = eq_length
        chose_colon = 0
        if (colon_start > 0 && (start == 0 || colon_start < start)) {
          start = colon_start
          matched_length = colon_length
          chose_colon = 1
        }
        if (start == 0) break

        # Whitespace-prefixed colon form: if the text before the whitespace run
        # is a known status label, this MAY be a prose chain (`error: password:
        # authentication is disabled`) rather than an assignment. The label
        # cannot settle it on its own, so hand the decision to the value-side
        # gate in emit_value instead of skipping outright (#156) — prose stays
        # visible, a credential-shaped value still masks. Any other
        # colon-terminated label (`response:`) is treated as structured output.
        # This also covers the chained shape (`response: error: api_key: ...`),
        # whose innermost label is a status word: the value decides there too.
        skip = 0
        status_guard = 0
        first = substr(rest, start, 1)
        # `:` joined the equals delimiter class only for a serialized string
        # leaf (`{"log":"API_KEY=<secret>"}`), where it is immediately followed
        # by the quote that opens the leaf. Without requiring that quote, valid
        # compact source such as the JavaScript labelled statement
        # `label:API_KEY=config.apiKey;` becomes newly reachable and the shared
        # prompt guard blocks it. Preserve the pre-widening behavior for an
        # unquoted key after a colon while keeping the quoted JSON form.
        if (!chose_colon && first == ":") {
          key_opener = substr(rest, start + 1, 1)
          if (key_opener != "\"" && key_opener != "'\''" && key_opener != "`")
            skip = 1
        }
        if (chose_colon && start > 1) {
          # `\r` belongs with space and tab here, or the guard misses the shape
          # the delimiter widening just made reachable: with a carriage return
          # between the label and the key (`error:\rpassword: <prose>`) the
          # colon assignment now matches AT the CR, this test saw a character
          # that was not space or tab, the status label went unrecognised, and
          # the prose chain the allowlist exists to protect was masked.
          if ((first == " " || first == "\t" || first == "\r") &&
              match(substr(low, 1, start - 1), status_label))
            status_guard = 1
          # `${NAME:-default}` / `${NAME:?message}` / `${NAME:=x}` / `${NAME:+x}`
          # is a shell parameter expansion, not an assignment: the operator makes
          # the trailing text a fallback, never the value of the variable. The
          # value gate above rejects the whole `${...}` token; without this
          # the inner `{NAME:` would still read as a JSON/map assignment.
          # Requiring the operator keeps `${password: value}` masked.
          else if (first == "{" && substr(rest, start - 1, 1) == "$") {
            expansion = substr(rest, start + matched_length, 1)
            if (expansion == "-" || expansion == "=" \
                || expansion == "?" || expansion == "+")
              skip = 1
          }
        }

        # Emit exactly the quoted value or the next unquoted token. Continuing
        # after the delimiter finds multiple assignments on one log line while
        # leaving adjacent status text untouched.
        next_rescan_cover_start = 0
        next_rescan_cover_end = 0
        # self_named_reference only applies to a field that starts its line.
        # Nothing of the line may have been consumed yet, and what precedes
        # the key is indentation, one diff marker and declaration keywords.
        # A line locator may come first, as grep -n, rg, git grep -n, cat -n
        # and nl print one: `path:14:`, `14:`, the context forms `path-14-`
        # and `14-`, or a padded number and a tab. It must carry the line
        # number, since a bare `name:` is a key of its own (`user: bob`). Its
        # path part is made of file path characters only, so that the tail of
        # a connection string or of `key=value` log text is not one
        # (`Server=db;Database=app:1: Password=...`), and holds a letter,
        # since digits and dots alone are a clock time, a date or an address
        # (`12:34: password: ...`, `10.0.0.1:5432: ...`). It does not start
        # with `+` or `-`, which would be a diff marker glued to it. Both
        # separators are the same, as the tools print them: `web-1:` is a
        # host or pod name in front of a log line, not a locator.
        #
        # A field that starts its line has little in front of it, so when
        # its `:` or `=` ends more than 1024 bytes into the line the field is
        # in mid-line and none of this runs. Below the limit the key and the
        # locator are cut off by without_key_tail and locator_length, each in
        # one pass over the text: as patterns they took quadratic time on a
        # long run of name or path characters, and one 260 KB line took
        # minutes. The limit also bounds those walks under busybox awk, whose
        # substr() costs time in proportion to the string it reads from.
        key_line_start = 0
        if (!key_name_redact && !advanced && !skip \
            && start + matched_length - 1 <= 1024) {
          head = without_key_tail(substr(rest, 1, start + matched_length - 1))
          head = substr(head, locator_length(head) + 1)
          key_line_start = (head ~ /^[+-]?[ \t\r]*((export|const|let|var|public|private|protected|readonly|static)[ \t]+)*$/)
        }
        if (!skip &&
            emit_value(rest, start + matched_length,
                       substr(rest, start, matched_length), status_guard)) break
        advance = start + matched_length - 1
        if (next_rescan_cover_end > 0) {
          rescan_cover_start = next_rescan_cover_start - advance
          rescan_cover_end = next_rescan_cover_end - advance
        } else if (rescan_cover_end > 0) {
          rescan_cover_start -= advance
          rescan_cover_end -= advance
          if (rescan_cover_end < 1) {
            rescan_cover_start = 0
            rescan_cover_end = 0
          }
        }
        rest = substr(rest, advance + 1)
        advanced = 1
      }
    }
    function scan_leaf(value, newline, line) {
      open_quote = ""
      open_value = ""
      open_guard = 0
      while ((newline = index(value, "\n")) > 0) {
        line = substr(value, 1, newline - 1)
        value = substr(value, newline + 1)
        scan_line(line)
      }
      scan_line(value)
      # Truncated output can omit a closing quote. Redact the leaf remainder.
      if (open_quote != "") {
        if (!open_guard || credential_shaped(edge_trim(open_value)))
          emit_captured(open_value)
        else
          guard_rescan_leaf(open_value)
      }
      open_quote = ""
      open_value = ""
      open_guard = 0
    }
    {
      if (record_mode == "probe_raw") {
        # Raw invalid-byte output is one logical plaintext leaf even though awk
        # presents it as physical records. Keep quote state across records so a
        # sanitized-looking first line cannot hide a credential continuation.
        if (!probe_found) scan_line($0)
        if (probe_found) exit
        next
      }
      record_ended_at_boundary = 0
      # Split once rather than searching/copying the remaining line for every
      # span; dense escaped controls must not turn the fast path quadratic.
      split($0, frame_spans, /[\036\037]/)
      frame_span_index = 1
      frame_span_end = length(frame_spans[frame_span_index])
      for (i = 1; i <= length($0); i++) {
        ch = substr($0, i, 1)
        # Append ordinary bytes as one span. The byte state machine still owns
        # escapes and leaf boundaries, including escapes across physical lines.
        # Repeated single-byte concatenation is quadratic on BSD awk even for
        # a clean line if a newline or one escaped control byte defeats framing.
        if (!escaped && index(escape boundary, ch) == 0) {
          leaf = leaf substr($0, i, frame_span_end - i + 1)
          i = frame_span_end
          record_ended_at_boundary = 0
        } else if (escaped) {
          leaf = leaf ch
          escaped = 0
          record_ended_at_boundary = 0
        } else if (ch == escape) {
          escaped = 1
          record_ended_at_boundary = 0
        } else if (ch == boundary) {
          if (record_mode != "probe" || !probe_found) scan_leaf(leaf)
          leaf = ""
          record_ended_at_boundary = 1
          if (record_mode == "probe" && probe_found) exit
        } else {
          leaf = leaf ch
          record_ended_at_boundary = 0
        }
        if (i > frame_span_end) {
          frame_span_index++
          frame_span_end = i + length(frame_spans[frame_span_index])
        }
      }
      # awk removes physical newlines that came from a JSON leaf, so restore
      # those as data. A record-ending boundary is followed by a synthetic
      # transport newline; do not insert that separator into the next leaf.
      if (!record_ended_at_boundary) leaf = leaf "\n"
    }
    END {
      if (record_mode == "probe_raw") {
        # A truncated multiline quote is evaluated only after the complete raw
        # capture has been scanned. This mirrors scan_leaf without resetting
        # open_quote/open_value at every physical newline.
        # Same status-label gate as the scan_leaf termination above: without
        # it a >64 KiB invalid-UTF-8 capture ending in an unterminated prose
        # chain was replaced wholesale, contradicting the gate everywhere else.
        if (!probe_found && open_quote != "") {
          if (!open_guard || credential_shaped(edge_trim(open_value)))
            emit_captured(open_value)
          else
            guard_rescan_leaf(open_value)
        }
        exit
      }
      # Valid framed input always terminates each leaf with RS. Preserve a final
      # partial record conservatively if a producer ever ends without one.
      if (length(leaf) > 0) scan_leaf(leaf)
    }
  '
}

# Set output_bytes to the byte length of $1. Returns 1 when wc yields no
# well-formed count; each caller decides what a malformed count means. The count
# is returned in a variable, not on stdout, so callers spawn no extra subshell.
output_byte_count() {
  output_bytes=$(printf '%s' "$1" | LC_ALL=C wc -c | tr -d '[:space:]')
  case "$output_bytes" in
    ''|*[!0-9]*) return 1 ;;
  esac
}

# Treat malformed byte counts as over-cap so callers fail closed. Keeping the
# limit in one helper aligns PostToolUse, gitleaks, and exec preflights.
OUTPUT_SCAN_MAX_BYTES=327680
output_scan_input_exceeds_cap() {
  output_byte_count "$1" || return 0
  [ "$output_bytes" -gt "$OUTPUT_SCAN_MAX_BYTES" ]
}

# Bind the live post-tool probe's replacement to this invocation's diagnostic
# log record. A report of "the sentinel came back masked" is otherwise a
# constant that can be produced without running anything; with the run id the
# reader can look the same invocation up in `agent-guard logs export` and see
# `hook-post-tool` finish as `masked`. The id proves that a PostToolUse rewrite
# happened here, not which tool route carried it - the log schema is metadata
# only and records no tool name. Empty whenever no verifiable record exists, and
# the sentinel then masks to the bare placeholder.
#
# This is the one place in the redaction path whose output differs between two
# otherwise identical runs, and the unpredictability is the point: a constant
# expected value can be reported without running anything. Nothing about WHICH
# values get masked varies - only this one sentinel's replacement text.
live_probe_run_id() {
  [ -n "$AG_AUDIT_FILE" ] || return 0
  audit_run_id_valid "$AG_AUDIT_ID" || return 0
  printf '%s' "$AG_AUDIT_ID"
}

live_probe_marker_valid() {
  live_probe_id=$1
  live_probe_dir=$2
  live_probe_marker="$live_probe_dir/live-probe-$live_probe_id"
  private_dir_ok "$live_probe_marker" || return 1
  ! find "$live_probe_marker" -mindepth 1 -maxdepth 1 -print 2>/dev/null \
    | grep -q .
}

# Record only that this audit invocation handled the public harmless sentinel.
# The empty private directory carries no tool output or other user content, and
# mkdir is atomic: a pre-existing file, directory, or symlink makes the marker
# fail closed and the replacement stays the bare placeholder.
audit_mark_live_probe() {
  [ -n "$AG_AUDIT_FILE" ] || return 1
  audit_run_id_valid "$AG_AUDIT_ID" || return 1
  live_probe_dir=$(audit_directory) || return 1
  [ "$AG_AUDIT_FILE" = "$live_probe_dir/event-$AG_AUDIT_ID" ] || return 1
  live_probe_marker="$live_probe_dir/live-probe-$AG_AUDIT_ID"
  (umask 077; mkdir "$live_probe_marker") 2>/dev/null || return 1
  if live_probe_marker_valid "$AG_AUDIT_ID" "$live_probe_dir"; then
    AG_LIVE_PROBE_MARKER=$live_probe_marker
    return 0
  fi
  rmdir "$live_probe_marker" 2>/dev/null || :
  return 1
}

audit_clear_live_probe_marker() {
  [ -n "$AG_LIVE_PROBE_MARKER" ] || return 0
  live_probe_marker=$AG_LIVE_PROBE_MARKER
  AG_LIVE_PROBE_MARKER=
  live_probe_dir=$(audit_directory) || return 0
  [ "$live_probe_marker" = "$live_probe_dir/live-probe-$AG_AUDIT_ID" ] || return 0
  live_probe_marker_valid "$AG_AUDIT_ID" "$live_probe_dir" || return 0
  rmdir "$live_probe_marker" 2>/dev/null || :
}

response_drops_live_probe() {
  printf '%s' "$1" | jq -e --arg probe "$LIVE_POST_TOOL_PROBE" \
    'any(.. | strings; contains($probe)) | not' >/dev/null 2>&1
}

# A prior live-probe replacement may pass through another PostToolUse event. It
# is trusted only when its exact generated id resolves to both the private
# sentinel sidecar and a bounded metadata record proving that a post-tool
# invocation finished masked. Prefixes, id shape, and an ordinary masked record
# are not provenance: forged lookalikes stay subject to PII.
live_probe_audit_record_exists() {
  live_probe_id=$1
  live_probe_dir=$2
  audit_run_id_valid "$live_probe_id" || return 1
  live_probe_file="$live_probe_dir/event-$live_probe_id"
  [ -f "$live_probe_file" ] && [ ! -L "$live_probe_file" ] || return 1
  [ "$(file_stat access -P "$live_probe_file")" = "$(id -u):600" ] || return 1
  live_probe_marker_valid "$live_probe_id" "$live_probe_dir" || return 1
  live_probe_bytes=$(wc -c <"$live_probe_file" | tr -d '[:space:]')
  case "$live_probe_bytes" in ''|*[!0-9]*) return 1 ;; esac
  [ "$live_probe_bytes" -le 2048 ] || return 1
  jq -e --arg id "$live_probe_id" '
      select(type == "object"
             and .schema == 1
             and .run_id == $id
             and .command == "hook-post-tool"
             and (.host == "claude" or .host == "codex")
             and .phase == "finished"
             and .outcome == "masked")
      | true
    ' "$live_probe_file" >/dev/null 2>&1
}

# Return at most sixteen provenance-verified, whole-leaf replacements. The
# response itself is already capped before this path; the tighter candidate cap
# bounds filesystem work even for adversarial output containing many lookalikes.
trusted_live_probe_replacements() {
  live_probe_response=$1
  case "$live_probe_response" in
    *"$LIVE_POST_TOOL_REPLACEMENT_PREFIX"*) ;;
    *) printf '%s' '[]'; return 0 ;;
  esac
  live_probe_dir=$(audit_directory) || {
    printf '%s' '[]'
    return 0
  }
  live_probe_candidates=$(printf '%s' "$live_probe_response" \
    | jq -c --arg prefix "$LIVE_POST_TOOL_REPLACEMENT_PREFIX" \
        --arg run_id_re "$AUDIT_RUN_ID_JQ_REGEX" '
        [.. | strings
         | select(startswith($prefix))
         | .[($prefix | length):] as $id
         | select($id | test($run_id_re))]
        | unique | .[:16][]
      ' 2>/dev/null) || {
    printf '%s' '[]'
    return 0
  }
  [ -n "$live_probe_candidates" ] || {
    printf '%s' '[]'
    return 0
  }
  printf '%s\n' "$live_probe_candidates" \
    | while IFS= read -r live_probe_candidate; do
        live_probe_id=$(printf '%s' "$live_probe_candidate" \
          | jq -r --arg prefix "$LIVE_POST_TOOL_REPLACEMENT_PREFIX" \
              '.[($prefix | length):]' 2>/dev/null) || continue
        if live_probe_audit_record_exists "$live_probe_id" "$live_probe_dir"; then
          printf '%s\n' "$live_probe_candidate"
        fi
      done \
    | jq -sc 'unique' 2>/dev/null
}

# --- Known values from the project's own dotenv files (#445) ------------------
# A secret under a generic key (APP_SEED=...) has no vendor prefix and no
# secret-like key name, so no detector below can recognize it in output on its
# own. In AGENT_GUARD_DENY_READ_MODE=mask, where the user already lets Agent
# Guard's own process read protected files, the values of the root dotenv
# files are treated as known secrets: every exact occurrence in output becomes
# [REDACTED] through the same literal records as any other finding.
#
# The one switch point. In `block` mode (the default) no protected file is
# ever opened. AGENT_GUARD_KNOWN_VALUE_REDACT=off turns it off in mask mode;
# AGENT_GUARD_OUTPUT_REDACT=off never reaches the detector at all.
known_value_redact_enabled() {
  # deny_read_mode's own values, without a command substitution per event:
  # only an exact `mask` opts in; unset, `block` and invalid values do not.
  [ "${AGENT_GUARD_DENY_READ_MODE:-block}" = mask ] || return 1
  case "${AGENT_GUARD_KNOWN_VALUE_REDACT:-on}" in
    off) return 1 ;;
  esac
  return 0
}

# The directory output masking treats as the project: the PostToolUse event's
# `cwd`, or for exec the process working directory. Set by the caller.
ag_known_value_base=

# Print, one per line, the values of the dotenv files directly in the project
# directory and in its Git top level (no recursion). A file counts when its
# basename is a deny-read rule (with that rule's template and source-module
# exemptions, so `.env.example` is skipped) and mask-file reads it as dotenv.
# Symlinks are skipped. A file mask-file cannot read or parse (unreadable,
# over 64 KiB, outside its dotenv subset) contributes no values; masking by
# every other rule continues. Values shorter than 8 bytes, booleans, numbers,
# empty values and values with fewer than two of letters, digits and other
# characters (a plain word) are dropped. Nothing is written to disk or to stderr.
known_env_values() (
  kv_base=$ag_known_value_base
  [ -n "$kv_base" ] && [ -d "$kv_base" ] || kv_base=.
  kv_base=$(CDPATH= cd -- "$kv_base" 2>/dev/null && pwd -P) || exit 0
  [ -f "$DENY_READ_PATHS" ] || exit 0
  kv_top=
  if command -v git >/dev/null 2>&1; then
    kv_top=$(CDPATH= cd -- "$kv_base" && git rev-parse --show-toplevel 2>/dev/null) \
      || kv_top=
    if [ -n "$kv_top" ]; then
      kv_top=$(CDPATH= cd -- "$kv_top" 2>/dev/null && pwd -P) || kv_top=
    fi
    [ "$kv_top" != "$kv_base" ] || kv_top=
  fi
  for kv_dir in "$kv_base" ${kv_top:+"$kv_top"}; do
    for kv_file in "$kv_dir"/.[!.]* "$kv_dir"/..?* "$kv_dir"/*; do
      kv_name=${kv_file##*/}
      # A cheap superset of the dotenv names; the deny rules and mask-file
      # below make the actual decision.
      case $kv_name in
        *env*|.dev.vars*) ;;
        *) continue ;;
      esac
      [ -f "$kv_file" ] && [ ! -L "$kv_file" ] || continue
      [ "$(mask_file_format "$kv_file" 2>/dev/null)" = dotenv ] || continue
      candidate_matches_deny "$kv_name" || continue
      mask_file "$kv_file" values 2>/dev/null || :
    done
  done | LC_ALL=C awk '
    length($0) < 8 { next }
    tolower($0) ~ /^(true|false|yes|no|on|off)$/ { next }
    /^[-+]?[0-9]+([.][0-9]+)?$/ { next }
    {
      # At least two of letters, digits and other characters, so a plain
      # word such as `development` or `localhost` is not a known value.
      k = ($0 ~ /[A-Za-z]/) + ($0 ~ /[0-9]/) + ($0 ~ /[^A-Za-z0-9]/)
      if (k >= 2) print
    }
  '
)

# JSON-string records for the known values that occur in the decoded output
# strings file $1. Only values present in the output become records, so a
# large dotenv file cannot push the bundle over its record cap. Literal
# index() matching: a value is never a regex. A matcher failure fails the
# detector, and the caller then masks conservatively. Callers check
# known_value_redact_enabled first, so `block` mode forks nothing here.
known_env_value_records() (
  [ -s "$1" ] || exit 0
  kv_values=$(known_env_values) || kv_values=
  [ -n "$kv_values" ] || exit 0
  kv_found=$(printf '%s\n' "$kv_values" | LC_ALL=C awk '
    NR == FNR { if (!($0 in want)) { want[$0] = 1; n++ }; next }
    n > 0 {
      for (v in want)
        if (index($0, v)) { print v; delete want[v]; n-- }
    }
  ' - "$1") || exit 1
  [ -n "$kv_found" ] || exit 0
  printf '%s\n' "$kv_found" | jq -Rc 'select(length > 0)' 2>/dev/null
)

# mktemp_files VAR...: assign each named variable its own mktemp_file path. If
# an allocation fails, remove the files this call already made (in one rm) and
# return 1, so the caller fails closed with nothing left behind. Each path is
# still allocated through $(...): rundir_temp_file changes umask and noclobber
# in the shell that runs it. The arguments are fixed variable names in code,
# never input, which is what makes the eval safe. Allocated paths rotate onto
# the end of the positional list, so a failure can drop the names not yet
# assigned and pass exactly the allocated paths to rm.
mktemp_files() {
  mktemp_files_left=$#
  while [ "$mktemp_files_left" -gt 0 ]; do
    mktemp_files_path=$(mktemp_file) || {
      shift "$mktemp_files_left"
      [ "$#" -eq 0 ] || rm -f "$@"
      return 1
    }
    eval "$1=\$mktemp_files_path"
    shift
    set -- "$@" "$mktemp_files_path"
    mktemp_files_left=$((mktemp_files_left - 1))
  done
}

# Collect JSON-string records for the literal secrets present in the response
# JSON ($1): gitleaks findings plus the env-assignment heuristic and compact
# token rules. The env heuristic scans each string leaf independently so quote
# state can never cross a stdout/stderr or array boundary.
# Materialize every detector stage before consuming its output. POSIX pipelines
# expose only their final command status, so a producer that writes a prefix and
# then fails must never be indistinguishable from a successful empty detector.
detect_output_secret_records() (
  response=$1
  env_records=${2:-yes}
  mktemp_files detector_input detector_strings detector_records \
    detector_work_a detector_work_b || exit 1
  detector_cleanup() {
    rm -f "$detector_input" "$detector_strings" "$detector_records" \
      "$detector_work_a" "$detector_work_b" ${detector_report:+"$detector_report"}
  }
  detector_fail() {
    detector_cleanup
    exit 1
  }

  : >"$detector_records" || detector_fail
  printf '%s' "$response" >"$detector_input" || detector_fail
  jq -rj 'if type == "string" then . else [.. | strings] | join("\n") end' \
    <"$detector_input" >"$detector_strings" 2>/dev/null || detector_fail

  gl=${GITLEAKS_READY_BIN:-}
  [ -n "$gl" ] && [ -x "$gl" ] || detector_fail
  [ -f "$GITLEAKS_CONFIG" ] || detector_fail
  if output_scan_input_exceeds_cap "$response"; then
      printf '%s\n' '{"agent_guard_whole_leaf":true}' \
        >>"$detector_records" || detector_fail
  else
      detector_report=$(mktemp_file) || detector_fail
      # gitleaks removes the report path and creates it again, so the file
      # takes the scanner's umask, not the mode mktemp gave it. The report
      # holds the found values unredacted: keep it private even when the
      # temp file had to land outside the run directory (#559).
      if gitleaks_helper_selected; then
        (
          ulimit -f 128 >/dev/null 2>&1 || exit 2
          umask 077
          gitleaks_exec "$gl" stdin --report-format json --report-path "$detector_report" \
            --no-banner --config "$GITLEAKS_CONFIG" <"$detector_strings"
        ) >/dev/null 2>&1
      else
        (
          ulimit -f 128 >/dev/null 2>&1 || exit 2
          umask 077
          "$gl" stdin --report-format json --report-path "$detector_report" \
            --no-banner --config "$GITLEAKS_CONFIG" <"$detector_strings"
        ) >/dev/null 2>&1
      fi
      detector_status=$?
      case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
      [ -s "$detector_report" ] || detector_fail
      # Validate and extract in one parser invocation. Partial records a
      # parser error leaves in the private records file are never printed:
      # detector_fail discards the file before the final cat.
      jq -sc 'if length == 0 or any(.[]; type != "array")
              then error("invalid scanner report") else .[] end
             | .[]? | (.Secret // empty)
             | select(type == "string" and length > 0)' \
        "$detector_report" >>"$detector_records" 2>/dev/null || detector_fail
      rm -f "$detector_report"
      detector_report=
  fi

  if [ "$env_records" = yes ]; then
    frame_json_string_leaves <"$detector_input" \
      >"$detector_work_a" 2>/dev/null || detector_fail
    secretish_env_values <"$detector_work_a" \
      >>"$detector_records" 2>/dev/null || detector_fail
  fi

  grep -Eo 'eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+' \
    <"$detector_strings" >"$detector_work_a" 2>/dev/null
  detector_status=$?
  case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
  jq -Rc 'select(length > 0)' <"$detector_work_a" \
    >>"$detector_records" 2>/dev/null || detector_fail

  grep -Eio 'bearer[ \t]+[-A-Za-z0-9._~+/=]+' \
    <"$detector_strings" >"$detector_work_a" 2>/dev/null
  detector_status=$?
  case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
  awk '{ tok = $2; if (length(tok) >= 8) print tok }' \
    <"$detector_work_a" >"$detector_work_b" 2>/dev/null || detector_fail
  jq -Rc 'select(length > 0)' <"$detector_work_b" \
    >>"$detector_records" 2>/dev/null || detector_fail

  if known_value_redact_enabled; then
    known_env_value_records "$detector_strings" \
      >>"$detector_records" 2>/dev/null || detector_fail
  fi

  cat "$detector_records"
  detector_status=$?
  detector_cleanup
  exit "$detector_status"
)

# Bound secret records before materializing them in a shell variable or passing
# the resulting JSON through exec argv. The raw-record cap is intentionally
# conservative: duplicates still count because stopping after a prefix cannot
# prove that later records contain no new secret. Callers fail closed when
# either cap is crossed.
bundle_secret_records() (
  mktemp_files bundle_input bundle_records bundle_output || exit 1
  if ! cat >"$bundle_input" \
    || ! LC_ALL=C awk '
        BEGIN {
          max_records = 256
          max_bytes = 65536
        }
        {
          record_count++
          record_bytes += length($0) + 1
          if (record_count > max_records || record_bytes > max_bytes) {
            print "{\"agent_guard_whole_leaf\":true}"
            exceeded = 1
            exit
          }
          records[record_count] = $0
        }
        END {
          if (!exceeded)
            for (i = 1; i <= record_count; i++) print records[i]
        }
      ' <"$bundle_input" >"$bundle_records" \
    || ! jq -sc "$JQ_SETTLE_EXTENTS"'
        if any(.[]; type == "object" and .agent_guard_whole_leaf == true)
        then {whole_leaf: true, secrets: []}
        else {whole_leaf: false, secrets: settle_extents}
        end
      ' <"$bundle_records" >"$bundle_output" 2>/dev/null; then
    rm -f "$bundle_input" "$bundle_records" "$bundle_output"
    exit 1
  fi
  cat "$bundle_output"
  bundle_status=$?
  rm -f "$bundle_input" "$bundle_records" "$bundle_output"
  exit "$bundle_status"
)

detect_output_secret_bundle() (
  bundle_response=$1
  mktemp_files bundle_raw bundle_json || exit 1
  if ! detect_output_secret_records "$bundle_response" >"$bundle_raw" \
    || ! bundle_secret_records <"$bundle_raw" >"$bundle_json"; then
    rm -f "$bundle_raw" "$bundle_json"
    exit 1
  fi
  cat "$bundle_json"
  bundle_status=$?
  rm -f "$bundle_raw" "$bundle_json"
  exit "$bundle_status"
)

# Parse a completed detector bundle once. The jq output is staged privately and
# accepted only after successful completion, then decoded as two newline-bounded
# fields without invoking another parser that could fail after partial output.
classify_secret_bundle() {
  classify_bundle_value=$1
  BUNDLE_MODE=
  BUNDLE_SECRETS=
  mktemp_files classify_bundle_input classify_bundle_output || return 1
  if ! printf '%s' "$classify_bundle_value" >"$classify_bundle_input" \
    || ! jq -jr '
      if type != "object"
         or (.whole_leaf | type) != "boolean"
         or (.secrets | type) != "array"
         or any(.secrets[];
                ((type == "string")
                 or (type == "object"
                     and (.literal | type) == "string"
                     and (.replacement | type) == "string"
                     and ((.contextual // false) | type) == "boolean"))
                | not)
      then error("invalid secret bundle")
      elif .whole_leaf
      then "whole_leaf\n[]\n"
      else "secrets\n\(.secrets | tojson)\n"
      end
    ' <"$classify_bundle_input" >"$classify_bundle_output" 2>/dev/null; then
    rm -f "$classify_bundle_input" "$classify_bundle_output"
    return 1
  fi
  classify_bundle_lines=0
  while IFS= read -r classify_bundle_line; do
    classify_bundle_lines=$((classify_bundle_lines + 1))
    case "$classify_bundle_lines" in
      1) BUNDLE_MODE=$classify_bundle_line ;;
      2) BUNDLE_SECRETS=$classify_bundle_line ;;
      *)
        rm -f "$classify_bundle_input" "$classify_bundle_output"
        BUNDLE_MODE=
        BUNDLE_SECRETS=
        return 1
        ;;
    esac
  done <"$classify_bundle_output"
  rm -f "$classify_bundle_input" "$classify_bundle_output"
  [ "$classify_bundle_lines" -eq 2 ] || return 1
  case "$BUNDLE_MODE:$BUNDLE_SECRETS" in
    whole_leaf:'[]'|secrets:'['*']') return 0 ;;
  esac
  BUNDLE_MODE=
  BUNDLE_SECRETS=
  return 1
}

# Remove the four work files of detect_printenv_argument_secret_records.
printenv_detect_cleanup() {
  rm -f "$printenv_args_file" "$printenv_entries_file" \
    "$printenv_work_a" "$printenv_work_b"
}

# `printenv NAME` prints only the value, so the output loses the secret-bearing
# variable name that secretish_env_values needs as context. Reconstruct that
# context from simple variable-name arguments, then emit only the detected
# values for literal redaction of the original bare output. GNU printenv emits
# every present argument while BSD printenv emits only the first; compare the
# captured output with both models before deciding which requested values were
# actually emitted. This intentionally ignores options and invalid names; the
# normal gitleaks scan still covers them.
detect_printenv_argument_secret_records() {
  response=$1
  shift
  [ "$#" -gt 1 ] || return 0
  cmd_name=${1##*/}
  [ "$cmd_name" = printenv ] || return 0
  shift
  [ "${1:-}" = "--" ] && shift
  [ "$#" -gt 0 ] || return 0
  mktemp_files printenv_args_file printenv_entries_file \
    printenv_work_a printenv_work_b || return 1

  # Do not replay the complete printenv argument list into a second process
  # argv: the original command can fit while jq's extra argv entries cross
  # ARG_MAX. NUL is the only byte a process argument cannot contain, so this
  # preserves every argument boundary without reserving another sentinel.
  # jq 1.6 raw slurp drops a final NUL. Append a non-NUL terminal field so the
  # preceding argument delimiter survives, then validate/remove only that field.
  if ! { printf '%s\0' "$@" && printf '.'; } >"$printenv_args_file" \
    || ! jq -Rsc '
    def trim_trailing_newlines: sub("\n+$"; "");
    (split("\u0000")
     | if length > 1 and .[-1] == "." then .[:-1]
       else error("unterminated printenv argument stream")
       end) as $args
    | {entries:
         ($args
          | to_entries
          | map(.value as $name
                | {position: .key,
                   name: $name,
                   valid: ($name | test("^[A-Za-z_][A-Za-z0-9_]*$"))})),
       names:
         ($args
          | map(select(test("^[A-Za-z_][A-Za-z0-9_]*$")))
          | unique
          | map(. as $name
                | (env[$name] // "") as $value
                | ($value | trim_trailing_newlines) as $trimmed_value
                | {name: $name,
                   present: (env[$name] != null),
                   value: $value,
                   value_length: ($value | length),
                   trimmed_value: $trimmed_value,
                   trimmed_length: ($trimmed_value | length),
                   has_content: (($trimmed_value | length) > 0),
                   probe: ("agent_guard_printenv_probe_" + $name)}))}
  ' "$printenv_args_file" >"$printenv_entries_file" 2>/dev/null \
    || ! jq -c '
      [.names[] | select(.present) | (.name + "=" + .probe)]
    ' "$printenv_entries_file" >"$printenv_work_a" 2>/dev/null \
    || ! frame_json_string_leaves \
      <"$printenv_work_a" >"$printenv_work_b" 2>/dev/null \
    || ! secretish_env_values \
      <"$printenv_work_b" >"$printenv_work_a" 2>/dev/null \
    || ! jq -sc 'reduce .[] as $probe ({}; .[$probe] = true)' \
      "$printenv_work_a" >"$printenv_work_b" 2>/dev/null; then
    printenv_detect_cleanup
    return 1
  fi

  # Feed entries, recognized probes, and captured output as three JSON
  # documents. Generated JSON can expand far beyond Linux MAX_ARG_STRLEN even
  # though the original plaintext remains under the output cap.
  : >"$printenv_work_a" || {
    printenv_detect_cleanup
    return 1
  }
  if ! cat "$printenv_entries_file" >>"$printenv_work_a" \
    || ! printf '\n' >>"$printenv_work_a" \
    || ! cat "$printenv_work_b" >>"$printenv_work_a" \
    || ! printf '\n%s\n' "$response" >>"$printenv_work_a"; then
    printenv_detect_cleanup
    return 1
  fi

  jq -cs '
    .[0] as $metadata
    | .[1] as $recognized
    | .[2] as $output
    | $metadata.entries as $entries
    | ($metadata.names
       | map({key: .name, value: .})
       | from_entries) as $names
    | [$entries[]
       | select(.valid)
       | . as $entry
       | select($names[$entry.name].present)
       | {position: .position, name: .name}] as $emitted
    # Shell capture removes every trailing newline from GNU printenv output.
    # Therefore entries after the last content-bearing value cannot affect the
    # capture. Exclude them from both the length gate and materialization so
    # repeated empty/newline-only values cannot amplify the model.
    | ([$emitted[]
        | select($names[.name].has_content)]) as $gnu_content_entries
    | (($gnu_content_entries[-1] // null)) as $gnu_last_entry
    | (if $gnu_last_entry == null
       then 0
       else (reduce ($emitted[]
                     | select(.position <= $gnu_last_entry.position)) as $entry
               ({length: 0, count: 0};
                ($names[$entry.name]) as $name
                | .length +=
                    ((if $entry.position == $gnu_last_entry.position
                      then $name.trimmed_length
                      else $name.value_length
                      end)
                     + (if .count > 0 then 1 else 0 end))
                | .count += 1)
             | .length)
       end) as $gnu_output_length
    | (if $gnu_output_length == ($output | length)
       then (if $gnu_last_entry == null
             then ""
             else ($emitted
                   | map(select(.position <= $gnu_last_entry.position)
                         | if .position == $gnu_last_entry.position
                           then $names[.name].trimmed_value
                           else $names[.name].value
                           end)
                   | join("\n"))
             end)
       else null
       end) as $gnu_output
    | (if (($entries | length) > 0
             and $entries[0].valid
             and $names[$entries[0].name].present)
       then $names[$entries[0].name].trimmed_value
       else ""
       end) as $bsd_output
    | (($gnu_last_entry.position // -1)) as $gnu_last_position
    | $entries[]
    | . as $entry
    | select(.valid)
    | $names[$entry.name] as $name
    | select($name.present and $recognized[$name.probe] == true)
    | if ($output == $gnu_output and $output != $bsd_output)
      then (if .position == $gnu_last_position
            then $name.trimmed_value
            else $name.value
            end)
      elif ($output == $bsd_output and $output != $gnu_output)
      then select(.position == 0) | $name.trimmed_value
      else ($name.value, $name.trimmed_value)
      end
    | select(length >= 4)
    | select(. as $value | $output | contains($value))
  ' "$printenv_work_a" 2>/dev/null
  printenv_detect_status=$?
  printenv_detect_cleanup
  return "$printenv_detect_status"
}

detect_exec_secret_bundle() (
  exec_bundle_response=$1
  exec_bundle_invalid=$2
  shift 2
  mktemp_files exec_bundle_records exec_bundle_json || exit 1
  : >"$exec_bundle_records" || {
    rm -f "$exec_bundle_records" "$exec_bundle_json"
    exit 1
  }
  exec_detector_failed=0
  if [ -n "$exec_bundle_response" ]; then
    if [ "$exec_bundle_invalid" -eq 1 ]; then
      detect_output_secret_records "$exec_bundle_response" no \
        >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
    else
      detect_output_secret_records "$exec_bundle_response" \
        >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
    fi
  fi
  detect_printenv_argument_secret_records "$exec_bundle_response" "$@" \
    >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
  if [ "$exec_detector_failed" -ne 0 ]; then
    printf '%s\n' '{"agent_guard_whole_leaf":true}' \
      >"$exec_bundle_records" || {
        rm -f "$exec_bundle_records" "$exec_bundle_json"
        exit 1
      }
  fi
  if ! bundle_secret_records <"$exec_bundle_records" >"$exec_bundle_json"; then
    rm -f "$exec_bundle_records" "$exec_bundle_json"
    exit 1
  fi
  cat "$exec_bundle_json"
  exec_bundle_status=$?
  rm -f "$exec_bundle_records" "$exec_bundle_json"
  exit "$exec_bundle_status"
)

# Invalid UTF-8 cannot round-trip through jq's env lookup, so its reconstructed
# printenv value cannot be matched byte-for-byte. Detect secret-bearing requested
# names without reading their values; exec then conservatively masks the captured
# output instead of risking a bare credential leak.
printenv_requests_secretish_name() {
  [ "$#" -gt 1 ] || return 1
  cmd_name=${1##*/}
  [ "$cmd_name" = printenv ] || return 1
  shift
  [ "${1:-}" = "--" ] && shift
  [ "$#" -gt 0 ] || return 1
  {
    for name do
      case "$name" in
        [A-Za-z_]*)
          case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
          printf '%s=%s\n' "$name" agent_guard_printenv_probe
          ;;
      esac
    done
  } \
    | frame_plaintext_leaf \
    | secretish_env_values framed \
    | grep -q .
}

# Set rust_core to the native redactor redact_tool_response_json may run: an
# explicit AGENT_GUARD_RUST_CORE_BIN, the unsuffixed packaged helper, or the
# packaged helper for the running architecture when its shipped checksum
# matches. Empty when nothing is configured or no architecture helper
# qualifies; the caller runs it only when it is an absolute executable path.
select_rust_redactor() {
  rust_core=${AGENT_GUARD_RUST_CORE_BIN:-}
  if [ -z "$rust_core" ] && [ -n "${ROOT_DIR:-}" ]; then
    rust_core="$ROOT_DIR/libexec/agent-guard-redact"
  fi
  # Explicit developer overrides retain their trusted-executable contract.
  # Packaged helpers are selected only for the running architecture and must
  # match the checksum shipped inside the checksum-verified release archive.
  if [ -z "${AGENT_GUARD_RUST_CORE_BIN:-}" ] && [ -n "${ROOT_DIR:-}" ] \
      && [ -d "$ROOT_DIR/libexec" ] && [ ! -e "$rust_core" ]; then
    rust_target=
    case "$(uname -s):$(uname -m)" in
      Linux:x86_64|Linux:amd64) rust_target=x86_64-unknown-linux-musl ;;
      Linux:aarch64|Linux:arm64) rust_target=aarch64-unknown-linux-musl ;;
      # Intel macOS has no helper after v3.8.2; a leftover one stays unused.
      Darwin:arm64) rust_target=aarch64-apple-darwin ;;
    esac
    rust_name="agent-guard-redact-$rust_target"
    rust_core="$ROOT_DIR/libexec/$rust_name"
    if [ -n "$rust_target" ] && [ -f "$rust_core" ] && [ ! -L "$rust_core" ] \
        && [ -f "$rust_core.sha256" ] && [ ! -L "$rust_core.sha256" ] \
        && rust_expected=$(cat "$rust_core.sha256" 2>/dev/null) \
        && rust_actual=$(
          CDPATH='' cd -- "$ROOT_DIR/libexec" || exit 1
          # Avoid starting Perl for each Linux invocation. Both tools emit
          # the same SHA-256/name record; macOS keeps its system shasum.
          if command -v sha256sum >/dev/null 2>&1; then
            sha256sum "$rust_name" 2>/dev/null
          else
            shasum -a 256 "$rust_name" 2>/dev/null
          fi
        ) \
        && [ "$rust_expected" = "$rust_actual" ]; then
      :
    else
      rust_core=
    fi
    unset rust_target rust_name rust_expected rust_actual
  fi
}

# Replace every detected secret literal with a placeholder inside ANY string leaf
# of the tool_response JSON ($1), preserving the original shape exactly
# (updatedToolOutput must match the tool's native output shape). $2 is a JSON
# string array. Prints the redacted JSON, or nothing on failure.
redact_tool_response_json() {
  resp=$1
  secrets=$2
  [ -n "$secrets" ] || return 1
  # Prefer the qualified packaged helper. Explicit shell/empty selections keep
  # the established jq contract; failed/partial helper stdout is never published.
  if [ "${AGENT_GUARD_EXPERIMENTAL_REDACTOR-rust}" = rust ]; then
    select_rust_redactor
    case "$rust_core" in
      /*)
        if [ -x "$rust_core" ] && rust_result=$(
          printf '{"protocol":1,"response":%s,"secrets":%s}\n' "$resp" "$secrets" \
            | "$rust_core" redact-v1 2>/dev/null
        ) && printf '%s\n' "$rust_result" | jq -e -s 'length == 1' >/dev/null 2>&1; then
          printf '%s\n' "$rust_result"
          unset rust_result rust_core
          return 0
        fi
        ;;
    esac
    unset rust_result rust_core
  fi
  # Redacts string VALUES only; object KEYS are left untouched. Transforming keys
  # could collide two distinct keys onto one placeholder and silently drop an
  # entry; a secret appearing as a JSON key is a documented limitation (README).
  printf '%s' "$resp" | jq -c --argjson secrets "$secrets" \
    "$JQ_SHAPE_SAFE_WALK"'
    def specs($s):
      $s
      | map(if type == "string"
            then {literal: ., replacement: "[REDACTED]", contextual: false}
            elif (type == "object"
                  and (.literal | type) == "string"
                  and (.replacement | type) == "string")
            then (. + {contextual: (.contextual == true)})
            else empty
            end);
    def context_replace($literal; $replacement):
      if contains($literal)
      then (. / $literal) as $parts
           | reduce range(1; $parts | length) as $i ($parts[0];
               . + (if ($parts[$i] | test("^([ \t\n,;]|$)"))
                    then $replacement
                    else $literal
                    end)
                 + $parts[$i])
      else .
      end;
    def prepare_specs($specs):
      {contextual: ($specs | map(select(.contextual))
                    | sort_by(.literal | length) | reverse),
       ordinary: ($specs | map(select(.contextual | not))
                  | sort_by(.literal | length) | reverse)};
    def redact($plan):
      reduce $plan.contextual[] as $x (.;
          if ($x.literal | length) > 0
          then context_replace($x.literal; $x.replacement)
          else .
          end)
      | reduce $plan.ordinary[] as $x (.;
        if ($x.literal | length) > 0 and contains($x.literal)
        then ((. / $x.literal) | join($x.replacement))
        else .
        end);
    (specs($secrets)) as $specs
    | (reduce (.. | strings) as $leaf
         (0; . + ($leaf | length) + 1)) as $string_work
    # Literal replacement is proportional to spec-count × response size.
    # Bound that work below the host hook timeout. High-cardinality output is
    # still fail-closed in one tree walk by masking every nonempty string leaf.
    # Both walks are key-aware: a detected literal that happens to equal a
    # protocol token would otherwise break the response shape here for exactly
    # the reason JQ_SHAPE_SAFE_WALK describes, on the precise path too.
    | if ($specs | length) > 256
         or (($specs | length) * $string_work) > 8000000
      then shape_safe_walk(if type == "string" and length > 0
                           then "[REDACTED]" else . end)
      # Ordering belongs to the response, not each string leaf. Reuse one
      # immutable plan while preserving contextual-first, longest-first order.
      else prepare_specs($specs) as $plan
           | shape_safe_walk(if type == "string" and length > 0
                             then redact($plan) else . end)
      end
  ' 2>/dev/null
}

# Replace only the harmless live sentinel after ordinary secret and PII masking.
# The audit id is generated by this hook invocation, not taken from tool output,
# and is introduced only after the generic PII pass so its timestamp cannot be
# mistaken for a phone number. Attacker-controlled text receives no exemption.
redact_live_probe_response_json() {
  resp=$1
  run_id=${2:-}
  case "$resp" in
    *"$LIVE_POST_TOOL_PROBE"*) ;;
    *) printf '%s' "$resp"; return 0 ;;
  esac
  replacement='[REDACTED]'
  if [ -n "$run_id" ]; then
    replacement="$LIVE_POST_TOOL_REPLACEMENT_PREFIX$run_id"
  fi
  specs=$(jq -nc \
    --arg literal "$LIVE_POST_TOOL_PROBE" \
    --arg replacement "$replacement" \
    '[{literal: $literal, replacement: $replacement, contextual: false}]') \
    || return 1
  redact_tool_response_json "$resp" "$specs"
}

# POSIX shell variables cannot preserve NUL bytes. Keep NUL-bearing JSON leaves
# out of command substitution entirely and conservatively replace the whole leaf
# before the ordinary literal detector runs.
# jq 1.6 contains("\u0000") also matches strings without NUL. index() uses
# length-aware matching and preserves the same contract across jq versions.
redact_nul_response_json() {
  resp=$1
  { printf '%s' "$resp"; } 2>/dev/null | jq -c "$JQ_WALK"'
    walk(if type == "string" and (index("\u0000") != null)
         then "[REDACTED]" else . end)
  ' 2>/dev/null
}

# Large, high-cardinality assignment dumps can exhaust the host timeout while
# the ordinary detector collects every unique literal. Probe them in one
# streaming pass first; only a confirmed secret-bearing assignment takes the
# conservative whole-leaf path. Large clean output still uses normal detection,
# and so does a response whose size cannot be counted: this is only a precheck.
# $2 is the output_byte_count of $1 that output_scan_input_exceeds_cap took; a
# count that failed made that check true, so this one never runs on it. It is
# not recounted: that costs another full copy of a large output.
OUTPUT_LARGE_PROBE_BYTES=262144
large_response_has_secretish_assignment() {
  large_probe_response=$1
  [ "$2" -gt "$OUTPUT_LARGE_PROBE_BYTES" ] || return 1
  printf '%s' "$large_probe_response" \
    | frame_json_string_leaves 2>/dev/null \
    | secretish_env_values probe \
    | grep -q .
}

redact_nonempty_response_strings() {
  whole_leaf_response=$1
  { printf '%s' "$whole_leaf_response"; } 2>/dev/null \
    | jq -c "$JQ_SHAPE_SAFE_WALK"'
    shape_safe_walk(if type == "string" and length > 0
                    then "[REDACTED]" else . end)
  ' 2>/dev/null
}

# jq has implementation-dependent nesting limits, so a valid response can pass
# hook validation and still fail the recursive whole-leaf walk. Parse its
# compact jq serialization iteratively with POSIX awk. Output stays in a
# private temporary file until the complete single document is validated, so a
# malformed or interrupted transform can never expose a partial replacement.
#
# Callers own whole_leaf_response. Read that inherited shell variable inside
# their command substitution instead of expanding a large JSON value through
# another function argument and assignment.
redact_response_values_awk_current() {
  whole_leaf_tmp=$(mktemp_file) || return 1
  case "$whole_leaf_response" in
    *'"'*) ;;
    *)
      if printf '%s' "$whole_leaf_response" | LC_ALL=C awk '
        BEGIN { RS = ","; ORS = "" }
        function json_fail() { failed = 1; exit 1 }
        function scan_structure(value,    clean, skeleton, residue, i, ch) {
          clean = value
          gsub(/[ \t\r\n]/, "", clean)
          if (clean == "") json_fail()
          residue = clean
          gsub(/-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/, "", residue)
          gsub(/true|false|null/, "", residue)
          gsub(/[\[\]{}]/, "", residue)
          if (residue != "") json_fail()
          skeleton = clean
          gsub(/[^][{}]+/, "", skeleton)
          if (skeleton == "" && depth == 0) {
            if (NR != 1 || root_seen \
                || clean !~ /^(-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?|true|false|null)$/) json_fail()
            root_seen = 1
            root_closed = 1
            return
          }
          for (i = 1; i <= length(skeleton); i++) {
            ch = substr(skeleton, i, 1)
            if (ch == "[" || ch == "{") {
              if (depth == 0 && root_seen) json_fail()
              root_seen = 1
              depth++
              container[depth] = ch
            } else {
              if (depth == 0) json_fail()
              if ((ch == "]" && container[depth] != "[") \
                  || (ch == "}" && container[depth] != "{")) json_fail()
              delete container[depth]
              depth--
              if (depth == 0) root_closed = 1
            }
          }
          if (root_closed && depth == 0 \
              && clean !~ /[}\]]$/ && NR > 1) json_fail()
        }
        {
          # Compact scalar records inside an open container need no structural
          # rescanning or repeated substitutions. Bracket-bearing records still
          # pass through the complete structure checks below.
          if (depth > 0 && ($0 == "true" || $0 == "false" || $0 == "null" \
              || $0 ~ /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$/)) {
            if (NR > 1) printf ","
            if ($0 == "null" || $0 == "false") printf "%s", $0
            else if ($0 == "true") printf "false"
            else printf "0"
            next
          }
          scan_structure($0)
          if (NR > 1) printf ","
          transformed = $0
          gsub(/-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/, "0", transformed)
          gsub(/true/, "false", transformed)
          printf "%s", transformed
        }
        END {
          if (NR == 0 || failed || depth != 0 || !root_seen) exit 1
        }
      ' >"$whole_leaf_tmp" 2>/dev/null; then
        cat "$whole_leaf_tmp"
        whole_leaf_status=$?
      else
        whole_leaf_status=$?
      fi
      rm -f "$whole_leaf_tmp"
      return "$whole_leaf_status"
      ;;
  esac
  if printf '%s' "$whole_leaf_response" | LC_ALL=C awk '
    function json_fail() {
      failed = 1
      exit 1
    }
    function emit(value) {
      printf "%s", value
    }
    function append_candidate(value) {
      if (!candidate_valid) return
      candidate = candidate value
      if (length(candidate) > 32) candidate_valid = 0
    }
    function hex_value(ch) {
      if (ch >= "0" && ch <= "9") return ch + 0
      if (ch >= "a" && ch <= "f") return 10 + index("abcdef", ch) - 1
      if (ch >= "A" && ch <= "F") return 10 + index("ABCDEF", ch) - 1
      return -1
    }
    function read_string(pos,    i, ch, esc, j, digit, code) {
      candidate = ""
      candidate_valid = 1
      i = pos + 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == "\"") {
          token_end = i
          token_raw = substr(document, pos, i - pos + 1)
          return
        }
        if (ch == "\\") {
          i++
          if (i > document_length) json_fail()
          esc = substr(document, i, 1)
          if (esc == "u") {
            if (i + 4 > document_length) json_fail()
            code = 0
            for (j = 1; j <= 4; j++) {
              digit = hex_value(substr(document, i + j, 1))
              if (digit < 0) json_fail()
              code = code * 16 + digit
            }
            if (code >= 32 && code <= 126) append_candidate(sprintf("%c", code))
            else candidate_valid = 0
            i += 5
            continue
          }
          if (index("\"\\/bfnrt", esc) == 0) json_fail()
          if (esc == "/") append_candidate("/")
          else if (esc == "\"") append_candidate("\"")
          else if (esc == "\\") append_candidate("\\")
          else candidate_valid = 0
          i++
          continue
        }
        if (ch ~ /[[:cntrl:]]/) json_fail()
        if (ch ~ /^[ -~]$/) append_candidate(ch)
        else candidate_valid = 0
        i++
      }
      json_fail()
    }
    function protocol_discriminator(key, value) {
      if (!(key == "type" || key == "media_type" || key == "mimeType" || key == "mediaType" \
            || key == "encoding" || key == "mode" || key == "cell_type")) return 0
      return value == "text" || value == "image" || value == "document" \
        || value == "search_result" || value == "browser_state" \
        || value == "tool_reference" || value == "tool_use" \
        || value == "tool_result" || value == "thinking" \
        || value == "redacted_thinking" || value == "base64" \
        || value == "url" || value == "file" || value == "content" \
        || value == "pdf" || value == "image/png" \
        || value == "image/jpeg" || value == "image/gif" \
        || value == "image/webp" || value == "application/pdf" \
        || value == "text/plain" || value == "notebook" || value == "parts" \
        || value == "file_unchanged" || value == "create" || value == "update" \
        || value == "files_with_matches" || value == "count" \
        || value == "code" || value == "markdown"
    }
    function accept_value() {
      if (depth == 0) {
        if (root_done) json_fail()
        root_done = 1
      } else if (container[depth] == "object") {
        if (state[depth] != "value") json_fail()
        state[depth] = "comma_or_end"
      } else {
        if (!(state[depth] == "value_or_end" || state[depth] == "value")) json_fail()
        state[depth] = "comma_or_end"
      }
    }
    function read_number(pos,    i, ch, window, next_ch) {
      window = substr(document, pos, 128)
      if (match(window, /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/)) {
        next_ch = substr(document, pos + RLENGTH, 1)
        if (RLENGTH < 128 || next_ch !~ /^[0-9.eE+-]$/) {
          token_end = pos + RLENGTH - 1
          return
        }
      }
      i = pos
      if (substr(document, i, 1) == "-") i++
      if (i > document_length) json_fail()
      ch = substr(document, i, 1)
      if (ch == "0") {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/) json_fail()
      } else if (ch ~ /^[1-9]$/) {
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      } else json_fail()
      if (i <= document_length && substr(document, i, 1) == ".") {
        i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      if (i <= document_length && substr(document, i, 1) ~ /^[eE]$/) {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[+-]$/) i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      token_end = i - 1
    }
    function parse_document(    i, ch, direct_key, literal) {
      document_length = length(document)
      if (document_length == 0) json_fail()
      i = 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
          i++
          continue
        }
        if (ch == "{") {
          accept_value()
          emit(ch)
          depth++
          container[depth] = "object"
          state[depth] = "key_or_end"
          i++
          continue
        }
        if (ch == "[") {
          accept_value()
          emit(ch)
          depth++
          container[depth] = "array"
          state[depth] = "value_or_end"
          i++
          continue
        }
        if (ch == "}") {
          if (depth == 0 || container[depth] != "object" || !(state[depth] == "key_or_end" || state[depth] == "comma_or_end")) json_fail()
          emit(ch)
          delete container[depth]
          delete state[depth]
          delete object_key[depth]
          depth--
          i++
          continue
        }
        if (ch == "]") {
          if (depth == 0 || container[depth] != "array" || !(state[depth] == "value_or_end" || state[depth] == "comma_or_end")) json_fail()
          emit(ch)
          delete container[depth]
          delete state[depth]
          depth--
          i++
          continue
        }
        if (ch == ":") {
          if (depth == 0 || container[depth] != "object" || state[depth] != "colon") json_fail()
          emit(ch)
          state[depth] = "value"
          i++
          continue
        }
        if (ch == ",") {
          if (depth == 0 || state[depth] != "comma_or_end") json_fail()
          emit(ch)
          if (container[depth] == "object") state[depth] = "key"
          else state[depth] = "value"
          i++
          continue
        }
        if (ch == "\"") {
          read_string(i)
          if (depth > 0 && container[depth] == "object" && (state[depth] == "key_or_end" || state[depth] == "key")) {
            emit(token_raw)
            if (candidate_valid) object_key[depth] = candidate
            else object_key[depth] = ""
            state[depth] = "colon"
          } else {
            direct_key = ""
            if (depth > 0 && container[depth] == "object" && state[depth] == "value") direct_key = object_key[depth]
            accept_value()
            if (token_raw == "\"\"" || (candidate_valid && protocol_discriminator(direct_key, candidate))) emit(token_raw)
            else emit("\"[REDACTED]\"")
          }
          i = token_end + 1
          continue
        }
        if (ch == "t" && substr(document, i, 4) == "true") {
          literal = "true"
        } else if (ch == "f" && substr(document, i, 5) == "false") {
          literal = "false"
        } else if (ch == "n" && substr(document, i, 4) == "null") {
          literal = "null"
        } else literal = ""
        if (literal != "") {
          accept_value()
          if (literal == "true") emit("false")
          else emit(literal)
          i += length(literal)
          continue
        }
        if (ch == "-" || ch ~ /^[0-9]$/) {
          read_number(i)
          accept_value()
          emit("0")
          i = token_end + 1
          continue
        }
        json_fail()
      }
      if (depth != 0 || !root_done) json_fail()
    }
    {
      if (NR > 1) document = document "\n"
      document = document $0
    }
    END {
      if (failed) exit 1
      parse_document()
    }
  ' >"$whole_leaf_tmp" 2>/dev/null; then
    cat "$whole_leaf_tmp"
    whole_leaf_status=$?
  else
    whole_leaf_status=$?
  fi
  rm -f "$whole_leaf_tmp"
  return "$whole_leaf_status"
}

# jq can reject a valid host envelope at implementation-specific nesting
# limits. Independently validate one complete top-level object and extract its
# unique tool_response value without recursion. Nothing reaches stdout until
# the full envelope has been accepted.
extract_post_tool_response_awk() {
  envelope=$1
  response_tmp=$(mktemp_file) || return 1
  if printf '%s' "$envelope" | LC_ALL=C awk '
    function json_fail() {
      failed = 1
      exit 1
    }
    function append_candidate(value) {
      if (!candidate_valid) return
      candidate = candidate value
      if (length(candidate) > 64) candidate_valid = 0
    }
    function hex_value(ch) {
      if (ch >= "0" && ch <= "9") return ch + 0
      if (ch >= "a" && ch <= "f") return 10 + index("abcdef", ch) - 1
      if (ch >= "A" && ch <= "F") return 10 + index("ABCDEF", ch) - 1
      return -1
    }
    function read_string(pos,    i, ch, esc, j, digit, code) {
      candidate = ""
      candidate_valid = 1
      i = pos + 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == "\"") {
          token_end = i
          return
        }
        if (ch == "\\") {
          i++
          if (i > document_length) json_fail()
          esc = substr(document, i, 1)
          if (esc == "u") {
            if (i + 4 > document_length) json_fail()
            code = 0
            for (j = 1; j <= 4; j++) {
              digit = hex_value(substr(document, i + j, 1))
              if (digit < 0) json_fail()
              code = code * 16 + digit
            }
            if (code >= 32 && code <= 126) append_candidate(sprintf("%c", code))
            else candidate_valid = 0
            i += 5
            continue
          }
          if (index("\"\\/bfnrt", esc) == 0) json_fail()
          if (esc == "/") append_candidate("/")
          else if (esc == "\"") append_candidate("\"")
          else if (esc == "\\") append_candidate("\\")
          else candidate_valid = 0
          i++
          continue
        }
        if (ch ~ /[[:cntrl:]]/) json_fail()
        if (ch ~ /^[ -~]$/) append_candidate(ch)
        else candidate_valid = 0
        i++
      }
      json_fail()
    }
    function read_number(pos,    i, ch) {
      i = pos
      if (substr(document, i, 1) == "-") i++
      if (i > document_length) json_fail()
      ch = substr(document, i, 1)
      if (ch == "0") {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/) json_fail()
      } else if (ch ~ /^[1-9]$/) {
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      } else json_fail()
      if (i <= document_length && substr(document, i, 1) == ".") {
        i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      if (i <= document_length && substr(document, i, 1) ~ /^[eE]$/) {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[+-]$/) i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      token_end = i - 1
    }
    function is_response_value() {
      return depth == 1 && container[depth] == "object" \
        && state[depth] == "value" && object_key[depth] == "tool_response"
    }
    function begin_value(pos, is_container,    target) {
      target = is_response_value()
      if (depth == 0) {
        if (root_done) json_fail()
        root_done = 1
      } else if (container[depth] == "object") {
        if (state[depth] != "value") json_fail()
        state[depth] = "comma_or_end"
      } else {
        if (!(state[depth] == "value_or_end" || state[depth] == "value")) json_fail()
        state[depth] = "comma_or_end"
      }
      if (target) {
        if (response_found) json_fail()
        response_found = 1
        response_start = pos
        if (is_container) response_depth = depth + 1
      }
      return target
    }
    function parse_document(    i, ch, literal, target) {
      document_length = length(document)
      if (document_length == 0) json_fail()
      i = 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
          i++
          continue
        }
        if (ch == "{") {
          if (depth == 0) root_kind = "object"
          begin_value(i, 1)
          depth++
          container[depth] = "object"
          state[depth] = "key_or_end"
          i++
          continue
        }
        if (ch == "[") {
          if (depth == 0) root_kind = "array"
          begin_value(i, 1)
          depth++
          container[depth] = "array"
          state[depth] = "value_or_end"
          i++
          continue
        }
        if (ch == "}") {
          if (depth == 0 || container[depth] != "object" \
              || !(state[depth] == "key_or_end" || state[depth] == "comma_or_end")) json_fail()
          if (response_depth == depth) {
            response_end = i
            response_depth = 0
          }
          delete container[depth]
          delete state[depth]
          delete object_key[depth]
          depth--
          i++
          continue
        }
        if (ch == "]") {
          if (depth == 0 || container[depth] != "array" \
              || !(state[depth] == "value_or_end" || state[depth] == "comma_or_end")) json_fail()
          if (response_depth == depth) {
            response_end = i
            response_depth = 0
          }
          delete container[depth]
          delete state[depth]
          depth--
          i++
          continue
        }
        if (ch == ":") {
          if (depth == 0 || container[depth] != "object" || state[depth] != "colon") json_fail()
          state[depth] = "value"
          i++
          continue
        }
        if (ch == ",") {
          if (depth == 0 || state[depth] != "comma_or_end") json_fail()
          if (container[depth] == "object") state[depth] = "key"
          else state[depth] = "value"
          i++
          continue
        }
        if (ch == "\"") {
          read_string(i)
          if (depth > 0 && container[depth] == "object" \
              && (state[depth] == "key_or_end" || state[depth] == "key")) {
            if (candidate_valid) object_key[depth] = candidate
            else object_key[depth] = ""
            state[depth] = "colon"
          } else {
            target = begin_value(i, 0)
            if (target) response_end = token_end
            if (depth == 0) root_kind = "scalar"
          }
          i = token_end + 1
          continue
        }
        if (ch == "t" && substr(document, i, 4) == "true") {
          literal = "true"
        } else if (ch == "f" && substr(document, i, 5) == "false") {
          literal = "false"
        } else if (ch == "n" && substr(document, i, 4) == "null") {
          literal = "null"
        } else literal = ""
        if (literal != "") {
          target = begin_value(i, 0)
          if (target) response_end = i + length(literal) - 1
          if (depth == 0) root_kind = "scalar"
          i += length(literal)
          continue
        }
        if (ch == "-" || ch ~ /^[0-9]$/) {
          read_number(i)
          target = begin_value(i, 0)
          if (target) response_end = token_end
          if (depth == 0) root_kind = "scalar"
          i = token_end + 1
          continue
        }
        json_fail()
      }
      if (depth != 0 || !root_done || root_kind != "object" \
          || !response_found || response_depth != 0 || response_end < response_start) json_fail()
      printf "%s", substr(document, response_start, response_end - response_start + 1)
    }
    {
      if (NR > 1) document = document "\n"
      document = document $0
    }
    END {
      if (failed) exit 1
      parse_document()
    }
  ' >"$response_tmp" 2>/dev/null; then
    cat "$response_tmp"
    response_status=$?
  else
    response_status=$?
  fi
  rm -f "$response_tmp"
  return "$response_status"
}

redact_response_whole_leaf_fail_closed() {
  # rewrite_response_conservatively sets whole_leaf_response before forking this
  # command substitution; all transformations below keep their private output.
  whole_leaf_redacted=
  # A quote-free compact JSON value contains no strings. The primary string
  # transform would return it unchanged and then enter the same value fallback.
  # Avoid copying a large numeric array through that known identity transform.
  case "$whole_leaf_response" in
    *'"'*)
      if ! whole_leaf_redacted=$(redact_nonempty_response_strings "$whole_leaf_response"); then
        whole_leaf_redacted=
      fi
      ;;
  esac
  if [ -z "$whole_leaf_redacted" ] \
      || [ "$whole_leaf_redacted" = "$whole_leaf_response" ]; then
    whole_leaf_redacted=
    if ! whole_leaf_redacted=$(redact_response_values_awk_current); then
      whole_leaf_redacted=
    fi
  fi
  if [ -n "$whole_leaf_redacted" ] \
    && [ "$whole_leaf_redacted" != "$whole_leaf_response" ]; then
    printf '%s' "$whole_leaf_redacted"
    return 0
  fi
  return 1
}

rewrite_response_conservatively() {
  whole_leaf_response=$1
  rewrite_current_response_conservatively
}

rewrite_current_response_conservatively() {
  SAFE_REWRITE=
  if ! SAFE_REWRITE=$(redact_response_whole_leaf_fail_closed); then
    SAFE_REWRITE=
  fi
  if [ -z "$SAFE_REWRITE" ]; then
    # Some jq printers exit successfully after truncating deep JSON to a
    # non-JSON marker. The intermediate response then cannot be repaired.
    # Recover from the retained hook envelope, not the damaged serialization.
    # Recovery emits the complete host response; stop to avoid a second one.
    if recover_post_tool_validation_failure "${HOOK_INPUT:-}"; then
      exit 0
    fi
    block_failed_output_rewrite
  fi
}

emit_secret_free_post_tool_replacement() {
  audit_clear_live_probe_marker
  case "$(hook_host)" in
    codex)
      printf '%s\n' '{"decision":"block","reason":"Agent Guard blocked the original tool output because a sanitized replacement could not be serialized.","hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"Agent Guard blocked a sensitive tool output; the sanitized replacement could not be serialized safely."}}'
      ;;
    *)
      # Claude Code drops a replacement that does not match a built-in tool's
      # output shape and gives the model the original, so a bare string hides
      # nothing there. Each tool below gets a fixed object in the shape Claude
      # Code 2.1.330 returns for it; a field the host reads as one of a few
      # words keeps a valid one. The host was seen to accept the Bash, REPL
      # and Poll shapes. The others follow recorded results and are not yet
      # confirmed on a live host; a shape it rejects fares no worse than the
      # string. A tool with no recorded result keeps the string. The envelope
      # may be what failed to parse, so the compact field backs up jq.
      esf_tool=
      if command -v jq >/dev/null 2>&1; then
        esf_tool=$({ printf '%s' "${HOOK_INPUT:-}"; } 2>/dev/null \
          | jq -r '.tool_name // empty' 2>/dev/null) || esf_tool=
      fi
      if [ -z "$esf_tool" ]; then
        for esf_name in REPL Poll Bash Read Write Edit NotebookEdit Grep Glob Skill Monitor; do
          case "${HOOK_INPUT:-}" in
            *"\"tool_name\":\"$esf_name\""*) esf_tool=$esf_name; break ;;
          esac
        done
      fi
      case "$esf_tool" in
        REPL) esf_shape='{"code":"[REDACTED]","result":"[REDACTED]","stdout":"[REDACTED]","stderr":"[REDACTED]"}' ;;
        Poll) esf_shape='{"content":"[REDACTED]","eventCount":0,"remainingWakeCount":0,"provenance":[]}' ;;
        Bash) esf_shape='{"stdout":"[REDACTED]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}' ;;
        Read) esf_shape='{"type":"text","file":{"filePath":"[REDACTED]","content":"[REDACTED]","numLines":1,"startLine":1,"totalLines":1}}' ;;
        Write) esf_shape='{"type":"create","filePath":"[REDACTED]","content":"[REDACTED]","structuredPatch":[],"originalFile":null,"userModified":false}' ;;
        Edit) esf_shape='{"filePath":"[REDACTED]","oldString":"[REDACTED]","newString":"[REDACTED]","originalFile":null,"structuredPatch":[],"userModified":false,"replaceAll":false}' ;;
        NotebookEdit) esf_shape='{"new_source":"[REDACTED]","old_source":"[REDACTED]","cell_type":"code","language":"python","edit_mode":"replace","cell_id":"[REDACTED]","error":"","notebook_path":"[REDACTED]","original_file":"[REDACTED]","updated_file":"[REDACTED]"}' ;;
        Grep) esf_shape='{"mode":"content","numFiles":0,"filenames":[],"content":"[REDACTED]","numLines":0,"totalLines":0}' ;;
        Glob) esf_shape='{"filenames":[],"durationMs":0,"numFiles":0,"truncated":false,"totalMatches":0,"countIsComplete":true}' ;;
        Skill) esf_shape='{"success":true,"commandName":"[REDACTED]"}' ;;
        Monitor) esf_shape='{"taskId":"[REDACTED]","timeoutMs":0,"persistent":false}' ;;
        *) esf_shape='"[REDACTED]"' ;;
      esac
      # Only the Bash, REPL and Poll objects are known to pass the host check.
      case "$esf_tool" in
        Bash|REPL|Poll|mcp__*) ;;
        *) POST_TOOL_SHAPE_KEPT=0 ;;
      esac
      printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","updatedToolOutput":%s}}\n' "$esf_shape"
      ;;
  esac
}

block_failed_output_rewrite() {
  audit_note error
  info "$PROGRAM: the tool output could not be serialized into a safe host replacement even with the conservative fallback"
  emit_secret_free_post_tool_replacement
  exit 0
}

emit_post_tool_replacement() {
  replacement=$1
  case "$(hook_host)" in
    codex)
      # Keep the potentially large updated output on stdin. Linux limits one
      # exec argument to roughly 128 KiB, so `--argjson ut "$replacement"`
      # can fail after a successful conservative whole-leaf rewrite. Capture
      # the complete envelope before printing so a jq failure cannot append a
      # fixed response after a partial JSON document.
      codex_envelope=
      if codex_envelope=$(printf '%s' "$replacement" \
        | jq -c '
            {decision: "block",
             reason: "Agent Guard blocked the original tool output because it contained sensitive values; use the sanitized replacement in additionalContext.",
             hookSpecificOutput: {
               hookEventName: "PostToolUse",
               additionalContext: ("Agent Guard sanitized tool output:\n" + (. | tojson))
             }}' 2>/dev/null); then
        printf '%s\n' "$codex_envelope"
      else
        emit_secret_free_post_tool_replacement
      fi
      ;;
    *)
      claude_post_tool_shape
      printf '%s' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","updatedToolOutput":'
      printf '%s' "$replacement"
      printf '%s\n' '}}'
      ;;
  esac
}

# Claude Code checks a built-in tool's replacement against that tool's output
# schema and, on a mismatch, gives the model the original output (#612). For
# the built-in tools whose output carries a host-checked field or the path the
# model asked for, put back a path equal to the one in tool_input (the model
# wrote it, so it reveals nothing new) and record in POST_TOOL_SHAPE_KEPT
# whether the replacement keeps every key, every value type and every field
# the walk above leaves as a protocol word. Callers then do not report masking
# that the host would throw away. Other tools, and a check jq cannot run, leave
# the replacement as it is and the flag empty. Reads and may set the caller's
# replacement.
claude_post_tool_shape() {
  POST_TOOL_SHAPE_KEPT=
  cps_tool=${tool:-}
  if [ -z "$cps_tool" ]; then
    for cps_name in Read Write Edit MultiEdit NotebookEdit Grep; do
      case "${HOOK_INPUT:-}" in
        *"\"tool_name\":\"$cps_name\""*|*"\"tool_name\": \"$cps_name\""*)
          cps_tool=$cps_name; break ;;
      esac
    done
  fi
  case "$cps_tool" in
    Read|Write|Edit|MultiEdit|NotebookEdit|Grep) ;;
    *) return 0 ;;
  esac
  cps_out=
  cps_out=$({ printf '%s\n' "${HOOK_INPUT:-}"; printf '%s\n' "$replacement"; } 2>/dev/null \
    | jq -rsc '
        def kinds: if type == "object" then with_entries(.value |= kinds)
          elif type == "array" then map(kinds) else type end;
        def at($p): try getpath($p) catch null;
        def word_key: . as $k
          | ["type","media_type","mimeType","mediaType","encoding","mode",
             "cell_type"] | index([$k]) != null;
        if length != 2 then error("two documents expected") else . end
        | .[1] as $replacement
        | .[0].tool_response as $orig
        | ([.[0].tool_input | objects | .file_path, .notebook_path
            | strings | select(length > 0)]) as $own
        | (reduce ($orig | paths(type == "string")) as $p ($replacement;
             if ($p[-1] == "filePath" or $p[-1] == "notebook_path")
                and ($own | index([$orig | getpath($p)])) != null
                and (at($p) | type) == "string"
             then setpath($p; $orig | getpath($p)) else . end)) as $new
        | (($new | kinds) == ($orig | kinds)
           and all($orig | paths(type == "string");
                   . as $p | ($p[-1] | type) == "string" and ($p[-1] | word_key)
                   | not or ($new | at($p)) == ($orig | getpath($p))))
        | (if . then "k" else "c" end)
          + (if $new == $replacement then "" else ($new | tojson) end)
      ' 2>/dev/null) || cps_out=
  case "$cps_out" in
    k*) POST_TOOL_SHAPE_KEPT=1 ;;
    c*) POST_TOOL_SHAPE_KEPT=0 ;;
    *) cps_out= ;;
  esac
  # Only a restored path takes jq's serialization, and only once it parses:
  # some jq builds print deep JSON truncated to a marker and still exit 0.
  cps_out=${cps_out#?}
  if [ -n "$cps_out" ] && { printf '%s' "$cps_out"; } 2>/dev/null \
      | jq -e 'true' >/dev/null 2>&1; then
    replacement=$cps_out
  fi
  cps_out=
}

# PostToolUse runs after the tool, so the closed policy's exit 2 only shows its
# reason: the output that could not be checked still reaches the model. Before
# that exit, replace every non-empty string in the response and keep its shape.
# Claude Code applies a replacement printed beside exit 2 (verified on 2.1.330
# for Bash, REPL and Poll). jq does the rewrite when it works and the
# independent awk parser otherwise, so a missing scanner or jq does not stop
# it; image and PDF bytes pass as they do through the output rewriter. Every
# caller runs in the hook's own shell, so the emitted flag is enough to keep
# stdout to one object. Codex takes no replacement and is left as it was.
withhold_post_tool_output() {
  [ "${HOOK_EVENT:-}" = PostToolUse ] || return 0
  [ "$(hook_host)" != codex ] || return 0
  [ "${REDACT_OUTPUT_EMITTED:-0}" = 0 ] && [ "$INFRA_FAILURE_NOTICE_EMITTED" = 0 ] || return 0
  [ -n "${HOOK_INPUT:-}" ] || return 0
  # The switches that turn the output rewrite off turn this off too.
  output_redact_enabled || [ "${AGENT_GUARD_PII_HOOK_MODE:-off}" = mask ] || return 0
  wpo_response=
  wpo_response=$(extract_post_tool_response_awk "$HOOK_INPUT") || wpo_response=
  case "$wpo_response" in
    '')
      # A readable envelope with no response has no output to withhold.
      if command -v jq >/dev/null 2>&1 \
          && { printf '%s' "$HOOK_INPUT"; } 2>/dev/null \
            | jq -e 'type == "object" and (has("tool_response") | not)' >/dev/null 2>&1; then
        return 0
      fi
      ;;
    null) return 0 ;;
  esac
  wpo_out=
  if [ -n "$wpo_response" ]; then
    if command -v jq >/dev/null 2>&1; then
      wpo_out=$({ printf '%s' "$wpo_response"; } 2>/dev/null \
        | jq -c "$JQ_SHAPE_SAFE_WALK"'
          . as $orig | strip_binary_payloads
          | shape_safe_walk(if type == "string" and length > 0
                            then "[REDACTED]" else . end)
          | restore_binary_payloads($orig)
        ' 2>/dev/null) || wpo_out=
    fi
    if [ -z "$wpo_out" ]; then
      whole_leaf_response=$wpo_response
      wpo_out=$(redact_response_values_awk_current) || wpo_out=
    fi
  fi
  if [ -n "$wpo_out" ]; then
    emit_post_tool_replacement "$wpo_out"
  else
    emit_secret_free_post_tool_replacement
  fi
  REDACT_OUTPUT_EMITTED=1
  if [ "${POST_TOOL_SHAPE_KEPT:-}" = 0 ]; then
    info "$PROGRAM: tried to withhold the tool output because it could not be checked for secret-like values, but the replacement changes a field the host checks; the host may reject it and pass the original output unchanged"
  else
    info "$PROGRAM: withheld the tool output because it could not be checked for secret-like values"
  fi
}

recover_post_tool_validation_failure() {
  recovery_input=$1
  recovery_response=
  if ! recovery_response=$(extract_post_tool_response_awk "$recovery_input"); then
    recovery_response=
    return 1
  fi

  # Primary JSON processing failed, so no scanner-dependent verdict is trustworthy.
  # Conservatively sanitize the entire response with the independent parser.
  recovery_output=
  if ! recovery_output=$(whole_leaf_response=$recovery_response; redact_response_values_awk_current); then
    recovery_output=
  fi
  if [ -z "$recovery_output" ]; then
    block_failed_output_rewrite
  fi

  audit_note masked
  emit_post_tool_replacement "$recovery_output"
  info "$PROGRAM: replaced the complete tool output after the primary PostToolUse JSON processing failed"
  return 0
}

# Mask PII inside ANY string leaf of the tool_response JSON ($1), preserving the
# original shape. The regex patterns mirror pii_regex_adapter_filter (the CLI
# adapter) so the hook and `agent-guard pii-filter` mask the same things; Tier-2
# (credit card / KR resident reg. no. / SSN) is masked first so a Tier-1 pattern
# can't shadow it, and KR mobile before the generic phone pattern. Oniguruma
# lookaround stands in for the digit boundaries mask_re() checks by hand in awk,
# and the Luhn filter for cards is the same rule expressed as a conditional
# gsub replacement — both must change with PII_AWK_LIB. Like the
# secret redactor, this masks string VALUES only — object KEYS are left as-is
# (masking keys risks collapsing distinct keys onto one placeholder); PII in a
# JSON key is a documented limitation (README). Prints the masked JSON, or
# nothing on failure (e.g. a jq build without Oniguruma gsub, or one whose
# Oniguruma lacks the lookbehind the boundaries need) — the caller then leaves
# the response unmasked. Only masking degrades that way: the input hard-block
# gate is the awk path, which needs no regex features beyond POSIX ERE.
mask_pii_response_json() {
  resp=$1
  trusted=${2:-[]}
  pii_skip_set
  printf '%s' "$resp" \
    | jq -c --arg pii_skip "$PII_SKIP" --argjson trusted "$trusted" "$JQ_WALK"'
    def keep($type): ($pii_skip | contains(",\($type),")) | not;
    def luhn:
      ([gsub("[^0-9]"; "") | explode | .[] | . - 48] | reverse
       | to_entries
       | map(if .key % 2 == 1
             then (.value * 2 | if . > 9 then . - 9 else . end)
             else .value end)
       | add) as $sum
      | $sum != null and $sum % 10 == 0;
    def mask_card($re): gsub($re;
      if (.pan | luhn) then "[PII:CREDIT_CARD]" else .pan end);
    def mask_pii:
      mask_card("(?<![0-9])(?<pan>[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{3})(?![0-9])")
      | mask_card("(?<![0-9])(?<pan>[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4})(?![0-9])")
      | mask_card("(?<![0-9])(?<pan>3[47][0-9]{2}[ -]?[0-9]{6}[ -]?[0-9]{5})(?![0-9])")
      | gsub("(?<![0-9])[0-9]{6}-[0-9]{7}(?![0-9])"; "[PII:KR_RRN]")
      | gsub("(?<![0-9])[0-9]{3}-[0-9]{2}-[0-9]{4}(?![0-9])"; "[PII:SSN]")
      | (if keep("IP_ADDRESS")
         then gsub("(?<![0-9])(?<![0-9]\\.)(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}(?![0-9])(?!\\.[0-9])"; "[PII:IP_ADDRESS]")
         else . end)
      | (if keep("EMAIL")
         then gsub("[A-Za-z0-9_%+.-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"; "[PII:EMAIL]")
         else . end)
      | (if keep("PHONE")
         then gsub("(?<![0-9])01[0-9][ -]?[0-9]{4}[ -]?[0-9]{4}(?![0-9])"; "[PII:PHONE]")
           | gsub("(?<![0-9])(\\+?[0-9][ .-]?)?(\\([0-9]{3}\\)|[0-9]{3})[ .-]?[0-9]{3}[ .-]?[0-9]{4}(?![0-9])"; "[PII:PHONE]")
         else . end);
    walk(if type == "string"
         then . as $value
              | if ($trusted | index($value)) == null then mask_pii else . end
         else . end)
  ' 2>/dev/null
}

# Masked view of a protected file: keys, comments and structure stay, every
# value becomes [MASKED]. The format comes from the resolved file name alone
# (content sniffing cannot tell `K: v` yaml from `K=v` dotenv apart), and the
# content must then parse as that format's supported subset or there is no
# view at all. The engine never decides to block; callers do on non-zero.
MASK_FILE_MAX_BYTES=65536

# Shared by the line-oriented formats. mode=paths prints the key path of each
# masked value instead of the view. mode=reveal shows the value numbered N
# between show_open and show_close when want_file lists "N<TAB>path" with this
# read's key path and that path is unambiguous (`amb` unset). mode=values
# (dotenv only) prints each value the format program left in `val`, one per
# line, and drops a trailing CR first; it is for known_env_values only.
MASK_FILE_AWK_LIB='
mode == "values" { sub(/\r$/, "") }
function emit_line(s) { if (mode != "paths" && mode != "values") print s }
function emit_masked(prefix, path, amb) {
  nv++
  if (mode == "values") print val
  else if (mode == "paths") print path
  else if (mode == "reveal" && !amb && (nv in want) && want[nv] == path)
    print prefix show_open substr($0, length(prefix) + 1) show_close
  else print prefix marker
}
# Index of the quote closing the one that opens s, or 0. Double quotes take
# backslash escapes; with dbl set a doubled single quote is an escape (yaml).
function quoted_end(s, q,   i, n, c) {
  n = length(s)
  for (i = 2; i <= n; i++) {
    c = substr(s, i, 1)
    if (q == "\"" && c == "\\") { i++; continue }
    if (c != q) continue
    if (dbl && q == sq && substr(s, i + 1, 1) == sq) { i++; continue }
    return i
  }
  return 0
}
BEGIN {
  sq = sprintf("%c", 39)
  if (mode == "reveal")
    while ((getline w < want_file) > 0) want[substr(w, 1, index(w, "\t") - 1)] = substr(w, index(w, "\t") + 1)
}
'

# An inline comment after a value is masked with it: telling a `#` inside an
# unquoted value from a comment is exactly the guess this must not make.
MASK_FILE_AWK_DOTENV='
/^[ \t]*$/ || /^[ \t]*#/ { emit_line($0); next }
{
  if (!match($0, /^[ \t]*(export[ \t]+)?[A-Za-z_][A-Za-z0-9_.]*[ \t]*=[ \t]*/)) exit 1
  prefix = substr($0, 1, RLENGTH)
  value = substr($0, RLENGTH + 1)
  if (value == "") { emit_line($0); next }
  # A sourcing shell can read the following lines as data, even ones that
  # look like comments and would print unmasked: after a trailing backslash,
  # a heredoc, or a quote, backtick, $( ${ $[ or ( left open. Inside any other
  # construct a blank-# line is a comment to the shell too. In an unquoted
  # value a blank-# starts a comment only when no backslash precedes it, so
  # the part before it is checked whole.
  if (value ~ /\\$/) exit 1
  c = substr(value, 1, 1)
  if (c == "\"" || c == sq) {
    e = quoted_end(value, c)
    if (!e || substr(value, e + 1) !~ /^([ \t]*|[ \t]+#.*)$/) exit 1
    word = c == sq ? "" : substr(value, 1, e)
    val = substr(value, 2, e - 2)
  } else {
    word = value
    if (match(word, /[ \t]#/)) word = substr(word, 1, RSTART - 1)
    if (word ~ /["\\(<]/ || index(word, sq)) exit 1
    val = word
    sub(/[ \t]+$/, "", val)
  }
  if (index(word, "`") || index(word, "$(") || index(word, "${") || index(word, "$[")) exit 1
  key = prefix
  sub(/^[ \t]*/, "", key)
  sub(/^export[ \t]+/, "", key)
  sub(/[ \t]*=[ \t]*$/, "", key)
  emit_masked(prefix, key, index(key, "."))
}
'

# Any indented line fails: in configparser it continues the previous value.
MASK_FILE_AWK_INI='
/^[ \t]*$/ { emit_line($0); next }
/^[ \t]/ { exit 1 }
/^[;#]/ { emit_line($0); next }
/^\[/ {
  h = $0
  sub(/[ \t]+$/, "", h)
  if (substr(h, length(h), 1) != "]") exit 1
  section = substr(h, 2, length(h) - 2)
  if (section == "" || index(section, "[") || index(section, "]")) exit 1
  emit_line($0)
  next
}
{
  eq = index($0, "=")
  if (eq < 2) exit 1
  key = substr($0, 1, eq - 1)
  sub(/[ \t]+$/, "", key)
  # configparser (.pypirc, .aws, most *.cfg) also splits at ":", so there a
  # key with ":" means part of it is really the value. npm splits at "=" only.
  if (!colon_keys && index(key, ":")) exit 1
  rest = substr($0, eq + 1)
  match(rest, /^[ \t]*/)
  if (substr(rest, RLENGTH + 1) == "") { emit_line($0); next }
  # Some ini readers continue a value ending in a backslash.
  if (rest ~ /\\$/) exit 1
  emit_masked(substr($0, 1, eq + RLENGTH), section == "" ? key : section "." key, index(section key, "."))
}
'

# Block-style yaml only, judged line by line against a stack of open
# containers (column, map or seq, key path). Anything that can pull a value in
# from elsewhere or spread one over several lines (anchors, aliases, tags,
# block and flow collections, multi-line scalars, more than one document) exits,
# because a line-wise rewrite cannot then vouch that every value was masked.
MASK_FILE_AWK_YAML='
BEGIN { dbl = 1 }
function join(a, b) { return a == "" ? b : a "." b }
# A key path is ambiguous when a map key could read as more than one step or
# as a sequence index.
function amb_key(k) { return k == "" || index(k, ".") || k ~ /^[0-9]+$/ }
function push(col, kind, path, amb) {
  d++; scol[d] = col; skind[d] = kind; spath[d] = path; samb[d] = amb; sidx[d] = 0; seen = 1
}
# Places an entry of kind at col. A sequence may sit at the column of the key
# that owns it; a deeper column is only allowed under a key with no value.
function enter(col, kind) {
  while (d > 0 && (scol[d] > col || (scol[d] == col && skind[d] == "seq" && kind == "map" && d > 1 && scol[d - 1] == col))) {
    d--; pending = 0
  }
  if (d > 0 && scol[d] == col) {
    if (skind[d] == kind) { if (kind == "seq") sidx[d]++; pending = 0; return }
    if (kind == "seq" && pending) { push(col, kind, ppath, pamb); pending = 0; return }
    exit 1
  }
  if (seen && !pending) exit 1
  push(col, kind, d == 0 ? "" : ppath, d == 0 ? 0 : pamb)
  pending = 0
}
# Sets K and returns the index of the colon when r is "key:" or "key: value",
# else 0.
function map_key(r,   c, e, p) {
  c = substr(r, 1, 1)
  if (c == "\"" || c == sq) {
    e = quoted_end(r, c)
    if (!e || substr(r, e + 1, 1) != ":") return 0
    K = substr(r, 2, e - 2)
    # The key path must be the key itself, and decoding double-quoted
    # escapes is beyond this parser.
    if (c == "\"" && index(K, "\\")) exit 1
    if (c == sq) gsub(sq sq, sq, K)
    p = e + 1
  } else {
    p = index(r, ": ")
    if (!p && substr(r, length(r)) == ":") p = length(r)
    if (!p) return 0
    K = substr(r, 1, p - 1)
    sub(/ +$/, "", K)
    if (index(K, " #")) return 0
    if (K == "" || K == "<<" || index("?:,[]{}#&*!|>%@`", c)) exit 1
  }
  if (p < length(r) && substr(r, p + 1, 1) != " ") exit 1
  return p
}
function check_scalar(v,   c, e, t, i) {
  c = substr(v, 1, 1)
  if (c == "\"" || c == sq) {
    e = quoted_end(v, c)
    if (!e || substr(v, e + 1) !~ /^( *| +#.*)$/) exit 1
    return
  }
  if (index("|>{}[]&*!%@`,", c) || v ~ /^[-?:]( |$)/) exit 1
  t = v
  i = index(t, " #")
  if (i) t = substr(t, 1, i - 1)
  if (index(t, ": ") || t ~ /:$/) exit 1
}
{
  line = $0
  if (line ~ /^ *$/) { emit_line(line); next }
  match(line, /^ */)
  n = RLENGTH
  r = substr(line, n + 1)
  c = substr(r, 1, 1)
  if (c == "\t") exit 1
  if (c == "#") { emit_line(line); next }
  if (n == 0 && r ~ /^--- *$/ && !seen && !docstart) { docstart = 1; emit_line(line); next }
  if (n == 0 && (r ~ /^(---|\.\.\.)( |$)/ || c == "%")) exit 1
  base = n
  if (r ~ /^-( |$)/) {
    enter(n, "seq")
    path = join(spath[d], sidx[d])
    amb = samb[d]
    if (!match(r, /^- +/)) exit 1
    base = n + RLENGTH
    r = substr(r, RLENGTH + 1)
    c = substr(r, 1, 1)
    if (r == "" || c == "#" || r ~ /^-( |$)/) exit 1
    p = map_key(r)
    if (!p) { check_scalar(r); emit_masked(substr(line, 1, base), path, amb); next }
    pending = 1
    ppath = path
    pamb = amb
  } else {
    p = map_key(r)
    if (!p) exit 1
  }
  enter(base, "map")
  path = join(spath[d], K)
  amb = samb[d] || amb_key(K)
  v = substr(r, p + 1)
  match(v, /^ */)
  s = RLENGTH
  v = substr(v, s + 1)
  if (v == "" || substr(v, 1, 1) == "#") { pending = 1; ppath = path; pamb = amb; emit_line(line); next }
  check_scalar(v)
  emit_masked(substr(line, 1, base + p + s), path, amb)
}
'

# Needs "$JQ_WALK" in front. Exactly one object or array document, so every
# masked value has a key path; a key with a control character would forge
# extra lines in the key path list, so it fails.
MASK_FILE_JQ='
if length != 1 then error("not one document") else .[0] end
| if type == "object" or type == "array" then . else error("scalar document") end
| if $mode == "paths" then
    paths(type != "object" and type != "array")
    | map(tostring) | join(".")
    | if (explode | map(select(. < 32 or . == 127)) | length) > 0
      then error("control character in key") else . end
  elif $mode == "reveal" then
    ($reveal | split("\n") | map(select(. != "") | split("\t")
      | {key: .[0], value: (.[1:] | join("\t"))}) | from_entries) as $want
    | . as $doc
    | [paths(type != "object" and type != "array")] as $ps
    | reduce range(0; $ps | length) as $i
        ($doc | walk(if type == "object" or type == "array" then . else $marker end);
         $ps[$i] as $p
         | if $want[($i + 1 | tostring)] == ($p | map(tostring) | join("."))
              and ($p | all(type == "number"
                or (. != "" and (contains(".") | not)
                    and (explode | all(. >= 48 and . <= 57) | not))))
           then setpath($p; $open + ($doc | getpath($p) | tojson) + $close)
           else . end)
  else
    walk(if type == "object" or type == "array" then . else $marker end)
  end
'

# First match wins, so `.env.json` is json. npmrc is the ini dialect whose
# keys may contain ":".
mask_file_format() {
  mf_name=${1##*/}
  mf_parent=${1%/*}
  mf_parent=${mf_parent##*/}
  case $mf_name in
    *.json) printf json ;;
    *.yaml|*.yml) printf yaml ;;
    .npmrc) printf npmrc ;;
    *.ini|*.cfg|*.cnf|*.conf|.pypirc) printf ini ;;
    credentials|config)
      [ "$mf_parent" = .aws ] || return 1
      printf ini
      ;;
    # Only a shell reads these, and shell grammar is wider than the dotenv
    # subset in ways a line-wise check keeps missing.
    .envrc|*.envrc) return 1 ;;
    .env|.env.*|*.env|.flaskenv|.flaskenv.*|.dev.vars|.dev.vars.*) printf dotenv ;;
    *) return 1 ;;
  esac
}

# $1 = format, $2 = text|paths|reveal, $3 = the value marker, and for reveal
# $4 = the want file, $5 and $6 = the text around a shown value; reads the
# file on stdin.
mask_file_render() {
  case $1 in
    json)
      mr_want=
      [ "$2" != reveal ] || mr_want=$(cat "$4") || return 2
      if [ "$2" = paths ]; then
        jq -rs --arg mode paths --arg marker "$3" --arg reveal '' --arg open '' --arg close '' \
          "$JQ_WALK$MASK_FILE_JQ"
      else
        jq -s --arg mode "$2" --arg marker "$3" --arg reveal "$mr_want" --arg open "${5:-}" \
          --arg close "${6:-}" "$JQ_WALK$MASK_FILE_JQ"
      fi
      ;;
    dotenv|ini|npmrc|yaml)
      mr_colon=0
      [ "$1" != npmrc ] || mr_colon=1
      mr_prog=$MASK_FILE_AWK_INI
      case $1 in
        dotenv) mr_prog=$MASK_FILE_AWK_DOTENV ;;
        yaml) mr_prog=$MASK_FILE_AWK_YAML ;;
      esac
      LC_ALL=C awk -v mode="$2" -v marker="$3" -v colon_keys="$mr_colon" \
        -v want_file="${4:-}" -v show_open="${5:-}" -v show_close="${6:-}" "$MASK_FILE_AWK_LIB$mr_prog"
      ;;
    *) return 2 ;;
  esac
}

# Runs "$@" and prints a trailing x, keeping its exit status, so that
# v=$(capture_keep_newlines cmd) keeps cmd's final newlines once ${v%x} strips
# the x. Redirections on the call apply to cmd.
capture_keep_newlines() {
  "$@"
  ckn_status=$?
  printf x
  return "$ckn_status"
}

# Prints the masked view of file $1, or with $2 = paths the key path of every
# masked value, one per line: dotenv KEY, ini section.key (key outside a
# section), json and yaml keys joined by `.` with array indexes as numbers.
# Every failure exits non-zero with empty stdout and a fixed stderr line that
# names neither the path nor any content. $3 replaces the [MASKED] marker; it
# must not contain a backslash. $2 = reveal takes the arguments
# mask_file_render documents and is for masked_view only. $2 = values prints
# each dotenv value, one per line, and is for known_env_values only. A
# subshell, so its names and those resolve_path sets never reach the caller.
mask_file() (
  mf_mode=${2:-text}
  mf_marker=${3:-[MASKED]}
  case $mf_mode in text|paths|reveal|values) ;; *) die "mask-file: unsupported mode" ;; esac
  need_cmd awk
  need_cmd jq
  mf_path=$(resolve_path "$1")
  # resolve_path falls back to the name it was given; a symlink left over
  # means the name the format comes from is not the file's own.
  if [ -L "$mf_path" ] || [ ! -f "$mf_path" ] || [ ! -r "$mf_path" ]; then
    die_with_status 1 "mask-file: not a readable regular file"
  fi
  mf_format=$(mask_file_format "$mf_path") \
    || die_with_status 1 "mask-file: unsupported file format"
  [ "$mf_mode" != values ] || [ "$mf_format" = dotenv ] \
    || die_with_status 1 "mask-file: unsupported file format"
  mf_size=$(wc -c <"$mf_path" 2>/dev/null | tr -d ' \t')
  case $mf_size in
    ''|*[!0-9]*) die_with_status 1 "mask-file: cannot read the file size" ;;
  esac
  [ "$mf_size" -le "$MASK_FILE_MAX_BYTES" ] \
    || die_with_status 1 "mask-file: file is larger than 64 KiB"
  # Buffered so a failure partway through prints nothing; capture_keep_newlines
  # keeps $( ) from dropping final newlines. Parser stderr is dropped because jq
  # and awk may quote the input in their errors.
  mf_out=$(capture_keep_newlines \
    mask_file_render "$mf_format" "$mf_mode" "$mf_marker" "${4:-}" "${5:-}" "${6:-}" \
    2>/dev/null <"$mf_path") \
    || die_with_status 1 "mask-file: content is outside the supported $mf_format subset"
  printf '%s' "${mf_out%x}"
)

mask_file_usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard mask-file [--key-paths] [--] FILE

Prints FILE with every value replaced by [MASKED], keeping keys, comments and
structure. --key-paths prints the key path of each masked value instead.
Supported: json, yaml (block subset), ini and dotenv, chosen by file name.
Exits non-zero with no output when the file cannot be masked.
EOF
}

do_mask_file() {
  mf_cli_mode=text
  while [ $# -gt 0 ]; do
    case $1 in
      --key-paths) mf_cli_mode=paths; shift ;;
      -h|--help) mask_file_usage; exit 0 ;;
      --) shift; break ;;
      -*) mask_file_usage; exit 2 ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || { mask_file_usage; exit 2; }
  mask_file "$1" "$mf_cli_mode"
}

deny_read_mode() {
  case ${AGENT_GUARD_DENY_READ_MODE:-block} in
    block) printf block ;;
    mask) printf mask ;;
    *) return 1 ;;
  esac
}

# Below the hosts' inline hook-output limits, so a view is never moved to a
# file on disk or cut to a preview the agent could take for the whole file.
MASKED_VIEW_MAX_BYTES=6144

masked_view_scan() {
  ( scan_text_direct "masked view" "$1" ) >/dev/null 2>&1
}

masked_view_fits() {
  mv_size=$(printf '%s' "$1" | wc -c | tr -d ' \t')
  case $mv_size in ''|*[!0-9]*) return 2 ;; esac
  [ "$mv_size" -le "$MASKED_VIEW_MAX_BYTES" ]
}

# Mask rule files hold one ERE per line, skipping `#` and blank lines. The
# rules are user input: only awk matches them (jq and GNU grep regexes can
# backtrack), their text never reaches a message, and a refusal names a rule
# by its file label and line. Shapes that backtracking awks (mawk) take
# exponential time on are refused; the timer catches what a shape check
# cannot, like mawk on a long run of `a?`.
MASK_RULES_MAX=64
MASK_RULES_MAX_BYTES=256
MASK_RULES_TIMEOUT_SECONDS=2

# Every program reads rules as "label<TAB>line<TAB>rule". unmark turns each
# one-time `marker` back into [MASKED] for the programs that render with one.
MASK_RULES_AWK_LIB='
function parse_rule(s,   t) {
  t = index(s, "\t"); label = substr(s, 1, t - 1); s = substr(s, t + 1)
  t = index(s, "\t"); line = substr(s, 1, t - 1); rule = substr(s, t + 1)
}
function unmark(s,   p, out) {
  out = ""
  while ((p = index(s, marker)) > 0) {
    out = out substr(s, 1, p - 1) "[MASKED]"
    s = substr(s, p + length(marker))
  }
  return out s
}
'

# Prints "label line N: reason" for the first refused rule. Dynamic regexes
# are not used here, so a rule cannot make this pass fail or slow down.
MASK_RULES_AWK_SHAPE='
function refuse(why) { printf "%s line %s: the rule %s", label, line, why; exit 0 }
# A repetition operator at i: *, +, ? or an interval; sets W to its width.
function repetition(r, i,   c, b, lo, hi, k) {
  c = substr(r, i, 1)
  W = 1
  if (c == "*" || c == "+" || c == "?") return 1
  if (c != "{" || !match(substr(r, i), /^\{[0-9]*(,[0-9]*)?\}/) || RLENGTH < 3) return 0
  W = RLENGTH
  b = substr(r, i + 1, RLENGTH - 2)
  k = index(b, ",")
  lo = k ? substr(b, 1, k - 1) : b
  hi = k ? substr(b, k + 1) : b
  if (length(lo) > 3 || length(hi) > 3 || lo + 0 > 255 || hi + 0 > 255) refuse("repeats more than 255 times")
  return 1
}
# Skips the bracket expression opening at i; returns the index of its "]".
function bracket_end(r, i, n,   s, e) {
  i++
  if (substr(r, i, 1) == "^") i++
  if (substr(r, i, 1) == "]") i++
  while (i <= n) {
    s = substr(r, i, 2)
    if (s == "[:" || s == "[." || s == "[=") {
      e = index(substr(r, i + 2), substr(s, 2, 1) "]")
      if (!e) return n
      i += e + 3
    } else if (substr(r, i, 1) == "\\") i += 2
    else if (substr(r, i, 1) == "]") return i
    else i++
  }
  return n
}
# q[d] and alt[d]: the open group at depth d holds a repetition or a |.
# gq and galt carry those for a group that just closed, so a repetition right
# after it can tell `(a+)+` and `(a|aa)*` from `(ab)+`.
function shape(r,   n, i, c, d, atom, lastq, gq, galt) {
  n = length(r); d = 0; q[0] = 0; alt[0] = 0
  atom = lastq = gq = galt = 0
  for (i = 1; i <= n; i++) {
    c = substr(r, i, 1)
    if (repetition(r, i)) {
      if (lastq || (atom && gq)) refuse("repeats an expression that already repeats")
      if (atom && galt) refuse("repeats a group that contains |")
      q[d] = 1; lastq = 1; i += W - 1
      continue
    }
    lastq = 0
    if (c == "\\") {
      i++
      if (substr(r, i, 1) ~ /[1-9]/) refuse("uses a back-reference")
      atom = 1; gq = galt = 0
    } else if (c == "[") {
      i = bracket_end(r, i, n); atom = 1; gq = galt = 0
    } else if (c == "(") {
      d++; q[d] = alt[d] = 0; atom = 0
    } else if (c == ")" && d > 0) {
      gq = q[d]; galt = alt[d]; d--
      if (gq) q[d] = 1
      if (galt) alt[d] = 1
      atom = 1
    } else if (c == "|") {
      alt[d] = 1; atom = 0
    } else if (c == "^" || c == "$") {
      atom = 0
    } else {
      atom = 1; gq = galt = 0
    }
  }
}
{
  parse_rule($0)
  if (NR > max) refuse("is past the limit of " max " rules")
  if (length(rule) > max_bytes) refuse("is longer than " max_bytes " bytes")
  shape(rule)
}
'

# awk exits on an invalid ERE, so the rule about to compile is announced
# first and the last one announced is the culprit.
MASK_RULES_AWK_COMPILE='
{
  parse_rule($0)
  print label "\t" line
  fflush()
  if ("" ~ rule) { print "empty"; empty = 1; exit 0 }
}
END { if (!empty) print "ok" }
'

# The view comes with a one-time `marker` in place of each value, so file
# text that reads "[MASKED]" is never taken for a value. Comment lines get
# every span any rule matches replaced by one [MASKED]. Other lines hold keys
# and structure around the markers; a rule that matches any piece between
# markers exits 3, since masking it would rewrite a key. Rules run one at a
# time and are announced to `progress`, so a timeout or a key match names
# the rule.
MASK_RULES_AWK_APPLY='
function outside(s, r,   p) {
  while ((p = index(s, marker)) > 0) {
    if (p > 1 && match(substr(s, 1, p - 1), r)) return 1
    s = substr(s, p + length(marker))
  }
  return s != "" && match(s, r)
}
function mark(i, r,   s, off, st, ones) {
  s = lines[i]
  if (!(i in marks)) marks[i] = sprintf("%" length(s) "s", "")
  off = 0
  while (off < length(s) && match(substr(s, off + 1), r)) {
    st = off + RSTART
    if (RLENGTH > 0) {
      ones = sprintf("%" RLENGTH "s", "")
      gsub(/ /, "1", ones)
      marks[i] = substr(marks[i], 1, st - 1) ones substr(marks[i], st + RLENGTH)
    }
    off = st + (RLENGTH > 0 ? RLENGTH : 1) - 1
  }
}
function masked(i,   s, m, j, n, out) {
  s = lines[i]; m = marks[i]; n = length(s); out = ""
  for (j = 1; j <= n; j++) {
    if (substr(m, j, 1) != "1") { out = out substr(s, j, 1); continue }
    out = out "[MASKED]"
    while (j < n && substr(m, j + 1, 1) == "1") j++
  }
  return out
}
BEGIN {
  if (format == "dotenv" || format == "yaml") comment = "^[ \t]*#"
  else if (format == "ini" || format == "npmrc") comment = "^[;#]"
  else comment = ""
}
FNR == NR { parse_rule($0); nr++; rl[nr] = label; rn[nr] = line; re[nr] = rule; next }
{ lines[++n] = $0; com[n] = comment != "" && $0 ~ comment }
END {
  for (k = 1; k <= nr; k++) {
    print rl[k] "\t" rn[k] > progress
    fflush(progress)
    for (i = 1; i <= n; i++) {
      if (com[i]) mark(i, re[k])
      else if (outside(lines[i], re[k])) exit 3
    }
  }
  for (i = 1; i <= n; i++) print (i in marks) ? masked(i) : com[i] ? lines[i] : unmark(lines[i])
}
'

# Prints the rules of file $2 labelled $1. With $3 = optional a missing file
# has no rules; any other file that cannot be read returns 1. Stops after one
# rule past the limit, which is enough for the check to refuse.
mask_rules_collect() {
  if [ "$3" = optional ] && [ ! -e "$2" ] && [ ! -L "$2" ]; then
    return 0
  fi
  [ -f "$2" ] && [ -r "$2" ] || return 1
  LC_ALL=C awk -v label="$1" -v max="$MASK_RULES_MAX" '
    { sub(/\r$/, "") }
    /^[ \t]*(#|$)/ { next }
    { print label "\t" FNR "\t" $0; if (++count > max) exit }
  ' "$2" 2>/dev/null
}

# Runs awk with stdout in file $1 under the rule timer. Returns awk's status,
# 137 when the timer killed it, or 125 when there is no timer.
mask_rules_awk() (
  mr_out=$1
  shift
  command -v sleep >/dev/null 2>&1 || exit 125
  LC_ALL=C awk "$@" >"$mr_out" 2>/dev/null &
  mr_pid=$!
  (
    mr_sleep=
    trap '[ -z "$mr_sleep" ] || kill -TERM "$mr_sleep" 2>/dev/null; exit 0' TERM
    sleep "$MASK_RULES_TIMEOUT_SECONDS" &
    mr_sleep=$!
    wait "$mr_sleep" 2>/dev/null || exit 0
    kill -KILL "$mr_pid" 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  mr_dog=$!
  wait "$mr_pid"
  mr_status=$?
  kill -TERM "$mr_dog" 2>/dev/null
  wait "$mr_dog" 2>/dev/null
  exit "$mr_status"
)

# The last "label<TAB>line" announced in file $1, as "label line N".
mask_rules_culprit() {
  awk -F '\t' 'NF == 2 { c = $1 " line " $2 } END { if (c == "") exit 1; printf "%s", c }' "$1" 2>/dev/null
}

# Judges the rules in file $1 (mask_rules_collect output). Returns 0 when all
# are accepted, 1 with "label line N: reason" on stdout for the first refused
# one, or 2 when they could not be checked. Deciding what a refusal means is
# left to the caller.
mask_rules_check() (
  mc_out=$(LC_ALL=C awk -v max="$MASK_RULES_MAX" -v max_bytes="$MASK_RULES_MAX_BYTES" \
    "$MASK_RULES_AWK_LIB$MASK_RULES_AWK_SHAPE" "$1" 2>/dev/null) || exit 2
  [ -z "$mc_out" ] || { printf '%s' "$mc_out"; exit 1; }
  mc_log=$(mktemp_file) || exit 2
  mask_rules_awk "$mc_log" "$MASK_RULES_AWK_LIB$MASK_RULES_AWK_COMPILE" "$1"
  mc_status=$?
  mc_last=$(tail -n 1 "$mc_log" 2>/dev/null)
  mc_rule=$(mask_rules_culprit "$mc_log")
  rm -f "$mc_log"
  [ "$mc_status" -eq 0 ] && [ "$mc_last" = ok ] && exit 0
  [ -n "$mc_rule" ] || exit 2
  case $mc_status:$mc_last in
    0:empty) printf '%s: the rule matches empty text' "$mc_rule" ;;
    137:*) printf '%s: the rule took too long to check' "$mc_rule" ;;
    125:*) exit 2 ;;
    *) printf '%s: the rule is not a valid extended regular expression' "$mc_rule" ;;
  esac
  exit 1
)

# Applies checked rules in file $1 to the view in file $3 of format $2,
# rendered with marker $4 for each value. Prints the view with [MASKED], or
# returns 1 with "label line N: reason" when a rule matches outside values
# and comments or runs out of time, or 2.
mask_rules_apply() (
  ma_out=$(mktemp_file) || exit 2
  ma_log=$(mktemp_file) || { rm -f "$ma_out"; exit 2; }
  mask_rules_awk "$ma_out" -v format="$2" -v marker="$4" -v progress="$ma_log" \
    "$MASK_RULES_AWK_LIB$MASK_RULES_AWK_APPLY" "$1" "$3"
  ma_status=$?
  [ "$ma_status" -eq 0 ] && cat "$ma_out"
  ma_rule=$(mask_rules_culprit "$ma_log")
  rm -f "$ma_out" "$ma_log"
  [ "$ma_status" -eq 0 ] && exit 0
  [ -n "$ma_rule" ] || exit 2
  case $ma_status in
    3) printf '%s: the rule matches a key or other text outside values and comments' "$ma_rule" ;;
    137) printf '%s: the rule took too long to apply' "$ma_rule" ;;
    *) exit 2 ;;
  esac
  exit 1
)

# Prints the deny-value rules: the user file and the file
# AGENT_GUARD_MASK_DENY_VALUES names, together, so a repository setting can
# add rules but never empty the user's list. Returns 1 with a reason when one
# cannot be read.
mask_deny_rules() (
  md_list=
  if [ -n "${HOME:-}" ]; then
    md_list=$(mask_rules_collect mask-deny-values.txt \
      "$HOME/.config/agent-guard/mask-deny-values.txt" optional) \
      || { printf 'mask-deny-values.txt could not be read'; exit 1; }
  fi
  if [ -n "${AGENT_GUARD_MASK_DENY_VALUES:-}" ]; then
    md_env=$(mask_rules_collect AGENT_GUARD_MASK_DENY_VALUES \
      "$AGENT_GUARD_MASK_DENY_VALUES" required) \
      || { printf 'the file AGENT_GUARD_MASK_DENY_VALUES names could not be read'; exit 1; }
    [ -z "$md_env" ] || md_list=${md_list:+$md_list
}$md_env
  fi
  printf '%s' "$md_list"
)

# Sets mask_token to 24 hex digits from /dev/urandom, or returns 1. It sets a
# name rather than printing, so a caller needs no extra command substitution.
mask_random_token() {
  mask_token=$(od -An -N12 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  case $mask_token in
    ????????????????????????) return 0 ;;
    *) return 1 ;;
  esac
}

# Applies the deny-value rules to masked view $2 of file $1. With rules, the
# file is masked again with a random marker so text in it that reads
# "[MASKED]" cannot pass for a value. Prints the view, or a reason with no
# rule text and returns 1; the caller blocks on either.
mask_deny_values() (
  md_list=$(mask_deny_rules) || { printf '%s' "$md_list"; exit 1; }
  [ -n "$md_list" ] || { printf '%s' "$2"; exit 0; }
  md_failed='the mask-deny-values rules could not be checked'
  md_rules=$(mktemp_file) || { printf '%s' "$md_failed"; exit 1; }
  md_view=$(mktemp_file) || { rm -f "$md_rules"; printf '%s' "$md_failed"; exit 1; }
  printf '%s\n' "$md_list" >"$md_rules"
  md_out=$(mask_rules_check "$md_rules")
  md_status=$?
  if [ "$md_status" -eq 0 ]; then
    mask_random_token && md_marker="[MASKED:$mask_token]" || md_status=2
  fi
  if [ "$md_status" -eq 0 ]; then
    mask_file "$1" text "$md_marker" >"$md_view" 2>/dev/null || md_status=2
  fi
  if [ "$md_status" -eq 0 ]; then
    md_out=$(capture_keep_newlines \
      mask_rules_apply "$md_rules" "$(mask_file_format "$1")" "$md_view" "$md_marker")
    md_status=$?
    md_out=${md_out%x}
  fi
  rm -f "$md_rules" "$md_view"
  case $md_status in
    0) printf '%s' "$md_out" ;;
    1) printf '%s' "$md_out"; exit 1 ;;
    *) printf '%s' "$md_failed"; exit 1 ;;
  esac
)

# The allow list shows the values of the keys it names. It widens what the
# agent sees, so it is read only from the user's own file, never from an
# environment variable: a host project setting committed to a repository can
# set those for the hook. Every refusal warns without rule text and falls back
# to the view with every value masked; none blocks.
MASK_ALLOW_PROBE_KEY=AGENT_GUARD_PROBE_KEY_7F3A

mask_allow_warn() {
  info "$PROGRAM: $1; every value stays masked"
}

# Prints "line<TAB>path" for each key path (one per line of the second file)
# that a rule matches whole. Refuses, with exit 3, a rule that is not anchored
# at both ends or that matches the probe key, which no rule naming real keys
# does.
MASK_ALLOW_AWK_SELECT='
function refuse(why) { printf "%s line %s: the rule %s", label, line, why; exit 3 }
FILENAME == rules_file {
  parse_rule($0)
  body = rule
  sub(/[$]$/, "", body)
  esc = body
  sub(/[\\]+$/, "", esc)
  if (substr(rule, 1, 1) != "^" || body == rule || (length(body) - length(esc)) % 2)
    refuse("does not start with ^ and end with $")
  if (match(probe, rule)) refuse("matches a probe key, so it would match almost any key")
  re[++nr] = rule
  next
}
{
  for (k = 1; k <= nr; k++)
    if (match($0, re[k]) && RSTART == 1 && RLENGTH == length($0)) { print FNR "\t" $0; next }
}
'

# Merges the view with values shown (the third file, other values under
# `marker`) into the masked view (the second file), line by line. A line takes
# its shown value only when hiding that value again gives the line of the
# masked view, and no deny-value rule (the first file) matches the line with it.
# json shows a value as a json string holding its json text. Exits 4 when the
# two views do not line up.
MASK_ALLOW_AWK_MERGE='
# Undoes the json string escaping of json text, which only escapes " and \.
function unquote(s,   i, c, out) {
  out = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\\") {
      c = substr(s, ++i, 1)
      if (c != "\\" && c != "\"") return ""
    }
    out = out c
  }
  return out
}
function shown(i,   s, p, lead, rest, val, tail, hole, line, k) {
  s = shows[i]
  if (!(p = index(s, show_open))) return ""
  lead = substr(s, 1, p - 1)
  rest = substr(s, p + length(show_open))
  if (!(p = index(rest, show_close))) return ""
  val = substr(rest, 1, p - 1)
  tail = substr(rest, p + length(show_close))
  if (index(tail, show_open)) return ""
  hole = "[MASKED]"
  if (json) {
    if (lead !~ /"$/ || tail !~ /^"/) return ""
    lead = substr(lead, 1, length(lead) - 1)
    tail = substr(tail, 2)
    if ((val = unquote(val)) == "") return ""
    hole = "\"[MASKED]\""
  }
  lead = unmark(lead)
  tail = unmark(tail)
  if (lead hole tail != masked[i]) return ""
  line = lead val tail
  for (k = 1; k <= nr; k++) if (line ~ re[k]) return ""
  return line
}
FILENAME == rules_file { parse_rule($0); re[++nr] = rule; next }
FILENAME == view_file { masked[++nm] = $0; next }
{ shows[++ns] = $0 }
END {
  if (ns != nm) exit 4
  for (i = 1; i <= nm; i++) {
    line = shown(i)
    print (line != "" ? line : masked[i])
  }
}
'

# Returns 1 when an access control list on $1 may let someone other than the
# owner in: on macOS any allow entry (a home directory carries deny entries),
# elsewhere any POSIX ACL, which ls marks with "+". Returns 2 when ls fails.
mask_allow_acl() (
  case "$(uname -s)" in
    Darwin)
      ma_ls=$(LC_ALL=C ls -lde -- "$1" 2>/dev/null) || exit 2
      case $ma_ls in *'
'*' allow '*) exit 1 ;; esac
      ;;
    *)
      ma_ls=$(LC_ALL=C ls -ld -- "$1" 2>/dev/null) || exit 2
      case ${ma_ls%% *} in ??????????+*) exit 1 ;; esac
      ;;
  esac
  exit 0
)

# Prints the resolved path of allow file $1 when it may be used: outside every
# git work tree, outside workdir $2 (or the current directory) and its work
# tree, with the file and its directory owned by the current user and
# writable by no one else. Otherwise prints the reason and returns 1.
mask_allow_source() (
  ma_unchecked='mask-allow-keys.txt could not be checked'
  # Returns 0 when $1 or a directory above it holds a .git entry.
  ma_git_above() {
    ma_up=$1
    while :; do
      if [ -e "$ma_up/.git" ] || [ -L "$ma_up/.git" ]; then
        return 0
      fi
      [ -n "$ma_up" ] && [ "$ma_up" != / ] || return 1
      ma_up=${ma_up%/*}
    done
  }
  # Sets ma_owner and ma_mode for node $1 after its ACL check, or prints the
  # reason and returns 1. The owner and mode policy stays with each caller.
  ma_node_facts() {
    mask_allow_acl "$1"
    case $? in
      0) ;;
      1) printf '%s' "$ma_acl"; return 1 ;;
      *) printf '%s' "$ma_unchecked"; return 1 ;;
    esac
    ma_stat=$(file_stat access -P "$1")
    ma_owner=${ma_stat%%:*}
    ma_mode=${ma_stat#*:}
    case $ma_owner:$ma_mode in
      :*|*:|*[!0-9:]*|*:*:*) printf '%s' "$ma_unchecked"; return 1 ;;
    esac
  }
  ma_real=$(resolve_path "$1")
  # resolve_path falls back to the name it was given; check that the path is
  # the physical one.
  ma_dir=${ma_real%/*}
  case $ma_real in /*) ;; *) printf '%s' "$ma_unchecked"; exit 1 ;; esac
  ma_dir=$(CDPATH= cd -P -- "${ma_dir:-/}" 2>/dev/null && pwd -P) \
    || { printf '%s' "$ma_unchecked"; exit 1; }
  if [ "${ma_dir%/}/${ma_real##*/}" != "$ma_real" ] || [ -L "$ma_real" ] || [ ! -f "$ma_real" ]; then
    printf '%s' "$ma_unchecked"
    exit 1
  fi
  ma_inside='mask-allow-keys.txt is inside the repository or the working directory'
  # The agent can run a tool from any directory, so the workdir alone cannot
  # tell a HOME that a project setting moved into a repository.
  if ma_git_above "$ma_dir"; then
    printf '%s' "$ma_inside"
    exit 1
  fi
  ma_work=${2:-.}
  ma_work=$(CDPATH= cd -P -- "$ma_work" 2>/dev/null && pwd -P) \
    || { printf '%s' "$ma_unchecked"; exit 1; }
  # Git variables are dropped so the work tree is the one on disk. When git
  # cannot answer inside what looks like a work tree, it is not guessed.
  ma_top=$(cd -- "$ma_work" && unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_CEILING_DIRECTORIES \
    GIT_DISCOVERY_ACROSS_FILESYSTEM && git rev-parse --show-toplevel 2>/dev/null) || ma_top=
  if [ -n "$ma_top" ]; then
    ma_top=$(CDPATH= cd -P -- "$ma_top" 2>/dev/null && pwd -P) \
      || { printf '%s' "$ma_unchecked"; exit 1; }
  elif ma_git_above "$ma_work"; then
    printf '%s' "$ma_unchecked"
    exit 1
  fi
  for ma_root in "$ma_work" ${ma_top:+"$ma_top"}; do
    case $ma_real in
      "${ma_root%/}"/*)
        printf '%s' "$ma_inside"
        exit 1
        ;;
    esac
  done
  ma_uid=$(id -u 2>/dev/null) || { printf '%s' "$ma_unchecked"; exit 1; }
  ma_acl='an access control list on mask-allow-keys.txt or a directory above it lets others write'
  for ma_node in "$ma_real" "$ma_dir"; do
    ma_node_facts "$ma_node" || exit 1
    [ "$ma_owner" = "$ma_uid" ] || {
      printf 'mask-allow-keys.txt or its directory is not owned by the current user'
      exit 1
    }
    case $ma_mode in
      ''|*[!0-7]*) printf '%s' "$ma_unchecked"; exit 1 ;;
      *[2367]|*[2367]?)
        printf 'mask-allow-keys.txt or its directory is writable by group or others'
        exit 1
        ;;
    esac
  done
  # Whoever can rename a directory above could swap the file after this
  # check, so each one belongs to the user or root, and one that others can
  # write is sticky.
  ma_up=$ma_dir
  while [ -n "$ma_up" ] && [ "$ma_up" != / ]; do
    ma_up=${ma_up%/*}
    ma_node=${ma_up:-/}
    ma_node_facts "$ma_node" || exit 1
    if [ "$ma_owner" != "$ma_uid" ] && [ "$ma_owner" != 0 ]; then
      printf 'a directory above mask-allow-keys.txt belongs to another user'
      exit 1
    fi
    case $ma_mode in
      *[2367]|*[2367]?)
        if [ ! -k "$ma_node" ]; then
          printf 'a directory above mask-allow-keys.txt is writable by group or others'
          exit 1
        fi
        ;;
    esac
  done
  printf '%s' "$ma_real"
)

# Prints masked view $2 of file $1 with the values the allow list names shown,
# or returns 1 when it shows none. $3 is the hook workdir. Values are chosen
# by the key paths of one read and shown from another only where both agree,
# and a value whose key path is ambiguous is never shown.
mask_allow_keys() (
  [ -n "${HOME:-}" ] || exit 1
  ma_file="$HOME/.config/agent-guard/mask-allow-keys.txt"
  [ -e "$ma_file" ] || [ -L "$ma_file" ] || exit 1
  ma_src=$(mask_allow_source "$ma_file" "$3") || { mask_allow_warn "$ma_src"; exit 1; }
  ma_list=$(mask_rules_collect mask-allow-keys.txt "$ma_src" required) \
    || { mask_allow_warn 'mask-allow-keys.txt could not be read'; exit 1; }
  [ -n "$ma_list" ] || exit 1
  ma_failed='the mask-allow-keys.txt rules could not be applied'
  ma_deny_list=$(mask_deny_rules) || { mask_allow_warn "$ma_failed"; exit 1; }
  ma_tmp=
  trap 'rm -f $ma_tmp' 0
  for ma_name in rules paths want deny masked shows out; do
    ma_f=$(mktemp_file) || { mask_allow_warn "$ma_failed"; exit 1; }
    ma_tmp="$ma_tmp $ma_f"
    eval "ma_$ma_name=\$ma_f"
  done
  printf '%s\n' "$ma_list" >"$ma_rules"
  ma_why=$(mask_rules_check "$ma_rules")
  case $? in
    0) ;;
    1) mask_allow_warn "$ma_why"; exit 1 ;;
    *) mask_allow_warn 'the mask-allow-keys.txt rules could not be checked'; exit 1 ;;
  esac
  mask_file "$1" paths >"$ma_paths" 2>/dev/null || { mask_allow_warn "$ma_failed"; exit 1; }
  mask_rules_awk "$ma_want" -v rules_file="$ma_rules" -v probe="$MASK_ALLOW_PROBE_KEY" \
    "$MASK_RULES_AWK_LIB$MASK_ALLOW_AWK_SELECT" "$ma_rules" "$ma_paths"
  case $? in
    0) ;;
    3) mask_allow_warn "$(cat "$ma_want")"; exit 1 ;;
    *) mask_allow_warn "$ma_failed"; exit 1 ;;
  esac
  [ -s "$ma_want" ] || exit 1
  if [ -n "$ma_deny_list" ]; then
    printf '%s\n' "$ma_deny_list" >"$ma_deny"
    mask_rules_check "$ma_deny" >/dev/null || { mask_allow_warn "$ma_failed"; exit 1; }
  fi
  mask_random_token || { mask_allow_warn "$ma_failed"; exit 1; }
  ma_token=$mask_token
  ma_marker="[MASKED:$ma_token]"
  ma_open="[SHOW:$ma_token:"
  ma_close=":$ma_token:SHOW]"
  mask_file "$1" reveal "$ma_marker" "$ma_want" "$ma_open" "$ma_close" >"$ma_shows" 2>/dev/null \
    || { mask_allow_warn "$ma_failed"; exit 1; }
  printf '%s' "$2" >"$ma_masked"
  ma_json=0
  [ "$(mask_file_format "$1")" != json ] || ma_json=1
  mask_rules_awk "$ma_out" -v rules_file="$ma_deny" -v view_file="$ma_masked" \
    -v marker="$ma_marker" -v show_open="$ma_open" -v show_close="$ma_close" -v json="$ma_json" \
    "$MASK_RULES_AWK_LIB$MASK_ALLOW_AWK_MERGE" "$ma_deny" "$ma_masked" "$ma_shows" \
    || { mask_allow_warn "$ma_failed"; exit 1; }
  ! cmp -s "$ma_out" "$ma_masked" || exit 1
  cat "$ma_out"
)

# Rules that rewrite the view belong between the engine and the size cap, so
# the cap and the rescan always see the view that is returned. The cap also
# runs first: awk time on user rules grows with the view.
masked_view() (
  mv_view=$(capture_keep_newlines mask_file "$1" text 2>/dev/null) || exit 10
  mv_view=${mv_view%x}
  masked_view_fits "$mv_view"
  case $? in 0) ;; 1) exit 11 ;; *) exit 10 ;; esac
  mv_view=$(capture_keep_newlines mask_deny_values "$1" "$mv_view")
  mv_status=$?
  mv_view=${mv_view%x}
  [ "$mv_status" -eq 0 ] || { printf '%s' "$mv_view"; exit 14; }
  masked_view_fits "$mv_view"
  case $? in 0) ;; 1) exit 11 ;; *) exit 10 ;; esac
  # The view with allowed values shown gets the first of at most two scans;
  # the view with every value masked gets the second.
  if mv_shown=$(capture_keep_newlines mask_allow_keys "$1" "$mv_view" "${2:-}"); then
    mv_shown=${mv_shown%x}
    if ! masked_view_fits "$mv_shown"; then
      mask_allow_warn 'the view showing the mask-allow-keys.txt values is too large'
    elif ! masked_view_scan "$mv_shown"; then
      mask_allow_warn 'the view showing the mask-allow-keys.txt values contains secret-like text or could not be scanned'
    else
      printf '%s' "$mv_shown"
      exit 0
    fi
  fi
  masked_view_scan "$mv_view"
  case $? in
    0) ;;
    1) exit 12 ;;
    *) exit 13 ;;
  esac
  printf '%s' "$mv_view"
)

# $2 is the hook workdir; empty means the current directory.
deny_read_masked_block() {
  info "$PROGRAM: blocked sensitive file access: $1"
  dr_view=$(capture_keep_newlines masked_view "$1" "${2:-}")
  case $? in
    0)
      info "$PROGRAM: masked view follows (values replaced with [MASKED]; the file itself was not read by the tool)"
      printf '%s' "${dr_view%x}" >&2
      ;;
    11) info "$PROGRAM: no masked view: the file is too large for a masked view" ;;
    12) info "$PROGRAM: no masked view: the masked view still contains secret-like text" ;;
    13) info "$PROGRAM: no masked view: the secret scanner could not check the masked view" ;;
    14) info "$PROGRAM: no masked view: ${dr_view%x}" ;;
    *) info "$PROGRAM: no masked view: the file is not a readable json, yaml, ini or dotenv file within the supported subset and 64 KiB" ;;
  esac
  exit 2
}

deny_read_mode_notice() {
  case $1 in
    mask)
      case "$(hook_host)" in
        codex) info "$PROGRAM: for a masked view, read the protected file alone with \`cat <path>\`" ;;
        *) info "$PROGRAM: for a masked view, read the protected file alone with the read tool or \`cat <path>\`" ;;
      esac
      ;;
    invalid) info "$PROGRAM: AGENT_GUARD_DENY_READ_MODE must be block or mask; no masked view" ;;
  esac
}

# A relative file_path would resolve against the hook's cwd, which need not be
# the host's.
read_mask_target() (
  [ "$2" = Read ] || exit 1
  rt_path=$(json_value '.tool_input.file_path | strings' "$1")
  [ -n "$rt_path" ] || exit 1
  rt_path=$(normalize_path "$rt_path")
  case $rt_path in /*) ;; *) exit 1 ;; esac
  matches_deny_path "$rt_path" || exit 1
  rt_other=$(printf '%s' "$1" | jq -r '.tool_input | del(.file_path) | .. | strings') || exit 1
  printf '%s\n' "$rt_other" | {
    while IFS= read -r rt_value; do
      [ -n "$rt_value" ] || continue
      matches_deny_path "$rt_value" && exit 1
    done
    exit 0
  } || exit 1
  resolve_path "$rt_path"
)

CAT_MASK_PATH_CHARS='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/~+@-'
cat_mask_target() (
  ct_blank=$(printf ' \t')
  ct_cmd=$1
  case $ct_cmd in *'
'*) exit 1 ;; esac
  ct_cmd=${ct_cmd#"${ct_cmd%%[!$ct_blank]*}"}
  ct_cmd=${ct_cmd%"${ct_cmd##*[!$ct_blank]}"}
  case $ct_cmd in cat[$ct_blank]*) ;; *) exit 1 ;; esac
  ct_path=${ct_cmd#cat}
  ct_path=${ct_path#"${ct_path%%[!$ct_blank]*}"}
  ct_dashdash=0
  case $ct_path in
    --[$ct_blank]*)
      ct_dashdash=1
      ct_path=${ct_path#--}
      ct_path=${ct_path#"${ct_path%%[!$ct_blank]*}"}
      ;;
  esac
  case $ct_path in ''|*[!$CAT_MASK_PATH_CHARS]*) exit 1 ;; esac
  case $ct_path in
    -) exit 1 ;;
    -*) [ "$ct_dashdash" -eq 1 ] || exit 1 ;;
  esac
  # `~user`, `~+` and `~-` name other directories than HOME.
  case $ct_path in
    '~'|'~/'*) ;;
    '~'*) exit 1 ;;
  esac
  if [ -n "$2" ]; then
    CDPATH= cd -- "$2" 2>/dev/null || exit 1
  fi
  ct_path=$(normalize_path "$ct_path")
  matches_deny_path "$ct_path" || exit 1
  case $ct_path in
    /*) ;;
    *) ct_path=$(pwd -P)/$ct_path || exit 1 ;;
  esac
  resolve_path "$ct_path"
)

# PostToolUse output guard. Applies, in one rewrite: secret-literal redaction
# (AGENT_GUARD_OUTPUT_REDACT, on by default) and PII masking
# (AGENT_GUARD_PII_HOOK_MODE=mask). Both transform the same tool_response and are
# emitted as a single updatedToolOutput, so they compose instead of racing for
# the one rewrite slot. PostToolUse cannot retract a completed tool result with
# exit status alone, so mandatory masking has a dependency-independent,
# shape-preserving fallback and emits one host-valid replacement.
# $2 is the tool name the caller read from $1 with $JV_TOOL; there is no
# fallback read, because the only caller has it and re-reading costs a jq run
# on large outputs.
redact_tool_output() {
  input=$1
  REDACT_OUTPUT_EMITTED=0
  # Validate the skip set here too: the masker reads it inside $( ), where a
  # die would only leave the response unmasked.
  pii_hook_mode
  pii_skip_set
  secrets_on=0; pii_on=0
  output_redact_enabled && secrets_on=1
  [ "$PII_HOOK_MODE" = mask ] && pii_on=1
  [ "$secrets_on" -eq 1 ] || [ "$pii_on" -eq 1 ] || return 0
  redact_figma_tool=0
  if is_figma_mcp_tool "$2"; then
    redact_figma_tool=1
  fi
  ag_known_value_base=
  if [ "$secrets_on" -eq 1 ] && known_value_redact_enabled; then
    ag_known_value_base=$(json_value '.cwd // empty' "$input" 2>/dev/null) \
      || ag_known_value_base=
  fi

  resp=
  if ! resp=$(printf '%s' "$input" | jq -c '.tool_response // empty' 2>/dev/null); then
    resp=
    if recover_post_tool_validation_failure "$input"; then
      REDACT_OUTPUT_EMITTED=1
      return 0
    fi
    block_failed_output_rewrite
  fi
  case "$resp" in
    ''|null) return 0 ;;
  esac

  # A quote-free JSON value is ASCII and has no string or binary payload. Its
  # character count is its byte count. Above the existing cap it must take the
  # conservative path anyway; do so before another large copy and NUL walk.
  # The same validated fallback and failure recovery remain authoritative.
  #
  # Only quote-free oversized JSON enters this scope. Such a value has no
  # strings or binary payload and is ASCII; byte and character semantics agree.
  # Older macOS shells otherwise spend substantial CPU expanding these large
  # ASCII variables in a multibyte locale. Assign in this shell, then restore
  # the exact prior set/unset state. The temporary function-call environment
  # alone did not resolve the measured older-shell regression.
  if [ "$secrets_on" -eq 1 ]; then
    case "$resp" in
      *'"'*) ;;
      *)
        if [ "${#resp}" -gt "$OUTPUT_SCAN_MAX_BYTES" ]; then
          ag_output_lc_all_set=${LC_ALL+x}
          ag_output_lc_all_saved=${LC_ALL-}
          LC_ALL=C
          export LC_ALL
          redact_tool_output_response conservative
          ag_output_response_status=$?
          if [ "$ag_output_lc_all_set" = x ]; then
            LC_ALL=$ag_output_lc_all_saved
          else
            unset LC_ALL
          fi
          return "$ag_output_response_status"
        fi
        ;;
    esac
  fi
  redact_tool_output_response
}

# Same shell, never $( ): the conservative rewrite may end the hook itself
# (recovery `exit 0` or block_failed_output_rewrite).
rewrite_out_conservatively() {
  rewrite_response_conservatively "$out"
  out=$SAFE_REWRITE
  conservative_done=1
}

# $1 = conservative when the caller found $resp quote-free and over the scan cap.
redact_tool_output_response() {
  resp_full=''
  conservative_done=0
  if [ "${1:-}" = conservative ]; then
    whole_leaf_response=$resp
    rewrite_current_response_conservatively
    resp=$SAFE_REWRITE
    conservative_done=1
  fi
  # Image and PDF payloads are lifted out before every pass below and put back
  # afterwards: a text scanner cannot read pixels, the host forwards the bytes
  # rather than showing them to the model, and one screenshot alone crosses
  # the scan cap. Every pass preserves structure, so the paths collected here
  # are still valid on the rewritten result. The token gate spares large
  # high-cardinality output the path collection.
  case "$resp" in
    *base64*|*mimeType*)
      r=
      if r=$(printf '%s' "$resp" \
        | jq -c "$JQ_SHAPE_SAFE_WALK"'strip_binary_payloads' 2>/dev/null); then
        if [ -n "$r" ] && [ "$r" != "$resp" ]; then
          resp_full=$resp
          resp=$r
        fi
      else
        r=
        rewrite_response_conservatively "$resp"
        resp=$SAFE_REWRITE
        conservative_done=1
      fi
      ;;
  esac

  out=$resp
  did_secret=0; did_pii=0

  [ "$conservative_done" -eq 1 ] && did_secret=1

  if [ "$secrets_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    r=
    if ! r=$(redact_nul_response_json "$out"); then
      r=
      rewrite_out_conservatively; did_secret=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_secret=1
    fi
    if [ "$conservative_done" -eq 0 ] \
        && { output_scan_input_exceeds_cap "$out" \
          || large_response_has_secretish_assignment "$out" "$output_bytes"; }; then
      rewrite_out_conservatively; did_secret=1
    elif [ "$conservative_done" -eq 0 ]; then
      secret_bundle=
      secret_scan_view=$out
      if [ "$redact_figma_tool" -eq 1 ]; then
        secret_scan_view=$(figma_file_key_scan_view "$out")
      fi
      if ! secret_bundle=$(detect_output_secret_bundle "$secret_scan_view"); then
        secret_bundle=
        rewrite_out_conservatively; did_secret=1
      elif [ -n "$secret_bundle" ]; then
        if ! classify_secret_bundle "$secret_bundle" \
            || [ "$BUNDLE_MODE" = whole_leaf ]; then
          rewrite_out_conservatively; did_secret=1
        elif [ "$BUNDLE_SECRETS" != '[]' ]; then
          secrets=$BUNDLE_SECRETS
          r=
          if ! r=$(redact_tool_response_json "$out" "$secrets"); then
            r=
          fi
          if [ -z "$r" ] || [ "$r" = "$out" ]; then
            rewrite_response_conservatively "$out"
            r=$SAFE_REWRITE
            conservative_done=1
          fi
          if [ -n "$r" ] && [ "$r" != "$out" ]; then out=$r; did_secret=1; fi
        fi
      fi
    fi
  fi

  if [ "$pii_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    trusted=
    if ! trusted=$(trusted_live_probe_replacements "$out"); then
      trusted='[]'
    fi
    case "$trusted" in ''|null) trusted='[]' ;; esac
    r=
    if ! r=$(mask_pii_response_json "$out" "$trusted"); then
      r=
      rewrite_out_conservatively; did_pii=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_pii=1
    fi
  fi

  if [ "$secrets_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    live_probe_id=
    if ! live_probe_id=$(live_probe_run_id); then
      live_probe_id=
    fi
    live_failed=0
    r=
    if ! r=$(redact_live_probe_response_json "$out" "$live_probe_id"); then
      r=
      live_failed=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      if ! response_drops_live_probe "$r"; then
        r=''
        live_failed=1
      elif [ -n "$live_probe_id" ] && ! audit_mark_live_probe; then
        # Provenance could not be persisted. Recompute without an id so a failed
        # marker cannot produce a replacement that later appears trustworthy.
        r=
        if ! r=$(redact_live_probe_response_json "$out" ''); then
          r=
          live_failed=1
        elif [ -z "$r" ] || [ "$r" = "$out" ] \
            || ! response_drops_live_probe "$r"; then
          r=''
          live_failed=1
        fi
      fi
    fi
    if [ "$live_failed" -eq 1 ]; then
      rewrite_out_conservatively; did_secret=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_secret=1
    fi
  fi

  [ "$did_secret" -eq 1 ] || [ "$did_pii" -eq 1 ] || return 0
  audit_note masked

  if [ -n "$resp_full" ]; then
    # Both documents ride stdin because the payloads are exactly the strings
    # that exceed Linux's ~128 KiB exec-argument limit. A bare "[REDACTED]"
    # fallback has no block to restore into and stands as-is.
    r=
    if r=$({ printf '%s\n%s\n' "$resp_full" "$out"; } 2>/dev/null \
      | jq -sc "$JQ_SHAPE_SAFE_WALK"'
          .[0] as $orig | .[1] | restore_binary_payloads($orig)
        ' 2>/dev/null); then
      [ -n "$r" ] && out=$r
    else
      r=
    fi
  fi

  emit_post_tool_replacement "$out"

  tool=
  if ! tool=$(json_value '.tool_name // "tool"' "$input"); then
    tool=tool
  fi
  if [ "${POST_TOOL_SHAPE_KEPT:-}" = 0 ]; then
    info "$PROGRAM: replaced $tool output to hide sensitive values, but the replacement changes a field the host checks; the host may reject it and pass the original output unchanged"
  elif [ "$did_secret" -eq 1 ] && [ "$did_pii" -eq 1 ]; then
    info "$PROGRAM: masked secret-like values and PII in $tool output"
  elif [ "$did_pii" -eq 1 ]; then
    info "$PROGRAM: masked PII in $tool output"
  else
    info "$PROGRAM: masked secret-like values in $tool output"
  fi
  REDACT_OUTPUT_EMITTED=1
  return 0
}

# --- PostToolUse: scan the path this tool call actually wrote ----------------
# The working-tree backstop is git-shaped. `git diff` and `git ls-files --others
# --exclude-standard` both skip ignored paths, and neither reaches past the
# repository boundary, so a write to an ignored path, into another repository,
# or with no repository at all landed with no backstop behind it.
#
# PostToolUse knows the path the tool just wrote, so that ONE file is scanned
# directly when git would not have reached it. The scope is deliberately this
# tool call's target and nothing else: sweeping every ignored file would report
# the operator's own local credential files on every write, and an alert nobody
# can act on is how a scanner gets turned off.

# SCAN_INPUT_MAX_BYTES (10 MiB by default). PostToolUse gets ~20s from the host
# and a killed hook fails OPEN, so an unbounded file is a timeout, not a scan.
# Over-cap follows the same infrastructure policy as any other scan that could
# not run.
POST_TOOL_PATH_SCAN_MAX_BYTES=$SCAN_INPUT_MAX_BYTES

post_tool_write_target() {
  case "$2" in
    Write|Edit|MultiEdit|NotebookEdit)
      tool_write_path "$1" "$2" ;;
    apply_patch)
      patch=$(tool_patch_text "$1" 2>/dev/null) || return "$SCAN_STATUS_UNAVAILABLE"
      [ -n "$patch" ] || return "$SCAN_STATUS_UNAVAILABLE"
      printf '%s\n' "$patch" | LC_ALL=C awk '
        /^\*\*\* Delete File:/ { valid=1; next }
        /^\*\*\* (Add|Update) File:/ {
          path=$0; sub(/^\*\*\* (Add|Update) File:[ \t]*/, "", path)
          if (path == "") bad=1; else { count++; if (count > 128) exit 3; print path; valid=1 }
          next
        }
        /^\*\*\* Move to:/ {
          path=$0; sub(/^\*\*\* Move to:[ \t]*/, "", path)
          if (path == "") bad=1; else { count++; if (count > 128) exit 3; print path; valid=1 }
          next
        }
        END { if (bad || !valid) exit 3 }
      '
      ;;
  esac
}

# 0 = the working-tree backstop already covered this path, 1 = it did not.
# Anything that cannot be established (no repository, a different repository, a
# failed check) counts as NOT covered, so the direct scan runs rather than being
# skipped on a guess.
git_backstop_covers_path() {
  covers_path=$1
  covers_root=$2
  [ -n "$covers_root" ] || return 1
  covers_dir=$(dirname -- "$covers_path")
  [ -d "$covers_dir" ] || return 1
  covers_file_root=$(git -C "$covers_dir" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ "$covers_file_root" = "$covers_root" ] || return 1
  # Ignore status alone is not coverage: `git update-index --skip-worktree` and
  # `--assume-unchanged` leave a tracked file un-ignored while `git diff HEAD`
  # stops reporting it, so both scanners missed it. One `ls-files -v` answers
  # tracking, index state, and ignore status together, in place of the
  # check-ignore call rather than in addition to it.
  #   'H ' tracked and honored     -> `git diff HEAD` reports it, ignored or not
  #   '? ' untracked, not ignored  -> `ls-files --others` reports it
  # Everything else is uncovered and falls through to the direct scan: no line
  # at all (ignored and untracked, or a failed call), 'S ' (skip-worktree), a
  # lowercase letter (assume-unchanged), or any other index state.
  covers_state=$(git -C "$covers_dir" ls-files -v --cached --others \
    --exclude-standard -- "$covers_path" 2>/dev/null) || return 1
  case "$covers_state" in
    'H '*|'? '*) return 0 ;;
  esac
  return 1
}

scan_write_target_path() {
  target=$1
  scanned_root=$2
  [ -n "$target" ] || return 0
  # Resolve first: a symlink parked in an ignored directory must not launder
  # its target, and a link to a device or fifo must not become a blocking read.
  target=$(resolve_path "$(normalize_path "$target")")
  [ -f "$target" ] || return 0
  git_backstop_covers_path "$target" "$scanned_root" && return 0

  # An unreadable file makes `wc -c` fail and yields no count. Treating a
  # missing count as over-cap keeps both cases on the infrastructure policy
  # instead of silently reporting a clean scan that never happened.
  target_bytes=$(LC_ALL=C wc -c <"$target" 2>/dev/null | tr -d '[:space:]')
  case "$target_bytes" in
    ''|*[!0-9]*) return "$SCAN_STATUS_UNAVAILABLE" ;;
  esac
  if [ "$target_bytes" -gt "$POST_TOOL_PATH_SCAN_MAX_BYTES" ]; then
    info "$PROGRAM: $target is too large to scan within the hook timeout (limit $POST_TOOL_PATH_SCAN_MAX_BYTES bytes; AGENT_GUARD_SCAN_INPUT_MAX_BYTES raises it)"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi

  target_snapshot=$(mktemp_file) || return "$SCAN_STATUS_UNAVAILABLE"
  if cat -- "$target" >"$target_snapshot"; then
    filter_lockfile_hashes "$target" "$target_snapshot" \
      | run_gitleaks_stdin "file written by the tool: $target"
    target_status=$?
  else
    target_status=$SCAN_STATUS_UNAVAILABLE
  fi
  rm -f "$target_snapshot"
  return "$target_status"
}

# Scan one written target from the tool's workdir in a subshell, so the cd and
# every exit stay local: 0 = clean, 1 = findings, anything else = not scanned.
post_tool_scan_target() (  # $1 = target, $2 = workdir, $3 = trust_git_backstop
  [ -z "$2" ] || CDPATH= cd -- "$2" 2>/dev/null \
    || exit "$SCAN_STATUS_UNAVAILABLE"
  scanned_root=
  [ "$3" -eq 1 ] && scanned_root=$(git rev-parse --show-toplevel 2>/dev/null) || scanned_root=
  scan_write_target_path "$1" "$scanned_root"
)

# The working-tree backstop from the tool's workdir, with the same status
# contract; outside a repository there is nothing to scan (clean).
scan_working_tree_in() (  # $1 = workdir
  [ -z "$1" ] || CDPATH= cd -- "$1" 2>/dev/null \
    || exit "$SCAN_STATUS_UNAVAILABLE"
  inside_git_repo || exit 0
  scan_working_tree
)

scan_post_tool_write_target() {
  input=$1
  tool=$2
  workdir=$3
  trust_git_backstop=${4:-0}
  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit)
      if printf '%s' "$input" | jq -e '
        (.tool_input.file_path // .tool_input.path //
         .tool_input.notebook_path // "") as $p |
        ($p | type) == "string" and ($p | explode | any(. < 32))
      ' >/dev/null 2>&1; then
        handle_git_infrastructure_failure "$input" \
          "$PROGRAM: the file path written by this tool call contains unsupported control characters;"
        return 0
      fi
      target=$(post_tool_write_target "$input" "$tool")
      target_extract_status=$?
      if [ "$target_extract_status" -ne 0 ]; then
        handle_git_infrastructure_failure "$input" \
          "$PROGRAM: the file path written by this tool call could not be determined;"
        return 0
      fi
      [ -n "$target" ] || return 0
      post_tool_scan_target "$target" "$workdir" "$trust_git_backstop"
      case "$?" in
        0) return 0 ;;
        1) info "$PROGRAM: the file this tool call wrote contains secret-like values"; return 1 ;;
        *)
          handle_git_infrastructure_failure "$input" \
            "$PROGRAM: the file this tool call wrote could not be scanned;"
          return 0
          ;;
      esac
      ;;
  esac
  targets=$(post_tool_write_target "$input" "$tool")
  target_extract_status=$?
  [ "$target_extract_status" -eq 0 ] || {
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be determined;"
    return 0
  }
  [ -n "$targets" ] || return 0
  targets_file=$(mktemp_file) || {
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be scanned;"
    return 0
  }
  printf '%s\n' "$targets" >"$targets_file" || {
    rm -f "$targets_file"
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be scanned;"
    return 0
  }
  target_result=0
  target_total_bytes=0
  target_count=0
  while IFS= read -r target || [ -n "$target" ]; do
    [ -n "$target" ] || continue
    target_count=$((target_count + 1))
    if [ "$target_count" -gt 128 ]; then
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    one_bytes=$(
      [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null || exit 3
      resolved_target=$(resolve_path "$(normalize_path "$target")")
      scanned_root=
      [ "$trust_git_backstop" -eq 1 ] && scanned_root=$(git rev-parse --show-toplevel 2>/dev/null) || scanned_root=
      if git_backstop_covers_path "$resolved_target" "$scanned_root"; then
        printf covered
        exit 0
      fi
      if [ -f "$resolved_target" ]; then
        LC_ALL=C wc -c <"$resolved_target" 2>/dev/null | tr -d '[:space:]'
      else
        printf 0
      fi
    )
    size_status=$?
    [ "$one_bytes" != covered ] || continue
    case "$one_bytes" in ''|*[!0-9]*) size_status=3 ;; esac
    if [ "$size_status" -ne 0 ]; then
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    [ -n "$one_bytes" ] && target_total_bytes=$((target_total_bytes + one_bytes))
    if [ "$target_total_bytes" -gt "$POST_TOOL_PATH_SCAN_MAX_BYTES" ]; then
      info "$PROGRAM: apply_patch direct-scan targets exceed the scan input limit of $POST_TOOL_PATH_SCAN_MAX_BYTES bytes; raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES only within the host hook timeout"
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    post_tool_scan_target "$target" "$workdir" "$trust_git_backstop"
    target_status=$?
    case "$target_status" in
      0) ;;
      1) target_result=1 ;;
      *) [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE" ;;
    esac
  done <"$targets_file"
  rm -f "$targets_file"
  case "$target_result" in
    0) return 0 ;;
    1)
      info "$PROGRAM: the file this tool call wrote contains secret-like values"
      return 1
      ;;
    *)
      handle_git_infrastructure_failure "$input" \
        "$PROGRAM: the file this tool call wrote could not be scanned;"
      ;;
  esac
}

hook_post_tool() {
  input=$(read_stdin)
  HOOK_EVENT=PostToolUse
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    # The object check itself still runs here: its failure is what selects the
    # validation-recovery path below, which must stay reachable on its own.
    # Refuse an over-limit input before the call copies it ('' resets alike).
    # Inline, not a helper: in dash each function definition costs every hook.
    if [ "${#input}" -le 262144 ]; then json_value_prime "$input" measured; else json_value_prime ''; fi
    if ! printf '%s' "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
      if recover_post_tool_validation_failure "$input"; then
        return 0
      fi
      validate_hook_object PostToolUse "$input" || return 0
    fi
  fi
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning PostToolUse "$input"
    return 0
  fi
  need_cmd jq
  [ -n "$input" ] || return 0

  # Same recovery PreToolUse does (#227). A host may serialize tool_input as a
  # JSON-encoded string; the precise-field extractors then find nothing, so
  # `post_tool_write_target` yielded an empty path and the direct file scan was
  # skipped without a word — a gitignored or out-of-repo write got neither the
  # git backstop nor the direct scan. Only an object is substituted, matching
  # PreToolUse: a string that decodes to an array/scalar, or to nothing, is left
  # alone so the generic string-leaf scanners still see it.
  json_value_to "$JV_INPUT_TYPE" "$input"
  if [ "$jv_out" = "string" ]; then
    input=$(printf '%s' "$input" \
      | jq -c '(.tool_input | try fromjson catch null) as $decoded
               | if ($decoded | type) == "object" then .tool_input = $decoded else . end')
    HOOK_INPUT=$input
  fi

  json_value_to "$JV_TOOL" "$input"
  tool=$jv_out
  json_value_to "$JV_WORKDIR" "$input"
  workdir=$jv_out

  # Mutation tools keep the working-tree backstop. It runs first so a secret
  # written to disk is recorded even when the same event also needs an output
  # rewrite; a disk-only finding still exits 2 below.
  post_tool_disk_finding=0
  if is_mutation_tool "$tool"; then
    git_backstop_ok=0
    if ! command -v git >/dev/null 2>&1; then
      handle_git_infrastructure_failure "$input" \
        "$PROGRAM: git is unavailable, so changed files could not be scanned;"
    else
      scan_working_tree_in "$workdir"
      status=$?
      case "$status" in
        0) git_backstop_ok=1 ;;
        1)
          info "$PROGRAM: changed files contain secret-like values after tool execution"
          audit_note blocked
          post_tool_disk_finding=1
          ;;
        *)
          handle_git_infrastructure_failure "$input" \
            "$PROGRAM: changed files could not be scanned after tool execution;"
          ;;
      esac
    fi
    # Second backstop for what the git-shaped one structurally cannot see.
    scan_post_tool_write_target "$input" "$tool" "$workdir" "$git_backstop_ok"
    post_target_status=$?
    if [ "$post_target_status" -eq 1 ]; then
      audit_note blocked
      post_tool_disk_finding=1
    fi
  fi

  # All matched tools: mask secret-like values (and PII, when
  # AGENT_GUARD_PII_HOOK_MODE=mask) using the selected host's output contract.
  redact_tool_output "$input" "$tool"
  if [ "$post_tool_disk_finding" -eq 1 ] \
    && [ "$REDACT_OUTPUT_EMITTED" -eq 0 ]; then
    exit 2
  fi
}

# --- hook-post-tool-failure: report secrets in a failed tool's output --------
# Claude Code fires PostToolUseFailure, not PostToolUse, when a tool fails, and
# its `error` string is generally the failed result as the model reads it. The
# host lets this event add context only: updatedToolOutput, decision "block"
# and exit 2 all leave the error text unchanged (anthropics/claude-code#97278).
# So this hook cannot mask or block. It runs the detectors that mask a
# successful result and, on a finding, tells the model by category only that a
# secret-like value reached it unmasked. A scan that could not run is reported
# as such, never as clean. Every message below is a fixed string: no value,
# path, rule text or tool name from the event is echoed.

post_tool_failure_context() {
  printf '{"hookSpecificOutput":{"hookEventName":"PostToolUseFailure","additionalContext":"%s"}}\n' "$1"
}

# Nothing can be blocked, so the closed policy has no exit 2 to give. It
# reports every unverified failure to the model instead of only the first one
# per session, which is what the open policy does.
post_tool_failure_unverified() {
  if [ "$(infrastructure_failure_mode)" = closed ]; then
    audit_note degraded
    unverified_message="$2 the failed tool output was NOT checked for secret-like values and was not masked. A failed tool result cannot be blocked or replaced, so this is reported because AGENT_GUARD_INFRA_FAILURE_MODE=closed."
    info "$unverified_message"
    post_tool_failure_context "$unverified_message"
    return 0
  fi
  handle_hook_infrastructure_failure PostToolUseFailure "$1" "$2"
}

hook_post_tool_failure() {
  input=$(read_stdin)
  HOOK_EVENT=PostToolUseFailure
  HOOK_INPUT=$input
  [ -n "$input" ] || return 0
  # The same switch that turns off masking of successful tool output.
  output_redact_enabled || return 0
  # A malformed envelope cannot be inspected, and exit 2 would block nothing:
  # the tool already failed. Pass it through with a diagnostic.
  if command -v jq >/dev/null 2>&1 \
    && ! printf '%s' "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
    audit_note error
    info "$PROGRAM: the PostToolUseFailure hook input was not a JSON object; passing it through unchecked because a failed tool result cannot be blocked"
    return 0
  fi
  if ! hook_dependencies_ready; then
    post_tool_failure_unverified "$input" "$(degraded_hook_message)"
    return 0
  fi
  # The output detectors take the value as a JSON string. An event without an
  # error field is not one this hook knows, so it passes through.
  if ! failure_output=$(printf '%s' "$input" | jq -c '
      .error | if . == null then empty
               elif type == "string" then .
               else tojson end' 2>/dev/null); then
    post_tool_failure_unverified "$input" \
      "$PROGRAM: the failed tool output could not be parsed;"
    return 0
  fi
  case "$failure_output" in ''|'""') return 0 ;; esac
  # The detector treats an over-cap value as one whole-leaf secret. That is
  # right for a rewrite, but here it would report an exposure nobody saw.
  if output_scan_input_exceeds_cap "$failure_output"; then
    post_tool_failure_unverified "$input" \
      "$PROGRAM: the failed tool output exceeds the output scan cap;"
    return 0
  fi
  if is_figma_mcp_tool "$(json_value '.tool_name // empty' "$input" 2>/dev/null)"; then
    failure_output=$(figma_file_key_scan_view "$failure_output")
  fi
  failure_bundle=
  if ! failure_bundle=$(detect_output_secret_bundle "$failure_output") \
    || ! classify_secret_bundle "$failure_bundle"; then
    post_tool_failure_unverified "$input" \
      "$PROGRAM: the failed tool output could not be scanned;"
    return 0
  fi
  if [ "$BUNDLE_MODE" != whole_leaf ] && [ "$BUNDLE_SECRETS" = '[]' ]; then
    return 0
  fi
  audit_note warned
  info "$PROGRAM: a failed tool's output contains secret-like values; they reached the model unmasked because Claude Code cannot replace a failed tool result"
  post_tool_failure_context "$PROGRAM: the output of this failed tool call contains a secret-like value (category: secret-like value, found by the detectors that mask successful tool output). It was NOT masked: Claude Code does not let a PostToolUseFailure hook replace a failed tool's output (host limit, anthropics/claude-code#97278). Do not repeat, quote, transform, or use that value in any reply or later tool call. Tell the user that a credential may have been exposed in a failed tool result and may need rotating."
}

hook_stop() {
  input=$(read_stdin)
  HOOK_EVENT=Stop
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    validate_hook_object Stop "$input" || return 0
  fi
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning Stop "$input"
    return 0
  fi
  need_cmd jq
  if [ -n "$input" ]; then
    active=$(json_value '.stop_hook_active // false' "$input")
    if [ "$active" = "true" ]; then
      info "$PROGRAM: stop hook already active; skipping repeat scan to avoid a loop"
      return 0
    fi
  fi

  if ! command -v git >/dev/null 2>&1; then
    handle_hook_infrastructure_failure Stop "$input" \
      "$PROGRAM: git is unavailable, so changed files could not be scanned before stop;"
    return 0
  fi
  workdir=$(json_value "$JV_WORKDIR" "$input")
  scan_working_tree_in "$workdir"
  status=$?
  case "$status" in
    0) return 0 ;;
    1) info "$PROGRAM: changed files contain secret-like values before stop"; exit 2 ;;
    *)
      handle_hook_infrastructure_failure Stop "$input" \
        "$PROGRAM: changed files could not be scanned before stop;"
      ;;
  esac
}

# --- hook-user-prompt: keep pasted secrets out of the model context -----------
# The tool hooks never see the USER's own prompt, so a pasted `.env` or API key
# reaches the model API and the on-disk transcript unscanned. UserPromptSubmit
# fires before that happens on both hosts. Neither host documents a way for a
# hook to REWRITE the submitted prompt (Claude's UserPromptSubmit supports only
# block/deny and added context; Codex documents block + context), so `mask` is
# accepted as a mode but degrades to block everywhere today. It exists so a
# configured preference survives a future host that adds prompt rewriting.

prompt_guard_mode() {
  case "${AGENT_GUARD_PROMPT_GUARD_MODE:-block}" in
    block|mask|warn|off) printf '%s' "${AGENT_GUARD_PROMPT_GUARD_MODE:-block}" ;;
    *) die "unsupported prompt guard mode: ${AGENT_GUARD_PROMPT_GUARD_MODE} (expected off, block, mask, or warn)" ;;
  esac
}

# Detection = gitleaks (rule-based) OR the streaming secret-ish KEY=value
# assignment probe. The probe is what catches a pasted .env whose custom value
# formats gitleaks has no rule for — the single most common prompt-leak shape.
prompt_has_secretish_assignment() {
  # Check each stage before consuming its output: a POSIX pipeline otherwise
  # turns producer/detector failure into grep's ordinary no-match status.
  # Framing ends with RS, so command substitution preserves its trailing LFs.
  prompt_assignment_framed=$(printf '%s' "$1" | frame_plaintext_leaf 2>/dev/null) || return 2
  prompt_assignment_result=$(printf '%s' "$prompt_assignment_framed" | secretish_env_values probe) || return 2
  [ -n "$prompt_assignment_result" ]
}

# Claude Code also runs UserPromptSubmit on messages nobody typed: a background
# task's notification, a subagent's hand-back, another session's message. A
# block drops them before the model sees them, and the block reason reaches
# only the user, so the session that waited for the report never learns it was
# lost. The hook input has no origin field, so the frame is recognized from the
# prompt text alone. It labels the block and nothing else: the frame can be
# typed, so it must never relax the scan.
#
# Prints `<label>|<recovery hint>`, or nothing for an ordinary prompt. Ids
# and the output path are echoed only when they match a strict shape, because
# the hint is later shown to the model.
injected_prompt_frame() {
  printf '%s\n' "$1" | LC_ALL=C awk -v anon="${2:-}" '
    NR == 1 {
      if ($0 == "<task-notification>") { kind = "task"; next }
      if ($0 ~ /^<agent-message from="[A-Za-z0-9_-]+">$/) {
        kind = "message"; from = substr($0, 22, length($0) - 23)
        if (anon != "" || length(from) > 32) from = ""
        next
      }
      exit
    }
    kind == "message" && NR == 2 && /^\[Subagent hand-back\]/ { kind = "handback" }
    kind == "task" && /^<task-id>[A-Za-z0-9_-]+<\/task-id>$/ {
      id = substr($0, 10, length($0) - 19)
      if (anon != "" || length(id) > 32) id = ""
    }
    kind == "task" && anon == "" && /^<output-file>\/[A-Za-z0-9._\/-]+<\/output-file>$/ {
      path = substr($0, 14, length($0) - 27)
      if (length(path) > 512) path = ""
    }
    END {
      if (kind == "task") {
        if (id == "") { printf "a background task notification|check the task output file directly\n"; exit }
        suffix = "/tasks/" id ".output"
        target = "that task output file"
        if (path != "" && path !~ /\/\.\.?\// &&
            substr(path, length(path) - length(suffix) + 1) == suffix)
          target = path
        printf "a background task notification (task %s)|read %s with the Read tool, which masks secret-like values\n", id, target
      } else if (kind == "handback") {
        if (from == "") printf "a subagent hand-back|ask the agent that sent it to resend its report without the credential values\n"
        else printf "a subagent hand-back from agent %s|ask agent %s to resend its report without the credential values\n", from, from
      } else if (kind == "message") {
        if (from == "") printf "a message from another agent or session|ask its sender to resend it without the credential values\n"
        else printf "a message from agent or session %s|ask %s to resend it without the credential values\n", from, from
      }
    }'
}

# The single hook response, whatever combination of facts produced it. A hook
# may write at most one top-level JSON object, so every notice and the
# mode-specific message share one: additionalContext (the model-facing channel
# both hosts document) carries them all, and on Claude systemMessage carries
# what the user must see: the infrastructure notice ($3) and the mode-specific
# message. Claude Code shows neither exit-0 stderr nor additionalContext to the
# user, so this is the same user-facing channel handle_hook_infrastructure_failure
# uses; Codex keeps additionalContext only (see there). A queued blocked-
# injection notice is addressed to the model and stays out of systemMessage.
# Prints nothing when there is nothing to say.
emit_prompt_response() {
  notice=$1
  message=$2
  if [ -n "$notice" ] && [ -n "$message" ]; then
    context="$notice $message"
  else
    context="$notice$message"
  fi
  [ -n "$context" ] || return 0
  shown=${3:-}
  if [ -n "$shown" ] && [ -n "$message" ]; then
    shown="$shown $message"
  else
    shown="$shown$message"
  fi
  if [ -n "$shown" ] && [ "$(hook_host)" != codex ]; then
    jq -nc --arg m "$shown" --arg c "$context" \
      '{systemMessage: $m,
        hookSpecificOutput: {hookEventName: "UserPromptSubmit",
                             additionalContext: $c}}'
  else
    jq -nc --arg c "$context" \
      '{hookSpecificOutput: {hookEventName: "UserPromptSubmit",
                             additionalContext: $c}}'
  fi
}

# Blocks a recognized injected message with a reason that names what was lost,
# and queues a notice for the model's next passing prompt. Returns for an
# ordinary prompt. `continue: false` would reach the model sooner, but Claude
# Code then keeps the blocked prompt text in the conversation.
block_injected_prompt() {
  case $2 in
    '<task-notification>'*|'<agent-message from="'*) ;;
    *) return 0 ;;
  esac
  frame=$(injected_prompt_frame "$2") || frame=
  [ -n "$frame" ] || return 0
  # Ids and the path are echoed to the model, so drop them if they themselves
  # look secret-like or the check cannot run.
  if ! injected_frame_is_clean "$frame"; then
    frame=$(injected_prompt_frame "$2" anon) || frame=
    [ -n "$frame" ] || return 0
  fi
  label=${frame%%'|'*}
  hint=${frame#*'|'}
  if state=$(private_warning_state_path blocked-injection "$1"); then
    (umask 077
     printf '%s: blocked %s earlier in this session because it contained %s, so its text never reached you. To recover it, %s.\n' \
       "$PROGRAM" "$label" "$3" "$hint" >>"$state") 2>/dev/null || :
  fi
  info "$PROGRAM: blocked $label before it reached the model: it contains $3. It is framed as a message the host injected, so nobody will resubmit it; to recover it, $hint."
  exit 2
}

injected_frame_is_clean() {
  scan_text_direct "injected message label" "$1" >/dev/null 2>&1 || return 1
  frame_probe_status=0
  prompt_has_secretish_assignment "$1" 2>/dev/null || frame_probe_status=$?
  [ "$frame_probe_status" -eq 1 ]
}

# Sets INJECTION_NOTICE to the queued notices (the last ten) and clears the
# queue. The glob keeps the common no-queue case free of a jq parse.
take_blocked_injection_notice() {
  INJECTION_NOTICE=
  set -- "$1" "$(warning_root)"/blocked-injection-*
  [ -e "$2" ] || return 0
  if state=$(private_warning_state_path blocked-injection "$1") && [ -s "$state" ]; then
    INJECTION_NOTICE=$(tail -n 10 "$state" 2>/dev/null | tr '\n' ' ') || INJECTION_NOTICE=
    INJECTION_NOTICE=${INJECTION_NOTICE% }
    rm -f "$state"
  fi
}

hook_user_prompt() {
  input=$(read_stdin)
  HOOK_EVENT=UserPromptSubmit
  HOOK_INPUT=$input
  # Validate the prompt mode in the main shell (die inside $() would only exit
  # the subshell and silently fail-open).
  prompt_guard_mode >/dev/null
  pii_hook_mode
  pii_skip_set
  prompt_mode=$(prompt_guard_mode)
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning UserPromptSubmit "$input"
    return 0
  fi
  need_cmd jq
  [ -n "$input" ] || return 0
  # A jq failure is an infrastructure failure, not an empty benign prompt.
  # Check the substitution in the parent shell so the closed policy can block;
  # the default open policy emits one host-shaped notice and returns.
  if ! prompt=$(json_value '.prompt // empty' "$input" 2>/dev/null); then
    begin_infrastructure_failure "$input" \
      "$PROGRAM: the prompt hook input could not be parsed;"
    notice=$INFRA_FAILURE_NOTICE
    emit_prompt_response "$notice" '' "$notice"
    return 0
  fi
  [ -n "$prompt" ] || return 0

  # The PII input gate is governed by AGENT_GUARD_PII_HOOK_MODE alone and stays
  # active even when the secret guard is off: block mode blocks any PII; mask
  # mode hard-blocks Tier-2. Tier-1 PII cannot be masked in a prompt (no host
  # rewrite exists), a documented limitation.
  block_on_pii_text "user prompt" "$prompt"
  [ "$prompt_mode" != off ] || return 0

  # An infrastructure notice raised here is ACCUMULATED, not printed: warn mode
  # still has its own response to write, and two concatenated top-level objects
  # are not a valid hook response — a host that parses stdout as one document
  # drops the warning entirely, exactly when the scanner is already degraded.
  # emit_prompt_response folds both messages into the single allowed object.
  notice=
  found=0
  found_reason=
  scan_text_direct "user prompt" "$prompt"
  case $? in
    0) ;;
    1) found=1; found_by='a value matching a gitleaks rule'; found_reason=secret-rule ;;
    "$SCAN_STATUS_UNAVAILABLE")
      begin_infrastructure_failure "$input" \
        "$PROGRAM: scanner infrastructure could not verify the prompt;"
      notice=$INFRA_FAILURE_NOTICE
      ;;
    *)
      begin_infrastructure_failure "$input" \
        "$PROGRAM: the prompt scanner failed;"
      notice=$INFRA_FAILURE_NOTICE
      ;;
  esac
  if [ "$found" -eq 0 ]; then
    # The assignment probe is super-linear on one large leaf (measured ~0.6s at
    # 128KB but ~23s at 874KB), which would burn the 10s host timeout and make
    # the host kill the hook — a silent fail-open. Above the shared scan cap,
    # skip the probe and route through the infra-failure policy instead:
    # open warns (at most once per interval) and keeps the gitleaks verdict; closed blocks.
    if output_scan_input_exceeds_cap "$prompt"; then
      begin_infrastructure_failure "$input" \
        "$PROGRAM: the prompt exceeds the assignment-probe scan cap (gitleaks rules were still applied);"
      notice=${notice:-$INFRA_FAILURE_NOTICE}
    else
      prompt_probe_status=0
      prompt_has_secretish_assignment "$prompt" || prompt_probe_status=$?
      case "$prompt_probe_status" in
        0) found=1; found_by='a secret-like KEY=value or key: value assignment'; found_reason=secret-assignment ;;
        1) ;;
        *)
          begin_infrastructure_failure "$input" \
            "$PROGRAM: the prompt assignment probe failed;"
          notice=${notice:-$INFRA_FAILURE_NOTICE}
          ;;
      esac
    fi
  fi
  infra_notice=$notice
  if [ "$found" -ne 1 ] || [ "$prompt_mode" = warn ]; then
    take_blocked_injection_notice "$input"
    notice=$INJECTION_NOTICE${INJECTION_NOTICE:+${notice:+ }}$notice
  fi
  if [ "$found" -ne 1 ]; then
    emit_prompt_response "$notice" '' "$infra_notice"
    return 0
  fi

  case "$prompt_mode" in
    warn)
      audit_note warned
      emit_prompt_response "$notice" \
        "$PROGRAM: the submitted prompt contains secret-like values; they were passed through because AGENT_GUARD_PROMPT_GUARD_MODE=warn" \
        "$infra_notice"
      return 0
      ;;
  esac
  audit_reason "$found_reason"
  block_injected_prompt "$input" "$prompt" "$found_by"
  case "$prompt_mode" in
    mask)
      info "$PROGRAM: no host supports rewriting a submitted prompt yet, so mask degrades to block; remove the secret-like values and resubmit"
      exit 2
      ;;
    *)
      info "$PROGRAM: blocked user prompt: it contains secret-like values; remove them and resubmit (AGENT_GUARD_PROMPT_GUARD_MODE controls this)"
      exit 2
      ;;
  esac
}

# --- hook-session-start: report degraded setup and shell-integration drift ----
# The plugin and the binary the shell integration (agx / command wrapping) resolves at
# runtime update independently, so updating one side silently leaves masking on
# the OLD rules while the hooks look current — an invisible failure. Instead of
# re-deriving which binary masks (a proxy this hook can't get right — it can't
# see the baked path, and would nag a CLI-on-$PATH user who never enabled the
# integration), `shell-init` EXPORTS the version it actually resolved at rc-eval
# time as $AGENT_GUARD_SHELL_INIT_VERSION; this hook just compares that marker to
# the plugin's own version. See README for the full false-pos/neg rationale.
#
# Env inheritance (verified against the Claude Code hooks docs): a command hook
# inherits the `claude` process env, which inherits the launching shell's
# exported vars — so the rc-set marker reaches this hook.
#
# SessionStart is non-mutating: it reports missing dependencies and directs the
# host to the approval-gated setup skill. Claude also reports shell-wrapper
# version drift; Codex ignores that unrelated shell boundary. The Codex variant
# duplicates host-independent warnings in additionalContext so the model can act
# on them; both hosts receive a user-facing systemMessage.

# Read one sh_squote word from $1, the text right after its opening quote, into
# $unsquoted. Fails when the word never closes.
shell_init_unsquote() {
  us_rest=$1 unsquoted=
  while :; do
    case "$us_rest" in *"'"*) ;; *) return 1 ;; esac
    unsquoted=$unsquoted${us_rest%%"'"*}
    us_rest=${us_rest#*"'"}
    case "$us_rest" in
      "\\''"*) unsquoted="$unsquoted'"; us_rest=${us_rest#"\\''"} ;;
      *) return 0 ;;
    esac
  done
}

# Classify `setup-shell`'s managed block in one rc file: 0 = the block is there
# AND can still load, 2 = the block is there but the binary it resolves is gone,
# 1 = no usable block at all.
#
# The marker only reaches this hook when the shell that LAUNCHED the agent
# evaluated that rc — which never happens for a fish (or any non-POSIX) login
# shell, or when Claude Code is started from a GUI/IDE launcher, even though
# Claude Code builds its `!`/Bash snapshot from bash or zsh and so DOES load the
# wrapping. An absent marker is therefore not evidence that the wrapping is
# missing. But the delimiters alone are not evidence that it LOADS either: the
# block's `eval` emits nothing when the binary it resolves has disappeared (cache
# updated, plugin uninstalled, block hand-edited), leaving neither the wrapping
# nor the marker — a silent, unprotected session. So re-run the block's OWN
# resolution order against the paths it baked in: the stable/self path, then the
# newest versioned binary under the plugin cache base, then `agent-guard` on
# $PATH. All stat-level; nothing is executed and no subshell is forked.
shell_init_rc_block_state() {
  rc_probe=$1
  # Both delimiters must be present, or the block is not a block (setup-shell
  # itself refuses to rewrite an unbalanced one).
  block=$(awk -v b="$SHELL_INIT_BLOCK_BEGIN" -v e="$SHELL_INIT_BLOCK_END" \
    '$0==b{inb=1;next} $0==e&&inb{found=1;inb=0;next} inb{print} END{exit !found}' \
    "$rc_probe" 2>/dev/null) || return 1
  # Current blocks source the resolver file setup-shell wrote, by `~/` path or,
  # in the earlier `if` form, by an sh_squote'd absolute path; older blocks
  # carry the resolver inline. A missing file loads nothing.
  rc_init=
  case "$block" in
    *"_agbin='"*) ;;
    *"; then . '"*)
      shell_init_unsquote "${block##*; then . \'}" || return 2
      rc_init=$unsquoted
      ;;
    *" . ~/"*)
      rc_init=${block##*" . ~/"}
      rc_init=$HOME/${rc_init%%[[:space:]]*}
      ;;
  esac
  if [ -n "$rc_init" ]; then
    [ -f "$rc_init" ] && [ -r "$rc_init" ] || return 2
    block=
    while IFS= read -r rc_init_line || [ -n "$rc_init_line" ]; do
      block="$block$rc_init_line
"
    done <"$rc_init"
  fi
  # Delimiters wrapping something that never invokes shell-init protect nothing.
  case "$block" in *shell-init*) ;; *) return 2 ;; esac

  # The baked words are emitted by sh_squote. A word that does not parse reads
  # as unresolvable — the safe direction: a false "run setup" is recoverable, a
  # false "you are protected" is not.
  agbin= agbase=
  case "$block" in
    *"_agbin='"*) shell_init_unsquote "${block#*_agbin=\'}" && agbin=$unsquoted ;;
  esac
  case "$block" in
    *"_agbase='"*) shell_init_unsquote "${block#*_agbase=\'}" && agbase=$unsquoted ;;
  esac
  [ -n "$agbin" ] && [ -x "$agbin" ] && return 0
  if [ -n "$agbase" ]; then
    for rc_cand in "$agbase"/[0-9]*.[0-9]*.[0-9]*/bin/agent-guard; do
      [ -x "$rc_cand" ] && return 0
    done
  fi
  command -v agent-guard >/dev/null 2>&1 && return 0
  return 2
}

# Choose the rc whose snapshot matters. setup-shell also consults the account
# login shell; if either reading says fish, it installs both POSIX rc files
# because the eventual bash/zsh snapshot choice is not visible while setup is
# running. The hook can likewise still receive a fish $SHELL. In that case one
# healthy rc cannot prove the unknown snapshot is protected, so require both.
# State 3 means exactly that partial fish coverage: rerunning setup-shell must
# restore both files before SessionStart can stay quiet.
shell_init_block_state() {
  [ -n "${HOME:-}" ] || return 1
  case "${SHELL:-}" in
    */bash) shell_init_rc_block_state "$HOME/.bashrc" ;;
    */fish)
      shell_init_rc_block_state "$HOME/.bashrc"
      bash_rc_state=$?
      shell_init_rc_block_state "$HOME/.zshrc"
      zsh_rc_state=$?
      [ "$bash_rc_state" -eq 0 ] && [ "$zsh_rc_state" -eq 0 ] && return 0
      [ "$bash_rc_state" -eq 1 ] && [ "$zsh_rc_state" -eq 1 ] && return 1
      if [ "$bash_rc_state" -eq 0 ] || [ "$zsh_rc_state" -eq 0 ]; then
        return 3
      fi
      return 2
      ;;
    *) shell_init_rc_block_state "$HOME/.zshrc" ;;
  esac
}

hook_session_start() {
  message=
  if ! hook_dependencies_ready || ! command -v git >/dev/null 2>&1; then
    message=$(degraded_hook_message)
  fi

  marker=${AGENT_GUARD_SHELL_INIT_VERSION:-}
  # Accept only a digit-led version token drawn from a safe charset: an empty or
  # unparseable marker fails quiet, and the charset keeps the hand-built JSON
  # below injection-safe (no quotes/backslashes/whitespace to escape).
  if [ "$(hook_host)" = claude ]; then
    case $marker in
      ''|[!0-9]*|*[!0-9A-Za-z.+-]*) ;;
      *)
        if [ "$marker" != "$VERSION" ]; then
          cli_ref_init
          drift="agent-guard plugin hooks are $VERSION but the Claude shell integration masks with $marker. Update whichever is older, then rerun $AG_CLI_REF_HOOK setup-shell."
          if [ -n "$message" ]; then message="$message $drift"; else message=$drift; fi
        fi
        ;;
    esac
  fi

  # Claude plugins cannot edit the user's shell rc during installation. Since 2.x
  # command wrapping is default-on, so an absent marker means the one-time shell
  # setup has not run — UNLESS the managed block is already in the rc AND can
  # still load, in which case the marker is merely unable to travel (fish/other
  # login shell, GUI or IDE launcher) while the snapshot still loads the
  # wrapping. Nagging there is a permanent false positive that rerunning
  # setup-shell cannot clear, so that case stays quiet and only the drift check
  # above is lost. A block that can no longer resolve its binary gets its own
  # wording: the user action is to restore the binary, not to discover setup.
  # Keep Codex silent: Claude shell snapshots are not a Codex command boundary.
  # A marker inherited from a shell that loaded earlier says nothing about the
  # rc a new snapshot reads, so a block that cannot load (2) or covers fish only
  # partly (3) still warns; with a marker, only "no block" (1) stays quiet.
  if [ "$(hook_host)" = claude ]; then
    shell_init_block_state
    block_state=$?
    [ -z "$marker" ] || [ "$block_state" -ne 1 ] || block_state=0
    # The standalone wording stays when `agent-guard` on PATH is this CLI; a
    # plugin-only install is told the path that actually runs.
    setup_shell_alt="$PROGRAM setup-shell for a standalone install"
    if [ "$block_state" -ne 0 ]; then
      cli_ref_init
      [ "$AG_CLI_REF_HOOK" = "$PROGRAM" ] || setup_shell_alt="$AG_CLI_REF_HOOK setup-shell"
    fi
    case $block_state in
      0) wrapping_setup= ;;
      2) wrapping_setup="agent-guard command wrapping is set up in your shell rc but can no longer load: the agent-guard binary that block resolves is gone (plugin cache updated, uninstalled, or the block was edited). Command output is NOT masked. Reinstall or update agent-guard, rerun /agent-guard:setup-shell (or $setup_shell_alt), then restart the shell and Claude Code." ;;
      3) wrapping_setup="agent-guard command wrapping for a fish shell does not cover both .bashrc and .zshrc, so the host snapshot may be unprotected. Command output is NOT masked unless the snapshot chose the surviving rc. Rerun /agent-guard:setup-shell (or $setup_shell_alt), then restart the shell and Claude Code." ;;
      *) wrapping_setup="agent-guard command wrapping is not loaded. Run /agent-guard:setup-shell (or $setup_shell_alt), then restart the shell and Claude Code. Use setup-shell --no-command-wrapping for a persistent opt-out." ;;
    esac
    if [ -n "$wrapping_setup" ]; then
      if [ -n "$message" ]; then message="$message $wrapping_setup"; else message=$wrapping_setup; fi
    fi
  fi

  [ -n "$message" ] || return 0
  case "$(hook_host)" in
    codex)
      printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$message" "$message"
      ;;
    *) printf '{"systemMessage":"%s"}\n' "$message" ;;
  esac
}

# --- exec: mask secrets/PII in a shell-escape command's captured output -------
# Threat model: in Claude Code, a `!`-prefixed command runs in the session shell
# and its OUTPUT is captured into the transcript and sent to the model, but NO
# agent-guard hook fires for `!` (a documented blind spot). The user is fine with
# the command running and seeing its output themselves; the risk is secret-bearing
# output reaching the model. `agent-guard exec` closes that gap: it first checks
# that masking is available (and fails closed before execution when it is not),
# then captures combined stdout+stderr, masks secret-like values (and PII, when
# enabled), prints the REDACTED text, and propagates the command's exit code.
# Capture is BUFFERED, so this is for NON-INTERACTIVE info
# commands (env / secret / config dumps), not TUIs or streaming programs.

# Apply collision-safe framed secret records from $2 to plaintext $1,
# de-duplicating context-aware mappings and sorting within each mapping class.
redact_plaintext_framed() {
  text=$1
  secret_file=$2
  printf '%s' "$text" | LC_ALL=C awk -v secret_file="$secret_file" '
    function add_mapping(literal, replacement, contextual, key) {
      key = contextual ":" length(literal) ":" literal \
        ":" length(replacement) ":" replacement
      if (length(literal) > 0 && !seen[key]) {
        seen[key] = 1
        lit[++count] = literal
        rep[count] = replacement
        ctx[count] = contextual
      }
    }
    function consume_record(value, tag, payload) {
      tag = substr(value, 1, 1)
      payload = substr(value, 2)
      if (tag == "S") add_mapping(payload, "[REDACTED]", 0)
      else if (tag == "L") pending_literal = payload
      else if (tag == "R") {
        add_mapping(pending_literal, payload, 1)
        pending_literal = ""
      }
    }
    function feed_framed(line, i, ch, n, pieces) {
      record_ended_at_boundary = 0
      # Without escape bytes every RS is structural. Consume whole spans
      # instead of repeatedly copying a long literal one byte at a time.
      # Escaped records retain the byte-wise state machine below.
      if (!escaped && index(line, escape) == 0) {
        n = split(line, pieces, boundary)
        for (i = 1; i < n; i++) {
          consume_record(record pieces[i])
          record = ""
        }
        record = record pieces[n]
        record_ended_at_boundary = (n > 1 && pieces[n] == "")
        if (!record_ended_at_boundary) record = record "\n"
        return
      }
      for (i = 1; i <= length(line); i++) {
        ch = substr(line, i, 1)
        if (escaped) {
          record = record ch
          escaped = 0
          record_ended_at_boundary = 0
        } else if (ch == escape) {
          escaped = 1
          record_ended_at_boundary = 0
        } else if (ch == boundary) {
          consume_record(record)
          record = ""
          record_ended_at_boundary = 1
        } else {
          record = record ch
          record_ended_at_boundary = 0
        }
      }
      if (!record_ended_at_boundary) record = record "\n"
    }
    BEGIN {
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
      while ((status = getline line < secret_file) > 0) feed_framed(line)
      close(secret_file)
      if (status < 0) read_error = 1
      for (i = 2; i <= count; i++) {
        value = lit[i]
        replacement = rep[i]
        contextual = ctx[i]
        j = i - 1
        while (j >= 1 &&
               (ctx[j] < contextual ||
                (ctx[j] == contextual &&
                 length(lit[j]) < length(value)))) {
          lit[j + 1] = lit[j]
          rep[j + 1] = rep[j]
          ctx[j + 1] = ctx[j]
          j--
        }
        lit[j + 1] = value
        rep[j + 1] = replacement
        ctx[j + 1] = contextual
      }
    }
    { buf = (NR == 1 ? $0 : buf ORS $0) }
    END {
      if (read_error) exit 2
      if (count > 256 || count * (length(buf) + 1) > 8000000) exit 3
      for (i = 1; i <= count; i++) {
        value = lit[i]
        replacement = rep[i]
        contextual = ctx[i]
        out = ""
        at = index(buf, value)
        while (at > 0) {
          after = substr(buf, at + length(value), 1)
          if (!contextual || after == "" || after == ORS ||
              after ~ /[ \t,;]/)
            out = out substr(buf, 1, at - 1) replacement
          else
            out = out substr(buf, 1, at - 1) value
          buf = substr(buf, at + length(value))
          at = index(buf, value)
        }
        buf = out buf
      }
      printf "%s", buf
    }
  '
}

# Literal (non-regex) replacement of every detected secret in $1 with [REDACTED],
# processing longest-first so a shorter secret that is a prefix of a longer one
# cannot strand the tail (mirrors the rationale in redact_tool_response_json).
# The secret list is a de-duplicated JSON string array. jq orders and frames it;
# byte-oriented awk applies literal index()/substr() replacement so unrelated
# non-UTF-8 output is preserved. Prints the redacted text with no added trailing
# newline (the caller re-adds one).
redact_plaintext_literal() {
  text=$1
  secrets=$2
  secret_file=$(mktemp_file) || return 1
  if ! printf '%s' "$secrets" \
    | jq -c '
        map(if type == "string"
            then ["S" + .]
            elif (type == "object"
                  and (.literal | type) == "string"
                  and (.replacement | type) == "string")
            then ["L" + .literal, "R" + .replacement]
            else []
            end)
        | (add // [])
      ' 2>/dev/null \
    | frame_json_string_leaves >"$secret_file" 2>/dev/null; then
    rm -f "$secret_file"
    return 1
  fi

  redact_plaintext_framed "$text" "$secret_file"
  status=$?
  rm -f "$secret_file"
  return "$status"
}

# Fail closed for exec: the whole output becomes [REDACTED]. Same shell, so
# both names reach do_exec.
exec_mask_all() {
  masked='[REDACTED]'
  output_fully_masked=1
}

do_exec() {
  [ "${1:-}" = "--" ] && shift
  if [ "$#" -eq 0 ]; then
    {
      printf '%s\n' "Usage: $PROGRAM exec [--] <cmd> [args...]"
      printf '%s\n' "Runs <cmd>, captures combined stdout+stderr (BUFFERED; for"
      printf '%s\n' "non-interactive info commands), masks secret-like values and"
      printf '%s\n' "PII, prints the redacted output, then exits with <cmd>'s status."
    } >&2
    exit 2
  fi

  # Validate the PII settings before running the command: the masker below runs
  # inside $( ) and keeps the unmasked text if it fails.
  pii_hook_mode
  pii_skip_set
  if output_redact_enabled; then
    need_cmd jq
    need_gitleaks
  fi
  if [ "$PII_HOOK_MODE" = mask ]; then
    need_cmd awk
  fi

  out=$("$@" 2>&1)
  status=$?

  masked=$out
  # Known dotenv values come from the directory exec runs in.
  ag_known_value_base=

  # Secret-literal redaction (AGENT_GUARD_OUTPUT_REDACT, default mask). Fails
  # closed: on any detector error the whole output is replaced with [REDACTED].
  if output_redact_enabled; then
    invalid_output=0
    output_fully_masked=0
    response=''
    # Avoid materializing oversized plaintext as JSON or invoking any detector;
    # match PostToolUse by conservatively masking it before bounded scan work.
    if output_scan_input_exceeds_cap "$masked"; then
      exec_mask_all
    else
      # Keep detection input tied to the original capture. The raw assignment
      # pass below may insert [REDACTED], which must not become a new candidate.
      response=$(printf '%s' "$masked" | jq -Rs . 2>/dev/null) || response=''

      # Scan assignment-shaped plaintext before jq-decoded records only when jq
      # cannot round-trip the captured bytes. jq replaces invalid UTF-8 with
      # U+FFFD, which would otherwise make that secret literal impossible to
      # match. Valid text stays on the established single replacement path.
      decoded=$(printf '%s' "$response" | jq -rj . 2>/dev/null) || decoded=''
      if [ "$decoded" != "$masked" ]; then
        invalid_output=1
        if printenv_requests_secretish_name "$@"; then
          exec_mask_all
        else
          raw_bytes=$(printf '%s' "$masked" | LC_ALL=C wc -c | tr -d ' ')
          case "$raw_bytes" in
            ''|*[!0-9]*)
              exec_mask_all
              ;;
            *)
              if [ "$raw_bytes" -gt 65536 ]; then
                # Preserve detector failure before interpreting its marker; grep
                # would turn an empty failed probe into an ordinary no-match.
                raw_probe_status=0
                raw_probe_result=$(printf '%s' "$masked" \
                  | secretish_env_values probe_raw 2>/dev/null) || raw_probe_status=$?
                if [ "$raw_probe_status" -ne 0 ] || [ -n "$raw_probe_result" ]; then
                  exec_mask_all
                fi
              else
                raw_secret_file=$(mktemp_file) || raw_secret_file=''
                if [ -z "$raw_secret_file" ]; then
                  exec_mask_all
                else
                  # Check the producer before invoking the detector: POSIX
                  # pipelines otherwise hide an empty or partial framing error.
                  # Successful framing ends in RS, preserving trailing LFs.
                  if ! raw_framed=$(printf '%s' "$masked" \
                    | frame_plaintext_leaf 2>/dev/null) \
                    || ! printf '%s' "$raw_framed" \
                      | secretish_env_values framed >"$raw_secret_file" 2>/dev/null; then
                    exec_mask_all
                  elif [ -s "$raw_secret_file" ]; then
                    if r=$(redact_plaintext_framed \
                      "$masked" "$raw_secret_file" 2>/dev/null) \
                      && [ -n "$r" ]; then
                      masked=$r
                    else
                      exec_mask_all
                    fi
                  fi
                  rm -f "$raw_secret_file"
                fi
              fi
              ;;
          esac
        fi
      fi
    fi

    secret_bundle=''
    if [ "$output_fully_masked" -eq 0 ]; then
      # The raw pass already handled invalid-byte assignments exactly. The
      # bundle helper skips only that JSON env heuristic while keeping every
      # detector and bundler stage atomic.
      if ! secret_bundle=$(detect_exec_secret_bundle \
        "$response" "$invalid_output" "$@"); then
        exec_mask_all
        secret_bundle=''
      fi
    fi
    if [ -n "$secret_bundle" ]; then
      if ! classify_secret_bundle "$secret_bundle" \
          || [ "$BUNDLE_MODE" = whole_leaf ]; then
        exec_mask_all
      elif [ "$BUNDLE_SECRETS" != '[]' ]; then
        secrets=$BUNDLE_SECRETS
        if r=$(redact_plaintext_literal "$masked" "$secrets" 2>/dev/null) \
          && [ -n "$r" ]; then
          masked=$r
        else
          exec_mask_all
        fi
      fi
    fi
  fi

  # PII masking (AGENT_GUARD_PII_HOOK_MODE=mask), reusing the same CLI masker the
  # pii-filter subcommand uses. Fail-safe: keep the prior text if it errors.
  if [ "$PII_HOOK_MODE" = mask ]; then
    r=$(printf '%s' "$masked" | pii_regex_adapter_filter 2>/dev/null)
    [ -n "$r" ] && masked=$r
  fi

  [ "$masked" = "$out" ] || audit_note masked
  printf '%s\n' "$masked"
  exit "$status"
}

# --- shell-init: emit `agx`, a warn-only nudge, and default command wrapping ---
# The snippet, eval'd by the file setup-shell writes, defines `agx` (an
# alias for `agent-guard exec --`) and a NON-BLOCKING preexec/DEBUG nudge that
# reminds the user to wrap known secret-loading idioms with `agx` so their output
# is masked before the model sees it.
# Emit the zsh preexec hook. add-zsh-hook chains onto any existing preexec
# rather than clobbering it; the plain-function fallback is only for ancient zsh.
shell_init_zsh_hook() {
  cat <<'EOF'
# zsh: fire the nudge before each interactive command (command line in $1). Use
# add-zsh-hook when available so an existing preexec is not clobbered.
if autoload -Uz add-zsh-hook 2>/dev/null; then
  add-zsh-hook preexec __agentguard_nudge
else
  preexec() { __agentguard_nudge "$1"; }
fi
EOF
}

# Emit the bash DEBUG-trap hook. A DEBUG trap is process-global, so we CHAIN
# onto any pre-existing trap instead of overwriting it. A sourced rc cannot read
# an existing DEBUG trap (bash does not expose it to sourced/function scope
# without functrace), so we DEFER the install to the first prompt via
# PROMPT_COMMAND — where the trap IS visible — then chain and self-remove.
shell_init_bash_hook() {
  cat <<'EOF'
# bash: install the nudge as a DEBUG trap that fires before each interactive
# command ($BASH_COMMAND). Deferred to the first prompt so we can read and CHAIN
# onto any pre-existing DEBUG trap instead of clobbering it; runs exactly once.
# ponytail: assumes PROMPT_COMMAND is a string, not a bash 5.1+ array.
__agentguard_sq=\'
__agentguard_boot='__agentguard_prev=$(trap -p DEBUG);
case "$__agentguard_prev" in
  (*__agentguard_nudge*) : ;;
  ("") trap "__agentguard_nudge \"\$BASH_COMMAND\"" DEBUG ;;
  (*) __agentguard_prev=${__agentguard_prev#trap -- $__agentguard_sq};
      __agentguard_prev=${__agentguard_prev%$__agentguard_sq DEBUG};
      trap "${__agentguard_prev}; __agentguard_nudge \"\$BASH_COMMAND\"" DEBUG ;;
esac;
unset __agentguard_prev;
PROMPT_COMMAND=${PROMPT_COMMAND#eval \"\$__agentguard_boot\";};
unset __agentguard_boot __agentguard_sq'
case "${PROMPT_COMMAND:-}" in
  (*__agentguard_boot*) ;;
  (*) PROMPT_COMMAND="eval \"\$__agentguard_boot\";${PROMPT_COMMAND:-}" ;;
esac
EOF
}

# Stable, default-on Claude command wrapping. Emit function overrides for common
# file/env dump commands so `!`-typed reads are routed through `agent-guard exec`
# (output masked) BEFORE the transcript captures them. Users can opt out for a
# managed rc with `setup-shell --no-command-wrapping`, or at runtime with
# `AGENT_GUARD_COMMAND_WRAPPING=off`.
#
# Why functions, not the preexec nudge above: Claude Code builds a "shell
# snapshot" of your interactive shell for `!` commands. That snapshot runs
# `unalias -a` and drops preexec/DEBUG hooks — so aliases and the nudge do NOT
# fire for `!`. It DOES keep functions, so these overrides are the one lever that
# actually intercepts `!cat .env`.
#
# Best-effort, NOT a security control:
#   * covers only these command names; trivially bypassed by an absolute path
#     (`/bin/cat`), `source`/`.`, `python -c 'open(...)'`, redirection (`< file`).
#   * gated on $CLAUDECODE so it is INERT in your normal terminal — cat/head/tail
#     behave exactly as before there; masking only kicks in inside Claude Code.
#   * `exec` buffers combined output (no streaming/paging) and adds a gitleaks
#     scan per call, so wrap only cheap, interactive dump commands.
#   * `exec` captures output via shell substitution, so it is TEXT-ONLY: a
#     binary / NUL-containing read loses embedded NULs and its trailing newline.
#     For faithful binary output use `command cat` / `\cat` (or
#     `shell-init --no-command-wrapping`). This targets text config/secret dumps,
#     not blobs.
shell_init_command_wrapping() {
  cat <<'EOF'
# --- agent-guard Claude command wrapping (enabled by default) ----------------
# Routes `!`-typed dump commands through `agent-guard exec` so their output is
# masked before Claude Code captures it. Active ONLY inside Claude Code
# ($CLAUDECODE); inert in a normal terminal. Set
# AGENT_GUARD_COMMAND_WRAPPING=off to pass through without masking.
# Best-effort — see docs.
# NOTE: `agent-guard exec` buffers the whole output, so streaming/follow commands
# would hang. `tail` is deliberately NOT wrapped for that reason; wrap only
# terminating dump commands.
__agentguard_wrap_command() {  # $1 = real command name, remaining args forwarded
  __ag_cmd=$1; shift
  if [ -n "${CLAUDECODE:-}" ]; then
    case "${AGENT_GUARD_COMMAND_WRAPPING:-on}" in
      0|off|OFF|false|FALSE|no|NO)
        command "$__ag_cmd" "$@"
        return
        ;;
    esac
    # Route through `agent-guard exec` (resolved via $PATH or the baked path) so
    # the output is masked. `exec` runs the command in agent-guard's OWN child
    # process, where these overrides do not exist, so the real binary runs with
    # no re-entry (no inner `command` needed).
    if __ag_exe=$(__agentguard_exe); then
      if command "$__ag_exe" check >/dev/null 2>&1; then
        command "$__ag_exe" exec -- "$__ag_cmd" "$@"
        return
      fi
      __agentguard_warn_infra_once 'command-wrapping dependencies are not ready'
    else
      __agentguard_warn_infra_once 'command wrapping cannot locate the agent-guard binary'
    fi
    __agentguard_infra_closed && return 127
  fi
  # `command` bypasses this override so the real binary runs (no recursion).
  command "$__ag_cmd" "$@"
}
# A user alias for one of these (e.g. `alias cat='cat -n'`) would otherwise
# alias-expand the `${name}()` token while this eval is PARSED, so the function
# would fail to define and `!cat` would stay unguarded. Drop the alias before the
# inner eval, then restore it so the normal interactive shell keeps its existing
# behavior. Claude Code's snapshot runs `unalias -a`, exposing the function it
# retained underneath the alias.
for __ag_name in cat head printenv; do
  __ag_alias=$(alias "$__ag_name" 2>/dev/null || :)
  __ag_alias=${__ag_alias#alias }
  unalias "$__ag_name" 2>/dev/null || :
  eval "${__ag_name}() { __agentguard_wrap_command ${__ag_name} \"\$@\"; }"
  [ -n "$__ag_alias" ] && eval "alias $__ag_alias"
done
unset __ag_name __ag_alias
EOF
}

# The rc bootstrap and a loaded shell use the same cache authority and recovery
# rules. Emit functions so a managed rc can still resolve after its original
# version directory disappears, without executing unvalidated cached binaries.
shell_init_resolver() {
  cat <<'EOF'
__agentguard_policy_file_usable() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] && [ -s "$1" ] \
    && awk '$0 !~ /^[[:space:]]*(#|$)/ { found = 1; exit } END { exit !found }' "$1"
}
__agentguard_cache_bin_usable() {
  __ag_candidate=$1
  __ag_expected=${2:-}
  __ag_root=${__ag_candidate%/bin/agent-guard}
  [ -d "$__ag_root" ] && [ ! -L "$__ag_root" ] \
    && [ -d "$__ag_root/bin" ] && [ ! -L "$__ag_root/bin" ] \
    && [ -d "$__ag_root/config" ] && [ ! -L "$__ag_root/config" ] \
    && [ -f "$__ag_candidate" ] && [ ! -L "$__ag_candidate" ] && [ -x "$__ag_candidate" ] \
    && __agentguard_policy_file_usable "$__ag_root/config/gitleaks.toml" \
    && __agentguard_policy_file_usable "$__ag_root/config/deny-read-paths.txt" \
    && __agentguard_policy_file_usable "$__ag_root/config/deny-bash-patterns.txt" \
    || return 1
  __ag_embedded=
  while IFS= read -r __ag_line; do
    case "$__ag_line" in
      VERSION=*) __ag_embedded=${__ag_line#VERSION=}; break ;;
    esac
  done <"$__ag_candidate"
  [ -n "$__ag_embedded" ] \
    && { [ -z "$__ag_expected" ] || [ "$__ag_embedded" = "$__ag_expected" ]; }
}
__agentguard_latest_plugin_bin() {
  [ -n "${__agentguard_plugin_base:-}" ] || return 1
  __ag_latest=$(
    for __ag_candidate in "$__agentguard_plugin_base"/[0-9]*.[0-9]*.[0-9]*/bin/agent-guard; do
      [ -x "$__ag_candidate" ] || continue
      __ag_root=${__ag_candidate%/bin/agent-guard}
      [ -d "$__ag_root" ] && [ ! -L "$__ag_root" ] || continue
      __ag_version=${__ag_candidate%/bin/agent-guard}
      __ag_version=${__ag_version##*/}
      __agentguard_cache_bin_usable "$__ag_candidate" "$__ag_version" || continue
      printf '%s\t%s\n' "$__ag_version" "$__ag_candidate"
    done \
      | awk -F '\t' '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/' \
      | sort -t. -k1,1n -k2,2n -k3,3n \
      | tail -n 1 \
      | cut -f 2-
  )
  [ -n "$__ag_latest" ] && [ -x "$__ag_latest" ] || return 1
  printf '%s' "$__ag_latest"
}
__agentguard_semver() {
  __ag_version=$1
  __ag_major=${__ag_version%%.*}
  __ag_rest=${__ag_version#*.}
  [ "$__ag_rest" != "$__ag_version" ] || return 1
  __ag_minor=${__ag_rest%%.*}
  __ag_patch=${__ag_rest#*.}
  [ "$__ag_patch" != "$__ag_rest" ] || return 1
  case "$__ag_major" in ''|*[!0-9]*) return 1 ;; esac
  case "$__ag_minor" in ''|*[!0-9]*) return 1 ;; esac
  case "$__ag_patch" in ''|*[!0-9]*) return 1 ;; esac
  return 0
}
__agentguard_physical_path() (
  __ag_physical=$1
  case "$__ag_physical" in
    /*) ;;
    *)
      __ag_pwd=$(pwd -P 2>/dev/null) || return 1
      __ag_physical=$__ag_pwd/$__ag_physical
      ;;
  esac
  __ag_hops=0
  while [ -L "$__ag_physical" ]; do
    __ag_hops=$((__ag_hops + 1))
    [ "$__ag_hops" -le 40 ] || return 1
    __ag_target=$(readlink -- "$__ag_physical" 2>/dev/null) || return 1
    case "$__ag_target" in
      /*) __ag_physical=$__ag_target ;;
      *) __ag_physical=${__ag_physical%/*}/$__ag_target ;;
    esac
  done
  __ag_name=${__ag_physical##*/}
  __ag_parent=${__ag_physical%/*}
  [ "$__ag_parent" != "$__ag_physical" ] || __ag_parent=.
  __ag_parent=$(CDPATH= cd -- "$__ag_parent" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s' "$__ag_parent" "$__ag_name"
)
__agentguard_path_bin() {
  __ag_path=$(command -v agent-guard 2>/dev/null) || __ag_path=
  if [ -n "$__ag_path" ]; then
    # setup-shell adds current/bin to PATH. Do not re-admit an invalid cache
    # through a relative entry or an external symlink alias after rejecting its
    # payload above. Canonicalize only in plugin mode; standalone PATH fallback
    # retains support for command wrappers that are not payload-shaped paths.
    if [ -n "${__agentguard_plugin_base:-}" ]; then
      __ag_path=$(__agentguard_physical_path "$__ag_path") || return 1
      __ag_base=$(CDPATH= cd -- "$__agentguard_plugin_base" 2>/dev/null && pwd -P) \
        || __ag_base=
      if [ -n "$__ag_base" ]; then
        case "$__ag_path" in "$__ag_base"|"$__ag_base"/*) return 1 ;; esac
      fi
    fi
    printf '%s' "$__ag_path"; return 0
  fi
  return 1
}
__agentguard_exe() {
  if [ -n "${AGENT_GUARD_BIN:-}" ] && [ -x "$AGENT_GUARD_BIN" ]; then
    printf '%s' "$AGENT_GUARD_BIN"; return 0
  fi
  __ag_current_target=
  if [ -n "${__agentguard_plugin_base:-}" ] \
     && [ -L "$__agentguard_plugin_base/current" ]; then
    __ag_current_target=$(readlink "$__agentguard_plugin_base/current" 2>/dev/null) \
      || __ag_current_target=
    __agentguard_semver "$__ag_current_target" || __ag_current_target=
  fi
  if [ -n "${__agentguard_bin:-}" ] && [ -x "$__agentguard_bin" ] \
     && [ -n "${__agentguard_plugin_base:-}" ] \
     && [ -n "$__ag_current_target" ] \
     && [ -d "$__agentguard_plugin_base/$__ag_current_target" ] \
     && [ ! -L "$__agentguard_plugin_base/$__ag_current_target" ] \
     && __agentguard_cache_bin_usable \
          "$__agentguard_plugin_base/$__ag_current_target/bin/agent-guard" \
          "$__ag_current_target"; then
    printf '%s' "$__agentguard_bin"; return 0
  fi
  __ag_latest=$(__agentguard_latest_plugin_bin) || __ag_latest=
  if [ -n "$__ag_latest" ]; then
    printf '%s' "$__ag_latest"; return 0
  fi
  if [ -z "${__agentguard_plugin_base:-}" ] \
     && [ -n "${__agentguard_bin:-}" ] && [ -x "$__agentguard_bin" ]; then
    printf '%s' "$__agentguard_bin"; return 0
  fi
  __agentguard_path_bin
}
EOF
}

shell_init() {
  # Default to `auto`: emit a snippet that picks the hook at SOURCE time in the
  # user's interactive shell. We cannot detect the parent shell here — this
  # script runs under its own `#!/usr/bin/env sh` interpreter, and $ZSH_VERSION
  # / $BASH_VERSION are non-exported shell parameters invisible to a child
  # process. `--bash` / `--zsh` force a single hook for users who prefer it.
  # Every argument is parsed before anything is printed, so an unknown one
  # exits 2 with no snippet rather than a half-understood invocation.
  target=auto
  command_wrapping=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bash) target=bash ;;
      --zsh) target=zsh ;;
      --no-command-wrapping) command_wrapping=0 ;;
      -h|--help) target=help ;;
      *) die "shell-init: unknown argument: $1 (expected --bash, --zsh, or --no-command-wrapping)" ;;
    esac
    shift
  done
  if [ "$target" = help ]; then
    {
      printf '%s\n' "Usage: $PROGRAM shell-init [--bash|--zsh] [--no-command-wrapping]"
      printf '%s\n' "Emits a shell snippet for: eval \"\$($PROGRAM shell-init)\""
      printf '%s\n' "Command wrapping is on by default: cat/head/printenv are masked inside"
      printf '%s\n' "Claude Code. Set AGENT_GUARD_COMMAND_WRAPPING=off for a runtime opt-out."
      printf '%s\n' "  --no-command-wrapping     omit the automatic command overrides"
    } >&2
    return 0
  fi

  # Shared comment header + the `agx` wrapper and nudge function body (identical
  # for both shells). The nudge is warn-only: it NEVER blocks or modifies the
  # command. It skips commands that already route through agx / agent-guard exec,
  # or that discard BOTH output streams (a bare >/dev/null or 2>/dev/null still
  # leaves the other stream transcript-bound, so those must NOT skip), and only
  # fires on a small curated set of secret-loading idioms. The match is a
  # pure-shell `case` glob (no subprocess per command, so it is fast).
  #
  # Plugin installs bake only the stable sibling path plus their cache base.
  # Direct CLI installs keep their already-stable absolute path. The cache base
  # lets an existing session recover if `current` cannot be updated.
  printf '__agentguard_bin=%s\n' "$(sh_squote "$STABLE_BIN")"
  printf '__agentguard_plugin_base=%s\n' "$(sh_squote "$PLUGIN_CACHE_BASE")"
  cat <<'EOF'
# --- agent-guard shell integration (managed by: agent-guard shell-init) -------
# Threat: a `!`-prefixed command in Claude Code runs in your shell and its OUTPUT
# is captured into the transcript and sent to the model. No agent-guard hook fires
# for `!`. Run secret-printing commands as `agx <cmd>` (in Claude Code: `!agx
# <cmd>`) so their output is masked BEFORE the model sees it. The nudge below is a
# warn-only reminder; it never blocks or changes your command.
#
# Resolve the agent-guard binary at call time: an explicit $AGENT_GUARD_BIN wins,
# then the stable baked path, then the newest installed plugin version as a
# recovery fallback, then $PATH for standalone CLI installs.
EOF
  shell_init_resolver
  cat <<'EOF'

__agentguard_infra_closed() {
  [ "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" = closed ]
}
__agentguard_warn_infra_once() {
  [ "${__agentguard_infra_warned:-0}" = 1 ] && return 0
  __agentguard_infra_warned=1
  printf 'agent-guard: %s; output is NOT masked. Set AGENT_GUARD_INFRA_FAILURE_MODE=closed to refuse execution.\n' "$1" >&2
}

# Explicit agx and transparent command wrapping share one infrastructure policy:
# open by default with one warning per shell, or closed when configured.
agx() {
  if __ag_exe=$(__agentguard_exe); then
    if command "$__ag_exe" check >/dev/null 2>&1; then
      command "$__ag_exe" exec -- "$@"
      return
    fi
    __agentguard_warn_infra_once 'agx masking dependencies are not ready'
  else
    __agentguard_warn_infra_once 'agx cannot locate the agent-guard binary'
  fi
  __agentguard_infra_closed && return 127
  command "$@"
}
__agentguard_nudge() {
  [ -n "$1" ] || return 0
  case "$1" in
    __agentguard_nudge*|*agx*|*'agent-guard exec'*) return 0 ;;
  esac
  # Skip only when BOTH streams are discarded — secrets leak via stdout OR
  # stderr into the transcript, so a lone `>/dev/null` / `2>/dev/null` must not
  # suppress the nudge. `2>&1 >/dev/null` (wrong order — stderr keeps the tty) is
  # deliberately NOT matched.
  case "$1" in
    *'>/dev/null 2>&1'*|*'> /dev/null 2>&1'*|*'&>/dev/null'*|*'&> /dev/null'*) return 0 ;;
  esac
  case "$1" in
    *printenv*|*'env |'*|*'op read'*|*'vault kv get'*|*'aws secretsmanager get-secret-value'*|*'gh auth token'*|*'cat '*.env*)
      printf '\033[33magent-guard: this command may print secrets to the transcript — consider: agx <cmd>\033[0m\n' >&2
      ;;
  esac
  return 0
}
# Record — for the plugin's SessionStart drift hook — the version of the binary
# the integration resolved here at rc-eval time, across every path
# ($AGENT_GUARD_BIN / $PATH / the baked path) — which the plugin's SessionStart
# hook cannot re-derive itself (it can't see the baked path). Exported so
# `claude` launched from this shell, and its hooks, inherit it; the hook warns
# when it differs from the plugin's own version. Present iff the integration
# loaded (see README for why that closes both the false-positive and
# false-negative of a re-derived check). It is a startup SNAPSHOT, not a
# call-time read: if the resolved binary is swapped in place within a long-lived
# shell that later launches `claude` without re-sourcing the rc, the marker can
# lag what actually masks — an accepted limitation of a session-start check.
# Resolve once, then one `version` exec; silent if nothing resolves.
#
# Clear the marker FIRST so each rc-eval is authoritative about its OWN
# resolution: a child shell that re-sources the rc but now fails to resolve must
# not keep a stale value inherited from the parent (would break "present iff
# loaded"). The version is pulled with parameter expansion, not word-splitting —
# `${v#* }` takes the field after the first space, `${v%%[!0-9A-Za-z.+-]*}` keeps
# only the leading version-charset run (dropping any trailing text/newline) — so
# there is no `$(...)` word-split to guard against globbing, and no positional
# args to clobber.
unset AGENT_GUARD_SHELL_INIT_VERSION
if __ag_exe=$(__agentguard_exe); then
  __ag_v=$(command "$__ag_exe" version 2>/dev/null)
  __ag_v=${__ag_v#* }
  __ag_v=${__ag_v%%[!0-9A-Za-z.+-]*}
  [ -n "$__ag_v" ] && export AGENT_GUARD_SHELL_INIT_VERSION=$__ag_v
  unset __ag_v
fi
unset __ag_exe
EOF
  case "$target" in
    zsh) shell_init_zsh_hook ;;
    bash) shell_init_bash_hook ;;
    auto)
      # Detect the shell at SOURCE time in the user's interactive shell, where
      # $ZSH_VERSION / $BASH_VERSION are actually set (unlike in this child sh).
      printf '%s\n' 'if [ -n "${ZSH_VERSION:-}" ]; then'
      shell_init_zsh_hook
      printf '%s\n' 'elif [ -n "${BASH_VERSION:-}" ]; then'
      shell_init_bash_hook
      printf '%s\n' 'fi'
      ;;
  esac
  # Command wrapping is shell-agnostic (plain functions), so it is emitted after
  # the shell-specific hook wiring for any target unless explicitly disabled.
  # An `if`, not `&&`: the opt-out must still return 0, or the bootstrap file
  # reads the failed status as "no snippet" and loads nothing at all.
  if [ "$command_wrapping" = 1 ]; then
    shell_init_command_wrapping
  fi
}

# Write (or replace in place) the managed block in ONE rc file. Split out of
# do_setup_shell so a fish login shell can install into both POSIX rc files.
setup_shell_write_rc() {  # $1 = rc path, $2 = the line to manage
  rc=$1 line=$2
  begin=$SHELL_INIT_BLOCK_BEGIN
  end=$SHELL_INIT_BLOCK_END

  # If the rc is a symlink (e.g. into a dotfiles repo), edit the file it points
  # at rather than replacing the link with a regular file. Walk the chain by hand
  # (BSD readlink lacks -f), matching script_path() above.
  rc_real=$rc hops=0
  while [ -L "$rc_real" ]; do
    hops=$((hops + 1)); [ "$hops" -le 40 ] || die "setup-shell: too many symlink hops resolving $rc"
    t=$(readlink -- "$rc_real")
    case "$t" in /*) rc_real=$t ;; *) rc_real=$(dirname -- "$rc_real")/$t ;; esac
  done
  rc_dir=$(dirname -- "$rc_real")
  [ -d "$rc_dir" ] || die "setup-shell: directory does not exist: $rc_dir"

  # Build the new content in a temp file in the SAME directory as the target, so
  # the final `mv` is an atomic same-filesystem rename: the rc is never left
  # half-written, even if this process is killed mid-run.
  tmp=$(mktemp "$rc_dir/.agent-guard-rc.XXXXXX" 2>/dev/null) \
    || die "setup-shell: failed to create temp file in $rc_dir"
  rc_block="$begin
$line
$end"
  if [ -f "$rc_real" ]; then
    # Seed perms/owner from the existing rc (a plain `>` below keeps the inode's
    # mode while rewriting content); a brand-new rc keeps mktemp's private 0600.
    cp -p "$rc_real" "$tmp" 2>/dev/null || :
    # Replace the first managed block where it stands (so rc lines after it keep
    # their order), drop any later copies, and append when there is none. REFUSE
    # on a begin marker with no matching end (`exit skip`): silently dropping
    # everything after an unbalanced marker would eat unrelated rc content. The
    # block travels through ENVIRON because `awk -v` rewrites backslashes.
    if ! AGENT_GUARD_RC_BLOCK=$rc_block awk -v b="$begin" -v e="$end" '
      $0==b { skip=1; if (!done) { print ENVIRON["AGENT_GUARD_RC_BLOCK"]; done=1 } }
      skip==0 { print }
      $0==e { skip=0 }
      END { if (skip) exit 1; if (!done) print ENVIRON["AGENT_GUARD_RC_BLOCK"] }
    ' "$rc_real" >"$tmp"; then
      rm -f "$tmp"
      die "setup-shell: $rc_real has '$begin' with no matching '$end'; refusing to overwrite. Fix or remove that block, then re-run."
    fi
  else
    printf '%s\n' "$rc_block" >"$tmp"
  fi
  mv "$tmp" "$rc_real" || { rm -f "$tmp"; die "setup-shell: failed to write $rc_real"; }

  info "$PROGRAM: shell integration written to $rc_real"
}

# The rc block only sources this file, so the validating resolver lives outside
# the rc. It names `current` and the cache base, never a version directory, so a
# plugin update does not require rewriting either file.
#
# The file is a frozen copy: a resolver fix reaches it only when setup-shell
# reruns. Its first line carries this format number so doctor can report a copy
# written by an older setup-shell. Bump SHELL_INIT_BOOTSTRAP_FORMAT whenever
# shell_init_resolver or the bootstrap body do_setup_shell assembles changes;
# tests/setup-shell.sh pins a hash of the body for the current number and fails
# when the body changes without a bump.
SHELL_INIT_BOOTSTRAP_FORMAT=1
SHELL_INIT_BOOTSTRAP_STAMP_PREFIX='# agent-guard shell-init bootstrap v'
SHELL_INIT_BOOTSTRAP_STAMP="$SHELL_INIT_BOOTSTRAP_STAMP_PREFIX$SHELL_INIT_BOOTSTRAP_FORMAT (managed by agent-guard setup-shell; rerun it to regenerate)"

setup_shell_write_bootstrap() {  # $1 = bootstrap path, $2 = file content
  bootstrap_dir=${1%/*}
  # `mv` onto a directory (or a link to one) would move the file inside it.
  [ ! -d "$1" ] || die "setup-shell: $1 is a directory; remove it, then re-run."
  (umask 077; mkdir -p -- "$bootstrap_dir") 2>/dev/null \
    || die "setup-shell: failed to create $bootstrap_dir"
  bootstrap_tmp=$(mktemp "$bootstrap_dir/.shell-init.XXXXXX" 2>/dev/null) \
    || die "setup-shell: failed to create temp file in $bootstrap_dir"
  printf '%s\n' "$2" >"$bootstrap_tmp" \
    && mv "$bootstrap_tmp" "$1" \
    || { rm -f "$bootstrap_tmp"; die "setup-shell: failed to write $1"; }
  info "$PROGRAM: shell resolver written to $1"
}

# The setup skill itself runs through an agent Bash tool, where $SHELL can name
# the bash/zsh snapshot instead of the user's account login shell. Query the
# account database as a second signal: getent covers NSS-backed Linux systems,
# while dscl covers macOS. This lookup is best-effort and never makes setup fail.
setup_shell_account_shell() (
  set -f
  account_user=$(id -un 2>/dev/null) || account_user=
  [ -n "$account_user" ] || return 1

  account_shell=
  if command -v getent >/dev/null 2>&1; then
    account_record=$(getent passwd "$account_user" 2>/dev/null) || account_record=
    if [ -n "$account_record" ]; then
      account_old_ifs=$IFS
      IFS=:
      # getent was queried for exactly one account. Field 7 is its login shell.
      # shellcheck disable=SC2086
      set -- $account_record
      IFS=$account_old_ifs
      [ "$#" -ge 7 ] && account_shell=$7
    fi
  fi

  if [ -z "$account_shell" ] && command -v dscl >/dev/null 2>&1; then
    account_record=$(dscl . -read "/Users/$account_user" UserShell 2>/dev/null) \
      || account_record=
    case "$account_record" in
      UserShell:*) account_shell=${account_record#UserShell:}
        account_shell=${account_shell#"${account_shell%%[![:space:]]*}"} ;;
    esac
  fi

  case "$account_shell" in
    /*) printf '%s\n' "$account_shell" ;;
    *) return 1 ;;
  esac
)

# Prints the command-wrapping choice an earlier setup-shell recorded, for the
# rc files given ($@: the files a bare setup-shell would write). The managed
# block is the record: it sources shell-init-no-wrapping.sh (or, before v3.9,
# carries `shell-init --no-command-wrapping` inline) only for an opt-out. Prints
# `off` when every balanced block found is an opt-out, `on` when any block loads
# wrapping. With no block in those files (setup-shell ran with --rc, or the
# block was removed), an opt-out resolver file with no default one beside it
# still reads as `off`. Everything else is the default, `on`. Writes nothing.
setup_shell_recorded_wrapping() {
  srw_states=
  for srw_rc do
    [ -f "$srw_rc" ] && [ -r "$srw_rc" ] || continue
    srw_states="$srw_states $(awk -v b="$SHELL_INIT_BLOCK_BEGIN" -v e="$SHELL_INIT_BLOCK_END" '
      $0 == b { inb = 1; off = on = 0; next }
      $0 == e && inb { if (off) printf " off"; else if (on) printf " on"; inb = 0; next }
      inb && (index($0, "shell-init-no-wrapping.sh") || index($0, "shell-init --no-command-wrapping")) { off = 1; next }
      inb && index($0, "shell-init") { on = 1 }
    ' "$srw_rc" 2>/dev/null)"
  done
  case "$srw_states " in
    *" on "*) printf '%s\n' on; return 0 ;;
    *" off "*) printf '%s\n' off; return 0 ;;
  esac
  if [ -f "$HOME/.agent-guard/shell-init-no-wrapping.sh" ] \
     && [ ! -e "$HOME/.agent-guard/shell-init.sh" ]; then
    printf '%s\n' off
  else
    printf '%s\n' on
  fi
}

# `setup-shell` — write ~/.agent-guard/shell-init.sh (the validating resolver
# that evals `shell-init`) and a managed rc block that only sources it, so the
# wrappers load in every new shell (hence every Claude Code shell snapshot).
# This is the one manual step a plugin-only install needs: a plugin cannot edit
# your rc, so run this once (by absolute path if agent-guard is not yet on
# $PATH). Idempotent — re-running rewrites the file and replaces the managed
# block in place, including an older inline block.
do_setup_shell() {
  sh_target= rc= wrapping= want_help=0 print_wrapping=0
  # Parse every argument before acting on --help, matching shell-init: a
  # rejected option must fail even when --help precedes it, so no invocation
  # carrying a removed/unknown flag can exit 0.
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bash) sh_target=bash ;;
      --zsh) sh_target=zsh ;;
      --rc) shift; rc=${1:-}; [ -n "$rc" ] || die "setup-shell: --rc requires a path" ;;
      --no-command-wrapping) wrapping=' --no-command-wrapping' ;;
      --print-command-wrapping) print_wrapping=1 ;;
      -h|--help) want_help=1 ;;
      *) cli_ref_init; die "setup-shell: unknown option: $1 (see: $AG_CLI_REF setup-shell --help)" ;;
    esac
    shift
  done
  if [ "$print_wrapping" -eq 1 ] && [ -n "$wrapping" ]; then
    die "setup-shell: --print-command-wrapping writes nothing and cannot be combined with --no-command-wrapping"
  fi
  if [ "$want_help" -eq 1 ]; then
    {
      printf '%s\n' "Usage: $PROGRAM setup-shell [--bash|--zsh|--rc FILE] [--no-command-wrapping]"
      printf '%s\n' "       $PROGRAM setup-shell [--bash|--zsh|--rc FILE] --print-command-wrapping"
      printf '%s\n' "Adds one line to your shell rc that sources ~/.agent-guard/shell-init.sh,"
      printf '%s\n' "and writes that file (idempotent; an older inline block is replaced)."
      printf '%s\n' "Restart your shell and any sessions launched from it afterwards to apply."
      printf '%s\n' "If the process or account login shell is fish, setup writes both ~/.bashrc"
      printf '%s\n' "and ~/.zshrc: fish cannot eval the POSIX snippet, and agent shell snapshots"
      printf '%s\n' "run one of those two. Account lookup is best-effort (getent on Linux, dscl"
      printf '%s\n' "on macOS); if it fails, setup falls back to the process SHELL."
      printf '%s\n' "Command wrapping is enabled by default. Use --no-command-wrapping for"
      printf '%s\n' "a persistent opt-out, or AGENT_GUARD_COMMAND_WRAPPING=off at runtime."
      printf '%s\n' "--print-command-wrapping prints on or off: the choice recorded in the rc"
      printf '%s\n' "files this command would write. It writes nothing; update keeps that choice."
    } >&2
    return 0
  fi

  # Pick the rc file: explicit --rc wins, else derive from the chosen/detected
  # shell. Fish in either the process environment or account login record is the
  # one case with no single answer. The setup skill runs inside an agent Bash
  # tool, whose $SHELL may describe its bash/zsh snapshot rather than the account
  # login shell, so relying on that variable alone misses real fish users.
  # `shell-init` emits POSIX shell code that fish cannot eval, so there is no fish
  # rc to install into, and Claude Code builds its `!`/Bash snapshot from bash or
  # zsh without telling us which. Install into both so the wrapping loads either
  # way. Explicit --bash / --zsh / --rc always wins. If lookup fails, retain the
  # old process-SHELL behavior; an unknown process and account shell falls back
  # to zsh rather than widening the write set.
  if [ -z "$rc" ]; then
    if [ -z "$sh_target" ]; then
      process_shell=${SHELL:-}
      account_shell=$(setup_shell_account_shell) || account_shell=
      process_kind= account_kind=
      case "${process_shell##*/}" in
        bash) process_kind=bash ;;
        zsh) process_kind=zsh ;;
        fish) process_kind=fish ;;
      esac
      case "${account_shell##*/}" in
        bash) account_kind=bash ;;
        zsh) account_kind=zsh ;;
        fish) account_kind=fish ;;
      esac
      case "$process_kind:$account_kind" in
        fish:*|*:fish) sh_target=fish ;;
        bash:*|zsh:*) sh_target=$process_kind ;;
        *:bash|*:zsh) sh_target=$account_kind ;;
        *) sh_target=zsh ;;
      esac
    fi
    case "$sh_target" in bash) rc=$HOME/.bashrc ;; fish) rc= ;; *) rc=$HOME/.zshrc ;; esac
  fi

  # Read the record from exactly the rc files the write below would replace.
  if [ "$print_wrapping" -eq 1 ]; then
    [ -n "${HOME:-}" ] || die "setup-shell: HOME is not set"
    if [ "$sh_target" = fish ]; then
      setup_shell_recorded_wrapping "$HOME/.bashrc" "$HOME/.zshrc"
    else
      setup_shell_recorded_wrapping "$rc"
    fi
    return 0
  fi

  # Bootstrap through the same validated resolver as a loaded shell. A healthy
  # current wins; only an unavailable current permits complete-cache recovery.
  stable=$(sh_squote "$STABLE_BIN")
  cache_base=$(sh_squote "$PLUGIN_CACHE_BASE")
  resolver=$(sh_squote "$(shell_init_resolver)")
  line="eval \"\$(
_agbin=$stable
_agbase=$cache_base
__agentguard_bin=\$_agbin
__agentguard_plugin_base=\$_agbase
eval $resolver
_agi=
_agresolved=\$(__agentguard_exe) || _agresolved=
if [ -n \"\$_agresolved\" ]; then
  _agi=\$(\"\$_agresolved\" shell-init${wrapping} 2>/dev/null) || _agi=
fi
if [ -z \"\$_agi\" ]; then
  _agfallback=\$(__agentguard_path_bin) || _agfallback=
  if [ -n \"\$_agfallback\" ] && [ \"\$_agfallback\" != \"\$_agresolved\" ]; then
    _agi=\$(\"\$_agfallback\" shell-init${wrapping} 2>/dev/null) || _agi=
  fi
fi
[ -n \"\$_agi\" ] && printf '%s\\n' \"\$_agi\"
)\""
  path_line=
  if [ -n "$PLUGIN_CACHE_BASE" ]; then
    stable_dir=$(sh_squote "$PLUGIN_CACHE_BASE/current/bin")
    path_line="case :\$PATH: in *:$stable_dir:*) ;; *) PATH=$stable_dir\${PATH:+:\$PATH} ;; esac; export PATH"
  fi
  [ -n "${HOME:-}" ] || die "setup-shell: HOME is not set"
  # One file per wrapping choice, so an opt-out rc and a default rc on the same
  # account do not overwrite each other's resolver.
  bootstrap_rel=.agent-guard/shell-init${wrapping:+-no-wrapping}.sh
  bootstrap=$HOME/$bootstrap_rel
  # Clear an inherited marker first: shell-init re-exports it only when it
  # loads, so a missing binary must not look protected to SessionStart.
  setup_shell_write_bootstrap "$bootstrap" "$SHELL_INIT_BOOTSTRAP_STAMP
unset AGENT_GUARD_SHELL_INIT_VERSION
${path_line:+$path_line
}$line"
  # `~` keeps the rc line free of quoting; `[ ! -r ] ||` (not `[ -r ] &&`) ends
  # with status 0 when the file is missing, so a `set -e` caller sourcing the rc
  # survives and the first prompt's $? stays 0.
  line="[ ! -r ~/$bootstrap_rel ] || . ~/$bootstrap_rel"

  if [ "$sh_target" = fish ]; then
    setup_shell_write_rc "$HOME/.bashrc" "$line"
    setup_shell_write_rc "$HOME/.zshrc" "$line"
    fish_exec=$STABLE_BIN
    [ -x "$fish_exec" ] || fish_exec=$SELF_BIN
    info "$PROGRAM: fish shell detected. The integration is POSIX shell code, so it cannot load in fish itself: no automatic agx and no nudge at your fish prompt."
    info "$PROGRAM: agent shell snapshots run bash or zsh, which do read the files above, so command wrapping still applies to agent-run commands."
    info "$PROGRAM: a plugin-only install may not put agent-guard on fish's PATH; use the PATH-safe agx function in docs/operations.md (fish), or this executable with 'exec -- <cmd>':"
    info "$PROGRAM: fish executable: $fish_exec"
  else
    setup_shell_write_rc "$rc" "$line"
  fi
  info "$PROGRAM: restart your shell and any sessions launched from it to apply"
}

# Homebrew owns the libexec payload through its formula. New formulas place a
# regular marker in that payload. Older releases did not, so recognize only the
# exact Cellar layout plus Homebrew's recorded canonical tap; a generic receipt
# elsewhere must never change standalone update behavior.
homebrew_managed_install() {
  marker="$ROOT_DIR/.agent-guard-homebrew"
  if [ -f "$marker" ] && [ ! -L "$marker" ]; then
    return 0
  fi

  case "$ROOT_DIR" in
    */Cellar/agent-guard/*/libexec) ;;
    *) return 1 ;;
  esac
  receipt="$ROOT_DIR/../INSTALL_RECEIPT.json"
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  grep -Eq '"tap"[[:space:]]*:[[:space:]]*"jeongjaesoon/tap"' "$receipt"
}

# Prints " --no-command-wrapping" or nothing when rc file $1 has a balanced
# managed block that still carries the resolver inline: the pre-v3.9 `_agbin='`
# form, which still loads (shell_init_rc_block_state reads it too) but is about
# 155 lines where setup-shell now writes one. Returns 1 for any other rc.
shell_init_rc_inline_block() {
  [ -f "$1" ] && [ -r "$1" ] || return 1
  awk -v b="$SHELL_INIT_BLOCK_BEGIN" -v e="$SHELL_INIT_BLOCK_END" '
    $0 == b { inb = 1; inline = off = 0; next }
    $0 == e && inb { if (inline) { found = 1; if (off) found_off = 1 } inb = 0; next }
    inb && index($0, "_agbin=\047") { inline = 1 }
    inb && index($0, "shell-init --no-command-wrapping") { off = 1 }
    END { if (!found) exit 1; if (found_off) printf " --no-command-wrapping" }
  ' "$1" 2>/dev/null
}

# 0 when bootstrap file $1 starts with this CLI's format stamp or a newer one
# (rerunning an older setup-shell would only downgrade it); 1 when the stamp is
# missing or older.
shell_init_bootstrap_current() {
  sb_line=
  IFS= read -r sb_line <"$1" || [ -n "$sb_line" ] || return 1
  case $sb_line in
    "$SHELL_INIT_BOOTSTRAP_STAMP") return 0 ;;
    "$SHELL_INIT_BOOTSTRAP_STAMP_PREFIX"[0-9]*) ;;
    *) return 1 ;;
  esac
  sb_format=${sb_line#"$SHELL_INIT_BOOTSTRAP_STAMP_PREFIX"}
  sb_format=${sb_format%%[!0-9]*}
  [ "${#sb_format}" -le 9 ] && [ "$sb_format" -gt "$SHELL_INIT_BOOTSTRAP_FORMAT" ]
}

# Informational only: never changes doctor's status and never rewrites a file.
# Kept out of SessionStart, whose output reaches the model context, because a
# stale copy that still loads is not a protection gap.
doctor_shell_integration_report() {
  [ -n "${HOME:-}" ] || return 0
  cli_ref_init
  # Name the rc's shell: a bare setup-shell writes only the detected shell's rc.
  for dsi_sh in zsh bash; do
    dsi_rc=$HOME/.${dsi_sh}rc
    dsi_flag=$(shell_init_rc_inline_block "$dsi_rc") || continue
    info "$PROGRAM: shell integration: $dsi_rc still has the pre-v3.9 inline agent-guard block; rerun $AG_CLI_REF setup-shell --$dsi_sh$dsi_flag (or /agent-guard:setup-shell) to replace it with one line"
  done
  for dsi_name in shell-init.sh shell-init-no-wrapping.sh; do
    dsi_init=$HOME/.agent-guard/$dsi_name
    [ -f "$dsi_init" ] && [ -r "$dsi_init" ] || continue
    shell_init_bootstrap_current "$dsi_init" && continue
    dsi_flag=
    [ "$dsi_name" = shell-init.sh ] || dsi_flag=' --no-command-wrapping'
    info "$PROGRAM: shell integration: $dsi_init was written by an older agent-guard setup-shell; rerun $AG_CLI_REF setup-shell$dsi_flag (or /agent-guard:setup-shell) to regenerate it"
  done
  return 0
}

# doctor is setup plus a release-staleness line; the setup status is returned
# unchanged so a failed lookup never turns a healthy doctor red.
do_doctor() {
  do_setup "$@"
  doctor_status=$?
  doctor_shell_integration_report
  if command -v codex >/dev/null 2>&1; then
    doctor_here=$(pwd -P 2>/dev/null) || doctor_here=$PWD
    codex_trust_probe "$doctor_here"
    codex_trust_report doctor || [ "$doctor_status" -ne 0 ] || doctor_status=1
  fi
  if latest_release_version; then
    if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
      info "$PROGRAM: release: $VERSION installed; $LATEST_RELEASE_VERSION is available"
    else
      info "$PROGRAM: release: $VERSION installed; latest release is $LATEST_RELEASE_VERSION"
    fi
  else
    info "$PROGRAM: release: $VERSION installed; latest unknown (release lookup unavailable or AGENT_GUARD_RELEASE_CHECK=off)"
  fi
  return "$doctor_status"
}

# Update only the standalone distribution. Plugin caches and Homebrew formula
# payloads are owned by their respective managers; mutating either here would
# recreate the stale-path problem this command is intended to avoid. The
# bootstrap script remains the single checksum-verified standalone installer.
do_update() {
  [ "$#" -eq 0 ] || die "update: no arguments are accepted"
  if [ -n "$PLUGIN_CACHE_BASE" ]; then
    cli_ref_init
    die "update is unavailable for plugin installs; run '$AG_CLI_REF plugin update --host claude' (or --host codex) to see the host-manager commands that move to a newer release"
  fi
  if homebrew_managed_install; then
    die "update is unavailable for Homebrew installs; run: brew upgrade JeongJaeSoon/tap/agent-guard"
  fi
  need_cmd curl
  info "$PROGRAM: downloading the checksum-verified standalone updater"
  [ -n "$AGENT_GUARD_RUNDIR" ] \
    || die "update: cannot create a private temporary workspace"
  update_script="$AGENT_GUARD_RUNDIR/bootstrap.sh"
  curl -fsSL "$AG_REPO_URL/releases/latest/download/bootstrap.sh" \
    -o "$update_script" || die "update: failed to download bootstrap.sh"
  sh -n "$update_script" || die "update: downloaded bootstrap.sh failed syntax validation"
  # A persistent opt-out lives only in the shell rc. The updater asks the
  # payload it installs for that choice before it reruns setup-shell, unless
  # the caller set AGENT_GUARD_COMMAND_WRAPPING, which passes through as is.
  # BIN_DIR is the resolved payload directory, not the public symlink's
  # directory. Preserve the invocation location (including custom installs)
  # unless the caller explicitly requests a different link directory.
  update_bin_dir=${AGENT_GUARD_BIN_DIR:-}
  if [ -z "$update_bin_dir" ]; then
    update_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) \
      || die "update: cannot resolve the invocation directory"
  fi
  AGENT_GUARD_HOME="$ROOT_DIR" \
    AGENT_GUARD_BIN_DIR="$update_bin_dir" \
    sh "$update_script"
}

# Per-invocation temp workspace. Every scan temp file (gitleaks stdin captures,
# read-loop payloads) may hold plaintext secrets, so route them all under one
# directory (see mktemp_file) and remove it with a single trap on exit —
# including the catchable signals the host actually sends: SIGTERM when it kills
# the PostToolUse/Stop hook at its timeout, SIGINT on Ctrl-C. mktemp -d (not a
# predictable $$-based name) because these files hold secrets and a guessable
# path in a shared /tmp invites a symlink / pre-create race. Non-fatal: if the
# dir cannot be created, mktemp_file falls back to per-file temps so no command
# breaks. An un-trappable SIGKILL also leaves the dir to the OS temp reaper.
# This is the process's only EXIT trap: a command running in this shell that
# needs its own temp directory removed sets AG_EXIT_TMP_DIR instead of
# replacing the trap, which would skip everything else here.
AGENT_GUARD_RUNDIR=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-run.XXXXXX" 2>/dev/null \
  || mktemp -d /tmp/agent-guard-run.XXXXXX 2>/dev/null || printf '')
AG_EXIT_TMP_DIR=
# Saved once so rundir_temp_file can restore it without a process per file.
AG_UMASK=$(umask 2>/dev/null) || AG_UMASK=
# Logging is independent of stdout and never changes the guard's exit status.
# SIGKILL cannot be trapped; a started-only record remains useful evidence.
trap 'ag_final_status=$?; clear_gitleaks_probe_processes; clear_codex_trust_probe_processes; claude_block_capture_finish "$ag_final_status"; audit_finish "$ag_final_status"; [ -z "$AGENT_GUARD_RUNDIR" ] || rm -rf "$AGENT_GUARD_RUNDIR"; [ -z "$AG_EXIT_TMP_DIR" ] || rm -rf "$AG_EXIT_TMP_DIR"; exit "$ag_final_status"' 0
trap 'exit 130' INT
trap 'exit 143' TERM

cmd=${1:-}
audit_begin "$cmd"
case "$cmd" in
  hook-pre-tool) claude_block_capture_begin PreToolUse; hook_pre_tool ;;
  hook-post-tool) hook_post_tool ;;
  hook-post-tool-failure) hook_post_tool_failure ;;
  hook-stop) claude_block_capture_begin Stop; hook_stop ;;
  hook-session-start) hook_session_start ;;
  hook-user-prompt) claude_block_capture_begin UserPromptSubmit; hook_user_prompt ;;
  exec) shift; do_exec "$@" ;;
  shell-init) shift; shell_init "$@" ;;
  pii-filter) shift; pii_filter "$@" ;;
  mask-file) shift; do_mask_file "$@" ;;
  scan-staged) shift; scan_staged "$@" ;;
  scan-working-tree) shift; scan_working_tree "$@" ;;
  scan-path) shift; scan_path "$@" ;;
  filter-lockfile-hashes) shift; filter_lockfile_hashes "$@" ;;
  logs) shift; audit_logs "$@" ;;
  plugin) shift; do_plugin "$@" ;;
  check) check_deps ;;
  doctor) shift; do_doctor "$@" ;;
  update) shift; do_update "$@" ;;
  setup) shift; do_setup "$@" ;;
  setup-shell) shift; do_setup_shell "$@" ;;
  smoke-test) smoke_test ;;
  checksum)
    shift
    cli_ref_init
    AGENT_GUARD_CLI_REF=$AG_CLI_REF
    export AGENT_GUARD_CLI_REF
    exec sh "$ROOT_DIR/scripts/gitleaks-checksum.sh" "$@"
    ;;
  version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  ''|-h|--help|help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
