#!/usr/bin/env sh
set -u

PROGRAM=agent-guard
VERSION=3.5.3

# Resolve the script's own path, following symlinks. The bootstrap installer
# drops a symlink at ~/.local/bin/agent-guard that points into ~/.agent-guard/
# bin/agent-guard, so dirname "$0" alone (without symlink follow) computes the
# config / scripts directory relative to ~/.local/ instead of ~/.agent-guard/.
# POSIX-portable: walk the readlink chain by hand (BSD readlink lacks -f).
script_path() {
  p=$0
  hops=0
  max_hops=40
  while [ -L "$p" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt "$max_hops" ]; then
      printf '%s: too many symlink hops while resolving script path: %s\n' "$PROGRAM" "$p" >&2
      exit 2
    fi
    target=$(readlink -- "$p")
    case "$target" in
      /*) p=$target ;;
      *) p="$(dirname -- "$p")/$target" ;;
    esac
  done
  printf '%s\n' "$p"
}

script_dir() {
  # shellcheck disable=SC2164
  CDPATH= cd -- "$(dirname -- "$(script_path)")" && pwd -P
}

BIN_DIR=$(script_dir)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd -P)
# Absolute path of THIS binary. Baked into the shell-init snippet so the wrappers
# can find agent-guard even when it is NOT on $PATH (e.g. a plugin-only install,
# where the binary lives in the plugin cache and is never symlinked onto PATH).
SELF_BIN="$BIN_DIR/agent-guard"


# Plugin managers install each release under a version directory. Keep one
# sibling `current` symlink so shell snapshots and hook manifests never bake a
# disposable version path. Direct CLI installs (ROOT_DIR is not a semver) keep
# their existing stable ~/.agent-guard path.
is_semver_dir() (
  set -f
  case ${1:-} in ''|*[!0-9.]*) return 1 ;; esac
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $1
  IFS=$old_ifs
  [ "$#" -eq 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ]
)

PLUGIN_CACHE_VERSION=${ROOT_DIR##*/}
PLUGIN_CACHE_BASE=
if is_semver_dir "$PLUGIN_CACHE_VERSION"; then
  PLUGIN_CACHE_BASE=${ROOT_DIR%/*}
fi

# A cache directory is selectable only when its executable, policy payload,
# and embedded version agree. An interrupted plugin update can leave a
# higher-looking directory with only bin/agent-guard; selecting it would turn a
# healthy installation into a default-open DEGRADED hook.
policy_file_has_active_rule() {
  [ -r "$1" ] && [ -s "$1" ] \
    && awk '$0 !~ /^[[:space:]]*(#|$)/ { found = 1; exit } END { exit !found }' "$1"
}

cache_policy_file_usable() {
  [ -f "$1" ] && [ ! -L "$1" ] && policy_file_has_active_rule "$1"
}

plugin_cache_root_usable() (
  candidate_root=$1
  expected_version=${2:-}
  candidate_bin="$candidate_root/bin/agent-guard"
  [ -d "$candidate_root" ] && [ ! -L "$candidate_root" ] \
    && [ -d "$candidate_root/bin" ] && [ ! -L "$candidate_root/bin" ] \
    && [ -d "$candidate_root/config" ] && [ ! -L "$candidate_root/config" ] \
    && [ -f "$candidate_bin" ] && [ ! -L "$candidate_bin" ] && [ -x "$candidate_bin" ] \
    && cache_policy_file_usable "$candidate_root/config/gitleaks.toml" \
    && cache_policy_file_usable "$candidate_root/config/deny-read-paths.txt" \
    && cache_policy_file_usable "$candidate_root/config/deny-bash-patterns.txt" \
    || return 1
  embedded_version=
  while IFS= read -r candidate_line; do
    case "$candidate_line" in
      VERSION=*) embedded_version=${candidate_line#VERSION=}; break ;;
    esac
  done <"$candidate_bin"
  [ -n "$embedded_version" ] || return 1
  [ -z "$expected_version" ] || [ "$embedded_version" = "$expected_version" ]
)

refresh_plugin_current_link() {
  [ -n "$PLUGIN_CACHE_BASE" ] || return 0
  current="$PLUGIN_CACHE_BASE/current"
  # Never replace a real directory named current. The runtime resolvers below
  # still fall back to the newest version directory in that environment.
  if [ -e "$current" ] && [ ! -L "$current" ]; then
    return 1
  fi
  plugin_cache_root_usable "$ROOT_DIR" "$PLUGIN_CACHE_VERSION" || return 1

  # A stale older process must not roll a current link backward. Conversely, a
  # merely cached higher sibling must not become active before that version's
  # host-selected binary actually runs.
  if [ -L "$current" ]; then
    current_target=$(readlink "$current" 2>/dev/null) || current_target=
    if is_semver_dir "$current_target" \
       && plugin_cache_root_usable "$PLUGIN_CACHE_BASE/$current_target" "$current_target"; then
      newest=$(printf '%s\n%s\n' "$current_target" "$PLUGIN_CACHE_VERSION" \
        | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
      [ "$newest" = "$current_target" ] && return 0
    fi
  fi
  # BSD and GNU ln both support -n to replace a symlink-to-directory itself
  # instead of following it and creating a link inside the old version.
  ln -sfn "$PLUGIN_CACHE_VERSION" "$current" 2>/dev/null
}

refresh_plugin_current_link || :
STABLE_BIN=$SELF_BIN
[ -n "$PLUGIN_CACHE_BASE" ] && STABLE_BIN="$PLUGIN_CACHE_BASE/current/bin/agent-guard"

# Emit $1 as a safely single-quoted POSIX shell word, so a path with spaces (or,
# rarely, an embedded quote) survives being baked into an emitted snippet.
sh_squote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

GITLEAKS_CONFIG=${AGENT_GUARD_GITLEAKS_CONFIG:-"$ROOT_DIR/config/gitleaks.toml"}
DENY_READ_PATHS_CUSTOM=0
if [ -n "${AGENT_GUARD_DENY_READ_PATHS:-}" ]; then
  DENY_READ_PATHS=$AGENT_GUARD_DENY_READ_PATHS
  DENY_READ_PATHS_CUSTOM=1
else
  DENY_READ_PATHS="$ROOT_DIR/config/deny-read-paths.txt"
fi
DENY_BASH_PATTERNS=${AGENT_GUARD_DENY_BASH_PATTERNS:-"$ROOT_DIR/config/deny-bash-patterns.txt"}
GITLEAKS_PRIVATE_BIN_DIR=${AGENT_GUARD_GITLEAKS_BIN_DIR:-${AGENT_GUARD_BIN_DIR:-$HOME/.agent-guard/bin}}
LIVE_PRE_TOOL_PROBE=AGENT_GUARD_LIVE_PRE_TOOL_PROBE
LIVE_POST_TOOL_PROBE=AGENT_GUARD_LIVE_POST_TOOL_PROBE
LIVE_POST_TOOL_REPLACEMENT_PREFIX='[REDACTED] agent-guard live probe run_id='
# Delimiters of the rc block `setup-shell` manages. `hook-session-start` reads
# them back to tell "setup-shell was never run" apart from "setup-shell ran, but
# the shell that launched the agent could not export the marker" — and from
# "setup-shell ran but the block can no longer load" — see shell_init_block_state.
SHELL_INIT_BLOCK_BEGIN='# >>> agent-guard shell-init >>>'
SHELL_INIT_BLOCK_END='# <<< agent-guard shell-init <<<'

usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard hook-pre-tool
  agent-guard hook-post-tool
  agent-guard hook-stop
  agent-guard hook-session-start
  agent-guard hook-user-prompt
  agent-guard exec [--] <cmd> [args...]
  agent-guard shell-init [--bash|--zsh] [--no-command-wrapping]
  agent-guard setup-shell [--bash|--zsh|--rc FILE] [--no-command-wrapping]
  agent-guard pii-filter [--check]
  agent-guard scan-staged
  agent-guard scan-working-tree
  agent-guard scan-path PATH...
  agent-guard check
  agent-guard setup [--install --gitleaks-checksum SHA [--gitleaks-version X.Y.Z]]
  agent-guard doctor
  agent-guard logs [status|export [--output FILE]]
  agent-guard plugin status|install|update|uninstall [--host claude|codex|all] [--scope user|project|local]
  agent-guard update
  agent-guard smoke-test
  agent-guard checksum [VERSION]
  agent-guard version
EOF
}

plugin_usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard plugin status|install|update|uninstall [--host claude|codex|all] [--scope user|project|local]

If --host is omitted, exactly one of claude or codex must be available. Claude
Code defaults to user scope. Codex supports user scope only.

Marketplaces are pinned to the release tag matching this CLI. If status reports
marketplace drift, remove that marketplace with the host manager and run install
again. Host marketplace removal also removes plugins installed from it.

status looks up the latest GitHub release only for an Agent Guard marketplace,
and update does so only when the installed plugin already matches this CLI
(AGENT_GUARD_RELEASE_CHECK=off skips it). When a newer release exists, update prints the host-manager commands that
move the marketplace pin forward; it never re-pins on its own.
EOF
}

# Resolve the latest release from the releases/latest HEAD redirect: no API
# token, no rate limit, no JSON. The redirect target is untrusted input, so only
# an exact tag URL with a three-field version is accepted and the raw URL is
# never printed. Sets LATEST_RELEASE_VERSION (not echoed, so the cache survives
# without a subshell) and succeeds when a version is known; `--host all` and
# doctor therefore look up once.
LATEST_RELEASE_VERSION=
LATEST_RELEASE_LOOKED_UP=0
latest_release_version() {
  if [ "$LATEST_RELEASE_LOOKED_UP" -eq 0 ]; then
    LATEST_RELEASE_LOOKED_UP=1
    if [ "${AGENT_GUARD_RELEASE_CHECK:-on}" != off ] && command -v curl >/dev/null 2>&1; then
      release_url=$(curl -fsSI --max-time 5 -o /dev/null -w '%{redirect_url}' \
        https://github.com/JeongJaeSoon/agent-guard/releases/latest 2>/dev/null) || release_url=
      release_prefix='https://github.com/JeongJaeSoon/agent-guard/releases/tag/v'
      case "$release_url" in
        "$release_prefix"*)
          release_tag=${release_url#"$release_prefix"}
          is_semver_dir "$release_tag" && LATEST_RELEASE_VERSION=$release_tag
          ;;
      esac
    fi
  fi
  [ -n "$LATEST_RELEASE_VERSION" ]
}

# version_newer A B: succeeds when semver A is strictly greater than B.
version_newer() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) {
      if (x[i] + 0 > y[i] + 0) exit 0
      if (x[i] + 0 < y[i] + 0) exit 1
    }
    exit 1
  }'
}

# Host-manager commands that move a pinned marketplace to $2 (a tag, or a
# placeholder when the latest release is unknown). Printed to stderr, never run.
print_release_forward_commands() {
  forward_host=$1
  forward_tag=$2
  forward_scope=$3
  case "$forward_host" in
    claude)
      printf '  claude plugin marketplace remove agent-guard --scope %s\n' "$forward_scope" >&2
      printf '  claude plugin marketplace add JeongJaeSoon/agent-guard@%s --scope %s\n' "$forward_tag" "$forward_scope" >&2
      printf '  claude plugin install agent-guard@agent-guard --scope %s\n' "$forward_scope" >&2
      ;;
    codex)
      printf '  codex plugin marketplace remove agent-guard\n' >&2
      printf '  codex plugin marketplace add JeongJaeSoon/agent-guard@%s\n' "$forward_tag" >&2
      printf '  codex plugin add agent-guard@agent-guard\n' >&2
      ;;
  esac
  printf '%s\n' "$PROGRAM: marketplace removal also removes its installed plugin; restart the host afterwards" >&2
}

plugin_marketplace_source_is_agent_guard() {
  plugin_host=$1
  plugin_json=$2
  case "$plugin_host" in
    claude)
      jq -e '.[] | select(.name == "agent-guard")
        | (((.source // "") == "github" and
            (.repo // "") == "JeongJaeSoon/agent-guard") or
           ((.source // "") == "git" and
            ((.url // "") == "https://github.com/JeongJaeSoon/agent-guard" or
             (.url // "") == "https://github.com/JeongJaeSoon/agent-guard.git")))' \
        "$plugin_json" >/dev/null 2>&1
      ;;
    codex)
      jq -e '.marketplaces[] | select(.name == "agent-guard")
        | (.marketplaceSource.source // "") as $source
        | ((.marketplaceSource.sourceType // "") == "git") and
          ($source == "JeongJaeSoon/agent-guard" or
           $source == "https://github.com/JeongJaeSoon/agent-guard" or
           $source == "https://github.com/JeongJaeSoon/agent-guard.git")' \
        "$plugin_json" >/dev/null 2>&1
      ;;
  esac
}

# Claude exposes the configured Git ref in marketplace-list JSON. Codex 0.153.4
# does not; for mutating actions we use `marketplace add owner/repo@ref` as the
# official manager's idempotence probe. It succeeds for the same ref and rejects
# an existing unpinned or different ref without changing host state.
claude_marketplace_matches_release() {
  jq -e --arg ref "v$VERSION" '.[] | select(.name == "agent-guard")
    | (.ref // "") == $ref' "$1" >/dev/null 2>&1
}

claude_marketplace_ref() {
  jq -r '.[] | select(.name == "agent-guard") | .ref // "unpinned"' "$1" | head -n 1
}

plugin_marketplace_present() {
  plugin_host=$1
  plugin_json=$2
  case "$plugin_host" in
    claude) jq -e '.[] | select(.name == "agent-guard")' "$plugin_json" >/dev/null 2>&1 ;;
    codex) jq -e '.marketplaces[] | select(.name == "agent-guard")' "$plugin_json" >/dev/null 2>&1 ;;
  esac
}

plugin_installed() {
  plugin_host=$1
  plugin_json=$2
  plugin_scope=$3
  case "$plugin_host" in
    claude) jq -e --arg scope "$plugin_scope" '.[]
      | select((.id // .pluginId // "") == "agent-guard@agent-guard" and (.scope // "user") == $scope)' "$plugin_json" >/dev/null 2>&1 ;;
    codex) jq -e '.installed[] | select(.pluginId == "agent-guard@agent-guard" and .installed == true)' "$plugin_json" >/dev/null 2>&1 ;;
  esac
}

plugin_version() {
  plugin_host=$1
  plugin_json=$2
  plugin_scope=$3
  case "$plugin_host" in
    claude) jq -r --arg scope "$plugin_scope" '.[]
      | select((.id // .pluginId // "") == "agent-guard@agent-guard" and (.scope // "user") == $scope)
      | .version // "unknown"' "$plugin_json" | head -n 1 ;;
    codex) jq -r '.installed[] | select(.pluginId == "agent-guard@agent-guard") | .version // "unknown"' "$plugin_json" | head -n 1 ;;
  esac
}

plugin_enabled() {
  plugin_host=$1
  plugin_json=$2
  plugin_scope=$3
  case "$plugin_host" in
    claude) jq -e --arg scope "$plugin_scope" '.[]
      | select((.id // .pluginId // "") == "agent-guard@agent-guard" and (.scope // "user") == $scope)
      | .enabled == true' "$plugin_json" >/dev/null 2>&1 ;;
    codex) jq -e '.installed[]
      | select(.pluginId == "agent-guard@agent-guard" and .installed == true)
      | .enabled == true' "$plugin_json" >/dev/null 2>&1 ;;
  esac
}

claude_managed_plugin_present() {
  jq -e '.[] | select((.id // .pluginId // "") == "agent-guard@agent-guard" and .scope == "managed")' "$1" >/dev/null 2>&1
}

# Claude's marketplace-list JSON intentionally omits settings provenance for
# ordinary Git/GitHub marketplaces. Read the administrator-owned source instead
# so a first-sync/download failure cannot make a managed declaration look like a
# self-managed marketplace. Return 0 for an Agent Guard declaration, 1 when all
# available files are valid but unrelated, and 2 when their state is unsafe to
# determine. Return 3 when policyHelper replaces their values dynamically.
# Mutations fail closed on 2 or 3; status reports the configuration limitation.
claude_managed_settings_state() (
  # Path injection exists only for isolated tests. It is deliberately gated and
  # does not turn this user-run helper into an OS policy enforcement boundary.
  if [ "${AG_PLUGIN_TEST_MODE:-0}" = 1 ] \
      && [ -n "${AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT:-}" ]; then
    managed_root=$AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT
  elif [ -n "${AG_PLUGIN_TEST_CLAUDE_MANAGED_SETTINGS_ROOT:-}" ]; then
    return 2
  else
    case "$(uname -s)" in
      Darwin) managed_root='/Library/Application Support/ClaudeCode' ;;
      Linux) managed_root='/etc/claude-code' ;;
      *) return 1 ;;
    esac
  fi
  case "$managed_root" in /*) ;; *) return 2 ;; esac

  if [ -e "$managed_root" ] || [ -L "$managed_root" ]; then
    [ -d "$managed_root" ] && [ -r "$managed_root" ] && [ -x "$managed_root" ] \
      || return 2
  fi
  managed_fragments="$managed_root/managed-settings.d"
  if [ -e "$managed_fragments" ] || [ -L "$managed_fragments" ]; then
    [ -d "$managed_fragments" ] && [ -r "$managed_fragments" ] && [ -x "$managed_fragments" ] \
      || return 2
  fi

  # Marketplace names remain as merge keys. Raw marketplace values,
  # policy-helper paths, and unrelated settings never enter this file; only
  # Agent Guard ownership classifications do. The subshell traps also remove a
  # mktemp_file fallback outside the invocation rundir on returns and signals.
  managed_summary=$(mktemp_file) || return 2
  trap 'rm -f "$managed_summary"' 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for managed_file in \
    "$managed_root/managed-settings.json" \
    "$managed_fragments"/*.json; do
    [ -e "$managed_file" ] || [ -L "$managed_file" ] || continue
    [ -f "$managed_file" ] && [ -r "$managed_file" ] || return 2
    jq -c -s '
      def valid_policy_helper:
        type == "object" and
        (.path | type == "string" and startswith("/")) and
        ((has("timeoutMs") | not) or (.timeoutMs | type == "number")) and
        ((has("refreshIntervalMs") | not) or
         (.refreshIntervalMs | type == "number"));
      def compact_source:
        {} +
        (if has("source") then
           {source: (if .source == "github" or .source == "git"
                     then .source else "other" end)}
         else {} end) +
        (if has("repo") then
           {repo: (if .repo == "JeongJaeSoon/agent-guard"
                   then "agent-guard" else "other" end)}
         else {} end) +
        (if has("url") then
           {url: (if .url == "https://github.com/JeongJaeSoon/agent-guard" or
                       .url == "https://github.com/JeongJaeSoon/agent-guard.git"
                  then "agent-guard" else "other" end)}
         else {} end);
      def compact_marketplace:
        if type != "object" then "other"
        elif has("source") and (.source | type) != "object" then
          {source: "other"}
        elif has("source") then {source: (.source | compact_source)}
        else {}
        end;
      if length == 0 then {}
      elif length == 1 and (.[0] | type == "object") then .[0]
      else error("managed settings must contain one object")
      end
      | if (has("extraKnownMarketplaces") and
            (.extraKnownMarketplaces | type) != "object") then
        error("extraKnownMarketplaces must be an object")
      elif (has("enabledPlugins") and (.enabledPlugins | type) != "object") then
        error("enabledPlugins must be an object")
      elif (has("policyHelper") and
            ((.policyHelper | valid_policy_helper) | not)) then
        error("policyHelper must name an absolute executable path")
      else
        ({
          extraKnownMarketplaces:
            ((.extraKnownMarketplaces // {})
             | with_entries(.value |= compact_marketplace)),
          enabledPlugins:
            (if ((.enabledPlugins // {}) | has("agent-guard@agent-guard"))
             then {"agent-guard@agent-guard": true}
             else {}
             end)
        } + if has("policyHelper") then {policyHelper: true} else {} end)
      end
    ' "$managed_file" >>"$managed_summary" 2>/dev/null || return 2
  done

  managed_state=$(jq -r -s '
      def agent_guard_source:
        type == "object" and
        ((.source == "github" and .repo == "agent-guard") or
         (.source == "git" and
          .url == "agent-guard"));
      reduce .[] as $document ({}; . * $document)
      | if has("policyHelper") then "dynamic"
        elif (((.extraKnownMarketplaces // {})
               | any(.[]; (.source? | agent_guard_source))) or
              ((.enabledPlugins // {}) | has("agent-guard@agent-guard"))) then
          "managed"
        else "unrelated"
        end
    ' "$managed_summary" 2>/dev/null) || return 2
  case "$managed_state" in
    managed) return 0 ;;
    unrelated) return 1 ;;
    dynamic) return 3 ;;
    *) return 2 ;;
  esac
)

claude_managed_status() {
  plugin_plugins=$1
  if claude_managed_plugin_present "$plugin_plugins"; then
    managed_version=$(jq -r '.[]
      | select((.id // .pluginId // "") == "agent-guard@agent-guard" and .scope == "managed")
      | .version // "unknown"' "$plugin_plugins" | head -n 1)
    if jq -e '.[]
      | select((.id // .pluginId // "") == "agent-guard@agent-guard" and .scope == "managed")
      | .enabled == true' "$plugin_plugins" >/dev/null 2>&1; then
      managed_enabled=enabled
    else
      managed_enabled=disabled
    fi
    if [ "$managed_version" = "$VERSION" ]; then
      managed_version_status="version $managed_version"
    else
      managed_version_status="version $managed_version, expected $VERSION"
    fi
    printf 'claude: managed by Jamf/managed settings (plugin installed, %s, %s)\n' \
      "$managed_enabled" "$managed_version_status"
  else
    printf '%s\n' 'claude: managed by Jamf/managed settings (Agent Guard configured, plugin not installed)'
  fi
}

plugin_read_state() {
  plugin_host=$1
  plugin_marketplaces=$2
  plugin_plugins=$3
  case "$plugin_host" in
    claude)
      claude plugin marketplace list --json >"$plugin_marketplaces" \
        && claude plugin list --json >"$plugin_plugins" \
        && jq -e 'type == "array"' "$plugin_marketplaces" >/dev/null 2>&1 \
        && jq -e 'type == "array"' "$plugin_plugins" >/dev/null 2>&1
      ;;
    codex)
      codex plugin marketplace list --json >"$plugin_marketplaces" \
        && codex plugin list --json >"$plugin_plugins" \
        && jq -e 'type == "object" and (.marketplaces | type == "array")' "$plugin_marketplaces" >/dev/null 2>&1 \
        && jq -e 'type == "object" and (.installed | type == "array")' "$plugin_plugins" >/dev/null 2>&1
      ;;
  esac
}

plugin_for_host() {
  plugin_action=$1
  plugin_host=$2
  plugin_scope=$3
  plugin_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-plugin.XXXXXX") || {
    printf '%s\n' "$PROGRAM: could not create plugin status directory" >&2
    return 2
  }
  plugin_marketplaces="$plugin_tmp/marketplaces.json"
  plugin_plugins="$plugin_tmp/plugins.json"

  if ! plugin_read_state "$plugin_host" "$plugin_marketplaces" "$plugin_plugins"; then
    rm -rf "$plugin_tmp"
    printf '%s\n' "$PROGRAM: $plugin_host plugin manager could not report its state" >&2
    return 1
  fi

  plugin_managed_state=1
  if [ "$plugin_host" = claude ]; then
    if claude_managed_plugin_present "$plugin_plugins"; then
      plugin_managed_state=0
    else
      claude_managed_settings_state
      plugin_managed_state=$?
    fi
  fi
  if [ "$plugin_managed_state" -eq 2 ]; then
    rm -rf "$plugin_tmp"
    if [ "$plugin_action" = status ]; then
      printf '%s\n' "$PROGRAM: Claude managed settings could not be read or safely parsed; plugin ownership cannot be determined" >&2
    else
      printf '%s\n' "$PROGRAM: Claude managed settings could not be read or safely parsed; refusing plugin lifecycle changes" >&2
    fi
    return 2
  fi
  if [ "$plugin_managed_state" -eq 3 ]; then
    rm -rf "$plugin_tmp"
    printf '%s\n' "$PROGRAM: Claude policyHelper replaces file-based managed settings; plugin ownership cannot be determined, so lifecycle changes are refused" >&2
    return 2
  fi
  if [ "$plugin_managed_state" -eq 0 ]; then
    if [ "$plugin_action" = status ]; then
      claude_managed_status "$plugin_plugins"
      rm -rf "$plugin_tmp"
      return 0
    fi
    rm -rf "$plugin_tmp"
    printf '%s\n' "$PROGRAM: Claude Agent Guard is managed by Jamf/managed settings; ask the administrator to change the pinned marketplace ref instead of using '$PROGRAM plugin $plugin_action'" >&2
    return 2
  fi
  if [ "$plugin_managed_state" -ne 1 ]; then
    rm -rf "$plugin_tmp"
    printf '%s\n' "$PROGRAM: Claude managed settings inspection was interrupted; refusing plugin lifecycle changes" >&2
    return 2
  fi

  if plugin_marketplace_present "$plugin_host" "$plugin_marketplaces"; then
    plugin_has_marketplace=1
    if plugin_marketplace_source_is_agent_guard "$plugin_host" "$plugin_marketplaces"; then
      plugin_marketplace_source=agent-guard
    else
      plugin_marketplace_source=conflict
    fi
  else
    plugin_has_marketplace=0
    plugin_marketplace_source=missing
  fi
  if plugin_installed "$plugin_host" "$plugin_plugins" "$plugin_scope"; then
    plugin_has_install=1
    if plugin_enabled "$plugin_host" "$plugin_plugins" "$plugin_scope"; then
      plugin_is_enabled=1
    else
      plugin_is_enabled=0
    fi
  else
    plugin_has_install=0
    plugin_is_enabled=0
  fi

  case "$plugin_action" in
    status)
      case "$plugin_marketplace_source" in
        agent-guard)
          if [ "$plugin_host" = claude ]; then
            if claude_marketplace_matches_release "$plugin_marketplaces"; then
              plugin_marketplace_status="configured at v$VERSION"
            else
              plugin_marketplace_status="drift: $(claude_marketplace_ref "$plugin_marketplaces"), expected v$VERSION"
            fi
          else
            plugin_marketplace_status='configured, pin unverified by Codex'
          fi
          ;;
        conflict) plugin_marketplace_status='conflict: different source' ;;
        missing) plugin_marketplace_status=missing ;;
      esac
      if [ "$plugin_has_install" -eq 1 ]; then
        plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
        if [ "$plugin_installed_version" = "$VERSION" ]; then
          plugin_version_status="version $plugin_installed_version"
        else
          plugin_version_status="version $plugin_installed_version, expected $VERSION"
        fi
        printf '%s: installed, %s (%s, marketplace %s)\n' \
          "$plugin_host" "$([ "$plugin_is_enabled" -eq 1 ] && printf enabled || printf disabled)" \
          "$plugin_version_status" "$plugin_marketplace_status"
      else
        printf '%s: not installed (marketplace %s)\n' \
          "$plugin_host" "$plugin_marketplace_status"
      fi
      if [ "$plugin_marketplace_source" = agent-guard ]; then
        if latest_release_version; then
          if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
            printf '%s: latest release v%s; this CLI is %s\n' \
              "$plugin_host" "$LATEST_RELEASE_VERSION" "$VERSION"
          else
            printf '%s: latest release v%s\n' "$plugin_host" "$LATEST_RELEASE_VERSION"
          fi
        else
          printf '%s: latest release unknown\n' "$plugin_host"
        fi
      fi
      ;;
    install)
      if [ "$plugin_marketplace_source" = conflict ]; then
        rm -rf "$plugin_tmp"
        printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' has a different source; refusing to replace it" >&2
        return 2
      fi
      if [ "$plugin_marketplace_source" = agent-guard ]; then
        plugin_marketplace_matches=0
        case "$plugin_host" in
          claude)
            claude_marketplace_matches_release "$plugin_marketplaces" \
              && plugin_marketplace_matches=1
            ;;
          codex)
            codex plugin marketplace add "JeongJaeSoon/agent-guard@v$VERSION" \
              && plugin_marketplace_matches=1
            ;;
        esac
        if [ "$plugin_marketplace_matches" -eq 0 ]; then
          if [ "$plugin_host" = claude ]; then
            plugin_actual_ref=$(claude_marketplace_ref "$plugin_marketplaces")
            plugin_remove="claude plugin marketplace remove agent-guard --scope $plugin_scope"
          else
            plugin_actual_ref='unverified or different ref'
            plugin_remove='codex plugin marketplace remove agent-guard'
          fi
          plugin_retry="$PROGRAM plugin install --host $plugin_host"
          if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
            plugin_retry="$plugin_retry --scope $plugin_scope"
          fi
          rm -rf "$plugin_tmp"
          printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' is '$plugin_actual_ref', expected 'v$VERSION'; refusing to reuse it" >&2
          printf '%s\n' "$PROGRAM: run '$plugin_remove', then '$plugin_retry'; marketplace removal also removes its installed plugin" >&2
          return 2
        fi
      fi
      if [ "$plugin_has_install" -eq 1 ]; then
        if [ "$plugin_is_enabled" -eq 0 ]; then
          printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin is installed but disabled; enable it with the $plugin_host plugin manager" >&2
          rm -rf "$plugin_tmp"
          return 1
        fi
        plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
        if [ "$plugin_installed_version" != "$VERSION" ]; then
          plugin_retry="$PROGRAM plugin update --host $plugin_host"
          if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
            plugin_retry="$plugin_retry --scope $plugin_scope"
          fi
          rm -rf "$plugin_tmp"
          printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin version is $plugin_installed_version, expected $VERSION; run '$plugin_retry'" >&2
          return 1
        fi
        printf '%s: agent-guard plugin is already installed and enabled (version %s, marketplace v%s)\n' \
          "$plugin_host" "$plugin_installed_version" "$VERSION"
      else
        plugin_marketplace_added=0
        if [ "$plugin_has_marketplace" -eq 0 ]; then
          case "$plugin_host" in
            claude) claude plugin marketplace add "JeongJaeSoon/agent-guard@v$VERSION" --scope "$plugin_scope" ;;
            codex) codex plugin marketplace add "JeongJaeSoon/agent-guard@v$VERSION" ;;
          esac
          plugin_add_status=$?
          if [ "$plugin_add_status" -ne 0 ]; then
            plugin_retry="$PROGRAM plugin install --host $plugin_host"
            if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
              plugin_retry="$plugin_retry --scope $plugin_scope"
            fi
            rm -rf "$plugin_tmp"
            printf '%s\n' "$PROGRAM: $plugin_host could not add marketplace 'agent-guard' pinned to v$VERSION; no plugin installation was attempted and it is safe to retry '$plugin_retry'" >&2
            return 1
          fi
          plugin_marketplace_added=1
        fi
        case "$plugin_host" in
          claude) claude plugin install agent-guard@agent-guard --scope "$plugin_scope" ;;
          codex) codex plugin add agent-guard@agent-guard ;;
        esac
        plugin_install_status=$?
        if [ "$plugin_install_status" -ne 0 ] && [ "$plugin_marketplace_added" -eq 1 ]; then
          plugin_retry="$PROGRAM plugin install --host $plugin_host"
          if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
            plugin_retry="$plugin_retry --scope $plugin_scope"
          fi
          printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' was added, but plugin installation failed; the marketplace remains configured and it is safe to retry '$plugin_retry'" >&2
        fi
        [ "$plugin_install_status" -eq 0 ]
      fi
      ;;
    update)
      if [ "$plugin_marketplace_source" = conflict ]; then
        rm -rf "$plugin_tmp"
        printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' has a different source; refusing to replace it" >&2
        return 2
      fi
      if [ "$plugin_has_marketplace" -eq 0 ] || [ "$plugin_has_install" -eq 0 ]; then
        printf '%s\n' "$PROGRAM: $plugin_host plugin is not installed; run '$PROGRAM plugin install --host $plugin_host' first" >&2
        rm -rf "$plugin_tmp"
        return 1
      fi
      plugin_marketplace_matches=0
      case "$plugin_host" in
        claude)
          claude_marketplace_matches_release "$plugin_marketplaces" \
            && plugin_marketplace_matches=1
          ;;
        codex)
          codex plugin marketplace add "JeongJaeSoon/agent-guard@v$VERSION" \
            && plugin_marketplace_matches=1
          ;;
      esac
      if [ "$plugin_marketplace_matches" -eq 0 ]; then
        if [ "$plugin_host" = claude ]; then
          plugin_actual_ref=$(claude_marketplace_ref "$plugin_marketplaces")
          plugin_remove="claude plugin marketplace remove agent-guard --scope $plugin_scope"
        else
          plugin_actual_ref='unverified or different ref'
          plugin_remove='codex plugin marketplace remove agent-guard'
        fi
        plugin_retry="$PROGRAM plugin install --host $plugin_host"
        if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
          plugin_retry="$plugin_retry --scope $plugin_scope"
        fi
        rm -rf "$plugin_tmp"
        printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' is '$plugin_actual_ref', expected 'v$VERSION'; refusing to update through it" >&2
        printf '%s\n' "$PROGRAM: run '$plugin_remove', then '$plugin_retry'; marketplace removal also removes its installed plugin" >&2
        return 2
      fi
      if [ "$plugin_is_enabled" -eq 0 ]; then
        printf '%s\n' "$PROGRAM: $plugin_host agent-guard plugin is installed but disabled; update will keep it disabled" >&2
      fi
      plugin_installed_version=$(plugin_version "$plugin_host" "$plugin_plugins" "$plugin_scope")
      if [ "$plugin_installed_version" = "$VERSION" ]; then
        printf '%s: agent-guard plugin already matches this CLI (version %s, marketplace v%s)\n' \
          "$plugin_host" "$VERSION" "$VERSION"
        rm -rf "$plugin_tmp"
        # This binary lives in the cache that marketplace removal deletes, so
        # moving to a newer release is printed for the user, never performed.
        if latest_release_version; then
          if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
            printf '%s\n' "$PROGRAM: this CLI is $VERSION and can only pin the marketplace to v$VERSION; to move to v$LATEST_RELEASE_VERSION, run:" >&2
            print_release_forward_commands "$plugin_host" "v$LATEST_RELEASE_VERSION" "$plugin_scope"
          elif [ "$LATEST_RELEASE_VERSION" = "$VERSION" ]; then
            printf '%s\n' "$PROGRAM: v$VERSION matches the latest release v$LATEST_RELEASE_VERSION" >&2
          else
            printf '%s\n' "$PROGRAM: latest release is v$LATEST_RELEASE_VERSION" >&2
          fi
        else
          printf '%s\n' "$PROGRAM: this CLI is $VERSION and can only pin the marketplace to v$VERSION; the latest release could not be looked up. To move to a newer release v<X.Y.Z> from https://github.com/JeongJaeSoon/agent-guard/releases, run:" >&2
          print_release_forward_commands "$plugin_host" 'v<X.Y.Z>' "$plugin_scope"
        fi
        return 0
      fi
      case "$plugin_host" in
        claude)
          claude plugin marketplace update agent-guard \
            && claude plugin update agent-guard@agent-guard --scope "$plugin_scope"
          ;;
        codex) codex plugin marketplace upgrade agent-guard ;;
      esac
      plugin_update_status=$?
      if [ "$plugin_update_status" -ne 0 ]; then
        plugin_retry="$PROGRAM plugin update --host $plugin_host"
        if [ "$plugin_host" = claude ] && [ "$plugin_scope" != user ]; then
          plugin_retry="$plugin_retry --scope $plugin_scope"
        fi
        printf '%s\n' "$PROGRAM: $plugin_host update did not complete; the marketplace remains pinned to v$VERSION and it is safe to retry '$plugin_retry'" >&2
      fi
      [ "$plugin_update_status" -eq 0 ]
      ;;
    uninstall)
      if [ "$plugin_marketplace_source" = conflict ]; then
        rm -rf "$plugin_tmp"
        printf '%s\n' "$PROGRAM: $plugin_host marketplace 'agent-guard' has a different source; refusing plugin lifecycle changes" >&2
        return 2
      fi
      if [ "$plugin_has_install" -eq 0 ]; then
        printf '%s\n' "$plugin_host: agent-guard plugin is not installed"
      else
        case "$plugin_host" in
          claude) claude plugin uninstall agent-guard@agent-guard --scope "$plugin_scope" ;;
          codex) codex plugin remove agent-guard@agent-guard ;;
        esac
      fi
      ;;
  esac
  plugin_status=$?
  rm -rf "$plugin_tmp"
  return "$plugin_status"
}

do_plugin() {
  plugin_action=${1:-}
  case "$plugin_action" in
    status|install|update|uninstall) shift ;;
    -h|--help|help) plugin_usage; return 0 ;;
    *) plugin_usage; return 2 ;;
  esac
  plugin_host=
  plugin_scope=user
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || { plugin_usage; return 2; }
        plugin_host=$2
        shift 2
        ;;
      --scope)
        [ "$#" -ge 2 ] || { plugin_usage; return 2; }
        plugin_scope=$2
        shift 2
        ;;
      -h|--help) plugin_usage; return 0 ;;
      *) plugin_usage; return 2 ;;
    esac
  done
  case "$plugin_host" in ''|claude|codex|all) ;; *) plugin_usage; return 2 ;; esac
  case "$plugin_scope" in user|project|local) ;; *) plugin_usage; return 2 ;; esac
  command -v jq >/dev/null 2>&1 || {
    printf '%s\n' "$PROGRAM: jq is required to inspect plugin-manager state" >&2
    return 1
  }

  plugin_has_claude=0
  plugin_has_codex=0
  command -v claude >/dev/null 2>&1 && plugin_has_claude=1
  command -v codex >/dev/null 2>&1 && plugin_has_codex=1
  if [ -z "$plugin_host" ]; then
    if [ "$plugin_has_claude" -eq 1 ] && [ "$plugin_has_codex" -eq 0 ]; then
      plugin_host=claude
    elif [ "$plugin_has_codex" -eq 1 ] && [ "$plugin_has_claude" -eq 0 ]; then
      plugin_host=codex
    else
      printf '%s\n' "$PROGRAM: omit --host only when exactly one of claude or codex is available" >&2
      return 2
    fi
  fi
  if { [ "$plugin_host" = codex ] || [ "$plugin_host" = all ]; } && [ "$plugin_scope" != user ]; then
    printf '%s\n' "$PROGRAM: Codex plugin management supports user scope only" >&2
    return 2
  fi

  plugin_result=0
  case "$plugin_host" in
    claude)
      [ "$plugin_has_claude" -eq 1 ] || { printf '%s\n' "$PROGRAM: claude command not found" >&2; return 1; }
      plugin_for_host "$plugin_action" claude "$plugin_scope"
      ;;
    codex)
      [ "$plugin_has_codex" -eq 1 ] || { printf '%s\n' "$PROGRAM: codex command not found" >&2; return 1; }
      plugin_for_host "$plugin_action" codex "$plugin_scope"
      ;;
    all)
      if [ "$plugin_has_claude" -eq 1 ]; then
        plugin_for_host "$plugin_action" claude "$plugin_scope" || plugin_result=1
      else
        printf '%s\n' "$PROGRAM: claude command not found" >&2
        plugin_result=1
      fi
      if [ "$plugin_has_codex" -eq 1 ]; then
        plugin_for_host "$plugin_action" codex "$plugin_scope" || plugin_result=1
      else
        printf '%s\n' "$PROGRAM: codex command not found" >&2
        plugin_result=1
      fi
      return "$plugin_result"
      ;;
  esac
}

info() {
  printf '%s\n' "$*" >&2
}

# Local support log. Only fixed vocabulary and numeric metadata reach disk.
# Never pass hook JSON, diagnostics, arguments, paths or environment values here.
AG_AUDIT_FILE=
AG_AUDIT_ID=
AG_AUDIT_START=0
AG_LIVE_PROBE_MARKER=

audit_location() {
  printf '%s/agent-guard' "${XDG_STATE_HOME:-${HOME:-}/.local/state}"
}

audit_stat() {
  case "$(uname -s)" in
    Darwin) stat -f '%u:%Lp' "$1" 2>/dev/null ;;
    *) stat -c '%u:%a' "$1" 2>/dev/null ;;
  esac
}

# Refuse symlink components and ambiguous relative paths. Existing private
# directories are never chmodded: an unexpected directory is an error.
audit_directory() (
  ag_dir=$(audit_location)
  case "$ag_dir" in /*) ;; *) return 1 ;; esac
  if printf '%s' "$ag_dir" | LC_ALL=C grep -q '[[:cntrl:]]'; then return 1; fi
  ag_prefix=
  ag_rest=${ag_dir#/}
  while [ -n "$ag_rest" ]; do
    ag_part=${ag_rest%%/*}
    case "$ag_part" in ''|.|..) return 1 ;; esac
    ag_prefix="$ag_prefix/$ag_part"
    [ ! -L "$ag_prefix" ] || return 1
    if [ "$ag_part" = "$ag_rest" ]; then break; fi
    ag_rest=${ag_rest#*/}
  done
  if [ "${1:-}" = create ]; then
    (umask 077; mkdir -p "$ag_dir") 2>/dev/null || return 1
  fi
  [ -d "$ag_dir" ] && [ ! -L "$ag_dir" ] || return 1
  [ "$(audit_stat "$ag_dir")" = "$(id -u):700" ] || return 1
  printf '%s' "$ag_dir"
)

audit_note() {
  [ -n "$AG_AUDIT_FILE" ] && [ -n "${AGENT_GUARD_RUNDIR:-}" ] || return 0
  case "$1" in blocked|degraded|masked|error|warned)
    (umask 077; : >"$AGENT_GUARD_RUNDIR/audit-$1") 2>/dev/null || : ;;
  esac
  return 0
}

audit_record() {
  # Every interpolated string is selected internally, never supplied by a host.
  printf '{"schema":1,"run_id":"%s","time":%s,"version":"%s","command":"%s","host":"%s","phase":"%s","outcome":"%s","exit_code":%s,"duration_seconds":%s}\n' \
    "$AG_AUDIT_ID" "$1" "$VERSION" "$AG_AUDIT_COMMAND" "$AG_AUDIT_HOST" "$2" "$3" "$4" "$5"
}

audit_prune() (
  # Keep housekeeping off the EXIT/signal path. Bound the directory listing
  # before filtering, so unrelated files cannot force an unbounded traversal.
  # Retention is incremental if the private directory was externally populated.
  ag_dir=$1
  ag_cutoff=$((AG_AUDIT_START - 604800))
  find "$ag_dir" -mindepth 1 -maxdepth 1 -print 2>/dev/null \
    | head -n 2000 \
    | AG_AUDIT_PRUNE_DIR="$ag_dir" LC_ALL=C awk '
        BEGIN { prefix=ENVIRON["AG_AUDIT_PRUNE_DIR"] "/" }
        index($0, prefix) == 1 {
          name=substr($0, length(prefix)+1)
          if (name ~ /^event-[0-9]{1,12}-[A-Za-z0-9]{6}$/) print
        }
      ' \
    | LC_ALL=C sort -r \
    | awk -v cutoff="$ag_cutoff" '
        { n=split($0, parts, "/"); split(parts[n], event, "-")
          if (event[2]+0 < cutoff || ++kept > 999) print }
      ' \
    | while IFS= read -r ag_old; do
        ag_old_id=${ag_old##*/event-}
        if printf '%s' "$ag_old_id" \
          | LC_ALL=C grep -Eq '^[0-9]{1,12}-[A-Za-z0-9]{6}$'; then
          # A live-probe sidecar is an empty directory by construction. Never
          # recurse or remove a nonempty/tampered marker during retention.
          rmdir "$ag_dir/live-probe-$ag_old_id" 2>/dev/null || :
          printf '%s\0' "$ag_old"
        fi
      done \
    | xargs -0 rm -f -- 2>/dev/null
)

audit_begin() {
  case "${AGENT_GUARD_LOG_MODE:-on}" in off) return 0 ;; on) ;; *)
    printf '%s\n' 'agent-guard: local diagnostic logging unavailable (invalid log mode).' >&2
    return 0 ;;
  esac
  case "$1" in
    hook-pre-tool|hook-post-tool|hook-stop|hook-user-prompt|hook-session-start|scan-staged|scan-working-tree|scan-path|exec|pii-filter) AG_AUDIT_COMMAND=$1 ;;
    *) return 0 ;;
  esac
  case "${AGENT_GUARD_HOOK_HOST:-claude}" in codex) AG_AUDIT_HOST=codex ;; *) AG_AUDIT_HOST=claude ;; esac
  case "$AG_AUDIT_COMMAND" in hook-*) ;; *) AG_AUDIT_HOST=cli ;; esac
  AG_AUDIT_START=$(date +%s 2>/dev/null) || AG_AUDIT_START=0
  case "$AG_AUDIT_START" in ''|*[!0-9]*) AG_AUDIT_START=0 ;; esac
  ag_candidate=
  ag_dir=$(audit_directory create) || ag_dir=
  if [ -n "$ag_dir" ]; then
    audit_prune "$ag_dir"
    ag_candidate=$(umask 077; mktemp "$ag_dir/event-$AG_AUDIT_START-XXXXXX" 2>/dev/null) || ag_candidate=
  fi
  AG_AUDIT_ID=${ag_candidate##*/event-}
  if [ -n "$ag_candidate" ] && [ ! -L "$ag_candidate" ] && [ -f "$ag_candidate" ] \
      && [ "$(audit_stat "$ag_candidate")" = "$(id -u):600" ] \
      && audit_record "$AG_AUDIT_START" started pending null 0 >>"$ag_candidate"; then
    # A caught signal before this assignment leaves no finish-only event.
    AG_AUDIT_FILE=$ag_candidate
  else
    printf '%s\n' 'agent-guard: local diagnostic logging unavailable; protection continues.' >&2
  fi
  return 0
}

audit_finish() {
  [ -n "$AG_AUDIT_FILE" ] || return 0
  ag_exit=$1
  ag_end=$(date +%s 2>/dev/null) || ag_end=$AG_AUDIT_START
  case "$ag_end" in ''|*[!0-9]*) ag_end=$AG_AUDIT_START ;; esac
  ag_duration=$((ag_end - AG_AUDIT_START))
  [ "$ag_duration" -ge 0 ] || ag_duration=0
  ag_outcome=pass
  case "$ag_exit" in
    0) ;;
    130|143) ag_outcome=interrupted ;;
    *)
      case "$AG_AUDIT_COMMAND:$ag_exit" in
        hook-*:2|scan-*:1|pii-filter:1) ag_outcome=blocked ;;
        *) ag_outcome=error ;;
      esac ;;
  esac
  if [ -n "${AGENT_GUARD_RUNDIR:-}" ]; then
    for ag_flag in warned masked error degraded blocked; do
      [ ! -f "$AGENT_GUARD_RUNDIR/audit-$ag_flag" ] || ag_outcome=$ag_flag
    done
  fi
  case "$ag_exit" in 130|143) ag_outcome=interrupted ;; esac
  if [ ! -L "$AG_AUDIT_FILE" ] && [ -f "$AG_AUDIT_FILE" ] \
      && [ "$(audit_stat "$AG_AUDIT_FILE")" = "$(id -u):600" ]; then
    audit_record "$ag_end" finished "$ag_outcome" "$ag_exit" "$ag_duration" >>"$AG_AUDIT_FILE" 2>/dev/null \
      || printf '%s\n' 'agent-guard: local diagnostic log could not be completed.' >&2
  fi
  return 0
}

audit_export() {
  command -v jq >/dev/null 2>&1 || { printf '%s\n' 'agent-guard: log export requires jq.' >&2; return 2; }
  ag_dir=$(audit_directory) || { printf '%s\n' 'agent-guard: no private diagnostic log directory is available.' >&2; return 2; }
  for ag_file in "$ag_dir"/event-*; do
    [ -f "$ag_file" ] && [ ! -L "$ag_file" ] || continue
    [ "$(audit_stat "$ag_file")" = "$(id -u):600" ] || continue
    ag_bytes=$(wc -c <"$ag_file" | tr -d ' ')
    case "$ag_bytes" in ''|*[!0-9]*) continue ;; esac
    [ "$ag_bytes" -le 2048 ] || continue
    # Rebuild the schema, dropping unknown keys. Validate every field so a
    # manually edited/corrupt log cannot smuggle source data into an export.
    jq -c '
      select(type == "object" and .schema == 1)
      | select(.run_id | type == "string" and test("^[0-9]{1,12}-[A-Za-z0-9]{6}$"))
      | select(.time | type == "number" and . >= 0 and . <= 9999999999 and floor == .)
      | select(.version | type == "string" and test("^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$"))
      | select(.command | IN("hook-pre-tool", "hook-post-tool", "hook-stop", "hook-user-prompt", "hook-session-start", "scan-staged", "scan-working-tree", "scan-path", "exec", "pii-filter"))
      | select(.host | IN("claude", "codex", "cli"))
      | select(.phase | IN("started", "finished"))
      | select(.outcome | IN("pending", "pass", "blocked", "masked", "degraded", "error", "interrupted", "warned"))
      | select(.exit_code == null or (.exit_code | type == "number" and . >= 0 and . <= 255 and floor == .))
      | select(.duration_seconds | type == "number" and . >= 0 and . <= 9999999999 and floor == .)
      | {schema,run_id,time,version,command,host,phase,outcome,exit_code,duration_seconds}
    ' "$ag_file" 2>/dev/null || :
  done
}

# Write a complete export into a private temporary file in the requested parent,
# then publish it with link(2). A hard-link creation fails if FILE already exists,
# unlike mv, so an existing regular file, directory, FIFO, or symlink is never
# overwritten. The temporary file and its final name are in one filesystem.
audit_export_to_file() (
  ag_output=$1
  case "$ag_output" in '') printf '%s\n' 'agent-guard: log export output path is required.' >&2; return 2 ;; esac
  ag_parent=$(dirname -- "$ag_output") || return 2
  [ -d "$ag_parent" ] && [ ! -L "$ag_parent" ] || {
    printf '%s\n' 'agent-guard: log export parent directory must already exist and not be a symlink.' >&2
    return 2
  }
  [ ! -e "$ag_output" ] && [ ! -L "$ag_output" ] || {
    printf '%s\n' 'agent-guard: refusing to overwrite an existing log export target.' >&2
    return 2
  }
  ag_tmp=
  trap '[ -z "$ag_tmp" ] || rm -f -- "$ag_tmp"' 0
  ag_tmp=$(umask 077; mktemp "$ag_parent/.agent-guard-support.XXXXXX" 2>/dev/null) || {
    printf '%s\n' 'agent-guard: could not create a private temporary log export file.' >&2
    return 2
  }
  if [ ! -f "$ag_tmp" ] || [ -L "$ag_tmp" ] || [ "$(audit_stat "$ag_tmp")" != "$(id -u):600" ]; then
    printf '%s\n' 'agent-guard: temporary log export file was not private.' >&2
    return 2
  fi
  audit_export >"$ag_tmp" || return $?
  ln "$ag_tmp" "$ag_output" 2>/dev/null || {
    printf '%s\n' 'agent-guard: refusing to overwrite an existing or invalid log export target.' >&2
    return 2
  }
  [ -f "$ag_output" ] && [ ! -L "$ag_output" ] && [ "$(audit_stat "$ag_output")" = "$(id -u):600" ] || {
    printf '%s\n' 'agent-guard: log export target was not a private regular file.' >&2
    return 2
  }
  printf 'agent-guard: exported metadata-only support log to %s\n' "$ag_output" >&2
)

audit_logs() {
  case "${1:-status}" in
    -h|--help|help)
      [ "$#" -eq 1 ] || { printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2; return 2; }
      printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2
      return 0
      ;;
    status)
      case "$#:${1:-}" in 0:|1:status) ;; *) printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2; return 2 ;; esac
      case "${AGENT_GUARD_LOG_MODE:-on}" in on|off) ag_mode=${AGENT_GUARD_LOG_MODE:-on} ;; *) ag_mode=invalid ;; esac
      printf 'Local diagnostic logging: %s\nDirectory: ${XDG_STATE_HOME:-~/.local/state}/agent-guard\nRetention target: 7 days, 1000 invocations; bounded cleanup runs at start, so concurrency or externally added files can exceed this.\n' "$ag_mode"
      if audit_directory >/dev/null; then printf 'Storage: private directory ready\n'; else printf 'Storage: not created or unavailable\n'; fi
      ;;
    export)
      shift
      case "$#" in
        0) audit_export ;;
        2) [ "$1" = --output ] || { printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2; return 2; }; audit_export_to_file "$2" ;;
        *) printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2; return 2 ;;
      esac
      ;;
    *) printf '%s\n' 'Usage: agent-guard logs [status|export [--output FILE]]' >&2; return 2 ;;
  esac
}

# Read hook JSON without depending on external `cat`: dependency-degraded PATH
# fixtures (and minimal hosts) still need the session_id to deduplicate warnings.
read_stdin() {
  # The shell loop below is O(lines x total bytes): a multi-hundred-KB paste
  # (exactly what hook-user-prompt exists to catch) burns the whole host hook
  # timeout inside the loop and the guard dies unrun. Prefer cat; the loop
  # remains only for a degraded PATH with no cat at all.
  if command -v cat >/dev/null 2>&1; then
    cat
    return 0
  fi
  stdin_value=
  while IFS= read -r stdin_line || [ -n "$stdin_line" ]; do
    if [ -n "$stdin_value" ]; then
      stdin_value="$stdin_value
$stdin_line"
    else
      stdin_value=$stdin_line
    fi
  done
  printf '%s' "$stdin_value"
}

die() {
  die_with_status 2 "$@"
}

die_with_status() {
  audit_note error
  failure_status=$1
  shift
  info "$PROGRAM: $*"
  exit "$failure_status"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 \
    || die_with_status "${2:-2}" "required command not found: $1"
}

resolve_gitleaks() {
  # A configured or private candidate is authoritative even when broken. A
  # silent fallback would make the active default rules depend on PATH again.
  if [ -n "${AGENT_GUARD_GITLEAKS_BIN:-}" ]; then
    ag_gl_candidate=$AGENT_GUARD_GITLEAKS_BIN
  elif [ -e "$GITLEAKS_PRIVATE_BIN_DIR/gitleaks" ] \
       || [ -L "$GITLEAKS_PRIVATE_BIN_DIR/gitleaks" ]; then
    ag_gl_candidate=$GITLEAKS_PRIVATE_BIN_DIR/gitleaks
  elif command -v gitleaks >/dev/null 2>&1; then
    ag_gl_candidate=$(command -v gitleaks) || return 1
  else
    return 1
  fi
  if [ -x "$ag_gl_candidate" ]; then
    ag_gl_dir=${ag_gl_candidate%/*}
    ag_gl_name=${ag_gl_candidate##*/}
    if [ "$ag_gl_dir" = "$ag_gl_candidate" ]; then
      ag_gl_dir=.
    elif [ -z "$ag_gl_dir" ]; then
      ag_gl_dir=/
    fi
    ag_gl_dir=$(CDPATH= cd -- "$ag_gl_dir" 2>/dev/null && pwd -P) \
      || return 1
    printf '%s/%s\n' "$ag_gl_dir" "$ag_gl_name"
    return 0
  fi
  printf '%s\n' "$ag_gl_candidate"
}

GITLEAKS_MIN_VERSION=8.30.0
GITLEAKS_DEFAULT_VERSION=8.30.1
GITLEAKS_PROBE_TIMEOUT_SECONDS=2
GITLEAKS_PROBE_MAX_BYTES=8192
GITLEAKS_PROBE_STATE=
GITLEAKS_PROBE_VERSION=
GITLEAKS_PROBE_DETAIL=
GITLEAKS_READY_BIN=
AG_GITLEAKS_PROBE_PID=
AG_GITLEAKS_PROBE_GROUP=
AG_GITLEAKS_WATCHDOG_PID=
GITLEAKS_PROBE_FALLBACK_DIR=
GITLEAKS_PROBE_FALLBACK_BASE=
GITLEAKS_PROBE_FALLBACK_OUTPUT=
GITLEAKS_PROBE_FALLBACK_TIMEOUT=
GITLEAKS_PROBE_FILE=
GITLEAKS_PROBE_MKDIR_BIN=
GITLEAKS_PROBE_RMDIR_BIN=
GITLEAKS_PROBE_LAUNCHER=
GITLEAKS_PROBE_LAUNCHER_BIN=

kill_gitleaks_probe_group() {
  ag_gl_signal=$1
  case "$AG_GITLEAKS_PROBE_GROUP" in
    ''|*[!0-9]*) return 0 ;;
  esac
  kill -"$ag_gl_signal" -"$AG_GITLEAKS_PROBE_GROUP" 2>/dev/null || :
}

clear_gitleaks_probe_processes() {
  if [ -n "$AG_GITLEAKS_WATCHDOG_PID" ]; then
    kill -TERM "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
    wait "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
    AG_GITLEAKS_WATCHDOG_PID=
  fi
  if [ -n "$AG_GITLEAKS_PROBE_PID" ]; then
    kill_gitleaks_probe_group TERM
    kill -TERM "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    kill_gitleaks_probe_group KILL
    kill -KILL "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    wait "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    AG_GITLEAKS_PROBE_PID=
    AG_GITLEAKS_PROBE_GROUP=
  fi
  for ag_gl_temp_path in \
    "$GITLEAKS_PROBE_FALLBACK_OUTPUT" "$GITLEAKS_PROBE_FALLBACK_TIMEOUT"; do
    [ -n "$ag_gl_temp_path" ] || continue
    if [ -f "$ag_gl_temp_path" ] && [ ! -L "$ag_gl_temp_path" ]; then
      rm -f "$ag_gl_temp_path" 2>/dev/null || :
    fi
  done
  GITLEAKS_PROBE_FALLBACK_OUTPUT=
  GITLEAKS_PROBE_FALLBACK_TIMEOUT=
  if [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ -d "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ ! -L "$GITLEAKS_PROBE_FALLBACK_DIR" ]; then
    "${GITLEAKS_PROBE_RMDIR_BIN:-rmdir}" \
      "$GITLEAKS_PROBE_FALLBACK_DIR" 2>/dev/null || :
  fi
  GITLEAKS_PROBE_FALLBACK_DIR=
}

mktemp_gitleaks_probe_file() {
  ag_gl_temp_kind=$1
  GITLEAKS_PROBE_FILE=$(mktemp_file 2>/dev/null) && return 0

  # Version output is not secret-bearing hook data. Keep the readiness probe
  # available when mktemp itself is unavailable. Atomically acquire a private
  # directory first, so a pre-existing FIFO or symlink can only occupy one
  # candidate directory name and is never opened as a file.
  if [ -z "$GITLEAKS_PROBE_FALLBACK_DIR" ]; then
    GITLEAKS_PROBE_MKDIR_BIN=$(command -v mkdir 2>/dev/null) || {
      GITLEAKS_PROBE_DETAIL=temp-helper-unavailable
      return 1
    }
    GITLEAKS_PROBE_RMDIR_BIN=$(command -v rmdir 2>/dev/null) || {
      GITLEAKS_PROBE_DETAIL=temp-helper-unavailable
      return 1
    }
    ag_gl_temp_attempt=0
    while [ "$ag_gl_temp_attempt" -lt 10 ]; do
      ag_gl_temp_dir="$GITLEAKS_PROBE_FALLBACK_BASE/agent-guard-version-$$-$ag_gl_temp_attempt.d"
      if (umask 077; "$GITLEAKS_PROBE_MKDIR_BIN" "$ag_gl_temp_dir") 2>/dev/null; then
        GITLEAKS_PROBE_FALLBACK_DIR=$ag_gl_temp_dir
        break
      fi
      ag_gl_temp_attempt=$((ag_gl_temp_attempt + 1))
    done
    [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] || return 1
  fi
  GITLEAKS_PROBE_FILE="$GITLEAKS_PROBE_FALLBACK_DIR/$ag_gl_temp_kind"
  (umask 077; : >"$GITLEAKS_PROBE_FILE") 2>/dev/null || return 1
  case "$ag_gl_temp_kind" in
    output) GITLEAKS_PROBE_FALLBACK_OUTPUT=$GITLEAKS_PROBE_FILE ;;
    timeout) GITLEAKS_PROBE_FALLBACK_TIMEOUT=$GITLEAKS_PROBE_FILE ;;
  esac
  return 0
}

release_gitleaks_probe_fallback_dir() {
  [ -z "$GITLEAKS_PROBE_FALLBACK_OUTPUT" ] || return 0
  [ -z "$GITLEAKS_PROBE_FALLBACK_TIMEOUT" ] || return 0
  [ -n "$GITLEAKS_PROBE_FALLBACK_DIR" ] || return 0
  if [ -d "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && [ ! -L "$GITLEAKS_PROBE_FALLBACK_DIR" ] \
      && "$GITLEAKS_PROBE_RMDIR_BIN" \
        "$GITLEAKS_PROBE_FALLBACK_DIR" 2>/dev/null; then
    GITLEAKS_PROBE_FALLBACK_DIR=
  fi
  return 0
}

remove_gitleaks_probe_file() {
  ag_gl_remove_kind=$1
  ag_gl_remove_path=$2
  rm -f "$ag_gl_remove_path" || return 1
  case "$ag_gl_remove_kind" in
    output)
      if [ "$GITLEAKS_PROBE_FALLBACK_OUTPUT" = "$ag_gl_remove_path" ]; then
        GITLEAKS_PROBE_FALLBACK_OUTPUT=
      fi
      ;;
    timeout)
      if [ "$GITLEAKS_PROBE_FALLBACK_TIMEOUT" = "$ag_gl_remove_path" ]; then
        GITLEAKS_PROBE_FALLBACK_TIMEOUT=
      fi
      ;;
  esac
  release_gitleaks_probe_fallback_dir
  return 0
}

select_gitleaks_probe_launcher() {
  if ag_gl_launcher=$(command -v setsid 2>/dev/null) \
      && [ -n "$ag_gl_launcher" ]; then
    GITLEAKS_PROBE_LAUNCHER=setsid
    GITLEAKS_PROBE_LAUNCHER_BIN=$ag_gl_launcher
    return 0
  fi
  if ag_gl_launcher=$(command -v perl 2>/dev/null) \
      && [ -n "$ag_gl_launcher" ]; then
    GITLEAKS_PROBE_LAUNCHER=perl
    GITLEAKS_PROBE_LAUNCHER_BIN=$ag_gl_launcher
    return 0
  fi
  GITLEAKS_PROBE_LAUNCHER=
  GITLEAKS_PROBE_LAUNCHER_BIN=
  return 1
}

probe_gitleaks() {
  ag_gl_probe_bin=$1
  GITLEAKS_PROBE_STATE=missing
  GITLEAKS_PROBE_VERSION=
  GITLEAKS_PROBE_DETAIL=
  [ -x "$ag_gl_probe_bin" ] || return 1
  GITLEAKS_PROBE_STATE=runtime-failure
  command -v sleep >/dev/null 2>&1 || {
    GITLEAKS_PROBE_DETAIL=timer-unavailable
    return 1
  }
  select_gitleaks_probe_launcher || {
    GITLEAKS_PROBE_DETAIL=launcher-unavailable
    return 1
  }
  GITLEAKS_PROBE_FALLBACK_BASE=${TMPDIR:-/tmp}
  case "$GITLEAKS_PROBE_FALLBACK_BASE" in
    /*) ;;
    *) GITLEAKS_PROBE_FALLBACK_BASE=/tmp ;;
  esac
  [ -d "$GITLEAKS_PROBE_FALLBACK_BASE" ] \
    && [ ! -L "$GITLEAKS_PROBE_FALLBACK_BASE" ] \
    || GITLEAKS_PROBE_FALLBACK_BASE=/tmp
  mktemp_gitleaks_probe_file output || {
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=temp-unavailable
    return 1
  }
  ag_gl_probe_output=$GITLEAKS_PROBE_FILE
  mktemp_gitleaks_probe_file timeout || {
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=temp-unavailable
    return 1
  }
  ag_gl_probe_timeout=$GITLEAKS_PROBE_FILE
  (
    # POSIX ulimit -f uses 512-byte blocks. Bounding the regular output file
    # prevents a broken version command from filling memory before parsing.
    ulimit -f 16 >/dev/null 2>&1 || exit 125
    case "$GITLEAKS_PROBE_LAUNCHER" in
      setsid) exec "$GITLEAKS_PROBE_LAUNCHER_BIN" "$ag_gl_probe_bin" version ;;
      perl)
        exec "$GITLEAKS_PROBE_LAUNCHER_BIN" -MPOSIX \
          -e 'POSIX::setsid() >= 0 or exit 125; exec @ARGV; exit 126' \
          "$ag_gl_probe_bin" version
        ;;
      *) exit 125 ;;
    esac
  ) >"$ag_gl_probe_output" 2>&1 &
  AG_GITLEAKS_PROBE_PID=$!
  AG_GITLEAKS_PROBE_GROUP=$AG_GITLEAKS_PROBE_PID
  (
    ag_gl_watch_sleep_pid=
    trap '[ -z "$ag_gl_watch_sleep_pid" ] || kill -TERM "$ag_gl_watch_sleep_pid" 2>/dev/null; exit 0' TERM INT
    sleep "$GITLEAKS_PROBE_TIMEOUT_SECONDS" &
    ag_gl_watch_sleep_pid=$!
    wait "$ag_gl_watch_sleep_pid" 2>/dev/null || exit 0
    ag_gl_watch_sleep_pid=
    printf 'timeout\n' >"$ag_gl_probe_timeout"
    kill_gitleaks_probe_group TERM
    kill -TERM "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
    sleep 1 &
    ag_gl_watch_sleep_pid=$!
    wait "$ag_gl_watch_sleep_pid" 2>/dev/null || exit 0
    ag_gl_watch_sleep_pid=
    kill_gitleaks_probe_group KILL
    kill -KILL "$AG_GITLEAKS_PROBE_PID" 2>/dev/null || :
  ) &
  AG_GITLEAKS_WATCHDOG_PID=$!
  wait "$AG_GITLEAKS_PROBE_PID" 2>/dev/null
  ag_gl_probe_status=$?
  AG_GITLEAKS_PROBE_PID=
  # A version wrapper may fork and exit before its child. The isolated group is
  # probe-private, so always clear any remaining descendants before returning.
  kill_gitleaks_probe_group TERM
  kill_gitleaks_probe_group KILL
  kill -TERM "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
  wait "$AG_GITLEAKS_WATCHDOG_PID" 2>/dev/null || :
  AG_GITLEAKS_WATCHDOG_PID=
  AG_GITLEAKS_PROBE_GROUP=
  ag_gl_probe_bytes=$(LC_ALL=C wc -c <"$ag_gl_probe_output" 2>/dev/null \
    | tr -d '[:space:]')
  if [ -s "$ag_gl_probe_timeout" ]; then
    GITLEAKS_PROBE_DETAIL=timeout
  else
    case "$ag_gl_probe_bytes" in
      ''|*[!0-9]*) GITLEAKS_PROBE_DETAIL=output-unavailable ;;
      *)
        if [ "$ag_gl_probe_bytes" -ge "$GITLEAKS_PROBE_MAX_BYTES" ]; then
          GITLEAKS_PROBE_DETAIL=output-limit
        fi
        ;;
    esac
  fi
  remove_gitleaks_probe_file timeout "$ag_gl_probe_timeout" || :
  if [ "$ag_gl_probe_status" -ne 0 ]; then
    [ -n "$GITLEAKS_PROBE_DETAIL" ] \
      || GITLEAKS_PROBE_DETAIL=command-failed
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    return 1
  fi
  if [ -n "$GITLEAKS_PROBE_DETAIL" ]; then
    remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
    return 1
  fi
  GITLEAKS_PROBE_VERSION=$(awk '
      {
        line = $0
        if (match(line, /[vV]?[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*/)) {
          version = substr(line, RSTART, RLENGTH)
          sub(/^[vV]/, "", version)
          print version
          exit
        }
      }
    ' "$ag_gl_probe_output")
  ag_gl_probe_status=$?
  remove_gitleaks_probe_file output "$ag_gl_probe_output" || :
  if [ "$ag_gl_probe_status" -ne 0 ] || [ -z "$GITLEAKS_PROBE_VERSION" ]; then
    GITLEAKS_PROBE_STATE=unparseable
    return 1
  fi
  if ! semver_at_least "$GITLEAKS_PROBE_VERSION" "$GITLEAKS_MIN_VERSION"; then
    GITLEAKS_PROBE_STATE=unsupported
    return 1
  fi
  GITLEAKS_PROBE_STATE=ready
  return 0
}

gitleaks_probe_error() {
  ag_gl_error_bin=$1
  case "$GITLEAKS_PROBE_STATE" in
    missing)
      printf 'selected gitleaks is not executable: %s' "$ag_gl_error_bin"
      ;;
    runtime-failure)
      case "$GITLEAKS_PROBE_DETAIL" in
        timeout)
          printf 'gitleaks version command timed out after %ss: %s' \
            "$GITLEAKS_PROBE_TIMEOUT_SECONDS" "$ag_gl_error_bin"
          ;;
        output-limit)
          printf 'gitleaks version output exceeded %s bytes: %s' \
            "$GITLEAKS_PROBE_MAX_BYTES" "$ag_gl_error_bin"
          ;;
        timer-unavailable)
          printf 'gitleaks version timeout helper is unavailable: sleep'
          ;;
        launcher-unavailable)
          printf 'gitleaks version isolation requires setsid or perl'
          ;;
        temp-helper-unavailable)
          printf 'gitleaks version temp fallback requires mkdir and rmdir'
          ;;
        *) printf 'gitleaks version command failed: %s' "$ag_gl_error_bin" ;;
      esac
      ;;
    unparseable)
      printf 'could not parse gitleaks version from %s (required >= %s)' \
        "$ag_gl_error_bin" "$GITLEAKS_MIN_VERSION"
      ;;
    unsupported)
      printf 'gitleaks %s is incompatible; required >= %s (%s)' \
        "$GITLEAKS_PROBE_VERSION" "$GITLEAKS_MIN_VERSION" "$ag_gl_error_bin"
      ;;
    *)
      printf 'gitleaks readiness probe failed: %s' "$ag_gl_error_bin"
      ;;
  esac
}

prepare_gitleaks() {
  if [ -n "$GITLEAKS_READY_BIN" ]; then
    GITLEAKS_BIN=$GITLEAKS_READY_BIN
    if [ ! -x "$GITLEAKS_BIN" ]; then
      GITLEAKS_PROBE_STATE=missing
      GITLEAKS_PROBE_DETAIL=
      return 1
    fi
    return 0
  fi
  GITLEAKS_BIN=$(resolve_gitleaks) || {
    GITLEAKS_PROBE_STATE=missing
    GITLEAKS_PROBE_DETAIL=no-candidate
    return 1
  }
  probe_gitleaks "$GITLEAKS_BIN" || return 1
  GITLEAKS_READY_BIN=$GITLEAKS_BIN
  return 0
}

need_gitleaks() {
  if ! prepare_gitleaks; then
    if [ -z "${GITLEAKS_BIN:-}" ]; then
      die_with_status "${1:-2}" \
        "required command not found: gitleaks (run: $PROGRAM setup)"
    fi
    probe_detail=$(gitleaks_probe_error "$GITLEAKS_BIN")
    die_with_status "${1:-2}" "$probe_detail"
  fi
  [ -f "$GITLEAKS_CONFIG" ] \
    || die_with_status "${1:-2}" "gitleaks config not found: $GITLEAKS_CONFIG"
}

hook_dependencies_ready() {
  command -v jq >/dev/null 2>&1 || return 1
  command -v awk >/dev/null 2>&1 || return 1
  prepare_gitleaks || return 1
  [ -f "$GITLEAKS_CONFIG" ] && policy_file_has_active_rule "$GITLEAKS_CONFIG" || return 1
  [ -f "$DENY_READ_PATHS" ] && policy_file_has_active_rule "$DENY_READ_PATHS" || return 1
  [ -f "$DENY_BASH_PATTERNS" ] && policy_file_has_active_rule "$DENY_BASH_PATTERNS" || return 1
}

infrastructure_failure_mode() {
  case "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" in
    open|closed) printf '%s\n' "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" ;;
    *) printf '%s\n' open ;;
  esac
}

hook_warning_once() {
  warning_input=${1:-}
  warning_session=${AGENT_GUARD_SESSION_ID:-}
  if [ -z "$warning_session" ] && command -v jq >/dev/null 2>&1; then
    warning_session=$(printf '%s' "$warning_input" | jq -r '.session_id // empty' 2>/dev/null) || warning_session=
  fi
  [ -n "$warning_session" ] || warning_session="${AGENT_GUARD_HOOK_HOST:-host}-${PPID:-0}"
  case "$warning_session" in
    *[!A-Za-z0-9._-]*) warning_session="${AGENT_GUARD_HOOK_HOST:-host}-${PPID:-0}" ;;
  esac
  warning_dir=${AGENT_GUARD_WARNING_DIR:-${TMPDIR:-/tmp}/agent-guard-warnings-${UID:-user}}
  if [ ! -d "$warning_dir" ]; then
    mkdir -p "$warning_dir" 2>/dev/null || return 0
    chmod 700 "$warning_dir" 2>/dev/null || :
  fi
  warning_marker="$warning_dir/infrastructure-$warning_session"
  (umask 077; set -C; : >"$warning_marker") 2>/dev/null
}

# Shared front half of every infrastructure-failure policy: warn once per
# session on stderr, apply the closed policy, and leave the message a caller
# may still want to publish in $INFRA_FAILURE_NOTICE (empty when this session
# already warned). Callers differ only in WHERE that notice goes, because a
# hook may write at most one top-level JSON response: a handler that prints its
# own object cannot be followed by a second one.
INFRA_FAILURE_NOTICE=

begin_infrastructure_failure() {
  audit_note degraded
  input=${1:-}
  detail=$2
  INFRA_FAILURE_NOTICE=
  mode=$(infrastructure_failure_mode)
  if hook_warning_once "$input"; then
    case "$mode" in
      closed) INFRA_FAILURE_NOTICE="$detail Blocking because AGENT_GUARD_INFRA_FAILURE_MODE=closed." ;;
      *) INFRA_FAILURE_NOTICE="$detail continuing because AGENT_GUARD_INFRA_FAILURE_MODE=open (the default)." ;;
    esac
    info "$INFRA_FAILURE_NOTICE"
  fi
  [ "$mode" = closed ] && exit 2
  return 0
}

# Emits the notice immediately. Only safe where the caller returns without
# writing anything else to stdout; hook-user-prompt defers instead.
handle_hook_infrastructure_failure() {
  event=$1
  begin_infrastructure_failure "${2:-}" "$3"
  [ -n "$INFRA_FAILURE_NOTICE" ] || return 0
  case "$event" in
    PreToolUse|PostToolUse|UserPromptSubmit)
      printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$INFRA_FAILURE_NOTICE"
      ;;
  esac
  return 0
}

# A malformed hook envelope is attacker-controlled input, not unavailable
# scanner infrastructure. It must never inherit the default open policy. A
# PreToolUse or Stop exit can prevent the unsafe boundary action; PostToolUse
# runs after the tool, so its exit is only an explicit diagnostic after the
# valid-envelope recovery path has failed. Do not deduplicate the diagnostic.
validate_hook_object() {
  event=$1
  input=${2:-}
  if printf '%s' "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
    return 0
  fi
  audit_note blocked
  case "$event" in
    PostToolUse)
      info "$PROGRAM: the $event hook input was not a JSON object; rejecting malformed input, but the host may retain an already-completed tool result"
      ;;
    *)
      info "$PROGRAM: the $event hook input was not a JSON object; blocking because malformed hook input cannot be inspected safely"
      ;;
  esac
  exit 2
}

# Which host's hook contract this invocation speaks. Every host-conditional
# branch routes through this single default so adding a host or changing the
# fallback is a one-line change, not a grep for scattered ':-claude' defaults.
hook_host() {
  printf '%s\n' "${AGENT_GUARD_HOOK_HOST:-claude}"
}

degraded_hook_message() {
  case "$(hook_host)" in
    codex) setup_ref='$setup-agent-guard' ;;
    *) setup_ref='/agent-guard:setup-agent-guard' ;;
  esac
  printf 'agent-guard: protection is DEGRADED because jq, awk, git, gitleaks (including its setsid or Perl process-isolation helper), or a policy file is unavailable. Run %s (or agent-guard setup), approve any required installation, verify with agent-guard check and smoke-test, then restart the host;' "$setup_ref"
}

emit_degraded_hook_warning() {
  event=$1
  input=${2:-}
  handle_hook_infrastructure_failure "$event" "$input" "$(degraded_hook_message)"
}

# PostToolUse may still emit one redaction response after an open git-backstop
# failure. Warn on stderr only here so the hook never emits two JSON responses.
handle_git_infrastructure_failure() {
  begin_infrastructure_failure "${1:-}" "$2"
  return 0
}

jq_lookbehind_supported() {
  printf '%s\n' '"x1"' \
    | jq -e 'test("(?<![0-9])1")' >/dev/null 2>&1
}

semver_at_least() (
  actual=$1
  required=$2
  old_ifs=$IFS
  IFS=.
  # shellcheck disable=SC2086
  set -- $actual
  actual_major=${1:-0}; actual_minor=${2:-0}; actual_patch=${3:-0}
  # shellcheck disable=SC2086
  set -- $required
  required_major=${1:-0}; required_minor=${2:-0}; required_patch=${3:-0}
  IFS=$old_ifs
  [ "$actual_major" -gt "$required_major" ] && return 0
  [ "$actual_major" -lt "$required_major" ] && return 1
  [ "$actual_minor" -gt "$required_minor" ] && return 0
  [ "$actual_minor" -lt "$required_minor" ] && return 1
  [ "$actual_patch" -ge "$required_patch" ]
)

check_deps() {
  need_cmd sh
  need_cmd jq
  need_cmd git
  need_cmd awk
  need_gitleaks
  [ -f "$DENY_READ_PATHS" ] || die "deny read policy not found: $DENY_READ_PATHS"
  [ -f "$DENY_BASH_PATTERNS" ] || die "deny bash policy not found: $DENY_BASH_PATTERNS"
  info "$PROGRAM: dependencies ok"
  if jq_lookbehind_supported; then
    info "$PROGRAM: jq regex lookbehind supported"
  else
    info "$PROGRAM: jq regex lookbehind unavailable (PostToolUse uses the conservative shape-preserving fallback)"
  fi
  info "$PROGRAM: gitleaks $GITLEAKS_PROBE_VERSION (required >= $GITLEAKS_MIN_VERSION; $GITLEAKS_BIN)"
}

SETUP_INSTALL_DIR=$GITLEAKS_PRIVATE_BIN_DIR

setup_status_line() {
  name=$1
  if command -v "$name" >/dev/null 2>&1; then
    ver=$($name --version 2>/dev/null | head -1)
    if [ -z "$ver" ]; then
      ver=$($name version 2>/dev/null | head -1)
    fi
    info "$PROGRAM: $name  ok  (${ver:-installed})"
    return 0
  fi
  info "$PROGRAM: $name  missing"
  return 1
}

setup_gitleaks_status_line() {
  if gl=$(resolve_gitleaks); then
    if probe_gitleaks "$gl"; then
      info "$PROGRAM: gitleaks  ok  ($GITLEAKS_PROBE_VERSION; $gl)"
      return 0
    fi
    case "$GITLEAKS_PROBE_STATE" in
      missing)
        info "$PROGRAM: gitleaks  missing  (selected path is not executable: $gl)"
        ;;
      runtime-failure)
        probe_detail=$(gitleaks_probe_error "$gl")
        info "$PROGRAM: gitleaks  runtime failure  ($probe_detail)"
        ;;
      unparseable)
        info "$PROGRAM: gitleaks  unparseable  (required >= $GITLEAKS_MIN_VERSION; $gl)"
        ;;
      unsupported)
        info "$PROGRAM: gitleaks  unsupported  ($GITLEAKS_PROBE_VERSION; required >= $GITLEAKS_MIN_VERSION; $gl)"
        ;;
      *) info "$PROGRAM: gitleaks  unavailable  ($gl)" ;;
    esac
    return 1
  fi
  if [ -n "${AGENT_GUARD_GITLEAKS_BIN:-}" ]; then
    info "$PROGRAM: gitleaks  missing (AGENT_GUARD_GITLEAKS_BIN is not executable: $AGENT_GUARD_GITLEAKS_BIN)"
  else
    info "$PROGRAM: gitleaks  missing"
  fi
  return 1
}

setup_jq_lookbehind_status_line() {
  if jq_lookbehind_supported; then
    info "$PROGRAM: jq regex lookbehind  supported"
  else
    info "$PROGRAM: jq regex lookbehind  unavailable (PostToolUse uses the conservative shape-preserving fallback)"
  fi
  return 0
}

setup_suggest_jq_install() {
  if command -v brew >/dev/null 2>&1; then
    info "  brew install jq"
  elif command -v apt-get >/dev/null 2>&1; then
    info "  sudo apt-get install -y jq"
  elif command -v dnf >/dev/null 2>&1; then
    info "  sudo dnf install -y jq"
  else
    info "  https://stedolan.github.io/jq/download/"
  fi
}

setup_suggest_git_install() {
  if command -v brew >/dev/null 2>&1; then
    info "  brew install git"
  elif command -v apt-get >/dev/null 2>&1; then
    info "  sudo apt-get install -y git"
  elif command -v dnf >/dev/null 2>&1; then
    info "  sudo dnf install -y git"
  else
    info "  https://git-scm.com/downloads"
  fi
}

setup_suggest_gitleaks_runtime_repair() {
  case "$GITLEAKS_PROBE_DETAIL" in
    launcher-unavailable)
      info "$PROGRAM: install a gitleaks process-isolation helper:"
      if command -v brew >/dev/null 2>&1; then
        info "  brew install perl"
      elif command -v apt-get >/dev/null 2>&1; then
        info "  sudo apt-get install -y util-linux"
      elif command -v dnf >/dev/null 2>&1; then
        info "  sudo dnf install -y util-linux"
      else
        info "  install setsid (util-linux) or Perl, then rerun $PROGRAM doctor"
      fi
      return 0
      ;;
    timer-unavailable)
      info "$PROGRAM: install the POSIX sleep utility, then rerun $PROGRAM doctor"
      return 0
      ;;
    temp-helper-unavailable)
      info "$PROGRAM: install the POSIX mkdir and rmdir utilities, then rerun $PROGRAM doctor"
      return 0
      ;;
  esac
  return 1
}

setup_install_gitleaks() {
  version=$1
  checksum=$2
  if [ -z "$checksum" ]; then
    die "setup: --gitleaks-checksum is required when using --install. Get the published value from https://github.com/gitleaks/gitleaks/releases/download/v${version}/gitleaks_${version}_checksums.txt"
  fi

  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m)
  case "$arch" in
    x86_64|amd64) arch=x64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) die "setup: unsupported architecture: $arch" ;;
  esac
  case "$os" in
    darwin|linux) ;;
    *) die "setup: unsupported os: $os" ;;
  esac

  need_cmd curl
  need_cmd shasum
  need_cmd tar

  archive="gitleaks_${version}_${os}_${arch}.tar.gz"
  url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}"

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-setup.XXXXXX") || die "setup: failed to create temp dir"
  # POSIX trap chain so caller's traps still run.
  trap 'rm -rf "$tmp"' EXIT

  info "$PROGRAM: downloading $archive"
  curl -fsSL "$url" -o "$tmp/$archive" || die "setup: download failed: $url"

  info "$PROGRAM: verifying sha256"
  printf '%s  %s\n' "$checksum" "$tmp/$archive" | shasum -a 256 -c - >&2 \
    || die "setup: checksum verification failed for $archive"

  info "$PROGRAM: extracting"
  tar -xzf "$tmp/$archive" -C "$tmp" || die "setup: extraction failed"

  mkdir -p "$SETUP_INSTALL_DIR" || die "setup: cannot create install dir: $SETUP_INSTALL_DIR"
  mv "$tmp/gitleaks" "$SETUP_INSTALL_DIR/gitleaks" || die "setup: failed to install gitleaks binary"
  chmod +x "$SETUP_INSTALL_DIR/gitleaks"

  info "$PROGRAM: installed gitleaks v${version} at $SETUP_INSTALL_DIR/gitleaks"
  case ":$PATH:" in
    *":$SETUP_INSTALL_DIR:"*) ;;
    *)
      info "$PROGRAM: $SETUP_INSTALL_DIR is not on PATH; add to your shell rc:"
      info "  export PATH=\"$SETUP_INSTALL_DIR:\$PATH\""
      ;;
  esac
}

do_setup() {
  install=0
  version=$GITLEAKS_DEFAULT_VERSION
  checksum=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) install=1 ;;
      --gitleaks-version)
        shift
        [ $# -gt 0 ] || die "setup: --gitleaks-version requires a value"
        version=$1
        ;;
      --gitleaks-version=*) version=${1#--gitleaks-version=} ;;
      --gitleaks-checksum)
        shift
        [ $# -gt 0 ] || die "setup: --gitleaks-checksum requires a value"
        checksum=$1
        ;;
      --gitleaks-checksum=*) checksum=${1#--gitleaks-checksum=} ;;
      -h|--help)
        cat >&2 <<'EOF'
Usage:
  agent-guard setup
  agent-guard setup --install --gitleaks-checksum SHA [--gitleaks-version X.Y.Z]

Default behavior is opt-in: setup only reports the dependency status.
Pass --install to download gitleaks. The checksum is required and must
match the published value at:
  https://github.com/gitleaks/gitleaks/releases/download/vX.Y.Z/gitleaks_X.Y.Z_checksums.txt
EOF
        return 0
        ;;
      *) die "setup: unknown argument: $1" ;;
    esac
    shift
  done

  jq_ok=1; git_ok=1; gitleaks_ok=1
  setup_status_line jq       || jq_ok=0
  [ "$jq_ok" -eq 0 ] || setup_jq_lookbehind_status_line
  setup_status_line git      || git_ok=0
  setup_gitleaks_status_line || gitleaks_ok=0
  # setup and doctor can establish only local dependencies.
  # A host must still dispatch one of its hook commands before runtime
  # protection can be observed; never imply that this CLI has inspected that
  # boundary or authenticated a host decision.
  info "$PROGRAM: host hook protection: unverified (dependency checks do not observe tool dispatch)"

  if [ "$install" -eq 1 ]; then
    gitleaks_runtime_ok=1
    if [ "$gitleaks_ok" -eq 1 ]; then
      info "$PROGRAM: gitleaks already available; skipping --install"
    elif setup_suggest_gitleaks_runtime_repair; then
      gitleaks_runtime_ok=0
    elif ! select_gitleaks_probe_launcher; then
      GITLEAKS_PROBE_DETAIL=launcher-unavailable
      setup_suggest_gitleaks_runtime_repair
      gitleaks_runtime_ok=0
    else
      setup_install_gitleaks "$version" "$checksum"
      GITLEAKS_READY_BIN=
      if ! setup_gitleaks_status_line; then
        gitleaks_runtime_ok=0
        setup_suggest_gitleaks_runtime_repair || :
      fi
    fi
    if [ "$jq_ok" -eq 0 ]; then
      info "$PROGRAM: jq is not auto-installed; use your system package manager:"
      setup_suggest_jq_install
    fi
    if [ "$git_ok" -eq 0 ]; then
      info "$PROGRAM: git is not auto-installed; use your system package manager:"
      setup_suggest_git_install
    fi
    [ "$jq_ok" -eq 1 ] && [ "$git_ok" -eq 1 ] \
      && [ "$gitleaks_runtime_ok" -eq 1 ]
    return $?
  fi

  if [ "$jq_ok" -eq 0 ] || [ "$git_ok" -eq 0 ] || [ "$gitleaks_ok" -eq 0 ]; then
    info ""
    if [ "$jq_ok" -eq 0 ]; then
      info "$PROGRAM: install jq with your package manager:"
      setup_suggest_jq_install
    fi
    if [ "$git_ok" -eq 0 ]; then
      info "$PROGRAM: install git with your package manager:"
      setup_suggest_git_install
    fi
    if [ "$gitleaks_ok" -eq 0 ]; then
      if ! setup_suggest_gitleaks_runtime_repair; then
        info "$PROGRAM: install gitleaks (rerun with --install to opt in):"
        info "  agent-guard setup --install \\"
        info "    --gitleaks-version $GITLEAKS_DEFAULT_VERSION \\"
        info "    --gitleaks-checksum <sha256-from-published-checksums.txt>"
        info ""
        info "$PROGRAM: get the checksum from"
        info "  https://github.com/gitleaks/gitleaks/releases/download/v$GITLEAKS_DEFAULT_VERSION/gitleaks_${GITLEAKS_DEFAULT_VERSION}_checksums.txt"
      fi
    fi
    return 1
  fi

  info "$PROGRAM: setup ok (dependencies only)"
  return 0
}

write_private_key_fixture() {
  path=$1
  body=AGENT-GUARD-FIXTURE-NEVER-A-REAL-KEY
  body="${body}-${body}-${body}-${body}"
  {
    printf '%s%s\n' '-----BEGIN RSA ' 'PRIVATE KEY-----'
    printf '%s\n' "$body"
    printf '%s%s\n' '-----END RSA ' 'PRIVATE KEY-----'
  } >"$path"
}

smoke_expect() {
  expected=$1
  label=$2
  shift 2
  ( "$@" ) >/dev/null 2>&1
  status=$?
  if [ "$status" -eq "$expected" ]; then
    info "$PROGRAM: smoke ok: $label"
    return 0
  fi
  die "smoke failed: $label (expected exit $expected, got $status)"
}

smoke_test() {
  check_deps
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-smoke.XXXXXX") || die "smoke: failed to create temp dir"
  trap 'rm -rf "$tmp"' EXIT INT TERM

  mkdir -p "$tmp/clean" "$tmp/dirty"
  printf '%s\n' "console.log('ok')" >"$tmp/clean/app.js"
  write_private_key_fixture "$tmp/dirty/private-key-fixture.txt"

  smoke_expect 0 "scan-path allows a clean directory" scan_path "$tmp/clean"
  smoke_expect 1 "scan-path blocks a private-key fixture" scan_path "$tmp/dirty"

  printf '%s' '{"tool_name":"Read","tool_input":{"file_path":".env"}}' \
    | smoke_expect 2 "hook-pre-tool blocks .env reads" hook_pre_tool

  printf '%s\n' "Contact smoke@example.com from 203.0.113.42" \
    | smoke_expect 0 "pii-filter runs with the regex provider" pii_filter

  write_payload=$(mktemp_file) || die "smoke: failed to create temp file"
  {
    printf '%s' '{"tool_name":"Write","tool_input":{"file_path":"guard-fixture.txt","content":"'
    sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' "$tmp/dirty/private-key-fixture.txt" | tr -d '\n'
    printf '%s\n' '"}}'
  } >"$write_payload"
  smoke_expect 2 "hook-pre-tool blocks secret-like writes" hook_pre_tool <"$write_payload"
  rm -f "$write_payload"

  repo="$tmp/repo"
  mkdir -p "$repo"
  (
    cd "$repo" || exit 2
    git init -q || exit 2
    git config user.email test@example.com || exit 2
    git config user.name "Agent Guard Smoke" || exit 2
    git config commit.gpgsign false || exit 2
    printf '%s\n' ok >README.md
    git add README.md || exit 2
    git commit -q -m init || exit 2
    mkdir -p githooks
    {
      printf '%s\n' '#!/usr/bin/env sh'
      printf 'exec "%s" scan-staged\n' "$BIN_DIR/agent-guard"
    } >githooks/pre-commit
    chmod +x githooks/pre-commit || exit 2
    git config core.hooksPath githooks || exit 2
    write_private_key_fixture staged-fixture.txt
    git add staged-fixture.txt || exit 2
    git commit -m leak >/dev/null 2>&1
    status=$?
    [ "$status" -ne 0 ] || exit 1
  ) || die "smoke failed: native pre-commit hook did not block staged fixture"
  info "$PROGRAM: smoke ok: native pre-commit hook blocks staged fixture"
  info "$PROGRAM: smoke-test ok"
}

mktemp_file() {
  # Every scan temp file lands under the per-invocation rundir (created once at
  # dispatch) so the single EXIT/INT/TERM trap removes all of them even when a
  # scan is interrupted mid-run. The fallback preserves the original per-file
  # behavior when there is no rundir — sourced in tests, or its creation failed —
  # so temp allocation never hard-fails.
  if [ -n "${AGENT_GUARD_RUNDIR:-}" ] && [ -d "$AGENT_GUARD_RUNDIR" ]; then
    mktemp "$AGENT_GUARD_RUNDIR/agent-guard.XXXXXX" 2>/dev/null && return 0
  fi
  mktemp "${TMPDIR:-/tmp}/agent-guard.XXXXXX" 2>/dev/null || mktemp /tmp/agent-guard.XXXXXX
}

pii_filter_usage() {
  cat >&2 <<'EOF'
Usage:
  agent-guard pii-filter [--check]

Reads text from stdin and writes masked text to stdout.
Set AGENT_GUARD_PII_PROVIDER=regex|http|pleno to choose a provider (default: regex).
  regex  built-in local adapter; no network access.
  http   experimental bring-your-own-endpoint adapter; needs
         AGENT_GUARD_PII_REDACT_URL; no service compatibility guarantee.
  pleno  verified pleno-anonymize /api/redact adapter; needs
         AGENT_GUARD_PII_REDACT_URL. AGENT_GUARD_PII_LANGUAGE defaults to en.
EOF
}

# Keep accepted-value validation in one place so filter and --check cannot
# drift apart. Unknown values fail closed rather than reaching pass-through
# output or an unvalidated endpoint contract.
pii_unsupported_provider() {
  die "pii-filter: unsupported provider: $1 (expected regex, http, or pleno)"
}

pii_provider() {
  provider=${AGENT_GUARD_PII_PROVIDER:-regex}
  case "$provider" in
    regex|http|pleno) printf '%s' "$provider" ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
}

# Tier-1 types AGENT_GUARD_PII_SKIP may turn off. Tier-2 (credit card, US SSN,
# KR resident reg. no.) is deliberately absent: masking those is what the
# mask-mode input hard-block is derived from, and a fail-closed gate must not be
# switchable from the environment. The names are the output placeholders
# (`[PII:IP_ADDRESS]`), so what to write is readable off the masked output.
PII_SKIPPABLE=',EMAIL,PHONE,IP_ADDRESS,'

# Prints the skip set normalized to `,A,B,` so a substring test is an exact name
# test. Separators are commas and/or spaces. An unknown or Tier-2 name dies
# rather than being ignored: someone who wrote AGENT_GUARD_PII_SKIP=CREDIT_CARD
# expects cards to pass and has to be told the knob cannot do that. Callers that
# read it through $( ) validate it once in the main shell first — otherwise the
# subshell swallows the die and the misconfiguration runs on silently.
pii_skip_set() {
  # skip_-prefixed names throughout: sh has no locals, and this runs in the main
  # shell of callers that hold their own `out` / `name` / `raw`.
  skip_raw=${AGENT_GUARD_PII_SKIP:-}
  [ -n "$skip_raw" ] || { printf ','; return 0; }
  case $- in *f*) skip_had_noglob=1 ;; *) skip_had_noglob=0 ;; esac
  skip_oifs=$IFS
  IFS=', '
  set -f
  # Intentional word splitting: this is the list parse.
  set -- $skip_raw
  IFS=$skip_oifs
  [ "$skip_had_noglob" -eq 1 ] || set +f
  skip_out=,
  for skip_name in "$@"; do
    case "$PII_SKIPPABLE" in
      *",$skip_name,"*) ;;
      *) die "AGENT_GUARD_PII_SKIP: unsupported type: $skip_name (expected EMAIL, PHONE, or IP_ADDRESS)" ;;
    esac
    case $skip_out in
      *",$skip_name,"*) continue ;;
    esac
    skip_out="$skip_out$skip_name,"
  done
  # An endpoint provider redacts server-side and never receives the skip set, so
  # accepting one would leave a switch that silently does nothing on every path
  # that goes through the provider. An unknown provider value is left alone here
  # so pii_provider still reports it as the provider error it is.
  if [ "$skip_out" != , ]; then
    case "${AGENT_GUARD_PII_PROVIDER:-regex}" in
      http|pleno)
        die "AGENT_GUARD_PII_SKIP is only supported with AGENT_GUARD_PII_PROVIDER=regex (got ${AGENT_GUARD_PII_PROVIDER})"
        ;;
    esac
  fi
  printf '%s' "$skip_out"
}

# Held here so the CLI masker and the hook input gate below read the SAME
# Tier-2 patterns instead of two hand-kept copies. They contain no backslashes,
# so `awk -v` passes them through unchanged. mask_pii_response_json is a jq
# transcription of the same shapes and still has to change alongside them;
# tests/run.sh drives one sample of each through all three.
# The 19-digit PAN is a separate pattern rather than an optional tail group:
# greedy matching would otherwise swallow a following 3-digit number, fail Luhn
# on the 19 digits, and lose the valid 16-digit card inside it. Longest first.
PII_CREDIT_CARD_RE='[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9]'
PII_CREDIT_CARD19_RE="$PII_CREDIT_CARD_RE"'[ -]?[0-9][0-9][0-9]'
PII_AMEX_RE='3[47][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9][0-9]'
PII_SSN_RE='[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
PII_KR_RRN_RE='[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9][0-9]'
PII_IPV4_RE='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))([.](25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))'

# awk has no \b and its gsub() cannot veto an individual match, so every
# validated pattern goes through mask_re(): it walks matches left to right,
# requires non-digit boundaries, and lets a validator reject a candidate. That
# is what keeps epoch-nanosecond timestamps and Snowflake ids — card-shaped but
# unbounded and Luhn-invalid — out of the Tier-2 verdict. Shared verbatim by
# pii_regex_adapter_filter and pii_tier2_present; mask_pii_response_json is the
# jq transcription (Oniguruma lookaround in place of the boundary checks) and
# must change alongside it. tests/run.sh drives every case through all three.
PII_AWK_LIB='
function tail2(s) { return (length(s) > 2) ? substr(s, length(s) - 1) : s }
function luhn(s,   i, d, sum, alt) {
  gsub(/[^0-9]/, "", s)
  sum = 0; alt = 0
  for (i = length(s); i >= 1; i--) {
    d = substr(s, i, 1) + 0
    if (alt) { d *= 2; if (d > 9) { d -= 9 } }
    sum += d
    alt = !alt
  }
  return (length(s) > 0 && sum % 10 == 0)
}
function pii_bounded(kind, before, after) {
  if (kind == "ipv4") { return (before !~ /[0-9][.]?$/ && after !~ /^[.]?[0-9]/) }
  return (before !~ /[0-9]$/ && after !~ /^[0-9]/)
}
BEGIN {
  # awk cannot start match() at an offset, so mask_re walks a sliding window
  # rather than re-slicing the whole remainder after every candidate — that
  # copy is per-candidate and turns one long line of card-shaped rejects
  # quadratic, past the 10s PreToolUse timeout in hooks/hooks.json.
  # PII_MARGIN must exceed the longest text any pattern can match (19 digits
  # plus three separators), so a match landing clear of the margin is whole.
  PII_WIN = 512
  PII_MARGIN = 64
}
function mask_re(s, re, repl, kind,   out, n, pos, win, wlen, mstart, mlen, mend, pre, m, after, skip) {
  n = length(s)
  out = ""
  pos = 1
  while (pos <= n) {
    win = substr(s, pos, PII_WIN)
    wlen = length(win)
    if (!match(win, re)) {
      # Nothing here. The tail margin may hold the start of a match that runs
      # past this window, so emit everything before it and slide.
      if (pos + wlen > n) { break }
      out = out substr(win, 1, wlen - PII_MARGIN)
      pos = pos + wlen - PII_MARGIN
      continue
    }
    mstart = RSTART
    mlen = RLENGTH
    mend = mstart + mlen - 1
    if (mstart > 1 && mend > wlen - PII_MARGIN && pos + wlen <= n) {
      # The match reaches into the margin with more input behind it, so it may
      # be truncated. Re-window from its start and look again.
      out = out substr(win, 1, mstart - 1)
      pos = pos + mstart - 1
      continue
    }
    pre = substr(win, 1, mstart - 1)
    m = substr(win, mstart, mlen)
    after = substr(win, mend + 1, 2)
    if (pii_bounded(kind, tail2(tail2(out) pre), after) \
        && (kind != "luhn" || luhn(m))) {
      out = out pre repl
      pos = pos + mend
    } else {
      # A rejected candidate cannot start again inside its own leading digit
      # run: every position in there has a digit in front of it, which the
      # boundary rule refuses. Skip the whole run, not one character.
      skip = match(m, /^[0-9]+/) ? RLENGTH : 1
      out = out pre substr(m, 1, skip)
      pos = pos + mstart - 1 + skip
    }
  }
  if (pos <= n) { out = out substr(s, pos) }
  return out
}
function mask_tier2(s) {
  s = mask_re(s, CC19_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, CC16_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, AMEX_RE, "[PII:CREDIT_CARD]", "luhn")
  s = mask_re(s, KR_RRN_RE, "[PII:KR_RRN]", "digits")
  s = mask_re(s, SSN_RE, "[PII:SSN]", "digits")
  return s
}
'

pii_regex_adapter_filter() {
  need_cmd awk
  skip=$(pii_skip_set) || exit 2
  awk -v CC16_RE="$PII_CREDIT_CARD_RE" -v CC19_RE="$PII_CREDIT_CARD19_RE" \
      -v AMEX_RE="$PII_AMEX_RE" -v SSN_RE="$PII_SSN_RE" \
      -v KR_RRN_RE="$PII_KR_RRN_RE" -v IPV4_RE="$PII_IPV4_RE" -v SKIP="$skip" \
      "$PII_AWK_LIB"'
    BEGIN {
      email = "[[:alnum:]_%+.-]+@[[:alnum:].-]+[.][[:alpha:]][[:alpha:]][[:alpha:]]*"
      kr_mobile = "01[0-9][ -]?[0-9][0-9][0-9][0-9][ -]?[0-9][0-9][0-9][0-9]"
      phone = "([+]?[0-9][ .-]?)?([(][0-9][0-9][0-9][)]|[0-9][0-9][0-9])[ .-]?[0-9][0-9][0-9][ .-]?[0-9][0-9][0-9][0-9]"
    }
    {
      if (NR > 1) {
        printf "%s", ORS
      }
      # Tier-2 first so a Tier-1 pattern cannot shadow it, and it is never
      # skippable — that ordering premise holds whatever SKIP contains.
      line = mask_tier2($0)
      if (!index(SKIP, ",IP_ADDRESS,")) {
        line = mask_re(line, IPV4_RE, "[PII:IP_ADDRESS]", "ipv4")
      }
      if (!index(SKIP, ",EMAIL,")) {
        gsub(email, "[PII:EMAIL]", line)
      }
      # Phone needs the same digit boundary: without it the generic 3-3-4 shape
      # matches the first 10 digits of any long numeric id, which the credit
      # card false positive used to hide.
      if (!index(SKIP, ",PHONE,")) {
        line = mask_re(line, kr_mobile, "[PII:PHONE]", "digits")
        line = mask_re(line, phone, "[PII:PHONE]", "digits")
      }
      printf "%s", line
    }
  '
}

pii_endpoint_adapter_filter() {
  provider=$1
  need_cmd curl
  need_cmd jq
  url=${AGENT_GUARD_PII_REDACT_URL:-}
  [ -n "$url" ] || die "pii-filter: AGENT_GUARD_PII_REDACT_URL is required for provider: $provider"

  timeout=${AGENT_GUARD_PII_TIMEOUT_SECONDS:-30}
  case "$timeout" in
    ''|*[!0-9]*) die "pii-filter: AGENT_GUARD_PII_TIMEOUT_SECONDS must be a positive integer" ;;
  esac
  [ "$timeout" -gt 0 ] 2>/dev/null \
    || die "pii-filter: AGENT_GUARD_PII_TIMEOUT_SECONDS must be a positive integer"
  if [ "${AGENT_GUARD_PII_HOOK_REQUEST:-}" = 1 ] && [ "$timeout" -gt 5 ]; then
    timeout=5
  fi

  # Provider differences end here, so the request and reader below stay common:
  # a change to the response contract — "exactly one JSON object", the
  # string-typed requirement, the fail-closed die — cannot land for one provider
  # and silently miss the other.
  case "$provider" in
    http)
      payload=$(jq -Rs '{text: .}') \
        || die "pii-filter: $provider provider request serialization failed"
      response_paths='[["redacted_text"],["anonymized_text"],["text"],["data","redacted_text"]]'
      response_shape='redacted_text, anonymized_text, text, or data.redacted_text'
      ;;
    pleno)
      language=${AGENT_GUARD_PII_LANGUAGE:-en}
      case "$language" in
        en|ja) ;;
        *) die "pii-filter: AGENT_GUARD_PII_LANGUAGE must be en or ja for provider: pleno" ;;
      esac
      payload=$(jq -Rs --arg language "$language" '{text: ., language: $language}') \
        || die "pii-filter: $provider provider request serialization failed"
      response_paths='[["text"]]'
      response_shape='string text'
      ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
  out=$(mktemp_file) || die "pii-filter: failed to create temp file"
  if ! printf '%s' "$payload" \
    | curl -fsS --max-time "$timeout" -H 'Content-Type: application/json' -d @- "$url" \
      >"$out" 2>/dev/null; then
    rm -f "$out"
    die "pii-filter: $provider provider request failed"
  fi

  # `first` stops at the earliest string-typed field, so a later path is never
  # evaluated once an earlier one matched — a response carrying both
  # `redacted_text` and a non-object `data` still resolves instead of erroring.
  # No match at all produces no output, which `-e` reports as a failure and the
  # die below turns into a fail-closed refusal rather than empty "masked" text.
  if ! jq -e -r -s -j --argjson paths "$response_paths" '
    if length != 1 or (.[0] | type != "object") then
      error("expected exactly one JSON object")
    else .[0]
    end
    | . as $body
    | first($paths[] as $path | $body | getpath($path) | select(type == "string"))
  ' "$out"; then
    rm -f "$out"
    die "pii-filter: $provider provider returned invalid response; expected JSON with $response_shape"
  fi
  rm -f "$out"
}

pii_adapter_filter() {
  if [ "$#" -gt 0 ]; then
    provider=$1
  else
    # `die` inside $( ) only kills the subshell, so propagate its status here
    # instead of continuing with an empty provider.
    provider=$(pii_provider) || exit 2
  fi
  case "$provider" in
    regex) pii_regex_adapter_filter ;;
    http|pleno) pii_endpoint_adapter_filter "$provider" ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
}

pii_adapter_check() {
  provider=$1
  case "$provider" in
    regex)
      need_cmd awk
      info "$PROGRAM: PII provider regex ok"
      ;;
    http|pleno)
      printf '%s' "agent-guard pii provider check" | pii_endpoint_adapter_filter "$provider" >/dev/null
      status=$?
      [ "$status" -eq 0 ] || exit "$status"
      info "$PROGRAM: PII provider $provider ok"
      ;;
    *) pii_unsupported_provider "$provider" ;;
  esac
}

pii_filter() {
  check=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --check) check=1 ;;
      -h|--help)
        pii_filter_usage
        return 0
        ;;
      *) die "pii-filter: unknown argument: $1" ;;
    esac
    shift
  done

  provider=$(pii_provider) || exit 2
  # Validate here, not only inside the adapter: --check never reaches the adapter
  # and would otherwise report "ok" for a skip set every real run refuses.
  pii_skip_set >/dev/null
  if [ "$check" -eq 1 ]; then
    pii_adapter_check "$provider"
    return 0
  fi
  pii_adapter_filter "$provider"
}

pii_text_has_match() {
  text=$1
  [ -n "$text" ] || return 1
  masked=$(printf '%s' "$text" | AGENT_GUARD_PII_HOOK_REQUEST=1 pii_adapter_filter)
  status=$?
  [ "$status" -eq 0 ] || exit "$status"
  [ "$masked" != "$text" ]
}

pii_hook_mode() {
  mode=${AGENT_GUARD_PII_HOOK_MODE:-off}
  case "$mode" in
    off|'') printf 'off' ;;
    block) printf 'block' ;;
    mask) printf 'mask' ;;
    *) die "unsupported PII hook mode: $mode (expected off, block, or mask)" ;;
  esac
}

# High-sensitivity ("Tier 2") PII that must never reach a tool input even in
# mask mode: SSN, credit card, and Korean resident registration number. Detected
# directly (provider-independent) so the input gate works for any provider, since
# only the regex adapter exposes typed markers. Reads the same PII_*_RE patterns
# the CLI masker uses; mask_pii_response_json is the jq transcription and must
# change with them. tests/run.sh drives a credit card, SSN, and resident reg. no.
# through this gate (expect exit 2) and through the masker.
pii_tier2_present() {
  text=$1
  [ -n "$text" ] || return 1
  need_cmd awk
  printf '%s' "$text" | awk -v CC16_RE="$PII_CREDIT_CARD_RE" \
      -v CC19_RE="$PII_CREDIT_CARD19_RE" -v AMEX_RE="$PII_AMEX_RE" \
      -v SSN_RE="$PII_SSN_RE" -v KR_RRN_RE="$PII_KR_RRN_RE" \
      "$PII_AWK_LIB"'
    mask_tier2($0) != $0 { found = 1 }
    END { exit (found ? 0 : 1) }
  '
}

# Input gate. block mode blocks ANY PII (run pii-filter first); mask mode only
# hard-blocks Tier-2 PII on the way in (Tier-1 — email/phone/IP — is allowed in
# and masked on the way out instead). off never reaches here.
block_on_pii_text() {
  label=$1
  text=$2
  case "$(pii_hook_mode)" in
    block)
      pii_text_has_match "$text" || return 0
      info "$PROGRAM: blocked PII in $label; run agent-guard pii-filter before using this tool"
      exit 2
      ;;
    mask)
      # Fail closed: only a definitive "no Tier-2 PII" (status 1) lets input
      # through; a detector error (awk missing/failed) blocks rather than
      # silently allowing high-sensitivity PII into the tool.
      pii_tier2_present "$text"
      status=$?
      case "$status" in
        1) return 0 ;;
        0) info "$PROGRAM: blocked high-sensitivity PII (SSN/credit card/resident reg. no.) in $label" ;;
        *) info "$PROGRAM: blocked input: Tier-2 PII detector failed (status $status) in $label" ;;
      esac
      exit 2
      ;;
  esac
}

check_pii_hook_input() {
  input=$1
  tool=$2
  # Validate the mode in the main shell first: pii_hook_mode dies on an
  # unsupported value, but the $(...) reads below would swallow that exit and
  # silently disable the gate. Running it here (no subshell) fails closed.
  pii_hook_mode >/dev/null
  pii_skip_set >/dev/null
  [ "$(pii_hook_mode)" = off ] && return 0
  need_cmd jq

  case "$tool" in
    Write)
      content=$(json_value '.tool_input.content // empty' "$input")
      block_on_pii_text "proposed Write content" "$content"
      ;;
    Edit)
      content=$(json_value '.tool_input.new_string // empty' "$input")
      block_on_pii_text "proposed Edit content" "$content"
      ;;
    MultiEdit)
      content=$(printf '%s' "$input" | jq -r '[.tool_input.edits[]?.new_string // empty] | join("\n")')
      block_on_pii_text "proposed MultiEdit content" "$content"
      ;;
    NotebookEdit)
      content=$(json_value '.tool_input.new_source // empty' "$input")
      block_on_pii_text "proposed NotebookEdit content" "$content"
      ;;
    apply_patch)
      patch=$(printf '%s' "$input" | jq -r '
        .tool_input.command // .tool_input.patch // .tool_input.input // .tool_input.diff // .tool_input.content // empty
        | if type == "string" then . else tojson end
      ')
      added=$(printf '%s\n' "$patch" | extract_patch_added_lines)
      block_on_pii_text "proposed apply_patch added lines" "$added"
      ;;
    Bash)
      content=$(json_value '.tool_input.command // .tool_input.cmd // empty' "$input")
      block_on_pii_text "Bash command" "$content"
      ;;
    WebFetch|WebSearch)
      content=$(printf '%s' "$input" | jq -r '.tool_input // {} | .. | strings')
      block_on_pii_text "$tool input" "$content"
      ;;
    Agent|Task)
      content=$(printf '%s' "$input" | jq -r '.tool_input // {} | .. | strings')
      block_on_pii_text "subagent delegation input" "$content"
      ;;
    mcp__*)
      content=$(printf '%s' "$input" | jq -r '.tool_input // {} | .. | strings')
      block_on_pii_text "MCP tool input" "$content"
      ;;
  esac
}

run_gitleaks_stdin() {
  label=$1
  need_gitleaks
  out=$(mktemp_file) || die "failed to create temp file"
  "$GITLEAKS_BIN" stdin --redact --no-banner --no-color --log-level error \
    --config "$GITLEAKS_CONFIG" --exit-code 1 >"$out" 2>&1
  status=$?
  if [ "$status" -eq 0 ]; then
    if [ -s "$out" ]; then
      info "$PROGRAM: gitleaks reported an error while scanning $label"
      sed 's/^/  /' "$out" >&2
      rm -f "$out"
      return 2
    fi
    rm -f "$out"
    return 0
  fi
  if [ "$status" -eq 1 ]; then
    info "$PROGRAM: secret-like value detected in $label"
    sed 's/^/  /' "$out" >&2
    rm -f "$out"
    return 1
  fi
  info "$PROGRAM: gitleaks failed while scanning $label"
  sed 's/^/  /' "$out" >&2
  rm -f "$out"
  return 2
}

# Filter records encoded as one lockfile-kind byte, a tab, then the original
# line. Keeping the checksum grammar in one place prevents staged diffs, host
# writes, untracked files, and path scans from drifting apart. Replace only the
# checksum field so any other same-line content is still scanned.
filter_lockfile_records() {
  forced_kind=${1:-}
  record_source=${2:--}
  LC_ALL=C awk -v forced_kind="$forced_kind" '
    function replace_match(line, replacement) {
      return substr(line, 1, RSTART - 1) replacement substr(line, RSTART + RLENGTH)
    }
    function hex_digit_value(ch, position) {
      if (length(ch) != 1) return -1
      position = index("0123456789abcdef", tolower(ch))
      return position ? position - 1 : -1
    }
    function unicode_escape_valid(line, at, width, i, digit, value) {
      value = 0
      for (i = 1; i <= width; i++) {
        digit = hex_digit_value(substr(line, at + 1 + i, 1))
        if (digit < 0) return 0
        value = value * 16 + digit
      }
      return value <= 1114111 && !(value >= 55296 && value <= 57343)
    }
    function basic_escape_valid(line, at, multiline, escaped_char, remainder) {
      escaped_char = substr(line, at + 1, 1)
      if (escaped_char == "\"" || escaped_char == "\\" \
          || escaped_char == "b" || escaped_char == "t" \
          || escaped_char == "n" || escaped_char == "f" \
          || escaped_char == "r")
        return 1
      if (escaped_char == "u") return unicode_escape_valid(line, at, 4)
      if (escaped_char == "U") return unicode_escape_valid(line, at, 8)
      # A multiline basic string may fold a physical line ending after a
      # backslash and optional spaces/tabs. awk has already removed the LF
      # record separator, but a CRLF record still has its terminal CR.
      if (multiline) {
        remainder = substr(line, at + 1)
        if (remainder ~ /^[ \t]*\r?$/) return 1
      }
      return 0
    }
    function toml_incomplete(kind) {
      return (kind == "c" || kind == "u") \
          && (toml_multiline != "" || toml_array_depth != 0 || toml_invalid)
    }
    function structured_delimiter(line, at, kind, n, ch) {
      n = length(line)
      # Yarn integrity and Cargo checksum are whole scalar fields. Accept only
      # end-of-record whitespace or a comment; malformed trailing data must
      # remain raw and scannable. package-lock and uv use inline containers.
      if (kind == "y" || kind == "c")
        return substr(line, at) ~ /^[[:space:]]*(#.*)?$/
      while (at <= n && substr(line, at, 1) ~ /[[:space:]]/) at++
      return at > n || substr(line, at, 1) == "," || substr(line, at, 1) == "}"
    }
    function field_replacement(line, at, kind, probe) {
      # All supported checksum fields are shorter than this bounded lookahead.
      # Excessive inter-token whitespace is left untouched and scanned
      # conservatively instead of making candidate search depend on line size.
      probe = substr(line, at, 256)
      replacement_length = 0
      replacement_text = ""
      if (kind == "p") {
        if (match(probe, "^\"integrity\"[[:space:]]*:[[:space:]]*\"" sri "\"")) {
          replacement_length = RLENGTH
          replacement_text = "\"integrity\": \"CHECKSUM\""
        }
      } else if (kind == "y") {
        if (match(probe, "^integrity[[:space:]]+" sri)) {
          replacement_length = RLENGTH
          replacement_text = "integrity CHECKSUM"
        } else if (match(probe, "^checksum:[[:space:]]*[0-9a-f]{64}")) {
          replacement_length = RLENGTH
          replacement_text = "checksum: CHECKSUM"
        }
      } else if (kind == "c") {
        if (match(probe, "^checksum[[:space:]]*=[[:space:]]*\"[0-9a-f]{64}\"")) {
          replacement_length = RLENGTH
          replacement_text = "checksum = \"CHECKSUM\""
        }
      } else if (kind == "u") {
        if (match(probe, "^hash[[:space:]]*=[[:space:]]*\"sha256:[0-9a-f]{64}\"")) {
          replacement_length = RLENGTH
          replacement_text = "hash = \"sha256:CHECKSUM\""
        }
      }
      if (replacement_length \
          && !structured_delimiter(line, at + replacement_length, kind)) {
        replacement_length = 0
        replacement_text = ""
      }
      return replacement_length
    }
    function emit_structural_fields(line, kind,
                                    encoded, char_count, i, ch, quote, escaped,
                                    field_allowed, ml_escaped, triple, chunk,
                                    header, brace_depth, uv_artifact_line, probe,
                                    json_open_role,
                                    chars, replacements, skips, uv_url_seen) {
      char_count = length(line)
      if (toml_skip_rest || json_skip_rest \
          || char_count > max_structured_line_chars \
          || index(line, char_separator)) {
        # Oversized/invalid records stay fully scannable. Their parser state is
        # intentionally not guessed; after one such TOML/JSON record,
        # conservatively skip neutralization for the rest of that file.
        if (kind == "c" || kind == "u") {
          toml_skip_rest = 1
          toml_invalid = 1
        }
        if (kind == "p") json_skip_rest = 1
        print line
        return
      }
      if (kind == "c" && toml_multiline == "") {
        header = line
        sub(/^[[:space:]]*/, "", header)
        if (substr(header, 1, 1) == "[") {
          if (header ~ /^\[\[[[:space:]]*package[[:space:]]*\]\][[:space:]]*(#.*)?$/ \
              || header ~ /^\[[[:space:]]*root[[:space:]]*\][[:space:]]*(#.*)?$/ \
              || header ~ /^\[\[[[:space:]]*patch[[:space:]]*\.[[:space:]]*unused[[:space:]]*\]\][[:space:]]*(#.*)?$/)
            cargo_checksum_scope = 1
          else
            cargo_checksum_scope = 0
        }
      }
      if (kind == "u" && toml_multiline == "") {
        header = line
        sub(/^[[:space:]]*/, "", header)
        if (substr(header, 1, 1) == "[") {
          uv_wheels_scope = 0
          if (header ~ /^\[\[[[:space:]]*(package|distribution)[[:space:]]*\]\][[:space:]]*(#.*)?$/)
            uv_package_scope = 1
          else
            uv_package_scope = 0
        }
        if (uv_package_scope \
            && header ~ /^wheels[[:space:]]*=[[:space:]]*\[[[:space:]]*(#.*)?$/)
          uv_wheels_scope = 1
        else if (header ~ /^\][[:space:]]*(#.*)?$/)
          uv_wheels_scope = 0
      }
      json_open_role = ""
      if (kind == "p") {
        if (json_depth == 1 \
            && line ~ /^[[:space:]]*"packages"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "package_map"
        else if (json_depth == 1 \
            && line ~ /^[[:space:]]*"dependencies"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "dependency_map"
        else if ((json_role[json_depth] == "package_map" \
                  || json_role[json_depth] == "dependency_map") \
                 && line ~ /^[[:space:]]*"[^"]*"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "entry"
        else if (json_role[json_depth] == "entry" \
                 && line ~ /^[[:space:]]*"dependencies"[[:space:]]*:[[:space:]]*\{[[:space:]]*$/)
          json_open_role = "dependency_map"
      }
      uv_artifact_line = 0
      if (kind == "u" && toml_multiline == "" && uv_package_scope \
          && (line ~ /^[[:space:]]*sdist[[:space:]]*=[[:space:]]*\{/ \
              || line ~ /^[[:space:]]*wheels[[:space:]]*=[[:space:]]*\[[[:space:]]*\{/ \
              || (uv_wheels_scope \
                  && line ~ /^[[:space:]]*\{/)))
        uv_artifact_line = 1
      encoded = line
      gsub(/./, "&" char_separator, encoded)
      split(encoded, chars, char_separator)
      quote = ""
      escaped = 0
      field_allowed = 1
      ml_escaped = 0
      brace_depth = 0
      i = 1
      while (i <= char_count) {
        ch = chars[i]

        # TOML multiline basic/literal strings span physical records. Preserve
        # their content verbatim until an unescaped matching triple delimiter.
        if ((kind == "c" || kind == "u") && toml_multiline != "") {
          field_allowed = 0
          triple = chars[i] chars[i + 1] chars[i + 2]
          if (toml_multiline == "\"") {
            if (ch == "\\") {
              if (!ml_escaped && !basic_escape_valid(line, i, 1))
                toml_invalid = 1
              ml_escaped = !ml_escaped
              i++
              continue
            }
            if (triple == triple_double && !ml_escaped) {
              i += 3
              toml_multiline = ""
              ml_escaped = 0
              continue
            }
            ml_escaped = 0
          } else if (triple == triple_single) {
            i += 3
            toml_multiline = ""
            continue
          }
          i++
          continue
        }

        if (quote != "") {
          if (quote == "\"" && ch == "\\") {
            if (!escaped && (kind == "c" || kind == "u") \
                && !basic_escape_valid(line, i, 0))
              toml_invalid = 1
            escaped = !escaped
            i++
            continue
          }
          if (ch == quote && !escaped) quote = ""
          escaped = 0
          i++
          continue
        }

        # JSON has no comments or single-quoted strings. TOML/Yarn comments
        # consume the remainder of a record and must stay fully scannable.
        if (kind != "p" && ch == "#") {
          break
        }

        if (kind == "u" && uv_artifact_line && brace_depth == 1 \
            && field_allowed && ch == "u") {
          probe = substr(line, i, 256)
          if (probe ~ /^url[[:space:]]*=[[:space:]]*"/)
            uv_url_seen[brace_depth] = 1
        }

        if (field_allowed \
            && ((kind == "p" && ch == "\"") \
                || (kind == "y" && (ch == "i" || ch == "c")) \
                || (kind == "c" && ch == "c") \
                || (kind == "u" && ch == "h")) \
            && (kind != "p" || json_role[json_depth] == "entry") \
            && (kind != "c" || cargo_checksum_scope) \
            && (kind != "u" \
                || (uv_artifact_line && brace_depth == 1 \
                    && uv_url_seen[brace_depth])) \
            && field_replacement(line, i, kind)) {
          replacements[i] = replacement_text
          skips[i] = replacement_length
          i += replacement_length
          field_allowed = 0
          continue
        }

        if ((kind == "c" || kind == "u") \
            && chars[i] chars[i + 1] chars[i + 2] == triple_double) {
          i += 3
          toml_multiline = "\""
          field_allowed = 0
          continue
        }
        if ((kind == "c" || kind == "u") \
            && chars[i] chars[i + 1] chars[i + 2] == triple_single) {
          i += 3
          toml_multiline = single_quote
          field_allowed = 0
          continue
        }
        if (ch == "\"" || (kind != "p" && ch == single_quote)) {
          quote = ch
          escaped = 0
          field_allowed = 0
          i++
          continue
        }

        if (kind == "c" || kind == "u") {
          if (ch == "[")
            toml_array_depth++
          else if (ch == "]") {
            if (toml_array_depth > 0)
              toml_array_depth--
            else
              toml_invalid = 1
          }
        }
        if (ch == "{") {
          if (kind == "p") {
            if (json_depth >= max_json_depth) {
              json_skip_rest = 1
              print line
              return
            }
            json_depth++
            if (json_open_role != "") {
              json_role[json_depth] = json_open_role
              json_open_role = ""
            } else {
              json_role[json_depth] = "other"
            }
          }
          brace_depth++
          uv_url_seen[brace_depth] = 0
          if (kind != "c") field_allowed = 1
        } else if (ch == "}") {
          if ((kind == "c" || kind == "u") && brace_depth == 0)
            toml_invalid = 1
          if (kind == "p") {
            delete json_role[json_depth]
            if (json_depth > 0) json_depth--
          }
          delete uv_url_seen[brace_depth]
          if (brace_depth > 0) brace_depth--
          field_allowed = 0
        # Cargo.lock checksums are line-leading fields in dependency tables,
        # never arbitrary inline-table keys. Other supported formats do use
        # checksum fields after record delimiters.
        } else if (kind != "c" && ch == ",")
          field_allowed = 1
        else if (ch !~ /[[:space:]]/)
          field_allowed = 0
        i++
      }

      # Ordinary TOML strings and inline tables cannot cross a physical
      # record. Preserve the whole raw snapshot if either remains open.
      if ((kind == "c" || kind == "u") \
          && (quote != "" || brace_depth != 0))
        toml_invalid = 1

      # Emit in bounded chunks. Repeatedly appending an unbounded record is
      # quadratic in some POSIX awks, even when parsing itself is single-pass.
      chunk = ""
      i = 1
      while (i <= char_count) {
        if (i in replacements) {
          chunk = chunk replacements[i]
          i += skips[i]
        } else {
          chunk = chunk chars[i]
          i++
        }
        if (length(chunk) >= 4096) {
          printf "%s", chunk
          chunk = ""
        }
      }
      print chunk
    }
    BEGIN {
      sri = "(sha1-[A-Za-z0-9+\\/]{27}=|sha256-[A-Za-z0-9+\\/]{43}=|sha384-[A-Za-z0-9+\\/]{64}|sha512-[A-Za-z0-9+\\/]{86}==)"
      single_quote = "'\''"
      triple_single = single_quote single_quote single_quote
      triple_double = "\"\"\""
      char_separator = sprintf("%c", 28)
      max_structured_line_chars = 131072
      max_json_depth = 256
      previous_kind = ""
      toml_multiline = ""
      toml_array_depth = 0
      toml_invalid = 0
      toml_skip_rest = 0
    }
    {
      if (forced_kind != "") {
        kind = forced_kind
        line = $0
      } else {
        kind = substr($0, 1, 1)
        line = substr($0, 3)
      }
      # Uppercase structured kinds are context-free physical-record fragments.
      # Their surrounding parser state is unavailable, so leave them fully
      # scannable instead of guessing that a checksum-looking field is
      # structural. Full-file records use the lowercase kinds below.
      if (kind ~ /^[CUP]$/) {
        print line
        next
      }
      if (kind != previous_kind) {
        # A structured TOML stream must not silently discard incomplete parser
        # state when the record kind changes. Returning nonzero makes the
        # caller scan the immutable raw snapshot instead.
        if (toml_incomplete(previous_kind))
          exit 2
        toml_multiline = ""
        toml_array_depth = 0
        toml_invalid = 0
        toml_skip_rest = 0
        json_skip_rest = 0
        json_depth = 0
        cargo_checksum_scope = 0
        uv_package_scope = 0
        uv_wheels_scope = 0
        previous_kind = kind
      }
      # Non-lockfile records have no structural checksum fields. Preserve the
      # preceding state-transition check, then skip the per-character parser.
      if (kind == "-") {
        print line
        next
      }
      if (kind == "g") {
        # Only the third go.sum field is a checksum. A module path may itself
        # contain an h1-shaped secret and must remain visible to gitleaks.
        if (match(line, /^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/)) {
          go_prefix = substr(line, 1, RLENGTH)
          go_tail = substr(line, RLENGTH + 1)
          if (go_tail ~ /^h1:[A-Za-z0-9+\/]{43}=[[:space:]]*$/ \
              && match(go_tail, /^h1:[A-Za-z0-9+\/]{43}=/))
            line = go_prefix replace_match(go_tail, "h1:CHECKSUM")
        }
      } else {
        emit_structural_fields(line, kind)
        next
      }
      print line
    }
    END {
      # Never emit checksum-neutralized output for incomplete TOML. The caller
      # treats this parser failure as a signal to scan the full raw snapshot.
      if (toml_incomplete(previous_kind))
        exit 2
    }
  ' "$record_source"
}

# Gitleaks' bundled defaults skip common lockfiles by path. Agent Guard rescans
# them through stdin after replacing only exact checksum fields; this both fixes
# checksum false positives and keeps credentials elsewhere detectable.
filter_lockfile_hashes() {
  path=$1
  original_source=${2:-$path}
  snapshot=
  case "${path##*/}" in
    go.sum) kind=g ;;
    package-lock.json) kind=p ;;
    yarn.lock) kind=y ;;
    Cargo.lock) kind=c ;;
    uv.lock) kind=u ;;
    *) cat -- "$original_source"; return ;;
  esac

  # Filter one immutable snapshot for every supported lockfile. Besides closing
  # path-swap races, this lets us reject NUL-bearing input before POSIX awk sees
  # it: BSD awk truncates a record at NUL and could otherwise discard a
  # credential suffix. NUL-bearing files stay byte-for-byte scannable.
  snapshot=$(mktemp_file) || { cat -- "$original_source"; return; }
  if ! cat -- "$original_source" >"$snapshot"; then
    rm -f "$snapshot"
    case "$original_source" in
      -|/dev/stdin) return 2 ;;
      *) cat -- "$original_source"; return ;;
    esac
  fi
  source=$snapshot
  nul_probe=$(mktemp_file) || nul_probe=
  if [ -z "$nul_probe" ] \
      || ! LC_ALL=C tr -d '\000' <"$source" >"$nul_probe" \
      || ! cmp -s "$source" "$nul_probe"; then
    cat -- "$source"
    status=$?
    rm -f "$snapshot" "$nul_probe"
    return "$status"
  fi
  rm -f "$nul_probe"

  if [ "$kind" = p ]; then
    # The streaming field parser cannot know that later input is truncated.
    # Validate the complete document first, keeping only a count/type summary
    # so large lockfiles do not need to be slurped into memory. If jq is absent,
    # the JSON is malformed, or multiple documents are present, preserve every
    # byte for gitleaks instead of risking an early integrity replacement.
    if ! command -v jq >/dev/null 2>&1 \
        || ! jq -e -n --stream '
          reduce inputs as $event (
            {documents: 0, in_object: false, valid: true};
            ($event[0] // []) as $path
            | if (.valid | not) then
                .
              elif .in_object then
                if (($event | length) == 1 and ($path | length) == 1) then
                  .in_object = false
                else
                  .
                end
              elif ($path | length) == 0 then
                if (($event | length) == 2 and $event[1] == {}) then
                  .documents += 1
                else
                  .valid = false
                end
              elif (($path[0] | type) == "string") then
                .documents += 1
                | .in_object = true
                | if (($event | length) == 1 and ($path | length) == 1) then
                    .in_object = false
                  else
                    .
                  end
              else
                .valid = false
              end
          )
          | .valid and (.documents == 1) and (.in_object | not)
        ' "$source" >/dev/null 2>&1; then
      cat -- "$source"
      status=$?
      rm -f "$snapshot"
      return "$status"
    fi
  fi
  filtered=$(mktemp_file) || {
    cat -- "$source"
    status=$?
    rm -f "$snapshot"
    return "$status"
  }
  if filter_lockfile_records "$kind" "$source" >"$filtered"; then
    cat -- "$filtered"
    status=$?
  else
    # Parser failure must never turn a lockfile into empty clean input. The
    # immutable snapshot is the authoritative byte stream for raw fallback.
    cat -- "$source"
    status=$?
  fi
  rm -f "$filtered"
  rm -f "$snapshot"
  return "$status"
}

scan_lockfiles_under() {
  root=$1
  label=$2
  blob=$(mktemp_file) || die "failed to create temp file"
  list=$(mktemp_file) || { rm -f "$blob"; die "failed to create temp file"; }
  find "$root" -type f \( \
      -name go.sum -o -name package-lock.json -o -name yarn.lock -o \
      -name Cargo.lock -o -name uv.lock \
    \) -print0 >"$list"
  find_status=$?
  if [ "$find_status" -ne 0 ]; then
    rm -f "$blob" "$list"
    info "$PROGRAM: failed to prepare lockfiles in $label"
    return 2
  fi
  if [ ! -s "$list" ]; then
    rm -f "$blob" "$list"
    return 0
  fi
  xargs -0 -I '{}' "$SELF_BIN" filter-lockfile-hashes '{}' '{}' \
    >>"$blob" <"$list"
  prepare_status=$?
  rm -f "$list"
  if [ "$prepare_status" -ne 0 ]; then
    rm -f "$blob"
    info "$PROGRAM: failed to prepare lockfiles in $label"
    return 2
  fi
  if [ ! -s "$blob" ]; then
    rm -f "$blob"
    return 0
  fi
  run_gitleaks_stdin "$label lockfile content" <"$blob"
  status=$?
  rm -f "$blob"
  return "$status"
}

scan_text_direct() {
  label=$1
  text=$2
  [ -n "$text" ] || return 0
  printf '%s\n' "$text" | run_gitleaks_stdin "$label"
}

# Remove only recognized lockfile checksum fields before scanning proposed file
# content. The logical path controls the exception; the temporary filename does
# not, so the same checksum-shaped text in any other file remains detectable.
scan_file_text_direct() {
  label=$1
  path=$2
  text=$3
  [ -n "$text" ] || return 0
  [ -n "$path" ] || { scan_text_direct "$label" "$text"; return $?; }

  source=$(mktemp_file) || die "failed to create temp file"
  printf '%s\n' "$text" >"$source"
  filter_lockfile_hashes "$path" "$source" | run_gitleaks_stdin "$label"
  status=$?
  rm -f "$source"
  return "$status"
}

# Edit/MultiEdit payloads contain only replacement fragments, not complete file
# context. Structural checksum filtering is unsafe there because an unchanged
# surrounding quote, multiline string, or earlier go.sum field is absent.
scan_file_fragment_direct() {
  label=$1
  text=$3
  scan_text_direct "$label" "$text"
}

# Scan status protocol, shared by every scan_* function and this dispatcher:
#   0 clean, 1 a secret was found, 3 the scan could not run, other scanner error.
# 3 exists because "I found a secret in your staged changes" and "I never got to
# look" are different facts and an operator has to be able to act on the right
# one. Hook callers apply AGENT_GUARD_INFRA_FAILURE_MODE to infrastructure
# failures; direct scan commands preserve the status for their caller.
SCAN_STATUS_UNAVAILABLE=3
SCAN_INPUT_MAX_BYTES=10485760
# Operators raise the budget when one legitimate file (a regenerated lockfile)
# exceeds it; a larger budget scans more, never less, so it cannot bypass the
# fail-closed contract. It is raise-only: a value below the default would
# shrink the budget until every diff is "unavailable", which under the open
# policy lets unscanned input through. Non-numeric, smaller, or overlong
# (beyond 18 digits, where dash arithmetic aborts) values keep the default.
case ${AGENT_GUARD_SCAN_INPUT_MAX_BYTES:-} in
  ''|*[!0-9]*) ;;
  *)
    # Strip leading zeros before arithmetic so `007` is not read as octal.
    scan_limit_override=${AGENT_GUARD_SCAN_INPUT_MAX_BYTES#"${AGENT_GUARD_SCAN_INPUT_MAX_BYTES%%[!0]*}"}
    case "$scan_limit_override" in
      ???????????????????*) ;;
      ?*) [ "$scan_limit_override" -ge "$SCAN_INPUT_MAX_BYTES" ] \
            && SCAN_INPUT_MAX_BYTES=$scan_limit_override ;;
    esac
    ;;
esac
# scan-working-tree has at most three producers: worktree diff, index diff, and
# untracked content. Giving each one third keeps their aggregate under the budget.
SCAN_COMPONENT_MAX_BYTES=$((SCAN_INPUT_MAX_BYTES / 3))

block_on_scan_status() {
  status=$1
  message=$2
  case "$status" in
    0) return 0 ;;
    1) info "$PROGRAM: $message"; exit 2 ;;
    "$SCAN_STATUS_UNAVAILABLE")
      handle_hook_infrastructure_failure "${HOOK_EVENT:-PreToolUse}" "${HOOK_INPUT:-}" \
        "$PROGRAM: scanner infrastructure could not verify the command;"
      ;;
    *)
      handle_hook_infrastructure_failure "${HOOK_EVENT:-PreToolUse}" "${HOOK_INPUT:-}" \
        "$PROGRAM: scanner infrastructure failed before it could verify the command;"
      ;;
  esac
}

# Shared by both diff extractors below: map a diff path to the (uppercase =
# fragment-context) lockfile kind byte filter_lockfile_records consumes.
AWK_LOCKFILE_KIND='
    function lockfile_kind(path, parts, count, name) {
      count = split(path, parts, "/")
      name = parts[count]
      if (name == "go.sum") return "g"
      if (name == "package-lock.json") return "P"
      if (name == "yarn.lock") return "y"
      if (name == "Cargo.lock") return "C"
      if (name == "uv.lock") return "U"
      return "-"
    }'

# Extract only added diff lines, dropping exact checksum fields only when the
# diff header identifies one of the supported lockfiles.
extract_added_lines() {
  LC_ALL=C awk "$AWK_LOCKFILE_KIND"'
    /^diff --git / { in_hunk = 0; path = ""; next }
    !in_hunk && /^\+\+\+ b\// { path = substr($0, 7); next }
    /^@@/ { in_hunk = 1; next }
    in_hunk && /^\+/ { print lockfile_kind(path) "\t" substr($0, 2) }
  ' | filter_lockfile_records
}
# Extract lines introduced by Codex apply_patch envelopes or unified diffs.
extract_patch_added_lines() {
  LC_ALL=C awk "$AWK_LOCKFILE_KIND"'
    BEGIN { mode = "none"; in_hunk = 0 }
    /^\*\*\* Begin Patch/ { mode = "none"; in_hunk = 0; next }
    /^\*\*\* End Patch/ { mode = "none"; in_hunk = 0; next }
    /^\*\*\* Add File:/ { path = $0; sub(/^\*\*\* Add File:[ \t]*/, "", path); mode = "add"; next }
    /^\*\*\* Update File:/ { path = $0; sub(/^\*\*\* Update File:[ \t]*/, "", path); mode = "update"; next }
    /^\*\*\* Delete File:/ { mode = "none"; path = ""; in_hunk = 0; next }
    /^\*\*\* End of File/ { next }
    /^diff --git / { if (mode == "none") in_hunk = 0; next }
    /^@@/ { if (mode == "none") in_hunk = 1; next }
    {
      if (mode == "add") {
        line = $0
        sub(/^\+/, "", line)
        print lockfile_kind(path) "\t" line
        next
      }
      if (mode == "update") {
        if (substr($0, 1, 1) == "+")
          print lockfile_kind(path) "\t" substr($0, 2)
        next
      }
      # Fallback: treat as a unified diff hunk. Tell a `+++ b/path` file header
      # (before the first @@, in_hunk=0) from added CONTENT by position, not by
      # shape — matching `+++ ` by shape dropped any added line whose own content
      # began with `++ `, which git prefixes to `+++ SECRET`. Only `+` lines
      # inside a hunk are additions.
      if (!in_hunk && /^\+\+\+ b\//) { path = substr($0, 7); next }
      if (!in_hunk && /^\+\+\+ /) next
      if (in_hunk && /^\+/) {
        line = $0
        sub(/^\+/, "", line)
        print lockfile_kind(path) "\t" line
      }
    }
  ' | filter_lockfile_records
}
inside_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# Name the directory and the action, not the internal subcommand: the operator
# never typed `scan-staged`, so telling them it "must run inside a git work
# tree" describes agent-guard's plumbing instead of their problem.
require_git_repo() {
  inside_git_repo && return 0
  info "$PROGRAM: could not scan: $(pwd) is not a git repository; run the command from inside the repository"
  return "$SCAN_STATUS_UNAVAILABLE"
}

extract_git_diff_added() {
  diff_file=$(mktemp_file) || return "$SCAN_STATUS_UNAVAILABLE"
  diff_status_file=$(mktemp_file) || { rm -f "$diff_file"; return "$SCAN_STATUS_UNAVAILABLE"; }
  # Unlike the untracked producer, git's stderr is bounded rather than
  # discarded: `fatal: bad revision` is the one detail an operator needs, so the
  # failure path relays its first line after sanitizing and truncating it. The
  # capture itself is bounded at the source (512 bytes, enough for that line):
  # a git wrapper spewing stderr must neither fill TMPDIR nor stall the hook,
  # and the trailing drain keeps a noisy-but-successful git from seeing SIGPIPE.
  diff_err_file=$(mktemp_file) || { rm -f "$diff_file" "$diff_status_file"; return "$SCAN_STATUS_UNAVAILABLE"; }
  # autoRefreshIndex=false: a work-tree diff otherwise rewrites the index to
  # refresh stale stat data, and a scan must leave the repository as it was.
  #
  # Read at most one byte beyond the shared scan budget. Closing the pipe there
  # stops a large diff from being fully materialized before the host timeout.
  # This bounds scan work and storage; it is not a portable wall-clock timeout
  # for a git process that stalls before producing output.
  (
    exec 3>&1
    { git -c diff.autoRefreshIndex=false diff --text --no-textconv --no-color "$@" 2>&1 >&3; printf '%s\n' "$?" >"$diff_status_file"; } 2>/dev/null \
      | { head -c 512 >"$diff_err_file"; cat >/dev/null; }
  ) | head -c $((SCAN_COMPONENT_MAX_BYTES + 1)) >"$diff_file"
  pipe_status=$?
  diff_status=$(sed -n '1p' "$diff_status_file" 2>/dev/null)
  rm -f "$diff_status_file"
  diff_bytes=$(LC_ALL=C wc -c <"$diff_file" 2>/dev/null | tr -d '[:space:]')
  case "$diff_bytes" in
    ''|*[!0-9]*) rm -f "$diff_file" "$diff_err_file"; return "$SCAN_STATUS_UNAVAILABLE" ;;
  esac
  # `head` closes the pipe at the sentinel byte, so git may report SIGPIPE (or
  # never reach its status write) for an over-budget diff; the byte count, not
  # that status, is authoritative here. `scan_untracked_files` bounds its own
  # producer the same way.
  if [ "$diff_bytes" -gt "$SCAN_COMPONENT_MAX_BYTES" ]; then
    rm -f "$diff_file" "$diff_err_file"
    info "$PROGRAM: git diff exceeded the scan input limit of $SCAN_COMPONENT_MAX_BYTES bytes; reduce the pending change, split it into smaller commits, or raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  if [ "$pipe_status" -ne 0 ] || [ "$diff_status" != 0 ]; then
    git_line=$(head -c 200 "$diff_err_file" 2>/dev/null | sed -n '1p' | tr -d '[:cntrl:]')
    rm -f "$diff_file" "$diff_err_file"
    info "$PROGRAM: git diff failed; staged or working changes were not scanned"
    [ -z "$git_line" ] || info "$PROGRAM: git: $git_line"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  extract_added_lines <"$diff_file"
  status=$?
  rm -f "$diff_file" "$diff_err_file"
  return "$status"
}

scan_staged() {
  need_cmd git "$SCAN_STATUS_UNAVAILABLE"
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  require_git_repo || return $?
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || return "$SCAN_STATUS_UNAVAILABLE"
  added=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --cached --unified=0 --no-ext-diff -- .)
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  [ -n "$added" ] || return 0
  scan_text_direct "staged added lines" "$added"
}

# What a `git commit` records: the index, plus tracked work-tree changes that
# Git stages itself after PreToolUse has run — all of them for -a, --patch and
# --interactive ($1 = 1), or those under the pathspecs in $3... (relative to
# the command cwd, as Git reads them). --interactive can also add untracked
# files ($2 = 1), and a same-command `git add -f` even ignored ones ($2 = 2),
# which may exceed the scan budget and then reports unavailable. A diff against HEAD is used instead of staging into a scratch
# index so the scan writes neither the index nor the object store.
scan_commit_candidate() {
  stage_all=$1
  stage_untracked=$2
  shift 2
  need_cmd git "$SCAN_STATUS_UNAVAILABLE"
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  require_git_repo || return $?
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || return "$SCAN_STATUS_UNAVAILABLE"
  added=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --cached --unified=0 --no-ext-diff -- .)
  status=$?
  [ "$status" -eq 0 ] || return "$status"
  if [ "$stage_all" -eq 1 ] || [ "$#" -gt 0 ]; then
    # Without a HEAD, the work tree is diffed against the index; the --cached
    # diff above already holds every index line, so together they cover it.
    stage_base=
    git rev-parse --verify --quiet HEAD >/dev/null 2>&1 && stage_base=HEAD
    if [ "$stage_all" -eq 1 ]; then
      staged_by_git=$(CDPATH= cd -- "$repo_root" \
        && extract_git_diff_added --unified=0 --no-ext-diff ${stage_base:+"$stage_base"} -- .)
    else
      staged_by_git=$(extract_git_diff_added --unified=0 --no-ext-diff ${stage_base:+"$stage_base"} -- "$@")
    fi
    status=$?
    [ "$status" -eq 0 ] || return "$status"
    [ -n "$staged_by_git" ] && added=${added:+"$added
"}$staged_by_git
  fi
  # A finding in either part outranks the other part failing to scan.
  untracked_status=0
  if [ "$stage_untracked" -ne 0 ]; then
    untracked_mode=
    [ "$stage_untracked" -eq 2 ] && untracked_mode=ignored
    (CDPATH= cd -- "$repo_root" && scan_untracked_files ${untracked_mode:+"$untracked_mode"})
    untracked_status=$?
    [ "$untracked_status" -eq 1 ] && return 1
  fi
  if [ -n "$added" ]; then
    scan_text_direct "commit candidate added lines" "$added"
    status=$?
    [ "$status" -eq 0 ] || return "$status"
  fi
  [ "$untracked_status" -eq 0 ] || return "$SCAN_STATUS_UNAVAILABLE"
  return 0
}

# $1 = ignored also lists gitignored files, for a same-command `git add -f`.
scan_untracked_files() {
  untracked_filter=--exclude-standard
  [ "${1:-}" = ignored ] && untracked_filter=
  need_cmd git
  need_gitleaks
  # Resolve the repo ROOT so an untracked secret OUTSIDE the caller's subdir is
  # still listed. --full-name emits root-relative paths regardless of cwd; the
  # cat step below reads them from that same root.
  root=$(git rev-parse --show-toplevel) || die "failed to resolve repository root"
  list=$(mktemp_file) || die "failed to create temp file"
  # core.quotePath=false + -z keep every filename byte-exact (non-ASCII,
  # backslash, quote, even an embedded newline). The previous newline-delimited
  # read silently skipped such names — letting a careless or adversarial agent
  # park a secret in a file the backstop never scanned.
  git -C "$root" -c core.quotePath=false ls-files --others ${untracked_filter:+"$untracked_filter"} --full-name -z >"$list" || {
    rm -f "$list"
    die "failed to list untracked files"
  }

  if [ ! -s "$list" ]; then
    rm -f "$list"
    return 0
  fi

  # Stream every untracked file through one gitleaks stdin call. Exact checksum
  # fields are removed only for supported lockfile basenames; all other content
  # from those files, including credentials, remains in the stream.
  # Producer stderr is untrusted and unbounded; discard it here and emit only
  # the fixed, secret-safe preparation diagnostic below when its status fails.
  blob=$(mktemp_file) || { rm -f "$list"; die "failed to create temp file"; }
  prepare_status_file=$(mktemp_file) || { rm -f "$list" "$blob"; die "failed to create temp file"; }
  (xargs -0 -I '{}' sh -c '
    cd "$0" 2>/dev/null || exit 0
    f=$1
    filter=$2
    [ -f "$f" ] || exit 0
    printf "### file: %s\n" "$f"
    case "${f##*/}" in
      go.sum|package-lock.json|yarn.lock|Cargo.lock|uv.lock)
        "$filter" filter-lockfile-hashes "$f" "$f" || exit 1
        ;;
      *) cat -- "$f" || exit 1 ;;
    esac
    printf "\n" || exit 1
  ' "$root" '{}' "$SELF_BIN" <"$list"; printf '%s\n' "$?" >"$prepare_status_file") \
    2>/dev/null \
    | head -c $((SCAN_COMPONENT_MAX_BYTES + 1)) >"$blob"
  pipe_status=$?
  prepare_status=$(sed -n '1p' "$prepare_status_file" 2>/dev/null)
  rm -f "$prepare_status_file"
  rm -f "$list"
  blob_bytes=$(LC_ALL=C wc -c <"$blob" 2>/dev/null | tr -d '[:space:]')
  case "$blob_bytes" in
    ''|*[!0-9]*) rm -f "$blob"; return "$SCAN_STATUS_UNAVAILABLE" ;;
  esac
  # `head` deliberately closes the pipe after the sentinel byte. The producer
  # may therefore report SIGPIPE (or never reach its status write) for an
  # over-budget stream; the byte count is the authoritative outcome in that
  # case. Preserve real preparation failures while the stream is still within
  # budget, where `head` did not truncate it.
  if [ "$blob_bytes" -gt "$SCAN_COMPONENT_MAX_BYTES" ]; then
    rm -f "$blob"
    info "$PROGRAM: untracked files exceeded the scan input limit of $SCAN_COMPONENT_MAX_BYTES bytes; reduce untracked input, add intentional exclusions to .gitignore, or raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi
  if [ "$pipe_status" -ne 0 ] || [ "$prepare_status" != 0 ]; then
    rm -f "$blob"
    info "$PROGRAM: failed to prepare untracked files for scanning"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi

  if [ ! -s "$blob" ]; then
    rm -f "$blob"
    return 0
  fi

  run_gitleaks_stdin "untracked files" <"$blob"
  status=$?
  rm -f "$blob"
  return "$status"
}

scan_working_tree() {
  need_cmd git "$SCAN_STATUS_UNAVAILABLE"
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  require_git_repo || return $?
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || return "$SCAN_STATUS_UNAVAILABLE"

  # Two diffs, and with a HEAD both are taken AGAINST HEAD (#224). `git diff
  # HEAD` alone compares only the worktree, so a secret staged and then reverted
  # on disk left the scan while the next commit still carried it; `--cached`
  # (index vs HEAD) closes that. Diffing the worktree against the INDEX instead
  # would look symmetric but is not: a committed line whose removal is staged and
  # then undone on disk reads as an addition there, re-reporting history that
  # `git diff HEAD` correctly calls unchanged. Added lines only is the contract,
  # so HEAD stays the base for both.
  result=0
  first=
  second=
  if git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    first=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --unified=0 --no-ext-diff HEAD -- .)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
    second=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --cached --unified=0 --no-ext-diff -- .)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
  else
    # No HEAD: `--cached` compares against the empty tree and the plain diff
    # carries unstaged edits. Nothing is committed yet, so neither can re-report
    # history and there is no HEAD to diff against.
    first=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --cached --unified=0 --no-ext-diff -- .)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
    second=$(CDPATH= cd -- "$repo_root" && extract_git_diff_added --unified=0 --no-ext-diff -- .)
    status=$?
    [ "$status" -eq 0 ] || result="$SCAN_STATUS_UNAVAILABLE"
  fi
  # Content staged and left alone on disk appears in both. gitleaks reports the
  # same finding either way and agent-guard emits one generic line, so the cost
  # is duplicate scanner input, not duplicate output.
  tracked=$first
  [ -n "$first" ] && [ -n "$second" ] && tracked="$tracked
$second"
  [ -z "$first" ] && tracked=$second

  if [ -n "$tracked" ]; then
    scan_text_direct "working tree added lines" "$tracked"
    status=$?
    case "$status" in
      0) ;;
      1) result=1 ;;
      *) [ "$result" -eq 0 ] && result="$SCAN_STATUS_UNAVAILABLE" ;;
    esac
  fi

  (CDPATH= cd -- "$repo_root" && scan_untracked_files)
  status=$?
  case "$status" in
    0) ;;
    1) result=1 ;;
    *) [ "$result" -eq 0 ] && result="$SCAN_STATUS_UNAVAILABLE" ;;
  esac

  return "$result"
}

scan_path() {
  need_gitleaks "$SCAN_STATUS_UNAVAILABLE"
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  [ "$#" -gt 0 ] || die "scan-path requires at least one path"
  result=0
  for path in "$@"; do
    [ -e "$path" ] || die "path not found: $path"
    out=$(mktemp_file) || die "failed to create temp file"
    "$GITLEAKS_BIN" dir "$path" --redact --no-banner --no-color --log-level error \
      --config "$GITLEAKS_CONFIG" --exit-code 1 >"$out" 2>&1
    status=$?
    if [ "$status" -eq 0 ]; then
      if [ -s "$out" ]; then
        info "$PROGRAM: gitleaks reported an error while scanning path: $path"
        sed 's/^/  /' "$out" >&2
        result=2
      fi
    elif [ "$status" -eq 1 ]; then
      info "$PROGRAM: secret-like value detected in path: $path"
      sed 's/^/  /' "$out" >&2
      [ "$result" -eq 0 ] && result=1
    else
      info "$PROGRAM: gitleaks failed while scanning path: $path"
      sed 's/^/  /' "$out" >&2
      result=2
    fi
    rm -f "$out"

    scan_lockfiles_under "$path" "path: $path"
    status=$?
    case "$status" in
      0) ;;
      1) [ "$result" -eq 0 ] && result=1 ;;
      *) result=2 ;;
    esac
  done
  return "$result"
}

json_value() {
  expr=$1
  input=$2
  printf '%s' "$input" | jq -r "$expr"
}

normalize_path() {
  candidate=$1
  case "$candidate" in
    file://*) candidate=${candidate#file://} ;;
  esac
  case "$candidate" in
    '~') candidate=${HOME:-/} ;;
    '~/'*) candidate=${HOME:-/}/${candidate#~/} ;;
  esac
  while :; do
    case "$candidate" in
      './'*) candidate=${candidate#./} ;;
      *) break ;;
    esac
  done
  printf '%s' "$candidate"
}

resolve_path() {
  candidate=$1
  # Resolve symlinks when possible; otherwise keep matching the original path.
  resolved=$(
    if command -v realpath >/dev/null 2>&1; then
      realpath -- "$candidate" 2>/dev/null
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f -- "$candidate" 2>/dev/null
    fi
  )
  if [ -n "$resolved" ]; then
    printf '%s' "$resolved"
  else
    printf '%s' "$candidate"
  fi
}

# Match a candidate without applying any template exception. Keep this in a
# subshell because POSIX sh has no local variables and callers also iterate the
# deny file.
candidate_matches_raw_deny() (
  raw_deny_candidate=$1
  [ -f "$DENY_READ_PATHS" ] || return 1
  while IFS= read -r raw_deny_pattern || [ -n "$raw_deny_pattern" ]; do
    case "$raw_deny_pattern" in
      ''|\#*) continue ;;
    esac
    case "$raw_deny_candidate" in
      $raw_deny_pattern|*/$raw_deny_pattern) return 0 ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
)

# A template basename never exempts a file inside a deny-listed directory. Walk
# every ancestor rather than only the complete parent string: `local.env/sub`
# must be caught by `*.env` before `local.env/sub/sample.env` can be allowed.
candidate_parent_matches_deny() (
  deny_parent_path=$1
  while [ -n "$deny_parent_path" ] && [ "$deny_parent_path" != / ]; do
    candidate_matches_raw_deny "$deny_parent_path" && return 0
    case "$deny_parent_path" in
      */*)
        next_deny_parent=${deny_parent_path%/*}
        [ "$next_deny_parent" = "$deny_parent_path" ] && break
        [ -n "$next_deny_parent" ] || next_deny_parent=/
        deny_parent_path=$next_deny_parent
        ;;
      *) break ;;
    esac
  done
  return 1
)

# Classify explicitly named environment placeholder templates. Accepted suffix
# markers are `example`, `sample`, `template`, `dist`, `tpl`, and `tmpl`,
# separated by `.`, `-`, or `_` (`.env.example`, `.env-example`, `.env_sample`,
# `.env.tpl`); the marker must be final. `.env.default(s)` is deliberately not
# a marker: dotenv-defaults loads it at runtime, so it may hold real values.
# `example.env`, `sample.env`, and `template.env` (plus their envrc forms) are
# also accepted because that prefix convention is common and unambiguous.
#
# The name on the other side of a suffix marker must still be an environment
# file family: env/envrc, *.env/*.envrc, .flaskenv, or .dev.vars. Consequently,
# runtime names such as `.env.local`, `local.env`, `env.local`, and
# `example.env.local` are not templates. This function checks the basename
# grammar only; candidate_matches_deny retains parent, non-environment, and
# custom-policy precedence.
candidate_is_allowed() {
  template_base=${1##*/}
  template_stem=

  case "$template_base" in
    example.env|sample.env|template.env|example.envrc|sample.envrc|template.envrc|\
    .example.env|.sample.env|.template.env|.example.envrc|.sample.envrc|.template.envrc)
      ;;
    *[._-]example) template_stem=${template_base%[._-]example} ;;
    *[._-]sample) template_stem=${template_base%[._-]sample} ;;
    *[._-]template) template_stem=${template_base%[._-]template} ;;
    *[._-]dist) template_stem=${template_base%[._-]dist} ;;
    *[._-]tpl) template_stem=${template_base%[._-]tpl} ;;
    *[._-]tmpl) template_stem=${template_base%[._-]tmpl} ;;
    *) return 1 ;;
  esac

  if [ -n "$template_stem" ]; then
    case "$template_stem" in
      .env|.env.*|env|env.*|.envrc|.envrc.*|envrc|envrc.*|*.env|*.envrc|\
      .flaskenv|.flaskenv.*|.dev.vars|.dev.vars.*) ;;
      *) return 1 ;;
    esac
  fi
  return 0
}

# Keep ordinary source modules such as `config.env.ts` readable without opening
# data/config suffixes such as `config.env.json`. Require a non-empty prefix for
# reverse-extension forms so `.env.ts` remains a protected runtime variant.
#
# The basename must end in a known code extension; the stem in front of it may
# carry at most ONE intermediate segment (`env.d.ts`, `env.server.ts`,
# `app.env.spec.ts`) because those are ordinary committed modules. Enforced by
# stripping the final dot-free segment from the stem: what remains must itself
# be a bare env stem, so `env.production.backup.ts` and `app.env.local.copy.js`
# stay on the deny globs. A stem with no code extension (`env.d`, `env.local`,
# `config.env.json`) is never a source module.
candidate_is_env_source_module() {
  env_source_base=${1##*/}
  case "$env_source_base" in
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.py|*.rb|*.go|*.rs|*.java|*.kt|*.kts|\
    *.swift) ;;
    *) return 1 ;;
  esac
  env_source_stem=${env_source_base%.*}
  case "$env_source_stem" in
    env|envrc|?*.env|?*.envrc) return 0 ;;
  esac
  case "${env_source_stem%.*}" in
    env|envrc|?*.env|?*.envrc) return 0 ;;
    *) return 1 ;;
  esac
}

candidate_has_default_env_exception() {
  candidate_is_allowed "$1" || candidate_is_env_source_module "$1"
}

# Only these shipped environment-family rules may be relaxed by a classified
# template or source-module basename. Custom deny files are always authoritative,
# and unrelated built-in rules such as `.ssh/id_*` must still win.
deny_pattern_allows_env_exception() {
  case "$1" in
    '.env*'|'*.env'|'*.env.*'|'*.envrc'|'*.envrc.*'|'env.*'|'envrc.*'|\
    '.flaskenv.*'|'.dev.vars.*') return 0 ;;
    *) return 1 ;;
  esac
}

candidate_matches_deny() (
  deny_candidate=$1
  case "$deny_candidate" in
    */*) candidate_parent_matches_deny "${deny_candidate%/*}" && return 0 ;;
  esac

  deny_candidate_has_env_exception=0
  candidate_has_default_env_exception "$deny_candidate" \
    && deny_candidate_has_env_exception=1
  while IFS= read -r deny_pattern || [ -n "$deny_pattern" ]; do
    case "$deny_pattern" in
      ''|\#*) continue ;;
    esac
    case "$deny_candidate" in
      $deny_pattern|*/$deny_pattern)
        if [ "$deny_candidate_has_env_exception" -eq 1 ] \
          && [ "$DENY_READ_PATHS_CUSTOM" -eq 0 ] \
          && deny_pattern_allows_env_exception "$deny_pattern"; then
          continue
        fi
        return 0
        ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
)

matches_deny_path() {
  raw=$1
  [ -f "$DENY_READ_PATHS" ] || return 1

  normalized=$(normalize_path "$raw")
  candidate_matches_deny "$normalized" && return 0

  resolved=$(resolve_path "$normalized")
  if [ "$resolved" != "$normalized" ]; then
    candidate_matches_deny "$resolved" && return 0
  fi
  return 1
}

check_sensitive_reads() {
  input=$1
  # POSIX sh has no locals: do not reuse the caller's `tool` here, it is still
  # needed by later checks in the same hook run.
  reads_tool=${2:-}
  need_cmd jq
  [ -f "$DENY_READ_PATHS" ] || die "deny read policy not found: $DENY_READ_PATHS"

  # Every string leaf of tool_input is a deny-path candidate: the gate does not
  # know which fields a host treats as paths, so unknown fields fail closed.
  # The one exception is Grep's `pattern`. It is the content regex the host
  # hands to ripgrep, structurally separate from `path` / `glob`, and nothing
  # resolves it into a filesystem path later - so a search for the literal text
  # `.key` is not a read of a `*.key` file (#187). The exemption is limited to
  # a string that does not start with `-`: a host that passed the pattern
  # positionally would let `--file=.env` / `-f.env` make ripgrep read patterns
  # FROM that file, and a non-string `pattern` is not a regex at all, so both
  # keep the every-leaf gate. Glob's `pattern` is a path glob and stays
  # checked. Secret-shaped Grep patterns are still handled by
  # check_broad_grep_content.
  values=$(printf '%s' "$input" | jq -r --arg tool "$reads_tool" '
    .tool_input // {}
    | if $tool == "Grep" and type == "object"
         and (.pattern | type) == "string"
         and (.pattern | startswith("-") | not)
      then del(.pattern) else . end
    | .. | strings')
  [ -n "$values" ] || return 0

  # Drive the loop from a temp file so it runs in this shell, not a pipeline
  # sub-shell — that keeps `exit 2` definitive even if a future edit appends
  # work after the loop.
  tmp=$(mktemp_file) || die "failed to create temp file"
  printf '%s\n' "$values" >"$tmp"
  while IFS= read -r value; do
    [ -n "$value" ] || continue
    if matches_deny_path "$value"; then
      info "$PROGRAM: blocked sensitive file access: $value"
      rm -f "$tmp"
      exit 2
    fi
  done <"$tmp"
  rm -f "$tmp"
}

deny_path_regex_fragment() {
  # Convert supported deny-read shell globs to POSIX ERE fragments. The
  # shell-expanded mode also catches command words that the shell can expand
  # into a deny-listed path, such as .e[n]v, .e?v, .e*v, or $'.e\x6ev'.
  pattern=$1
  mode=${2:-literal}
  if [ "$mode" = "shell-expanded" ]; then
    deny_path_shell_expanded_fragment "$pattern"
    return
  fi
  py=
  remaining=$pattern
  while [ -n "$remaining" ]; do
    ch=${remaining%"${remaining#?}"}
    remaining=${remaining#?}
    case "$ch" in
      '*') py=${py}'[^[:space:]<>|;&`$()]*' ;;
      '.'|'^'|'$'|'+'|'?'|'('|')'|'['|']'|'{'|'}'|'|'|'\\') py=${py}'\'${ch} ;;
      '/') py=${py}'/' ;;
      *) py=${py}${ch} ;;
    esac
  done
  printf '%s' "$py"
}

# A shell word reaches an entry in two ways. Position by position, each entry
# character may be itself, a \xHH escape, or one glob character (.e[n]v, .e?v,
# .e*v, $'.e\x6ev'). A `*` can also stand for a whole run of characters (.e*,
# ~/.n*, .n*c, .*v), but only inside one `/` component: bash never lets a star
# match a slash, so ~/.config* does not reach .config/gh/hosts.yml. The second
# kind of alternative therefore picks the component that holds the stars and
# spells every other component position by position. Inside that component
# the word is an entry prefix, a `*` (more stars may follow), and an entry
# suffix; prefix and suffix are nested optionals instead of one alternative
# per split point, which keeps the ERE linear in the entry length, at the
# price of letting them overlap (.n*netrc), which can only over-block. A dot
# that starts a component must be spelled out, because bash globs never match
# a leading dot.
#
# The match must also pin at least one of the entry's letters or digits with
# that character, its hex escape, or a bracket listing it: accepting a bare
# star, `?`, or a generic class instead would turn `.*`, `\s*`, and
# `\.[^.]*$` in ordinary sed/grep regexes into protected-path matches. Another
# component spelled out with its first letter pinned is enough. Otherwise the
# prefix pins the component's first letter and is at least two characters long
# (.e*), or, for a component that starts with a dot, the suffix pins its last
# letter (.*v). A suffix pin needs that leading dot: without it, *.json would
# name credentials.json. An entry `*` after the pinned last letter matches only
# stars there, so .*version stays a regex rather than a way to name .env*.
deny_path_shell_expanded_fragment() {
  sx_rest=$1
  sx_any='[^[:space:]<>|;&`$()]*'
  sx_gap='\*([^[:space:]<>|;&`$()/]*\*)?'
  sx_n=0 sx_full= sx_alnum_segs=0 sx_seg_pinned=0
  # sx_c_<i>: the entry character at i; sx_t_<i>: the same, but an entry `*`
  # matches only stars; sx_p_<i>: the same as sx_c_<i>, except that each
  # component's first letter is pinned.
  while [ -n "$sx_rest" ]; do
    ch=${sx_rest%"${sx_rest#?}"}
    sx_rest=${sx_rest#?}
    sx_n=$((sx_n + 1))
    case "$ch" in
      '*')
        sx_c=$sx_any
        sx_t='\**'
        ;;
      *)
        sx_c=$(deny_path_shell_expansion_char_pattern "$ch")
        sx_t=$sx_c
        ;;
    esac
    sx_p=$sx_c
    case "$ch" in
      /) sx_seg_pinned=0 ;;
      [[:alnum:]])
        if [ "$sx_seg_pinned" -eq 0 ]; then
          sx_seg_pinned=1
          sx_alnum_segs=$((sx_alnum_segs + 1))
          deny_path_pin_char_pattern "$ch"
          sx_p=$sx_pin
        fi
        ;;
    esac
    eval "sx_r_$sx_n=\$ch sx_c_$sx_n=\$sx_c sx_t_$sx_n=\$sx_t sx_p_$sx_n=\$sx_p"
    sx_full=${sx_full}${sx_c}
  done

  sx_alts=
  sx_a=1
  sx_i=1
  while [ "$sx_i" -le $((sx_n + 1)) ]; do
    sx_ch=/
    [ "$sx_i" -le "$sx_n" ] && eval "sx_ch=\$sx_r_$sx_i"
    if [ "$sx_ch" = / ]; then
      [ "$sx_i" -gt "$sx_a" ] \
        && deny_path_spanning_component_alternatives "$sx_a" $((sx_i - 1))
      sx_a=$((sx_i + 1))
    fi
    sx_i=$((sx_i + 1))
  done
  if [ -n "$sx_alts" ]; then
    printf '(%s%s)' "$sx_full" "$sx_alts"
  else
    printf '%s' "$sx_full"
  fi
}

# Append to sx_alts the alternatives whose stars fall in component $1..$2.
deny_path_spanning_component_alternatives() {
  sca_a=$1
  sca_b=$2
  sca_first= sca_last= sca_j=$sca_a
  while [ "$sca_j" -le "$sca_b" ]; do
    eval "sca_ch=\$sx_r_$sca_j"
    case "$sca_ch" in
      [[:alnum:]])
        [ -n "$sca_first" ] || sca_first=$sca_j
        sca_last=$sca_j
        ;;
    esac
    sca_j=$((sca_j + 1))
  done
  eval "sca_lead=\$sx_r_$sca_a"
  deny_path_sx_concat p 1 $((sca_a - 1))
  sca_before=$sx_out
  deny_path_sx_concat p $((sca_b + 1)) "$sx_n"
  sca_after=$sx_out
  deny_path_sx_suffixes c "$sca_a" "$sca_b"
  sca_suffixes=$sx_out
  # The leading dot of a component is mandatory in every prefix.
  sca_pre_from=$sca_a
  [ "$sca_lead" = . ] && sca_pre_from=$((sca_a + 1))
  deny_path_sx_concat c "$sca_a" $((sca_pre_from - 1))
  sca_prefixes=$sx_out
  deny_path_sx_prefixes c "$sca_pre_from" "$sca_b"
  sca_prefixes=$sca_prefixes$sx_out

  sca_others=$sx_alnum_segs
  [ -n "$sca_first" ] && sca_others=$((sca_others - 1))
  if [ "$sca_others" -ge 1 ]; then
    sx_alts="$sx_alts|$sca_before$sca_prefixes$sx_gap$sca_suffixes$sca_after"
    return 0
  fi
  [ -n "$sca_first" ] || return 0

  sca_head_end=$sca_first
  [ "$sca_head_end" -gt "$sca_a" ] || sca_head_end=$((sca_a + 1))
  if [ "$sca_head_end" -le "$sca_b" ]; then
    deny_path_sx_concat p "$sca_a" "$sca_head_end"
    sca_head=$sx_out
    deny_path_sx_prefixes c $((sca_head_end + 1)) "$sca_b"
    sx_alts="$sx_alts|$sca_before$sca_head$sx_out$sx_gap$sca_suffixes$sca_after"
  fi

  [ "$sca_lead" = . ] || return 0
  eval "sca_ch=\$sx_r_$sca_last"
  deny_path_pin_char_pattern "$sca_ch"
  deny_path_sx_suffixes t "$sca_a" $((sca_last - 1))
  sca_tail=$sx_out$sx_pin
  deny_path_sx_concat t $((sca_last + 1)) "$sca_b"
  sca_tail=$sca_tail$sx_out
  sx_alts="$sx_alts|$sca_before$sca_prefixes$sx_gap$sca_tail$sca_after"
}

# Set sx_pin to the pattern for $1 as a pinning character: itself, a bracket
# listing it, or its \xHH escape when it has an ASCII one.
deny_path_pin_char_pattern() {
  if sx_pin_hex=$(deny_path_char_hex_pattern "$1" 2>/dev/null); then
    sx_pin=$(printf '(%s|\\[[^]]*%s[^]]*\\]|\\\\x%s)' "$1" "$1" "$sx_pin_hex")
  else
    sx_pin=$(printf '(%s|\\[[^]]*%s[^]]*\\])' "$1" "$1")
  fi
}

# Set sx_out to the concatenation of sx_<$1>_<i> for i in $2..$3.
deny_path_sx_concat() {
  sx_out=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"\${sx_out}\${sx_$1_$sx_j}\""
    sx_j=$((sx_j + 1))
  done
}

# Set sx_out to an ERE for any prefix, possibly empty, of sx_<$1>_<$2..$3>.
deny_path_sx_prefixes() {
  sx_out=
  sx_close=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"\${sx_out}(\${sx_$1_$sx_j}\""
    sx_close="${sx_close})?"
    sx_j=$((sx_j + 1))
  done
  sx_out=$sx_out$sx_close
}

# Set sx_out to an ERE for any suffix, possibly empty, of sx_<$1>_<$2..$3>.
deny_path_sx_suffixes() {
  sx_out=
  sx_j=$2
  while [ "$sx_j" -le "$3" ]; do
    eval "sx_out=\"(\${sx_out}\${sx_$1_$sx_j})?\""
    sx_j=$((sx_j + 1))
  done
}

deny_path_char_hex_pattern() {
  case "$1" in
    0) printf '3[0]' ;; 1) printf '3[1]' ;; 2) printf '3[2]' ;; 3) printf '3[3]' ;;
    4) printf '3[4]' ;; 5) printf '3[5]' ;; 6) printf '3[6]' ;; 7) printf '3[7]' ;;
    8) printf '3[8]' ;; 9) printf '3[9]' ;;
    a|A) printf '6[1]' ;; b|B) printf '6[2]' ;; c|C) printf '6[3]' ;;
    d|D) printf '6[4]' ;; e|E) printf '6[5]' ;; f|F) printf '6[6]' ;;
    g|G) printf '6[7]' ;; h|H) printf '6[8]' ;; i|I) printf '6[9]' ;;
    j|J) printf '6[aA]' ;; k|K) printf '6[bB]' ;; l|L) printf '6[cC]' ;;
    m|M) printf '6[dD]' ;; n|N) printf '6[eE]' ;; o|O) printf '6[fF]' ;;
    p|P) printf '7[0]' ;; q|Q) printf '7[1]' ;; r|R) printf '7[2]' ;;
    s|S) printf '7[3]' ;; t|T) printf '7[4]' ;; u|U) printf '7[5]' ;;
    v|V) printf '7[6]' ;; w|W) printf '7[7]' ;; x|X) printf '7[8]' ;;
    y|Y) printf '7[9]' ;; z|Z) printf '7[aA]' ;;
    '.') printf '2[eE]' ;; '_') printf '5[fF]' ;; '-') printf '2[dD]' ;;
    *) return 1 ;;
  esac
}

deny_path_shell_expansion_char_pattern() {
  ch=$1
  case "$ch" in
    '.'|'^'|'$'|'+'|'?'|'('|')'|'['|']'|'{'|'}'|'|'|'\\')
      literal=\\$ch
      ;;
    *)
      literal=$ch
      ;;
  esac

  hex=$(deny_path_char_hex_pattern "$ch" 2>/dev/null || true)
  case "$ch" in
    '/')
      printf '/'
      ;;
    '.')
      if [ -n "$hex" ]; then
        printf '(%s|\\\\x%s)' "$literal" "$hex"
      else
        printf '%s' "$literal"
      fi
      ;;
    *)
      if [ -n "$hex" ]; then
        printf '(%s|\\\\x%s|\\?|\\*|\\[[^]]+\\])' "$literal" "$hex"
      else
        printf '(%s|\\?|\\*|\\[[^]]+\\])' "$literal"
      fi
      ;;
  esac
}

deny_path_command_regex() {
  pattern=$1
  mode=$2
  converted=$(deny_path_regex_fragment "$pattern" "$mode")
  [ -n "$converted" ] || return 1
  # Catch path arguments and shell words without matching substrings like myenv.
  printf '%s' '(^|[^[:alnum:]_./~-])('"${converted}"'|[^[:space:]<>|;&`$()]*/'"${converted}"')([^[:alnum:]_.-]|$)'
}

# Private variable name: POSIX sh has no locals, and assigning the bare name
# `cmd` here clobbers the caller's command in check_bash_command (see #127).
bash_matches_deny_path_mode() {
  mode_cmd=$1
  mode=$2
  [ -f "$DENY_READ_PATHS" ] || return 1
  while IFS= read -r entry || [ -n "$entry" ]; do
    case "$entry" in
      ''|\#*) continue ;;
    esac
    regex=$(deny_path_command_regex "$entry" "$mode") || continue
    printf '%s\n' "$mode_cmd" | grep -Eq "$regex"
    grep_status=$?
    case "$grep_status" in
      0)                 # command references a deny-listed path -> block
        # Name what tripped the gate on stdout, so a block can be diagnosed
        # without guessing (#99): the value of this line is that a false
        # positive can be rewritten instead of answered by weakening the deny
        # list. Report the entry only -- it is public policy text. An excerpt of
        # the matched text is NOT safe to emit: both wildcards in the regex
        # swallow whatever else shares the shell word (an entry's own trailing
        # `*` eats a URL query string, the `<prefix>/` alternative eats a
        # userinfo field or a directory component), so the excerpt can carry a
        # credential, and this branch blocks before any scanner runs, leaving
        # nothing downstream to redact it.
        printf "matched deny-read-paths entry '%s'\n" "$entry"
        return 0
        ;;
      1) ;;            # no match -> keep scanning
      *)
        # grep failed (e.g. a custom deny-read entry produced an invalid ERE).
        # Fail closed, mirroring check_bash_command: silently allowing here
        # would let one bad entry disable the rest of the deny-read path check.
        info "$PROGRAM: deny-read-paths Bash scan failed; refusing to allow command"
        exit 2
        ;;
    esac
  done <"$DENY_READ_PATHS"
  return 1
}

shell_dequote_for_policy() {
  printf '%s\n' "$1" | awk '
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c == "\\") {
          i++
          if (i <= length($0)) {
            out = out substr($0, i, 1)
          }
          continue
        }
        if (c == "\"" || c == "\047") {
          continue
        }
        out = out c
      }
      print out
    }
  '
}

# Unquote the command the way bash would, decoding $'...' escapes. The coarse
# pass above turns $'.e\x6e'v into $.ex6ev, so an ANSI-C escape spliced with
# unquoted text slipped past both it and the raw \xHH alternatives. A byte that
# no deny-read path contains (a control character, a backslash, or anything
# above ASCII) becomes \001; a NUL ends the $'...' string, as in bash. Every
# backslash left in the output is literal text, such as the \x6e in '\x6e' or
# \$'\x6e', so it must not reach the shell-expanded pass, which would read it
# as an escape again. Expansions and globs are left as text for the literal and
# shell-expanded passes.
shell_decode_ansi_c_for_policy() {
  printf '%s\n' "$1" | awk '
    function hexval(ch) { return index("0123456789abcdef", tolower(ch)) - 1 }
    function emit(v) {
      if (nul) return
      if (v == 0) { nul = 1; return }
      if (v < 32 || v > 126) v = 1
      out = out sprintf("%c", v)
    }
    { s = (NR == 1) ? $0 : s "\n" $0 }
    END {
      q = "\047"; out = ""; state = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (state == "single") {
          if (c == q) state = ""; else out = out c
          continue
        }
        if (state == "double") {
          if (c == "\"") { state = ""; continue }
          if (c == "\\" && i < n && index("$`\"\\\n", substr(s, i + 1, 1))) {
            i++
            if (substr(s, i, 1) != "\n") out = out substr(s, i, 1)
            continue
          }
          out = out c
          continue
        }
        if (state == "ansi") {
          if (c == q) { state = ""; continue }
          if (c != "\\" || i == n) { if (!nul) out = out c; continue }
          i++
          e = substr(s, i, 1)
          if (e == "x" || e == "u" || e == "U") {
            max = (e == "x") ? 2 : ((e == "u") ? 4 : 8)
            v = 0; k = 0
            while (k < max && i < n && hexval(substr(s, i + 1, 1)) >= 0) {
              i++; v = v * 16 + hexval(substr(s, i, 1)); k++
            }
            if (k > 0) emit(v); else if (!nul) out = out "\\" e
          } else if (e ~ /[0-7]/) {
            v = e + 0; k = 1
            while (k < 3 && i < n && substr(s, i + 1, 1) ~ /[0-7]/) {
              i++; v = v * 8 + substr(s, i, 1); k++
            }
            emit(v)
          } else if (e == "c") {
            if (i < n) i++
            emit(1)
          } else if (index("abefnrtvE", e)) {
            emit(1)
          } else if (index("\\\047\"?", e)) {
            if (!nul) out = out e
          } else if (!nul) {
            out = out "\\" e
          }
          continue
        }
        if (c == "\\") {
          if (i < n) { i++; if (substr(s, i, 1) != "\n") out = out substr(s, i, 1) }
          continue
        }
        if (c == q) { state = "single"; continue }
        if (c == "\"") { state = "double"; continue }
        if (c == "$" && i < n && substr(s, i + 1, 1) == q) {
          state = "ansi"; nul = 0; i++
          continue
        }
        if (c == "$" && i < n && substr(s, i + 1, 1) == "\"") {
          state = "double"; i++
          continue
        }
        out = out c
      }
      gsub(/\\/, "\001", out)
      print out
    }
  '
}

# Drop the backslash-newline pairs bash removes before it splits words: those
# outside quotes and inside "...", but not inside '...' or $'...'. The later
# passes split the command into words and rejoin them with spaces, which would
# turn $\<newline>'...' into `$\ '...'` and hide the $'...' string bash reads.
shell_join_line_continuations() {
  printf '%s\n' "$1" | awk '
    { s = (NR == 1) ? $0 : s "\n" $0 }
    END {
      q = "\047"; out = ""; state = ""; dollar = 0; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (state == "single") {
          if (c == q) state = ""
          out = out c
          continue
        }
        if (state == "ansi") {
          out = out c
          if (c == "\\" && i < n) { i++; out = out substr(s, i, 1) }
          else if (c == q) state = ""
          continue
        }
        if (c == "\\" && i < n) {
          i++
          if (substr(s, i, 1) != "\n") { out = out c substr(s, i, 1); dollar = 0 }
          continue
        }
        if (state == "double") {
          if (c == "\"") state = ""
          out = out c
          continue
        }
        if (c == q) state = dollar ? "ansi" : "single"
        else if (c == "\"") state = "double"
        dollar = (c == "$" && !dollar)
        out = out c
      }
      print out
    }
  '
}

# Remove only exclusion operands whose command context proves they do not name a
# file to read. This is intentionally narrow: globally dropping `!*.pem` would
# turn a literal path such as `cat '!secret.pem'` into a policy bypass. Ripgrep's
# negative glob is common in repository scans and has an unambiguous grammar.
bash_strip_exclusion_operands() {
  (
    set -f
    words=$(shell_command_words "$1")
    # shellcheck disable=SC2086
    set -- $words
    result= command_name= pending_glob=

    append_policy_token() {
      if [ -z "$result" ]; then result=$1; else result="$result $1"; fi
    }
    is_negative_glob_value() {
      value=$1
      case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
        \"*\") value=${value#\"}; value=${value%\"} ;;
      esac
      case "$value" in !*) return 0 ;; *) return 1 ;; esac
    }

    for token in "$@"; do
      if is_shell_command_separator "$token"; then
        [ -n "$pending_glob" ] && append_policy_token "$pending_glob"
        pending_glob=
        append_policy_token "$token"
        command_name=
        continue
      fi

      if [ -z "$command_name" ]; then
        if is_assignment_token "$token" || is_noop_wrapper "${token##*/}"; then
          append_policy_token "$token"
          continue
        fi
        command_name=${token##*/}
        command_name=$(printf '%s' "$command_name" | tr -d "'\"")
        append_policy_token "$token"
        continue
      fi

      if [ "$command_name" = rg ]; then
        if [ -n "$pending_glob" ]; then
          if is_negative_glob_value "$token"; then
            pending_glob=
            continue
          fi
          append_policy_token "$pending_glob"
          pending_glob=
        fi
        case "$token" in
          -g|--glob|--iglob)
            pending_glob=$token
            continue
            ;;
          --glob=*|--iglob=*)
            value=${token#*=}
            is_negative_glob_value "$value" && continue
            ;;
        esac
      fi
      append_policy_token "$token"
    done
    [ -n "$pending_glob" ] && append_policy_token "$pending_glob"
    printf '%s' "$result"
  )
}

# Return a literal shell token suitable for template classification. Fully
# quoted tokens without expansion syntax are safe to unwrap; partial quoting,
# double-quoted expansions, and tokens split at whitespace remain conservative.
env_exception_literal_shell_token() {
  literal_shell_token=$1
  literal_env_unquoted=0
  case "$literal_shell_token" in
    \'*\')
      literal_env_value=${literal_shell_token#\'}
      literal_env_value=${literal_env_value%\'}
      case "$literal_env_value" in *\'*) return 1 ;; esac
      ;;
    \"*\")
      literal_env_value=${literal_shell_token#\"}
      literal_env_value=${literal_env_value%\"}
      case "$literal_env_value" in
        *\"*|*\\*|*'$'*|*'`'*) return 1 ;;
      esac
      ;;
    *\'*|*\"*) return 1 ;;
    *)
      literal_env_value=$literal_shell_token
      literal_env_unquoted=1
      ;;
  esac

  # The exception candidate must remain literal even if a wrapper such as
  # `eval` performs another round of shell parsing. Apply this after unquoting,
  # not only to initially unquoted tokens: a single-quoted expansion is inert
  # for the first parse but becomes active when eval reinterprets it. Otherwise
  # a dynamic prefix can hide a denied read behind an allowed basename and the
  # whole token would be removed before the deny regex sees the protected path.
  case "$literal_env_value" in
    *\'*|*\"*|*'$'*|*'`'*|*\\*|*'*'*|*'?'*|*'['*|*']'*|*'{'*|*'}'*|\
    *'('*|*')'*|*'<'*|*'>'*) return 1 ;;
  esac

  # Only an initially unquoted `~/...` is normalized to the same path the shell
  # expands. Quoted tildes and account-lookup forms such as `~other/...` can
  # change meaning under another parse and therefore stay in the deny scan.
  case "$literal_env_value" in
    '~/'*) [ "$literal_env_unquoted" -eq 1 ] || return 1 ;;
    *'~'*) return 1 ;;
  esac
  case "$literal_env_value" in *[[:space:]]*) return 1 ;; esac
  printf '%s' "$literal_env_value"
}

# Drop tokens that name an allowed `.env` template (e.g. `.env.example`) before
# the whole-command deny regex runs, so `cat .env.example` is allowed while
# `cat .env.example .env` still blocks on the bare `.env` token. Globbing is
# disabled inside a subshell so a stray `*` in the command is not expanded
# against the real filesystem during word splitting. A template *name* that is
# actually a symlink to a deny-listed secret is NOT stripped: mirroring the Read
# path (matches_deny_path), the token is resolved and kept when its target is
# itself deny-listed, so the whole-command deny gate still blocks it. A genuine
# template file resolves to a same-named target and is still stripped.
bash_strip_allowed_tokens() {
  (
    set -f
    bash_relative_env_exception_safe=1
    bash_command_may_rebase_relative_paths "$1" \
      && bash_relative_env_exception_safe=0
    words=$(shell_command_words "$1")
    # shellcheck disable=SC2086
    set -- $words
    result=
    for token in "$@"; do
      env_exception_token=$(env_exception_literal_shell_token "$token" 2>/dev/null || true)
      if [ -n "$env_exception_token" ] \
        && candidate_has_default_env_exception "$env_exception_token"; then
        normalized=$(normalize_path "$env_exception_token")
        case "$normalized" in
          /*) bash_env_token_context_safe=1 ;;
          *) bash_env_token_context_safe=$bash_relative_env_exception_safe ;;
        esac
        if [ "$bash_env_token_context_safe" -eq 1 ] \
          && ! candidate_matches_deny "$normalized"; then
          resolved=$(resolve_path "$normalized")
          if [ "$resolved" = "$normalized" ] || ! candidate_matches_deny "$resolved"; then
            continue
          fi
        fi
      fi
      if [ -z "$result" ]; then
        result=$token
      else
        result="$result $token"
      fi
    done
    printf '%s' "$result"
  )
}

# POSIX sh has no locals: this function must NOT assign the bare name `cmd`, or
# it clobbers the caller's command in check_bash_command. The strip helpers
# rejoin tokens with single spaces (dropping a real newline separator), so a
# clobbered `cmd` would collapse `cd X<newline>git commit` into one word and hide
# the commit from check_git_command's detector (#127). Use a private name.
bash_matches_deny_path() {
  deny_cmd=$1
  case "$deny_cmd" in
    *"\\
"*) deny_cmd=$(shell_join_line_continuations "$deny_cmd") ;;
  esac
  deny_cmd=$(bash_strip_exclusion_operands "$deny_cmd")
  deny_cmd=$(bash_strip_allowed_tokens "$deny_cmd")
  bash_matches_deny_path_mode "$deny_cmd" "literal" && return 0
  bash_matches_deny_path_mode "$deny_cmd" "shell-expanded" && return 0
  dequoted=$(shell_dequote_for_policy "$deny_cmd")
  [ "$dequoted" = "$deny_cmd" ] && return 1
  bash_matches_deny_path_mode "$dequoted" "literal" && return 0
  bash_matches_deny_path_mode "$dequoted" "shell-expanded" && return 0
  case "$deny_cmd" in *"\$'"*) ;; *) return 1 ;; esac
  decoded=$(shell_decode_ansi_c_for_policy "$deny_cmd")
  bash_matches_deny_path_mode "$decoded" "literal" && return 0
  bash_matches_deny_path_mode "$decoded" "shell-expanded"
}

is_shell_command_separator() {
  case "$1" in
    ';'|'&&'|'||'|'|') return 0 ;;
    *) return 1 ;;
  esac
}

shell_command_words() {
  printf '%s\n' "$1" | awk '
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        n = substr($0, i + 1, 1)
        if (c == "&" && n == "&") {
          out = out " && "
          i++
          continue
        }
        if (c == "|" && n == "|") {
          out = out " || "
          i++
          continue
        }
        if (c == ";" || c == "|") {
          out = out " " c " "
          continue
        }
        out = out c
      }
      print out
    }
  '
}

# Tokenize only enough POSIX shell syntax to locate git and its cwd-changing
# options without executing the command. Each record is prefixed with 0 for a
# literal token, 4 for one that shell expansion yields as exactly one word
# (every expansion is double-quoted and cannot split, like "$x" or "$(cmd)"),
# or 1 for one whose expansion may split into several words, or into none;
# malformed input is emitted as 2. A quoted or escaped `;`, `&&`, `||` or `|`
# is a 4 too, so that no caller mistakes it for the operator. A bare `&` or a `( ) { }` character is emitted on its own with
# prefix 3: a command boundary for most callers, but the commit argument parser
# must tell `2>&1` and brace expansion apart from the end of the command. Newlines cannot be represented safely in the record stream, so
# they make the affected token dynamic and therefore subject to infra policy.
# Comments are dropped. A here-document body is still tokenized, since it may
# be code for another shell, but is wrapped in `3(` and `3)`: nothing in it
# runs in this shell.
git_command_records() {
  printf '%s\n' "$1" | awk '
    BEGIN { heredoc_next = 1 }
    function emit() {
      if (!started) return
      if (heredoc_expect) {
        delim = substr(word, heredoc_mark + 1)
        heredoc_mark = 0
        if (delim != "" || heredoc_quoted) {
          heredoc_quoted = 0
          heredoc_delim[++heredoc_count] = delim
          heredoc_strip[heredoc_count] = heredoc_dash
          heredoc_expect = 0
        }
      }
      print (splits ? "1" : dynamic || word ~ /^(;|&&|\|\||\|)$/ ? "4" : "0") word
      if (word == "[[") in_test = 1
      if (word == "]]") in_test = 0
      word = ""; started = 0; dynamic = 0; splits = 0
    }
    NR > 1 {
      if (quote == "") { emit(); print "0;" }
      else { word = word " "; dynamic = 1 }
      heredoc_expect = 0; heredoc_quoted = 0
    }
    heredoc_next <= heredoc_count && NR > heredoc_line {
      line = $0
      if (heredoc_strip[heredoc_next]) sub(/^\t+/, "", line)
      if (line != heredoc_delim[heredoc_next]) {
        if (!heredoc_open) { print "3("; heredoc_open = 1 }
      } else {
        if (quote != "") { quote = ""; dynamic = 1; splits = 1 }
        emit()
        if (heredoc_open) { print "3)"; heredoc_open = 0 }
        heredoc_next++
        next
      }
    }
    {
      in_heredoc = heredoc_next <= heredoc_count && NR > heredoc_line
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        n = substr($0, i + 1, 1)
        if (quote == "single") {
          if (c == "\047") quote = ""
          else word = word c
          started = 1
          continue
        }
        if (quote == "double") {
          if (c == "\"") { quote = ""; started = 1; continue }
          # `"` needs no backslash inside a bracket expression, and `\"` is not
          # a defined escape there: gawk warns on every hook run and another awk
          # is free to read the class differently. `\\` already puts a literal
          # backslash in the set, so the class is unchanged (#99).
          if (c == "\\" && n ~ /^["\\$`]$/) {
            word = word n; started = 1; i++; continue
          }
          if (c == "$" || c == "`") dynamic = 1
          # "$@", "${a[@]}", "${!a@}", zsh "$a[@]" and "${(f)a}" still split;
          # "${a:-b c}" does not.
          if (c == "$" && substr($0, i) !~ /^\$([A-Za-z_][A-Za-z0-9_]*([^A-Za-z0-9_[]|$)|[0-9*#?$!-]|\{#?([A-Za-z_][A-Za-z0-9_]*|[0-9]+)[^}@[]*\}|\()/) splits = 1
          word = word c; started = 1
          continue
        }
        if (c == " " || c == "\t") { emit(); continue }
        # `#` opens a comment only where a word starts; `${#x}` and `a#b` do not,
        # nor does `$(x)#y`, but `(x)#y` does.
        if (c == "#" && !started && (i == 1 || substr($0, i - 1, 1) ~ /[ \t;&|(]/ \
            || (substr($0, i - 1, 1) == ")" && closed == "s"))) break
        if (c == "\047" || c == "\"") {
          # An empty quoted word after << is a valid delimiter.
          if (heredoc_expect) heredoc_quoted = 1
          quote = c == "\047" ? "single" : "double"; started = 1; continue
        }
        if (c == "\\") {
          if (i == length($0)) { dynamic = 1; splits = 1; started = 1; continue }
          word = word n; started = 1; i++; continue
        }
        if (c == "<" && n == "<" && !in_heredoc) {
          if (substr($0, i + 2, 1) == "<") { word = word "<<<"; started = 1; i += 2; continue }
          word = word "<<"; started = 1; i++
          heredoc_dash = substr($0, i + 1, 1) == "-"
          if (heredoc_dash) { word = word "-"; i++ }
          heredoc_expect = 1; heredoc_mark = length(word); heredoc_line = NR
          continue
        }
        if (c == ";" || c == "|" || (c == "&" && n == "&")) {
          emit()
          if ((c == "|" || c == "&") && n == c) { print "0" c c; i++ }
          else print "0" c
          continue
        }
        # Bare &, newline-free ( ) { } grouping: treat as a command boundary so
        # a git commit/push after one is still seen as a command head (#127).
        # Over-splitting can only cause MORE detection, never less.
        if (c == "&" || c == "(" || c == ")" || c == "{" || c == "}") {
          # A `(` that starts a word opens a subshell; `$(`, `<(`, `@(` and a
          # group in a `[[ =~ ]]` pattern do not.
          if (c == "(") parens = parens (started || in_test ? "w" : "s")
          if (c == ")") { closed = substr(parens, length(parens)); parens = substr(parens, 1, length(parens) - 1) }
          emit(); print "3" c; continue
        }
        if (c == "$" || c == "`") { dynamic = 1; splits = 1 }
        word = word c; started = 1
      }
    }
    END {
      if (quote != "") print "2"
      else emit()
    }
  '
}

# A relative template token can be resolved safely only when the command keeps
# the event workdir as its path base. Refuse the exception when shell syntax is
# dynamic or a command can rebase later relative operands (`cd`, `env -C`,
# `find -execdir`, and common `-C`/directory forms). Absolute template paths are
# unaffected because their resolution does not depend on command-local cwd.
bash_command_may_rebase_relative_paths() (
  set -f
  cwd_records=$(git_command_records "$1")
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $cwd_records
  IFS=$old_ifs

  cwd_option_owner=
  for cwd_record in "$@"; do
    case "$cwd_record" in
      4';'|4'&&'|4'||'|4'|') cwd_option_owner=; continue ;;
      1*|2*|4*) return 0 ;;
      3*) cwd_option_owner=; continue ;;
    esac
    cwd_token=${cwd_record#?}
    cwd_token_name=${cwd_token##*/}
    case "$cwd_token_name" in
      ';'|'&&'|'||'|'|') cwd_option_owner=; continue ;;
      cd|pushd|popd|chroot) return 0 ;;
      env|tar|git|make|ninja|cmake|sudo|find)
        cwd_option_owner=$cwd_token_name
        ;;
      -execdir|-execdir=*) return 0 ;;
      --chdir|--chdir=*|--directory|--directory=*) return 0 ;;
      -C|-C?*)
        case "$cwd_option_owner" in
          env|tar|git|make|ninja|cmake) return 0 ;;
        esac
        ;;
      -D|-D?*) [ "$cwd_option_owner" = sudo ] && return 0 ;;
    esac
  done
  return 1
)

git_option_takes_value() {
  case "$1" in
    -c|-C|--git-dir|--work-tree|--namespace|--exec-path|--config-env) return 0 ;;
    *) return 1 ;;
  esac
}

is_git_global_option() {
  case "$1" in
    -*) return 0 ;;
    *) return 1 ;;
  esac
}

is_assignment_token() {
  case "$1" in
    [A-Za-z_]*=*)
      case "${1%%=*}" in
        *[!A-Za-z0-9_]*) return 1 ;;
        *) return 0 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

# The variables that decide which configuration files git reads, and so what a
# git alias expands to. GIT_CONFIG itself redirects `git config` alone.
is_git_config_env_name() {
  case "$1" in
    HOME|XDG_CONFIG_HOME|GIT_CONFIG_*|GIT_DIR|GIT_COMMON_DIR|GIT_CEILING_DIRECTORIES|GIT_DISCOVERY_ACROSS_FILESYSTEM) return 0 ;;
    *) return 1 ;;
  esac
}

# Succeed when a word names one of those variables other than in an expansion
# that only reads it, as `export HOME=x`, `unset GIT_DIR`, `read HOME` and
# `${HOME:=x}` do.
mentions_git_config_env() {
  case "$1" in
    *HOME*|*GIT_*) ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$1" \
    | sed -E 's/\$[A-Za-z_][A-Za-z0-9_]*//g; s/\$\{#?[A-Za-z_][A-Za-z0-9_]*([}#%\/^,?+-]|:[^=])//g' \
    | grep -Eq '(^|[^A-Za-z0-9_])(HOME|XDG_CONFIG_HOME|GIT_CONFIG_[A-Za-z0-9_]*|GIT_DIR|GIT_COMMON_DIR|GIT_CEILING_DIRECTORIES|GIT_DISCOVERY_ACROSS_FILESYSTEM)([^A-Za-z0-9_]|$)'
}

# Git runs a subcommand that has no built-in as an external git-<name>
# program, else as an alias; an alias cannot hide a built-in, except a
# deprecated one. The common built-ins skip spawning git to list them.
git_is_builtin() {
  case "$1" in
    status|log|diff|show|add|stage|rm|mv|rev-parse|config|remote|branch|tag|ls-files|describe|shortlog|blame|grep|fetch|pull|checkout|switch|restore|reset|stash|merge|rebase|cherry-pick|revert|init|clone|worktree|submodule|apply|am|format-patch|ls-tree|ls-remote|cat-file|rev-list|for-each-ref|show-ref|symbolic-ref|reflog|clean|bisect|notes|gc|fsck|version|help|var|merge-base|update-index) return 0 ;;
  esac
  if [ -z "${git_builtin_names+x}" ]; then
    git_builtin_names=$(git --list-cmds=builtins 2>/dev/null) || git_builtin_names=
    git_deprecated_names=$(git --list-cmds=deprecated 2>/dev/null) || git_deprecated_names=
  fi
  case "
$git_deprecated_names
" in
    *"
$1
"*) return 1 ;;
  esac
  case "
$git_builtin_names
" in
    *"
$1
"*) return 0 ;;
  esac
  return 1
}

git_has_external() {
  command -v "git-$1" >/dev/null 2>&1 && return 0
  git_exec_path=$(git --exec-path 2>/dev/null) && [ -x "$git_exec_path/git-$1" ]
}

# Print the alias git expands subcommand $1 to when it runs in directory $2,
# then in each directory on a line of $3, with the git options in $4 (-c,
# --git-dir, --bare) and the variable assignments in $5, one word per line.
# Fail with 1 when $1 names no alias and help.autocorrect runs no guess, with 3
# when autocorrect may run one, and with 2 when the configuration cannot be
# read or the alias is not a plain git command line, one that the tokenizer
# splits the way git does: `!` shell aliases included.
git_alias_lookup() (
  set -f
  alias_name=$1
  CDPATH= cd -- "$2" 2>/dev/null || exit 2
  IFS='
'
  for alias_dir in $3; do
    # A shell cd resolves `..` logically, git -C and env -C physically.
    alias_physical=$(CDPATH= cd -P -- "$alias_dir" 2>/dev/null && pwd -P) || exit 2
    CDPATH= cd -- "$alias_dir" 2>/dev/null || exit 2
    [ "$(pwd -P)" = "$alias_physical" ] || exit 2
  done
  unset GIT_CONFIG
  # shellcheck disable=SC2086
  set -- $5 git $4 config -z --list
  # Each entry is `key<LF>value<NUL>`, or `key<NUL>` for a bare boolean: one
  # line per entry, with \001 after the key and for a newline in the value.
  alias_value=$(
    { env "$@" 2>/dev/null || printf '\001failed\0'; } \
      | tr '\0\n' '\n\001' \
      | awk -v name="$alias_name" '
        BEGIN { FS = "\001"; name = tolower(name) }
        $0 == "\001failed" { failed = 1; next }
        {
          key = tolower($1)
          sep = index($0, FS)
          # Git matches `alias.<name>` case-insensitively and the subsection
          # form `alias.<name>.command` case-sensitively; match both loosely.
          if (key == "alias." name || key == "alias." name ".command") {
            found = 1
            bare = !sep
            value = substr($0, sep + 1)
          } else if (key == "help.autocorrect") {
            autocorrect = sep ? tolower(substr($0, sep + 1)) : "true"
          }
        }
        END {
          if (failed || (found && bare)) exit 2
          if (found) { print value; exit 0 }
          if (autocorrect == "" || autocorrect ~ /^(0|false|off|no|show|never)$/) exit 1
          exit 3
        }
      '
  )
  alias_status=$?
  case "$alias_status:$alias_value" in
    0:|0:!*|0:*[!A-Za-z0-9_./=:,+@%^~?*\'\"\ \	-]*) exit 2 ;;
  esac
  [ "$alias_status" -ne 0 ] || printf '%s\n' "$alias_value"
  exit "$alias_status"
)

# Transparent wrappers that run the command following them; a git commit/push
# behind one of these still stages/commits, so the gate must see through it.
is_noop_wrapper() {
  case "$1" in
    env|command|sudo|nice|nohup|time|xargs) return 0 ;;
    *) return 1 ;;
  esac
}

# Wrapper options that consume the next token as a value (env -u NAME, env -C
# DIR, nice -n N, …). Kept to unambiguous flags so the wrapped command head is
# not misread as an option value.
wrapper_option_takes_value() {
  case "$1" in
    -u|--unset|-C|--chdir|-S|--split-string|-n) return 0 ;;
    *) return 1 ;;
  esac
}

long_option_abbreviates() {
  [ -n "$1" ] || return 1
  case "$2" in
    "$1"*) return 0 ;;
    *) return 1 ;;
  esac
}

# `git commit -a`, --patch, --interactive, --pathspec-from-file, and a
# pathspec (with or without --only/--include) make Git stage tracked work-tree
# changes itself, after PreToolUse has run. Given the git_command_records after
# `commit`, print W when any tracked change may be staged, I when untracked
# files may be too (--interactive), and P<pathspec> for each literal pathspec.
# Every misreading must widen the scan, never narrow it: a word only known at
# run time may be --interactive, so it becomes I, and an unrecognised option is
# a flag, so the word after it stays a pathspec. Git accepts unambiguous
# long-option prefixes, and an ambiguous one fails the commit, so any prefix of
# a staging option widens the scan.
git_commit_stage_records() {
  stage_skip_next=0
  stage_options_done=0
  while [ "$#" -gt 0 ]; do
    stage_kind=${1%"${1#?}"}
    stage_word=${1#?}
    shift
    if [ "$stage_kind" = 3 ]; then
      case "$stage_word" in
        '&')
          # `2>&1` and `&>log` are redirections, not a background `&`; the
          # pathspec that may follow them still belongs to this commit.
          [ "$stage_skip_next" -ne 0 ] && continue
          case "${1-}" in
            0'>'*|0'<'*) continue ;;
          esac
          return 0
          ;;
        # Brace expansion can yield any option or pathspec, and `(` here is
        # extglob or a syntax error.
        '{'|'}') printf 'I\n'; continue ;;
        '(') printf 'W\n'; return 0 ;;
        *) return 0 ;;
      esac
    fi
    if [ "$stage_kind" = 0 ] && is_shell_command_separator "$stage_word"; then
      return 0
    fi
    # A quoted operator, like the pathspec in `-- ';'`, is a literal word.
    case "$stage_kind$stage_word" in
      4';'|4'&&'|4'||'|4'|') stage_kind=0 ;;
    esac
    if [ "$stage_skip_next" -eq 1 ]; then
      stage_skip_next=0
      # An option value that may split, like `-m $F`, may also be --interactive.
      case "$stage_kind" in
        0|4) ;;
        *) printf 'I\n' ;;
      esac
      continue
    fi
    if [ "$stage_skip_next" -eq 2 ]; then
      stage_skip_next=0
      # A redirection target, unless the shell saw a quoted `>` pathspec: keep
      # every word that can name a file inside the repository.
      case "$stage_word" in
        /*|..|../*|-) ;;
        *[!0-9]*) [ "$stage_kind" = 0 ] && printf 'P%s\n' "$stage_word" ;;
      esac
      continue
    fi
    if [ "$stage_kind" != 0 ]; then
      printf 'I\n'
      continue
    fi
    # The tokenizer keeps `x>log` whole; the shell passes `x` to Git. Keep the
    # whole word too, in case it was a quoted pathspec.
    stage_prefix=${stage_word%%[<>]*}
    case "$stage_prefix" in
      *[!0-9]*)
        if [ "$stage_prefix" != "$stage_word" ]; then
          printf 'P%s\n' "$stage_word"
          case "$stage_word" in
            *'>'|*'<') stage_skip_next=2 ;;
          esac
          stage_word=$stage_prefix
        fi
        ;;
    esac
    stage_redirect=${stage_word#"${stage_word%%[!0-9]*}"}
    # A redirection word is also a harmless relative pathspec, and keeping it
    # covers a quoted pathspec that merely looks like one.
    case "$stage_redirect" in
      '>'|'>>'|'<'|'<<'|'<<<'|'<>'|'>|') printf 'P%s\n' "$stage_word"; stage_skip_next=2; continue ;;
      '>'*|'<'*) printf 'P%s\n' "$stage_word"; continue ;;
    esac
    # An unquoted glob that starts with `-` or with a glob character can
    # expand to a file named `-a` or `--interactive`; the tokenizer cannot
    # tell it from a quoted one. A glob under a directory is a pathspec.
    case "$stage_word" in
      -*[*?[]*|[*?[]*) printf 'I\n'; continue ;;
    esac
    if [ "$stage_options_done" -eq 0 ]; then
      case "$stage_word" in
        --)
          stage_options_done=1
          continue
          ;;
        --*)
          stage_long=${stage_word#--}
          stage_long=${stage_long%%=*}
          for stage_option in all interactive patch pathspec-from-file; do
            if long_option_abbreviates "$stage_long" "$stage_option"; then
              printf 'W\n'
              break
            fi
          done
          long_option_abbreviates "$stage_long" interactive && printf 'I\n'
          case "$stage_word" in
            *=*) ;;
            --file|--author|--date|--message|--reedit-message|--reuse-message|--fixup|--squash|--trailer|--template|--cleanup|--unified|--inter-hunk-context)
              stage_skip_next=1
              ;;
            # Its file lies outside the repository as often as not; the scan
            # is already whole-tree, so dropping the word loses nothing.
            *) long_option_abbreviates "$stage_long" pathspec-from-file && stage_skip_next=1 ;;
          esac
          continue
          ;;
        -?*)
          stage_short=${stage_word#-}
          while [ -n "$stage_short" ]; do
            stage_flag=${stage_short%"${stage_short#?}"}
            stage_short=${stage_short#?}
            case "$stage_flag" in
              a|p) printf 'W\n' ;;
              F|m|c|C|t|U) [ -n "$stage_short" ] || stage_skip_next=1; break ;;
              # -S and -u take only an attached optional value.
              S|u) break ;;
            esac
          done
          continue
          ;;
      esac
    fi
    printf 'P%s\n' "$stage_word"
  done
  return 0
}

# Given the records after `git add`, succeed when it may add ignored files:
# -f/--force (or a prefix of it, which Git accepts), or a word only known at
# run time — a variable, a brace expansion, or a glob that may match `-f`
# (one that starts with `-` or with a glob character; `src/*.js` cannot).
git_add_is_forced() {
  add_after_redirect=0
  while [ "$#" -gt 0 ]; do
    add_kind=${1%"${1#?}"}
    add_word=${1#?}
    shift
    case "$add_kind:$add_word" in
      # `2>&1` and `&>log` arrive split around a bare `&`; the arguments after
      # them still belong to this `git add`.
      3:'&')
        [ "$add_after_redirect" -eq 1 ] && continue
        case "${1-}" in
          0'>'*|0'<'*) continue ;;
        esac
        return 1
        ;;
      3:'{'|3:'}') return 0 ;;
      3:*) return 1 ;;
      0:*) is_shell_command_separator "$add_word" && return 1 ;;
      *) return 0 ;;
    esac
    add_after_redirect=0
    case "$add_word" in
      *'>'|*'<') add_after_redirect=1 ;;
    esac
    # The tokenizer keeps `-f>log` whole; the shell passes `-f` to Git.
    add_prefix=${add_word%%[<>]*}
    case "$add_prefix" in
      *[!0-9]*) add_word=$add_prefix ;;
    esac
    case "$add_word" in
      -*[*?[]*|[*?[]*) return 0 ;;
      --) return 1 ;;
      --*) long_option_abbreviates "${add_word#--}" force && return 0 ;;
      -*f*) return 0 ;;
    esac
  done
  return 1
}

# Given the records after `cd` or `pushd`, print the one literal directory it
# changes to. Fail when only run time knows it: no operand ($HOME), `-`
# ($OLDPWD), an option or directory-stack entry, several operands (zsh
# substitutes), a dynamic, tilde or glob word, a relative one that CDPATH may
# redirect ($shell_cd_cdpath), or a redirection that may fail and skip the cd.
shell_cd_target() {
  cd_target=
  cd_operands=0
  cd_dashdash=0
  cd_skip=0
  cd_dup=0
  while [ "$#" -gt 0 ]; do
    cd_kind=${1%"${1#?}"}
    cd_word=${1#?}
    shift
    if [ "$cd_skip" -eq 1 ]; then
      # `2>&1` arrives as `2>`, `&`, `1`.
      if [ "$cd_kind$cd_word" = '3&' ]; then
        cd_dup=1
        continue
      fi
      cd_skip=0
      # A redirection that fails skips the cd; these cannot fail.
      case "$cd_dup$cd_kind$cd_word" in
        101|102|00/dev/null) continue ;;
        *) return 1 ;;
      esac
    fi
    case "$cd_kind$cd_word" in
      0';'|0'&&'|0'||'|0'|'|3'&'|3')'|3'}') break ;;
      # Brace expansion adds operands; `(` is a syntax error.
      *) [ "$cd_kind" != 3 ] && [ "$cd_kind" != 2 ] || return 1 ;;
    esac
    cd_redirect=${cd_word#"${cd_word%%[!0-9]*}"}
    case "$cd_redirect" in
      '>'|'>>'|'<')
        cd_skip=1
        cd_dup=0
        continue
        ;;
      '>/dev/null'|'>>/dev/null'|'</dev/null') continue ;;
      *'>'*|*'<'*) return 1 ;;
    esac
    [ "$cd_kind" = 0 ] || return 1
    if [ "$cd_word$cd_dashdash$cd_operands" = --00 ]; then
      cd_dashdash=1
      continue
    fi
    cd_operands=$((cd_operands + 1))
    cd_target=$cd_word
  done
  [ "$cd_operands" -eq 1 ] || return 1
  case "$cd_target" in
    # zsh expands a leading `=` to a command path.
    ''|[-+=]*|'~'*|*[*?[]*) return 1 ;;
    /*|.|..|./*|../*) ;;
    *) [ "$shell_cd_cdpath" -eq 0 ] || return 1 ;;
  esac
  printf '%s\n' "$cd_target"
}

# Given `eval` or a shell name and the records after it, print how many of
# them the command takes, a colon, and the code it runs: eval's arguments
# joined by spaces, the script after -c, or a here-string. Fail with 1 when
# only run time knows that code, and with 2 when the command line holds none
# (a script file, or stdin from a pipe, a file or a here-document, whose body
# is tokenized in place).
shell_command_code() {
  code_shell=$1
  shift
  code_taken=0
  code_text=
  code_state=options
  code_c=0
  code_here=
  code_prev=
  while [ "$#" -gt 0 ]; do
    code_kind=${1%"${1#?}"}
    code_word=${1#?}
    case "$code_kind$code_word" in
      0';'|0'&&'|0'||'|0'|'|3'('|3')'|3'}') break ;;
      # `2>&1` arrives as `2>`, `&`, `1`.
      3'&')
        case "$code_prev" in
          *'>'|*'<') ;;
          *) break ;;
        esac
        ;;
      # Brace expansion.
      3*) return 1 ;;
    esac
    shift
    code_taken=$((code_taken + 1))
    code_prev=$code_word
    if [ "$code_shell" = eval ]; then
      case "$code_kind" in
        0|3|4)
          # A quoted operator is not one to eval, but eval parses it as one.
          case "$code_kind$code_word" in
            4';'|4'&&'|4'||'|4'|') ;;
            4*) return 1 ;;
          esac
          ;;
        *) return 1 ;;
      esac
      # eval's `--` may follow redirections, which apply to eval itself.
      if [ "$code_kind" = 0 ] && [ "$code_state" != script ]; then
        case "$code_state:${code_word#"${code_word%%[!0-9]*}"}" in
          redirect:*) code_state=options ;;
          *:'>'|*:'>>'|*:'<'|*:'<>'|*:'>|'|*:'<<<') code_state=redirect ;;
          *:'>'*|*:'<'*) ;;
          *:--) code_state=script; continue ;;
          *) code_state=script ;;
        esac
      fi
      code_text="$code_text${code_text:+ }$code_word"
      continue
    fi
    [ "$code_kind" = 3 ] && continue
    case "$code_state" in
      # The words after a -c script are its $0, $1, ...: data.
      script) continue ;;
      redirect) code_state=options; continue ;;
      here)
        code_state=options
        code_here=$code_kind$code_word
        continue
        ;;
      # An option value that splits may add -c.
      value)
        code_state=options
        case "$code_kind" in
          0|4) continue ;;
          *) return 1 ;;
        esac
        ;;
    esac
    [ "$code_kind" = 0 ] || return 1
    case "${code_word#"${code_word%%[!0-9]*}"}" in
      '<<<') code_state=here; continue ;;
      '<<<'*) code_here=0${code_word#*'<<<'}; continue ;;
      '>'|'>>'|'<'|'<>'|'>|') code_state=redirect; continue ;;
      '>'*|'<'*) continue ;;
    esac
    if [ "$code_state" = options ]; then
      case "$code_word" in
        --|-) code_state=operands; continue ;;
        --rcfile|--init-file) code_state=value; continue ;;
        --*) continue ;;
        [-+]*)
          case "$code_word" in
            -*c*) code_c=1 ;;
          esac
          # -o and -O take an option name.
          case "$code_word" in
            [-+]*[oO]*) code_state=value ;;
          esac
          continue
          ;;
      esac
    fi
    [ "$code_c" -eq 1 ] || return 2
    code_text=$code_word
    code_state=script
  done
  # A shell with no -c and no script file operand reads stdin.
  if [ "$code_shell" != eval ] && [ "$code_state" != script ]; then
    [ "$code_c" -eq 0 ] || return 2
    case "$code_here" in
      '') return 2 ;;
      0*) code_text=${code_here#0} ;;
      *) return 1 ;;
    esac
  fi
  printf '%s:%s\n' "$code_taken" "$code_text"
}

is_git_commit_or_push() {
  cmd=$1
  git_alias_workdir=${2:-}
  [ -n "$git_alias_workdir" ] || git_alias_workdir=$(pwd)
  (
    set -f
    words=$(git_command_records "$cmd")
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    IFS=$old_ifs

    unset git_builtin_names
    # A git alias expands per the configuration its command reads. That is
    # unknown once an earlier part of the line may write a config file
    # (git_config_mutable) or change the variables that locate one
    # (git_env_changed), or when the command's own assignments or options
    # that do so are dynamic. Literal ones are applied to the lookup.
    git_config_mutable=0
    git_env_changed=0
    git_env_args=
    git_env_dynamic=0
    git_config_args=
    git_config_dynamic=0
    git_alias_depth=0
    # Only a redirection to a descriptor or /dev/null writes no file.
    case "$cmd" in
      *'>'*)
        printf '%s\n' "$cmd" \
          | sed -E 's/[0-9]*>&([0-9]+|-)([[:space:];&|)]|$)/\2/g; s/(&|[0-9]*)>>?[|]? *\/dev\/null([[:space:];&|)]|$)/\2/g' \
          | grep -q '>' && git_config_mutable=1
        ;;
    esac
    # PATH decides which external git-<name> programs exist.
    git_external_known=1
    case "$cmd" in
      *PATH*|*--exec-path*) git_external_known=0 ;;
    esac

    command_start=1
    effective_c_dirs=
    effective_c_dynamic=0
    xargs_wrapped=0
    git_index_changed=0
    git_index_forced=0
    matched=1
    # A shell cd moves every later git command, across ; && || and out of a
    # { } group, but not out of a ( ) subshell or a here-document. The scan
    # follows a literal cd whose effect is certain (D records). Any other cd
    # leaves the working directory of every later git command unknown (U):
    # one behind a wrapper, in a pipeline, in a backgrounded list, in braces,
    # after control flow or anything that can redefine cd, after a command
    # that may relink its target, or one reached through && or || once its
    # and-or list ends, since the commands after that run whether or not it
    # did.
    shell_cd_dirs=
    shell_cd_count=0
    shell_cd_unknown=0
    shell_cd_lost=0
    shell_cd_cond=0
    shell_cd_pending=0
    shell_cd_in_list=0
    shell_cd_last=0
    shell_cd_piped=0
    shell_cd_wrapped=0
    shell_cd_braces=0
    shell_cd_untrusted=0
    shell_cd_mutable=0
    shell_cd_function=0
    shell_cd_stack=
    shell_cd_prev=
    shell_cd_cdpath=0
    [ -n "${CDPATH:-}" ] && shell_cd_cdpath=1
    case "$cmd" in
      *[Cc][Dd][Pp][Aa][Tt][Hh]*) shell_cd_cdpath=1 ;;
    esac
    # $1 is a separator or a kind-3 token, $2 the record after it, and $3
    # is 1 when $1 stands where a command starts.
    shell_cd_boundary() {
      shell_cd_last_was=$shell_cd_last
      shell_cd_last=0
      shell_cd_wrapped=0
      shell_cd_piped=0
      case "$1" in
        # cond 1: only && led here, so a cd holds for the rest of the chain;
        # cond 2: an || did, so what follows may run without the cd. A command
        # that runs only because a cd failed keeps its D: the cd fails the
        # same way in the scan, which then reports it could not run.
        '&&') [ "$shell_cd_cond" -eq 2 ] || shell_cd_cond=1 ;;
        '||')
          shell_cd_cond=2
          [ "$shell_cd_pending" -eq 0 ] || shell_cd_unknown=1
          ;;
        '|')
          shell_cd_piped=1
          [ "$shell_cd_last_was" -eq 0 ] || shell_cd_unknown=1
          ;;
        ';'|'&')
          [ "$shell_cd_pending" -eq 0 ] || shell_cd_unknown=1
          # A backgrounded list runs its cds in a subshell.
          [ "$1:$shell_cd_in_list" != '&:1' ] || shell_cd_unknown=1
          shell_cd_cond=0
          shell_cd_pending=0
          shell_cd_in_list=0
          ;;
        '{') [ "$3" -eq 0 ] || shell_cd_braces=$((shell_cd_braces + 1)) ;;
        '}')
          if [ "$3" -eq 1 ] && [ "$shell_cd_braces" -gt 0 ]; then
            shell_cd_braces=$((shell_cd_braces - 1))
          fi
          ;;
        '(')
          if [ "$2" = '3)' ]; then
            # `name()` defines a function, which may be cd itself.
            shell_cd_untrusted=1
            shell_cd_function=1
          else
            shell_cd_stack="$shell_cd_stack $shell_cd_count:$shell_cd_unknown:$shell_cd_cond:$shell_cd_pending:$shell_cd_in_list:$shell_cd_braces"
            shell_cd_cond=0
            shell_cd_pending=0
            shell_cd_in_list=0
          fi
          ;;
        ')')
          if [ "$shell_cd_function" -eq 1 ]; then
            shell_cd_function=0
          elif [ -z "$shell_cd_stack" ]; then
            :
          elif [ "$shell_cd_untrusted" -eq 1 ]; then
            # A case pattern also ends in `)`; the subshell it closes is unknown.
            [ "$shell_cd_count" -eq 0 ] || shell_cd_lost=1
          else
            shell_cd_saved=${shell_cd_stack##* }
            shell_cd_stack=${shell_cd_stack% *}
            shell_cd_count=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_unknown=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_cond=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_pending=${shell_cd_saved%%:*}
            shell_cd_saved=${shell_cd_saved#*:}
            shell_cd_in_list=${shell_cd_saved%%:*}
            shell_cd_braces=${shell_cd_saved#*:}
            if [ "$shell_cd_count" -eq 0 ]; then
              shell_cd_dirs=
            else
              shell_cd_dirs=$(printf '%s\n' "$shell_cd_dirs" | sed -n "1,${shell_cd_count}p")
            fi
          fi
          ;;
      esac
    }
    append_effective_c_dir() {
      record=$1
      case "$record" in
        1*) effective_c_dynamic=1 ;;
        0*)
          dir=${record#?}
          if [ -n "$effective_c_dirs" ]; then
            effective_c_dirs="$effective_c_dirs
$dir"
          else
            effective_c_dirs=$dir
          fi
          ;;
        *) effective_c_dynamic=1 ;;
      esac
    }
    # $1 is a NAME=value record before a command name. A tilde in it expands.
    git_env_assignment() {
      git_env_name=${1#?}
      is_git_config_env_name "${git_env_name%%=*}" || return 0
      case "$1" in
        0*'~'*|[!0]*) git_env_dynamic=1 ;;
        *) git_env_args="$git_env_args${1#?}
" ;;
      esac
    }
    # $1 is an option that changes the configuration git reads, $2 the record
    # of its value.
    git_config_option() {
      case "$2" in
        0*) git_config_args="$git_config_args$1
${2#?}
" ;;
        *) git_config_dynamic=1 ;;
      esac
    }
    # Print what git expands subcommand $1 to, with the status of
    # git_alias_lookup; one that only run time knows fails with 2, unless git
    # runs an external command by that name instead.
    git_subcommand_alias() (
      if [ "$git_config_mutable$git_env_changed$git_env_dynamic$git_config_dynamic$effective_c_dynamic$shell_cd_unknown$shell_cd_lost" = 0000000 ]; then
        git_alias_lookup "$1" "$git_alias_workdir" "$shell_cd_dirs
$effective_c_dirs" "$git_config_args" "$git_env_args"
        git_alias_status=$?
        [ "$git_alias_status" -eq 3 ] || exit "$git_alias_status"
      fi
      [ "$git_external_known" -eq 1 ] && git_has_external "$1" && exit 1
      exit 2
    )
    while [ "$#" -gt 0 ]; do
      record=$1
      record_kind=${record%"${record#?}"}
      token=${record#?}

      if [ "$command_start" -eq 1 ]; then
        # Strip leading `NAME=value` assignments and no-op wrappers so a wrapped
        # invocation like `FOO=1 env git commit --no-verify` still reaches the
        # git check below. command_start stays 1 so the next token is re-examined
        # as the command head.
        if is_assignment_token "$token"; then
          git_env_assignment "$record"
          shift
          continue
        fi
        # `git>/dev/null` and `bash<<<code` are a command name and a
        # redirection; the name alone is matched below.
        head_name=${token%%[<>]*}
        if [ "$record_kind" = 0 ] && [ -n "$head_name" ] && [ "$head_name" != "$token" ]; then
          case "$head_name" in
            *[!0-9]*)
              shift
              set -- "0$head_name" "0${token#"$head_name"}" "$@"
              continue
              ;;
          esac
        fi
        # A redirection may precede the command name: `>/dev/null git commit`.
        # One that fails skips the command, so a cd after it is unknown.
        case "${token#"${token%%[!0-9]*}"}" in
          '>'|'>>'|'<'|'<>'|'>|')
            shell_cd_wrapped=1
            shift
            [ "${1-}" = '3&' ] && shift
            [ "$#" -gt 0 ] && shift
            continue
            ;;
          '>'*|'<'*)
            shell_cd_wrapped=1
            shift
            continue
            ;;
        esac
        # A command name only run time knows may be git, a shell or eval.
        case "$record_kind:${token##*/}" in
          1:*|4:*[\$\`]*)
            printf 'G\nU\n'
            matched=0
            shell_cd_mutable=1
            shift
            command_start=0
            continue
            ;;
        esac
        case "$token" in
          cd|pushd|popd)
            shift
            if [ "$token" != popd ] \
              && [ "$shell_cd_untrusted$shell_cd_piped$shell_cd_wrapped" = 000 ] \
              && [ "$shell_cd_cond" -ne 2 ] \
              && [ "$shell_cd_mutable" -eq 0 ] \
              && [ "$shell_cd_braces" -eq 0 ] \
              && shell_cd_dir=$(shell_cd_target "$@"); then
              if [ -n "$shell_cd_dirs" ]; then
                shell_cd_dirs="$shell_cd_dirs
$shell_cd_dir"
              else
                shell_cd_dirs=$shell_cd_dir
              fi
              shell_cd_count=$((shell_cd_count + 1))
              shell_cd_in_list=1
              [ "$shell_cd_cond" -eq 0 ] || shell_cd_pending=1
            else
              shell_cd_unknown=1
            fi
            shell_cd_last=1
            command_start=0
            continue
            ;;
          # Reserved words start a command of their own, under control flow.
          if|then|else|elif|fi|do|done|while|until|for|case|esac|select|function|coproc|'!')
            shell_cd_untrusted=1
            shift
            continue
            ;;
          builtin)
            shell_cd_wrapped=1
            shift
            continue
            ;;
          # These can redefine or disable cd, or run code that does.
          # exec can also close a descriptor a later `2>&1` duplicates.
          alias|unalias|enable|disable|unset|unfunction|autoload|source|.|eval|exec|trap|shopt|setopt|unsetopt|emulate|*'['*']='*)
            shell_cd_untrusted=1
            ;;
        esac
        # The code a shell or eval runs from its arguments goes through the
        # same checks, in place: a shell's in a ( ) subshell, since its cds
        # do not leave it; eval's in this shell, whose later cds it already
        # made unknown. Code only run time knows may commit or push anywhere;
        # the policy then decides for the whole command, but the open policy
        # still scans the other git commands where they appear to run.
        case "${token##*/}" in
          eval|sh|bash|dash|zsh|ksh|mksh|ash|yash|posh|csh|tcsh)
            shift
            shell_code=$(shell_command_code "${token##*/}" "$@")
            shell_code_status=$?
            # xargs may append -c and a script, or replace text in one.
            [ "$xargs_wrapped" -eq 0 ] || shell_code_status=1
            case "$shell_code_status" in
              0)
                shift "${shell_code%%:*}"
                shell_code_records=$(git_command_records "${shell_code#*:}")
                # An unbalanced ( or ) would restore the cd state of a
                # subshell around this command.
                printf '%s\n' "$shell_code_records" \
                  | awk '$0 == "3(" { d++ } $0 == "3)" && --d < 0 { exit 1 } END { if (d) exit 1 }' \
                  || shell_cd_untrusted=1
                # env -C and --chdir start the shell in their directory.
                shell_code_chdir=
                if [ -n "$effective_c_dirs" ]; then
                  shell_code_chdir=$(printf '%s\n' "$effective_c_dirs" \
                    | awk '{ print "0cd"; print "0--"; print "0" $0; print "0;" }')
                fi
                [ "$effective_c_dynamic" -eq 0 ] || shell_code_chdir="$shell_code_chdir
0cd
1\$
0;"
                # An assignment before eval may outlast it.
                [ -z "$git_env_args" ] && [ "$git_env_dynamic" -eq 0 ] || git_env_changed=1
                IFS='
'
                if [ "${token##*/}" = eval ]; then
                  # shellcheck disable=SC2086
                  set -- $shell_code_records "$@"
                elif [ -n "$shell_code_records" ]; then
                  # shellcheck disable=SC2086
                  set -- '3(' $shell_code_chdir $shell_code_records '3)' "$@"
                fi
                IFS=$old_ifs
                continue
                ;;
              1)
                printf 'G\nU\n'
                matched=0
                ;;
            esac
            shell_cd_mutable=1
            command_start=0
            continue
            ;;
        esac
        if is_noop_wrapper "${token##*/}"; then
          wrapper=${token##*/}
          shell_cd_wrapped=1
          # xargs appends words read from stdin, which may be any argument.
          [ "$wrapper" = xargs ] && xargs_wrapped=1
          # sudo may run git with another HOME.
          [ "$wrapper" = sudo ] && git_env_dynamic=1
          shift
          while [ "$#" -gt 0 ]; do
            record=$1
            record_kind=${record%"${record#?}"}
            token=${record#?}
            case "$token" in
              --) shift; break ;;
              -*)
                case "$wrapper:$token" in
                  env:-C|env:--chdir)
                    shift
                    [ "$#" -gt 0 ] || break
                    append_effective_c_dir "$1"
                    shift
                    continue
                    ;;
                  env:--chdir=*)
                    append_effective_c_dir "$record_kind${token#--chdir=}"
                    shift
                    continue
                    ;;
                  env:-C?*)
                    append_effective_c_dir "$record_kind${token#-C}"
                    shift
                    continue
                    ;;
                  # env -S splits its string into more options and the command.
                  env:-S|env:--split-string)
                    shift
                    [ "$#" -gt 0 ] || break
                    env_split=$1
                    ;;
                  env:-S?*) env_split=$record_kind${token#-S} ;;
                  env:--split-string=*) env_split=$record_kind${token#--split-string=} ;;
                  # -i and -u remove variables that locate git configuration.
                  env:-|env:--ignore-environment|env:--unset|env:--unset=*|env:-[!-]*[iu]*|env:-[iu]*)
                    git_env_dynamic=1
                    env_split=
                    ;;
                  *) env_split= ;;
                esac
                if [ -n "$env_split" ]; then
                  shift
                  # env -S splits at any whitespace and has escapes of its
                  # own (`\_` separates words); read it as shell words only
                  # when every character means the same to both.
                  case "$env_split" in
                    0*[!A-Za-z0-9_./=:,+@%^~?*\'\"\ \	-]*) env_split=1 ;;
                  esac
                  if [ "${env_split%"${env_split#?}"}" != 0 ]; then
                    printf 'G\nU\n'
                    matched=0
                    break
                  fi
                  IFS='
'
                  # shellcheck disable=SC2086
                  set -- $(git_command_records "${env_split#?}") "$@"
                  IFS=$old_ifs
                  continue
                fi
                # A word that may split, or be -C, may move the command.
                [ "$record_kind" = 0 ] || effective_c_dynamic=1
                if wrapper_option_takes_value "$token"; then
                  shift
                  case "${1-}" in
                    1*|2*) effective_c_dynamic=1 ;;
                  esac
                  [ "$#" -gt 0 ] && shift
                else
                  shift
                fi
                ;;
              *)
                is_assignment_token "${1#?}" && { git_env_assignment "$1"; shift; continue; }
                # `{}`, as in `xargs -I{}`, is a word, not a group.
                case "$record" in
                  3'{'|3'}') shift; continue ;;
                esac
                break
                ;;
            esac
          done
          continue
        fi
        if [ "${token##*/}" = git ]; then
          shift
          git_alias_depth=0
          [ "$shell_cd_mutable" -eq 0 ] || git_config_mutable=1
          while [ "$#" -gt 0 ]; do
            record=$1
            token=${record#?}
            # `git --version && cd x` still reaches the cd.
            case "$record" in
              3*|0';'|0'&&'|0'||'|0'|') break ;;
            esac
            shift
            # A redirection is not a git argument: `git 2>&1 commit`.
            case "$record_kind${token#"${token%%[!0-9]*}"}" in
              0'>'|0'>>'|0'<'|0'<>'|0'>|')
                [ "${1-}" = '3&' ] && shift
                [ "$#" -gt 0 ] && shift
                continue
                ;;
              0'>'*|0'<'*) continue ;;
            esac
            # A word only run time knows may be an option that moves the
            # repository, or the subcommand itself: scan it as a commit in an
            # unknown directory. A long option's quoted value is one word.
            if git_option_takes_value "$token"; then
              [ "$#" -gt 0 ] || continue
              [ "$token" = -C ] && append_effective_c_dir "$1"
              git_value=$1
              shift
              case "$token" in
                -c|--git-dir) git_config_option "$token" "$git_value" ;;
                --config-env) git_config_dynamic=1 ;;
              esac
              case "$git_value" in
                0*|4*) continue ;;
              esac
              token=commit
              effective_c_dynamic=1
            else
              case "$record" in
                0--git-dir=*|0--bare) git_config_args="$git_config_args$token
" ;;
                0--config-env=*|4--git-dir=*|4--config-env=*) git_config_dynamic=1 ;;
              esac
              case "$record" in
                0*) is_git_global_option "$token" && continue ;;
                4--*=*)
                  case "${token%%=*}" in
                    *[!A-Za-z-]*) ;;
                    *) continue ;;
                  esac
                  ;;
              esac
              if [ "${record%"$token"}" != 0 ]; then
                token=commit
                effective_c_dynamic=1
              fi
            fi

            case "$token" in
              status|log|diff|show|add|stage|rev-parse|config|remote|branch|tag|ls-files|describe|shortlog|blame|grep|fetch) ;;
              # Checkout, hooks and the rest may move a path a later cd follows.
              *) shell_cd_mutable=1 ;;
            esac
            case "$token" in
              commit|push)
                # One G-led group per git command: a later `git commit -a`
                # in the same command line must not hide behind an earlier
                # plain commit or push.
                printf 'G\n'
                [ "$effective_c_dynamic" -eq 1 ] && printf 'U\n'
                [ "$shell_cd_unknown$shell_cd_lost" = 00 ] || printf 'U\n'
                [ -n "$shell_cd_dirs" ] && printf '%s\n' "$shell_cd_dirs" | sed 's/^/D/'
                [ -n "$effective_c_dirs" ] && printf '%s\n' "$effective_c_dirs" | sed 's/^/D/'
                # N: a flag that disables hooks or signing, also from code
                # that is_git_hook_bypass cannot see in the command line.
                for git_arg in "$@"; do
                  case "$git_arg" in
                    3*|0';'|0'&&'|0'||'|0'|') break ;;
                    0--no-verify|0--no-gpg-sign) printf 'N\n' ;;
                  esac
                done
                if [ "$token" = commit ]; then
                  [ "$xargs_wrapped" -eq 1 ] && printf 'I\n'
                  [ "$git_index_changed" -eq 1 ] && printf 'I\n'
                  [ "$git_index_forced" -eq 1 ] && printf 'X\n'
                  stage_records=$(git_commit_stage_records "$@")
                  [ -n "$stage_records" ] && printf '%s\n' "$stage_records"
                fi
                matched=0
                break
                ;;
              # Stages after PreToolUse, like `git commit -a`; the scan cannot
              # tell which paths, so a later commit scans all of them.
              add|stage|rm|mv)
                git_index_changed=1
                case "$token" in
                  add|stage) git_add_is_forced "$@" && git_index_forced=1 ;;
                esac
                break
                ;;
              # It may define an alias a later git command runs.
              config)
                git_config_mutable=1
                break
                ;;
              *)
                git_is_builtin "$token" && break
                # Expand an alias in place, so that the checks above see the
                # git command it runs. Git refuses an alias loop.
                git_alias=$(git_subcommand_alias "$token")
                case "$?" in
                  0)
                    if [ "$git_alias_depth" -lt 10 ]; then
                      git_alias_depth=$((git_alias_depth + 1))
                      IFS='
'
                      # shellcheck disable=SC2086
                      set -- $(git_command_records "$git_alias") "$@"
                      IFS=$old_ifs
                      continue
                    fi
                    ;;
                  1) break ;;
                esac
                printf 'G\nU\n'
                matched=0
                break
                ;;
            esac
          done
          git_env_args=
          git_env_dynamic=0
          command_start=0
          continue
        fi
        # The scan resolves every cd before the command runs, so any earlier
        # command that may create, remove or relink a path leaves a later cd
        # unknown. These cannot; redirections write regular files only.
        case "$record_kind$token" in
          3*|0';'|0'&&'|0'||'|0'|') ;;
          0echo|0printf|0pwd|0ls|0cat|0head|0tail|0wc|0true|0false|0:|0test|0'['|0'[['|0which|0type|0date|0whoami|0id|0uname|0grep|0rg|0sleep|0wait|0jq|0sort|0uniq|0diff|0stat|0basename|0dirname|0realpath|0readlink) ;;
          # Shell state only; `set -P` is caught when the scan resolves `..`.
          0set|0export|0read|0local|0declare|0typeset|0readonly|0shift|0printenv) ;;
          *) shell_cd_mutable=1 ;;
        esac
      fi

      mentions_git_config_env "$token" && git_env_changed=1
      shift
      if [ "$record_kind" = 3 ] || is_shell_command_separator "$token"; then
        # `>&2` and `2>&1` redirect; they do not background anything.
        case "$record_kind$token:$shell_cd_prev" in
          '3&:'*'>'|'3&:'*'<') ;;
          *) shell_cd_boundary "$token" "${1-}" "$command_start" ;;
        esac
        command_start=1
        effective_c_dirs=
        effective_c_dynamic=0
        xargs_wrapped=0
        # An assignment no git command took may stay in the environment.
        [ -z "$git_env_args" ] && [ "$git_env_dynamic" -eq 0 ] || git_env_changed=1
        git_env_args=
        git_env_dynamic=0
        git_config_args=
        git_config_dynamic=0
      else
        command_start=0
      fi
      shell_cd_prev=$token
    done
    return "$matched"
  )
}

is_git_hook_bypass() {
  cmd=$1
  (
    set -f
    words=$(git_command_records "$cmd")
    old_ifs=$IFS
    IFS='
'
    # shellcheck disable=SC2086
    set -- $words
    IFS=$old_ifs

    while [ "$#" -gt 0 ]; do
      token=${1#?}
      shift
      case "$token" in
        --no-verify|--no-gpg-sign) return 0 ;;
      esac
    done
    return 1
  )
}

check_git_command() {
  cmd=$1
  workdir=${2:-}
  git_c_records=$(is_git_commit_or_push "$cmd" "$workdir")
  git_command_status=$?
  if [ "$git_command_status" -eq 0 ]; then
    if is_git_hook_bypass "$cmd" || printf '%s\n' "$git_c_records" | grep -qx N; then
      info "$PROGRAM: blocked git command that disables hooks/signing"
      exit 2
    fi
    if ! command -v git >/dev/null 2>&1; then
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: git is unavailable, so staged changes could not be scanned;"
      return $?
    fi
    # A group with U cannot be scanned. The closed policy blocks the whole
    # command; the open policy still scans every other group.
    if printf '%s\n' "$git_c_records" | grep -qx U; then
      handle_hook_infrastructure_failure PreToolUse "${HOOK_INPUT:-}" \
        "$PROGRAM: a git commit or push may run in a working directory, or with arguments, a git alias or shell code, that could not be resolved safely;"
    fi
    (
      set -f
      git_scan_status=0
      git_group=
      git_in_group=0
      git_ifs=$IFS
      IFS='
'
      # The trailing G flushes the last group.
      # shellcheck disable=SC2086
      for git_c_record in $git_c_records G; do
        if [ "$git_c_record" != G ]; then
          git_group="$git_group$git_c_record
"
          continue
        fi
        case "
$git_group" in
          *'
U
'*) git_in_group=0 ;;
        esac
        if [ "$git_in_group" -eq 1 ]; then
          IFS=$git_ifs
          scan_git_command_group "${workdir:-$(pwd)}" "$git_group"
          git_group_status=$?
          if [ "$git_group_status" -eq 1 ] || [ "$git_scan_status" -eq 0 ]; then
            git_scan_status=$git_group_status
          fi
        fi
        git_in_group=1
        git_group=
      done
      exit "$git_scan_status"
    )
    git_scan_status=$?
    case "$git_c_records" in
      *'
'[WIPX]*) git_scan_message="changes this git commit would stage contain secret-like values; blocking git command" ;;
      *) git_scan_message="staged changes contain secret-like values; blocking git command" ;;
    esac
    block_on_scan_status "$git_scan_status" "$git_scan_message"
  fi
}

# Scan one git commit/push command: apply its D<dir> cwd changes in order, then
# scan the index plus whatever its W/P records say Git will stage itself.
scan_git_command_group() (
  set -f
  CDPATH= cd -- "$1" 2>/dev/null || exit "$SCAN_STATUS_UNAVAILABLE"
  group_stage_all=0
  group_untracked=0
  group_pathspecs=
  group_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  for group_record in $2; do
    case "$group_record" in
      D*)
        # A shell cd resolves `..` logically unless `set -P` is on; git -C and
        # env -C resolve it physically. Refuse to guess when they disagree.
        group_physical=$(CDPATH= cd -P -- "${group_record#D}" 2>/dev/null && pwd -P) \
          || exit "$SCAN_STATUS_UNAVAILABLE"
        CDPATH= cd -- "${group_record#D}" 2>/dev/null || exit "$SCAN_STATUS_UNAVAILABLE"
        [ "$(pwd -P)" = "$group_physical" ] || exit "$SCAN_STATUS_UNAVAILABLE"
        ;;
      W) group_stage_all=1 ;;
      I) group_stage_all=1; [ "$group_untracked" -eq 2 ] || group_untracked=1 ;;
      X) group_stage_all=1; group_untracked=2 ;;
      P*) group_pathspecs="$group_pathspecs${group_record#P}
" ;;
      *) exit "$SCAN_STATUS_UNAVAILABLE" ;;
    esac
  done
  # shellcheck disable=SC2086
  set -- $group_pathspecs
  IFS=$group_ifs
  set +f
  scan_commit_candidate "$group_stage_all" "$group_untracked" "$@"
)

check_bash_command() {
  input=$1
  need_cmd jq
  cmd=$(json_value '.tool_input.command // .tool_input.cmd // empty' "$input")
  [ -n "$cmd" ] || return 0
  # POSIX sh has no locals, so a helper that assigns the bare name `cmd` would
  # overwrite the command mid-function. The deny-path helpers also rejoin tokens
  # with single spaces, which destroys a real newline separator — collapsing
  # `cd X<newline>git commit` into one word and hiding the commit from the
  # detector (#127). Keep an untouched copy and use it for every later check.
  raw_cmd=$cmd
  workdir=$(json_value '.tool_input.workdir // .tool_input.cwd // .cwd // empty' "$input")

  # A harmless, deterministic sentinel lets setup prove that the host really
  # dispatched PreToolUse without naming or touching any sensitive file. Keep
  # this before configurable policy checks so the probe is stable everywhere.
  case "$cmd" in
    *"$LIVE_PRE_TOOL_PROBE"*)
      info "$PROGRAM: blocked the live PreToolUse probe"
      exit 2
      ;;
  esac

  [ -f "$DENY_BASH_PATTERNS" ] || die "deny bash policy not found: $DENY_BASH_PATTERNS"
  patterns=$(mktemp_file) || die "failed to create temp file"
  grep -Ev '^[[:space:]]*(#|$)' "$DENY_BASH_PATTERNS" >"$patterns"
  if [ -s "$patterns" ]; then
    printf '%s\n' "$cmd" | grep -E -q -f "$patterns"
    grep_status=$?
    rm -f "$patterns"
    case "$grep_status" in
      0)
        info "$PROGRAM: blocked risky shell command by deny pattern"
        exit 2
        ;;
      1) ;;
      *)
        # grep failed (e.g., invalid ERE in a custom deny file). Fail closed —
        # silently allowing here would let the rest of the deny list be bypassed.
        info "$PROGRAM: deny-bash-patterns scan failed; refusing to allow command"
        exit 2
        ;;
    esac
  else
    rm -f "$patterns"
  fi

  # Run the deny-path check inside the event workdir. bash_strip_allowed_tokens
  # resolves a template-named token (e.g. a `.env.example` symlink) with realpath
  # to decide whether it points at a deny-listed secret (#132); a relative token
  # resolves against the process cwd, so if the host dispatched the hook from a
  # different directory than the command targets, the resolution — and the
  # symlink check that depends on it — would silently no-op and fall open. cd
  # first, mirroring check_git_command.
  #
  # bash_matches_deny_path returns 0 on a deny match and 1 on none; its internal
  # fail-closed path exits 2, which in this subshell no longer terminates the
  # process, so re-propagate every status but 1 (no-match) as a block. `die` on
  # an inaccessible workdir also surfaces as a non-1 status (fail closed).
  #
  # The subshell's stdout carries only the match report (every helper it calls
  # captures its own output), so it is safe to collect here and replay as a
  # diagnosis. A non-match produces no output.
  deny_report=$(
    [ -n "$workdir" ] && { CDPATH= cd -- "$workdir" 2>/dev/null \
      || die "hook workdir is not accessible: $workdir"; }
    bash_matches_deny_path "$raw_cmd"
  )
  case "$?" in
    0)
      info "$PROGRAM: blocked shell command referencing a deny-listed path"
      info "$PROGRAM: reason=bash_protected_path_text_match; raw Bash command text matched a protected-path pattern and may be a file operand or source/search text; command was not executed"
      [ -n "$deny_report" ] && info "$PROGRAM: $deny_report"
      info "$PROGRAM: if the command reads no protected file, rewrite the matched text so it is not path-shaped and retry; do not weaken the deny list. Examples: jq '.[\"key\"]' instead of jq '.key'; a commit message that omits the path; a structured Grep pattern instead of an inline shell search."
      exit 2
      ;;
    1) ;;
    *) exit 2 ;;
  esac

  scan_text_direct "shell command" "$raw_cmd"
  block_on_scan_status "$?" "shell command contains secret-like values"

  # Path-policy helpers above intentionally dequote their input and use global
  # POSIX-shell variables. raw_cmd preserves the original quoting for git cwd
  # parsing.
  check_git_command "$raw_cmd" "$workdir"
}

scan_tool_input() {
  input=$1
  label=$2
  need_cmd jq
  text=$(printf '%s' "$input" | jq -c '.tool_input // {}')
  scan_text_direct "$label" "$text"
  block_on_scan_status "$?" "$label contains secret-like values"
}

scan_mcp_input() {
  scan_tool_input "$1" "MCP tool input"
}

scan_network_input() {
  input=$1
  check_sensitive_reads "$input"
  scan_tool_input "$input" "network tool input"
}

scan_proposed_write() {
  input=$1
  tool=$2
  need_cmd jq

  case "$tool" in
    Write)
      path=$(json_value '.tool_input.file_path // .tool_input.path // empty' "$input")
      content=$(json_value '.tool_input.content // empty' "$input")
      scan_file_text_direct "proposed Write content" "$path" "$content"
      block_on_scan_status "$?" "proposed Write contains secret-like values"
      ;;
    Edit)
      path=$(json_value '.tool_input.file_path // .tool_input.path // empty' "$input")
      content=$(json_value '.tool_input.new_string // empty' "$input")
      scan_file_fragment_direct "proposed Edit content" "$path" "$content"
      block_on_scan_status "$?" "proposed Edit contains secret-like values"
      ;;
    MultiEdit)
      path=$(json_value '.tool_input.file_path // .tool_input.path // empty' "$input")
      content=$(printf '%s' "$input" | jq -r '[.tool_input.edits[]?.new_string // empty] | join("\n")')
      scan_file_fragment_direct "proposed MultiEdit content" "$path" "$content"
      block_on_scan_status "$?" "proposed MultiEdit contains secret-like values"
      ;;
    NotebookEdit)
      path=$(json_value '.tool_input.notebook_path // .tool_input.file_path // empty' "$input")
      content=$(json_value '.tool_input.new_source // empty' "$input")
      scan_file_fragment_direct "proposed NotebookEdit content" "$path" "$content"
      block_on_scan_status "$?" "proposed NotebookEdit contains secret-like values"
      ;;
    apply_patch)
      patch=$(printf '%s' "$input" | jq -r '
        .tool_input.command // .tool_input.patch // .tool_input.input // .tool_input.diff // .tool_input.content // empty
        | if type == "string" then . else tojson end
      ')
      added=$(printf '%s\n' "$patch" | extract_patch_added_lines)
      scan_text_direct "proposed apply_patch added lines" "$added"
      block_on_scan_status "$?" "proposed apply_patch contains secret-like values"
      ;;
  esac
}

is_broad_search_path() {
  path=${1:-}
  normalized=$(normalize_path "$path")
  case "$normalized" in
    ''|'.'|'./'|'/') return 0 ;;
  esac
  cwd=$(pwd -P 2>/dev/null || pwd)
  [ "$normalized" = "$cwd" ] && return 0
  return 1
}

is_broad_grep_glob() {
  case "${1:-}" in
    ''|'*'|'**'|'**/*'|'./**/*'|'*.*') return 0 ;;
    *) return 1 ;;
  esac
}

is_secret_search_pattern() {
  pattern=$1
  case "$pattern" in
    ''|'.*'|'.+'|'^.*$'|'[[:print:]]*'|'[\\s\\S]*') return 0 ;;
  esac
  printf '%s\n' "$pattern" \
    | grep -Eiq '(secret|token|password|passwd|credential|api[^[:alnum:]]*key|access[^[:alnum:]]*key|private[^[:alnum:]]*key|authorization|bearer|aws|openai|anthropic|stripe|github|ghp_|sk-)'
}

check_broad_grep_content() {
  input=$1
  output_mode=$(json_value '.tool_input.output_mode // empty' "$input")
  [ "$output_mode" = "content" ] || return 0

  path=$(json_value '.tool_input.path // empty' "$input")
  glob=$(json_value '.tool_input.glob // empty' "$input")
  pattern=$(json_value '.tool_input.pattern // empty' "$input")

  is_broad_search_path "$path" || return 0
  is_broad_grep_glob "$glob" || return 0
  if is_secret_search_pattern "$pattern"; then
    info "$PROGRAM: blocked broad Grep content search that could expose secrets"
    exit 2
  fi
}

hook_pre_tool() {
  input=$(read_stdin)
  HOOK_EVENT=PreToolUse
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    validate_hook_object PreToolUse "$input" || return 0
  fi
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning PreToolUse "$input"
    return 0
  fi
  need_cmd jq
  [ -n "$input" ] || return 0

  # A host may serialize tool_input as a JSON-encoded string instead of an
  # object. When that string decodes to an *object*, the precise-field extractors
  # (.tool_input.command / .content / .file_path) would otherwise error on a
  # string and yield nothing, so the Bash/Write checks silently no-op
  # (fail-open). Decode it back into an object so those checks see real fields.
  #
  # Only an object is substituted. A string that does NOT decode to an object
  # (plain text, or JSON that decodes to an array/scalar) is left UNCHANGED: the
  # generic scanners for Read/Grep/WebFetch/WebSearch/MCP use
  # `.tool_input // {} | .. | strings`, which already inspects a raw string leaf.
  # Coercing such input to {} would drop that leaf and let a bare secret string
  # (e.g. an mcp__* tool_input of "AGENT_GUARD_TEST_SECRET") through — a
  # regression. Recover-not-block keeps a string-encoding host from being
  # over-blocked.
  if [ "$(json_value '.tool_input | type' "$input")" = "string" ]; then
    input=$(printf '%s' "$input" \
      | jq -c '(.tool_input | try fromjson catch null) as $decoded
               | if ($decoded | type) == "object" then .tool_input = $decoded else . end')
  fi

  tool=$(json_value '.tool_name // .tool // .name // empty' "$input")

  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit|apply_patch)
      scan_proposed_write "$input" "$tool"
      ;;
    Read|NotebookRead|Grep|Glob)
      check_sensitive_reads "$input" "$tool"
      if [ "$tool" = "Grep" ]; then
        check_broad_grep_content "$input"
      fi
      ;;
    Bash)
      check_bash_command "$input"
      ;;
    WebFetch|WebSearch)
      scan_network_input "$input"
      ;;
    Agent|Task)
      # Delegation is a trust boundary too: the task prompt leaves the parent
      # context and the returned result re-enters it. `Agent` is the current
      # tool name on Claude and Codex; `Task` keeps coverage for older Claude
      # releases that still emit the legacy alias.
      scan_tool_input "$input" "subagent delegation input"
      ;;
    mcp__*)
      scan_mcp_input "$input"
      ;;
  esac

  check_pii_hook_input "$input" "$tool"
}

is_mutation_tool() {
  case "$1" in
    Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash|mcp__*) return 0 ;;
    *) return 1 ;;
  esac
}

# --- Tool-output secret redaction (PostToolUse) ------------------------------
# The pre-tool checks only ever see a command string or a file path; they never
# see what a command PRINTS or what a file read RETURNS. A shell command that
# dumps credentials to stdout (an env-printing CLI, `cat` of a secret-bearing
# note) therefore leaks the secret into the model context unscanned. PostToolUse
# can replace an already-produced result before the model sees it. Claude uses
# `hookSpecificOutput.updatedToolOutput`; Codex blocks the original result and
# receives a sanitized replacement in `additionalContext`.
#
# Fail-safe: this path runs for (potentially) every tool result, so any error
# emits NOTHING and lets the original output through unchanged. A redaction bug
# must never corrupt a tool result.

output_redact_enabled() {
  case "${AGENT_GUARD_OUTPUT_REDACT:-mask}" in
    off|'') return 1 ;;
    *) return 0 ;;
  esac
}

# One jq tree-walk definition shared by every response rewriter below (it also
# keeps jq 1.5, which lacks the walk builtin, working). Prepend as
# `jq -c "$JQ_WALK"'<program>'`.
JQ_WALK='def walk(f): def w: if type == "object" then map_values(w)
                    elif type == "array" then map(w)
                    else . end | f; w;
'

# Key-aware companion to the walk above, for the redactors that rewrite a
# tool_response the host feeds straight back into the conversation as
# `updatedToolOutput`. Anthropic content blocks are a discriminated union: the
# `type`, `source.type` and `media_type` strings select which block shape the
# API expects. Masking one produces a block tagged `[REDACTED]`, every later
# request is rejected with `Input tag '[REDACTED]' ... does not match any of
# the expected tags`, and because the host persists the rewritten block in the
# session transcript the failure is permanent — a retry replays it. So the leaf
# filter is skipped for a discriminator, but ONLY when the value is exactly one
# of the protocol tokens below. Allowlisting whole values rather than key names
# is what keeps this from becoming a hole: no secret is equal to `image/png`,
# so nothing that needs masking can reach the skip, and a `type` carrying
# anything else is still replaced. The tokens are one flat list instead of one
# set per key because hosts are not consistent about which key carries which
# token — Claude Code's Read returns `{"type":"image","file":{"type":
# "image/png",...}}`, a media type under a plain `type`, and tags a PDF read
# `{"type":"pdf","file":{"base64":...}}` with no media type at all. MCP's own
# image block spells the same thing `mimeType`. Prepend as
# `jq -c "$JQ_SHAPE_SAFE_WALK"'<program>'`.
JQ_SHAPE_SAFE_WALK='def protocol_discriminator($key): . as $v
    | ($key == "type" or $key == "media_type" or $key == "mimeType"
       or $key == "encoding")
      and (["text","image","document","search_result","browser_state",
            "tool_reference","tool_use","tool_result","thinking",
            "redacted_thinking","base64","url","file","content","pdf",
            "image/png","image/jpeg","image/gif","image/webp",
            "application/pdf","text/plain"]
           | map(. == $v) | any);
def shape_safe_walk(f): def w($key):
      if type == "object"
      then with_entries(. as $e | .value = ($e.value | w($e.key)))
      elif type == "array" then map(w(null))
      elif type == "string" and protocol_discriminator($key) then .
      else f
      end;
    w(null);
def binary_media_type: . as $v
    | (["image/png","image/jpeg","image/gif","image/webp","application/pdf"]
       | map(. == $v) | any);
def binary_block:
      type == "object"
      and (((.type == "image" or .type == "document")
            and (.source | type) == "object"
            and .source.type == "base64"
            and (.source.data | type) == "string"
            and (.source.media_type | binary_media_type))
           or (.type == "image"
               and (.file | type) == "object"
               and (.file.base64 | type) == "string"
               and (.file.type | binary_media_type))
           or (.type == "pdf"
               and (.file | type) == "object"
               and (.file.base64 | type) == "string")
           or (.type == "image"
               and (.data | type) == "string"
               and (.mimeType | binary_media_type)));
def binary_payload_path:
      if has("source") then ["source", "data"]
      elif has("file") then ["file", "base64"]
      else ["data"]
      end;
def binary_payload_paths: . as $root
    | [[], paths]
    | map(select(. as $p | $root | getpath($p) | binary_block))
    | map(. as $p | $p + ($root | getpath($p) | binary_payload_path));
def strip_binary_payloads:
      reduce binary_payload_paths[] as $p (.; setpath($p; ""));
def restore_binary_payloads($orig):
      reduce ($orig | binary_payload_paths[]) as $p
        (.; setpath($p; $orig | getpath($p)));
'

# Recall booster for the most common leak shape: `KEY=value`, `export KEY=value`
# or `KEY: value` dumps whose key name looks secret-bearing. gitleaks misses most
# of these (custom value formats), so emit the VALUE for literal redaction.
frame_json_string_leaves() {
  jq -rj '
    .. | strings
    | ((gsub("\u001f"; "\u001f\u001f") | gsub("\u001e"; "\u001f\u001e"))
       + "\u001e\n")
  '
}

# Frame one raw plaintext leaf without decoding it as UTF-8. This gives exec's
# byte-oriented assignment pass the same collision-safe transport used for JSON
# leaves while preserving invalid bytes inside a credential value.
frame_plaintext_leaf() {
  LC_ALL=C awk '
    function emit_char(ch) {
      if (ch == escape) printf "%s%s", escape, escape
      else if (ch == boundary) printf "%s%s", escape, boundary
      else printf "%s", ch
    }
    BEGIN {
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
    }
    NR > 1 { emit_char("\n") }
    {
      for (i = 1; i <= length($0); i++) emit_char(substr($0, i, 1))
    }
    END { printf "%s", boundary }
  '
}

# Read an RS-delimited, US-escaped leaf stream. Each leaf gets independent
# multiline quote state. Emits JSON-string records by default, or raw framed
# secret records for exec's byte-preserving plaintext pass. Probe modes exit on
# the first non-sanitized assignment key; framed probe mode also fast-paths the
# common escape-free leaf so large clean JSON strings remain linear.
secretish_env_values() {
  record_mode=${1:-json}
  LC_ALL=C awk -v record_mode="$record_mode" '
    BEGIN {
      core = "password|passwd|passphrase|db[_-]?pass(word)?|secret|secret[_-]?key|token|refresh[_-]?token|auth[_-]?token|session[_-]?key|api[_-]?key|access[_-]?key|private[_-]?key|signing[_-]?key|encryption[_-]?key|credential|client[_-]?secret|bearer|webhook"
      # Match assignment keys whose secret-bearing term is terminal or carries
      # only a bounded qualifier suffix (AWS_ACCESS_KEY_ID, API_KEY_VALUE,
      # DB_PASSWORD_HASH). An unbounded suffix over-masked metadata keys such
      # as password_policy or token_name; no suffix at all dropped these very
      # common real-credential names. Bare PATH/PWD remain excluded; compound
      # _pat/_pwd keys keep their intended coverage.
      qualifier = "([_-](id|ids|value|val|hash|b64|base64|hex|enc|encrypted|encoded|raw|str|string|pem|cert|json|prod|production|dev|development|staging|stage|test|local|old|new|current|primary|secondary|backup|main|default|[0-9]+))*"
      key = "[a-z0-9_.-]*(" core "|[_-](pat|pwd))" qualifier
      # `(` and `[` open an argument or subscript list, so an assignment can
      # begin immediately after one (`wrap(secret_key=<secret>)`). `:` is here
      # for the serialized-log leaf a tool returns as JSON: in a
      # `{"log":"KEY=<value>"}` shape the only thing between the structure and
      # the key is `:`, so without it the whole class went unmatched (#178).
      # It must sit away from `[` in the class — `[:` opens a POSIX character
      # class and makes the whole regex invalid. The value gate
      # below stops treating a whole call expression as a single literal, so a
      # nested assignment has to be reachable on its own to stay masked.
      #
      # `\r` is a delimiter for the same reason it is edge whitespace on the
      # value side: a carriage return separates fields on screen but is not
      # part of either. Without it a CR before the key hid the assignment
      # completely — a curl or pip progress meter, a spinner, or classic-Mac
      # line endings all put one there, and `<meter>\rAPI_KEY=<secret>` leaked
      # in full and did not block at the prompt guard.
      equals_assignment = "(^|[ \t\r,:{;([])[\"'\''`]?" key "[\"'\''`]?[ \t]*="
      # A colon is ambiguous in prose. Accept it at the start of a YAML field,
      # after a JSON/map/argument delimiter, or after plain whitespace (log lines
      # such as `10:00:00 password: hunter2`); the loop below rejects the
      # whitespace form only when the preceding token is a known status word,
      # which marks a prose chain like `error: password: authentication is
      # disabled`.
      colon_assignment = "(^[ \t\r]*|[,{([][ \t\r]*|[ \t\r]+)[\"'\''`]?" key "[\"'\''`]?[ \t]*:"
      # Skipping after ANY colon-terminated token also let real structured log
      # lines through unmasked (`response: api_key: <secret>`), so only these
      # status words justify the skip. Deliberately short: an unlisted label
      # falls through to masking, and a false-positive mask of prose is far
      # cheaper than a displayed secret. Require the status word to stand alone
      # at line start or after whitespace; punctuation-bound suffixes such as
      # `response.error:` / `response/error:` are structured labels and must
      # not suppress masking. Matched against the lowercased line, so `Error:` /
      # `ERROR:` are covered too, including after a timestamp/log prefix.
      status_label = "(^|[ \t\r])(error|warning|info|note|debug|fatal|hint)[ \t]*:$"
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
    }
    function quoted_end(raw, quote, i, slash_count, ch) {
      slash_count = 0
      for (i = 1; i <= length(raw); i++) {
        ch = substr(raw, i, 1)
        if (ch == "\\") {
          slash_count++
          continue
        }
        if (ch == quote && slash_count % 2 == 0) return i
        slash_count = 0
      }
      return 0
    }
    function json_escape(value, i, ch, replacement) {
      gsub(/\\/, "\\\\", value)
      gsub(/"/, "\\\"", value)
      for (i = 1; i < 32; i++) {
        ch = sprintf("%c", i)
        replacement = sprintf("\\u%04x", i)
        gsub(ch, replacement, value)
      }
      return value
    }
    function emit_framed(value, tag, i, ch) {
      printf "%s", tag
      for (i = 1; i <= length(value); i++) {
        ch = substr(value, i, 1)
        if (ch == escape) printf "%s%s", escape, escape
        else if (ch == boundary) printf "%s%s", escape, boundary
        else printf "%s", ch
      }
      printf "%s", boundary
    }
    function already_redacted(value, marker, tail, i, ch) {
      marker = "[REDACTED]"
      if (substr(value, 1, length(marker)) != marker) return 0
      tail = substr(value, length(marker) + 1)
      for (i = 1; i <= length(tail); i++) {
        ch = substr(tail, i, 1)
        if (ch != "}" && ch != "]" && ch != ")") return 0
      }
      return 1
    }
    # scan_line deliberately re-scans inside a quoted value after emit_secret
    # records that wider literal. A short inner assignment can then produce a
    # contextual mapping whose value span is the SAME occurrence already
    # covered by the outer secret. Applying it first strands the inner key
    # prefix. Suppress only that scanner occurrence; an identical short value
    # elsewhere still needs its own contextual mapping and must remain emitted.
    function emit_mapping(literal, replacement, value_start, value_length) {
      if (record_mode == "probe" || record_mode == "probe_raw") {
        if (!probe_found) print "x"
        probe_found = 1
      } else if (rescan_cover_end > 0 \
                 && value_start >= rescan_cover_start \
                 && value_start + value_length - 1 <= rescan_cover_end) {
        return
      } else if (record_mode == "framed") {
        emit_framed(literal, "L")
        emit_framed(replacement, "R")
      } else {
        print "{\"literal\":\"" json_escape(literal) \
          "\",\"replacement\":\"" json_escape(replacement) \
          "\",\"contextual\":true}"
      }
    }
    # A multiline capture keeps the newline that separated the label from the
    # value, so the global literal is `<newline><secret>` and a BARE recurrence
    # of the credential later in the output does not match it. Emit the trimmed
    # token as a second record so global masking still reaches those.
    # A guarded capture that fails the shape test must not be DISCARDED: it has
    # absorbed every following line of the leaf, and throwing that away drops
    # the assignments inside it. A status label whose value opens a quote that
    # never closes — an apostrophe in ordinary prose is enough — made every real
    # assignment on the lines below it stop masking, and stopped the prompt
    # guard blocking the same text. 818f540 reached those lines because the
    # status label took an unconditional skip; the deferral has to reach them
    # too, so re-scan what was absorbed as ordinary input.
    #
    # guard_rescan makes that single-pass: during a re-scan the status path
    # falls back to the old skip instead of opening another capture, so this
    # cannot nest or loop.
    function guard_rescan_leaf(v) {
      open_quote = ""
      open_value = ""
      open_guard = 0
      if (guard_rescan) return
      guard_rescan = 1
      scan_leaf(v)
      guard_rescan = 0
    }
    # `\r` counts as edge whitespace: scan_leaf splits on `\n` and keeps the
    # preceding `\r`, so CRLF output left a carriage return glued to the value.
    # The capture then recorded `\r\n<secret>` as its literal and a bare
    # recurrence of the credential further down matched nothing.
    function edge_trim(v) {
      sub(/^[ \t\r\n]+/, "", v)
      sub(/[ \t\r\n]+$/, "", v)
      return v
    }
    # Keep the assignment heuristic aligned with the narrow, human-readable
    # documentation placeholders in gitleaks.toml. Match the complete trimmed
    # value only: decorated values and secrets that merely contain one of these
    # words must retain independent protection from the heuristic.
    function obvious_word_placeholder(value, v) {
      v = tolower(edge_trim(value))
      return v ~ /^(example|dummy)[_-]?(token|key|secret|password)$/ \
          || v ~ /^not[-_ ]?a[-_ ]?real[-_ ]?(token|key|secret|password)$/
    }
    function emit_captured(v, trimmed) {
      emit_secret(v)
      trimmed = edge_trim(v)
      if (trimmed != v) emit_secret(trimmed)
    }
    function emit_secret(value, eligible_length) {
      if (already_redacted(value)) return
      if (obvious_word_placeholder(value)) return
      if (eligible_length == 0) eligible_length = length(value)
      if (eligible_length < 4 || length(value) == 0) return
      if (record_mode == "probe" || record_mode == "probe_raw") {
        if (!probe_found) print "x"
        probe_found = 1
        return
      }
      if (record_mode == "framed") emit_framed(value, "S")
      else print "\"" json_escape(value) "\""
    }
    # A credential-shaped KEY only tells us the assignment is interesting; it
    # says nothing about whether the right-hand side IS a credential. Source that
    # merely READS one (`process.env.API_KEY`, `os.environ["DB_PASSWORD"]`,
    # `config.apiKey`, `${API_KEY:?required}`) is a reference, so masking it
    # hides nothing and destroys ordinary code. Decide from the token SHAPE, not
    # from a list of known accessor spellings: an unfamiliar accessor is still
    # rejected, and an unfamiliar credential format is still masked.
    #
    # Only applies to the bare/unquoted branch. A quoted value is already a
    # literal, and trailing closers are stripped before this test so a value
    # such as `abc)evil` is still treated as a value.
    #
    # Tradeoff: an unquoted credential that itself contains an opener or an
    # embedded quote is no longer masked by this heuristic. gitleaks still
    # covers every format it knows, and the block/detect path is unaffected.
    # Where the uppercase sits separates an accessor from a passphrase that
    # happens to be dot-separated. An accessor reads a value OUT of lowercase
    # roots (`process.env`, `config`, `cfg`), so only its LEAF carries case; a
    # passphrase capitalizes whole words anywhere in the chain. Past two
    # segments a real chain ends in a constant or property — SCREAMING_SNAKE,
    # camelCase, or underscore-bearing — never a plain Capitalized word, which
    # is what separates `my.secret.Phrase` from `process.env.API_KEY`.
    #
    # Residual: a two-segment `head.Word` (`my.Secret`) is the same shape as the
    # Go/C# exported-field access it mimics (`cfg.Token`), so it still reads as
    # a reference. Narrowing that too would re-break the source code #169 is
    # about; gitleaks still covers every format it knows either way.
    function accessor_chain(v, parts, n, i, leaf) {
      n = split(v, parts, ".")
      for (i = 1; i < n; i++)
        if (parts[i] ~ /[A-Z]/) return 0
      leaf = parts[n]
      if (n > 2 && leaf !~ /_/ && leaf !~ /^[A-Z$]+$/ \
          && leaf !~ /^[a-z_$][A-Za-z_$]*[A-Z]/)
        return 0
      return 1
    }
    function looks_like_reference(value, assignment, leading, v, ch) {
      # An opener or an embedded quote: call, index, expansion or nested string.
      # An opener only counts past the first character, because a call, an index
      # and an expansion always follow the thing they apply to; a token that
      # BEGINS with a bracket (`[REDACTED]]evil`) is not a reference, so it stays
      # maskable. `$` alone is deliberately allowed so bcrypt-style `$2b$12$...`
      # values stay masked; `${...}` is caught by the brace.
      if (index(value, "(") > 1 || index(value, "[") > 1 \
          || index(value, "{") > 1 || index(value, "\"") \
          || index(value, "'\''") || index(value, "`"))
        return 1
      # A trailing `:` (a def/lambda suite ending the line) blocked the outer
      # closer strip, so `DEFAULT_PASSWORD):` still carries its closers here.
      # Normalize a local copy for classification only; masking, when it does
      # happen, still replaces the original extent.
      v = value
      sub(/:+$/, "", v)
      while (length(v) > 0) {
        ch = substr(v, length(v), 1)
        if (ch != "}" && ch != "]" && ch != ")") break
        v = substr(v, 1, length(v) - 1)
      }
      # Inside an argument or subscript list (`make(api_key=DEFAULT_API_KEY)`,
      # `def connect(password=None):`) a bare digit-free identifier or
      # identifier chain is a default or reference, not a literal. A digit
      # pushes the token back toward masking: real identifiers named as
      # defaults rarely carry digits, credential fragments usually do.
      ch = substr(assignment, 1, 1)
      if ((ch == "(" || ch == "[") && v ~ /^[A-Za-z_$]+(\.[A-Za-z_$]+)*$/)
        return 1
      # Dotted identifier chain (`process.env.API_KEY`, `config.apiKey`), and
      # only in a code-shaped assignment: whitespace on both sides of `=`, a
      # lowercase head segment (accessor roots are lowercase in the languages
      # this bug mangled), no digit in any segment, and at least one uppercase
      # character somewhere in the chain. Anything short of all four masks, so
      # dot-separated passphrases (`correct.horse.battery.staple`), dotted
      # env/YAML/INI values (`PASSWORD=a.b.c`, `password: a.b.c`) and dotted
      # version- or token-shaped values (`v1.0.x`) keep masking. Those four
      # still admit a capitalized passphrase (`my.Secret.phrase`), so where the
      # uppercase SITS has to decide as well; see accessor_chain.
      if (!(assignment ~ /[ \t]=$/ && leading != "" && v ~ /[A-Z]/ \
            && v ~ /^[a-z_$]+(\.[A-Za-z_$]+)+$/))
        return 0
      return accessor_chain(v)
    }
    # Value-side gate for the status-label colon path (#156). A status label on
    # its own cannot separate `error: password: authentication is disabled`
    # (prose, must not mask) from `error: password: hunter2-long-value`
    # (assignment, must mask): the label is identical in both, so the VALUE has
    # to decide. Mask only a token whose shape reads as a credential; an
    # ordinary word, path, number or timestamp stays visible, which is what
    # keeps the #145/#153 prose assertions green.
    #
    # Deliberately shape-based rather than a dictionary: an unfamiliar prose
    # word is still preserved and an unfamiliar credential format is still
    # masked. Residual: an all-lowercase alphabetic secret below the compound
    # threshold is indistinguishable from a prose word on this path and stays
    # visible. gitleaks still covers every format it knows regardless of the
    # label, and the block/detect path is unaffected either way.
    function credential_shaped(v) {
      if (length(v) < 6) return 0
      # A credential is a single token. The unquoted branch has already cut at
      # whitespace, so this only bites on a QUOTED value — where a multi-word
      # string behind a status label is a message, not a secret. Without it
      # `error: password: "must be at least 8 characters"` masks, because the
      # class tests below would find a letter and a digit somewhere in the
      # sentence and never ask whether they were part of the same token.
      if (v ~ /[ \t]/) return 0
      # Dates, timestamps and clock times are the ordinary log values that would
      # otherwise satisfy the mixed-class tests. Anchored at BOTH ends: a date
      # only tells us this value is a date when the value is nothing else, and a
      # prefix match let `2026-08-30-A1b2C3d4-token` through unmasked.
      if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
      if (v ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][T][0-9][0-9]:[0-9][0-9](:[0-9][0-9])?([.][0-9]+)?(Z|[+-][0-9][0-9]:?[0-9][0-9])?$/) return 0
      if (v ~ /^[0-9]+:[0-9]+(:[0-9]+)?$/) return 0
      # Mixed character classes. The digit test requires the digit and the
      # letter to be ADJACENT: `hunter2-long-value` is a credential, `least 8
      # characters` and `expires in 3600 seconds` are prose that merely contain
      # both. An uppercase run must start past the first character, since a
      # leading capital alone is ordinary sentence case (`Authentication`).
      if (v ~ /[0-9][A-Za-z]/ || v ~ /[A-Za-z][0-9]/) return 1
      if (v ~ /[a-z]/ && substr(v, 2) ~ /[A-Z]/) return 1
      # A single-case alphabetic run longer than any ordinary word, joined by
      # `.`/`-`/`_` or not. Requiring a PURELY alphabetic value let a
      # delimiter-separated passphrase (`correct-horse-battery-staple`) through,
      # although it is far less prose-like than the bare-word residual below it.
      if (length(v) >= 24 && v ~ /^[A-Za-z]+([._-][A-Za-z]+)*$/) return 1
      return 0
    }
    function emit_value(source, start, assignment, require_credential, \
                        raw, leading, quote, end, \
                        value, token, trailing, ch) {
      next_rescan_cover_start = 0
      next_rescan_cover_end = 0
      raw = substr(source, start)
      match(raw, /^[ \t]*/)
      leading = substr(raw, 1, RLENGTH)
      sub(/^[ \t]+/, "", raw)
      quote = substr(raw, 1, 1)
      if (quote == "\"" || quote == "'\''" || quote == "`") {
        raw = substr(raw, 2)
        end = quoted_end(raw, quote)
        if (end == 0) {
          # Truncated or malformed output after an opening quote. Open the
          # multiline capture like every other path and DEFER the shape
          # decision to the close (or leaf end), carrying open_guard so the
          # status-label rule still applies there. Classifying the fragment
          # available on THIS line instead missed a value whose text begins on
          # the NEXT one — a status label, its key, an opening quote, then a
          # newline before the credential. There the fragment is empty, so it
          # failed the shape test, the capture never opened, and the
          # continuation line has no assignment key of its own to match.
          # Inside a re-scan the status path takes the pre-deferral skip, which
          # is what stops this from re-opening the capture it just failed.
          if (require_credential && guard_rescan) return 0
          open_quote = quote
          open_value = raw
          open_guard = require_credential
          return 1
        }
        value = substr(raw, 1, end - 1)
        # Classify an edge-trimmed copy, replace the original. A quoted value
        # with padding (`" <secret>"`) failed the whitespace-is-prose test on
        # its padding alone, on this single-line path as well as the multiline
        # one. Internal whitespace is untouched, so prose still reads as prose.
        if (require_credential && !credential_shaped(edge_trim(value))) return 0
      } else {
        value = raw
        sub(/[ \t,;].*$/, "", value)
        if (already_redacted(value)) return 0
        token = value
        end = length(value)
        strip_quote = 0
        while (end > 0) {
          # Re-test after every strip, because the strip can walk INTO the
          # redaction sentinel. `password=[REDACTED]"}` loses `}` and then the
          # quote, and the next closer taken is the `]` that belongs to the
          # marker itself. The pre-loop test passed (the tail held a quote),
          # and after that
          # `[REDACTED` no longer matches, so the fragment is re-emitted as a
          # secret and a stray `]` appended. That compounds on every pass
          # (`[REDACTED]]`, `[REDACTED]]]`) and makes the prompt guard BLOCK
          # text agent-guard itself redacted.
          if (already_redacted(substr(value, 1, end))) return 0
          ch = substr(value, end, 1)
          # `\r` is edge whitespace, not value: scan_leaf splits on `\n` and
          # keeps the preceding carriage return, so on CRLF output the token is
          # `…"}\r` and this loop stopped on the CR before it could reach the
          # quote or the closers — leaving the exact shape #178 is about
          # unmasked on Windows, PowerShell, Docker and CI logs. Stripping it
          # keeps the replacement extent at the value: the CR stays in the text.
          if (ch == "\r") { end--; continue }
          if (ch == "}" || ch == "]" || ch == ")") { end--; continue }
          # One trailing quote closes the string the assignment SITS INSIDE; it
          # is not part of the value. A tool returning a serialized log leaf
          # puts the JSON string terminator right after the credential, and
          # leaving it attached made the token carry a quote, which
          # looks_like_reference() reads as a nested string — so the whole class
          # went unmasked (#178). Exactly one, only at the very end, so an
          # interior quote still marks a reference and the accessor forms in
          # the #169 assertions stay preserved.
          #
          # A line-start quoted assignment needs the same strip. The re-scan of
          # an outer quoted value can then rediscover a narrower short token;
          # emit_mapping suppresses that record only when an already-emitted
          # secret literal covers its exact value span (#180).
          if (strip_quote == 0 \
              && (ch == "\"" || ch == "'\''" || ch == "`")) {
            strip_quote = 1
            end--
            continue
          }
          break
        }
        value = substr(value, 1, end)
        if (looks_like_reference(value, assignment, leading)) return 0
        if (require_credential && !credential_shaped(edge_trim(value))) return 0
        # Eligibility is based on the complete token. For short values, scope
        # replacement to the complete assignment token so an ordinary
        # one-character literal is not replaced throughout the response.
        #
        # The status-label path deliberately does NOT scope: a value that has
        # passed credential_shaped is masked globally, exactly like one found
        # behind any other label. Scoping it left a recurrence visible —
        # `error: password: <secret>` followed by `retrying with <secret>`
        # masked only the labelled line. The false positives that scoping would
        # contain (a version string or a resource name scrubbed from a later
        # line) are not specific to this path: `response: token: v1.2.3` already
        # scrubs every v1.2.3 in the response on main. Consistency with the
        # other paths is worth more here than containing a bad guess, because a
        # displayed secret costs more than a mangled log line.
        if (length(value) < 4 && length(token) >= 4) {
          trailing = substr(token, end + 1)
          emit_mapping(assignment leading token,
                       assignment leading "[REDACTED]" trailing,
                       start + length(leading),
                       length(value))
          return 0
        }
        emit_secret(value, length(token))
        return 0
      }
      # emit_captured, not emit_secret: a padded quoted value (`" <secret> "`)
      # is classified on its trimmed copy just above, so recording only the
      # padded literal left a bare recurrence of the same credential further
      # down unmasked. Record both forms, exactly as the multiline close does.
      emit_captured(value)
      # Coordinates are relative to this scan_line source. Once scan_line
      # advances past the assignment delimiter it translates them to the new
      # `rest`, allowing only mappings from this exact emitted value occurrence
      # to be suppressed. Mixed quotes elsewhere in the span stay scannable.
      next_rescan_cover_start = start + length(leading) + 1
      next_rescan_cover_end = start + length(leading) + length(value)
      return 0
    }
    function scan_line(line, rest, end, low, eq_start, eq_length, \
                       colon_start, colon_length, start, matched_length, \
                       chose_colon, skip, status_guard, first, expansion, \
                       closed_value, key_opener, advance) {
      rest = line
      rescan_cover_start = 0
      rescan_cover_end = 0
      if (open_quote != "") {
        end = quoted_end(rest, open_quote)
        if (end == 0) {
          open_value = open_value "\n" rest
          return
        }
        closed_value = open_value "\n" substr(rest, 1, end - 1)
        # Classify the EDGE-trimmed capture: an indented continuation line
        # carries leading spaces into closed_value, and the whitespace test
        # would reject the credential before emit_captured could trim it.
        # Internal whitespace is untouched, so it still marks prose.
        if (!open_guard || credential_shaped(edge_trim(closed_value))) {
          emit_captured(closed_value)
          open_quote = ""
          open_value = ""
          open_guard = 0
          rest = substr(rest, end + 1)
        } else {
          # The capture scans forward for ANY matching quote, so the one it
          # closed on often belongs to something else entirely — typically the
          # OPENING quote of a credential further down. Re-scanning only what
          # was absorbed then leaves that credential stranded on the far side
          # of a quote the capture ate, with its key consumed too, so nothing
          # masks it. Hand the re-scan the absorbed text AND the rest of this
          # line starting at that quote, which reconstructs the original text
          # exactly, and consume the line here.
          guard_rescan_leaf(closed_value substr(rest, end))
          rest = ""
        }
      }
      while (length(rest) > 0) {
        low = tolower(rest)
        match(low, equals_assignment)
        eq_start = RSTART
        eq_length = RLENGTH
        match(low, colon_assignment)
        colon_start = RSTART
        colon_length = RLENGTH

        start = eq_start
        matched_length = eq_length
        chose_colon = 0
        if (colon_start > 0 && (start == 0 || colon_start < start)) {
          start = colon_start
          matched_length = colon_length
          chose_colon = 1
        }
        if (start == 0) break

        # Whitespace-prefixed colon form: if the text before the whitespace run
        # is a known status label, this MAY be a prose chain (`error: password:
        # authentication is disabled`) rather than an assignment. The label
        # cannot settle it on its own, so hand the decision to the value-side
        # gate in emit_value instead of skipping outright (#156) — prose stays
        # visible, a credential-shaped value still masks. Any other
        # colon-terminated label (`response:`) is treated as structured output.
        # This also covers the chained shape (`response: error: api_key: ...`),
        # whose innermost label is a status word: the value decides there too.
        skip = 0
        status_guard = 0
        first = substr(rest, start, 1)
        # `:` joined the equals delimiter class only for a serialized string
        # leaf (`{"log":"API_KEY=<secret>"}`), where it is immediately followed
        # by the quote that opens the leaf. Without requiring that quote, valid
        # compact source such as the JavaScript labelled statement
        # `label:API_KEY=config.apiKey;` becomes newly reachable and the shared
        # prompt guard blocks it. Preserve the pre-widening behavior for an
        # unquoted key after a colon while keeping the quoted JSON form.
        if (!chose_colon && first == ":") {
          key_opener = substr(rest, start + 1, 1)
          if (key_opener != "\"" && key_opener != "'\''" && key_opener != "`")
            skip = 1
        }
        if (chose_colon && start > 1) {
          # `\r` belongs with space and tab here, or the guard misses the shape
          # the delimiter widening just made reachable: with a carriage return
          # between the label and the key (`error:\rpassword: <prose>`) the
          # colon assignment now matches AT the CR, this test saw a character
          # that was not space or tab, the status label went unrecognised, and
          # the prose chain the allowlist exists to protect was masked.
          if ((first == " " || first == "\t" || first == "\r") &&
              match(substr(low, 1, start - 1), status_label))
            status_guard = 1
          # `${NAME:-default}` / `${NAME:?message}` / `${NAME:=x}` / `${NAME:+x}`
          # is a shell parameter expansion, not an assignment: the operator makes
          # the trailing text a fallback, never the value of the variable. The
          # value gate above rejects the whole `${...}` token; without this
          # the inner `{NAME:` would still read as a JSON/map assignment.
          # Requiring the operator keeps `${password: value}` masked.
          else if (first == "{" && substr(rest, start - 1, 1) == "$") {
            expansion = substr(rest, start + matched_length, 1)
            if (expansion == "-" || expansion == "=" \
                || expansion == "?" || expansion == "+")
              skip = 1
          }
        }

        # Emit exactly the quoted value or the next unquoted token. Continuing
        # after the delimiter finds multiple assignments on one log line while
        # leaving adjacent status text untouched.
        next_rescan_cover_start = 0
        next_rescan_cover_end = 0
        if (!skip &&
            emit_value(rest, start + matched_length,
                       substr(rest, start, matched_length), status_guard)) break
        advance = start + matched_length - 1
        if (next_rescan_cover_end > 0) {
          rescan_cover_start = next_rescan_cover_start - advance
          rescan_cover_end = next_rescan_cover_end - advance
        } else if (rescan_cover_end > 0) {
          rescan_cover_start -= advance
          rescan_cover_end -= advance
          if (rescan_cover_end < 1) {
            rescan_cover_start = 0
            rescan_cover_end = 0
          }
        }
        rest = substr(rest, advance + 1)
      }
    }
    function scan_leaf(value, newline, line) {
      open_quote = ""
      open_value = ""
      open_guard = 0
      while ((newline = index(value, "\n")) > 0) {
        line = substr(value, 1, newline - 1)
        value = substr(value, newline + 1)
        scan_line(line)
      }
      scan_line(value)
      # Truncated output can omit a closing quote. Redact the leaf remainder.
      if (open_quote != "") {
        if (!open_guard || credential_shaped(edge_trim(open_value)))
          emit_captured(open_value)
        else
          guard_rescan_leaf(open_value)
      }
      open_quote = ""
      open_value = ""
      open_guard = 0
    }
    {
      if (record_mode == "probe_raw") {
        # Raw invalid-byte output is one logical plaintext leaf even though awk
        # presents it as physical records. Keep quote state across records so a
        # sanitized-looking first line cannot hide a credential continuation.
        if (!probe_found) scan_line($0)
        if (probe_found) exit
        next
      }
      # frame_json_string_leaves emits one boundary-terminated leaf unless the
      # value contains a physical newline. Avoid building a large clean leaf one
      # byte at a time in awk, which is quadratic on some macOS runners.
      if (record_mode == "probe" && index($0, escape) == 0 &&
          substr($0, length($0), 1) == boundary) {
        leaf = leaf substr($0, 1, length($0) - 1)
        scan_leaf(leaf)
        leaf = ""
        record_ended_at_boundary = 1
        if (probe_found) exit
        next
      }
      record_ended_at_boundary = 0
      for (i = 1; i <= length($0); i++) {
        ch = substr($0, i, 1)
        if (escaped) {
          leaf = leaf ch
          escaped = 0
          record_ended_at_boundary = 0
        } else if (ch == escape) {
          escaped = 1
          record_ended_at_boundary = 0
        } else if (ch == boundary) {
          if (record_mode != "probe" || !probe_found) scan_leaf(leaf)
          leaf = ""
          record_ended_at_boundary = 1
          if (record_mode == "probe" && probe_found) exit
        } else {
          leaf = leaf ch
          record_ended_at_boundary = 0
        }
      }
      # awk removes physical newlines that came from a JSON leaf, so restore
      # those as data. A record-ending boundary is followed by a synthetic
      # transport newline; do not insert that separator into the next leaf.
      if (!record_ended_at_boundary) leaf = leaf "\n"
    }
    END {
      if (record_mode == "probe_raw") {
        # A truncated multiline quote is evaluated only after the complete raw
        # capture has been scanned. This mirrors scan_leaf without resetting
        # open_quote/open_value at every physical newline.
        # Same status-label gate as the scan_leaf termination above: without
        # it a >64 KiB invalid-UTF-8 capture ending in an unterminated prose
        # chain was replaced wholesale, contradicting the gate everywhere else.
        if (!probe_found && open_quote != "") {
          if (!open_guard || credential_shaped(edge_trim(open_value)))
            emit_captured(open_value)
          else
            guard_rescan_leaf(open_value)
        }
        exit
      }
      # Valid framed input always terminates each leaf with RS. Preserve a final
      # partial record conservatively if a producer ever ends without one.
      if (length(leaf) > 0) scan_leaf(leaf)
    }
  '
}

# Treat malformed byte counts as over-cap so callers fail closed. Keeping the
# limit in one helper aligns PostToolUse, gitleaks, and exec preflights.
output_scan_input_exceeds_cap() {
  output_scan_input=$1
  output_scan_bytes=$(printf '%s' "$output_scan_input" \
    | LC_ALL=C wc -c | tr -d '[:space:]')
  case "$output_scan_bytes" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "$output_scan_bytes" -gt 327680 ]
}

# Bind the live post-tool probe's replacement to this invocation's diagnostic
# log record. A report of "the sentinel came back masked" is otherwise a
# constant that can be produced without running anything; with the run id the
# reader can look the same invocation up in `agent-guard logs export` and see
# `hook-post-tool` finish as `masked`. The id proves that a PostToolUse rewrite
# happened here, not which tool route carried it - the log schema is metadata
# only and records no tool name. Empty whenever no verifiable record exists, and
# the sentinel then masks to the bare placeholder.
#
# This is the one place in the redaction path whose output differs between two
# otherwise identical runs, and the unpredictability is the point: a constant
# expected value can be reported without running anything. Nothing about WHICH
# values get masked varies - only this one sentinel's replacement text.
live_probe_run_id() {
  [ -n "$AG_AUDIT_FILE" ] || return 0
  case "$AG_AUDIT_ID" in
    ''|*[!0-9A-Za-z-]*) return 0 ;;
  esac
  printf '%s' "$AG_AUDIT_ID"
}

live_probe_marker_valid() {
  live_probe_id=$1
  live_probe_dir=$2
  live_probe_marker="$live_probe_dir/live-probe-$live_probe_id"
  [ -d "$live_probe_marker" ] && [ ! -L "$live_probe_marker" ] || return 1
  [ "$(audit_stat "$live_probe_marker")" = "$(id -u):700" ] || return 1
  ! find "$live_probe_marker" -mindepth 1 -maxdepth 1 -print 2>/dev/null \
    | grep -q .
}

# Record only that this audit invocation handled the public harmless sentinel.
# The empty private directory carries no tool output or other user content, and
# mkdir is atomic: a pre-existing file, directory, or symlink makes the marker
# fail closed and the replacement stays the bare placeholder.
audit_mark_live_probe() {
  [ -n "$AG_AUDIT_FILE" ] || return 1
  case "$AG_AUDIT_ID" in
    ''|*[!0-9A-Za-z-]*) return 1 ;;
  esac
  live_probe_dir=$(audit_directory) || return 1
  [ "$AG_AUDIT_FILE" = "$live_probe_dir/event-$AG_AUDIT_ID" ] || return 1
  live_probe_marker="$live_probe_dir/live-probe-$AG_AUDIT_ID"
  (umask 077; mkdir "$live_probe_marker") 2>/dev/null || return 1
  if live_probe_marker_valid "$AG_AUDIT_ID" "$live_probe_dir"; then
    AG_LIVE_PROBE_MARKER=$live_probe_marker
    return 0
  fi
  rmdir "$live_probe_marker" 2>/dev/null || :
  return 1
}

audit_clear_live_probe_marker() {
  [ -n "$AG_LIVE_PROBE_MARKER" ] || return 0
  live_probe_marker=$AG_LIVE_PROBE_MARKER
  AG_LIVE_PROBE_MARKER=
  live_probe_dir=$(audit_directory) || return 0
  [ "$live_probe_marker" = "$live_probe_dir/live-probe-$AG_AUDIT_ID" ] || return 0
  live_probe_marker_valid "$AG_AUDIT_ID" "$live_probe_dir" || return 0
  rmdir "$live_probe_marker" 2>/dev/null || :
}

response_drops_live_probe() {
  printf '%s' "$1" | jq -e --arg probe "$LIVE_POST_TOOL_PROBE" \
    'any(.. | strings; contains($probe)) | not' >/dev/null 2>&1
}

# A prior live-probe replacement may pass through another PostToolUse event. It
# is trusted only when its exact generated id resolves to both the private
# sentinel sidecar and a bounded metadata record proving that a post-tool
# invocation finished masked. Prefixes, id shape, and an ordinary masked record
# are not provenance: forged lookalikes stay subject to PII.
live_probe_audit_record_exists() {
  live_probe_id=$1
  live_probe_dir=$2
  printf '%s' "$live_probe_id" \
    | LC_ALL=C grep -Eq '^[0-9]{1,12}-[A-Za-z0-9]{6}$' || return 1
  live_probe_file="$live_probe_dir/event-$live_probe_id"
  [ -f "$live_probe_file" ] && [ ! -L "$live_probe_file" ] || return 1
  [ "$(audit_stat "$live_probe_file")" = "$(id -u):600" ] || return 1
  live_probe_marker_valid "$live_probe_id" "$live_probe_dir" || return 1
  live_probe_bytes=$(wc -c <"$live_probe_file" | tr -d '[:space:]')
  case "$live_probe_bytes" in ''|*[!0-9]*) return 1 ;; esac
  [ "$live_probe_bytes" -le 2048 ] || return 1
  jq -e --arg id "$live_probe_id" '
      select(type == "object"
             and .schema == 1
             and .run_id == $id
             and .command == "hook-post-tool"
             and (.host == "claude" or .host == "codex")
             and .phase == "finished"
             and .outcome == "masked")
      | true
    ' "$live_probe_file" >/dev/null 2>&1
}

# Return at most sixteen provenance-verified, whole-leaf replacements. The
# response itself is already capped before this path; the tighter candidate cap
# bounds filesystem work even for adversarial output containing many lookalikes.
trusted_live_probe_replacements() {
  live_probe_response=$1
  case "$live_probe_response" in
    *"$LIVE_POST_TOOL_REPLACEMENT_PREFIX"*) ;;
    *) printf '%s' '[]'; return 0 ;;
  esac
  live_probe_dir=$(audit_directory) || {
    printf '%s' '[]'
    return 0
  }
  live_probe_candidates=$(printf '%s' "$live_probe_response" \
    | jq -c --arg prefix "$LIVE_POST_TOOL_REPLACEMENT_PREFIX" '
        [.. | strings
         | select(startswith($prefix))
         | .[($prefix | length):] as $id
         | select($id | test("^[0-9]{1,12}-[A-Za-z0-9]{6}$"))]
        | unique | .[:16][]
      ' 2>/dev/null) || {
    printf '%s' '[]'
    return 0
  }
  [ -n "$live_probe_candidates" ] || {
    printf '%s' '[]'
    return 0
  }
  printf '%s\n' "$live_probe_candidates" \
    | while IFS= read -r live_probe_candidate; do
        live_probe_id=$(printf '%s' "$live_probe_candidate" \
          | jq -r --arg prefix "$LIVE_POST_TOOL_REPLACEMENT_PREFIX" \
              '.[($prefix | length):]' 2>/dev/null) || continue
        if live_probe_audit_record_exists "$live_probe_id" "$live_probe_dir"; then
          printf '%s\n' "$live_probe_candidate"
        fi
      done \
    | jq -sc 'unique' 2>/dev/null
}

# Collect JSON-string records for the literal secrets present in the response
# JSON ($1): gitleaks findings plus the env-assignment heuristic and compact
# token rules. The env heuristic scans each string leaf independently so quote
# state can never cross a stdout/stderr or array boundary.
# Materialize every detector stage before consuming its output. POSIX pipelines
# expose only their final command status, so a producer that writes a prefix and
# then fails must never be indistinguishable from a successful empty detector.
detect_output_secret_records() (
  response=$1
  env_records=${2:-yes}
  detector_input=$(mktemp_file) || exit 1
  detector_strings=$(mktemp_file) || {
    rm -f "$detector_input"
    exit 1
  }
  detector_records=$(mktemp_file) || {
    rm -f "$detector_input" "$detector_strings"
    exit 1
  }
  detector_work_a=$(mktemp_file) || {
    rm -f "$detector_input" "$detector_strings" "$detector_records"
    exit 1
  }
  detector_work_b=$(mktemp_file) || {
    rm -f "$detector_input" "$detector_strings" "$detector_records" \
      "$detector_work_a"
    exit 1
  }
  detector_cleanup() {
    rm -f "$detector_input" "$detector_strings" "$detector_records" \
      "$detector_work_a" "$detector_work_b" ${detector_report:+"$detector_report"}
  }
  detector_fail() {
    detector_cleanup
    exit 1
  }

  : >"$detector_records" || detector_fail
  printf '%s' "$response" >"$detector_input" || detector_fail
  jq -rj 'if type == "string" then . else [.. | strings] | join("\n") end' \
    <"$detector_input" >"$detector_strings" 2>/dev/null || detector_fail

  gl=${GITLEAKS_READY_BIN:-}
  [ -n "$gl" ] && [ -x "$gl" ] || detector_fail
  [ -f "$GITLEAKS_CONFIG" ] || detector_fail
  if output_scan_input_exceeds_cap "$response"; then
      printf '%s\n' '{"agent_guard_whole_leaf":true}' \
        >>"$detector_records" || detector_fail
  else
      detector_report=$(mktemp_file) || detector_fail
      (
        ulimit -f 128 >/dev/null 2>&1 || exit 2
        "$gl" stdin --report-format json --report-path "$detector_report" \
          --no-banner --config "$GITLEAKS_CONFIG" <"$detector_strings"
      ) >/dev/null 2>&1
      detector_status=$?
      case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
      [ -s "$detector_report" ] || detector_fail
      jq -e 'type == "array"' "$detector_report" >/dev/null 2>&1 \
        || detector_fail
      jq -c '.[]? | (.Secret // empty)
             | select(type == "string" and length > 0)' \
        "$detector_report" >"$detector_work_a" 2>/dev/null || detector_fail
      cat "$detector_work_a" >>"$detector_records" || detector_fail
      rm -f "$detector_report"
      detector_report=
  fi

  if [ "$env_records" = yes ]; then
    frame_json_string_leaves <"$detector_input" \
      >"$detector_work_a" 2>/dev/null || detector_fail
    secretish_env_values <"$detector_work_a" \
      >"$detector_work_b" 2>/dev/null || detector_fail
    cat "$detector_work_b" >>"$detector_records" || detector_fail
  fi

  grep -Eo 'eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+' \
    <"$detector_strings" >"$detector_work_a" 2>/dev/null
  detector_status=$?
  case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
  jq -Rc 'select(length > 0)' <"$detector_work_a" \
    >"$detector_work_b" 2>/dev/null || detector_fail
  cat "$detector_work_b" >>"$detector_records" || detector_fail

  grep -Eio 'bearer[ \t]+[-A-Za-z0-9._~+/=]+' \
    <"$detector_strings" >"$detector_work_a" 2>/dev/null
  detector_status=$?
  case "$detector_status" in 0|1) ;; *) detector_fail ;; esac
  awk '{ tok = $2; if (length(tok) >= 8) print tok }' \
    <"$detector_work_a" >"$detector_work_b" 2>/dev/null || detector_fail
  jq -Rc 'select(length > 0)' <"$detector_work_b" \
    >"$detector_work_a" 2>/dev/null || detector_fail
  cat "$detector_work_a" >>"$detector_records" || detector_fail

  cat "$detector_records"
  detector_status=$?
  detector_cleanup
  exit "$detector_status"
)

# Bound secret records before materializing them in a shell variable or passing
# the resulting JSON through exec argv. The raw-record cap is intentionally
# conservative: duplicates still count because stopping after a prefix cannot
# prove that later records contain no new secret. Callers fail closed when
# either cap is crossed.
bundle_secret_records() (
  bundle_input=$(mktemp_file) || exit 1
  bundle_records=$(mktemp_file) || {
    rm -f "$bundle_input"
    exit 1
  }
  bundle_output=$(mktemp_file) || {
    rm -f "$bundle_input" "$bundle_records"
    exit 1
  }
  if ! cat >"$bundle_input" \
    || ! LC_ALL=C awk '
        BEGIN {
          max_records = 256
          max_bytes = 65536
        }
        {
          record_count++
          record_bytes += length($0) + 1
          if (record_count > max_records || record_bytes > max_bytes) {
            print "{\"agent_guard_whole_leaf\":true}"
            exceeded = 1
            exit
          }
          records[record_count] = $0
        }
        END {
          if (!exceeded)
            for (i = 1; i <= record_count; i++) print records[i]
        }
      ' <"$bundle_input" >"$bundle_records" \
    || ! jq -sc '
        if any(.[]; type == "object" and .agent_guard_whole_leaf == true)
        then {whole_leaf: true, secrets: []}
        else {whole_leaf: false, secrets: unique}
        end
      ' <"$bundle_records" >"$bundle_output" 2>/dev/null; then
    rm -f "$bundle_input" "$bundle_records" "$bundle_output"
    exit 1
  fi
  cat "$bundle_output"
  bundle_status=$?
  rm -f "$bundle_input" "$bundle_records" "$bundle_output"
  exit "$bundle_status"
)

detect_output_secret_bundle() (
  bundle_response=$1
  bundle_raw=$(mktemp_file) || exit 1
  bundle_json=$(mktemp_file) || {
    rm -f "$bundle_raw"
    exit 1
  }
  if ! detect_output_secret_records "$bundle_response" >"$bundle_raw" \
    || ! bundle_secret_records <"$bundle_raw" >"$bundle_json"; then
    rm -f "$bundle_raw" "$bundle_json"
    exit 1
  fi
  cat "$bundle_json"
  bundle_status=$?
  rm -f "$bundle_raw" "$bundle_json"
  exit "$bundle_status"
)

# Parse a completed detector bundle once. The jq output is staged privately and
# accepted only after successful completion, then decoded as two newline-bounded
# fields without invoking another parser that could fail after partial output.
classify_secret_bundle() {
  classify_bundle_value=$1
  BUNDLE_MODE=
  BUNDLE_SECRETS=
  classify_bundle_input=$(mktemp_file) || return 1
  classify_bundle_output=$(mktemp_file) || {
    rm -f "$classify_bundle_input"
    return 1
  }
  if ! printf '%s' "$classify_bundle_value" >"$classify_bundle_input" \
    || ! jq -jr '
      if type != "object"
         or (.whole_leaf | type) != "boolean"
         or (.secrets | type) != "array"
         or any(.secrets[];
                ((type == "string")
                 or (type == "object"
                     and (.literal | type) == "string"
                     and (.replacement | type) == "string"
                     and ((.contextual // false) | type) == "boolean"))
                | not)
      then error("invalid secret bundle")
      elif .whole_leaf
      then "whole_leaf\n[]\n"
      else "secrets\n\(.secrets | tojson)\n"
      end
    ' <"$classify_bundle_input" >"$classify_bundle_output" 2>/dev/null; then
    rm -f "$classify_bundle_input" "$classify_bundle_output"
    return 1
  fi
  classify_bundle_lines=0
  while IFS= read -r classify_bundle_line; do
    classify_bundle_lines=$((classify_bundle_lines + 1))
    case "$classify_bundle_lines" in
      1) BUNDLE_MODE=$classify_bundle_line ;;
      2) BUNDLE_SECRETS=$classify_bundle_line ;;
      *)
        rm -f "$classify_bundle_input" "$classify_bundle_output"
        BUNDLE_MODE=
        BUNDLE_SECRETS=
        return 1
        ;;
    esac
  done <"$classify_bundle_output"
  rm -f "$classify_bundle_input" "$classify_bundle_output"
  [ "$classify_bundle_lines" -eq 2 ] || return 1
  case "$BUNDLE_MODE:$BUNDLE_SECRETS" in
    whole_leaf:'[]'|secrets:'['*']') return 0 ;;
  esac
  BUNDLE_MODE=
  BUNDLE_SECRETS=
  return 1
}

# `printenv NAME` prints only the value, so the output loses the secret-bearing
# variable name that secretish_env_values needs as context. Reconstruct that
# context from simple variable-name arguments, then emit only the detected
# values for literal redaction of the original bare output. GNU printenv emits
# every present argument while BSD printenv emits only the first; compare the
# captured output with both models before deciding which requested values were
# actually emitted. This intentionally ignores options and invalid names; the
# normal gitleaks scan still covers them.
detect_printenv_argument_secret_records() {
  response=$1
  shift
  [ "$#" -gt 1 ] || return 0
  cmd_name=${1##*/}
  [ "$cmd_name" = printenv ] || return 0
  shift
  [ "${1:-}" = "--" ] && shift
  [ "$#" -gt 0 ] || return 0
  printenv_args_file=$(mktemp_file) || return 1
  printenv_entries_file=$(mktemp_file) || {
    rm -f "$printenv_args_file"
    return 1
  }
  printenv_work_a=$(mktemp_file) || {
    rm -f "$printenv_args_file" "$printenv_entries_file"
    return 1
  }
  printenv_work_b=$(mktemp_file) || {
    rm -f "$printenv_args_file" "$printenv_entries_file" "$printenv_work_a"
    return 1
  }

  # Do not replay the complete printenv argument list into a second process
  # argv: the original command can fit while jq's extra argv entries cross
  # ARG_MAX. NUL is the only byte a process argument cannot contain, so this
  # preserves every argument boundary without reserving another sentinel.
  if ! printf '%s\0' "$@" >"$printenv_args_file" \
    || ! jq -Rsc '
    def trim_trailing_newlines: sub("\n+$"; "");
    (split("\u0000")
     | if length > 0 and .[-1] == "" then .[:-1]
       else error("unterminated printenv argument stream")
       end) as $args
    | {entries:
         ($args
          | to_entries
          | map(.value as $name
                | {position: .key,
                   name: $name,
                   valid: ($name | test("^[A-Za-z_][A-Za-z0-9_]*$"))})),
       names:
         ($args
          | map(select(test("^[A-Za-z_][A-Za-z0-9_]*$")))
          | unique
          | map(. as $name
                | (env[$name] // "") as $value
                | ($value | trim_trailing_newlines) as $trimmed_value
                | {name: $name,
                   present: (env[$name] != null),
                   value: $value,
                   value_length: ($value | length),
                   trimmed_value: $trimmed_value,
                   trimmed_length: ($trimmed_value | length),
                   has_content: (($trimmed_value | length) > 0),
                   probe: ("agent_guard_printenv_probe_" + $name)}))}
  ' "$printenv_args_file" >"$printenv_entries_file" 2>/dev/null \
    || ! jq -c '
      [.names[] | select(.present) | (.name + "=" + .probe)]
    ' "$printenv_entries_file" >"$printenv_work_a" 2>/dev/null \
    || ! frame_json_string_leaves \
      <"$printenv_work_a" >"$printenv_work_b" 2>/dev/null \
    || ! secretish_env_values \
      <"$printenv_work_b" >"$printenv_work_a" 2>/dev/null \
    || ! jq -sc 'reduce .[] as $probe ({}; .[$probe] = true)' \
      "$printenv_work_a" >"$printenv_work_b" 2>/dev/null; then
    rm -f "$printenv_args_file" "$printenv_entries_file" \
      "$printenv_work_a" "$printenv_work_b"
    return 1
  fi

  # Feed entries, recognized probes, and captured output as three JSON
  # documents. Generated JSON can expand far beyond Linux MAX_ARG_STRLEN even
  # though the original plaintext remains under the output cap.
  : >"$printenv_work_a" || {
    rm -f "$printenv_args_file" "$printenv_entries_file" \
      "$printenv_work_a" "$printenv_work_b"
    return 1
  }
  if ! cat "$printenv_entries_file" >>"$printenv_work_a" \
    || ! printf '\n' >>"$printenv_work_a" \
    || ! cat "$printenv_work_b" >>"$printenv_work_a" \
    || ! printf '\n%s\n' "$response" >>"$printenv_work_a"; then
    rm -f "$printenv_args_file" "$printenv_entries_file" \
      "$printenv_work_a" "$printenv_work_b"
    return 1
  fi

  jq -cs '
    .[0] as $metadata
    | .[1] as $recognized
    | .[2] as $output
    | $metadata.entries as $entries
    | ($metadata.names
       | map({key: .name, value: .})
       | from_entries) as $names
    | [$entries[]
       | select(.valid)
       | . as $entry
       | select($names[$entry.name].present)
       | {position: .position, name: .name}] as $emitted
    # Shell capture removes every trailing newline from GNU printenv output.
    # Therefore entries after the last content-bearing value cannot affect the
    # capture. Exclude them from both the length gate and materialization so
    # repeated empty/newline-only values cannot amplify the model.
    | ([$emitted[]
        | select($names[.name].has_content)]) as $gnu_content_entries
    | (($gnu_content_entries[-1] // null)) as $gnu_last_entry
    | (if $gnu_last_entry == null
       then 0
       else (reduce ($emitted[]
                     | select(.position <= $gnu_last_entry.position)) as $entry
               ({length: 0, count: 0};
                ($names[$entry.name]) as $name
                | .length +=
                    ((if $entry.position == $gnu_last_entry.position
                      then $name.trimmed_length
                      else $name.value_length
                      end)
                     + (if .count > 0 then 1 else 0 end))
                | .count += 1)
             | .length)
       end) as $gnu_output_length
    | (if $gnu_output_length == ($output | length)
       then (if $gnu_last_entry == null
             then ""
             else ($emitted
                   | map(select(.position <= $gnu_last_entry.position)
                         | if .position == $gnu_last_entry.position
                           then $names[.name].trimmed_value
                           else $names[.name].value
                           end)
                   | join("\n"))
             end)
       else null
       end) as $gnu_output
    | (if (($entries | length) > 0
             and $entries[0].valid
             and $names[$entries[0].name].present)
       then $names[$entries[0].name].trimmed_value
       else ""
       end) as $bsd_output
    | (($gnu_last_entry.position // -1)) as $gnu_last_position
    | $entries[]
    | . as $entry
    | select(.valid)
    | $names[$entry.name] as $name
    | select($name.present and $recognized[$name.probe] == true)
    | if ($output == $gnu_output and $output != $bsd_output)
      then (if .position == $gnu_last_position
            then $name.trimmed_value
            else $name.value
            end)
      elif ($output == $bsd_output and $output != $gnu_output)
      then select(.position == 0) | $name.trimmed_value
      else ($name.value, $name.trimmed_value)
      end
    | select(length >= 4)
    | select(. as $value | $output | contains($value))
  ' "$printenv_work_a" 2>/dev/null
  printenv_detect_status=$?
  rm -f "$printenv_args_file" "$printenv_entries_file" \
    "$printenv_work_a" "$printenv_work_b"
  return "$printenv_detect_status"
}

detect_exec_secret_bundle() (
  exec_bundle_response=$1
  exec_bundle_invalid=$2
  shift 2
  exec_bundle_records=$(mktemp_file) || exit 1
  exec_bundle_json=$(mktemp_file) || {
    rm -f "$exec_bundle_records"
    exit 1
  }
  : >"$exec_bundle_records" || {
    rm -f "$exec_bundle_records" "$exec_bundle_json"
    exit 1
  }
  exec_detector_failed=0
  if [ -n "$exec_bundle_response" ]; then
    if [ "$exec_bundle_invalid" -eq 1 ]; then
      detect_output_secret_records "$exec_bundle_response" no \
        >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
    else
      detect_output_secret_records "$exec_bundle_response" \
        >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
    fi
  fi
  detect_printenv_argument_secret_records "$exec_bundle_response" "$@" \
    >>"$exec_bundle_records" 2>/dev/null || exec_detector_failed=1
  if [ "$exec_detector_failed" -ne 0 ]; then
    printf '%s\n' '{"agent_guard_whole_leaf":true}' \
      >"$exec_bundle_records" || {
        rm -f "$exec_bundle_records" "$exec_bundle_json"
        exit 1
      }
  fi
  if ! bundle_secret_records <"$exec_bundle_records" >"$exec_bundle_json"; then
    rm -f "$exec_bundle_records" "$exec_bundle_json"
    exit 1
  fi
  cat "$exec_bundle_json"
  exec_bundle_status=$?
  rm -f "$exec_bundle_records" "$exec_bundle_json"
  exit "$exec_bundle_status"
)

# Invalid UTF-8 cannot round-trip through jq's env lookup, so its reconstructed
# printenv value cannot be matched byte-for-byte. Detect secret-bearing requested
# names without reading their values; exec then conservatively masks the captured
# output instead of risking a bare credential leak.
printenv_requests_secretish_name() {
  [ "$#" -gt 1 ] || return 1
  cmd_name=${1##*/}
  [ "$cmd_name" = printenv ] || return 1
  shift
  [ "${1:-}" = "--" ] && shift
  [ "$#" -gt 0 ] || return 1
  {
    for name do
      case "$name" in
        [A-Za-z_]*)
          case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
          printf '%s=%s\n' "$name" agent_guard_printenv_probe
          ;;
      esac
    done
  } \
    | frame_plaintext_leaf \
    | secretish_env_values framed \
    | grep -q .
}

# Replace every detected secret literal with a placeholder inside ANY string leaf
# of the tool_response JSON ($1), preserving the original shape exactly
# (updatedToolOutput must match the tool's native output shape). $2 is a JSON
# string array. Prints the redacted JSON, or nothing on failure.
redact_tool_response_json() {
  resp=$1
  secrets=$2
  [ -n "$secrets" ] || return 1
  # Redacts string VALUES only; object KEYS are left untouched. Transforming keys
  # could collide two distinct keys onto one placeholder and silently drop an
  # entry; a secret appearing as a JSON key is a documented limitation (README).
  printf '%s' "$resp" | jq -c --argjson secrets "$secrets" \
    "$JQ_SHAPE_SAFE_WALK"'
    def specs($s):
      $s
      | map(if type == "string"
            then {literal: ., replacement: "[REDACTED]", contextual: false}
            elif (type == "object"
                  and (.literal | type) == "string"
                  and (.replacement | type) == "string")
            then (. + {contextual: (.contextual == true)})
            else empty
            end);
    def context_replace($literal; $replacement):
      if contains($literal)
      then (. / $literal) as $parts
           | reduce range(1; $parts | length) as $i ($parts[0];
               . + (if ($parts[$i] | test("^([ \t\n,;]|$)"))
                    then $replacement
                    else $literal
                    end)
                 + $parts[$i])
      else .
      end;
    def redact($specs):
      reduce ($specs
                | map(select(.contextual))
                | sort_by(.literal | length)
                | reverse)[] as $x (.;
          if ($x.literal | length) > 0
          then context_replace($x.literal; $x.replacement)
          else .
          end)
      | reduce ($specs
                | map(select(.contextual | not))
                | sort_by(.literal | length)
                | reverse)[] as $x (.;
        if ($x.literal | length) > 0
        then ((. / $x.literal) | join($x.replacement))
        else .
        end);
    (specs($secrets)) as $specs
    | (reduce (.. | strings) as $leaf
         (0; . + ($leaf | length) + 1)) as $string_work
    # Literal replacement is proportional to spec-count × response size.
    # Bound that work below the host hook timeout. High-cardinality output is
    # still fail-closed in one tree walk by masking every nonempty string leaf.
    # Both walks are key-aware: a detected literal that happens to equal a
    # protocol token would otherwise break the response shape here for exactly
    # the reason JQ_SHAPE_SAFE_WALK describes, on the precise path too.
    | if ($specs | length) > 256
         or (($specs | length) * $string_work) > 8000000
      then shape_safe_walk(if type == "string" and length > 0
                           then "[REDACTED]" else . end)
      else shape_safe_walk(if type == "string" and length > 0
                           then redact($specs) else . end)
      end
  ' 2>/dev/null
}

# Replace only the harmless live sentinel after ordinary secret and PII masking.
# The audit id is generated by this hook invocation, not taken from tool output,
# and is introduced only after the generic PII pass so its timestamp cannot be
# mistaken for a phone number. Attacker-controlled text receives no exemption.
redact_live_probe_response_json() {
  resp=$1
  run_id=${2:-}
  case "$resp" in
    *"$LIVE_POST_TOOL_PROBE"*) ;;
    *) printf '%s' "$resp"; return 0 ;;
  esac
  replacement='[REDACTED]'
  if [ -n "$run_id" ]; then
    replacement="$LIVE_POST_TOOL_REPLACEMENT_PREFIX$run_id"
  fi
  specs=$(jq -nc \
    --arg literal "$LIVE_POST_TOOL_PROBE" \
    --arg replacement "$replacement" \
    '[{literal: $literal, replacement: $replacement, contextual: false}]') \
    || return 1
  redact_tool_response_json "$resp" "$specs"
}

# POSIX shell variables cannot preserve NUL bytes. Keep NUL-bearing JSON leaves
# out of command substitution entirely and conservatively replace the whole leaf
# before the ordinary literal detector runs.
redact_nul_response_json() {
  resp=$1
  { printf '%s' "$resp"; } 2>/dev/null | jq -c "$JQ_WALK"'
    walk(if type == "string" and contains("\u0000")
         then "[REDACTED]" else . end)
  ' 2>/dev/null
}

# Large, high-cardinality assignment dumps can exhaust the host timeout while
# the ordinary detector collects every unique literal. Probe them in one
# streaming pass first; only a confirmed secret-bearing assignment takes the
# conservative whole-leaf path. Large clean output still uses normal detection.
large_response_has_secretish_assignment() {
  large_probe_response=$1
  large_probe_bytes=$(printf '%s' "$large_probe_response" \
    | wc -c | tr -d '[:space:]')
  case "$large_probe_bytes" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$large_probe_bytes" -gt 262144 ] || return 1
  printf '%s' "$large_probe_response" \
    | frame_json_string_leaves 2>/dev/null \
    | secretish_env_values probe \
    | grep -q .
}

redact_nonempty_response_strings() {
  whole_leaf_response=$1
  { printf '%s' "$whole_leaf_response"; } 2>/dev/null \
    | jq -c "$JQ_SHAPE_SAFE_WALK"'
    shape_safe_walk(if type == "string" and length > 0
                    then "[REDACTED]" else . end)
  ' 2>/dev/null
}

# jq has implementation-dependent nesting limits, so a valid response can pass
# hook validation and still fail the recursive whole-leaf walk. Parse its
# compact jq serialization iteratively with POSIX awk. Output stays in a
# private temporary file until the complete single document is validated, so a
# malformed or interrupted transform can never expose a partial replacement.
redact_response_values_awk() {
  whole_leaf_response=$1
  whole_leaf_tmp=$(mktemp_file) || return 1
  case "$whole_leaf_response" in
    *'"'*) ;;
    *)
      if printf '%s' "$whole_leaf_response" | LC_ALL=C awk '
        BEGIN { RS = ","; ORS = "" }
        function json_fail() { failed = 1; exit 1 }
        function scan_structure(value,    clean, skeleton, residue, i, ch) {
          clean = value
          gsub(/[ \t\r\n]/, "", clean)
          if (clean == "") json_fail()
          residue = clean
          gsub(/-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/, "", residue)
          gsub(/true|false|null/, "", residue)
          gsub(/[\[\]{}]/, "", residue)
          if (residue != "") json_fail()
          skeleton = clean
          gsub(/[^][{}]+/, "", skeleton)
          if (skeleton == "" && depth == 0) {
            if (NR != 1 || root_seen \
                || clean !~ /^(-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?|true|false|null)$/) json_fail()
            root_seen = 1
            root_closed = 1
            return
          }
          for (i = 1; i <= length(skeleton); i++) {
            ch = substr(skeleton, i, 1)
            if (ch == "[" || ch == "{") {
              if (depth == 0 && root_seen) json_fail()
              root_seen = 1
              depth++
              container[depth] = ch
            } else {
              if (depth == 0) json_fail()
              if ((ch == "]" && container[depth] != "[") \
                  || (ch == "}" && container[depth] != "{")) json_fail()
              delete container[depth]
              depth--
              if (depth == 0) root_closed = 1
            }
          }
          if (root_closed && depth == 0 \
              && clean !~ /[}\]]$/ && NR > 1) json_fail()
        }
        {
          scan_structure($0)
          if (NR > 1) printf ","
          transformed = $0
          gsub(/-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/, "0", transformed)
          gsub(/true/, "false", transformed)
          printf "%s", transformed
        }
        END {
          if (NR == 0 || failed || depth != 0 || !root_seen) exit 1
        }
      ' >"$whole_leaf_tmp" 2>/dev/null; then
        cat "$whole_leaf_tmp"
        whole_leaf_status=$?
      else
        whole_leaf_status=$?
      fi
      rm -f "$whole_leaf_tmp"
      return "$whole_leaf_status"
      ;;
  esac
  if printf '%s' "$whole_leaf_response" | LC_ALL=C awk '
    function json_fail() {
      failed = 1
      exit 1
    }
    function emit(value) {
      printf "%s", value
    }
    function append_candidate(value) {
      if (!candidate_valid) return
      candidate = candidate value
      if (length(candidate) > 32) candidate_valid = 0
    }
    function hex_value(ch) {
      if (ch >= "0" && ch <= "9") return ch + 0
      if (ch >= "a" && ch <= "f") return 10 + index("abcdef", ch) - 1
      if (ch >= "A" && ch <= "F") return 10 + index("ABCDEF", ch) - 1
      return -1
    }
    function read_string(pos,    i, ch, esc, j, digit, code) {
      candidate = ""
      candidate_valid = 1
      i = pos + 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == "\"") {
          token_end = i
          token_raw = substr(document, pos, i - pos + 1)
          return
        }
        if (ch == "\\") {
          i++
          if (i > document_length) json_fail()
          esc = substr(document, i, 1)
          if (esc == "u") {
            if (i + 4 > document_length) json_fail()
            code = 0
            for (j = 1; j <= 4; j++) {
              digit = hex_value(substr(document, i + j, 1))
              if (digit < 0) json_fail()
              code = code * 16 + digit
            }
            if (code >= 32 && code <= 126) append_candidate(sprintf("%c", code))
            else candidate_valid = 0
            i += 5
            continue
          }
          if (index("\"\\/bfnrt", esc) == 0) json_fail()
          if (esc == "/") append_candidate("/")
          else if (esc == "\"") append_candidate("\"")
          else if (esc == "\\") append_candidate("\\")
          else candidate_valid = 0
          i++
          continue
        }
        if (ch ~ /[[:cntrl:]]/) json_fail()
        if (ch ~ /^[ -~]$/) append_candidate(ch)
        else candidate_valid = 0
        i++
      }
      json_fail()
    }
    function protocol_discriminator(key, value) {
      if (!(key == "type" || key == "media_type" || key == "mimeType" || key == "encoding")) return 0
      return value == "text" || value == "image" || value == "document" \
        || value == "search_result" || value == "browser_state" \
        || value == "tool_reference" || value == "tool_use" \
        || value == "tool_result" || value == "thinking" \
        || value == "redacted_thinking" || value == "base64" \
        || value == "url" || value == "file" || value == "content" \
        || value == "pdf" || value == "image/png" \
        || value == "image/jpeg" || value == "image/gif" \
        || value == "image/webp" || value == "application/pdf" \
        || value == "text/plain"
    }
    function accept_value() {
      if (depth == 0) {
        if (root_done) json_fail()
        root_done = 1
      } else if (container[depth] == "object") {
        if (state[depth] != "value") json_fail()
        state[depth] = "comma_or_end"
      } else {
        if (!(state[depth] == "value_or_end" || state[depth] == "value")) json_fail()
        state[depth] = "comma_or_end"
      }
    }
    function read_number(pos,    i, ch, window, next_ch) {
      window = substr(document, pos, 128)
      if (match(window, /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/)) {
        next_ch = substr(document, pos + RLENGTH, 1)
        if (RLENGTH < 128 || next_ch !~ /^[0-9.eE+-]$/) {
          token_end = pos + RLENGTH - 1
          return
        }
      }
      i = pos
      if (substr(document, i, 1) == "-") i++
      if (i > document_length) json_fail()
      ch = substr(document, i, 1)
      if (ch == "0") {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/) json_fail()
      } else if (ch ~ /^[1-9]$/) {
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      } else json_fail()
      if (i <= document_length && substr(document, i, 1) == ".") {
        i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      if (i <= document_length && substr(document, i, 1) ~ /^[eE]$/) {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[+-]$/) i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      token_end = i - 1
    }
    function parse_document(    i, ch, direct_key, literal) {
      document_length = length(document)
      if (document_length == 0) json_fail()
      i = 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
          i++
          continue
        }
        if (ch == "{") {
          accept_value()
          emit(ch)
          depth++
          container[depth] = "object"
          state[depth] = "key_or_end"
          i++
          continue
        }
        if (ch == "[") {
          accept_value()
          emit(ch)
          depth++
          container[depth] = "array"
          state[depth] = "value_or_end"
          i++
          continue
        }
        if (ch == "}") {
          if (depth == 0 || container[depth] != "object" || !(state[depth] == "key_or_end" || state[depth] == "comma_or_end")) json_fail()
          emit(ch)
          delete container[depth]
          delete state[depth]
          delete object_key[depth]
          depth--
          i++
          continue
        }
        if (ch == "]") {
          if (depth == 0 || container[depth] != "array" || !(state[depth] == "value_or_end" || state[depth] == "comma_or_end")) json_fail()
          emit(ch)
          delete container[depth]
          delete state[depth]
          depth--
          i++
          continue
        }
        if (ch == ":") {
          if (depth == 0 || container[depth] != "object" || state[depth] != "colon") json_fail()
          emit(ch)
          state[depth] = "value"
          i++
          continue
        }
        if (ch == ",") {
          if (depth == 0 || state[depth] != "comma_or_end") json_fail()
          emit(ch)
          if (container[depth] == "object") state[depth] = "key"
          else state[depth] = "value"
          i++
          continue
        }
        if (ch == "\"") {
          read_string(i)
          if (depth > 0 && container[depth] == "object" && (state[depth] == "key_or_end" || state[depth] == "key")) {
            emit(token_raw)
            if (candidate_valid) object_key[depth] = candidate
            else object_key[depth] = ""
            state[depth] = "colon"
          } else {
            direct_key = ""
            if (depth > 0 && container[depth] == "object" && state[depth] == "value") direct_key = object_key[depth]
            accept_value()
            if (token_raw == "\"\"" || (candidate_valid && protocol_discriminator(direct_key, candidate))) emit(token_raw)
            else emit("\"[REDACTED]\"")
          }
          i = token_end + 1
          continue
        }
        if (ch == "t" && substr(document, i, 4) == "true") {
          literal = "true"
        } else if (ch == "f" && substr(document, i, 5) == "false") {
          literal = "false"
        } else if (ch == "n" && substr(document, i, 4) == "null") {
          literal = "null"
        } else literal = ""
        if (literal != "") {
          accept_value()
          if (literal == "true") emit("false")
          else emit(literal)
          i += length(literal)
          continue
        }
        if (ch == "-" || ch ~ /^[0-9]$/) {
          read_number(i)
          accept_value()
          emit("0")
          i = token_end + 1
          continue
        }
        json_fail()
      }
      if (depth != 0 || !root_done) json_fail()
    }
    {
      if (NR > 1) document = document "\n"
      document = document $0
    }
    END {
      if (failed) exit 1
      parse_document()
    }
  ' >"$whole_leaf_tmp" 2>/dev/null; then
    cat "$whole_leaf_tmp"
    whole_leaf_status=$?
  else
    whole_leaf_status=$?
  fi
  rm -f "$whole_leaf_tmp"
  return "$whole_leaf_status"
}

# jq can reject a valid host envelope at implementation-specific nesting
# limits. Independently validate one complete top-level object and extract its
# unique tool_response value without recursion. Nothing reaches stdout until
# the full envelope has been accepted.
extract_post_tool_response_awk() {
  envelope=$1
  response_tmp=$(mktemp_file) || return 1
  if printf '%s' "$envelope" | LC_ALL=C awk '
    function json_fail() {
      failed = 1
      exit 1
    }
    function append_candidate(value) {
      if (!candidate_valid) return
      candidate = candidate value
      if (length(candidate) > 64) candidate_valid = 0
    }
    function hex_value(ch) {
      if (ch >= "0" && ch <= "9") return ch + 0
      if (ch >= "a" && ch <= "f") return 10 + index("abcdef", ch) - 1
      if (ch >= "A" && ch <= "F") return 10 + index("ABCDEF", ch) - 1
      return -1
    }
    function read_string(pos,    i, ch, esc, j, digit, code) {
      candidate = ""
      candidate_valid = 1
      i = pos + 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == "\"") {
          token_end = i
          return
        }
        if (ch == "\\") {
          i++
          if (i > document_length) json_fail()
          esc = substr(document, i, 1)
          if (esc == "u") {
            if (i + 4 > document_length) json_fail()
            code = 0
            for (j = 1; j <= 4; j++) {
              digit = hex_value(substr(document, i + j, 1))
              if (digit < 0) json_fail()
              code = code * 16 + digit
            }
            if (code >= 32 && code <= 126) append_candidate(sprintf("%c", code))
            else candidate_valid = 0
            i += 5
            continue
          }
          if (index("\"\\/bfnrt", esc) == 0) json_fail()
          if (esc == "/") append_candidate("/")
          else if (esc == "\"") append_candidate("\"")
          else if (esc == "\\") append_candidate("\\")
          else candidate_valid = 0
          i++
          continue
        }
        if (ch ~ /[[:cntrl:]]/) json_fail()
        if (ch ~ /^[ -~]$/) append_candidate(ch)
        else candidate_valid = 0
        i++
      }
      json_fail()
    }
    function read_number(pos,    i, ch) {
      i = pos
      if (substr(document, i, 1) == "-") i++
      if (i > document_length) json_fail()
      ch = substr(document, i, 1)
      if (ch == "0") {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/) json_fail()
      } else if (ch ~ /^[1-9]$/) {
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      } else json_fail()
      if (i <= document_length && substr(document, i, 1) == ".") {
        i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      if (i <= document_length && substr(document, i, 1) ~ /^[eE]$/) {
        i++
        if (i <= document_length && substr(document, i, 1) ~ /^[+-]$/) i++
        if (i > document_length || substr(document, i, 1) !~ /^[0-9]$/) json_fail()
        do { i++ } while (i <= document_length && substr(document, i, 1) ~ /^[0-9]$/)
      }
      token_end = i - 1
    }
    function is_response_value() {
      return depth == 1 && container[depth] == "object" \
        && state[depth] == "value" && object_key[depth] == "tool_response"
    }
    function begin_value(pos, is_container,    target) {
      target = is_response_value()
      if (depth == 0) {
        if (root_done) json_fail()
        root_done = 1
      } else if (container[depth] == "object") {
        if (state[depth] != "value") json_fail()
        state[depth] = "comma_or_end"
      } else {
        if (!(state[depth] == "value_or_end" || state[depth] == "value")) json_fail()
        state[depth] = "comma_or_end"
      }
      if (target) {
        if (response_found) json_fail()
        response_found = 1
        response_start = pos
        if (is_container) response_depth = depth + 1
      }
      return target
    }
    function parse_document(    i, ch, literal, target) {
      document_length = length(document)
      if (document_length == 0) json_fail()
      i = 1
      while (i <= document_length) {
        ch = substr(document, i, 1)
        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") {
          i++
          continue
        }
        if (ch == "{") {
          if (depth == 0) root_kind = "object"
          begin_value(i, 1)
          depth++
          container[depth] = "object"
          state[depth] = "key_or_end"
          i++
          continue
        }
        if (ch == "[") {
          if (depth == 0) root_kind = "array"
          begin_value(i, 1)
          depth++
          container[depth] = "array"
          state[depth] = "value_or_end"
          i++
          continue
        }
        if (ch == "}") {
          if (depth == 0 || container[depth] != "object" \
              || !(state[depth] == "key_or_end" || state[depth] == "comma_or_end")) json_fail()
          if (response_depth == depth) {
            response_end = i
            response_depth = 0
          }
          delete container[depth]
          delete state[depth]
          delete object_key[depth]
          depth--
          i++
          continue
        }
        if (ch == "]") {
          if (depth == 0 || container[depth] != "array" \
              || !(state[depth] == "value_or_end" || state[depth] == "comma_or_end")) json_fail()
          if (response_depth == depth) {
            response_end = i
            response_depth = 0
          }
          delete container[depth]
          delete state[depth]
          depth--
          i++
          continue
        }
        if (ch == ":") {
          if (depth == 0 || container[depth] != "object" || state[depth] != "colon") json_fail()
          state[depth] = "value"
          i++
          continue
        }
        if (ch == ",") {
          if (depth == 0 || state[depth] != "comma_or_end") json_fail()
          if (container[depth] == "object") state[depth] = "key"
          else state[depth] = "value"
          i++
          continue
        }
        if (ch == "\"") {
          read_string(i)
          if (depth > 0 && container[depth] == "object" \
              && (state[depth] == "key_or_end" || state[depth] == "key")) {
            if (candidate_valid) object_key[depth] = candidate
            else object_key[depth] = ""
            state[depth] = "colon"
          } else {
            target = begin_value(i, 0)
            if (target) response_end = token_end
            if (depth == 0) root_kind = "scalar"
          }
          i = token_end + 1
          continue
        }
        if (ch == "t" && substr(document, i, 4) == "true") {
          literal = "true"
        } else if (ch == "f" && substr(document, i, 5) == "false") {
          literal = "false"
        } else if (ch == "n" && substr(document, i, 4) == "null") {
          literal = "null"
        } else literal = ""
        if (literal != "") {
          target = begin_value(i, 0)
          if (target) response_end = i + length(literal) - 1
          if (depth == 0) root_kind = "scalar"
          i += length(literal)
          continue
        }
        if (ch == "-" || ch ~ /^[0-9]$/) {
          read_number(i)
          target = begin_value(i, 0)
          if (target) response_end = token_end
          if (depth == 0) root_kind = "scalar"
          i = token_end + 1
          continue
        }
        json_fail()
      }
      if (depth != 0 || !root_done || root_kind != "object" \
          || !response_found || response_depth != 0 || response_end < response_start) json_fail()
      printf "%s", substr(document, response_start, response_end - response_start + 1)
    }
    {
      if (NR > 1) document = document "\n"
      document = document $0
    }
    END {
      if (failed) exit 1
      parse_document()
    }
  ' >"$response_tmp" 2>/dev/null; then
    cat "$response_tmp"
    response_status=$?
  else
    response_status=$?
  fi
  rm -f "$response_tmp"
  return "$response_status"
}

redact_response_whole_leaf_fail_closed() {
  whole_leaf_response=$1
  whole_leaf_redacted=
  if ! whole_leaf_redacted=$(redact_nonempty_response_strings "$whole_leaf_response"); then
    whole_leaf_redacted=
  fi
  if [ -z "$whole_leaf_redacted" ] \
      || [ "$whole_leaf_redacted" = "$whole_leaf_response" ]; then
    whole_leaf_redacted=
    if ! whole_leaf_redacted=$(redact_response_values_awk "$whole_leaf_response"); then
      whole_leaf_redacted=
    fi
  fi
  if [ -n "$whole_leaf_redacted" ] \
    && [ "$whole_leaf_redacted" != "$whole_leaf_response" ]; then
    printf '%s' "$whole_leaf_redacted"
    return 0
  fi
  return 1
}

rewrite_response_conservatively() {
  conservative_input=$1
  SAFE_REWRITE=
  if ! SAFE_REWRITE=$(redact_response_whole_leaf_fail_closed "$conservative_input"); then
    SAFE_REWRITE=
  fi
  [ -n "$SAFE_REWRITE" ] || block_failed_output_rewrite
}

emit_secret_free_post_tool_replacement() {
  audit_clear_live_probe_marker
  case "$(hook_host)" in
    codex)
      printf '%s\n' '{"decision":"block","reason":"Agent Guard blocked the original tool output because a sanitized replacement could not be serialized.","hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"Agent Guard blocked a sensitive tool output; the sanitized replacement could not be serialized safely."}}'
      ;;
    *)
      printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","updatedToolOutput":"[REDACTED]"}}'
      ;;
  esac
}

block_failed_output_rewrite() {
  audit_note error
  info "$PROGRAM: the tool output could not be serialized into a safe host replacement even with the conservative fallback"
  emit_secret_free_post_tool_replacement
  exit 0
}

emit_post_tool_replacement() {
  replacement=$1
  case "$(hook_host)" in
    codex)
      # Keep the potentially large updated output on stdin. Linux limits one
      # exec argument to roughly 128 KiB, so `--argjson ut "$replacement"`
      # can fail after a successful conservative whole-leaf rewrite. Capture
      # the complete envelope before printing so a jq failure cannot append a
      # fixed response after a partial JSON document.
      codex_envelope=
      if codex_envelope=$(printf '%s' "$replacement" \
        | jq -c '
            {decision: "block",
             reason: "Agent Guard blocked the original tool output because it contained sensitive values; use the sanitized replacement in additionalContext.",
             hookSpecificOutput: {
               hookEventName: "PostToolUse",
               additionalContext: ("Agent Guard sanitized tool output:\n" + (. | tojson))
             }}' 2>/dev/null); then
        printf '%s\n' "$codex_envelope"
      else
        emit_secret_free_post_tool_replacement
      fi
      ;;
    *)
      printf '%s' '{"hookSpecificOutput":{"hookEventName":"PostToolUse","updatedToolOutput":'
      printf '%s' "$replacement"
      printf '%s\n' '}}'
      ;;
  esac
}

recover_post_tool_validation_failure() {
  recovery_input=$1
  recovery_response=
  if ! recovery_response=$(extract_post_tool_response_awk "$recovery_input"); then
    recovery_response=
    return 1
  fi

  # The jq validator failed, so no scanner-dependent verdict is trustworthy.
  # Conservatively sanitize the entire response with the independent parser.
  recovery_output=
  if ! recovery_output=$(redact_response_values_awk "$recovery_response"); then
    recovery_output=
  fi
  if [ -z "$recovery_output" ]; then
    block_failed_output_rewrite
  fi

  audit_note masked
  emit_post_tool_replacement "$recovery_output"
  info "$PROGRAM: replaced the complete tool output after the primary PostToolUse JSON validator failed"
  return 0
}

# Mask PII inside ANY string leaf of the tool_response JSON ($1), preserving the
# original shape. The regex patterns mirror pii_regex_adapter_filter (the CLI
# adapter) so the hook and `agent-guard pii-filter` mask the same things; Tier-2
# (credit card / KR resident reg. no. / SSN) is masked first so a Tier-1 pattern
# can't shadow it, and KR mobile before the generic phone pattern. Oniguruma
# lookaround stands in for the digit boundaries mask_re() checks by hand in awk,
# and the Luhn filter for cards is the same rule expressed as a conditional
# gsub replacement — both must change with PII_AWK_LIB. Like the
# secret redactor, this masks string VALUES only — object KEYS are left as-is
# (masking keys risks collapsing distinct keys onto one placeholder); PII in a
# JSON key is a documented limitation (README). Prints the masked JSON, or
# nothing on failure (e.g. a jq build without Oniguruma gsub, or one whose
# Oniguruma lacks the lookbehind the boundaries need) — the caller then leaves
# the response unmasked. Only masking degrades that way: the input hard-block
# gate is the awk path, which needs no regex features beyond POSIX ERE.
mask_pii_response_json() {
  resp=$1
  trusted=${2:-[]}
  skip=$(pii_skip_set) || exit 2
  printf '%s' "$resp" \
    | jq -c --arg pii_skip "$skip" --argjson trusted "$trusted" "$JQ_WALK"'
    def keep($type): ($pii_skip | contains(",\($type),")) | not;
    def luhn:
      ([gsub("[^0-9]"; "") | explode | .[] | . - 48] | reverse
       | to_entries
       | map(if .key % 2 == 1
             then (.value * 2 | if . > 9 then . - 9 else . end)
             else .value end)
       | add) as $sum
      | $sum != null and $sum % 10 == 0;
    def mask_card($re): gsub($re;
      if (.pan | luhn) then "[PII:CREDIT_CARD]" else .pan end);
    def mask_pii:
      mask_card("(?<![0-9])(?<pan>[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{3})(?![0-9])")
      | mask_card("(?<![0-9])(?<pan>[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4})(?![0-9])")
      | mask_card("(?<![0-9])(?<pan>3[47][0-9]{2}[ -]?[0-9]{6}[ -]?[0-9]{5})(?![0-9])")
      | gsub("(?<![0-9])[0-9]{6}-[0-9]{7}(?![0-9])"; "[PII:KR_RRN]")
      | gsub("(?<![0-9])[0-9]{3}-[0-9]{2}-[0-9]{4}(?![0-9])"; "[PII:SSN]")
      | (if keep("IP_ADDRESS")
         then gsub("(?<![0-9])(?<![0-9]\\.)(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}(?![0-9])(?!\\.[0-9])"; "[PII:IP_ADDRESS]")
         else . end)
      | (if keep("EMAIL")
         then gsub("[A-Za-z0-9_%+.-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"; "[PII:EMAIL]")
         else . end)
      | (if keep("PHONE")
         then gsub("(?<![0-9])01[0-9][ -]?[0-9]{4}[ -]?[0-9]{4}(?![0-9])"; "[PII:PHONE]")
           | gsub("(?<![0-9])(\\+?[0-9][ .-]?)?(\\([0-9]{3}\\)|[0-9]{3})[ .-]?[0-9]{3}[ .-]?[0-9]{4}(?![0-9])"; "[PII:PHONE]")
         else . end);
    walk(if type == "string"
         then . as $value
              | if ($trusted | index($value)) == null then mask_pii else . end
         else . end)
  ' 2>/dev/null
}

# PostToolUse output guard. Applies, in one rewrite: secret-literal redaction
# (AGENT_GUARD_OUTPUT_REDACT, on by default) and PII masking
# (AGENT_GUARD_PII_HOOK_MODE=mask). Both transform the same tool_response and are
# emitted as a single updatedToolOutput, so they compose instead of racing for
# the one rewrite slot. PostToolUse cannot retract a completed tool result with
# exit status alone, so mandatory masking has a dependency-independent,
# shape-preserving fallback and emits one host-valid replacement.
redact_tool_output() {
  input=$1
  REDACT_OUTPUT_EMITTED=0
  # Validate the mode in the main shell (pii_hook_mode dies on an unsupported
  # value; the $(...) read below would otherwise swallow the exit and silently
  # leave PII unmasked). A misconfigured mode fails loud instead of fail-open.
  pii_hook_mode >/dev/null
  pii_skip_set >/dev/null
  secrets_on=0; pii_on=0
  output_redact_enabled && secrets_on=1
  [ "$(pii_hook_mode)" = mask ] && pii_on=1
  [ "$secrets_on" -eq 1 ] || [ "$pii_on" -eq 1 ] || return 0

  resp=
  if ! resp=$(printf '%s' "$input" | jq -c '.tool_response // empty' 2>/dev/null); then
    resp=
    if recover_post_tool_validation_failure "$input"; then
      REDACT_OUTPUT_EMITTED=1
      return 0
    fi
    block_failed_output_rewrite
  fi
  case "$resp" in
    ''|null) return 0 ;;
  esac

  # Image and PDF payloads are lifted out before every pass below and put back
  # afterwards: a text scanner cannot read pixels, the host forwards the bytes
  # rather than showing them to the model, and one screenshot alone crosses
  # the scan cap. Every pass preserves structure, so the paths collected here
  # are still valid on the rewritten result. The token gate spares large
  # high-cardinality output the path collection.
  resp_full=''
  conservative_done=0
  case "$resp" in
    *base64*|*mimeType*)
      r=
      if r=$(printf '%s' "$resp" \
        | jq -c "$JQ_SHAPE_SAFE_WALK"'strip_binary_payloads' 2>/dev/null); then
        if [ -n "$r" ] && [ "$r" != "$resp" ]; then
          resp_full=$resp
          resp=$r
        fi
      else
        r=
        rewrite_response_conservatively "$resp"
        resp=$SAFE_REWRITE
        conservative_done=1
      fi
      ;;
  esac

  out=$resp
  did_secret=0; did_pii=0

  [ "$conservative_done" -eq 1 ] && did_secret=1

  if [ "$secrets_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    r=
    if ! r=$(redact_nul_response_json "$out"); then
      r=
      rewrite_response_conservatively "$out"
      out=$SAFE_REWRITE
      conservative_done=1
      did_secret=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_secret=1
    fi
    if [ "$conservative_done" -eq 0 ] && output_scan_input_exceeds_cap "$out"; then
      rewrite_response_conservatively "$out"
      out=$SAFE_REWRITE
      conservative_done=1
      did_secret=1
    elif [ "$conservative_done" -eq 0 ] && large_response_has_secretish_assignment "$out"; then
      rewrite_response_conservatively "$out"
      out=$SAFE_REWRITE
      conservative_done=1
      did_secret=1
    elif [ "$conservative_done" -eq 0 ]; then
      secret_bundle=
      if ! secret_bundle=$(detect_output_secret_bundle "$out"); then
        secret_bundle=
        rewrite_response_conservatively "$out"
        out=$SAFE_REWRITE
        conservative_done=1
        did_secret=1
      elif [ -n "$secret_bundle" ]; then
        if ! classify_secret_bundle "$secret_bundle"; then
          rewrite_response_conservatively "$out"
          out=$SAFE_REWRITE
          conservative_done=1
          did_secret=1
        elif [ "$BUNDLE_MODE" = whole_leaf ]; then
          rewrite_response_conservatively "$out"
          out=$SAFE_REWRITE
          conservative_done=1
          did_secret=1
        elif [ "$BUNDLE_SECRETS" != '[]' ]; then
          secrets=$BUNDLE_SECRETS
          r=
          if ! r=$(redact_tool_response_json "$out" "$secrets"); then
            r=
          fi
          if [ -z "$r" ] || [ "$r" = "$out" ]; then
            rewrite_response_conservatively "$out"
            r=$SAFE_REWRITE
            conservative_done=1
          fi
          if [ -n "$r" ] && [ "$r" != "$out" ]; then out=$r; did_secret=1; fi
        fi
      fi
    fi
  fi

  if [ "$pii_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    trusted=
    if ! trusted=$(trusted_live_probe_replacements "$out"); then
      trusted='[]'
    fi
    case "$trusted" in ''|null) trusted='[]' ;; esac
    r=
    if ! r=$(mask_pii_response_json "$out" "$trusted"); then
      r=
      rewrite_response_conservatively "$out"
      out=$SAFE_REWRITE
      conservative_done=1
      did_pii=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_pii=1
    fi
  fi

  if [ "$secrets_on" -eq 1 ] && [ "$conservative_done" -eq 0 ]; then
    live_probe_id=
    if ! live_probe_id=$(live_probe_run_id); then
      live_probe_id=
    fi
    live_failed=0
    r=
    if ! r=$(redact_live_probe_response_json "$out" "$live_probe_id"); then
      r=
      live_failed=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      if ! response_drops_live_probe "$r"; then
        r=''
        live_failed=1
      elif [ -n "$live_probe_id" ] && ! audit_mark_live_probe; then
        # Provenance could not be persisted. Recompute without an id so a failed
        # marker cannot produce a replacement that later appears trustworthy.
        r=
        if ! r=$(redact_live_probe_response_json "$out" ''); then
          r=
          live_failed=1
        elif [ -z "$r" ] || [ "$r" = "$out" ] \
            || ! response_drops_live_probe "$r"; then
          r=''
          live_failed=1
        fi
      fi
    fi
    if [ "$live_failed" -eq 1 ]; then
      rewrite_response_conservatively "$out"
      out=$SAFE_REWRITE
      conservative_done=1
      did_secret=1
    elif [ -n "$r" ] && [ "$r" != "$out" ]; then
      out=$r
      did_secret=1
    fi
  fi

  [ "$did_secret" -eq 1 ] || [ "$did_pii" -eq 1 ] || return 0
  audit_note masked

  if [ -n "$resp_full" ]; then
    # Both documents ride stdin because the payloads are exactly the strings
    # that exceed Linux's ~128 KiB exec-argument limit. A bare "[REDACTED]"
    # fallback has no block to restore into and stands as-is.
    r=
    if r=$({ printf '%s\n%s\n' "$resp_full" "$out"; } 2>/dev/null \
      | jq -sc "$JQ_SHAPE_SAFE_WALK"'
          .[0] as $orig | .[1] | restore_binary_payloads($orig)
        ' 2>/dev/null); then
      [ -n "$r" ] && out=$r
    else
      r=
    fi
  fi

  emit_post_tool_replacement "$out"

  tool=
  if ! tool=$(json_value '.tool_name // "tool"' "$input"); then
    tool=tool
  fi
  if [ "$did_secret" -eq 1 ] && [ "$did_pii" -eq 1 ]; then
    info "$PROGRAM: masked secret-like values and PII in $tool output"
  elif [ "$did_pii" -eq 1 ]; then
    info "$PROGRAM: masked PII in $tool output"
  else
    info "$PROGRAM: masked secret-like values in $tool output"
  fi
  REDACT_OUTPUT_EMITTED=1
  return 0
}

# --- PostToolUse: scan the path this tool call actually wrote ----------------
# The working-tree backstop is git-shaped. `git diff` and `git ls-files --others
# --exclude-standard` both skip ignored paths, and neither reaches past the
# repository boundary, so a write to an ignored path, into another repository,
# or with no repository at all landed with no backstop behind it.
#
# PostToolUse knows the path the tool just wrote, so that ONE file is scanned
# directly when git would not have reached it. The scope is deliberately this
# tool call's target and nothing else: sweeping every ignored file would report
# the operator's own local credential files on every write, and an alert nobody
# can act on is how a scanner gets turned off.

# 10 MiB. PostToolUse gets ~20s from the host and a killed hook fails OPEN, so
# an unbounded file is a timeout, not a scan. Over-cap follows the same
# infrastructure policy as any other scan that could not run.
POST_TOOL_PATH_SCAN_MAX_BYTES=$SCAN_INPUT_MAX_BYTES

post_tool_write_target() {
  case "$2" in
    Write|Edit|MultiEdit)
      json_value '.tool_input.file_path // .tool_input.path // empty' "$1" ;;
    NotebookEdit)
      json_value '.tool_input.notebook_path // .tool_input.file_path // empty' "$1" ;;
    apply_patch)
      patch=$(printf '%s' "$1" | jq -r '
        .tool_input.command // .tool_input.patch // .tool_input.input //
        .tool_input.diff // .tool_input.content // empty |
        if type == "string" then . else tojson end
      ' 2>/dev/null) || return "$SCAN_STATUS_UNAVAILABLE"
      [ -n "$patch" ] || return "$SCAN_STATUS_UNAVAILABLE"
      printf '%s\n' "$patch" | LC_ALL=C awk '
        /^\*\*\* Delete File:/ { valid=1; next }
        /^\*\*\* (Add|Update) File:/ {
          path=$0; sub(/^\*\*\* (Add|Update) File:[ \t]*/, "", path)
          if (path == "") bad=1; else { count++; if (count > 128) exit 3; print path; valid=1 }
          next
        }
        /^\*\*\* Move to:/ {
          path=$0; sub(/^\*\*\* Move to:[ \t]*/, "", path)
          if (path == "") bad=1; else { count++; if (count > 128) exit 3; print path; valid=1 }
          next
        }
        END { if (bad || !valid) exit 3 }
      '
      ;;
  esac
}

# 0 = the working-tree backstop already covered this path, 1 = it did not.
# Anything that cannot be established (no repository, a different repository, a
# failed check) counts as NOT covered, so the direct scan runs rather than being
# skipped on a guess.
git_backstop_covers_path() {
  covers_path=$1
  covers_root=$2
  [ -n "$covers_root" ] || return 1
  covers_dir=$(dirname -- "$covers_path")
  [ -d "$covers_dir" ] || return 1
  covers_file_root=$(git -C "$covers_dir" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ "$covers_file_root" = "$covers_root" ] || return 1
  # Ignore status alone is not coverage: `git update-index --skip-worktree` and
  # `--assume-unchanged` leave a tracked file un-ignored while `git diff HEAD`
  # stops reporting it, so both scanners missed it. One `ls-files -v` answers
  # tracking, index state, and ignore status together, in place of the
  # check-ignore call rather than in addition to it.
  #   'H ' tracked and honored     -> `git diff HEAD` reports it, ignored or not
  #   '? ' untracked, not ignored  -> `ls-files --others` reports it
  # Everything else is uncovered and falls through to the direct scan: no line
  # at all (ignored and untracked, or a failed call), 'S ' (skip-worktree), a
  # lowercase letter (assume-unchanged), or any other index state.
  covers_state=$(git -C "$covers_dir" ls-files -v --cached --others \
    --exclude-standard -- "$covers_path" 2>/dev/null) || return 1
  case "$covers_state" in
    'H '*|'? '*) return 0 ;;
  esac
  return 1
}

scan_write_target_path() {
  target=$1
  scanned_root=$2
  [ -n "$target" ] || return 0
  # Resolve first: a symlink parked in an ignored directory must not launder
  # its target, and a link to a device or fifo must not become a blocking read.
  target=$(resolve_path "$(normalize_path "$target")")
  [ -f "$target" ] || return 0
  git_backstop_covers_path "$target" "$scanned_root" && return 0

  # An unreadable file makes `wc -c` fail and yields no count. Treating a
  # missing count as over-cap keeps both cases on the infrastructure policy
  # instead of silently reporting a clean scan that never happened.
  target_bytes=$(LC_ALL=C wc -c <"$target" 2>/dev/null | tr -d '[:space:]')
  case "$target_bytes" in
    ''|*[!0-9]*) return "$SCAN_STATUS_UNAVAILABLE" ;;
  esac
  if [ "$target_bytes" -gt "$POST_TOOL_PATH_SCAN_MAX_BYTES" ]; then
    info "$PROGRAM: $target is too large to scan within the hook timeout (limit $POST_TOOL_PATH_SCAN_MAX_BYTES bytes; AGENT_GUARD_SCAN_INPUT_MAX_BYTES raises it)"
    return "$SCAN_STATUS_UNAVAILABLE"
  fi

  target_snapshot=$(mktemp_file) || return "$SCAN_STATUS_UNAVAILABLE"
  if cat -- "$target" >"$target_snapshot"; then
    filter_lockfile_hashes "$target" "$target_snapshot" \
      | run_gitleaks_stdin "file written by the tool: $target"
    target_status=$?
  else
    target_status=$SCAN_STATUS_UNAVAILABLE
  fi
  rm -f "$target_snapshot"
  return "$target_status"
}

scan_post_tool_write_target() {
  input=$1
  tool=$2
  workdir=$3
  trust_git_backstop=${4:-0}
  case "$tool" in
    Write|Edit|MultiEdit|NotebookEdit)
      if printf '%s' "$input" | jq -e '
        (.tool_input.file_path // .tool_input.path //
         .tool_input.notebook_path // "") as $p |
        ($p | type) == "string" and ($p | explode | any(. < 32))
      ' >/dev/null 2>&1; then
        handle_git_infrastructure_failure "$input" \
          "$PROGRAM: the file path written by this tool call contains unsupported control characters;"
        return 0
      fi
      target=$(post_tool_write_target "$input" "$tool")
      target_extract_status=$?
      if [ "$target_extract_status" -ne 0 ]; then
        handle_git_infrastructure_failure "$input" \
          "$PROGRAM: the file path written by this tool call could not be determined;"
        return 0
      fi
      [ -n "$target" ] || return 0
      (
        [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null \
          || exit "$SCAN_STATUS_UNAVAILABLE"
        scanned_root=
        [ "$trust_git_backstop" -eq 1 ] && scanned_root=$(git rev-parse --show-toplevel 2>/dev/null) || scanned_root=
        scan_write_target_path "$target" "$scanned_root"
      )
      case "$?" in
        0) return 0 ;;
        1) info "$PROGRAM: the file this tool call wrote contains secret-like values"; return 1 ;;
        *)
          handle_git_infrastructure_failure "$input" \
            "$PROGRAM: the file this tool call wrote could not be scanned;"
          return 0
          ;;
      esac
      ;;
  esac
  targets=$(post_tool_write_target "$input" "$2")
  target_extract_status=$?
  [ "$target_extract_status" -eq 0 ] || {
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be determined;"
    return 0
  }
  [ -n "$targets" ] || return 0
  targets_file=$(mktemp_file) || {
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be scanned;"
    return 0
  }
  printf '%s\n' "$targets" >"$targets_file" || {
    rm -f "$targets_file"
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: the file paths written by this tool call could not be scanned;"
    return 0
  }
  target_result=0
  target_total_bytes=0
  target_count=0
  while IFS= read -r target || [ -n "$target" ]; do
    [ -n "$target" ] || continue
    target_count=$((target_count + 1))
    if [ "$target_count" -gt 128 ]; then
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    one_bytes=$(
      [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null || exit 3
      resolved_target=$(resolve_path "$(normalize_path "$target")")
      scanned_root=
      [ "$trust_git_backstop" -eq 1 ] && scanned_root=$(git rev-parse --show-toplevel 2>/dev/null) || scanned_root=
      if git_backstop_covers_path "$resolved_target" "$scanned_root"; then
        printf covered
        exit 0
      fi
      if [ -f "$resolved_target" ]; then
        LC_ALL=C wc -c <"$resolved_target" 2>/dev/null | tr -d '[:space:]'
      else
        printf 0
      fi
    )
    size_status=$?
    [ "$one_bytes" != covered ] || continue
    case "$one_bytes" in ''|*[!0-9]*) size_status=3 ;; esac
    if [ "$size_status" -ne 0 ]; then
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    [ -n "$one_bytes" ] && target_total_bytes=$((target_total_bytes + one_bytes))
    if [ "$target_total_bytes" -gt "$POST_TOOL_PATH_SCAN_MAX_BYTES" ]; then
      info "$PROGRAM: apply_patch direct-scan targets exceed the scan input limit of $POST_TOOL_PATH_SCAN_MAX_BYTES bytes; raise AGENT_GUARD_SCAN_INPUT_MAX_BYTES only within the host hook timeout"
      [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE"
      continue
    fi
    (
      [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null \
        || exit "$SCAN_STATUS_UNAVAILABLE"
      scanned_root=
      [ "$trust_git_backstop" -eq 1 ] && scanned_root=$(git rev-parse --show-toplevel 2>/dev/null) || scanned_root=
      scan_write_target_path "$target" "$scanned_root"
    )
    target_status=$?
    case "$target_status" in
      0) ;;
      1) target_result=1 ;;
      *) [ "$target_result" -eq 0 ] && target_result="$SCAN_STATUS_UNAVAILABLE" ;;
    esac
  done <"$targets_file"
  rm -f "$targets_file"
  case "$target_result" in
    0) return 0 ;;
    1)
      info "$PROGRAM: the file this tool call wrote contains secret-like values"
      return 1
      ;;
    *)
      handle_git_infrastructure_failure "$input" \
        "$PROGRAM: the file this tool call wrote could not be scanned;"
      ;;
  esac
}

hook_post_tool() {
  input=$(read_stdin)
  HOOK_EVENT=PostToolUse
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    if ! printf '%s' "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
      if recover_post_tool_validation_failure "$input"; then
        return 0
      fi
      validate_hook_object PostToolUse "$input" || return 0
    fi
  fi
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning PostToolUse "$input"
    return 0
  fi
  need_cmd jq
  [ -n "$input" ] || return 0

  # Same recovery PreToolUse does (#227). A host may serialize tool_input as a
  # JSON-encoded string; the precise-field extractors then find nothing, so
  # `post_tool_write_target` yielded an empty path and the direct file scan was
  # skipped without a word — a gitignored or out-of-repo write got neither the
  # git backstop nor the direct scan. Only an object is substituted, matching
  # PreToolUse: a string that decodes to an array/scalar, or to nothing, is left
  # alone so the generic string-leaf scanners still see it.
  if [ "$(json_value '.tool_input | type' "$input")" = "string" ]; then
    input=$(printf '%s' "$input" \
      | jq -c '(.tool_input | try fromjson catch null) as $decoded
               | if ($decoded | type) == "object" then .tool_input = $decoded else . end')
    HOOK_INPUT=$input
  fi

  tool=$(json_value '.tool_name // .tool // .name // empty' "$input")
  workdir=$(json_value '.tool_input.workdir // .tool_input.cwd // .cwd // empty' "$input")

  # Mutation tools keep the working-tree backstop. It runs first so a secret
  # written to disk is recorded even when the same event also needs an output
  # rewrite; a disk-only finding still exits 2 below.
  post_tool_disk_finding=0
  if is_mutation_tool "$tool"; then
    git_backstop_ok=0
    if ! command -v git >/dev/null 2>&1; then
      handle_git_infrastructure_failure "$input" \
        "$PROGRAM: git is unavailable, so changed files could not be scanned;"
    else
      (
        [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null \
          || exit "$SCAN_STATUS_UNAVAILABLE"
        inside_git_repo || exit 0
        scan_working_tree
      )
      status=$?
      case "$status" in
        0) git_backstop_ok=1 ;;
        1)
          info "$PROGRAM: changed files contain secret-like values after tool execution"
          audit_note blocked
          post_tool_disk_finding=1
          ;;
        *)
          handle_git_infrastructure_failure "$input" \
            "$PROGRAM: changed files could not be scanned after tool execution;"
          ;;
      esac
    fi
    # Second backstop for what the git-shaped one structurally cannot see.
    scan_post_tool_write_target "$input" "$tool" "$workdir" "$git_backstop_ok"
    post_target_status=$?
    if [ "$post_target_status" -eq 1 ]; then
      audit_note blocked
      post_tool_disk_finding=1
    fi
  fi

  # All matched tools: mask secret-like values (and PII, when
  # AGENT_GUARD_PII_HOOK_MODE=mask) using the selected host's output contract.
  redact_tool_output "$input"
  if [ "$post_tool_disk_finding" -eq 1 ] \
    && [ "$REDACT_OUTPUT_EMITTED" -eq 0 ]; then
    exit 2
  fi
}

hook_stop() {
  input=$(read_stdin)
  HOOK_EVENT=Stop
  HOOK_INPUT=$input
  if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    validate_hook_object Stop "$input" || return 0
  fi
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning Stop "$input"
    return 0
  fi
  need_cmd jq
  if [ -n "$input" ]; then
    active=$(json_value '.stop_hook_active // false' "$input")
    if [ "$active" = "true" ]; then
      info "$PROGRAM: stop hook already active; skipping repeat scan to avoid a loop"
      return 0
    fi
  fi

  if ! command -v git >/dev/null 2>&1; then
    handle_git_infrastructure_failure "$input" \
      "$PROGRAM: git is unavailable, so changed files could not be scanned before stop;"
    return 0
  fi
  workdir=$(json_value '.tool_input.workdir // .tool_input.cwd // .cwd // empty' "$input")
  (
    [ -z "$workdir" ] || CDPATH= cd -- "$workdir" 2>/dev/null \
      || exit "$SCAN_STATUS_UNAVAILABLE"
    inside_git_repo || exit 0
    scan_working_tree
  )
  status=$?
  case "$status" in
    0) return 0 ;;
    1) info "$PROGRAM: changed files contain secret-like values before stop"; exit 2 ;;
    *)
      handle_git_infrastructure_failure "$input" \
        "$PROGRAM: changed files could not be scanned before stop;"
      ;;
  esac
}

# --- hook-user-prompt: keep pasted secrets out of the model context -----------
# The tool hooks never see the USER's own prompt, so a pasted `.env` or API key
# reaches the model API and the on-disk transcript unscanned. UserPromptSubmit
# fires before that happens on both hosts. Neither host documents a way for a
# hook to REWRITE the submitted prompt (Claude's UserPromptSubmit supports only
# block/deny and added context; Codex documents block + context), so `mask` is
# accepted as a mode but degrades to block everywhere today. It exists so a
# configured preference survives a future host that adds prompt rewriting.

prompt_guard_mode() {
  case "${AGENT_GUARD_PROMPT_GUARD_MODE:-block}" in
    block|mask|warn|off) printf '%s' "${AGENT_GUARD_PROMPT_GUARD_MODE:-block}" ;;
    *) die "unsupported prompt guard mode: ${AGENT_GUARD_PROMPT_GUARD_MODE} (expected off, block, mask, or warn)" ;;
  esac
}

# Detection = gitleaks (rule-based) OR the streaming secret-ish KEY=value
# assignment probe. The probe is what catches a pasted .env whose custom value
# formats gitleaks has no rule for — the single most common prompt-leak shape.
prompt_has_secretish_assignment() {
  printf '%s' "$1" \
    | frame_plaintext_leaf 2>/dev/null \
    | secretish_env_values probe \
    | grep -q .
}

# The single hook response, whatever combination of facts produced it. A hook
# may write at most one top-level JSON object, so the infrastructure notice and
# the mode-specific message share one: additionalContext (the model-facing
# channel both hosts document) carries both, and systemMessage — a Claude-only
# field — carries the mode-specific message, matching how the other hooks
# report an infrastructure failure to the user on stderr rather than in the UI.
# Prints nothing when there is nothing to say.
emit_prompt_response() {
  notice=$1
  message=$2
  if [ -n "$notice" ] && [ -n "$message" ]; then
    context="$notice $message"
  else
    context="$notice$message"
  fi
  [ -n "$context" ] || return 0
  if [ -n "$message" ] && [ "$(hook_host)" != codex ]; then
    jq -nc --arg m "$message" --arg c "$context" \
      '{systemMessage: $m,
        hookSpecificOutput: {hookEventName: "UserPromptSubmit",
                             additionalContext: $c}}'
  else
    jq -nc --arg c "$context" \
      '{hookSpecificOutput: {hookEventName: "UserPromptSubmit",
                             additionalContext: $c}}'
  fi
}

hook_user_prompt() {
  input=$(read_stdin)
  HOOK_EVENT=UserPromptSubmit
  HOOK_INPUT=$input
  # Validate both modes in the main shell (die inside $() would only exit the
  # subshell and silently fail-open, exactly the hazard check_pii_hook_input
  # and redact_tool_output guard against).
  prompt_guard_mode >/dev/null
  pii_hook_mode >/dev/null
  pii_skip_set >/dev/null
  prompt_mode=$(prompt_guard_mode)
  if ! hook_dependencies_ready; then
    emit_degraded_hook_warning UserPromptSubmit "$input"
    return 0
  fi
  need_cmd jq
  [ -n "$input" ] || return 0
  # A jq failure is an infrastructure failure, not an empty benign prompt.
  # Check the substitution in the parent shell so the closed policy can block;
  # the default open policy emits one host-shaped notice and returns.
  if ! prompt=$(json_value '.prompt // empty' "$input" 2>/dev/null); then
    begin_infrastructure_failure "$input" \
      "$PROGRAM: the prompt hook input could not be parsed;"
    notice=$INFRA_FAILURE_NOTICE
    emit_prompt_response "$notice" ''
    return 0
  fi
  [ -n "$prompt" ] || return 0

  # The PII input gate is governed by AGENT_GUARD_PII_HOOK_MODE alone and stays
  # active even when the secret guard is off: block mode blocks any PII; mask
  # mode hard-blocks Tier-2. Tier-1 PII cannot be masked in a prompt (no host
  # rewrite exists), a documented limitation.
  block_on_pii_text "user prompt" "$prompt"
  [ "$prompt_mode" != off ] || return 0

  # An infrastructure notice raised here is ACCUMULATED, not printed: warn mode
  # still has its own response to write, and two concatenated top-level objects
  # are not a valid hook response — a host that parses stdout as one document
  # drops the warning entirely, exactly when the scanner is already degraded.
  # emit_prompt_response folds both messages into the single allowed object.
  notice=
  found=0
  scan_text_direct "user prompt" "$prompt"
  case $? in
    0) ;;
    1) found=1 ;;
    "$SCAN_STATUS_UNAVAILABLE")
      begin_infrastructure_failure "$input" \
        "$PROGRAM: scanner infrastructure could not verify the prompt;"
      notice=$INFRA_FAILURE_NOTICE
      ;;
    *)
      begin_infrastructure_failure "$input" \
        "$PROGRAM: the prompt scanner failed;"
      notice=$INFRA_FAILURE_NOTICE
      ;;
  esac
  if [ "$found" -eq 0 ]; then
    # The assignment probe is super-linear on one large leaf (measured ~0.6s at
    # 128KB but ~23s at 874KB), which would burn the 10s host timeout and make
    # the host kill the hook — a silent fail-open. Above the shared scan cap,
    # skip the probe and route through the infra-failure policy instead:
    # open warns once and keeps the gitleaks verdict; closed blocks.
    if output_scan_input_exceeds_cap "$prompt"; then
      begin_infrastructure_failure "$input" \
        "$PROGRAM: the prompt exceeds the assignment-probe scan cap (gitleaks rules were still applied);"
      notice=${notice:-$INFRA_FAILURE_NOTICE}
    elif prompt_has_secretish_assignment "$prompt"; then
      found=1
    fi
  fi
  if [ "$found" -ne 1 ]; then
    emit_prompt_response "$notice" ''
    return 0
  fi

  case "$prompt_mode" in
    warn)
      audit_note warned
      emit_prompt_response "$notice" \
        "$PROGRAM: the submitted prompt contains secret-like values; they were passed through because AGENT_GUARD_PROMPT_GUARD_MODE=warn"
      return 0
      ;;
    mask)
      info "$PROGRAM: no host supports rewriting a submitted prompt yet, so mask degrades to block; remove the secret-like values and resubmit"
      exit 2
      ;;
    *)
      info "$PROGRAM: blocked user prompt: it contains secret-like values; remove them and resubmit (AGENT_GUARD_PROMPT_GUARD_MODE controls this)"
      exit 2
      ;;
  esac
}

# --- hook-session-start: report degraded setup and shell-integration drift ----
# The plugin and the binary the shell integration (agx / command wrapping) resolves at
# runtime update independently, so updating one side silently leaves masking on
# the OLD rules while the hooks look current — an invisible failure. Instead of
# re-deriving which binary masks (a proxy this hook can't get right — it can't
# see the baked path, and would nag a CLI-on-$PATH user who never enabled the
# integration), `shell-init` EXPORTS the version it actually resolved at rc-eval
# time as $AGENT_GUARD_SHELL_INIT_VERSION; this hook just compares that marker to
# the plugin's own version. See README for the full false-pos/neg rationale.
#
# Env inheritance (verified against the Claude Code hooks docs): a command hook
# inherits the `claude` process env, which inherits the launching shell's
# exported vars — so the rc-set marker reaches this hook. In 2.x an absent marker
# triggers Claude-only setup guidance because command wrapping is default-on;
# Codex remains silent because it does not use this shell boundary.
#
# SessionStart is non-mutating: it reports missing dependencies and directs the
# host to the approval-gated setup skill. Claude also reports shell-wrapper
# version drift; Codex ignores that unrelated shell boundary. The Codex variant
# duplicates host-independent warnings in additionalContext so the model can act
# on them; both hosts receive a user-facing systemMessage.

# Classify `setup-shell`'s managed block in one rc file: 0 = the block is there
# AND can still load, 2 = the block is there but the binary it resolves is gone,
# 1 = no usable block at all.
#
# The marker only reaches this hook when the shell that LAUNCHED the agent
# evaluated that rc — which never happens for a fish (or any non-POSIX) login
# shell, or when Claude Code is started from a GUI/IDE launcher, even though
# Claude Code builds its `!`/Bash snapshot from bash or zsh and so DOES load the
# wrapping. An absent marker is therefore not evidence that the wrapping is
# missing. But the delimiters alone are not evidence that it LOADS either: the
# block's `eval` emits nothing when the binary it resolves has disappeared (cache
# updated, plugin uninstalled, block hand-edited), leaving neither the wrapping
# nor the marker — a silent, unprotected session. So re-run the block's OWN
# resolution order against the paths it baked in: the stable/self path, then the
# newest versioned binary under the plugin cache base, then `agent-guard` on
# $PATH. All stat-level; nothing is executed and no subshell is forked.
shell_init_rc_block_state() {
  rc_probe=$1
  # Both delimiters must be present, or the block is not a block (setup-shell
  # itself refuses to rewrite an unbalanced one).
  block=$(awk -v b="$SHELL_INIT_BLOCK_BEGIN" -v e="$SHELL_INIT_BLOCK_END" \
    '$0==b{inb=1;next} $0==e&&inb{found=1;inb=0;next} inb{print} END{exit !found}' \
    "$rc_probe" 2>/dev/null) || return 1
  # Delimiters wrapping something that never invokes shell-init protect nothing.
  case "$block" in *shell-init*) ;; *) return 2 ;; esac

  # The baked words are emitted by sh_squote, so read up to the closing quote. A
  # path containing a quote truncates here and reads as unresolvable — the safe
  # direction: a false "run setup" is recoverable, a false "you are protected"
  # is not.
  agbin= agbase=
  case "$block" in
    *"_agbin='"*) agbin=${block#*_agbin=\'}; agbin=${agbin%%\'*} ;;
  esac
  case "$block" in
    *"_agbase='"*) agbase=${block#*_agbase=\'}; agbase=${agbase%%\'*} ;;
  esac
  [ -n "$agbin" ] && [ -x "$agbin" ] && return 0
  if [ -n "$agbase" ]; then
    for rc_cand in "$agbase"/[0-9]*.[0-9]*.[0-9]*/bin/agent-guard; do
      [ -x "$rc_cand" ] && return 0
    done
  fi
  command -v agent-guard >/dev/null 2>&1 && return 0
  return 2
}

# Choose the rc whose snapshot matters. setup-shell also consults the account
# login shell; if either reading says fish, it installs both POSIX rc files
# because the eventual bash/zsh snapshot choice is not visible while setup is
# running. The hook can likewise still receive a fish $SHELL. In that case one
# healthy rc cannot prove the unknown snapshot is protected, so require both.
# State 3 means exactly that partial fish coverage: rerunning setup-shell must
# restore both files before SessionStart can stay quiet.
shell_init_block_state() {
  [ -n "${HOME:-}" ] || return 1
  case "${SHELL:-}" in
    */bash) shell_init_rc_block_state "$HOME/.bashrc" ;;
    */fish)
      shell_init_rc_block_state "$HOME/.bashrc"
      bash_rc_state=$?
      shell_init_rc_block_state "$HOME/.zshrc"
      zsh_rc_state=$?
      [ "$bash_rc_state" -eq 0 ] && [ "$zsh_rc_state" -eq 0 ] && return 0
      [ "$bash_rc_state" -eq 1 ] && [ "$zsh_rc_state" -eq 1 ] && return 1
      if [ "$bash_rc_state" -eq 0 ] || [ "$zsh_rc_state" -eq 0 ]; then
        return 3
      fi
      return 2
      ;;
    *) shell_init_rc_block_state "$HOME/.zshrc" ;;
  esac
}

hook_session_start() {
  message=
  if ! hook_dependencies_ready || ! command -v git >/dev/null 2>&1; then
    message=$(degraded_hook_message)
  fi

  marker=${AGENT_GUARD_SHELL_INIT_VERSION:-}
  # Accept only a digit-led version token drawn from a safe charset: an empty or
  # unparseable marker fails quiet, and the charset keeps the hand-built JSON
  # below injection-safe (no quotes/backslashes/whitespace to escape).
  if [ "$(hook_host)" = claude ]; then
    case $marker in
      ''|[!0-9]*|*[!0-9A-Za-z.+-]*) ;;
      *)
        if [ "$marker" != "$VERSION" ]; then
          drift="agent-guard plugin hooks are $VERSION but the Claude shell integration masks with $marker. Update whichever is older, then rerun agent-guard setup-shell."
          if [ -n "$message" ]; then message="$message $drift"; else message=$drift; fi
        fi
        ;;
    esac
  fi

  # Claude plugins cannot edit the user's shell rc during installation. In 2.x
  # command wrapping is default-on, so an absent marker means the one-time shell
  # setup has not run — UNLESS the managed block is already in the rc AND can
  # still load, in which case the marker is merely unable to travel (fish/other
  # login shell, GUI or IDE launcher) while the snapshot still loads the
  # wrapping. Nagging there is a permanent false positive that rerunning
  # setup-shell cannot clear, so that case stays quiet and only the drift check
  # above is lost. A block that can no longer resolve its binary gets its own
  # wording: the user action is to restore the binary, not to discover setup.
  # Keep Codex silent: Claude shell snapshots are not a Codex command boundary.
  if [ -z "$marker" ] && [ "$(hook_host)" = claude ]; then
    shell_init_block_state
    case $? in
      0) wrapping_setup= ;;
      2) wrapping_setup='agent-guard command wrapping is set up in your shell rc but can no longer load: the agent-guard binary that block resolves is gone (plugin cache updated, uninstalled, or the block was edited). Command output is NOT masked. Reinstall or update agent-guard, rerun /agent-guard:setup-shell (or agent-guard setup-shell for a standalone install), then restart the shell and Claude Code.' ;;
      3) wrapping_setup='agent-guard command wrapping for a fish shell does not cover both .bashrc and .zshrc, so the host snapshot may be unprotected. Command output is NOT masked unless the snapshot chose the surviving rc. Rerun /agent-guard:setup-shell (or agent-guard setup-shell for a standalone install), then restart the shell and Claude Code.' ;;
      *) wrapping_setup='agent-guard command wrapping is not loaded. Run /agent-guard:setup-shell (or agent-guard setup-shell for a standalone install), then restart the shell and Claude Code. Use setup-shell --no-command-wrapping for a persistent opt-out.' ;;
    esac
    if [ -n "$wrapping_setup" ]; then
      if [ -n "$message" ]; then message="$message $wrapping_setup"; else message=$wrapping_setup; fi
    fi
  fi

  [ -n "$message" ] || return 0
  case "$(hook_host)" in
    codex)
      printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$message" "$message"
      ;;
    *) printf '{"systemMessage":"%s"}\n' "$message" ;;
  esac
}

# --- exec: mask secrets/PII in a shell-escape command's captured output -------
# Threat model: in Claude Code, a `!`-prefixed command runs in the session shell
# and its OUTPUT is captured into the transcript and sent to the model, but NO
# agent-guard hook fires for `!` (a documented blind spot). The user is fine with
# the command running and seeing its output themselves; the risk is secret-bearing
# output reaching the model. `agent-guard exec` closes that gap: it first checks
# that masking is available (and fails closed before execution when it is not),
# then captures combined stdout+stderr, masks secret-like values (and PII, when
# enabled), prints the REDACTED text, and propagates the command's exit code.
# Capture is BUFFERED, so this is for NON-INTERACTIVE info
# commands (env / secret / config dumps), not TUIs or streaming programs.

# Apply collision-safe framed secret records from $2 to plaintext $1,
# de-duplicating context-aware mappings and sorting within each mapping class.
redact_plaintext_framed() {
  text=$1
  secret_file=$2
  printf '%s' "$text" | LC_ALL=C awk -v secret_file="$secret_file" '
    function add_mapping(literal, replacement, contextual, key) {
      key = contextual ":" length(literal) ":" literal \
        ":" length(replacement) ":" replacement
      if (length(literal) > 0 && !seen[key]) {
        seen[key] = 1
        lit[++count] = literal
        rep[count] = replacement
        ctx[count] = contextual
      }
    }
    function consume_record(value, tag, payload) {
      tag = substr(value, 1, 1)
      payload = substr(value, 2)
      if (tag == "S") add_mapping(payload, "[REDACTED]", 0)
      else if (tag == "L") pending_literal = payload
      else if (tag == "R") {
        add_mapping(pending_literal, payload, 1)
        pending_literal = ""
      }
    }
    function feed_framed(line, i, ch) {
      record_ended_at_boundary = 0
      for (i = 1; i <= length(line); i++) {
        ch = substr(line, i, 1)
        if (escaped) {
          record = record ch
          escaped = 0
          record_ended_at_boundary = 0
        } else if (ch == escape) {
          escaped = 1
          record_ended_at_boundary = 0
        } else if (ch == boundary) {
          consume_record(record)
          record = ""
          record_ended_at_boundary = 1
        } else {
          record = record ch
          record_ended_at_boundary = 0
        }
      }
      if (!record_ended_at_boundary) record = record "\n"
    }
    BEGIN {
      boundary = sprintf("%c", 30)
      escape = sprintf("%c", 31)
      while ((status = getline line < secret_file) > 0) feed_framed(line)
      close(secret_file)
      if (status < 0) read_error = 1
      for (i = 2; i <= count; i++) {
        value = lit[i]
        replacement = rep[i]
        contextual = ctx[i]
        j = i - 1
        while (j >= 1 &&
               (ctx[j] < contextual ||
                (ctx[j] == contextual &&
                 length(lit[j]) < length(value)))) {
          lit[j + 1] = lit[j]
          rep[j + 1] = rep[j]
          ctx[j + 1] = ctx[j]
          j--
        }
        lit[j + 1] = value
        rep[j + 1] = replacement
        ctx[j + 1] = contextual
      }
    }
    { buf = (NR == 1 ? $0 : buf ORS $0) }
    END {
      if (read_error) exit 2
      if (count > 256 || count * (length(buf) + 1) > 8000000) exit 3
      for (i = 1; i <= count; i++) {
        value = lit[i]
        replacement = rep[i]
        contextual = ctx[i]
        out = ""
        at = index(buf, value)
        while (at > 0) {
          after = substr(buf, at + length(value), 1)
          if (!contextual || after == "" || after == ORS ||
              after ~ /[ \t,;]/)
            out = out substr(buf, 1, at - 1) replacement
          else
            out = out substr(buf, 1, at - 1) value
          buf = substr(buf, at + length(value))
          at = index(buf, value)
        }
        buf = out buf
      }
      printf "%s", buf
    }
  '
}

# Literal (non-regex) replacement of every detected secret in $1 with [REDACTED],
# processing longest-first so a shorter secret that is a prefix of a longer one
# cannot strand the tail (mirrors the rationale in redact_tool_response_json).
# The secret list is a de-duplicated JSON string array. jq orders and frames it;
# byte-oriented awk applies literal index()/substr() replacement so unrelated
# non-UTF-8 output is preserved. Prints the redacted text with no added trailing
# newline (the caller re-adds one).
redact_plaintext_literal() {
  text=$1
  secrets=$2
  secret_file=$(mktemp_file) || return 1
  if ! printf '%s' "$secrets" \
    | jq -c '
        map(if type == "string"
            then ["S" + .]
            elif (type == "object"
                  and (.literal | type) == "string"
                  and (.replacement | type) == "string")
            then ["L" + .literal, "R" + .replacement]
            else []
            end)
        | (add // [])
      ' 2>/dev/null \
    | frame_json_string_leaves >"$secret_file" 2>/dev/null; then
    rm -f "$secret_file"
    return 1
  fi

  redact_plaintext_framed "$text" "$secret_file"
  status=$?
  rm -f "$secret_file"
  return "$status"
}

do_exec() {
  [ "${1:-}" = "--" ] && shift
  if [ "$#" -eq 0 ]; then
    {
      printf '%s\n' "Usage: $PROGRAM exec [--] <cmd> [args...]"
      printf '%s\n' "Runs <cmd>, captures combined stdout+stderr (BUFFERED; for"
      printf '%s\n' "non-interactive info commands), masks secret-like values and"
      printf '%s\n' "PII, prints the redacted output, then exits with <cmd>'s status."
    } >&2
    exit 2
  fi

  # Validate the PII mode up front so a misconfiguration fails loud (pii_hook_mode
  # dies on an unsupported value) instead of silently leaving PII unmasked.
  pii_hook_mode >/dev/null
  pii_skip_set >/dev/null
  if output_redact_enabled; then
    need_cmd jq
    need_gitleaks
  fi
  if [ "$(pii_hook_mode)" = mask ]; then
    need_cmd awk
  fi

  out=$("$@" 2>&1)
  status=$?

  masked=$out

  # Secret-literal redaction (AGENT_GUARD_OUTPUT_REDACT, default mask). Fail-safe:
  # on any error the original output is preserved rather than swallowed.
  if output_redact_enabled; then
    invalid_output=0
    output_fully_masked=0
    response=''
    # Avoid materializing oversized plaintext as JSON or invoking any detector;
    # match PostToolUse by conservatively masking it before bounded scan work.
    if output_scan_input_exceeds_cap "$masked"; then
      masked='[REDACTED]'
      output_fully_masked=1
    else
      # Keep detection input tied to the original capture. The raw assignment
      # pass below may insert [REDACTED], which must not become a new candidate.
      response=$(printf '%s' "$masked" | jq -Rs . 2>/dev/null) || response=''

      # Scan assignment-shaped plaintext before jq-decoded records only when jq
      # cannot round-trip the captured bytes. jq replaces invalid UTF-8 with
      # U+FFFD, which would otherwise make that secret literal impossible to
      # match. Valid text stays on the established single replacement path.
      decoded=$(printf '%s' "$response" | jq -rj . 2>/dev/null) || decoded=''
      if [ "$decoded" != "$masked" ]; then
        invalid_output=1
        if printenv_requests_secretish_name "$@"; then
          masked='[REDACTED]'
          output_fully_masked=1
        else
          raw_bytes=$(printf '%s' "$masked" | LC_ALL=C wc -c | tr -d ' ')
          case "$raw_bytes" in
            ''|*[!0-9]*)
              masked='[REDACTED]'
              output_fully_masked=1
              ;;
            *)
              if [ "$raw_bytes" -gt 65536 ]; then
                if printf '%s' "$masked" \
                  | secretish_env_values probe_raw 2>/dev/null \
                  | grep -q .; then
                  masked='[REDACTED]'
                  output_fully_masked=1
                fi
              else
                raw_secret_file=$(mktemp_file) || raw_secret_file=''
                if [ -z "$raw_secret_file" ]; then
                  masked='[REDACTED]'
                  output_fully_masked=1
                else
                  if ! printf '%s' "$masked" \
                    | frame_plaintext_leaf \
                    | secretish_env_values framed >"$raw_secret_file" 2>/dev/null; then
                    masked='[REDACTED]'
                    output_fully_masked=1
                  elif [ -s "$raw_secret_file" ]; then
                    if r=$(redact_plaintext_framed \
                      "$masked" "$raw_secret_file" 2>/dev/null) \
                      && [ -n "$r" ]; then
                      masked=$r
                    else
                      masked='[REDACTED]'
                      output_fully_masked=1
                    fi
                  fi
                  rm -f "$raw_secret_file"
                fi
              fi
              ;;
          esac
        fi
      fi
    fi

    secret_bundle=''
    if [ "$output_fully_masked" -eq 0 ]; then
      # The raw pass already handled invalid-byte assignments exactly. The
      # bundle helper skips only that JSON env heuristic while keeping every
      # detector and bundler stage atomic.
      if ! secret_bundle=$(detect_exec_secret_bundle \
        "$response" "$invalid_output" "$@"); then
        masked='[REDACTED]'
        output_fully_masked=1
        secret_bundle=''
      fi
    fi
    if [ -n "$secret_bundle" ]; then
      if ! classify_secret_bundle "$secret_bundle"; then
        masked='[REDACTED]'
        output_fully_masked=1
      elif [ "$BUNDLE_MODE" = whole_leaf ]; then
        masked='[REDACTED]'
        output_fully_masked=1
      elif [ "$BUNDLE_SECRETS" != '[]' ]; then
        secrets=$BUNDLE_SECRETS
        if r=$(redact_plaintext_literal "$masked" "$secrets" 2>/dev/null) \
          && [ -n "$r" ]; then
          masked=$r
        else
          masked='[REDACTED]'
          output_fully_masked=1
        fi
      fi
    fi
  fi

  # PII masking (AGENT_GUARD_PII_HOOK_MODE=mask), reusing the same CLI masker the
  # pii-filter subcommand uses. Fail-safe: keep the prior text if it errors.
  if [ "$(pii_hook_mode)" = mask ]; then
    r=$(printf '%s' "$masked" | pii_regex_adapter_filter 2>/dev/null)
    [ -n "$r" ] && masked=$r
  fi

  [ "$masked" = "$out" ] || audit_note masked
  printf '%s\n' "$masked"
  exit "$status"
}

# --- shell-init: emit `agx`, a warn-only nudge, and default command wrapping ---
# `eval "$(agent-guard shell-init)"` in the user's shell rc defines `agx` (an
# alias for `agent-guard exec --`) and a NON-BLOCKING preexec/DEBUG nudge that
# reminds the user to wrap known secret-loading idioms with `agx` so their output
# is masked before the model sees it.
shell_init_target() {
  # Default to `auto`: emit a snippet that picks the hook at SOURCE time in the
  # user's interactive shell. We cannot detect the parent shell here — this
  # script runs under its own `#!/usr/bin/env sh` interpreter, and $ZSH_VERSION
  # / $BASH_VERSION are non-exported shell parameters invisible to a child
  # process. `--bash` / `--zsh` force a single hook for users who prefer it.
  target=auto
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bash) target=bash ;;
      --zsh) target=zsh ;;
      --no-command-wrapping) : ;;
      -h|--help) target=help ;;
      *) die "shell-init: unknown argument: $1 (expected --bash, --zsh, or --no-command-wrapping)" ;;
    esac
    shift
  done
  printf '%s' "$target"
}

# Emit the zsh preexec hook. add-zsh-hook chains onto any existing preexec
# rather than clobbering it; the plain-function fallback is only for ancient zsh.
shell_init_zsh_hook() {
  cat <<'EOF'
# zsh: fire the nudge before each interactive command (command line in $1). Use
# add-zsh-hook when available so an existing preexec is not clobbered.
if autoload -Uz add-zsh-hook 2>/dev/null; then
  add-zsh-hook preexec __agentguard_nudge
else
  preexec() { __agentguard_nudge "$1"; }
fi
EOF
}

# Emit the bash DEBUG-trap hook. A DEBUG trap is process-global, so we CHAIN
# onto any pre-existing trap instead of overwriting it. A sourced rc cannot read
# an existing DEBUG trap (bash does not expose it to sourced/function scope
# without functrace), so we DEFER the install to the first prompt via
# PROMPT_COMMAND — where the trap IS visible — then chain and self-remove.
shell_init_bash_hook() {
  cat <<'EOF'
# bash: install the nudge as a DEBUG trap that fires before each interactive
# command ($BASH_COMMAND). Deferred to the first prompt so we can read and CHAIN
# onto any pre-existing DEBUG trap instead of clobbering it; runs exactly once.
# ponytail: assumes PROMPT_COMMAND is a string, not a bash 5.1+ array.
__agentguard_sq=\'
__agentguard_boot='__agentguard_prev=$(trap -p DEBUG);
case "$__agentguard_prev" in
  (*__agentguard_nudge*) : ;;
  ("") trap "__agentguard_nudge \"\$BASH_COMMAND\"" DEBUG ;;
  (*) __agentguard_prev=${__agentguard_prev#trap -- $__agentguard_sq};
      __agentguard_prev=${__agentguard_prev%$__agentguard_sq DEBUG};
      trap "${__agentguard_prev}; __agentguard_nudge \"\$BASH_COMMAND\"" DEBUG ;;
esac;
unset __agentguard_prev;
PROMPT_COMMAND=${PROMPT_COMMAND#eval \"\$__agentguard_boot\";};
unset __agentguard_boot __agentguard_sq'
case "${PROMPT_COMMAND:-}" in
  (*__agentguard_boot*) ;;
  (*) PROMPT_COMMAND="eval \"\$__agentguard_boot\";${PROMPT_COMMAND:-}" ;;
esac
EOF
}

# Stable, default-on Claude command wrapping. Emit function overrides for common
# file/env dump commands so `!`-typed reads are routed through `agent-guard exec`
# (output masked) BEFORE the transcript captures them. Users can opt out for a
# managed rc with `setup-shell --no-command-wrapping`, or at runtime with
# `AGENT_GUARD_COMMAND_WRAPPING=off`.
#
# Why functions, not the preexec nudge above: Claude Code builds a "shell
# snapshot" of your interactive shell for `!` commands. That snapshot runs
# `unalias -a` and drops preexec/DEBUG hooks — so aliases and the nudge do NOT
# fire for `!`. It DOES keep functions, so these overrides are the one lever that
# actually intercepts `!cat .env`.
#
# Best-effort, NOT a security control:
#   * covers only these command names; trivially bypassed by an absolute path
#     (`/bin/cat`), `source`/`.`, `python -c 'open(...)'`, redirection (`< file`).
#   * gated on $CLAUDECODE so it is INERT in your normal terminal — cat/head/tail
#     behave exactly as before there; masking only kicks in inside Claude Code.
#   * `exec` buffers combined output (no streaming/paging) and adds a gitleaks
#     scan per call, so wrap only cheap, interactive dump commands.
#   * `exec` captures output via shell substitution, so it is TEXT-ONLY: a
#     binary / NUL-containing read loses embedded NULs and its trailing newline.
#     For faithful binary output use `command cat` / `\cat` (or
#     `shell-init --no-command-wrapping`). This targets text config/secret dumps,
#     not blobs.
shell_init_command_wrapping() {
  cat <<'EOF'
# --- agent-guard Claude command wrapping (enabled by default) ----------------
# Routes `!`-typed dump commands through `agent-guard exec` so their output is
# masked before Claude Code captures it. Active ONLY inside Claude Code
# ($CLAUDECODE); inert in a normal terminal. Set
# AGENT_GUARD_COMMAND_WRAPPING=off to pass through without masking.
# Best-effort — see docs.
# NOTE: `agent-guard exec` buffers the whole output, so streaming/follow commands
# would hang. `tail` is deliberately NOT wrapped for that reason; wrap only
# terminating dump commands.
__agentguard_wrap_command() {  # $1 = real command name, remaining args forwarded
  __ag_cmd=$1; shift
  if [ -n "${CLAUDECODE:-}" ]; then
    case "${AGENT_GUARD_COMMAND_WRAPPING:-on}" in
      0|off|OFF|false|FALSE|no|NO)
        command "$__ag_cmd" "$@"
        return
        ;;
    esac
    # Route through `agent-guard exec` (resolved via $PATH or the baked path) so
    # the output is masked. `exec` runs the command in agent-guard's OWN child
    # process, where these overrides do not exist, so the real binary runs with
    # no re-entry (no inner `command` needed).
    if __ag_exe=$(__agentguard_exe); then
      if command "$__ag_exe" check >/dev/null 2>&1; then
        command "$__ag_exe" exec -- "$__ag_cmd" "$@"
        return
      fi
      __agentguard_warn_infra_once 'command-wrapping dependencies are not ready'
    else
      __agentguard_warn_infra_once 'command wrapping cannot locate the agent-guard binary'
    fi
    __agentguard_infra_closed && return 127
  fi
  # `command` bypasses this override so the real binary runs (no recursion).
  command "$__ag_cmd" "$@"
}
# A user alias for one of these (e.g. `alias cat='cat -n'`) would otherwise
# alias-expand the `${name}()` token while this eval is PARSED, so the function
# would fail to define and `!cat` would stay unguarded. Drop the alias before the
# inner eval, then restore it so the normal interactive shell keeps its existing
# behavior. Claude Code's snapshot runs `unalias -a`, exposing the function it
# retained underneath the alias.
for __ag_name in cat head printenv; do
  __ag_alias=$(alias "$__ag_name" 2>/dev/null || :)
  __ag_alias=${__ag_alias#alias }
  unalias "$__ag_name" 2>/dev/null || :
  eval "${__ag_name}() { __agentguard_wrap_command ${__ag_name} \"\$@\"; }"
  [ -n "$__ag_alias" ] && eval "alias $__ag_alias"
done
unset __ag_name __ag_alias
EOF
}

# The rc bootstrap and a loaded shell use the same cache authority and recovery
# rules. Emit functions so a managed rc can still resolve after its original
# version directory disappears, without executing unvalidated cached binaries.
shell_init_resolver() {
  cat <<'EOF'
__agentguard_policy_file_usable() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] && [ -s "$1" ] \
    && awk '$0 !~ /^[[:space:]]*(#|$)/ { found = 1; exit } END { exit !found }' "$1"
}
__agentguard_cache_bin_usable() {
  __ag_candidate=$1
  __ag_expected=${2:-}
  __ag_root=${__ag_candidate%/bin/agent-guard}
  [ -d "$__ag_root" ] && [ ! -L "$__ag_root" ] \
    && [ -d "$__ag_root/bin" ] && [ ! -L "$__ag_root/bin" ] \
    && [ -d "$__ag_root/config" ] && [ ! -L "$__ag_root/config" ] \
    && [ -f "$__ag_candidate" ] && [ ! -L "$__ag_candidate" ] && [ -x "$__ag_candidate" ] \
    && __agentguard_policy_file_usable "$__ag_root/config/gitleaks.toml" \
    && __agentguard_policy_file_usable "$__ag_root/config/deny-read-paths.txt" \
    && __agentguard_policy_file_usable "$__ag_root/config/deny-bash-patterns.txt" \
    || return 1
  __ag_embedded=
  while IFS= read -r __ag_line; do
    case "$__ag_line" in
      VERSION=*) __ag_embedded=${__ag_line#VERSION=}; break ;;
    esac
  done <"$__ag_candidate"
  [ -n "$__ag_embedded" ] \
    && { [ -z "$__ag_expected" ] || [ "$__ag_embedded" = "$__ag_expected" ]; }
}
__agentguard_latest_plugin_bin() {
  [ -n "${__agentguard_plugin_base:-}" ] || return 1
  __ag_latest=$(
    for __ag_candidate in "$__agentguard_plugin_base"/[0-9]*.[0-9]*.[0-9]*/bin/agent-guard; do
      [ -x "$__ag_candidate" ] || continue
      __ag_root=${__ag_candidate%/bin/agent-guard}
      [ -d "$__ag_root" ] && [ ! -L "$__ag_root" ] || continue
      __ag_version=${__ag_candidate%/bin/agent-guard}
      __ag_version=${__ag_version##*/}
      __agentguard_cache_bin_usable "$__ag_candidate" "$__ag_version" || continue
      printf '%s\t%s\n' "$__ag_version" "$__ag_candidate"
    done \
      | awk -F '\t' '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/' \
      | sort -t. -k1,1n -k2,2n -k3,3n \
      | tail -n 1 \
      | cut -f 2-
  )
  [ -n "$__ag_latest" ] && [ -x "$__ag_latest" ] || return 1
  printf '%s' "$__ag_latest"
}
__agentguard_semver() {
  __ag_version=$1
  __ag_major=${__ag_version%%.*}
  __ag_rest=${__ag_version#*.}
  [ "$__ag_rest" != "$__ag_version" ] || return 1
  __ag_minor=${__ag_rest%%.*}
  __ag_patch=${__ag_rest#*.}
  [ "$__ag_patch" != "$__ag_rest" ] || return 1
  case "$__ag_major" in ''|*[!0-9]*) return 1 ;; esac
  case "$__ag_minor" in ''|*[!0-9]*) return 1 ;; esac
  case "$__ag_patch" in ''|*[!0-9]*) return 1 ;; esac
  return 0
}
__agentguard_physical_path() (
  __ag_physical=$1
  case "$__ag_physical" in
    /*) ;;
    *)
      __ag_pwd=$(pwd -P 2>/dev/null) || return 1
      __ag_physical=$__ag_pwd/$__ag_physical
      ;;
  esac
  __ag_hops=0
  while [ -L "$__ag_physical" ]; do
    __ag_hops=$((__ag_hops + 1))
    [ "$__ag_hops" -le 40 ] || return 1
    __ag_target=$(readlink -- "$__ag_physical" 2>/dev/null) || return 1
    case "$__ag_target" in
      /*) __ag_physical=$__ag_target ;;
      *) __ag_physical=${__ag_physical%/*}/$__ag_target ;;
    esac
  done
  __ag_name=${__ag_physical##*/}
  __ag_parent=${__ag_physical%/*}
  [ "$__ag_parent" != "$__ag_physical" ] || __ag_parent=.
  __ag_parent=$(CDPATH= cd -- "$__ag_parent" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s' "$__ag_parent" "$__ag_name"
)
__agentguard_path_bin() {
  __ag_path=$(command -v agent-guard 2>/dev/null) || __ag_path=
  if [ -n "$__ag_path" ]; then
    # setup-shell adds current/bin to PATH. Do not re-admit an invalid cache
    # through a relative entry or an external symlink alias after rejecting its
    # payload above. Canonicalize only in plugin mode; standalone PATH fallback
    # retains support for command wrappers that are not payload-shaped paths.
    if [ -n "${__agentguard_plugin_base:-}" ]; then
      __ag_path=$(__agentguard_physical_path "$__ag_path") || return 1
      __ag_base=$(CDPATH= cd -- "$__agentguard_plugin_base" 2>/dev/null && pwd -P) \
        || __ag_base=
      if [ -n "$__ag_base" ]; then
        case "$__ag_path" in "$__ag_base"|"$__ag_base"/*) return 1 ;; esac
      fi
    fi
    printf '%s' "$__ag_path"; return 0
  fi
  return 1
}
__agentguard_exe() {
  if [ -n "${AGENT_GUARD_BIN:-}" ] && [ -x "$AGENT_GUARD_BIN" ]; then
    printf '%s' "$AGENT_GUARD_BIN"; return 0
  fi
  __ag_current_target=
  if [ -n "${__agentguard_plugin_base:-}" ] \
     && [ -L "$__agentguard_plugin_base/current" ]; then
    __ag_current_target=$(readlink "$__agentguard_plugin_base/current" 2>/dev/null) \
      || __ag_current_target=
    __agentguard_semver "$__ag_current_target" || __ag_current_target=
  fi
  if [ -n "${__agentguard_bin:-}" ] && [ -x "$__agentguard_bin" ] \
     && [ -n "${__agentguard_plugin_base:-}" ] \
     && [ -n "$__ag_current_target" ] \
     && [ -d "$__agentguard_plugin_base/$__ag_current_target" ] \
     && [ ! -L "$__agentguard_plugin_base/$__ag_current_target" ] \
     && __agentguard_cache_bin_usable \
          "$__agentguard_plugin_base/$__ag_current_target/bin/agent-guard" \
          "$__ag_current_target"; then
    printf '%s' "$__agentguard_bin"; return 0
  fi
  __ag_latest=$(__agentguard_latest_plugin_bin) || __ag_latest=
  if [ -n "$__ag_latest" ]; then
    printf '%s' "$__ag_latest"; return 0
  fi
  if [ -z "${__agentguard_plugin_base:-}" ] \
     && [ -n "${__agentguard_bin:-}" ] && [ -x "$__agentguard_bin" ]; then
    printf '%s' "$__agentguard_bin"; return 0
  fi
  __agentguard_path_bin
}
EOF
}

shell_init() {
  # Propagate a die from inside the command substitution: without this an
  # unknown argument printed its error but still emitted the full snippet with
  # exit 0, so a stale rc line kept eval-ing a half-understood invocation.
  target=$(shell_init_target "$@") || exit 2
  command_wrapping=1
  for __ag_arg in "$@"; do
    case "$__ag_arg" in
      --no-command-wrapping) command_wrapping=0 ;;
    esac
  done
  if [ "$target" = help ]; then
    {
      printf '%s\n' "Usage: $PROGRAM shell-init [--bash|--zsh] [--no-command-wrapping]"
      printf '%s\n' "Emits a shell snippet for: eval \"\$($PROGRAM shell-init)\""
      printf '%s\n' "Command wrapping is on by default: cat/head/printenv are masked inside"
      printf '%s\n' "Claude Code. Set AGENT_GUARD_COMMAND_WRAPPING=off for a runtime opt-out."
      printf '%s\n' "  --no-command-wrapping     omit the automatic command overrides"
    } >&2
    return 0
  fi

  # Shared comment header + the `agx` wrapper and nudge function body (identical
  # for both shells). The nudge is warn-only: it NEVER blocks or modifies the
  # command. It skips commands that already route through agx / agent-guard exec,
  # or that discard BOTH output streams (a bare >/dev/null or 2>/dev/null still
  # leaves the other stream transcript-bound, so those must NOT skip), and only
  # fires on a small curated set of secret-loading idioms. The match is a
  # pure-shell `case` glob (no subprocess per command, so it is fast).
  #
  # Plugin installs bake only the stable sibling path plus their cache base.
  # Direct CLI installs keep their already-stable absolute path. The cache base
  # lets an existing session recover if `current` cannot be updated.
  printf '__agentguard_bin=%s\n' "$(sh_squote "$STABLE_BIN")"
  printf '__agentguard_plugin_base=%s\n' "$(sh_squote "$PLUGIN_CACHE_BASE")"
  cat <<'EOF'
# --- agent-guard shell integration (managed by: agent-guard shell-init) -------
# Threat: a `!`-prefixed command in Claude Code runs in your shell and its OUTPUT
# is captured into the transcript and sent to the model. No agent-guard hook fires
# for `!`. Run secret-printing commands as `agx <cmd>` (in Claude Code: `!agx
# <cmd>`) so their output is masked BEFORE the model sees it. The nudge below is a
# warn-only reminder; it never blocks or changes your command.
#
# Resolve the agent-guard binary at call time: an explicit $AGENT_GUARD_BIN wins,
# then the stable baked path, then the newest installed plugin version as a
# recovery fallback, then $PATH for standalone CLI installs.
EOF
  shell_init_resolver
  cat <<'EOF'

__agentguard_infra_closed() {
  [ "${AGENT_GUARD_INFRA_FAILURE_MODE:-open}" = closed ]
}
__agentguard_warn_infra_once() {
  [ "${__agentguard_infra_warned:-0}" = 1 ] && return 0
  __agentguard_infra_warned=1
  printf 'agent-guard: %s; output is NOT masked. Set AGENT_GUARD_INFRA_FAILURE_MODE=closed to refuse execution.\n' "$1" >&2
}

# Explicit agx and transparent command wrapping share one infrastructure policy:
# open by default with one warning per shell, or closed when configured.
agx() {
  if __ag_exe=$(__agentguard_exe); then
    if command "$__ag_exe" check >/dev/null 2>&1; then
      command "$__ag_exe" exec -- "$@"
      return
    fi
    __agentguard_warn_infra_once 'agx masking dependencies are not ready'
  else
    __agentguard_warn_infra_once 'agx cannot locate the agent-guard binary'
  fi
  __agentguard_infra_closed && return 127
  command "$@"
}
__agentguard_nudge() {
  [ -n "$1" ] || return 0
  case "$1" in
    __agentguard_nudge*|*agx*|*'agent-guard exec'*) return 0 ;;
  esac
  # Skip only when BOTH streams are discarded — secrets leak via stdout OR
  # stderr into the transcript, so a lone `>/dev/null` / `2>/dev/null` must not
  # suppress the nudge. `2>&1 >/dev/null` (wrong order — stderr keeps the tty) is
  # deliberately NOT matched.
  case "$1" in
    *'>/dev/null 2>&1'*|*'> /dev/null 2>&1'*|*'&>/dev/null'*|*'&> /dev/null'*) return 0 ;;
  esac
  case "$1" in
    *printenv*|*'env |'*|*'op read'*|*'vault kv get'*|*'aws secretsmanager get-secret-value'*|*'gh auth token'*|*'cat '*.env*)
      printf '\033[33magent-guard: this command may print secrets to the transcript — consider: agx <cmd>\033[0m\n' >&2
      ;;
  esac
  return 0
}
# Record — for the plugin's SessionStart drift hook — the version of the binary
# the integration resolved here at rc-eval time, across every path
# ($AGENT_GUARD_BIN / $PATH / the baked path) — which the plugin's SessionStart
# hook cannot re-derive itself (it can't see the baked path). Exported so
# `claude` launched from this shell, and its hooks, inherit it; the hook warns
# when it differs from the plugin's own version. Present iff the integration
# loaded (see README for why that closes both the false-positive and
# false-negative of a re-derived check). It is a startup SNAPSHOT, not a
# call-time read: if the resolved binary is swapped in place within a long-lived
# shell that later launches `claude` without re-sourcing the rc, the marker can
# lag what actually masks — an accepted limitation of a session-start check.
# Resolve once, then one `version` exec; silent if nothing resolves.
#
# Clear the marker FIRST so each rc-eval is authoritative about its OWN
# resolution: a child shell that re-sources the rc but now fails to resolve must
# not keep a stale value inherited from the parent (would break "present iff
# loaded"). The version is pulled with parameter expansion, not word-splitting —
# `${v#* }` takes the field after the first space, `${v%%[!0-9A-Za-z.+-]*}` keeps
# only the leading version-charset run (dropping any trailing text/newline) — so
# there is no `$(...)` word-split to guard against globbing, and no positional
# args to clobber.
unset AGENT_GUARD_SHELL_INIT_VERSION
if __ag_exe=$(__agentguard_exe); then
  __ag_v=$(command "$__ag_exe" version 2>/dev/null)
  __ag_v=${__ag_v#* }
  __ag_v=${__ag_v%%[!0-9A-Za-z.+-]*}
  [ -n "$__ag_v" ] && export AGENT_GUARD_SHELL_INIT_VERSION=$__ag_v
  unset __ag_v
fi
unset __ag_exe
EOF
  case "$target" in
    zsh) shell_init_zsh_hook ;;
    bash) shell_init_bash_hook ;;
    auto)
      # Detect the shell at SOURCE time in the user's interactive shell, where
      # $ZSH_VERSION / $BASH_VERSION are actually set (unlike in this child sh).
      printf '%s\n' 'if [ -n "${ZSH_VERSION:-}" ]; then'
      shell_init_zsh_hook
      printf '%s\n' 'elif [ -n "${BASH_VERSION:-}" ]; then'
      shell_init_bash_hook
      printf '%s\n' 'fi'
      ;;
  esac
  # Command wrapping is shell-agnostic (plain functions), so it is emitted after
  # the shell-specific hook wiring for any target unless explicitly disabled.
  [ "$command_wrapping" = 1 ] && shell_init_command_wrapping
}

# Write (or replace in place) the managed block in ONE rc file. Split out of
# do_setup_shell so a fish login shell can install into both POSIX rc files.
setup_shell_write_rc() {  # $1 = rc path, $2 = the eval line to manage
  rc=$1 line=$2
  begin=$SHELL_INIT_BLOCK_BEGIN
  end=$SHELL_INIT_BLOCK_END

  # If the rc is a symlink (e.g. into a dotfiles repo), edit the file it points
  # at rather than replacing the link with a regular file. Walk the chain by hand
  # (BSD readlink lacks -f), matching script_path() above.
  rc_real=$rc hops=0
  while [ -L "$rc_real" ]; do
    hops=$((hops + 1)); [ "$hops" -le 40 ] || die "setup-shell: too many symlink hops resolving $rc"
    t=$(readlink -- "$rc_real")
    case "$t" in /*) rc_real=$t ;; *) rc_real=$(dirname -- "$rc_real")/$t ;; esac
  done
  rc_dir=$(dirname -- "$rc_real")
  [ -d "$rc_dir" ] || die "setup-shell: directory does not exist: $rc_dir"

  # Build the new content in a temp file in the SAME directory as the target, so
  # the final `mv` is an atomic same-filesystem rename: the rc is never left
  # half-written, even if this process is killed mid-run.
  tmp=$(mktemp "$rc_dir/.agent-guard-rc.XXXXXX" 2>/dev/null) \
    || die "setup-shell: failed to create temp file in $rc_dir"
  if [ -f "$rc_real" ]; then
    # Seed perms/owner from the existing rc (a plain `>` below keeps the inode's
    # mode while rewriting content); a brand-new rc keeps mktemp's private 0600.
    cp -p "$rc_real" "$tmp" 2>/dev/null || :
    # Strip any existing managed block, then REFUSE if we hit a begin marker with
    # no matching end (`END{exit skip}`): silently dropping everything after an
    # unbalanced marker would eat unrelated rc content.
    if ! awk -v b="$begin" -v e="$end" \
      '$0==b{skip=1} skip==0{print} $0==e{skip=0} END{exit skip}' "$rc_real" >"$tmp"; then
      rm -f "$tmp"
      die "setup-shell: $rc_real has '$begin' with no matching '$end'; refusing to overwrite. Fix or remove that block, then re-run."
    fi
  else
    : >"$tmp"
  fi
  {
    printf '%s\n' "$begin"
    printf '%s\n' "# Managed by 'agent-guard setup-shell' — remove this block to disable."
    [ -z "${path_line:-}" ] || printf '%s\n' "$path_line"
    printf '%s\n' "$line"
    printf '%s\n' "$end"
  } >>"$tmp"
  mv "$tmp" "$rc_real" || { rm -f "$tmp"; die "setup-shell: failed to write $rc_real"; }

  info "$PROGRAM: shell integration written to $rc_real"
}

# `setup-shell` — write the `eval "$(... shell-init ...)"` line into the user's
# shell rc so the wrappers load in every new shell (hence every Claude Code shell
# snapshot). This is the one manual step a plugin-only install needs: a plugin
# cannot edit your rc, so run this once (by absolute path if agent-guard is not
# yet on $PATH). Idempotent — re-running replaces the managed block in place.
#
# The setup skill itself runs through an agent Bash tool, where $SHELL can name
# the bash/zsh snapshot instead of the user's account login shell. Query the
# account database as a second signal: getent covers NSS-backed Linux systems,
# while dscl covers macOS. This lookup is best-effort and never makes setup fail.
setup_shell_account_shell() (
  set -f
  account_user=$(id -un 2>/dev/null) || account_user=
  [ -n "$account_user" ] || return 1

  account_shell=
  if command -v getent >/dev/null 2>&1; then
    account_record=$(getent passwd "$account_user" 2>/dev/null) || account_record=
    if [ -n "$account_record" ]; then
      account_old_ifs=$IFS
      IFS=:
      # getent was queried for exactly one account. Field 7 is its login shell.
      # shellcheck disable=SC2086
      set -- $account_record
      IFS=$account_old_ifs
      [ "$#" -ge 7 ] && account_shell=$7
    fi
  fi

  if [ -z "$account_shell" ] && command -v dscl >/dev/null 2>&1; then
    account_record=$(dscl . -read "/Users/$account_user" UserShell 2>/dev/null) \
      || account_record=
    case "$account_record" in
      UserShell:*) account_shell=${account_record#UserShell:}
        account_shell=${account_shell#"${account_shell%%[![:space:]]*}"} ;;
    esac
  fi

  case "$account_shell" in
    /*) printf '%s\n' "$account_shell" ;;
    *) return 1 ;;
  esac
)

do_setup_shell() {
  sh_target= rc= wrapping= want_help=0
  # Parse every argument before acting on --help, matching shell-init: a
  # rejected option must fail even when --help precedes it, so no invocation
  # carrying a removed/unknown flag can exit 0.
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --bash) sh_target=bash ;;
      --zsh) sh_target=zsh ;;
      --rc) shift; rc=${1:-}; [ -n "$rc" ] || die "setup-shell: --rc requires a path" ;;
      --no-command-wrapping) wrapping=' --no-command-wrapping' ;;
      -h|--help) want_help=1 ;;
      *) die "setup-shell: unknown option: $1 (see: $PROGRAM setup-shell --help)" ;;
    esac
    shift
  done
  if [ "$want_help" -eq 1 ]; then
    {
      printf '%s\n' "Usage: $PROGRAM setup-shell [--bash|--zsh|--rc FILE] [--no-command-wrapping]"
      printf '%s\n' "Adds the shell-init line to your shell rc (idempotent). Restart your"
      printf '%s\n' "shell and any sessions launched from it afterwards to apply."
      printf '%s\n' "If the process or account login shell is fish, setup writes both ~/.bashrc"
      printf '%s\n' "and ~/.zshrc: fish cannot eval the POSIX snippet, and agent shell snapshots"
      printf '%s\n' "run one of those two. Account lookup is best-effort (getent on Linux, dscl"
      printf '%s\n' "on macOS); if it fails, setup falls back to the process SHELL."
      printf '%s\n' "Command wrapping is enabled by default. Use --no-command-wrapping for"
      printf '%s\n' "a persistent opt-out, or AGENT_GUARD_COMMAND_WRAPPING=off at runtime."
    } >&2
    return 0
  fi

  # Pick the rc file: explicit --rc wins, else derive from the chosen/detected
  # shell. Fish in either the process environment or account login record is the
  # one case with no single answer. The setup skill runs inside an agent Bash
  # tool, whose $SHELL may describe its bash/zsh snapshot rather than the account
  # login shell, so relying on that variable alone misses real fish users.
  # `shell-init` emits POSIX shell code that fish cannot eval, so there is no fish
  # rc to install into, and Claude Code builds its `!`/Bash snapshot from bash or
  # zsh without telling us which. Install into both so the wrapping loads either
  # way. Explicit --bash / --zsh / --rc always wins. If lookup fails, retain the
  # old process-SHELL behavior; an unknown process and account shell falls back
  # to zsh rather than widening the write set.
  if [ -z "$rc" ]; then
    if [ -z "$sh_target" ]; then
      process_shell=${SHELL:-}
      account_shell=$(setup_shell_account_shell) || account_shell=
      process_kind= account_kind=
      case "${process_shell##*/}" in
        bash) process_kind=bash ;;
        zsh) process_kind=zsh ;;
        fish) process_kind=fish ;;
      esac
      case "${account_shell##*/}" in
        bash) account_kind=bash ;;
        zsh) account_kind=zsh ;;
        fish) account_kind=fish ;;
      esac
      case "$process_kind:$account_kind" in
        fish:*|*:fish) sh_target=fish ;;
        bash:*|zsh:*) sh_target=$process_kind ;;
        *:bash|*:zsh) sh_target=$account_kind ;;
        *) sh_target=zsh ;;
      esac
    fi
    case "$sh_target" in bash) rc=$HOME/.bashrc ;; fish) rc= ;; *) rc=$HOME/.zshrc ;; esac
  fi

  # Bootstrap through the same validated resolver as a loaded shell. A healthy
  # current wins; only an unavailable current permits complete-cache recovery.
  stable=$(sh_squote "$STABLE_BIN")
  cache_base=$(sh_squote "$PLUGIN_CACHE_BASE")
  resolver=$(sh_squote "$(shell_init_resolver)")
  line="eval \"\$(
_agbin=$stable
_agbase=$cache_base
__agentguard_bin=\$_agbin
__agentguard_plugin_base=\$_agbase
eval $resolver
_agi=
_agresolved=\$(__agentguard_exe) || _agresolved=
if [ -n \"\$_agresolved\" ]; then
  _agi=\$(\"\$_agresolved\" shell-init${wrapping} 2>/dev/null) || _agi=
fi
if [ -z \"\$_agi\" ]; then
  _agfallback=\$(__agentguard_path_bin) || _agfallback=
  if [ -n \"\$_agfallback\" ] && [ \"\$_agfallback\" != \"\$_agresolved\" ]; then
    _agi=\$(\"\$_agfallback\" shell-init${wrapping} 2>/dev/null) || _agi=
  fi
fi
[ -n \"\$_agi\" ] && printf '%s\\n' \"\$_agi\"
)\""
  path_line=
  if [ -n "$PLUGIN_CACHE_BASE" ]; then
    stable_dir=$(sh_squote "$PLUGIN_CACHE_BASE/current/bin")
    path_line="case :\$PATH: in *:$stable_dir:*) ;; *) PATH=$stable_dir\${PATH:+:\$PATH} ;; esac; export PATH"
  fi

  if [ "$sh_target" = fish ]; then
    setup_shell_write_rc "$HOME/.bashrc" "$line"
    setup_shell_write_rc "$HOME/.zshrc" "$line"
    fish_exec=$STABLE_BIN
    [ -x "$fish_exec" ] || fish_exec=$SELF_BIN
    info "$PROGRAM: fish shell detected. The integration is POSIX shell code, so it cannot load in fish itself: no automatic agx and no nudge at your fish prompt."
    info "$PROGRAM: agent shell snapshots run bash or zsh, which do read the files above, so command wrapping still applies to agent-run commands."
    info "$PROGRAM: a plugin-only install may not put agent-guard on fish's PATH; use the PATH-safe agx function in docs/operations.md (fish), or this executable with 'exec -- <cmd>':"
    info "$PROGRAM: fish executable: $fish_exec"
  else
    setup_shell_write_rc "$rc" "$line"
  fi
  info "$PROGRAM: restart your shell and any sessions launched from it to apply"
}

# Homebrew owns the libexec payload through its formula. New formulas place a
# regular marker in that payload. Older releases did not, so recognize only the
# exact Cellar layout plus Homebrew's recorded canonical tap; a generic receipt
# elsewhere must never change standalone update behavior.
homebrew_managed_install() {
  marker="$ROOT_DIR/.agent-guard-homebrew"
  if [ -f "$marker" ] && [ ! -L "$marker" ]; then
    return 0
  fi

  case "$ROOT_DIR" in
    */Cellar/agent-guard/*/libexec) ;;
    *) return 1 ;;
  esac
  receipt="$ROOT_DIR/../INSTALL_RECEIPT.json"
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  grep -Eq '"tap"[[:space:]]*:[[:space:]]*"jeongjaesoon/tap"' "$receipt"
}

# doctor is setup plus a release-staleness line; the setup status is returned
# unchanged so a failed lookup never turns a healthy doctor red.
do_doctor() {
  do_setup "$@"
  doctor_status=$?
  if latest_release_version; then
    if version_newer "$LATEST_RELEASE_VERSION" "$VERSION"; then
      info "$PROGRAM: release: $VERSION installed; $LATEST_RELEASE_VERSION is available"
    else
      info "$PROGRAM: release: $VERSION installed; latest release is $LATEST_RELEASE_VERSION"
    fi
  else
    info "$PROGRAM: release: $VERSION installed; latest unknown (release lookup unavailable or AGENT_GUARD_RELEASE_CHECK=off)"
  fi
  return "$doctor_status"
}

# Update only the standalone distribution. Plugin caches and Homebrew formula
# payloads are owned by their respective managers; mutating either here would
# recreate the stale-path problem this command is intended to avoid. The
# bootstrap script remains the single checksum-verified standalone installer.
do_update() {
  [ "$#" -eq 0 ] || die "update: no arguments are accepted"
  if [ -n "$PLUGIN_CACHE_BASE" ]; then
    die "update is unavailable for plugin installs; run '$PROGRAM plugin update --host claude' (or --host codex) to see the host-manager commands that move to a newer release"
  fi
  if homebrew_managed_install; then
    die "update is unavailable for Homebrew installs; run: brew upgrade JeongJaeSoon/tap/agent-guard"
  fi
  need_cmd curl
  info "$PROGRAM: downloading the checksum-verified standalone updater"
  [ -n "$AGENT_GUARD_RUNDIR" ] \
    || die "update: cannot create a private temporary workspace"
  update_script="$AGENT_GUARD_RUNDIR/bootstrap.sh"
  curl -fsSL "https://github.com/JeongJaeSoon/agent-guard/releases/latest/download/bootstrap.sh" \
    -o "$update_script" || die "update: failed to download bootstrap.sh"
  sh -n "$update_script" || die "update: downloaded bootstrap.sh failed syntax validation"
  # BIN_DIR is the resolved payload directory, not the public symlink's
  # directory. Preserve the invocation location (including custom installs)
  # unless the caller explicitly requests a different link directory.
  update_bin_dir=${AGENT_GUARD_BIN_DIR:-}
  if [ -z "$update_bin_dir" ]; then
    update_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) \
      || die "update: cannot resolve the invocation directory"
  fi
  AGENT_GUARD_HOME="$ROOT_DIR" \
    AGENT_GUARD_BIN_DIR="$update_bin_dir" \
    sh "$update_script"
}

# Per-invocation temp workspace. Every scan temp file (gitleaks stdin captures,
# read-loop payloads) may hold plaintext secrets, so route them all under one
# directory (see mktemp_file) and remove it with a single trap on exit —
# including the catchable signals the host actually sends: SIGTERM when it kills
# the PostToolUse/Stop hook at its timeout, SIGINT on Ctrl-C. mktemp -d (not a
# predictable $$-based name) because these files hold secrets and a guessable
# path in a shared /tmp invites a symlink / pre-create race. Non-fatal: if the
# dir cannot be created, mktemp_file falls back to per-file temps so no command
# breaks. `do_setup` and `smoke_test` install their own EXIT trap and so replace
# this one — harmless: they clean their own temp and hold no real secrets.
# ponytail: an un-trappable SIGKILL still leaves the dir to the OS temp reaper.
AGENT_GUARD_RUNDIR=$(mktemp -d "${TMPDIR:-/tmp}/agent-guard-run.XXXXXX" 2>/dev/null \
  || mktemp -d /tmp/agent-guard-run.XXXXXX 2>/dev/null || printf '')
# Logging is independent of stdout and never changes the guard's exit status.
# SIGKILL cannot be trapped; a started-only record remains useful evidence.
trap 'ag_final_status=$?; clear_gitleaks_probe_processes; audit_finish "$ag_final_status"; [ -z "$AGENT_GUARD_RUNDIR" ] || rm -rf "$AGENT_GUARD_RUNDIR"; exit "$ag_final_status"' 0
trap 'exit 130' INT
trap 'exit 143' TERM

cmd=${1:-}
audit_begin "$cmd"
case "$cmd" in
  hook-pre-tool) hook_pre_tool ;;
  hook-post-tool) hook_post_tool ;;
  hook-stop) hook_stop ;;
  hook-session-start) hook_session_start ;;
  hook-user-prompt) hook_user_prompt ;;
  exec) shift; do_exec "$@" ;;
  shell-init) shift; shell_init "$@" ;;
  pii-filter) shift; pii_filter "$@" ;;
  scan-staged) shift; scan_staged "$@" ;;
  scan-working-tree) shift; scan_working_tree "$@" ;;
  scan-path) shift; scan_path "$@" ;;
  filter-lockfile-hashes) shift; filter_lockfile_hashes "$@" ;;
  logs) shift; audit_logs "$@" ;;
  plugin) shift; do_plugin "$@" ;;
  check) check_deps ;;
  doctor) shift; do_doctor "$@" ;;
  update) shift; do_update "$@" ;;
  setup) shift; do_setup "$@" ;;
  setup-shell) shift; do_setup_shell "$@" ;;
  smoke-test) smoke_test ;;
  checksum) shift; exec sh "$ROOT_DIR/scripts/gitleaks-checksum.sh" "$@" ;;
  version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  ''|-h|--help|help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
